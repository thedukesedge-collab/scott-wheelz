    // Re-RinkFloat: neon green + purple theme for the main screen.
    // Warning colors (red, orange) are kept so alerts still read as alerts.
    QtObject {
        id: swTheme

        readonly property color neonGreen: "#39ff7a"
        readonly property color neonPurple: "#b14cff"
        readonly property color background: "#05060d"
        readonly property color grid: "#160d2b"

        // Re-RinkFloat: neon palette for the tune preset buttons
        readonly property var neonNames: ["Green", "Purple", "Cyan", "Magenta", "Orange", "Yellow", "Red", "Blue"]
        readonly property var neonColors: ["#39ff7a", "#b14cff", "#00f0ff", "#ff2bd6", "#ff8a1f", "#f5ff3b", "#ff2b4f", "#3b7bff"]

        function tuneColorIndex(slot) {
            var map = {};
            try { map = JSON.parse(swSettings.tuneColors || "{}"); } catch (e) {}
            var i = map[slot];
            return (i === undefined || i < 0 || i >= neonColors.length) ? ((slot - 1) % neonColors.length) : i;
        }

        function tuneColor(slot) {
            return neonColors[tuneColorIndex(slot)];
        }

        function setTuneColor(slot, index) {
            var map = {};
            try { map = JSON.parse(swSettings.tuneColors || "{}"); } catch (e) {}
            map[slot] = index;
            swSettings.tuneColors = JSON.stringify(map);
        }

        function color(name) {
            switch (name) {
            case "lightAccent":
            case "green":
                return "#39ff7a";
            case "lightText":
                return "#d6ffe4";
            case "normalText":
                return "#c3a6ff";
            case "disabledText":
                return "#7d68ab";
            case "lightBackground":
                return "#24123f";
            case "lightestBackground":
                return "#3d2266";
            case "darkBackground":
                return "#05060d";
            case "purpleAccent":
                return "#7b2fd0";
            case "swPurple":
                return "#b14cff";
            case "swBalance":
                return "#6a4a9e";
            default:
                return Utility.getAppHexColor(name);
            }
        }
    }

    // Re-RinkFloat: Neon Future grid used behind the main screen and the bottom sheet
    component SwGrid : Canvas {
        contextType: "2d"
        onWidthChanged: requestPaint()
        onHeightChanged: requestPaint()
        onPaint: {
            var ctx = getContext("2d");
            ctx.reset();
            ctx.strokeStyle = swTheme.grid;
            ctx.lineWidth = 1;
            var step = Math.max(12, Math.round(0.5 * unit));
            ctx.beginPath();
            for (var x = 0; x < width; x += step) {
                ctx.moveTo(x + 0.5, 0);
                ctx.lineTo(x + 0.5, height);
            }
            for (var y = 0; y < height; y += step) {
                ctx.moveTo(0, y + 0.5);
                ctx.lineTo(width, y + 0.5);
            }
            ctx.stroke();
        }
    }

    component SwNText : Text {
        color: swTheme.color("normalText")
    }

    component SwLText : Text {
        color: swTheme.color("lightText")
    }

    component SwDText : Text {
        color: swTheme.color("disabledText")
    }

    // Re-RinkFloat: home-screen labels/values in the speedo's digital font,
    // neon purple with a soft glow
    component SwNeonLabel : Text {
        color: "#c98bff"
        font.family: "Exan"
        font.pixelSize: 0.3 * unit
        font.letterSpacing: 0.02 * unit
        fontSizeMode: width > 0 ? Text.HorizontalFit : Text.FixedSize
        minimumPixelSize: 0.14 * unit
    }

    component SwNeonValue : SwNeonLabel {
        color: "#ead6ff"
        font.pixelSize: 0.42 * unit
        minimumPixelSize: 0.2 * unit
    }

    // Re-RinkFloat: "check engine" style motor symbol (outline after the
    // Material Design "engine" icon, Apache 2.0)
    component SwEngineIcon : Canvas {
        id: engineIcon
        property color color: "#c98bff"
        onColorChanged: requestPaint()
        onWidthChanged: requestPaint()
        onHeightChanged: requestPaint()
        contextType: "2d"
        onPaint: {
            var pts = [[14,8],[14,12],[20,12],[20,16],[14,16],[10,20],[10,26],[6,26],[6,20],[2,20],[2,36],[6,36],
                       [6,30],[10,30],[10,36],[16,36],[20,40],[36,40],[36,32],[40,32],[40,38],[46,38],[46,18],
                       [40,18],[40,24],[36,24],[36,16],[24,16],[24,12],[30,12],[30,8]];
            var ctx = getContext("2d");
            ctx.reset();
            var s = Math.min(width / 48, height / 48);
            ctx.translate((width - 48 * s) / 2, (height - 48 * s) / 2);
            ctx.scale(s, s);
            ctx.lineJoin = "round";
            ctx.beginPath();
            ctx.moveTo(pts[0][0], pts[0][1]);
            for (var i = 1; i < pts.length; i++) {
                ctx.lineTo(pts[i][0], pts[i][1]);
            }
            ctx.closePath();
            ctx.strokeStyle = swTheme.neonPurple;
            ctx.globalAlpha = 0.3;
            ctx.lineWidth = 8;
            ctx.stroke();
            ctx.globalAlpha = 1.0;
            ctx.strokeStyle = engineIcon.color;
            ctx.lineWidth = 3;
            ctx.stroke();
        }
    }

    // Re-RinkFloat: small up/down arrow button with hold-to-repeat
    component SwArrow : Rectangle {
        id: arrow
        property bool up: true
        property bool atLimit: false
        signal step()
        width: 0.8 * unit
        height: 0.7 * unit
        radius: 0.12 * unit
        color: arrowArea.pressed && !atLimit ? swTheme.neonPurple : "#140a26"
        border.color: atLimit ? "#4a2a73" : swTheme.neonPurple
        border.width: 2

        Canvas {
            anchors.centerIn: parent
            width: 0.32 * unit
            height: 0.24 * unit
            property color col: arrow.atLimit ? "#4a2a73" : arrowArea.pressed ? swTheme.background : swTheme.neonGreen
            onColChanged: requestPaint()
            onPaint: {
                var ctx = getContext("2d");
                ctx.reset();
                ctx.beginPath();
                if (arrow.up) {
                    ctx.moveTo(0, height); ctx.lineTo(width / 2, 0); ctx.lineTo(width, height);
                } else {
                    ctx.moveTo(0, 0); ctx.lineTo(width / 2, height); ctx.lineTo(width, 0);
                }
                ctx.closePath();
                ctx.fillStyle = col;
                ctx.fill();
            }
        }

        MouseArea {
            id: arrowArea
            anchors.fill: parent
            onPressed: { if (!arrow.atLimit) arrow.step(); arrowRepeat.interval = 450; arrowRepeat.start(); }
            onReleased: arrowRepeat.stop()
            onCanceled: arrowRepeat.stop()
        }

        Timer {
            id: arrowRepeat
            repeat: true
            onTriggered: { interval = 110; if (!arrow.atLimit) arrow.step(); }
        }
    }

    // Re-RinkFloat: neon pill button
    component SwPill : Rectangle {
        id: pill
        property string label
        property bool lit: false
        property bool enabledLook: true
        property real minWidth: 2.0 * unit
        signal clicked()
        // implicit size, so pills also work inside Row/ColumnLayouts
        implicitWidth: Math.max(minWidth, pillText.implicitWidth + 0.6 * unit)
        implicitHeight: 0.72 * unit
        radius: height / 2
        opacity: enabledLook ? 1 : 0.4
        color: lit || pillArea.pressed ? swTheme.neonGreen : "transparent"
        border.color: lit || pillArea.pressed ? swTheme.neonGreen : swTheme.neonPurple
        border.width: 2

        Text {
            id: pillText
            anchors.centerIn: parent
            width: Math.min(implicitWidth, pill.width - 0.3 * unit)
            elide: Text.ElideRight
            horizontalAlignment: Text.AlignHCenter
            text: pill.label
            color: pill.lit || pillArea.pressed ? swTheme.background : swTheme.neonPurple
            font.family: "Exan"
            font.pixelSize: 0.24 * unit
        }

        MouseArea {
            id: pillArea
            anchors.fill: parent
            onClicked: pill.clicked()
        }
    }

    // Re-Float Rink-Mixed: neon outline button for dialogs (settings window)
    component NeonButton : Rectangle {
        id: nbtn
        property string text
        property bool lit: false
        signal clicked()
        implicitWidth: Math.max(2.6 * unit, nbtnText.implicitWidth + 0.8 * unit)
        implicitHeight: 0.8 * unit
        radius: height / 2
        opacity: enabled ? 1 : 0.4
        color: nbtnArea.pressed ? swTheme.neonGreen : (lit ? "#123a20" : "transparent")
        border.color: swTheme.neonGreen
        border.width: 2
        Text {
            id: nbtnText
            anchors.centerIn: parent
            text: nbtn.text.toUpperCase()
            color: nbtnArea.pressed ? swTheme.background : swTheme.neonGreen
            font.family: "Exan"
            font.pixelSize: 0.24 * unit
            font.letterSpacing: 0.02 * unit
        }
        MouseArea {
            id: nbtnArea
            anchors.fill: parent
            onClicked: nbtn.clicked()
        }
    }

    // Re-Float Rink-Mixed: a framed group in the settings window
    component SettingsCard : Rectangle {
        id: scard
        property string title
        default property alias content: scardCol.data
        Layout.fillWidth: true
        Layout.leftMargin: 0.1 * unit
        Layout.rightMargin: 0.1 * unit
        // delayed: the wrapped texts' height depends on the card's width,
        // which the layout sets - a direct binding loops
        Binding on implicitHeight { value: scardCol.implicitHeight + 0.5 * unit; delayed: true }
        radius: 0.22 * unit
        color: "#100a24"
        border.color: "#3a2266"
        border.width: 2
        ColumnLayout {
            id: scardCol
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.top: parent.top
            anchors.margins: 0.25 * unit
            spacing: 0.15 * unit
            Text {
                Layout.fillWidth: true
                text: scard.title
                color: swTheme.neonPurple
                font.family: "Exan"
                font.pixelSize: 0.28 * unit
                font.letterSpacing: 0.04 * unit
            }
        }
    }

    // Re-RinkFloat: section heading (neon green, digital font)
    component LedHeading : SwLText {
        anchors.horizontalCenter: parent ? parent.horizontalCenter : undefined
        font.pixelSize: 0.38 * unit
        font.family: "Exan"
        font.letterSpacing: 0.03 * unit
        color: swTheme.neonGreen
    }

    // Re-RinkFloat: LEDS tab tile - opens a full-screen settings window
    component LedTile : Rectangle {
        id: tile
        property string title
        property string summary
        property string glyph
        property bool lit: false
        property color swatch: "transparent"
        property bool slcmOnly: false  // needs the SLCM light module firmware
        // rf92: small animated picture instead of the glyph: 2 status bar
        // (LEDs filling up), 3 the neon board (HEAD/TAIL LIGHTS, rf98)
        property int art: 0
        signal clicked()
        Layout.fillWidth: true
        Layout.preferredHeight: 1.9 * unit
        opacity: slcmOnly && !slcmDetect.present ? 0.5 : 1
        radius: 0.22 * unit
        color: tileArea.pressed ? "#1b2a1f" : "#0b0718"
        border.color: lit ? swTheme.neonGreen : swTheme.neonPurple
        border.width: 2

        Text {
            visible: tile.art === 0
            anchors.left: parent.left
            anchors.top: parent.top
            anchors.margins: 0.18 * unit
            text: tile.glyph
            color: tile.lit ? swTheme.neonGreen : swTheme.neonPurple
            font.pixelSize: 0.42 * unit
        }

        // ---- rf98 art 3: HEAD/TAIL LIGHTS - the neon board (Canvas)
        Canvas {
            id: boardArt
            visible: tile.art === 3
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.top: parent.top
            anchors.margins: 0.12 * unit
            height: parent.height - 1.0 * unit
            property real t: 0
            readonly property bool live: visible && tile.lit && Qt.application.state === Qt.ApplicationActive
            onLiveChanged: requestPaint()
            onWidthChanged: requestPaint()
            onHeightChanged: requestPaint()
            Connections { target: tile; function onLitChanged() { boardArt.requestPaint(); } }
            Timer {
                interval: 40
                repeat: true
                running: boardArt.live
                onTriggered: { boardArt.t += 0.04; boardArt.requestPaint(); }
            }
                // rf98: HEAD/TAIL LIGHTS tile art - the neon board, its lights fading
                // between neon (purple tail / green nose) and regular (red tail / white
                // head), the fade sweeping left to right. Coordinates from the 1774x887 art.
                function drawBoardArt(c, w, h, t, lit) {
                    c.clearRect(0, 0, w, h);
                    var sc = Math.min(w / 1774, h / 887), ox = (w - 1774 * sc) / 2, oy = (h - 887 * sc) / 2;
                    var X = function(x) { return ox + x * sc; }, Y = function(y) { return oy + y * sc; };
                    var mixc = function(a, b, k) { return [a[0] + (b[0] - a[0]) * k, a[1] + (b[1] - a[1]) * k, a[2] + (b[2] - a[2]) * k]; };
                    var css = function(v, a) { return "rgba(" + Math.round(v[0]) + "," + Math.round(v[1]) + "," + Math.round(v[2]) + "," + a + ")"; };
                    var green = [57, 255, 60], purple = [176, 40, 255], red = [255, 40, 60], white = [240, 248, 255];
                    // fade 0 (neon) -> 1 (regular) and back, the left end first
                    var ph = function(lag) { var p = (t / 7 - lag) % 1; if (p < 0) p += 1; return p < 0.35 ? 0 : p < 0.5 ? (p - 0.35) / 0.15 : p < 0.85 ? 1 : 1 - (p - 0.85) / 0.15; };
                    var kl = ph(0), kr = ph(0.06);
                    var lc = lit ? mixc(purple, red, kl) : [90, 60, 140], rc = lit ? mixc(green, white, kr) : [90, 60, 140];
                    var line = lit ? green : [110, 70, 170];
                    c.lineJoin = "round"; c.lineCap = "round";
                    // ground glow
                    if (lit) {
                        var g = c.createLinearGradient(X(150), 0, X(1650), 0);
                        g.addColorStop(0, css(lc, 0)); g.addColorStop(0.15, css(lc, 0.75)); g.addColorStop(0.28, css(mixc(lc, line, 0.5), 0.6));
                        g.addColorStop(0.5, css(line, 0.75)); g.addColorStop(0.85, css(rc, 0.75)); g.addColorStop(1, css(rc, 0));
                        c.strokeStyle = g; c.lineWidth = Math.max(2, 14 * sc); c.shadowColor = css(line, 0.8); c.shadowBlur = 30 * sc;
                        c.beginPath(); c.moveTo(X(150), Y(710)); c.lineTo(X(1650), Y(710)); c.stroke();
                        // beams / glows at the ends
                        var gl = c.createRadialGradient(X(225), Y(470), 0, X(225), Y(470), 260 * sc);
                        gl.addColorStop(0, css(lc, 0.85)); gl.addColorStop(1, css(lc, 0));
                        c.shadowBlur = 0; c.fillStyle = gl;
                        c.beginPath(); c.moveTo(X(260), Y(450)); c.lineTo(X(0), Y(380)); c.lineTo(X(0), Y(560)); c.closePath(); c.fill();
                        var gr = c.createRadialGradient(X(1550), Y(462), 0, X(1550), Y(462), 220 * sc);
                        gr.addColorStop(0, css(rc, 0.75)); gr.addColorStop(1, css(rc, 0));
                        c.fillStyle = gr; c.beginPath(); c.arc(X(1550), Y(462), 220 * sc, 0, 2 * Math.PI); c.fill();
                    }
                    c.lineWidth = Math.max(1.5, 7 * sc);
                    c.shadowColor = css(line, 0.9); c.shadowBlur = lit ? 22 * sc : 0;
                    c.strokeStyle = css(line, 1);
                    // wheel
                    c.beginPath(); c.arc(X(880), Y(460), 252 * sc, 0, 2 * Math.PI); c.stroke();
                    c.beginPath(); c.arc(X(880), Y(460), 145 * sc, 0, 2 * Math.PI); c.stroke();
                    // deck (filled dark so it hides the wheel behind it)
                    var p = [[218, 390], [290, 382], [405, 406], [592, 406], [615, 432], [1158, 432], [1180, 406], [1335, 406], [1450, 376],
                             [1545, 372], [1560, 388], [1558, 418], [1452, 507], [330, 507], [220, 442]];
                    c.beginPath(); c.moveTo(X(p[0][0]), Y(p[0][1]));
                    for (var i = 1; i < p.length; i++) c.lineTo(X(p[i][0]), Y(p[i][1]));
                    c.closePath();
                    c.shadowBlur = 0; c.fillStyle = "#06030d"; c.fill();
                    c.shadowBlur = lit ? 22 * sc : 0; c.stroke();
                    c.beginPath(); c.moveTo(X(232), Y(432)); c.lineTo(X(1548), Y(432)); c.stroke();
                    // light strips
                    c.lineWidth = Math.max(2, 10 * sc);
                    c.strokeStyle = css(lit ? mixc(lc, white, 0.55) : lc, 1); c.shadowColor = css(lc, 1); c.shadowBlur = lit ? 30 * sc : 0;
                    c.beginPath(); c.moveTo(X(224), Y(452)); c.lineTo(X(288), Y(490)); c.stroke();
                    c.strokeStyle = css(lit ? mixc(rc, white, 0.55) : rc, 1); c.shadowColor = css(rc, 1);
                    c.beginPath(); c.moveTo(X(1490), Y(488)); c.lineTo(X(1553), Y(440)); c.stroke();
                    c.shadowBlur = 0;
                }

            onPaint: drawBoardArt(getContext("2d"), width, height, t, tile.lit)
        }

        // ---- rf92 art: status bar - ten LEDs filling up like the battery bar
        Row {
            id: barArt
            visible: tile.art === 2
            anchors.left: parent.left
            anchors.top: parent.top
            anchors.leftMargin: 0.22 * unit
            anchors.topMargin: 0.35 * unit
            spacing: 0.06 * unit
            property real level: 0
            SequentialAnimation on level {
                running: barArt.visible && tile.lit && Qt.application.state === Qt.ApplicationActive
                loops: Animation.Infinite
                NumberAnimation { from: 0; to: 1; duration: 1600; easing.type: Easing.OutCubic }
                PauseAnimation { duration: 900 }
                NumberAnimation { to: 0.8; duration: 500 }
                PauseAnimation { duration: 700 }
            }
            Repeater {
                model: 10
                Rectangle {
                    readonly property bool on: tile.lit && (index + 0.5) / 10 <= barArt.level
                    width: 0.13 * unit
                    height: 0.3 * unit
                    radius: 0.04 * unit
                    color: !on ? "#21143a" : index < 2 ? "#ff2b4f" : index < 4 ? "#f5ff3b" : swTheme.neonGreen
                    border.color: tile.lit ? "#3d2a63" : swTheme.neonPurple
                    border.width: 1
                }
            }
        }
        Rectangle {
            visible: tile.swatch.a > 0
            anchors.right: parent.right
            anchors.top: parent.top
            anchors.margins: 0.22 * unit
            width: 0.3 * unit; height: width; radius: width / 2
            color: tile.swatch
        }
        Rectangle {
            visible: tile.slcmOnly
            anchors.right: parent.right
            anchors.top: parent.top
            anchors.topMargin: 0.2 * unit
            anchors.rightMargin: tile.swatch.a > 0 ? 0.65 * unit : 0.2 * unit
            width: slcmBadge.implicitWidth + 0.2 * unit
            height: 0.34 * unit
            radius: height / 2
            color: "transparent"
            border.width: 1
            border.color: slcmDetect.present ? swTheme.neonGreen : "#FFB300"
            Text {
                id: slcmBadge
                anchors.centerIn: parent
                text: "SLCM"
                color: parent.border.color
                font.family: "Exan"
                font.pixelSize: 0.16 * unit
            }
        }
        Text {
            anchors.right: parent.right
            anchors.bottom: parent.bottom
            anchors.margins: 0.14 * unit
            text: "\u203A"
            color: swTheme.neonPurple
            font.pixelSize: 0.4 * unit
        }
        Column {
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.bottom: parent.bottom
            anchors.leftMargin: 0.18 * unit
            anchors.rightMargin: 0.4 * unit
            anchors.bottomMargin: 0.16 * unit
            spacing: 0.04 * unit
            Text {
                width: parent.width
                text: tile.title
                color: swTheme.neonGreen
                font.family: "Exan"
                font.pixelSize: 0.27 * unit
                elide: Text.ElideRight
            }
            Text {
                width: parent.width
                text: tile.summary
                color: "#ead6ff"
                font.pixelSize: 0.17 * unit
                wrapMode: Text.WordWrap
                maximumLineCount: 2
                elide: Text.ElideRight
            }
        }
        MouseArea {
            id: tileArea
            anchors.fill: parent
            onClicked: tile.clicked()
        }
    }

    // Re-RinkFloat: label + [down] value [up] stepper with hold-to-repeat
    // Re-Float Rink-Mixed: an LED animation's name drawn the way the status
    // bar plays it: each letter is an "LED" (rainbow, red scanner, fire...),
    // with a glow from a blurred copy of the letters. Mirrors status_leds.c.
    component AnimName : Item {
        id: an
        property int anim: 0
        property string text: ""
        property real hue: 0  // personal color (degrees)
        property var rf: null  // anim 15: {mode, c1, c2, speed} of a Refloat light bar (else the Status Idle animation)
        property real basePixelSize: 0.32 * unit
        property real t: 0
        readonly property real pixelSize: Math.max(0.14 * unit,
            basePixelSize * Math.min(1, (width - 0.1 * unit) / Math.max(1, anTm.advanceWidth)))

        TextMetrics { id: anTm; font.family: "Exan"; font.pixelSize: an.basePixelSize; text: an.text }

        Timer {
            interval: 50
            repeat: true
            running: an.visible && an.anim > 0
            onTriggered: an.t = (an.t + 0.05) % 600
        }

        // brightness of a scanner spot at c (0..1) seen from letter position x
        function spot(x, c) { return Math.max(0.3, 1 - Math.abs(x - c) * 3.2); }
        function sweep(t, period) { return 0.5 - 0.5 * Math.cos(2 * Math.PI * t / period); }
        function frac(v) { return v - Math.floor(v); }

        function col(i, n, t) {
            var x = n > 1 ? i / (n - 1) : 0.5, h = 0, l = 0.6, a = 1, sat = 1, hu = an.hue / 360;
            var m = Math.abs(x - 0.5) * 2;  // 0 centre .. 1 ends
            switch (an.anim) {
            case 1:  // RAINBOW SCAN: one spot sweeping, its hue cycling
                h = 1 - frac(t / 3); a = spot(x, sweep(t, 2)); break;
            case 2:  // RAINBOW MIRROR: rainbow mirrored from the centre, flowing
                h = frac(m * 0.8 + t / 1.5); break;
            case 3:  // KNIGHT RIDER: red scanner
                h = 0; l = 0.5; a = spot(x, sweep(t, 2)); break;
            case 4:  // RAINBOW BAR: full rainbow across, scrolling
                h = frac(x - t / 1.0); break;
            case 5: {  // THE FUZZ: red / blue strobes
                var ph = Math.floor(t / 0.5) % 2, k = frac(t / 0.5);
                h = ph ? 0.667 : 0; l = 0.55;
                a = (k < 0.5 && Math.floor(t * 16) % 2 === 0) ? 1 : 0.15;
                if ((x < 0.5) === (ph === 1)) a = Math.min(a, 0.35);
                break;
            }
            case 6: {  // FIRE: flickering red / orange / yellow
                var f = 0.5 + 0.5 * Math.sin(t * 9.1 + i * 2.3) * Math.sin(t * 5.7 + i * 1.7 + 1);
                h = 0.01 + 0.12 * f; l = 0.38 + 0.25 * f; a = 0.55 + 0.45 * f; break;
            }
            case 7:  // PULSE OUT: personal color from the centre out
                h = hu + 0.04 * Math.sin(t * 2); a = spot(m, frac(t / 1.4)); break;
            case 8:  // PULSE IN: from the ends in
                h = hu + 0.04 * Math.sin(t * 2); a = spot(m, 1 - frac(t / 1.4)); break;
            case 9:  // 120 SCROLL: personal color + 120 degrees, scrolling
                h = hu + (1 / 3) * (0.5 - 0.5 * Math.cos(2 * Math.PI * (x - t / 2))); break;
            case 10:  // COMP. WAVE: personal color and its opposite, mirrored
                h = hu + 0.5 * (0.5 - 0.5 * Math.cos(2 * Math.PI * (m - t / 2))); break;
            case 11:  // CLASSIC: fills with the personal color, left to right
                h = hu; a = x <= Math.min(1, frac(t / 6.5) * 6.5 / 5.5) ? 1 : 0.15; break;
            case 12:  // COLOR SCAN: personal color scanner
                h = hu; a = spot(x, sweep(t, 2)); break;
            case 13:  // BATTERY LEVEL: a gauge, white, filled to ~80 %
                return x <= 0.8 ? "#f4f0ff" : Qt.rgba(1, 1, 1, 0.22);
            case 14: {  // CUSTOM: an approximation of the SLCM's fill / scan engines
                var c = ledSender.custom();
                var scan = (c[0] & 1) === 1, cm = (c[0] >> 1) & 7, pat = (c[0] >> 4) & 7;
                var ha = c[2] * 2 / 360, hb = c[3] * 2 / 360;
                var cs = (c[4] + 1) * 0.05, ms = (c[5] + 1) * 0.05;
                var pos = scan ? 0.5 : (pat === 1 ? x : (pat === 2 ? m : 0));
                var k = cm === 0 ? frac(pos + t / cs) : cm === 1 ? frac(pos - t / cs)
                    : cm === 2 ? 0.5 - 0.5 * Math.cos(2 * Math.PI * (t / cs + pos * 0.5))
                    : (Math.floor(t / cs + pos) % 2);
                h = cm === 4 ? hu : (cm === 3 ? (k ? hb : ha) : ha + (hb - ha) * k);
                if (scan) {
                    var u = frac(t / ms);
                    var p = pat === 0 ? u : pat === 1 ? 1 - u : pat === 2 ? 0.5 + 0.5 * u : pat === 3 ? 1 - 0.5 * u
                        : pat === 4 ? u : pat === 5 ? 1 - u : sweep(t, ms * 2);
                    var xx = pat === 2 || pat === 3 ? 0.5 + Math.abs(x - 0.5) : x;
                    a = pat === 4 ? (x <= p ? 1 : 0.15) : pat === 5 ? (x >= p ? 1 : 0.15) : spot(xx, p);
                } else if (c[1] === 1) {
                    a = c[6] / 255 + (1 - c[6] / 255) * (0.5 - 0.5 * Math.cos(2 * Math.PI * t / ms));
                } else if (c[1] === 2) {
                    a = frac(t / ms) < 0.5 ? 1 : Math.max(0.12, c[6] / 255);
                }
                break;
            }
            case 15: {  // Refloat's Status Idle animation (approximation)
                if ((!an.rf && !ledSender.rfOn) || (an.rf && an.rf.mode < 0)) return "#ead6ff";  // battery display
                var c1 = ledSender.rfQColor(an.rf ? an.rf.c1 : ledSender.rfColor1), c2 = ledSender.rfQColor(an.rf ? an.rf.c2 : ledSender.rfColor2);
                var sp = Math.max(0.1, an.rf ? an.rf.speed : ledSender.rfSpeed), md = an.rf ? an.rf.mode : ledSender.rfMode;
                var mix = function(p) { return Qt.rgba(c1.r + (c2.r - c1.r) * p, c1.g + (c2.g - c1.g) * p, c1.b + (c2.b - c1.b) * p, 1); };
                var dim = function(cc, k) { return Qt.rgba(cc.r, cc.g, cc.b, Math.max(0.15, k)); };
                var has2 = (an.rf ? an.rf.c2 : ledSender.rfColor2) !== 0;  // rf92: black = dim, not invisible
                var c1black = (an.rf ? an.rf.c1 : ledSender.rfColor1) === 0;
                if (c1black && (md === 0 || !has2)) return "#5c5470";  // all black: shown dim grey
                if (md === 0) return c1;
                if (c1black) { var sw = c1; c1 = c2; c2 = sw; has2 = false; }
                if (md === 1) { var pf = 0.5 - 0.5 * Math.cos(2 * Math.PI * t * sp); return has2 ? mix(pf) : dim(c1, 1 - pf); }
                // rf91: PULSE / STROBE / KNIGHT RIDER show color 2 (background) unless it's black
                if (md === 2) { var kp = spot(m, frac(t * sp)); return has2 ? mix(1 - kp) : dim(c1, kp); }
                if (md === 3) return frac(t * sp * 2) < 0.5 ? c1 : (has2 ? c2 : dim(c1, 0));
                if (md === 4) { var kk = spot(x, sweep(t, 2 / sp)); return has2 ? mix(1 - kk) : dim(c1, kk); }
                if (md === 5) {
                    var fp = Math.floor(t * sp * 2) % 2;
                    var side = (x < 0.5) === (fp === 0), fl = Math.floor(t * 16) % 2 === 0 ? 1 : 0.2;
                    return side || has2 ? dim(side ? c1 : c2, fl) : dim(c1, 0.15);
                }
                if (md === 8) { h = frac(x - t * sp); break; }
                h = frac(t * sp / 3); break;
            }
            default:  // STANDARD (white) / OFF (dark)
                return an.text === "OFF" ? "#5c5470" : "#ead6ff";
            }
            return Qt.hsla(frac(h), sat, l, a);
        }

        Item {
            id: anLetters
            anchors.centerIn: parent
            width: anRow.implicitWidth
            height: anRow.implicitHeight

            Row {
                id: anRow
                Repeater {
                    model: an.text.length
                    Text {
                        text: an.text.charAt(index)
                        color: an.col(index, an.text.length, an.t)
                        font.family: "Exan"
                        font.pixelSize: an.pixelSize
                    }
                }
            }
        }

        // the glow: the same letters, blurred, behind
        FastBlur {
            z: -1
            anchors.fill: anLetters
            source: anLetters
            radius: 14
            transparentBorder: true
        }
    }

    component SwStepper : Item {
        id: stepper
        width: parent ? parent.width : 0
        height: 0.95 * unit

        property string label
        property real value
        property real from
        property real to
        property real step: 1
        property int decimals: 0
        property string suffix: ""
        property string valueText: ""  // overrides the number if set
        property color valueColor: swTheme.neonGreen
        property real valueWidth: 2.1 * unit  // wider for names (animations)
        property bool animName: false  // draw valueText as an LED animation (AnimName)
        // Refloat animation as the value (AnimName anim 15): rfAnim for the
        // Status Idle animation, rf = {mode, c1, c2, speed} for a light bar
        property bool rfAnim: false
        property var rf: null
        // the animation itself is the selector: no label, [down] NAME [up]
        // across the full width
        property bool bigName: false
        signal moved(real newValue)
        // rf101: optional ON / OFF switch between the label and the arrows
        // (-1 = none, 0 off, 1 on), e.g. the background color
        property int toggle: -1
        signal toggleClicked()

        function nudge(dir) {
            var v = Math.round((value + dir * step) / step) * step;
            v = Math.max(from, Math.min(to, v));
            if (v !== value) moved(v);
        }

        SwNeonLabel {
            visible: !stepper.bigName
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter
            width: parent.width - stepper.valueWidth - 2.5 * unit - (stepper.toggle >= 0 ? 1.3 * unit : 0)
            font.pixelSize: 0.28 * unit
            text: stepper.label
        }

        Rectangle {
            visible: stepper.toggle >= 0 && !stepper.bigName
            anchors.verticalCenter: parent.verticalCenter
            anchors.right: parent.right
            anchors.rightMargin: stepper.valueWidth + 2.55 * unit
            width: 1.1 * unit
            height: 0.5 * unit
            radius: height / 2
            color: stepper.toggle === 1 ? swTheme.neonGreen : "transparent"
            border.color: stepper.toggle === 1 ? swTheme.neonGreen : swTheme.neonPurple
            border.width: 2
            Text {
                anchors.centerIn: parent
                text: stepper.toggle === 1 ? "ON" : "OFF"
                color: stepper.toggle === 1 ? swTheme.background : swTheme.neonPurple
                font.family: "Exan"
                font.pixelSize: 0.2 * unit
            }
            MouseArea { anchors.fill: parent; anchors.margins: -0.1 * unit; onClicked: stepper.toggleClicked() }
        }

        Row {
            anchors.right: stepper.bigName ? undefined : parent.right
            anchors.horizontalCenter: stepper.bigName ? parent.horizontalCenter : undefined
            anchors.verticalCenter: parent.verticalCenter
            spacing: 0.1 * unit

            Repeater {
                model: [-1, 0, 1]

                Item {
                    width: modelData !== 0 ? 1.1 * unit
                        : stepper.bigName ? stepper.width - 2.4 * unit : stepper.valueWidth
                    height: 0.8 * unit

                    AnimName {
                        visible: modelData === 0 && (stepper.animName || stepper.rfAnim || !!stepper.rf)
                        anchors.fill: parent
                        anim: stepper.rfAnim || stepper.rf ? 15 : stepper.value
                        rf: stepper.rf
                        text: stepper.valueText
                        hue: swSettings.ledColor
                        basePixelSize: stepper.bigName ? 0.4 * unit : 0.32 * unit
                    }

                    Text {
                        visible: modelData === 0 && !stepper.animName && !stepper.rfAnim && !stepper.rf
                        anchors.centerIn: parent
                        width: parent.width
                        horizontalAlignment: Text.AlignHCenter
                        fontSizeMode: Text.HorizontalFit
                        minimumPixelSize: 0.16 * unit
                        color: stepper.valueColor
                        font.family: "Exan"
                        font.pixelSize: 0.32 * unit
                        text: stepper.valueText !== "" ? stepper.valueText : stepper.value.toFixed(stepper.decimals) + stepper.suffix
                    }

                    Rectangle {
                        visible: modelData !== 0
                        anchors.fill: parent
                        radius: 0.15 * unit
                        property bool atLimit: modelData < 0 ? stepper.value <= stepper.from : stepper.value >= stepper.to
                        color: arrowMouse.pressed && !atLimit ? swTheme.neonPurple : "#140a26"
                        border.color: atLimit ? "#4a2a73" : swTheme.neonPurple
                        border.width: 2

                        // arrow
                        Canvas {
                            anchors.centerIn: parent
                            width: 0.4 * unit
                            height: 0.3 * unit
                            property bool up: modelData > 0
                            property color col: parent.atLimit ? "#4a2a73" : arrowMouse.pressed ? swTheme.background : swTheme.neonGreen
                            onColChanged: requestPaint()
                            onPaint: {
                                var ctx = getContext("2d");
                                ctx.reset();
                                ctx.beginPath();
                                if (up) {
                                    ctx.moveTo(0, height); ctx.lineTo(width / 2, 0); ctx.lineTo(width, height);
                                } else {
                                    ctx.moveTo(0, 0); ctx.lineTo(width / 2, height); ctx.lineTo(width, 0);
                                }
                                ctx.closePath();
                                ctx.fillStyle = col;
                                ctx.fill();
                            }
                        }

                        MouseArea {
                            id: arrowMouse
                            anchors.fill: parent
                            onPressed: { stepper.nudge(modelData); repeatTimer.interval = 450; repeatTimer.start(); }
                            onReleased: repeatTimer.stop()
                            onCanceled: repeatTimer.stop()
                        }

                        Timer {
                            id: repeatTimer
                            repeat: true
                            onTriggered: { interval = 90; stepper.nudge(modelData); }
                        }
                    }
                }
            }
        }
    }

    // Re-RinkFloat: value over a neon label (or the engine symbol)
    component SwStat : Item {
        width: 1.7 * unit
        height: 0.95 * unit

        property string labelText
        property bool engineIcon: false
        property string unitText: ""
        property real value
        property real warningThreshold: 0
        property bool warn: !!warningThreshold && value > warningThreshold
        property bool fahrenheit: false  // value stays in °C; only the display converts
        readonly property real shownValue: fahrenheit ? value * 1.8 + 32 : value

        SwNeonValue {
            anchors.top: parent.top
            width: parent.width
            horizontalAlignment: Text.AlignHCenter
            color: parent.warn ? swTheme.color("red") : "#ead6ff"
            font.pixelSize: 0.4 * unit
            text: toFixed1Zero(parent.shownValue) + parent.unitText
        }

        SwNeonLabel {
            anchors.bottom: parent.bottom
            width: parent.width
            horizontalAlignment: Text.AlignHCenter
            visible: !parent.engineIcon
            text: parent.labelText
        }

        SwEngineIcon {
            anchors.bottom: parent.bottom
            anchors.horizontalCenter: parent.horizontalCenter
            width: 0.75 * unit
            height: 0.55 * unit
            visible: parent.engineIcon
            color: parent.warn ? swTheme.color("red") : "#c98bff"
        }
    }

    component FloatingToolButton : RoundButton {
        id: button
        anchors.margins: 4
        width: unit
        height: unit
        padding: 0
        leftInset: 0
        rightInset: 0
        topInset: 0
        bottomInset: 0

        property Path iconPath
        property Path fillIconPath
        property real iconSize: width * 0.7
        property color strokeColor: Utility.getAppHexColor("normalText")
        property color fillColor: Utility.getAppHexColor("normalText")
        property color bgColor: Utility.getAppHexColor("darkBackground")
        property var customBgColor
        property real iconLineWidth: 2
        property color iconGlowColor: "transparent"
        property real iconGlowBlur: 0

        onIconPathChanged: iconCanvas.requestPaint()
        onStrokeColorChanged: iconCanvas.requestPaint()
        onFillColorChanged: iconCanvas.requestPaint()
        onFillIconPathChanged: iconCanvas.requestPaint()

        contentItem: Item {
            Canvas {
                id: iconCanvas
                anchors.centerIn: parent
                implicitWidth: iconSize
                implicitHeight: iconSize
                contextType: "2d"

                onPaint: {
                    var context = getContext("2d");
                    context.reset();
                    if (iconPath) {
                        context.lineCap = "round";
                        context.lineJoin = "round";
                        iconPath.scale = Qt.size(iconSize / 50, iconSize / 50);
                        context.path = iconPath;
                        // Re-RinkFloat: soft halo as a wide translucent stroke (crisper
                        // than canvas shadowBlur), then the sharp line on top
                        if (button.iconGlowBlur > 0 && button.iconGlowColor.a > 0) {
                            context.strokeStyle = button.iconGlowColor;
                            context.globalAlpha = 0.28;
                            context.lineWidth = button.iconLineWidth * 3;
                            context.stroke();
                            context.globalAlpha = 1.0;
                        }
                        context.strokeStyle = button.strokeColor;
                        context.lineWidth = button.iconLineWidth;
                        context.stroke();
                    }
                    if (fillIconPath) {
                        context.fillStyle = button.fillColor;
                        fillIconPath.scale = Qt.size(iconSize / 50, iconSize / 50);
                        context.path = fillIconPath;
                        context.fill();
                    }
                }
            }
        }

        background: Rectangle {
            id: buttonBg
            radius: parent.width / 2
            opacity: 0.9

            color: button.customBgColor ?? button.bgColor

            states: [
                State {
                    name: "change"
                    when: button.pressed && !button.customBgColor
                    PropertyChanges {target: buttonBg; color: Utility.getAppHexColor("lightestBackground");}
                }
            ]

            transitions: Transition {
                ColorAnimation {property: "color"; duration: 200; easing.type: Easing.InOutCirc;}
            }
        }
    }

    component ToolButton : FloatingToolButton {
        anchors.margins: 0
        bgColor: Utility.getAppHexColor("normalBackground")
    }

    // Re-RinkFloat: Neon Future-style round button - dark core, neon purple ring
    // with a soft glow, glowing neon green icon. Flips to solid purple when pressed.
    component NeonToolButton : FloatingToolButton {
        id: neonButton
        anchors.margins: 0
        iconSize: width * 0.56
        iconLineWidth: 2.5
        strokeColor: pressed ? swTheme.background : swTheme.neonGreen
        iconGlowColor: pressed ? "transparent" : swTheme.neonGreen
        iconGlowBlur: 0.12 * unit

        background: Item {
            RectangularGlow {
                anchors.fill: neonRing
                glowRadius: 0.15 * unit
                spread: 0.15
                cornerRadius: neonRing.radius + glowRadius
                color: swTheme.neonPurple
                opacity: neonButton.pressed ? 0.9 : 0.45
            }

            Rectangle {
                id: neonRing
                anchors.fill: parent
                anchors.margins: 0.1 * unit
                radius: width / 2
                color: neonButton.pressed ? swTheme.neonPurple : swTheme.background
                border.color: swTheme.neonPurple
                border.width: 2

                Behavior on color {
                    ColorAnimation {duration: 150}
                }
            }
        }
    }

    component ToggleFloatingToolButton : FloatingToolButton {
        property bool autonomous: true
        property bool value: false

        property Path trueIconPath
        property Path falseIconPath
        property Path trueFillIconPath
        property Path falseFillIconPath

        iconPath: value ? trueIconPath : falseIconPath
        fillIconPath: value ? trueFillIconPath : falseFillIconPath

        onClicked: {
            if (autonomous) {
                value = !value;
            }
        }
    }

    component Dial : Item {
        id: dial

        property real lineWidth: width * 0.075
        property real maxValue
        property real minValue
        property real value
        property real topValue
        property real warnThresholdAbs: 0
        property bool allowNegative: false
        property string valueUnit: ""
        property real valueFontSize: fontSizeNormal

        property real valueAngle: value > 0 ? Math.min(360 * value / maxValue, 360) : Math.max(360 * value / -minValue, -360)
        property real topAngle: Math.min(360 * topValue / maxValue, 360)

        property real topAngleRads: topAngle * Math.PI / 180

        property real dialRadius: width * 0.3

        Behavior on value {
            NumberAnimation {
                easing.type: Easing.OutCirc
                duration: 100
            }
        }

        Behavior on topValue {
            NumberAnimation {
                easing.type: Easing.OutCirc
                duration: 100
            }
        }

        onValueAngleChanged: canvas.requestPaint();
        onTopAngleChanged: canvas.requestPaint();

        Canvas {
            id: canvas
            anchors.fill: parent

            contextType: "2d"

            Path {
                id: dialBackground

                PathAngleArc {
                    centerX: width * 0.5
                    centerY: centerX
                    radiusX: dialRadius + lineWidth * 0.5
                    radiusY: radiusX
                    startAngle: -270
                    sweepAngle: 360
                }
            }

            Path {
                id: topFill

                PathAngleArc {
                    centerX: width * 0.5
                    centerY: centerX
                    radiusX: dialRadius + lineWidth * 0.5
                    radiusY: radiusX
                    startAngle: -270
                    sweepAngle: topAngle
                }
            }

            Path {
                id: valueFill

                PathAngleArc {
                    centerX: width * 0.5
                    centerY: centerX
                    radiusX: dialRadius + lineWidth * 0.5
                    radiusY: radiusX
                    startAngle: -270
                    sweepAngle: valueAngle
                }
            }

            onPaint: {
                var context = getContext("2d");
                context.reset();
                context.lineWidth = lineWidth;
                context.strokeStyle = swTheme.color("lightBackground");
                context.path = dialBackground;
                context.stroke();

                if (!allowNegative) {
                    context.strokeStyle = swTheme.color("lightestBackground");
                    context.path = topFill;
                    context.stroke();
                }

                if (warnThresholdAbs > 0 && Math.abs(value) > warnThresholdAbs) {
                    context.strokeStyle = swTheme.color("orange");
                } else {
                    if (valueAngle > 0) {
                        context.strokeStyle = swTheme.color("lightAccent");
                    } else {
                        context.strokeStyle = swTheme.color("green");
                    }
                }

                context.path = valueFill;
                context.stroke();
            }
        }

        Rectangle {
            id: zeroMarker
            width: 1
            height: 1.3 * lineWidth
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.top: parent.verticalCenter
            anchors.topMargin: dialRadius
            z: 1
            color: swTheme.color("lightText")
        }

        Rectangle {
            id: topMarker
            width: 1
            height: 1.3 * lineWidth
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.top: parent.verticalCenter
            anchors.topMargin: dialRadius
            visible: !allowNegative && topAngle > 0
            z: 3
            color: swTheme.color("lightText")
            transform: Rotation {origin.x: 0; origin.y: -dialRadius; angle: topAngle}
            antialiasing: true
        }

        SwNeonValue {
            id: valueText
            anchors.centerIn: parent

            font.pixelSize: valueFontSize
            horizontalAlignment: Text.AlignHCenter
            text: round(parent.value)
        }

        SwNeonLabel {
            id: valueUnit
            anchors.left: valueText.right
            anchors.baseline: valueText.baseline
            anchors.leftMargin: 0.04 * unit

            text: parent.valueUnit
        }

        SwLText {
            id: topValueLabel
            anchors.centerIn: parent
            anchors.horizontalCenterOffset: -Math.sin(topAngleRads) * (dialRadius + lineWidth + font.pixelSize * 1.7)
            anchors.verticalCenterOffset: Math.cos(topAngleRads) * (dialRadius + lineWidth + font.pixelSize * 1.1)
            visible: !allowNegative && topAngle > 0
            z: 4
            font.pixelSize: fontSizeSmall
            text: toFixed1Zero(topValue)
        }
    }

    // Re-RinkFloat: digital Neon Future speedometer. Segmented neon arc for speed
    // (green, then purple, red at the top end), thin inner arc for duty, and
    // a big glowing digital readout in the middle.
    component NeonSpeedo : Item {
        id: speedo

        property real value: 0
        property real maxValue: 30
        property real duty: 0  // 0..1
        property real dutyWarn: 0.8
        property real erpm: 0
        property string unitText: ""
        property bool wheelslip: false
        property bool spinLimiting: false  // Re-RinkFloat

        property int segments: 40
        property real sweepDeg: 240
        property real radius: Math.max(unit, Math.min(width * 0.46, (height - 0.4 * unit) / 1.58))
        property real centerY: radius * 1.08 + 0.05 * unit

        Behavior on value {
            NumberAnimation {easing.type: Easing.OutCirc; duration: 100}
        }

        Behavior on duty {
            NumberAnimation {easing.type: Easing.OutCirc; duration: 100}
        }

        onValueChanged: speedoCanvas.requestPaint()
        onDutyChanged: speedoCanvas.requestPaint()
        onMaxValueChanged: speedoCanvas.requestPaint()

        Canvas {
            id: speedoCanvas
            anchors.fill: parent
            contextType: "2d"
            onWidthChanged: requestPaint()
            onHeightChanged: requestPaint()

            onPaint: {
                var ctx = getContext("2d");
                ctx.reset();

                var green = "#39ff7a";
                var purple = "#b14cff";
                var red = "#ff2b4f";
                var orange = "#ff8a1f";
                var dim = "#1d1238";

                var cx = width / 2;
                var cy = speedo.centerY;
                var R = speedo.radius;
                var sweep = speedo.sweepDeg * Math.PI / 180;
                var start = Math.PI / 2 + (2 * Math.PI - sweep) / 2;
                var n = speedo.segments;
                var frac = speedo.maxValue > 0 ? Math.max(0, Math.min(1, speedo.value / speedo.maxValue)) : 0;
                if (frac !== frac) frac = 0;

                var t = R * 0.17;
                var rSeg = R - t / 2;
                var gap = sweep / n * 0.25;
                var rDuty = R - t - R * 0.07;
                var rLabel = rDuty - R * 0.14;

                // outer guide line + ticks every 10%
                ctx.lineWidth = Math.max(1, R * 0.014);
                ctx.strokeStyle = purple;
                ctx.globalAlpha = 0.85;
                ctx.beginPath();
                ctx.arc(cx, cy, R * 1.05, start, start + sweep, false);
                ctx.stroke();
                for (var k = 0; k <= 10; k++) {
                    var ak = start + sweep * k / 10;
                    var r0 = R * 1.05;
                    var r1 = R * (k % 5 === 0 ? 1.13 : 1.09);
                    ctx.beginPath();
                    ctx.moveTo(cx + Math.cos(ak) * r0, cy + Math.sin(ak) * r0);
                    ctx.lineTo(cx + Math.cos(ak) * r1, cy + Math.sin(ak) * r1);
                    ctx.stroke();
                }
                ctx.globalAlpha = 1;

                // speed segments: unlit first, then a soft halo under the lit ones,
                // then the lit segments crisp on top
                var segCol = function(pos) { return pos < 0.7 ? green : pos < 0.9 ? purple : red; };
                for (var pass = 0; pass < 3; pass++) {
                    ctx.lineWidth = pass === 1 ? t + R * 0.07 : t;
                    ctx.globalAlpha = pass === 1 ? 0.22 : 1.0;
                    for (var i = 0; i < n; i++) {
                        var pos = (i + 0.5) / n;
                        var lit = pos <= frac;
                        if ((pass === 0) === lit) continue;
                        var a0 = start + sweep * i / n + gap / 2;
                        var a1 = start + sweep * (i + 1) / n - gap / 2;
                        ctx.beginPath();
                        ctx.arc(cx, cy, rSeg, a0, a1, false);
                        ctx.strokeStyle = lit ? segCol(pos) : dim;
                        ctx.stroke();
                    }
                }
                ctx.globalAlpha = 1.0;

                // duty arc
                ctx.lineWidth = Math.max(2, R * 0.045);
                ctx.strokeStyle = dim;
                ctx.beginPath();
                ctx.arc(cx, cy, rDuty, start, start + sweep, false);
                ctx.stroke();
                var d = Math.max(0, Math.min(1, speedo.duty));
                if (d === d && d > 0.002) {
                    var dcol = d >= 0.9 ? red : d >= speedo.dutyWarn ? orange : purple;
                    ctx.strokeStyle = dcol;
                    ctx.beginPath();
                    ctx.arc(cx, cy, rDuty, start, start + sweep * d, false);
                    var dutyW = ctx.lineWidth;
                    ctx.globalAlpha = 0.25;
                    ctx.lineWidth = dutyW * 2.6;
                    ctx.stroke();
                    ctx.globalAlpha = 1.0;
                    ctx.lineWidth = dutyW;
                    ctx.stroke();
                }

                // inner guide line
                ctx.lineWidth = Math.max(1, R * 0.01);
                ctx.strokeStyle = purple;
                ctx.globalAlpha = 0.35;
                ctx.beginPath();
                ctx.arc(cx, cy, rDuty - R * 0.06, start, start + sweep, false);
                ctx.stroke();
                ctx.globalAlpha = 1;

                // scale labels at 0, 25, 50, 75, 100 %
                ctx.fillStyle = "#7d68ab";
                ctx.font = Math.round(Math.max(9, R * 0.1)) + "px sans-serif";
                ctx.textAlign = "center";
                ctx.textBaseline = "middle";
                for (var j = 0; j <= 4; j++) {
                    var aj = start + sweep * j / 4;
                    ctx.fillText(Math.round(speedo.maxValue * j / 4), cx + Math.cos(aj) * rLabel, cy + Math.sin(aj) * rLabel);
                }
            }
        }

        Text {
            id: speedoWheelslip
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.bottom: speedoDigits.top
            color: swTheme.color("red")
            font.family: "Exan"
            font.pixelSize: Math.max(fontSizeSuperSmall, speedo.radius * 0.11)
            text: speedo.spinLimiting ? "SPIN LIMIT" : "WHEELSLIP"
            opacity: speedo.wheelslip ? 1 : 0

            Behavior on opacity {
                NumberAnimation {duration: speedo.wheelslip ? 200 : 1000; easing.type: Easing.OutExpo}
            }
        }

        Text {
            id: speedoDigits
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.verticalCenter: parent.top
            anchors.verticalCenterOffset: speedo.centerY - speedo.radius * 0.08
            color: "#d6ffe4"
            font.family: "Exan"
            font.pixelSize: speedo.radius * 0.5
            text: round(speedo.value)
        }

        Glow {
            anchors.fill: speedoDigits
            source: speedoDigits
            radius: Math.round(0.2 * unit)
            samples: 2 * radius + 1
            spread: 0.2
            color: swTheme.neonGreen
            opacity: 0.7
        }

        Column {
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.top: speedoDigits.bottom
            spacing: 0

            Text {
                anchors.horizontalCenter: parent.horizontalCenter
                color: swTheme.neonGreen
                font.family: "Exan"
                font.pixelSize: Math.max(fontSizeSuperSmall, speedo.radius * 0.12)
                text: speedo.unitText.toUpperCase()
            }

            SwDText {
                anchors.horizontalCenter: parent.horizontalCenter
                font.family: "monospace"
                font.pixelSize: Math.max(fontSizeSuperSmall, speedo.radius * 0.095)
                text: "%1 ERPM".arg(round(speedo.erpm))
            }

            Text {
                anchors.horizontalCenter: parent.horizontalCenter
                color: speedo.duty >= 0.9 ? "#ff2b4f" : speedo.duty >= speedo.dutyWarn ? "#ff8a1f" : swTheme.neonPurple
                font.family: "monospace"
                font.pixelSize: Math.max(fontSizeSuperSmall, speedo.radius * 0.095)
                text: "DUTY %1%".arg(round(speedo.duty * 100))
            }

        }
    }


    component BaseDialog : Dialog {
        id: baseDialog
        x: 10
        y: (parent.height / 2 - implicitHeight / 2) / (placeAtTop ? 2 : 1)
        implicitWidth: parent.width - 20

        property real fullHeight: parent.height - 20
        // place dialog at the top part of the screen, so that the phone
        // keyboard doesn't just exactly cover the buttons
        property bool placeAtTop: false

        // Re-Float Rink-Mixed: every dialog in the Neon Future look - dark
        // panel, purple neon frame, title in the digital font, green accents
        Material.theme: Material.Dark
        Material.accent: swTheme.neonGreen
        Material.foreground: "#ead6ff"
        Material.background: "#0b0718"

        background: Rectangle {
            color: "#0b0718"
            radius: 0.25 * unit
            border.color: swTheme.neonPurple
            border.width: 2
        }

        header: Item {
            visible: baseDialog.title !== ""
            implicitHeight: baseDialog.title !== "" ? dialogTitle.implicitHeight + 0.5 * unit : 0
            Text {
                id: dialogTitle
                anchors.centerIn: parent
                width: parent.width - 0.6 * unit
                horizontalAlignment: Text.AlignHCenter
                wrapMode: Text.WordWrap
                text: baseDialog.title.toUpperCase()
                color: swTheme.neonGreen
                font.family: "Exan"
                font.pixelSize: 0.36 * unit
                font.letterSpacing: 0.03 * unit
            }
            Rectangle {
                anchors.bottom: parent.bottom
                anchors.horizontalCenter: parent.horizontalCenter
                width: parent.width - 0.6 * unit
                height: 2
                color: swTheme.neonPurple
                opacity: 0.6
            }
        }

        modal: true
        focus: true
        closePolicy: Popup.CloseOnEscape
        parent: mainItem

        Overlay.modal: Rectangle {
            color: "#AA000000"
        }
    }

    component PlotData : QtObject {
        property int sampleSize: 0
        property var seriesIds
        property var series: []
        property var seriesSorted: []
        property var data: []
        property int ticksPerSecond
        // an offset added to timestamps if timestamps older than the last one
        // arrive, to ensure time is always increasing
        property real timeOffset: 0

        property var mins: []
        property var maxs: []
        property var scales: []

        property real timeStart
        property real timeEnd
        property real timeRange
        property real positiveRatio

        property int sampleNr: 0

        property bool initialized: true
        property bool dataReady: false

        signal dataUpdate
        signal scalesUpdate

        property var seriesMetaData
        property var seriesExtraColors
        // Static flags always added to data series, not part of the dynamic data series
        property var extraFlags: [
            "state.running",
            "state.wheelslip",
            "state.sat",
            "footpad.state",
        ]

        function reset() {
            sampleNr = 0;
            data = [];
            initialized = false;
            dataReady = false;
        }

        function init(seriesIds, ticksPerSec) {
            ticksPerSecond = ticksPerSec;
            initSeries(seriesIds, false);
        }

        function initSeries(ids, allVisible) {
            var smplSize = ids.length + extraFlags.length;
            sampleSize = smplSize;
            mins = Array(smplSize).fill(0);
            maxs = Array(smplSize).fill(0);
            scales = Array(smplSize).fill(1);

            if (arraysEqual(ids, seriesIds)) {
                initialized = true;
                return;
            }

            seriesIds = ids;
            var seriesMeta = seriesMetaData;

            var tmpMd = {};
            for (var i =0; i < seriesMeta.length; i++) {
                var sm = seriesMeta[i];
                var smDataCopy = Object.assign({}, sm[1]);
                tmpMd[sm[0]] = smDataCopy;
                smDataCopy.sortOrder = i + 100;
            }

            var srs = [];
            var srsSorted = [];
            var extrasOrder = 0;

            var push_series = function(id, i, visible) {
                var seriesMd = tmpMd[id] ?? {
                    "name": id,
                    "color": seriesExtraColors[extrasOrder],
                    "sortOrder": extrasOrder++,
                    "visible": true,
                };
                if (visible) {
                    seriesMd.visible = visible;
                }
                seriesMd.dataOrder = i;
                srs.push(seriesMd);
                srsSorted.push(seriesMd);
            }

            for (var i = 0; i < extraFlags.length; i++) {
                push_series(extraFlags[i], i, false);
            }

            for (var i = 0; i < ids.length; i++) {
                push_series(ids[i], i + extraFlags.length, !!allVisible);
            }

            srsSorted.sort((a, b) => a.sortOrder - b.sortOrder);
            series = srs;
            seriesSorted = srsSorted;
            initialized = true;
        }

        function addSample(sample, offset) {
            var sampleTime = sample[0] + timeOffset;
            var lastTime = data.length > 0 ? data[data.length - 1][0] : undefined;

            // only push sample if it's the next in row, assuming messages
            // can't change order, this should guarantee consistency
            //
            // also don't push if the timestamp is the same as that of the last
            // record, this can happen if two clients are connected to the same
            // VESC (they both poll for data and the messages get sent twice)
            if ((offset !== undefined && offset !== data.length) || lastTime === sampleTime) {
                return;
            }

            if (sampleTime < lastTime) {
                if (lastTime - sampleTime > 2 ** 31) {
                    // assume ticks have overflown
                    timeOffset = timeOffset + 2 ** 32;
                } else {
                    // a temporary disconnect (as of writing this code, doesn't
                    // normally occur without the AppUI being brought down)
                    timeOffset += lastTime + 10 * ticksPerSecond;
                }
            }

            if (timeOffset > 0) {
                sample[0] += timeOffset;
            }

            data.push(sample);

            for (var i = 0; i < sampleSize; i++) {
                if (sample[i + 1] > maxs[i]) {
                    maxs[i] = sample[i + 1];
                }
                if (sample[i + 1] < mins[i]) {
                    mins[i] = sample[i + 1];
                }
            }

            sampleNr = data.length;
        }

        function makeReady() {
            calculateRanges();
            dataReady = true;
            dataUpdate();
        }

        function calculateRanges() {
            if (data.length == 0) {
                return;
            }

            var lowestRatio = 1;
            var highestRatio = 0;
            var lMins = mins;
            var lMaxs = maxs;
            var srs = series;
            for (var i = 0; i < sampleSize; i++) {
                if (!srs[i].visible) {
                    continue;
                }

                if (lMaxs[i] > 1 || lMins[i] < -1) {
                    var ratio = clamp(lMaxs[i] / (lMaxs[i] - lMins[i]), 0, 1);
                    lowestRatio = Math.min(lowestRatio, ratio);
                    highestRatio = Math.max(highestRatio, ratio);
                }
            }

            var newRatio;
            if (lowestRatio < 0.5) {
                if (highestRatio > 0.5) {
                    newRatio = 0.5;
                } else {
                    newRatio = highestRatio;
                }
            } else {
                newRatio = lowestRatio;
            }

            positiveRatio = clamp(newRatio, 0.15, 0.85);

            var setScale = function(i, s) {
                if (s != scales[i]) {
                    scalesUpdate();
                }
                scales[i] = s;
            }

            var newScale;
            for (var i = 0; i < sampleSize; i++) {
                var minRatio = (1 - positiveRatio) / lMins[i];
                var maxRatio = positiveRatio / lMaxs[i];
                if (lMaxs[i] > 0) {
                    if (lMins[i] < 0) {
                        newScale = Math.min(maxRatio, -minRatio);
                    } else {
                        newScale = isFinite(maxRatio) ? maxRatio : 1;
                    }
                } else {
                    newScale = isFinite(minRatio) ? -minRatio : 1;
                }
                var rns = Math.min(newScale, srs[i].maxScale ?? 1);
                setScale(i, rns);
            }

            timeStart = data[0][0];
            timeEnd = data[data.length - 1][0];
            timeRange = timeEnd - timeStart;
        }
    }

    component RecordedPlotData : PlotData {
        id: recPlotData

        property bool noData: false
        property bool timeout: false

        property int sampleCount: 0
        property int requestTries: 0

        property Timer receiveTimeout: Timer {
            interval: 1000

            onTriggered: {
                recPlotData.requestPlot(true);
            }
        }

        function fetch(ticksPerSec) {
            reset();
            ticksPerSecond = ticksPerSec;
            noData = false;
            timeout = false;
            requestPlot();
        }

        function requestPlot(isARetry) {
            var reqTries = requestTries;

            if (!isARetry) {
                reqTries = 1;
            } else if (reqTries > 5) {
                timeout = true;
                return;
            }

            if (!initialized) {
                commands.sendDataRecordRequest(true);
            } else {
                commands.sendDataRecordRequest(false, sampleNr);
            }

            reqTries++;
            requestTries = reqTries;

            receiveTimeout.start();
        }

        function receiveHeader(dv, ind) {
            if (initialized) {
                // prevent processing messages in more than one AppUI instance
                return;
            }

            receiveTimeout.stop();

            sampleCount = dv.getUint32(ind); ind += 4;

            var sampleSize = dv.getUint8(ind++);
            var ids = [];
            for (var i = 0; i < sampleSize; i++) {
                var id = "";
                var size = dv.getUint8(ind++);
                for (var j = 0; j < size; j++) {
                    id += String.fromCharCode(dv.getUint8(ind++));
                }
                ids.push(id);
            }
            initSeries(ids, true);

            if (sampleCount === 0) {
                noData = true;
            } else {
                requestPlot();
            }
        }

        function receiveData(dv, ind) {
            receiveTimeout.stop();

            var offset = dv.getUint32(ind); ind += 4;

            var getFloat16 = commands.getFloat16;
            while (ind < dv.byteLength) {
                var time = dv.getUint32(ind); ind += 4;
                var flags = dv.getUint8(ind++);
                var sat = flags >> 4;
                var fp_state = (flags & 0b1100) >> 2;
                var wheelslip = (flags & 0b10) >> 1;
                var running = flags & 0b1;
                var data = [time, running, wheelslip, sat, fp_state];

                var remainingSampleSize = sampleSize - extraFlags.length;
                for (var i = 0; i < remainingSampleSize; i++) {
                    data.push(getFloat16(dv, ind)); ind += 2;
                }
                addSample(data, offset++);
            }

            if (sampleNr < sampleCount) {
                requestPlot();
            } else {
                makeReady();
            }
        }
    }

    component Plot : Rectangle {
        id: plot
        color: neon ? swTheme.background : "#0b0b0b"

        // Re-RinkFloat: neon axes / labels (series keep their own colors)
        property bool neon: false

        function themeColor(name) {
            return neon ? swTheme.color(name) : getDarkThemeColor(name);
        }

        property var plotData
        property int ticksPerSecond
        property bool followEnd: false
        property real startWindow: 10

        property real toolbarOffset: 0

        property bool showRecordDownload: false
        property int maxWindowMinutes
        property bool dotsEnabled: true

        function init(ticksPerSec) {
            ticksPerSecond = ticksPerSec;
            reset();
            // solves updating the plot (series) menu when the series in plotData have changed
            plotData = plotData;
        }

        function reset() {
            plotCanvas.reset();
        }

        function spawnCursor(cursorPos) {
            plotCanvas.spawnCursor(cursorPos);
        }

        function hideCursor() {
            plotCanvas.fadeCursor();
        }

        onVisibleChanged: {
            if (!visible) {
                menu.visible = false;
            }
        }

        Row {
            anchors.left: parent.left
            anchors.top: parent.top
            anchors.leftMargin: toolbarOffset * unit + 0.1 * unit
            anchors.topMargin: 0.1 * unit
            spacing: 0.1 * unit
            z: parent.z + 5

            FloatingToolButton {
                width: 0.8 * unit
                height: 0.8 * unit
                visible: plotData.initialized

                iconPath: Path {
                    PathSvg {path: "M 10 15 L 40 15 M 10 25 L 40 25 M 10 35 L 40 35"}
                }

                onClicked: {
                    menu.visible = !menu.visible;
                }
            }

            FloatingToolButton {
                width: 0.8 * unit
                height: 0.8 * unit
                visible: plot.showRecordDownload

                iconPath: Path {
                    PathSvg {path: "M 8 38 L 42 38 M 25 10 L 25 38 M 14 23 L 25 38 M 36 23 L 25 38"}
                }

                onClicked: {
                    recordedPlot.show();
                }
            }

            ToggleFloatingToolButton {
                width: 0.8 * unit
                height: 0.8 * unit
                visible: plot.showRecordDownload

                autonomous: false
                value: mainItem.state.extraRecording

                customBgColor: value ? Utility.getAppHexColor("red") : Utility.getAppHexColor("normalBackground")
                fillColor: value ? Utility.getAppHexColor("normalText") : Utility.getAppHexColor("red")

                trueFillIconPath: Path {
                    PathSvg {path: "M 13 13 L 13 37 L 37 37 L 37 13 L 13 13"}
                }

                falseFillIconPath: Path {
                    PathAngleArc {centerX: 25; centerY: 25; radiusX: 12; radiusY: 12; sweepAngle: 360;}
                }

                onClicked: {
                    commands.sendDataRecordControl(commands.dr_RECORD, !value);
                }

                onPressAndHold: {
                    recMenu.visible = true;
                }

                Menu {
                    id: recMenu

                    CheckBox {
                        text: "Autostart"
                        checkable: true
                        checked: mainItem.state.extraRecAutostart
                        onClicked: {
                            commands.sendDataRecordControl(commands.dr_AUTOSTART, checked);
                        }
                    }

                    CheckBox {
                        text: "Autostop"
                        checkable: true
                        checked: mainItem.state.extraRecAutostop
                        onClicked: {
                            commands.sendDataRecordControl(commands.dr_AUTOSTOP, checked);
                        }
                    }
                }
            }

//            FloatingToolButton {
//                width: 0.8 * unit
//                height: 0.8 * unit
//
//                iconPath: Path {
//                    PathAngleArc {centerX: 25; centerY: 25; radiusX: 12; radiusY: 12; startAngle: 45; sweepAngle: 270;}
//                }
//
//                onClicked: {
//                    colorPreview.show();
//                }
//            }
        }

        Rectangle {
            id: menu
            z: parent.z + 10
            anchors.top: parent.top
            anchors.left: parent.left
            anchors.topMargin: topMargin
            anchors.leftMargin: sideMargin
            height: menuScrollView.height
            width: menuScrollView.width
            visible: false

            property real topMargin: unit
            property real sideMargin: 0.2 * unit
            property real hPadding: 8
            property real vPadding: 4

            color: plot.themeColor("darkBackground");

            ScrollView {
                id: menuScrollView
                anchors.top: parent.top
                anchors.left: parent.left
                height: Math.min(contentHeight, plot.height - parent.topMargin - parent.sideMargin)
                width: menuColumn.width + 2 * menu.hPadding + 4
                contentWidth: availableWidth
                contentHeight: menuColumn.height + menu.vPadding
                clip: true

                Column {
                    id: menuColumn
                    anchors.top: parent.top
                    anchors.left: parent.left
                    anchors.topMargin: menu.vPadding * 0.5
                    spacing: 0

                    Repeater {
                        model: plotData.seriesSorted

                        Item {
                            width: menuRow.width
                            height: label.height + 2 * menu.vPadding

                            MouseArea {
                                anchors.top: parent.top
                                anchors.left: parent.left
                                width: menuColumn.width
                                height: parent.height
                                onClicked: itemCheckBox.toggle()
                            }

                            Row {
                                id: menuRow
                                anchors.left: parent.left
                                anchors.verticalCenter: parent.verticalCenter
                                anchors.leftMargin: menu.hPadding
                                spacing: 4

                                CheckBox {
                                    id: itemCheckBox
                                    height: label.height
                                    width: height

                                    checked: modelData.visible

                                    onCheckedChanged: {
                                        plot.plotData.seriesSorted[index].visible = checked;
                                        plot.plotData.calculateRanges();
                                        plotCanvas.requestPaint();
                                    }

                                    indicator: Rectangle {
                                        implicitHeight: parent.height * 0.9
                                        implicitWidth: implicitHeight
                                        y: parent.height / 2 - height / 2
                                        radius: 2
                                        color: "transparent"
                                        border.color: parent.checked ? plot.themeColor("lightText") : plot.themeColor("normalText")

                                        Rectangle {
                                            height: parent.height * 0.5
                                            width: height
                                            x: parent.width / 2 - width / 2
                                            y: parent.height / 2 - height / 2
                                            radius: 1
                                            color: parent.border.color
                                            visible: parent.parent.checked
                                        }
                                    }
                                }

                                Text {
                                    id: label
                                    text: modelData.name
                                    font.pointSize: 16
                                    color: modelData.color
                                }
                            }
                        }
                    }
                }
            }
        }

        PinchArea {
            anchors.fill: parent

            property real initialPlotWindow
            property real initialX
            property real lastScale

            onPinchStarted: {
                initialPlotWindow = plotCanvas.window;
                initialX = plotMouse.x(pinch.center);
                plotMover.grab();
            }

            onPinchUpdated: {
                plotMover.move(initialX - plotMouse.x(pinch.center), pinch.scale != lastScale);
                plotMover.zoom(initialPlotWindow / pinch.scale, plotMouse.x(pinch.center));
                lastScale = pinch.scale;
            }

            onPinchFinished: {
                plotMouse.release();
            }

            MouseArea {
                id: plotMouse
                anchors.fill: parent
                preventStealing: true

                property real initialX
                property real initialY

                property bool moving: false
                property bool holdCursor: false
                property bool moveCursor: false
                property bool cancelAction: false

                property real snap: 20

                function x(obj) {
                    return obj.x - plotCanvas.padding;
                }

                function dist2d(event) {
                    var dx = initialX - x(event);
                    var dy = initialY - event.y;
                    return Math.sqrt(dx * dx + dy * dy);
                }

                function release() {
                    moving = false;
                    holdCursor = false;
                    moveCursor = false;
                    cancelAction = false;
                    plotCanvas.fadeCursor(1);
                    plotMover.flick();
                }

                onWheel: {
                    if (!plotMover.grabbed) {
                        plotMover.grab();
                    }

                    plotMover.zoomAnimated(Math.max(0.75, 1 + wheel.angleDelta.y / 120 * 0.25), x(wheel));
                }

                onPressed: {
                    menu.visible = false;

                    initialX = x(mouse);
                    initialY = mouse.y;

                    var cursorPos = plotCanvas.getCursorPosIfCan();
                    if (plotMover.rolling) {
                        moving = true;
                    } else if (cursorPos !== null && dist(initialX, cursorPos) < snap) {
                        holdCursor = true;
                        return;
                    }

                    plotMover.grab();
                }

                onPositionChanged: {
                    if (cancelAction) {
                        return;
                    }

                    var d = initialX - x(mouse);
                    if (holdCursor) {
                        if (moveCursor) {
                            plotCanvas.spawnCursorCoord(x(mouse));
                        } else {
                            var yd = initialY - mouse.y;
                            var dist = Math.sqrt(yd * yd + d * d);
                            var angle = Math.acos(yd / dist);

                            // a cone of 30 degrees (15 to each side) or further than 10 pixels
                            if (angle > 0.2618 && dist > snap) {
                                if (yd > 30) {
                                    cancelAction = true;
                                } else {
                                    moveCursor = true;
                                }
                                plotCanvas.fadeCursor(1);
                                return;
                            }

                            plotCanvas.fadeCursor(clamp(1 - (yd - snap) / 100, 0, 1));
                        }
                    } else {
                        if (Math.abs(d) > snap) {
                            moving = true;
                        }
                        plotMover.move(d);
                    }
                }

                onReleased: {
                    release();
                }

                onPressAndHold: {
                    if (cancelAction) {
                        return;
                    }

                    if (!moving && (dist2d(mouse) < snap || !holdCursor)) {
                        holdCursor = true;
                        moveCursor = true;
                        plotCanvas.spawnCursorCoord(x(mouse));
                    }
                }
            }

            Canvas {
                id: plotCanvas
                anchors.centerIn: parent
                width: parent.width
                height: parent.height
                visible: plotData.dataReady
                contextType: "2d"

                property real position: NaN
                property real window

                property int padding: 8
                property int toolbarHeight: unit
                property int bottomHeight: 20

                property real length: width
                property real xLength: width - 2 * padding
                property real yLength: height - toolbarHeight - bottomHeight

                property var cursor: null
                property real cursorOpacity: 1

                // for hysteresis (to prevent blinking)
                property bool paintDotsHyst: false
                property real hystWindow

                Connections {
                    target: plotData

                    function onDataUpdate() {
                        if (isNaN(plotCanvas.position)) {
                            if (plot.followEnd) {
                                plotCanvas.position = plotData.timeEnd - plotCanvas.window;
                                plotMover.followPosition();
                            } else {
                                plotCanvas.position = plotData.timeStart;
                                plotCanvas.window = plotData.timeRange;
                            }
                        }

                        if (plot.followEnd && plotMover.following) {
                            plotMover.positionFollower = plotData.timeEnd - plotCanvas.window;
                        }
                    }

                    function onScalesUpdate() {
                        plotCanvas.requestPaint();
                    }
                }

                onVisibleChanged: requestPaint();
                onPositionChanged: requestPaint();
                onWindowChanged: requestPaint();
                onCursorChanged: requestPaint();
                onCursorOpacityChanged: requestPaint();

                QtObject {
                    id: plotMover

                    property real bounceOffset: 0.05
                    property real minWindow: 0.001 * plot.ticksPerSecond
                    property real maxWindow: Math.max(plot.followEnd ? plot.startWindow * plot.ticksPerSecond : 0, Math.min(plot.maxWindowMinutes * 60 * plot.ticksPerSecond, plotData.timeRange))

                    property real moveReferencePos
                    property real moveUnbluntedPos
                    property real animWin

                    property real zoomCenter

                    property real lastDist
                    property real lastTime
                    property real speed
                    property real zoomDampen
                    property real positionFollower
                    property real lastZoomCenter

                    property bool grabbed
                    property bool moving
                    property bool rolling
                    property bool following

                    onAnimWinChanged: {
                        zoom(animWin, zoomCenter);
                    }

                    onPositionFollowerChanged: {
                        if (following) {
                            plotCanvas.position = positionFollower;
                        }
                    }

                    Behavior on positionFollower {
                        id: positionFollowerBehavior
                        NumberAnimation {
                            easing.type: Easing.OutExpo
                            duration: 800
                        }
                    }

                    function followPosition() {
                        positionFollowerBehavior.enabled = false;
                        positionFollower = plotCanvas.position;
                        positionFollowerBehavior.enabled = true;
                        following = true;
                    }

                    function grab() {
                        moveReferencePos = plotCanvas.position;
                        animWin = plotCanvas.window;

                        lastDist = 0;
                        lastTime = 0;
                        speed = 0;

                        grabbed = true;
                        moving = false;
                        rolling = false;
                        following = false;

                        zoomAnim.stop();
                        bounceBack.stop();
                        bounceBackZoom.stop();
                    }

                    function release() {
                        if (grabbed) {
                            snapToBounds();
                        }
                        grabbed = false;
                    }

                    function blunt(x, a) {
                        return a * Math.exp(x / a) - a;
                    }

                    function moveRelative(pos, x) {
                        moveUnbluntedPos = plotCanvas.toPlotPos(pos, x);
                        var newPos = moveUnbluntedPos;

                        var endPos = plotData.timeEnd - plotCanvas.window;
                        var startPos = plot.followEnd && plotCanvas.window > plotData.timeRange ? endPos : plotData.timeStart;

                        var startDist = newPos - startPos;
                        if (startDist < 0) {
                            newPos += -startDist + blunt(startDist / plotCanvas.window, bounceOffset) * plotCanvas.window;
                        }

                        var endDist = endPos - newPos;
                        if (endDist < 0) {
                            newPos += endDist - blunt(endDist / plotCanvas.window, bounceOffset) * plotCanvas.window;
                        }

                        var ret = plotCanvas.toCanvasPos(newPos);
                        plotCanvas.position = newPos;

                        return ret;
                    }

                    function move(dist, isZooming) {
                        moveRelative(moveReferencePos, dist);

                        var now = Date.now();
                        var dt = now - lastTime;
                        if (dt === 0) {
                            // seems to happen on desktop with mouse only
                            return;
                        }

                        var alpha = 0.9;
                        if (isZooming) {
                            zoomDampen = alpha;
                        } else {
                            alpha -= zoomDampen;
                        }
                        var s = (dist - lastDist) / dt * 1000;
                        speed += alpha * (s - speed);
                        zoomDampen = Math.max(zoomDampen * 0.98 - 0.002, 0);

                        moving = true;
                        lastDist = dist;
                        lastTime = now;
                    }

                    function zoomPosOffset(oldWindow, newWindow, center) {
                        var perc = oldWindow / newWindow - 1;
                        return (plotCanvas.toPlotPos(plotCanvas.position, center, newWindow) - plotCanvas.position) * perc;
                    }

                    function zoom(newWindow, center) {
                        bounceBackZoom.stop();
                        lastZoomCenter = center;

                        var maxWin = maxWindow;
                        var maxDist = maxWin - newWindow;
                        if (maxDist < 0) {
                            newWindow = (1 - blunt(maxDist / maxWin, bounceOffset * 2)) * maxWin;
                        }

                        var minDist = newWindow - minWindow;
                        if (minDist < 0) {
                            newWindow = (1 + blunt(minDist / minWindow, bounceOffset * 2)) * minWindow;
                        }

                        var posOffset = zoomPosOffset(plotCanvas.window, newWindow, center);
                        moveReferencePos += posOffset;
                        plotCanvas.position = plotCanvas.position + posOffset;
                        plotCanvas.window = newWindow;
                    }

                    function flick() {
                        grabbed = false;
                        rolling = true;
                    }

                    function snapToBounds() {
                        var windowTo = clamp(plotCanvas.window, minWindow, maxWindow);

                        bounceBackZoom.stop();
                        bounceBackZoom.to = windowTo;
                        bounceBackZoom.start();

                        if (plot.followEnd && (plotCanvas.window > plotData.timeRange || plotCanvas.position > plotData.timeEnd - plotCanvas.window * 1.05)) {
                            plotMover.followPosition();
                        } else {
                            bounceBack.stop();
                            var newPos = plotCanvas.position + zoomPosOffset(plotCanvas.window, windowTo, lastZoomCenter);
                            bounceBack.to = clamp(newPos, plotData.timeStart, plotData.timeEnd - windowTo);
                            bounceBack.start();
                        }
                    }

                    function zoomAnimated(by, center) {
                        zoomCenter = center;

                        if (!zoomAnim.running) {
                            zoomAnim.to = animWin / by;
                        } else {
                            zoomAnim.stop();
                            zoomAnim.to /= by;
                        }

                        zoomAnim.start();
                    }
                }

                Timer {
                    id: plotFlickTimer
                    repeat: true
                    interval: dt * 1000
                    running: plotCanvas.visible

                    property real dt: 1 / 30

                    onTriggered: {
                        var sign = plotMover.speed < 0 ? -1 : 1;
                        if (plotMover.speed * sign > 0) {
                            var d = plotMover.speed * dt;

                            if (plotMover.rolling) {
                                var realD = plotMover.moveRelative(plotMover.moveUnbluntedPos, d);

                                if (sign * realD < sign * d - 0.000001) {
                                    // we hit the edge, real speed is now much slower
                                    plotMover.speed = realD / dt;
                                    plotMover.speed -= sign * 0.1;
                                } else {
                                    // very gradual deceleration during normal rolling
                                    plotMover.speed *= 0.98;
                                    plotMover.speed -= sign * 2;
                                }
                            } else if (!plotMover.moving) {
                                // fast decay when plot is being held in place without moving (i.e. no mouse events incoming)
                                plotMover.speed *= 0.7;
                                plotMover.speed -= sign * 20;
                            }

                            plotMover.moving = false;
                        }

                        if (plotMover.speed * sign <= 0) {
                            plotMover.speed = 0;
                            if (plotMover.rolling) {
                                plotMover.snapToBounds();
                            }
                            plotMover.rolling = false;
                        }
                    }
                }

                NumberAnimation {
                    id: zoomAnim
                    target: plotMover
                    property: "animWin"
                    easing.type: Easing.OutQuad
                    duration: 200

                    onFinished: {
                        plotMover.release();
                    }
                }

                NumberAnimation {
                    id: bounceBack
                    target: plotCanvas
                    property: "position"
                    easing {
                        type: Easing.OutBack
                        amplitude: 2.0
                        period: 0.5
                    }
                    duration: 300
                }

                NumberAnimation {
                    id: bounceBackZoom
                    target: plotCanvas
                    property: "window"
                    easing {
                        type: Easing.OutBack
                        amplitude: 2.0
                        period: 0.5
                    }
                    duration: 300
                }

                function toPlotPos(oldPos, x, win) {
                    if (win === undefined) {
                        win = window;
                    }
                    return oldPos + x / xLength * win;
                }

                function toCanvasPos(pos) {
                    return (pos - position) / window * xLength;
                }

                function isCursorPosValid(pos) {
                    if (pos < plotData.timeStart || pos < position || pos > position + window || pos > plotData.timeEnd) {
                        return false;
                    }

                    return true;
                }

                function spawnCursorCoord(x) {
                    spawnCursor(toPlotPos(position, x));
                }

                function spawnCursor(cursorPos) {
                    if (!isCursorPosValid(cursorPos)) {
                        return;
                    }

                    for (var i = 0; i < plotData.data.length; i++) {
                        var time1 = plotData.data[i][0];
                        if (cursorPos < time1) {
                            if (i === 0) {
                                cursor = plotData.data[i];
                            } else {
                                var time2 = plotData.data[i - 1][0];
                                if (dist(cursorPos, time1) < dist(cursorPos, time2)) {
                                    cursor = plotData.data[i];
                                } else {
                                    cursor = plotData.data[i - 1];
                                }
                            }
                            break;
                        }
                    }
                }

                function getCursorPosIfCan() {
                    if (!cursor) {
                        return null;
                    }

                    var pos = cursor[0];
                    if (!isCursorPosValid(pos)) {
                        return null;
                    }

                    return toCanvasPos(pos);
                }

                function fadeCursor(a=0) {
                    a = a * a * a;
                    if (a <= 0.05) {
                        cursor = null;
                    } else {
                        cursorOpacity = a;
                    }
                }

                function reset() {
                    position = NaN;
                    window = plot.startWindow * plot.ticksPerSecond;
                    cursor = null;
                }

                function pointYCoord(point, n) {
                    return point[n + 1] * yLength * plotData.scales[n];
                }

                function timeFormat(s, decimals) {
                    var res = "";
                    if (s > 60) {
                        var m = Math.floor(s / 60);
                        s -= m * 60;
                        if (m > 60) {
                            var h = Math.floor(m / 60);
                            m = String(m - h * 60).padStart(2, "0");
                            res += h + ":";
                        }
                        res += m + ":";
                    }

                    if (s < 10) {
                        res += "0";
                    }

                    if (decimals !== undefined) {
                        res += s.toFixed(decimals);
                    } else {
                        res += s.toFixed(6) / 1;
                    }

                    return res;
                }

                function paintXAxis(ctx, yMax, yMin) {
                    ctx.beginPath();
                    ctx.lineWidth = 1;
                    ctx.strokeStyle = plot.themeColor("disabledText");

                    ctx.moveTo(-padding, 0);
                    ctx.lineTo(xLength + padding, 0);
                    ctx.stroke();

                    if (window == 0 || xLength == 0) {
                        // prevent an infinite loop
                        return;
                    }

                    var basePixelsPerTick = 60;

                    var calcTick = function(extraWidth) {
                        var mult = 1;
                        var tick = window / xLength * (basePixelsPerTick + extraWidth);

                        while (tick < 1) {
                            mult *= 0.1;
                            tick *= 10;
                        }

                        while (tick > 10) {
                            mult *= 10;
                            tick *= 0.1;
                        }

                        if (tick > 5) {
                            tick = 5;
                        } else if (tick > 2) {
                            tick = 2;
                        } else {
                            tick = 1;
                        }

                        return tick * mult;
                    }

                    // estimate label width
                    var digitSize = ctx.measureText("8").width;
                    var sepSize = ctx.measureText(":").width;
                    var sampleTime = plotData.timeEnd;
                    var decs = Math.max(-Math.log10(window / xLength * basePixelsPerTick), 0);
                    var estimatedExtraWidth = decs * digitSize + sepSize;
                    if (sampleTime >= 60) {
                        estimatedExtraWidth += digitSize + sepSize;
                    }
                    if (sampleTime >= 600) {
                        estimatedExtraWidth += digitSize;
                    }
                    if (sampleTime >= 3600) {
                        estimatedExtraWidth += digitSize + sepSize;
                    }

                    var tick = calcTick(Math.max(0, estimatedExtraWidth - 10) * 3.6);

                    ctx.beginPath();
                    ctx.textAlign = "center";
                    ctx.fillStyle = plot.themeColor("disabledText");
                    ctx.strokeStyle = plot.themeColor("darkBackground");
                    var notch = Math.floor(position / tick) * tick;
                    var maxNotch = Math.ceil((position + window) / tick) * tick;
                    var ticksPerSec = plot.ticksPerSecond;
                    while (notch <= maxNotch) {
                        var coord = toCanvasPos(notch);
                        ctx.moveTo(coord, -yMax);
                        ctx.lineTo(coord, -yMin);

                        var decimals = Math.max(Math.ceil(-Math.log10(tick / ticksPerSec)), 0);
                        ctx.fillText(timeFormat(notch / ticksPerSec, decimals), coord, -yMin + 15);
                        ctx.stroke();

                        notch += tick;
                    }

                    ctx.stroke();
                }

                function paintCursor(ctx, yMax, yMin) {
                    var time = cursor[0];
                    if (time < position || time > position + window) {
                        return;
                    }

                    var originalAlpha = ctx.globalAlpha;
                    ctx.globalAlpha = cursorOpacity;

                    ctx.beginPath();
                    ctx.lineWidth = 1;
                    ctx.strokeStyle = plot.themeColor("normalText");

                    var cursorCoord = toCanvasPos(cursor[0]);
                    ctx.moveTo(cursorCoord, -yMax - 3);
                    ctx.lineTo(cursorCoord, -yMin + 3);
                    ctx.stroke();

                    ctx.textAlign = "center";
                    ctx.textBaseline = "top";
                    ctx.fillStyle = plot.themeColor("normalText");
                    var text = timeFormat(time / plot.ticksPerSecond);
                    var rectWidth = ctx.measureText(text).width + 20;
                    var rectHalfWidth = rectWidth / 2;
                    var removePadding = padding + 5;
                    var xTextCoord = clamp(cursorCoord, rectHalfWidth - removePadding, xLength - rectHalfWidth + removePadding - 1);
                    var yTextCoord = -yMin + 5;
                    ctx.rect(xTextCoord - rectHalfWidth, yTextCoord, rectWidth, 14);

                    var pc = plot.color;
                    ctx.fillStyle = Qt.rgba(pc.r, pc.g, pc.b, 0.7);
                    ctx.fill();
                    ctx.fillStyle = plot.themeColor("normalText");
                    ctx.fillText(text, xTextCoord, yTextCoord);
                    ctx.textBaseline = "alphabetic";

                    var textHeight = 10;
                    var yOffset = 4;
                    var labelHeight = textHeight + yOffset;
                    var topLimit = yMax - textHeight - 1;
                    var bottomLimit = yMin + 1;
                    var pd = plotData;
                    var series = pd.series;

                    var textX = cursorCoord;
                    var textFormat;
                    if (cursorCoord > xLength / 2) {
                        textX -= 4;
                        ctx.textAlign = "right";
                        textFormat = "%2  %1";
                    } else {
                        textX += 4;
                        ctx.textAlign = "left";
                        textFormat = "%1  %2";
                    }

                    var vals = [];
                    for (var n = 0; n < pd.sampleSize; n++) {
                        if (!series[n].visible) {
                            continue;
                        }
                        var y = pointYCoord(cursor, n);
                        if (!Number.isNaN(y)) {
                            vals.push([y, series[n].sortOrder, n]);
                        }
                    }

                    vals.sort((a, b) => b[0] !== a[0] ? b[0] - a[0] : a[1] - b[1]);

                    ctx.strokeStyle = "#000000";
                    ctx.lineWidth = 3;
                    for (var i = 0; i < vals.length; i++) {
                        var p = vals[i];
                        var n = p[2];
                        ctx.fillStyle = series[n].color;
                        var str = textFormat.arg(Number(cursor[n + 1].toPrecision(4))).arg(series[n].name);
                        var textY = Math.min(p[0] + yOffset, topLimit);
                        textY = Math.max(bottomLimit + (vals.length - i - 1) * labelHeight, textY);
                        topLimit = textY - labelHeight;

                        ctx.strokeText(str, textX, -textY);
                        ctx.fillText(str, textX, -textY);
                    }

                    ctx.globalAlpha = originalAlpha;
                }

                function paintSeries(ctx, yMax, yMin) {
                    var lineWidth = 1;
                    ctx.lineWidth = lineWidth;

                    // optimization: local variables are much faster than property resolution
                    var pd = plotData;
                    var data = pd.data;
                    var scales = pd.scales;
                    var sampleSize = pd.sampleSize;
                    var yLen = yLength;
                    var pos = position;
                    var win = window;
                    var xLen = xLength;
                    var dotsEnbld = plot.dotsEnabled;

                    // calculate start and end indices according to window
                    var start = 0;
                    var end = data.length;

                    var winNotChangedFactor = Math.abs(win - hystWindow) < 0.0001 ? 2 : 1;
                    hystWindow = win;

                    var pixelsPerTimeUnit = xLen / win;
                    var prevTime = null;
                    var paintDots = true;
                    var dotsThreshold = 20 / (paintDotsHyst ? 1 : (0.8 / winNotChangedFactor));
                    var distanceSum = 0;
                    var minDistance = 1e10;
                    var windowSize = 4;
                    var lastFour = [];
                    for (var i = start; i < end; i++) {
                        var t = data[i][0];
                        if (t < pos) {
                            start = i;
                        } else {
                            if (t > pos + win) {
                                end = Math.min(i + 1, data.length);
                                break;
                            }

                            // measure point distance until we measure enough to disable painting plot dots
                            // (or never reach enough distance and paint the dots)
                            if (prevTime !== null) {
                                var distance = (t - prevTime) * pixelsPerTimeUnit;
                                distanceSum += distance;
                                lastFour.push(distance);

                                if (lastFour.length > 4) {
                                    distanceSum -= lastFour.shift();
                                }

                                if (lastFour.length === 4) {
                                    if (distanceSum / 4 < dotsThreshold) {
                                        paintDots = false;
                                    }

                                    minDistance = Math.min(minDistance, distanceSum);
                                }
                            }
                            prevTime = t;
                        }
                    }

                    if (lastFour.length < 4 && distanceSum / lastFour.length < dotsThreshold) {
                        paintDots = false;
                    }
                    minDistance = Math.min(minDistance, distanceSum);

                    var dotDistThreshold = Math.max(minDistance / lastFour.length * 3, 10);

                    paintDotsHyst = paintDots;

                    var step = 0.5 / Screen.devicePixelRatio;
                    var justOutOfMinMax = false;
                    var halfASecondPixels = 0.5 * plot.ticksPerSecond * xLen / win;

                    var srsSorted = pd.seriesSorted;
                    for (var k = srsSorted.length - 1; k >= 0; k--) {
                        var series = srsSorted[k];
                        if (!series.visible) {
                            continue;
                        }

                        ctx.beginPath();
                        var color = series.color;
                        ctx.strokeStyle = color;
                        ctx.fillStyle = color;

                        var n = series.dataOrder;
                        var nScale = scales[n];
                        var min = -1e30;
                        var max = 1e30;
                        var lastX = -0.001;
                        var lastSampleX = -0.001;
                        var lastY = 0;
                        var lastDrawnX = 0;
                        var minMaxMode = false;
                        var drawnLastDot = false;
                        for (var i = start; i < end; i++) {
                            var point = data[i];
                            var nPoint = point[n + 1];

                            // optimization: instead of toCanvasPos(point[0])
                            var x = (point[0] - pos) / win * xLen;

                            // optimization: NaN check by comparison instead of Number.isNaN()
                            if (nPoint !== nPoint) {
                                lastSampleX = x;
                                continue;
                            }

                            var y = -nPoint * yLen * nScale;
                            var origX = x;

                            // handle trimming lines at plot edges
                            if (i === start && x < 0) {
                                var nextPoint = data[i + 1];
                                var nextX = (nextPoint[0] - pos) / win * xLen;
                                var nextY = -nextPoint[n + 1] * yLen * nScale;
                                y += (nextY - y) * x / (x - nextX);
                                x = 0;
                            } else if (i === end - 1 && x > xLen) {
                                y -= (y - lastY) * (x - xLen) / (x - lastX);
                                x = xLen;
                            }

                            if (i > start && x - lastX < step) {
                                minMaxMode = true;
                            }

                            if (minMaxMode) {
                                // min-max algorithm for dynamically "downsampling" the series
                                if (x - lastDrawnX > step) {
                                    var miny = min;
                                    var maxy = max;
                                    var dist = miny - maxy;
                                    if (dist < lineWidth) {
                                        var offset = (lineWidth - dist) / 2;
                                        miny += offset;
                                        maxy -= offset;
                                    }

                                    ctx.moveTo(lastX, miny);
                                    ctx.lineTo(lastX, maxy);

                                    var tmp = min;
                                    min = max;
                                    max = tmp;

                                    lastDrawnX = x;

                                    if (x - lastX > step) {
                                        minMaxMode = false;
                                        justOutOfMinMax = true;
                                        ctx.moveTo(lastX, lastY);
                                    }
                                }

                                min = y > min ? y : min;
                                max = y < max ? y : max;
                            }

                            if (!minMaxMode) {
                                if (dotsEnbld && origX - lastX > halfASecondPixels) {
                                    ctx.moveTo(x, y);
                                } else {
                                    ctx.lineTo(x, y);
                                }

                                min = y;
                                max = y;
                                lastDrawnX = x;
                                justOutOfMinMax = false;
                            }

                            if (dotsEnbld && i > start && origX >= 0 && (paintDots || x - lastSampleX > dotDistThreshold || origX - lastSampleX > halfASecondPixels)) {
                                ctx.stroke();
                                ctx.beginPath();
                                if (!drawnLastDot && lastX >= 0) {
                                    ctx.arc(lastX, lastY, 2.5, 0, 2 * Math.PI, false);
                                }
                                if (origX <= xLen + 0.001) {
                                    ctx.arc(x, y, 2.5, 0, 2 * Math.PI, false);
                                }
                                ctx.fill();
                                ctx.beginPath();
                                if (justOutOfMinMax) {
                                    ctx.moveTo(lastX, lastY);
                                } else {
                                    ctx.moveTo(x, y);
                                }
                                drawnLastDot = true;
                            } else {
                                // move to the same point to draw a series of disconnected lines,
                                // which is much faster
                                ctx.moveTo(x, y);
                                drawnLastDot = false;
                            }

                            lastX = origX;
                            lastSampleX = origX;
                            lastY = y;
                        }
                        ctx.stroke();
                    }
                }

                onPaint: {
                    if (!visible) {
                        return;
                    }

                    var ctx = getContext("2d");
                    ctx.reset();

                    if (!plotData.dataReady) {
                        return;
                    }

                    var yMax = yLength * plotData.positiveRatio;
                    var yMin = yLength * (plotData.positiveRatio - 1);

                    ctx.translate(padding, yMax + toolbarHeight);

                    paintXAxis(ctx, yMax, yMin);

                    paintSeries(ctx, yMax, yMin);

                    if (cursor !== null) {
                        paintCursor(ctx, yMax, yMin);
                    }
                }
            }
        }
    }

    component OverlayPlot : Plot {
        anchors.centerIn: parent
        height: vertical ? parent.width : parent.height
        width: vertical ? parent.height : parent.width
        rotation: vertical ? 90 : 0
        z: 100
        visible: false

        property bool vertical: parent.height > parent.width

        showRecordDownload: parent.state.capDataRecord
        toolbarOffset: 0.9

        FloatingToolButton {
            anchors.top: parent.top
            anchors.left: parent.left
            width: 0.8 * unit
            height: 0.8 * unit

            iconPath: Path {
                PathSvg {path: "M 15 15 L 35 35 M 15 35 L 35 15"}
            }

            onClicked: {
                parent.visible = false;
            }
        }
    }

    component StatusText : Item {
        property var globState

        MouseArea {
            anchors.fill: parent
            onClicked: alertsDialog.show()
        }

        states: [
            State {
                name: "specialMode"
                when: statusTextMode.visible || statusTextAlert.visible
                AnchorChanges {target: statusTextState; anchors.top: parent.top; anchors.verticalCenter: undefined;}
            }
        ]

        SwLText {
            id: statusTextState
            anchors.verticalCenter: parent.verticalCenter
            width: parent.width
            font.pixelSize: (statusTextMode.visible && statusTextAlert.visible ? 0.3 : globState.pkgStateString.length >= 10 ? 0.42 : 0.55) * unit
            font.family: "Exan"
            horizontalAlignment: Text.AlignHCenter
            verticalAlignment: Text.AlignVCenter
            text: globState.pkgStateString
        }

        Glow {
            property bool red: globState.isError
            property bool dark: globState.darkride
            property bool blue: globState.pkgState == globState.s_Running

            anchors.fill: statusTextState
            radius: Math.round((dark ? 0.2 : 0.12) * unit)
            samples: radius * 2 + 1
            spread: red ? 0.6 : (dark ? 0.7 : 0.5)
            opacity: red || dark || blue ? 0.8 : 0.3

            color: {
                if (red) {
                    return swTheme.color("red");
                } else if (dark) {
                    return Utility.isDarkMode() ? swTheme.color("black") : swTheme.color("disabledText");
                } else if (blue) {
                    return swTheme.color("lightAccent");
                } else {
                    return swTheme.color("lightText");
                }
            }
            source: statusTextState
        }

        Text {
            id: statusTextMode
            anchors.top: statusTextState.bottom
            width: parent.width
            color: globState.pkgMode == globState.m_Flywheel ? swTheme.color("lightAccent") : swTheme.color("lightText")
            font.pixelSize: statusTextAlert.visible ? fontSizeSuperSmall : fontSizeSmall
            font.family: "Exan"
            horizontalAlignment: Text.AlignHCenter
            verticalAlignment: Text.AlignVCenter
            visible: globState.pkgMode != globState.m_Normal
            text: globState.pkgModeString
        }

        Glow {
            anchors.fill: statusTextMode
            radius: Math.round(0.12 * unit)
            samples: radius * 2 + 1
            opacity: 0.3
            color: statusTextMode.color
            visible: globState.pkgMode != globState.m_Normal
            source: statusTextMode
        }

        Text {
            id: statusTextAlert

            property var alert: alerts.getActiveAlertData(alerts.activeAlertHighlight)
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.top: statusTextMode.visible ? statusTextMode.bottom : statusTextState.bottom
            width: parent.width * 1.2
            color: alerts.severityColors.get(alert.severity)
            font.pixelSize: fontSizeSuperSmall
            font.family: "Mono"
            horizontalAlignment: Text.AlignHCenter
            verticalAlignment: Text.AlignVCenter
            elide: Text.ElideMiddle
            visible: alerts.activeAlertCount > 0
            text: alert.name
        }

        Glow {
            anchors.fill: statusTextAlert
            radius: Math.round(0.12 * unit)
            samples: radius * 2 + 1
            opacity: 0.3
            color: statusTextAlert.color
            visible: statusTextAlert.visible
            source: statusTextAlert
        }
    }

    function locateButton(comp, name) {
        for (var i = 0; i < comp.children.length; i++) {
            var child = comp.children[i];
            if (child.toString().startsWith("Button_QMLTYPE") && child.text === name) {
                return child;
            }
            var res = locateButton(child, name);
            if (res) {
                return res;
            }
        }

        return null;
    }

    Timer {
        id: onStartupTimer
        interval: 10

        onTriggered: {
            updateChecker.check();
        }
    }

    property var customConfigWriteButton: null

    Component.onCompleted: {
        if (typeof confCustomLoader !== typeof undefined) {
            // There is no reliable "config updated" signal, we have to hook onto
            // the VESC Tool custom config buttons (works for QML only, not
            // for the desktop app config page).
            print("{{PACKAGE_NAME}}: Hooking custom config Write button...");
            customConfigWriteButton = locateButton(confCustomLoader.item, "Write");
            if (customConfigWriteButton) {
                customConfigWriteButton.clicked.connect(packageConfig.configWritten);
            } else {
                print("{{PACKAGE_NAME}}: Failed to locate Write button.");
            }
        }

        // rf90: no welcome dialog / upstream hint pages on start; the
        // Rink-Mixed tour opens once instead (SKIP closes it)
        // rf93: the disclaimer opens every time (until "don't show again"),
        // the tour after it on first start
        if (swSettings.ledSnoozeMin === 255) swSettings.ledSnoozeMin = 5;  // rf100: old AUTO
        // rf97: SNOOZE BREATHING OFF from before -> DARK snooze style
        if (!swSettings.ledDozeBreath && swSettings.ledSnoozeStyle === 0) swSettings.ledSnoozeStyle = 2;
        if (!swSettings.hideDisclaimer) disclaimerDialog.open();
        else if (!swSettings.tourSeen) rinkTour.open();

        onStartupTimer.start();
    }

    Component.onDestruction: {
        if (typeof confCustomLoader !== typeof undefined) {
            print("{{PACKAGE_NAME}}: Unhooking custom config Write button...");
            if (customConfigWriteButton) {
                customConfigWriteButton.clicked.disconnect(packageConfig.configWritten);
            } else {
                print("{{PACKAGE_NAME}}: Write button was not set.");
            }
        }
    }

    Dl.FileDialog {
        id: jsonSaveDialog
        title: "Choose a file to save"
        nameFilters: ["JSON (*.json)"]
        selectExisting: false

        property string jsonData

        function show(data) {
            if (!Utility.requestFilePermission()) {
                VescIf.emitMessageDialog(
                            "File Permissions",
                            "Unable to request file system permission.",
                            false, false);
                return;
            }

            jsonData = JSON.stringify(data, null, 4);
            open();
        }

        onAccepted: {
            var fUrl = fileUrl.toString();
            if (!fUrl.toLowerCase().endsWith(".json")) {
                fUrl += ".json";
            }

            var request = new XMLHttpRequest();
            request.open("PUT", fUrl, false);
            request.send(jsonData);

            if (request.status === 0) {
                VescIf.emitStatusMessage("File saved", true);
            } else {
                VescIf.emitStatusMessage("Save failed: %1".arg(request.status), false);
            }
        }
    }

    // Re-RinkFloat: pick an LCM firmware .hex for FLASH LCM
    Dl.FileDialog {
        id: hexLoadDialog
        title: "Choose an LCM firmware .hex"
        nameFilters: ["Intel HEX (*.hex)", "All files (*)"]
        selectExisting: true

        function show() {
            if (!Utility.requestFilePermission()) {
                VescIf.emitMessageDialog("File Permissions", "Unable to request file system permission.", false, false);
                return;
            }
            open();
        }

        onAccepted: {
            var fUrl = fileUrl.toString();
            var request = new XMLHttpRequest();
            request.open("GET", fUrl, false);
            request.send(null);
            if (request.status === 200 || (request.status === 0 && request.responseText.length > 0)) {
                lcmFw.loadHexText(request.responseText, decodeURIComponent(fUrl.split("/").pop()));
            } else {
                lcmFw.message = "Couldn't open the file (%1).".arg(request.status);
            }
        }
    }

    Dl.FileDialog {
        id: jsonLoadDialog
        title: "Choose a file to load"
        nameFilters: ["JSON (*.json)"]
        selectExisting: true

        function show() {
            if (!Utility.requestFilePermission()) {
                VescIf.emitMessageDialog(
                            "File Permissions",
                            "Unable to request file system permission.",
                            false, false);
                return;
            }

            applyConfigDialog.open();
            open();
        }

        onAccepted: {
            var fUrl = fileUrl.toString();

            var request = new XMLHttpRequest();
            request.open("GET", fUrl, false);
            request.send(null);

            if (request.status === 200) {
                applyConfigDialog.set(JSON.parse(request.responseText));
            } else {
                VescIf.emitStatusMessage("Opening file failed: %1".arg(request.status), false);
            }
        }

        onRejected: {
            applyConfigDialog.close();
        }
    }

    BaseDialog {
        id: settingsDialog
        implicitHeight: fullHeight

        title: "Settings"
        standardButtons: Dialog.NoButton

        footer: Item {
            implicitHeight: 1.2 * unit
            SwPill {
                anchors.centerIn: parent
                minWidth: 3.0 * unit
                label: "CLOSE"
                onClicked: settingsDialog.close()
            }
        }

        function show(tab) {
            settingsTabBar.currentIndex = tab || 0;
            open();
        }

        component RightSwitch : RowLayout {
            Layout.fillWidth: true

            property string label
            property alias checked: swtch.checked

            LText {
                color: swTheme.neonGreen  // rf81: neon settings text
                Layout.fillWidth: true
                text: parent.label
            }

            Switch {
                id: swtch
            }
        }

        component IntTextField : RowLayout {
            Layout.fillWidth: true

            property string label
            property string valueUnit: ""
            property int value
            property int sourceValue

            property int minValue: 0
            property int maxValue: 100

            LText {
                color: swTheme.neonGreen  // rf81: neon settings text
                Layout.fillWidth: true
                text: parent.label
            }

            TextField {
                id: textField
                implicitWidth: 50

                maximumLength: 4
                horizontalAlignment: TextInput.AlignRight
                inputMethodHints: Qt.ImhDigitsOnly
                // rf81: our own neon number pad (with DONE) instead of the
                // phone's grey keyboard
                readOnly: true
                color: swTheme.neonGreen
                font.family: "Exan"

                MouseArea {
                    anchors.fill: parent
                    onClicked: numPad.edit(textField.parent.label, textField.parent.value, textField.parent.minValue,
                        textField.parent.maxValue, textField.parent.valueUnit, function(v) { textField.text = String(v); })
                }

                property string prevText

                onTextChanged: {
                    if (text !== "") {
                        var number = Number(text);
                        if (number > maxValue) {
                            text = prevText;
                        } else if (number < minValue) {
                            parent.value = Math.max(number, minValue);
                        } else {
                            parent.value = number;
                            prevText = text;
                        }
                    }
                }

                onActiveFocusChanged: {
                    if (!activeFocus) {
                        text = parent.value;
                    }
                }

                Component.onCompleted: {
                    text = parent.sourceValue;
                    prevText = text;
                }
            }

            LText {
                color: swTheme.neonGreen  // rf81: neon settings text
                text: parent.valueUnit
            }
        }

        component Heading : LText {
            Layout.fillWidth: true
            Layout.topMargin: 10
            horizontalAlignment: TextInput.AlignHCenter
            color: swTheme.neonGreen
            font.family: "Exan"
            font.pixelSize: 0.32 * unit
        }

        component SubHeading : LText {
            Layout.fillWidth: true
            Layout.topMargin: 10
            horizontalAlignment: TextInput.AlignHCenter
            font.pointSize: 14
        }

        component OptionDescription : NText {
            Layout.fillWidth: true
            Layout.leftMargin: 20
            Layout.rightMargin: 20
            Layout.topMargin: -7
            color: "#9d8ac0"
            font.pixelSize: 0.2 * unit
            horizontalAlignment: TextInput.AlignHCenter
            wrapMode: Text.WordWrap
        }

        component SetupDescription : NText {
            Layout.fillWidth: true
            horizontalAlignment: TextInput.AlignHCenter
            wrapMode: Text.WordWrap
            color: "#cbb8ec"
            font.pixelSize: 0.22 * unit
        }

        ColumnLayout {
            width: settingsDialog.availableWidth
            height: parent.height
            spacing: 0.15 * unit

            // Re-Float Rink-Mixed: neon tab pills instead of the stock TabBar
            Row {
                id: settingsTabBar
                Layout.alignment: Qt.AlignHCenter
                spacing: 0.2 * unit
                property int currentIndex: 0
                onCurrentIndexChanged: settingsStackLayout.currentIndex = currentIndex

                Repeater {
                    model: ["SETUP", "PREFERENCES"]
                    SwPill {
                        minWidth: 3.0 * unit
                        label: modelData
                        lit: settingsTabBar.currentIndex === index
                        onClicked: settingsTabBar.currentIndex = index
                    }
                }
            }

            StackLayout {
                id: settingsStackLayout
                Layout.fillWidth: true
                Layout.fillHeight: true
                clip: true

                ScrollView {
                    Layout.fillWidth: true
                    Layout.fillHeight: true
                    contentWidth: availableWidth
                    clip: true

                    ColumnLayout {
                        width: parent.width
                        spacing: 0.25 * unit

                        SettingsCard {
                            title: "PACKAGE"

                            SetupDescription {
                                text: "Before running the motor wizard, disable the package so the two don't fight over the motor. Re-enable it after configuring your motor."
                            }

                            NeonButton {
                                Layout.alignment: Qt.AlignHCenter
                                lit: state.pkgState === state.s_Disabled
                                text: state.pkgState === state.s_Disabled ? "Enable package" : "Disable package"
                                onClicked: packageConfig.setDisabled(state.pkgState !== state.s_Disabled)
                            }
                        }

                        SettingsCard {
                            title: "HANDTEST"

                            SetupDescription {
                                text: "After setup, turn on Handtest and engage the board by hand to check it balances the right way. Motor currents are limited to a safe level."
                            }

                            NeonButton {
                                Layout.alignment: Qt.AlignHCenter
                                // Only allow if no other mode is active
                                enabled: [state.m_Normal, state.m_Handtest].includes(state.pkgMode)
                                lit: state.pkgMode === state.m_Handtest
                                text: state.pkgMode === state.m_Handtest ? "Handtest off" : "Handtest on"
                                onClicked: commands.sendHandtest(state.pkgMode === state.m_Normal)
                            }

                            SetupDescription {
                                visible: state.pkgMode === state.m_Handtest
                                color: "#FFB300"
                                text: "Balances in reverse (shoots off)? Your Imu Rotation Yaw is off by 180\u00B0. Erratic? Likely off by 90\u00B0.\nWhile Handtest is on, writing the configuration is disabled."
                            }
                        }

                        SettingsCard {
                            title: "BACKUP / RESTORE"

                            SetupDescription {
                                text: "Backups are stored in VESC Tool's internal storage."
                            }

                            // one row per backup: name + date on the left, buttons on the right
                            RowLayout {
                                Layout.fillWidth: true
                                spacing: 0.15 * unit
                                ColumnLayout {
                                    Layout.fillWidth: true
                                    spacing: 0
                                    LText { text: "Automatic"; font.pixelSize: 0.26 * unit; color: swTheme.neonGreen }
                                    NText {
                                        id: setupAutoBackupDate
                                        property var backup: null
                                        font.pixelSize: 0.2 * unit
                                        color: "#9d8ac0"
                                        text: backup ? Qt.formatDateTime(backup.date) : "none yet"
                                        Connections {
                                            target: tuneManager
                                            function onAutoBackupFinished(backup) {
                                                setupAutoBackupDate.backup = backup;
                                            }
                                        }
                                    }
                                }
                                NeonButton { text: "View"; implicitWidth: 1.8 * unit; onClicked: tuneManager.autoRestore() }
                            }

                            Rectangle { Layout.fillWidth: true; height: 1; color: "#3a2266" }

                            RowLayout {
                                Layout.fillWidth: true
                                spacing: 0.15 * unit
                                ColumnLayout {
                                    Layout.fillWidth: true
                                    spacing: 0
                                    LText { text: "This board"; font.pixelSize: 0.26 * unit; color: swTheme.neonGreen }
                                    NText {
                                        id: setupIdBackupDate
                                        property var backup: null
                                        font.pixelSize: 0.2 * unit
                                        color: "#9d8ac0"
                                        text: backup ? Qt.formatDateTime(backup.date) : "none yet"
                                        Connections {
                                            target: tuneManager
                                            function onIdBackupFinished(backup) {
                                                setupIdBackupDate.backup = backup;
                                            }
                                        }
                                    }
                                }
                                NeonButton { text: "Backup"; implicitWidth: 1.8 * unit; onClicked: tuneManager.idBackup() }
                                NeonButton { text: "View"; implicitWidth: 1.8 * unit; onClicked: tuneManager.idRestore() }
                            }

                            Rectangle { Layout.fillWidth: true; height: 1; color: "#3a2266" }

                            RowLayout {
                                Layout.fillWidth: true
                                spacing: 0.15 * unit
                                ColumnLayout {
                                    Layout.fillWidth: true
                                    spacing: 0
                                    LText { text: "Shared"; font.pixelSize: 0.26 * unit; color: swTheme.neonGreen }
                                    NText {
                                        font.pixelSize: 0.2 * unit
                                        color: "#9d8ac0"
                                        text: tuneManager.fullBackup ? Qt.formatDateTime(tuneManager.fullBackup.date) : "none yet"
                                    }
                                }
                                NeonButton { text: "Backup"; implicitWidth: 1.8 * unit; onClicked: tuneManager.globalBackup() }
                                NeonButton { text: "View"; implicitWidth: 1.8 * unit; onClicked: tuneManager.globalRestore() }
                            }
                        }

                        Item { Layout.fillWidth: true; height: 0.2 * unit }
                    }
                }

                ScrollView {
                    Layout.fillWidth: true
                    Layout.fillHeight: true
                    contentWidth: availableWidth
                    clip: true

                    ColumnLayout {
                        width: parent.width
                        spacing: 0.25 * unit

                        SettingsCard {
                            title: "DASHBOARD"

                            IntTextField {
                                label: "Speed dial max"
                                valueUnit: vescConfig.speedUnit
                                sourceValue: preferences.speedDialMax
                                minValue: 10
                                maxValue: 200
                                onValueChanged: {
                                    preferences.speedDialMax = value
                                }
                            }

                            RightSwitch {
                                id: prefShowBattVoltage
                                checked: true
                                label: "Show battery voltage"
                            }

                            RightSwitch {
                                id: prefShowBattVoltagePerCell
                                label: "Battery voltage per cell"
                            }

                            RightSwitch {
                                id: prefBattCurrentLog
                                checked: true
                                label: "Log scale for the battery current bar"
                            }

                            IntTextField {
                                label: "Temperature warning offset"
                                valueUnit: "\u00B0C"
                                sourceValue: preferences.tempWarningOffset
                                onValueChanged: {
                                    preferences.tempWarningOffset = value
                                }
                            }

                            OptionDescription {
                                Layout.topMargin: 0
                                text: "Motor / controller temperatures turn red above TEMP - OFFSET (TEMP = your Motor / MOSFET Temp Cutoff Start). The package beeps at TEMP - 3\u00B0C and pushback starts at TEMP - 2\u00B0C."
                            }
                        }

                        SettingsCard {
                            title: "TUNES"

                            RowLayout {
                                Layout.fillWidth: true

                                LText {
                                    color: swTheme.neonGreen  // rf81: neon settings text
                                    text: "Tune slots"
                                }

                                Slider {
                                    id: prefTuneSlotCount
                                    Layout.fillWidth: true

                                    from: 2
                                    to: tuneManager.maxTunes
                                    value: 4
                                    stepSize: 1
                                }

                                Text {
                                    text: prefTuneSlotCount.value
                                    color: swTheme.neonGreen
                                    font.family: "Exan"
                                    font.pixelSize: 0.32 * unit
                                }
                            }

                            RightSwitch {
                                id: prefShowTuneDiffCount
                                checked: false
                                label: "Show changed options count"
                            }
                        }

                        SettingsCard {
                            title: "DATA & APP"

                            IntTextField {
                                label: "Realtime plot window"
                                valueUnit: "min"
                                sourceValue: preferences.plotMaxWindowMinutes
                                minValue: 1
                                maxValue: 1000
                                onValueChanged: {
                                    preferences.plotMaxWindowMinutes = value
                                }
                            }

                            RightSwitch {
                                id: prefShowWelcomeDialog
                                visible: false  // rf90: the welcome dialog no longer opens
                                checked: true
                                label: "Show Welcome dialog"
                            }

                            RightSwitch {
                                id: prefCheckForNewVersions
                                checked: true
                                label: "Check for new package versions"
                            }

                            NeonButton {
                                Layout.alignment: Qt.AlignHCenter
                                text: "Show tips & tricks"
                                onClicked: {
                                    settingsDialog.close();
                                    rinkTour.open();  // rf87: Neon Future tour of the Rink-Mixed features
                                }
                            }
                        }

                        Item { Layout.fillWidth: true; height: 0.2 * unit }
                    }
                }
            }
        }
    }

    BaseDialog {
        id: newPackageVersionDialog
        parent: ApplicationWindow.overlay

        title: "New Package Version"
        standardButtons: Dialog.Ok | Dialog.Abort

        property string version

        function show(newVersion) {
            version = newVersion;
            standardButton(Dialog.Abort).text = "Snooze for one month"

            open();
        }

        onRejected: {
            persistentData.packageUpdateSnooze = Date.now();
        }

        NText {
            width: newPackageVersionDialog.availableWidth
            font.pointSize: 12
            horizontalAlignment: Text.AlignHCenter
            wrapMode: TextEdit.WordWrap
            text: "New {{PACKAGE_NAME}} package version available: %1\n\nIt's recommended you update it in the Package Store.\n\nYour package configuration will be migrated automatically, no extra steps needed unless mentioned in package description. Having a manual XML or Start Page \"Backup Configs\" backup is still recommended.".arg(newPackageVersionDialog.version)
        }
    }

    // rf89: MAX SPEED - VESC's own Max ERPM (motor config), worked out from
    // the wheel diameter, motor poles and gear ratio set in VESC Tool. Near
    // the cap the motor's forward push fades to zero (ERPM Limit Start ->
    // Max ERPM) so a free-spinning tire coasts at about the cap; braking is
    // not limited. No package (C) change. Writes go read-modify-write: the
    // motor config is read fresh from the board first.
    Connections {
        id: maxSpeed
        property ConfigParams mc: VescIf.mcConfig()
        target: mc

        readonly property real erpmDefault: 100000  // VESC's default Max ERPM (no limit)
        readonly property real minKmh: 64.4  // 40 mph: lowest cap offered (rf96)
        readonly property real maxKmh: 120.7  // 75 mph
        property real wheelD: 0
        property int poles: 0
        property real gear: 1
        property real maxErpm: 0
        property real erpmStart: 0.8
        property int pending: 0  // 1 set, 2 remove (waiting for a fresh motor config)
        property real targetKmh: 72.4
        // ERPM per km/h: wheel turns per km/h x pole pairs x gear ratio
        readonly property real erpmPerKmh: wheelD > 0.05 && poles >= 2 ? (1000 / 60) / (Math.PI * wheelD) * (poles / 2) * gear : 0
        readonly property bool ready: erpmPerKmh > 0
        readonly property bool limited: ready && maxErpm > 0 && maxErpm < erpmDefault * 0.99
        readonly property real capKmh: limited ? maxErpm / erpmPerKmh : 0
        // rf96: a cap the rider set here (not a huge VESC Tool value): shown on the speedo
        readonly property bool shown: limited && capKmh < 161

        function load() {
            wheelD = mc.getParamDouble("si_wheel_diameter");
            poles = mc.getParamInt("si_motor_poles");
            gear = Math.max(0.01, mc.getParamDouble("si_gear_ratio"));
            maxErpm = mc.getParamDouble("l_max_erpm");
            erpmStart = mc.getParamDouble("l_erpm_start");
            if (!targetTouched && limited) targetKmh = Math.min(maxKmh, Math.max(minKmh, capKmh));
        }
        property bool targetTouched: false
        function onUpdated() {
            load();
            if (pending) apply();
        }
        function onParamChangedDouble(src, name, v) { if (name.indexOf("l_") === 0 || name.indexOf("si_") === 0) load(); }
        function onParamChangedInt(src, name, v) { if (name === "si_motor_poles") load(); }
        Component.onCompleted: load()

        function request(kind) {
            // writing the motor config resets the motor: never while riding
            if (boardRunning) {
                VescIf.emitStatusMessage("Stop riding first: the motor settings can't be changed while the board is engaged", false);
                return;
            }
            pending = kind;
            maxSpeedTimer.restart();
            vescCommands.getMcconf();  // apply() runs when it arrives
        }
        function apply() {
            var kind = pending;
            pending = 0;
            maxSpeedTimer.stop();
            if (boardRunning) return;
            if (!ready) {
                VescIf.emitStatusMessage("Set the wheel diameter and motor poles in VESC Tool first", false);
                return;
            }
            // VESC's optional overspeed fault would STOP the motor past Max ERPM
            var faults = mc.getParamInt("l_additional_faults");
            if (kind === 1 && faults > 0 && (faults & 2)) {
                VescIf.emitStatusMessage("Turn off the Overspeed fault (Motor Settings > General > Additional Faults) first: it stops the motor at the limit", false);
                return;
            }
            var e = kind === 1 ? Math.round(targetKmh * erpmPerKmh) : erpmDefault;
            mc.updateParamDouble("l_max_erpm", e);
            mc.updateParamDouble("l_min_erpm", -e);
            if (kind === 1 && mc.getParamDouble("l_erpm_start") < 0.95) {
                mc.updateParamDouble("l_erpm_start", 0.95);  // push fades only in the last 5%
            }
            vescCommands.setMcconf(false);
            load();
            VescIf.emitStatusMessage(kind === 1 ? "Max speed set: " + Math.round(targetKmh * vescConfig.imperialFactor) + " " + vescConfig.speedUnit + " (" + e + " ERPM)"
                                                : "Max speed limit removed", true);
        }
        property Timer timer: Timer {
            id: maxSpeedTimer
            interval: 4000
            onTriggered: {
                if (maxSpeed.pending) {
                    maxSpeed.pending = 0;
                    VescIf.emitStatusMessage("Couldn't read the motor settings from the board - nothing changed", false);
                }
            }
        }
    }

    // rf93: shown each time the package UI opens, until "don't show again"
    BaseDialog {
        id: disclaimerDialog
        parent: ApplicationWindow.overlay
        title: "Before you start"
        standardButtons: Dialog.Ok
        closePolicy: Popup.NoAutoClose

        onOpened: { disclaimerHide.checked = false; standardButton(Dialog.Ok).text = "Got it"; }
        onAccepted: {
            if (disclaimerHide.checked) swSettings.hideDisclaimer = true;
            if (!swSettings.tourSeen) rinkTour.open();
        }

        Column {
            width: disclaimerDialog.availableWidth
            spacing: 0.25 * unit

            NText {
                width: parent.width
                font.pointSize: 12
                wrapMode: Text.WordWrap
                text: "Everything in Re-Float Rink-Mixed works off your current Refloat settings: tunes, lights, sounds and the rest read and write Refloat's own configuration.\n\n"
                    + "To use its features properly you need a working board that is set up and rides correctly on Refloat, and working LEDs for the light features.\n\n"
                    + "Based on Refloat 1.2.3. Later Refloat versions are known to ride quite differently, so if you're coming back from a newer version your board will likely feel noticeably different.\n\n"
                    + "If something doesn't work, check the board and its Refloat settings in VESC Tool first."
            }

            CheckBox {
                id: disclaimerHide
                width: parent.width
                text: "Don't show this again"
            }
        }
    }

    // rf96: terms before the MAX SPEED window opens (every time)
    BaseDialog {
        id: maxSpeedTerms
        parent: ApplicationWindow.overlay
        title: "\u26A0 Max speed limiter"
        standardButtons: Dialog.Ok | Dialog.Cancel

        onOpened: {
            maxSpeedAck.checked = false;
            standardButton(Dialog.Ok).text = "Continue";
            standardButton(Dialog.Ok).enabled = false;
        }
        onAccepted: if (maxSpeedAck.checked) maxSpeedPanel.open()

        Column {
            width: maxSpeedTerms.availableWidth
            spacing: 0.25 * unit

            NText {
                width: parent.width
                font.pointSize: 12
                wrapMode: Text.WordWrap
                text: "This is meant for riders who want to limit how fast the tire free-spins in the air (off a jump). It sets VESC's own Max ERPM from your wheel diameter; it is off unless you set it.\n\n"
                    + "WARNING: the limit also applies while riding. If you ever reach this speed on the ground, the motor can no longer push the nose back up and the board WILL NOSEDIVE.\n\n"
                    + "Set it well above the fastest you ride, and check your real top speed after changing the wheel or tire. You ride at your own risk."
            }

            CheckBox {
                id: maxSpeedAck
                width: parent.width
                text: "I understand and accept these terms"
                onCheckedChanged: maxSpeedTerms.standardButton(Dialog.Ok).enabled = checked
            }
        }
    }

    // rf96: the MAX SPEED window (behind the terms)
    BaseDialog {
        id: maxSpeedPanel
        parent: ApplicationWindow.overlay
        title: "Max speed"
        standardButtons: Dialog.Close

        Column {
            width: maxSpeedPanel.availableWidth
            spacing: 0.2 * unit

            // rf89: MAX SPEED (VESC's Max ERPM from the wheel diameter)
            SwLText {
                width: parent.width
                horizontalAlignment: Text.AlignHCenter
                wrapMode: Text.WordWrap
                font.pixelSize: fontSizeSmall
                color: maxSpeed.limited ? swTheme.neonGreen : "#ead6ff"
                text: !maxSpeed.ready ? "Set the wheel diameter and motor poles in VESC Tool (Motor Settings \u203A Additional Info) first."
                    : (maxSpeed.limited ? "Now: %1 %2 (Max ERPM %3)".arg(Math.round(maxSpeed.capKmh * vescConfig.imperialFactor)).arg(vescConfig.speedUnit).arg(Math.round(maxSpeed.maxErpm))
                                        : "Now: no limit")
                      + " \u00B7 wheel %1 mm, %2 poles".arg(Math.round(maxSpeed.wheelD * 1000)).arg(maxSpeed.poles)
            }

            SwStepper {
                visible: maxSpeed.ready
                label: "LIMIT"
                value: Math.round(maxSpeed.targetKmh * vescConfig.imperialFactor)
                from: Math.ceil(maxSpeed.minKmh * vescConfig.imperialFactor)
                to: Math.floor(maxSpeed.maxKmh * vescConfig.imperialFactor)
                step: 1
                suffix: " " + vescConfig.speedUnit
                onMoved: { maxSpeed.targetTouched = true; maxSpeed.targetKmh = newValue / vescConfig.imperialFactor; }
            }

            Row {
                visible: maxSpeed.ready
                anchors.horizontalCenter: parent.horizontalCenter
                spacing: 0.2 * unit
                SwPill {
                    minWidth: 2.8 * unit
                    label: "SET LIMIT"
                    lit: true
                    onClicked: maxSpeed.request(1)
                }
                SwPill {
                    visible: maxSpeed.limited
                    minWidth: 2.8 * unit
                    label: "REMOVE"
                    onClicked: maxSpeed.request(2)
                }
            }

            SwLText {
                width: parent.width
                wrapMode: Text.WordWrap
                font.pixelSize: fontSizeSmall
                text: "Caps how fast the tire can spin up in the air off a jump: it coasts at about this speed instead of 50+. "
                    + "Uses VESC's own Max ERPM and your wheel diameter, so it follows your setup. It also caps riding speed: set it well above your top speed."
            }

            Item { width: parent.width; height: 0.3 * unit }

        }
    }

    BaseDialog {
        id: editBoardNameDialog

        title: "Board Name"
        placeAtTop: true  // keep it above the phone keyboard

        onAccepted: {
            board.setName(boardNameInput.text);
            boardNameText.load();
        }
        onOpened: { boardNameInput.text = boardNameText.name; boardNameInput.forceActiveFocus(); }

        Column {
            width: editBoardNameDialog.availableWidth
            spacing: 0.3 * unit

            // neon input field: green digital text in a purple frame
            Rectangle {
                width: parent.width
                height: 1.1 * unit
                radius: 0.2 * unit
                color: "#100a24"
                border.color: boardNameInput.activeFocus ? swTheme.neonGreen : swTheme.neonPurple
                border.width: 2

                TextInput {
                    id: boardNameInput
                    anchors.fill: parent
                    anchors.leftMargin: 0.3 * unit
                    anchors.rightMargin: 0.3 * unit
                    verticalAlignment: TextInput.AlignVCenter
                    maximumLength: 30
                    clip: true
                    color: swTheme.neonGreen
                    selectionColor: swTheme.neonPurple
                    font.family: "Exan"
                    font.pixelSize: 0.4 * unit
                    text: boardNameText.name
                    onAccepted: editBoardNameDialog.accept()
                }

                Text {
                    anchors.left: parent.left
                    anchors.leftMargin: 0.3 * unit
                    anchors.verticalCenter: parent.verticalCenter
                    visible: boardNameInput.text === ""
                    text: "NAME YOUR BOARD"
                    color: "#4a3a70"
                    font.family: "Exan"
                    font.pixelSize: 0.36 * unit
                }
            }

            Text {
                width: parent.width
                horizontalAlignment: Text.AlignHCenter
                text: boardNameInput.text.length + " / 30 \u00B7 shown at the top of the dashboard"
                color: "#9d8ac0"
                font.pixelSize: 0.2 * unit
            }

            Row {
                anchors.horizontalCenter: parent.horizontalCenter
                spacing: 0.3 * unit
                SwPill {
                    minWidth: 2.4 * unit
                    label: "CANCEL"
                    onClicked: editBoardNameDialog.reject()
                }
                SwPill {
                    minWidth: 2.4 * unit
                    label: "SAVE"
                    lit: true
                    onClicked: editBoardNameDialog.accept()
                }
            }
        }
    }

    // Re-RinkFloat: MY MELODIES window (CONTROL > BOOT MELODY): the saved
    // melodies, kept out of the CONTROL tab so it stays short. Tap a name to
    // make it the boot melody, pencil to re-record it, x twice to delete.
    // Re-RinkFloat: full-screen window for one LEDS tab section
    Popup {
        id: ledWindow
        parent: mainItem
        x: 0
        // half the screen, from the bottom (the LEDS tiles stay visible above)
        width: mainItem.width
        height: mainItem.height * 0.5
        y: mainItem.height - height
        modal: true
        dim: true
        padding: 0.25 * unit
        closePolicy: Popup.CloseOnEscape | Popup.CloseOnPressOutside

        property string section: "head"
        readonly property var titles: ({"head": "HEAD/TAIL LIGHTS", "bar": "STATUS BAR", "anim": "STATUS BAR ANIMATIONS", "sound": "BEEPER", "battery": "BATTERY GAUGE", "fw": "LCM FIRMWARE", "custom": "CUSTOM ANIMATION", "updates": "UPDATES", "rgb": "RGB LIGHTS"})

        function show(which) {
            section = which;
            ledWindowFlick.contentY = 0;
            ledSender.fromConfig();  // Refloat's LED settings may have changed in VESC Tool
            if (which === "fw") lcmFw.forgetCheck();
            open();
        }

        // the LCM check must be done again each time the tools are opened
        onClosed: lcmFw.forgetCheck()

        background: Rectangle {
            color: "#0b0718"
            radius: 0.3 * unit
            border.color: swTheme.neonPurple
            border.width: 2
        }

        ColumnLayout {
            anchors.fill: parent
            spacing: 0.15 * unit

            RowLayout {
                Layout.fillWidth: true

                SwPill {
                    minWidth: 1.8 * unit
                    label: "\u2039 BACK"
                    onClicked: ledWindow.section === "custom" ? ledWindow.show("anim") : ledWindow.close()
                }

                SwNeonLabel {
                    Layout.fillWidth: true
                    horizontalAlignment: Text.AlignHCenter
                    font.pixelSize: 0.36 * unit
                    text: ledWindow.titles[ledWindow.section] || ""
                }

                // balances the BACK pill so the title stays centred
                Item { implicitWidth: 1.8 * unit; implicitHeight: 1 }
            }

            Rectangle { Layout.fillWidth: true; height: 2; color: swTheme.neonPurple; opacity: 0.6 }

            Flickable {
                id: ledWindowFlick
                Layout.fillWidth: true
                Layout.fillHeight: true
                clip: true
                contentHeight: ledWindowCol.height + 0.4 * unit
                boundsBehavior: Flickable.StopAtBounds

                Column {
                    id: ledWindowCol
                    width: parent.width
                    spacing: 0.14 * unit
                    topPadding: 0.1 * unit

                    Column {
                        width: parent.width
                        spacing: 0.14 * unit
                        visible: ledWindow.section === "head"

                        SwPill {
                            anchors.horizontalCenter: parent.horizontalCenter
                            minWidth: 3.4 * unit
                            label: swSettings.ledHeadlights ? "HEAD/TAIL LIGHTS ON" : "HEAD/TAIL LIGHTS OFF"
                            lit: swSettings.ledHeadlights
                            onClicked: ledSender.setHead(!swSettings.ledHeadlights)
                        }

                        SwStepper {
                            label: "IN MOTION"
                            value: swSettings.ledHeadlightPct
                            from: 0; to: 100; step: 5
                            valueText: value === 0 ? "OFF" : value + "%"
                            onMoved: { swSettings.ledHeadlightPct = newValue; ledSender.changed(); }
                        }

                        SwStepper {
                            label: "IDLE"
                            value: swSettings.ledHeadlightIdlePct
                            from: 0; to: 100; step: 5
                            valueText: value === 0 ? "OFF" : value + "%"
                            onMoved: { swSettings.ledHeadlightIdlePct = newValue; ledSender.changed(); }
                        }

                        // rf86: snooze for controller-driven LEDs (head/tail and status
                        // bar), kept by the package; an SLCM snoozes by itself
                        LedHeading { text: "Snooze" }

                        // rf100: how many minutes BEFORE the board powers off the
                        // snooze starts (default 5; 0 = never), head/tail and status bar
                        SwStepper {
                            visible: ledSender.rgbAvail || ledSender.rfStatusAvail
                            label: "SNOOZE BEFORE OFF"
                            valueWidth: 2.1 * unit
                            value: swSettings.ledSnoozeMin === 255 ? 5 : swSettings.ledSnoozeMin
                            from: 0; to: vescAppConfig.offMinutes >= 2 ? Math.min(60, Math.ceil(vescAppConfig.offMinutes) - 1) : 60; step: 1
                            valueText: value === 0 ? "NEVER" : value + " min"
                            onMoved: { swSettings.ledSnoozeMin = newValue; ledSender.changed(); }
                        }

                        // rf97: how the lights look while snoozing
                        Row {
                            anchors.horizontalCenter: parent.horizontalCenter
                            spacing: 0.15 * unit
                            Repeater {
                                // DIM only for controller-driven LEDs (an SLCM breathes or goes dark)
                                model: (ledSender.rgbAvail || ledSender.rfStatusAvail) ? [["BREATHE", 0], ["DIM", 1], ["DARK", 2]] : [["BREATHE", 0], ["DARK", 2]]
                                SwPill {
                                    minWidth: 2.2 * unit
                                    label: modelData[0]
                                    lit: swSettings.ledSnoozeStyle === modelData[1] || (modelData[1] === 0 && swSettings.ledSnoozeStyle === 1 && !(ledSender.rgbAvail || ledSender.rfStatusAvail))
                                    onClicked: { swSettings.ledSnoozeStyle = modelData[1]; swSettings.ledDozeBreath = modelData[1] !== 2; ledSender.changed(); }
                                }
                            }
                        }

                        SwLText {
                            visible: (ledSender.rgbAvail || ledSender.rfStatusAvail) && vescAppConfig.offMinutes > 0
                            width: parent.width
                            horizontalAlignment: Text.AlignHCenter
                            wrapMode: Text.WordWrap
                            font.pixelSize: fontSizeSmall
                            color: swTheme.neonGreen
                            readonly property real snzBefore: swSettings.ledSnoozeMin === 255 ? 5 : swSettings.ledSnoozeMin
                            text: "Board powers off after " + (vescAppConfig.offMinutes < 1 ? "10 s" : vescAppConfig.offMinutes >= 60 ? (vescAppConfig.offMinutes / 60) + " h" : vescAppConfig.offMinutes + " min")
                                + " idling (VESC Shutdown Mode)"
                                + (snzBefore > 0 && vescAppConfig.offMinutes > snzBefore ? ", so the lights snooze at " + (vescAppConfig.offMinutes - snzBefore) + " min." : ".")
                                + " They blink twice every 15 s in the last minute."
                        }

                        SwLText {
                            width: parent.width
                            wrapMode: Text.WordWrap
                            font.pixelSize: fontSizeSmall
                            text: "IN MOTION: while the board is engaged. IDLE: the rest of the time. 0% = off; HEAD/TAIL LIGHTS OFF = always off. "
                                + "Same as Refloat's Headlight Brightness (in motion) and Front Brightness (idle). "
                                + "SNOOZE: after the set time sitting still (not engaged, no footpad, not lifted) all lights dim, head/tail and status bar; any of those wakes them. "
                                + "SNOOZE sets how many minutes before the board powers off the head/tail lights and status bar start snoozing (default 5; without a power-off timer: after 10 min). BREATHE: a slow breath; DIM: a steady low glow; DARK: off. An SLCM light module snoozes on its own timer; this is for controller-driven LEDs (e.g. Thor)."
                        }
                    }
                    Column {
                        width: parent.width
                        spacing: 0.14 * unit
                        visible: ledWindow.section === "bar"

                        SwPill {
                            anchors.horizontalCenter: parent.horizontalCenter
                            minWidth: 3.4 * unit
                            label: swSettings.ledStatusBar ? "STATUS BAR ON" : "STATUS BAR OFF"
                            lit: swSettings.ledStatusBar
                            onClicked: ledSender.setStatus(!swSettings.ledStatusBar)
                        }

                        SwStepper {
                            label: "IDLE BRIGHTNESS"
                            value: swSettings.ledStatusIdlePct
                            from: 0; to: 100; step: 5; suffix: "%"
                            onMoved: { swSettings.ledStatusIdlePct = newValue; ledSender.changed(); }
                        }

                        SwStepper {
                            label: "RIDING BRIGHTNESS"
                            value: swSettings.ledStatusRidePct
                            from: 0; to: 100; step: 5; suffix: "%"
                            onMoved: { swSettings.ledStatusRidePct = newValue; ledSender.changed(); }
                        }

                        SwLText {
                            width: parent.width
                            wrapMode: Text.WordWrap
                            font.pixelSize: fontSizeSmall
                            text: "Same as Refloat's Status Idle Brightness (idle) and Status Brightness (riding)."
                        }

                        // rf72: Refloat's Status Idle animation - one setting for
                        // every controller (controller-driven LEDs play it, an SLCM gets it
                        // translated by the package)
                        LedHeading { text: "Idle animation" }

                        // the animation preview is the selector; first choice
                        // BATTERY = Refloat's idle animation off (idle_timeout 0)
                        SwStepper {
                            bigName: true
                            rfAnim: true
                            value: ledSender.rfOn ? ledSender.rfMode : -1
                            from: -1; to: ledSender.rfModes.length - 1; step: 1
                            valueText: value < 0 ? "BATTERY" : ledSender.rfModes[value]
                            onMoved: {
                                if (newValue < 0) {
                                    ledSender.setRf("rfTimeout", 0);
                                } else {
                                    // rf102: one-color animations start with a BLACK background
                                    if (ledSender.oneColor(newValue) && !(ledSender.rfOn && ledSender.oneColor(ledSender.rfMode))) ledSender.rfColor2 = 0;
                                    ledSender.rfMode = newValue;
                                    ledSender.setRf("rfTimeout", ledSender.rfOn ? ledSender.rfTimeout : 10);
                                }
                            }
                        }

                        Column {
                            width: parent.width
                            spacing: 0.14 * unit
                            visible: ledSender.rfOn

                            SwStepper {
                                visible: ledSender.rfMode < 6
                                label: "COLOR 1"
                                valueWidth: 3.2 * unit
                                value: ledSender.rfColor1
                                from: 0; to: 29; step: 1
                                valueText: ledSender.rfColors[value]
                                valueColor: ledSender.rfTextColor(value)
                                onMoved: ledSender.setRf("rfColor1", ledSender.rfColorNext(value, newValue > value ? 1 : -1))
                            }
                            SwStepper {
                                // rf91: Refloat uses color 2 in FADE, STROBE, FELONY and as the
                                // background of PULSE and KNIGHT RIDER (BLACK = one color)
                                visible: ledSender.rfMode >= 1 && ledSender.rfMode <= 5
                                label: ledSender.oneColor(ledSender.rfMode) ? "BACKGROUND" : "COLOR 2"
                                // rf101: BACKGROUND ON / OFF (off = BLACK)
                                toggle: ledSender.oneColor(ledSender.rfMode) ? (ledSender.rfColor2 !== 0 ? 1 : 0) : -1
                                onToggleClicked: {
                                    if (ledSender.rfColor2 !== 0) { swSettings.rfBgLast = ledSender.rfColor2; ledSender.setRf("rfColor2", 0); }
                                    else ledSender.setRf("rfColor2", swSettings.rfBgLast || 1);
                                }
                                valueWidth: 3.2 * unit
                                value: ledSender.rfColor2
                                from: 0; to: 29; step: 1
                                valueText: ledSender.rfColors[value]
                                valueColor: ledSender.rfTextColor(value)
                                onMoved: ledSender.setRf("rfColor2", ledSender.rfColorNext(value, newValue > value ? 1 : -1))
                            }
                            Rectangle {
                                visible: ledSender.rfMode < 6
                                anchors.horizontalCenter: parent.horizontalCenter
                                width: parent.width * 0.7; height: 0.14 * unit; radius: height / 2
                                gradient: Gradient {
                                    orientation: Gradient.Horizontal
                                    GradientStop { position: 0; color: ledSender.rfQColor(ledSender.rfColor1) }
                                    GradientStop {
                                        position: 1
                                        color: ledSender.rfQColor(ledSender.rfMode >= 1 && ledSender.rfMode <= 5 ? ledSender.rfColor2 : ledSender.rfColor1)
                                    }
                                }
                            }
                            SwStepper {
                                visible: ledSender.rfMode !== 0
                                label: "SPEED"
                                value: ledSender.rfSpeed
                                from: 0.1; to: 5; step: 0.1; decimals: 1; suffix: "/s"
                                onMoved: ledSender.setRf("rfSpeed", newValue)
                            }
                            SwStepper {
                                label: "START AFTER"
                                value: ledSender.rfTimeout
                                from: 1; to: 300; step: 1; suffix: " s"
                                onMoved: ledSender.setRf("rfTimeout", newValue)
                            }
                        }

                        SwLText {
                            width: parent.width
                            wrapMode: Text.WordWrap
                            font.pixelSize: fontSizeSmall
                            text: "Refloat's own Status Idle animation, so it's the same on every controller (Thor, Floatwheel, ...): controller-driven LEDs play it themselves, "
                                + "and for an SLCM light module the package turns it into the closest SLCM animation (from SLCM r19; older builds show the battery). "
                                + "BATTERY = the battery level. START AFTER only applies to controller-driven LEDs, an SLCM starts right away."
                                + (slcmDetect.present && !ledSender.idleFollows
                                    ? " Right now the SLCM plays " + ledSender.animLabel(0, swSettings.ledAnimIdle) + " from SLCM EXTRAS \u203A ANIMATIONS instead; change anything here to follow this again."
                                    : "")
                        }

                        // rf84: Refloat's riding status bar (Thor etc.; an SLCM
                        // uses SLCM EXTRAS > ANIMATIONS > RIDING)
                        LedHeading { visible: ledSender.rfStatusAvail; text: "Riding animation" }

                        // rf97: riding animation for the controller's status strip:
                        // BATTERY / DUTY (Refloat) or a Refloat animation in the idle colors
                        SwStepper {
                            visible: ledSender.rfStatusAvail
                            bigName: true
                            value: swSettings.ledRideMode
                            rf: ({mode: value - 1, c1: ledSender.rfColor1, c2: ledSender.rfColor2, speed: ledSender.rfSpeed})
                            from: 0; to: ledSender.rfModes.length; step: 1
                            valueText: value === 0 ? "BATTERY / DUTY" : ledSender.rfModes[value - 1]
                            onMoved: { swSettings.ledRideMode = newValue; ledSender.changed(); }
                        }

                        SwStepper {
                            visible: ledSender.rfStatusAvail
                            label: "DUTY BAR FROM"
                            value: Math.max(15, Math.round(ledSender.rfDutyTh * 20) * 5)
                            from: 15; to: 100; step: 5
                            valueText: value >= 100 ? "NEVER" : value + "%"
                            onMoved: { if (!ledSender.rfLoaded) ledSender.fromConfig(); ledSender.rfDutyTh = newValue / 100; ledSender.changed(); }
                        }

                        SwPill {
                            visible: ledSender.rfStatusAvail
                            anchors.horizontalCenter: parent.horizontalCenter
                            minWidth: 4.4 * unit
                            label: ledSender.rfSensors ? "FOOTPAD SENSORS ON" : "FOOTPAD SENSORS OFF"
                            lit: ledSender.rfSensors
                            onClicked: { if (!ledSender.rfLoaded) ledSender.fromConfig(); ledSender.rfSensors = !ledSender.rfSensors; ledSender.changed(); }
                        }

                        SwLText {
                            visible: ledSender.rfStatusAvail
                            width: parent.width
                            wrapMode: Text.WordWrap
                            font.pixelSize: fontSizeSmall
                            text: "BATTERY / DUTY: the battery level, then the duty bar from the set duty (NEVER = battery only). Any other animation plays in the idle animation's colors and speed while riding; the duty bar still takes over from the set duty. FOOTPAD SENSORS: show a released sensor while riding. "
                                + "Same as Refloat's Status Duty Threshold and Show Sensor Indicators While Running."
                        }
                    }
                    Column {
                        width: parent.width
                        spacing: 0.14 * unit
                        visible: ledWindow.section === "anim"

                        SwLText {
                            width: parent.width
                            horizontalAlignment: Text.AlignHCenter
                            wrapMode: Text.WordWrap
                            font.pixelSize: fontSizeSmall
                            text: "Status bar only (SLCM). XRV / GTV / Pint V head and tail lights are plain strips."
                        }

                        Repeater {
                            model: ledSender.animContexts

                            SwStepper {
                                width: ledWindowCol.width
                                label: modelData[0]
                                valueWidth: 3.6 * unit
                                animName: true
                                // IDLE: one more choice at the end, STATUS BAR = Refloat's
                                // Status Idle animation (stored as 128)
                                value: index === 0 && swSettings.ledAnimIdle === 128 ? 15 : swSettings[modelData[1]]
                                from: 0; to: ledSender.animNames.length - (index === 0 ? 0 : 1); step: 1
                                valueText: ledSender.animLabel(index, value)
                                onMoved: { swSettings[modelData[1]] = index === 0 && newValue === 15 ? 128 : newValue; ledSender.changed(); }
                            }
                        }

                        SwStepper {
                            label: "COLOR"
                            value: swSettings.ledColor
                            from: 0; to: 350; step: 10; suffix: "\u00B0"
                            onMoved: { swSettings.ledColor = newValue; ledSender.changed(); }
                        }

                        // personal color (used by the CLASSIC / COLOR SCAN / PULSE / WAVE animations)
                        Rectangle {
                            anchors.horizontalCenter: parent.horizontalCenter
                            width: parent.width * 0.7
                            height: 0.18 * unit
                            radius: height / 2
                            color: Qt.hsla(swSettings.ledColor / 360, 1.0, 0.5, 1.0)
                        }

                        SwLText {
                            width: parent.width
                            wrapMode: Text.WordWrap
                            font.pixelSize: fontSizeSmall
                            text: "OFF = nothing shown (riding still warns when the battery is low). STANDARD = battery level, footpad sensors when stepped on. "
                                + "BATTERY LEVEL shows the battery gauge anywhere (riding: live); it needs the SLCM build that comes with this package (CHECK LCM: up to date). "
                                + "IDLE STATUS BAR = the idle animation set in STATUS BAR (Refloat's own), the same on every controller."
                        }

                        SwPill {
                            anchors.horizontalCenter: parent.horizontalCenter
                            minWidth: 4.6 * unit
                            label: "DESIGN CUSTOM \u203A"
                            lit: true
                            onClicked: ledWindow.show("custom")
                        }
                    }

                    // Re-Float Rink-Mixed: CUSTOM animation designer (SLCM r19+).
                    // The light module runs it itself (stored there too, so it
                    // also plays with the package off).
                    Column {
                        width: parent.width
                        spacing: 0.14 * unit
                        visible: ledWindow.section === "custom"

                        AnimName {
                            width: parent.width
                            height: 0.9 * unit
                            anim: 14
                            text: "CUSTOM PREVIEW"
                            hue: swSettings.ledColor
                            basePixelSize: 0.4 * unit
                        }

                        LedHeading { text: "Style" }
                        Row {
                            anchors.horizontalCenter: parent.horizontalCenter
                            spacing: 0.15 * unit
                            Repeater {
                                model: ["FILL", "SCANNER"]
                                SwPill {
                                    minWidth: 2.8 * unit
                                    label: modelData
                                    lit: { swSettings.ledCustom; return ledSender.customField(0) === index; }
                                    onClicked: ledSender.setCustomField(0, index)
                                }
                            }
                        }

                        LedHeading { text: "Colors" }
                        Flow {
                            width: parent.width
                            spacing: 0.12 * unit
                            Repeater {
                                model: ["RAINBOW \u2192", "RAINBOW \u2190", "WAVE A\u2194B", "FLIP A/B", "MY COLOR"]
                                SwPill {
                                    minWidth: 2.2 * unit
                                    label: modelData
                                    lit: { swSettings.ledCustom; return ledSender.customField(1) === index; }
                                    onClicked: ledSender.setCustomField(1, index)
                                }
                            }
                        }

                        LedHeading { text: "Pattern" }
                        Flow {
                            width: parent.width
                            spacing: 0.12 * unit
                            Repeater {
                                model: { swSettings.ledCustom; return ledSender.customField(0) === 1
                                    ? ["LEFT \u2192 RIGHT", "RIGHT \u2192 LEFT", "MIRROR OUT", "MIRROR IN", "FILL \u2192", "FILL \u2190", "BOUNCE"]
                                    : ["SOLID", "GRADIENT", "MIRROR"]; }
                                SwPill {
                                    minWidth: 2.2 * unit
                                    label: modelData
                                    lit: { swSettings.ledCustom; return ledSender.customField(2) === index; }
                                    onClicked: ledSender.setCustomField(2, index)
                                }
                            }
                        }

                        SwStepper {
                            label: "COLOR A"
                            value: { swSettings.ledCustom; return ledSender.custom()[2] * 2; }
                            from: 0; to: 358; step: 6; suffix: "\u00B0"
                            onMoved: ledSender.setCustom(2, newValue / 2)
                        }
                        Rectangle {
                            anchors.horizontalCenter: parent.horizontalCenter
                            width: parent.width * 0.7; height: 0.14 * unit; radius: height / 2
                            gradient: Gradient {
                                orientation: Gradient.Horizontal
                                GradientStop { position: 0; color: { swSettings.ledCustom; return Qt.hsla(ledSender.custom()[2] * 2 / 360, 1, 0.5, 1); } }
                                GradientStop { position: 1; color: { swSettings.ledCustom; return Qt.hsla(ledSender.custom()[3] * 2 / 360, 1, 0.5, 1); } }
                            }
                        }
                        SwStepper {
                            label: "COLOR B"
                            value: { swSettings.ledCustom; return ledSender.custom()[3] * 2; }
                            from: 0; to: 358; step: 6; suffix: "\u00B0"
                            onMoved: ledSender.setCustom(3, newValue / 2)
                        }
                        SwStepper {
                            label: "COLOR SPEED"
                            value: { swSettings.ledCustom; return ledSender.custom()[4]; }
                            from: 0; to: 255; step: 1
                            valueText: ((value + 1) * 0.05).toFixed(2) + " s"
                            onMoved: ledSender.setCustom(4, newValue)
                        }
                        SwStepper {
                            label: { swSettings.ledCustom; return ledSender.customField(0) === 1 ? "SCAN SPEED" : "PULSE SPEED"; }
                            value: { swSettings.ledCustom; return ledSender.custom()[5]; }
                            from: 0; to: 255; step: 1
                            valueText: ((value + 1) * 0.05).toFixed(2) + " s"
                            onMoved: ledSender.setCustom(5, newValue)
                        }

                        LedHeading { visible: ledSender.customField(0) === 0; text: "Brightness" }
                        Row {
                            visible: { swSettings.ledCustom; return ledSender.customField(0) === 0; }
                            anchors.horizontalCenter: parent.horizontalCenter
                            spacing: 0.15 * unit
                            Repeater {
                                model: ["STEADY", "BREATHE", "FLASH"]
                                SwPill {
                                    minWidth: 2.2 * unit
                                    label: modelData
                                    lit: { swSettings.ledCustom; return ledSender.custom()[1] === index; }
                                    onClicked: ledSender.setCustom(1, index)
                                }
                            }
                        }
                        SwStepper {
                            visible: { swSettings.ledCustom; return ledSender.customField(0) === 0 && ledSender.custom()[1] > 0; }
                            label: "LOWEST BRIGHTNESS"
                            value: { swSettings.ledCustom; return Math.round(ledSender.custom()[6] / 2.55); }
                            from: 0; to: 100; step: 5; suffix: "%"
                            onMoved: ledSender.setCustom(6, newValue * 2.55)
                        }

                        SwLText {
                            width: parent.width
                            wrapMode: Text.WordWrap
                            font.pixelSize: fontSizeSmall
                            text: "Pick CUSTOM for any of IDLE / RIDING / SNOOZE / BOOT / SHUTDOWN in ANIMATIONS. The light module runs it and keeps it, so it also plays with the package off. "
                                + "MY COLOR uses the COLOR from ANIMATIONS. Needs SLCM r19 or newer (CHECK LCM)."
                        }
                    }
                    Column {
                        width: parent.width
                        spacing: 0.14 * unit
                        visible: ledWindow.section === "sound"

                        // rf84: the controller's own beeper (Refloat setting)
                        LedHeading { text: "Controller" }
                        Row {
                            anchors.horizontalCenter: parent.horizontalCenter
                            spacing: 0.15 * unit
                            SwPill {
                                minWidth: 3.4 * unit
                                label: ledSender.ctrlBeep ? "BEEPER ON" : "BEEPER OFF"
                                lit: ledSender.ctrlBeep
                                onClicked: ledSender.setCtrlBeep(!ledSender.ctrlBeep)
                            }
                            SwPill {
                                minWidth: 3.0 * unit
                                label: "\u266A TEST BEEP"
                                lit: true
                                onClicked: {
                                    ledSender.testCtrlBeep();
                                    VescIf.emitStatusMessage(ledSender.ctrlBeep ? "Test beep sent to the controller"
                                        : "Controller beeper is off - turn it on to hear the test beep", true);
                                }
                            }
                        }
                        SwLText {
                            width: parent.width
                            wrapMode: Text.WordWrap
                            font.pixelSize: fontSizeSmall
                            text: "Refloat's Enable Beeper on Servo/PPM: the beep when settings are written, and the warning beeps (low / high battery, temperature, sensor faults). "
                                + "Refloat has one switch for all of them: OFF also silences the warnings."
                        }

                        LedHeading { text: "Light module" }

                        SwPill {
                            anchors.horizontalCenter: parent.horizontalCenter
                            minWidth: 3.4 * unit
                            label: swSettings.ledBeep ? "LCM BEEPER ON" : "LCM BEEPER OFF"
                            lit: swSettings.ledBeep
                            onClicked: { swSettings.ledBeep = !swSettings.ledBeep; ledSender.changed(); }
                        }

                        Item { width: parent.width; height: 0.2 * unit }

                        Rectangle {
                            id: testBeepBtn
                            anchors.horizontalCenter: parent.horizontalCenter
                            width: Math.min(parent.width, 4.6 * unit)
                            height: 1.4 * unit
                            radius: height / 2
                            color: testBeepArea.pressed ? swTheme.neonGreen : "transparent"
                            border.color: swTheme.neonGreen
                            border.width: 3
                            Text {
                                anchors.centerIn: parent
                                text: "\u266A  TEST BEEP"
                                color: testBeepArea.pressed ? swTheme.background : swTheme.neonGreen
                                font.family: "Exan"
                                font.pixelSize: 0.36 * unit
                            }
                            MouseArea {
                                id: testBeepArea
                                anchors.fill: parent
                                onClicked: {
                                    ledSender.testBeep();
                                    VescIf.emitStatusMessage(swSettings.ledBeep ? "Test beep sent to the light module"
                                    : "Test beep sent - turn the LCM beeper on to hear it", true);
                                }
                            }
                        }

                        SwLText {
                            width: parent.width
                            horizontalAlignment: Text.AlignHCenter
                            wrapMode: Text.WordWrap
                            font.pixelSize: fontSizeSmall
                            text: swSettings.ledBeep
                            ? "The light module plays one short beep. No beep = the module isn't running the SLCM firmware or isn't connected."
                            : "The LCM beeper is off, so the test beep is silent. Turn it on above first."
                        }
                    }

                    Column {
                        width: parent.width
                        spacing: 0.14 * unit
                        visible: ledWindow.section === "battery"

                        SwPill {
                            anchors.horizontalCenter: parent.horizontalCenter
                            minWidth: 3.4 * unit
                            label: swSettings.batCurveOn ? "BATTERY CURVE ON" : "BATTERY CURVE OFF"
                            lit: swSettings.batCurveOn
                            onClicked: { swSettings.batCurveOn = !swSettings.batCurveOn; batteryCurve.changed(); }
                        }

                        SwLText {
                            width: parent.width
                            horizontalAlignment: Text.AlignHCenter
                            wrapMode: Text.WordWrap
                            font.pixelSize: fontSizeSmall
                            color: swTheme.neonGreen
                            text: batteryCurve.cells > 0
                                ? "Now: " + batteryCurve.volts.toFixed(1) + " V \u00B7 " + batteryCurve.cells + "s \u00B7 "
                                    + (batteryCurve.volts / batteryCurve.cells).toFixed(2) + " V/cell \u2192 "
                                    + (batteryCurve.percent <= 100 ? batteryCurve.percent + " %" : "VESC's own %")
                                : "Waiting for the board..."
                        }

                        LedHeading { text: "1. Cell size" }
                        Row {
                            anchors.horizontalCenter: parent.horizontalCenter
                            spacing: 0.15 * unit
                            Repeater {
                                model: ["18650", "21700"]
                                SwPill {
                                    minWidth: 2.2 * unit
                                    label: modelData
                                    lit: swSettings.batSize === modelData
                                    onClicked: batteryCurve.pickSize(modelData)
                                }
                            }
                        }

                        LedHeading { text: "2. Cell" }
                        Flow {
                            width: parent.width
                            spacing: 0.12 * unit
                            Repeater {
                                model: batteryCurve.cellsOfSize(swSettings.batSize)
                                SwPill {
                                    minWidth: 1.6 * unit
                                    label: modelData
                                    lit: swSettings.batCell === modelData
                                    onClicked: batteryCurve.pickCell(modelData)
                                }
                            }
                        }

                        LedHeading { text: "3. Pack" }
                        Row {
                            anchors.horizontalCenter: parent.horizontalCenter
                            spacing: 0.12 * unit
                            Repeater {
                                model: [1, 2, 3, 4]
                                SwPill {
                                    minWidth: 1.2 * unit
                                    label: modelData + "P"
                                    lit: swSettings.batParallel === modelData
                                    onClicked: { swSettings.batParallel = modelData; batteryCurve.changed(); }
                                }
                            }
                        }

                        LedHeading { text: "4. Gauge" }
                        Flow {
                            width: parent.width
                            spacing: 0.12 * unit
                            Repeater {
                                model: 3
                                SwPill {
                                    minWidth: 2.2 * unit
                                    label: batteryCurve.styleNames[index]
                                    lit: swSettings.batStyle === index - 1
                                    onClicked: { swSettings.batStyle = index - 1; batteryCurve.changed(); }
                                }
                            }
                        }

                        SwLText {
                            width: parent.width
                            wrapMode: Text.WordWrap
                            font.pixelSize: fontSizeSmall
                            text: (swSettings.batStyle < 0 ? "Conservative: reads a bit low, so it warns you earlier. "
                                    : swSettings.batStyle > 0 ? "Optimistic: reads a bit high, closer to the last bit of range. " : "Balanced: the cell's own curve. ")
                                + (batteryCurve.current.approx ? batteryCurve.current.name + ": approximate curve (Molicel publishes none; based on P42A). " : "")
                                + "Sag compensation: " + (swSettings.batResAuto ? "automatic, " + (2 * batteryCurve.resistance) + " m\u03A9 for " + batteryCurve.series + "s" + swSettings.batParallel + "p." : "manual (Advanced).")
                        }

                        SwPill {
                            anchors.horizontalCenter: parent.horizontalCenter
                            minWidth: 3.4 * unit
                            label: "ADVANCED \u203A"
                            onClicked: batteryAdvanced.open()
                        }
                    }

                    // Re-Float Rink-Mixed: RGB LIGHTS - Refloat's own light bar
                    // animations (Refloat Cfg > LEDs), for RGB strips (Thor...)
                    Column {
                        id: rgbCol
                        width: parent.width
                        spacing: 0.14 * unit
                        visible: ledWindow.section === "rgb"
                        property int sel: 0
                        readonly property var bar: ledSender.rgb[sel] || ({})

                        // IN MOTION (engaged, headlights on) = Refloat's
                        // headlights / taillights bars; IDLE = front / rear
                        Repeater {
                            model: [["IN MOTION", 0], ["IDLE", 2]]
                            Item {
                                id: rgbGroup
                                width: rgbCol.width
                                height: 0.8 * unit
                                SwNeonLabel {
                                    anchors.left: parent.left
                                    anchors.verticalCenter: parent.verticalCenter
                                    width: parent.width - 4.6 * unit
                                    font.pixelSize: 0.28 * unit
                                    text: modelData[0]
                                }
                                Row {
                                    anchors.right: parent.right
                                    anchors.verticalCenter: parent.verticalCenter
                                    spacing: 0.15 * unit
                                    Repeater {
                                        model: ["HEAD", "TAIL"]
                                        SwPill {
                                            readonly property int bar: rgbGroup.base + (modelData === "HEAD" ? 0 : 1)
                                            minWidth: 2.0 * unit
                                            label: modelData
                                            lit: rgbCol.sel === bar
                                            onClicked: rgbCol.sel = bar
                                        }
                                    }
                                }
                                readonly property int base: modelData[1]
                            }
                        }

                        // the animation preview is the selector
                        SwStepper {
                            bigName: true
                            rf: rgbCol.bar
                            value: rgbCol.bar.mode || 0
                            from: 0; to: ledSender.rfModes.length - 1; step: 1
                            valueText: ledSender.rfModes[value] || ""
                            onMoved: ledSender.rgbSet(rgbCol.sel, "mode", newValue)
                        }
                        SwStepper {
                            visible: (rgbCol.bar.mode || 0) < 6
                            label: "COLOR 1"
                            valueWidth: 3.2 * unit
                            value: rgbCol.bar.c1 || 0
                            from: 0; to: 29; step: 1
                            valueText: ledSender.rfColors[value]
                            valueColor: ledSender.rfTextColor(value)
                            onMoved: ledSender.rgbSet(rgbCol.sel, "c1", ledSender.rfColorNext(value, newValue > value ? 1 : -1))
                        }
                        SwStepper {
                            visible: rgbCol.bar.mode >= 1 && rgbCol.bar.mode <= 5  // rf91, see Status Idle
                            label: ledSender.oneColor(rgbCol.bar.mode) ? "BACKGROUND" : "COLOR 2"
                            toggle: ledSender.oneColor(rgbCol.bar.mode) ? ((rgbCol.bar.c2 || 0) !== 0 ? 1 : 0) : -1  // rf101
                            onToggleClicked: {
                                if ((rgbCol.bar.c2 || 0) !== 0) { swSettings.rfBgLast = rgbCol.bar.c2; ledSender.rgbSet(rgbCol.sel, "c2", 0); }
                                else ledSender.rgbSet(rgbCol.sel, "c2", swSettings.rfBgLast || 1);
                            }
                            valueWidth: 3.2 * unit
                            value: rgbCol.bar.c2 || 0
                            from: 0; to: 29; step: 1
                            valueText: ledSender.rfColors[value]
                            valueColor: ledSender.rfTextColor(value)
                            onMoved: ledSender.rgbSet(rgbCol.sel, "c2", ledSender.rfColorNext(value, newValue > value ? 1 : -1))
                        }
                        SwStepper {
                            visible: (rgbCol.bar.mode || 0) !== 0
                            label: "SPEED"
                            value: rgbCol.bar.speed || 1
                            from: 0.1; to: 5; step: 0.1; decimals: 1; suffix: "/s"
                            onMoved: ledSender.rgbSet(rgbCol.sel, "speed", newValue)
                        }
                        SwStepper {
                            label: "BRIGHTNESS"
                            value: ledSender.rgbLoaded ? ledSender.rgbBri(rgbCol.sel) : 0
                            from: 0; to: 100; step: 5; suffix: "%"
                            onMoved: ledSender.rgbSetBri(rgbCol.sel, newValue)
                        }

                        SwPill {
                            anchors.horizontalCenter: parent.horizontalCenter
                            minWidth: 4.4 * unit
                            label: ledSender.rgbLifted ? "OFF WHEN LIFTED: ON" : "OFF WHEN LIFTED: OFF"
                            lit: ledSender.rgbLifted
                            onClicked: ledSender.rgbSetLifted(!ledSender.rgbLifted)
                        }

                        SwLText {
                            width: parent.width
                            horizontalAlignment: Text.AlignHCenter
                            wrapMode: Text.WordWrap
                            font.pixelSize: fontSizeSmall
                            text: "Refloat's LED settings (Refloat Cfg \u203A LEDs), linked both ways."
                        }
                    }

                    // Re-Float Rink-Mixed: UPDATES (CHECK FOR UPDATES on GitHub)
                    Column {
                        width: parent.width
                        spacing: 0.16 * unit
                        visible: ledWindow.section === "updates"

                        // what's installed
                        Rectangle {
                            width: parent.width
                            height: installedText.implicitHeight + 0.24 * unit
                            radius: 0.08 * unit
                            color: "#140c26"
                            border.color: swTheme.neonPurple
                            border.width: 2
                            Text {
                                id: installedText
                                anchors.centerIn: parent
                                width: parent.width - 0.24 * unit
                                horizontalAlignment: Text.AlignHCenter
                                wrapMode: Text.WordWrap
                                color: "#ead6ff"
                                font.pixelSize: fontSizeSmall
                                text: "This package: Re-Float Rink-Mixed " + lcmFw.pkgVersion + "\n"
                                    + "Light module: " + (lcmFw.hasBootloader ? "SLCM " + lcmFw.verText(lcmFw.lcmVer)
                                        : (lcmFw.nameKnown ? (lcmFw.lcmName !== "" ? "“" + lcmFw.lcmName + "” (not updatable from the app)" : "no SLCM detected")
                                        : "not asked yet"))
                            }
                        }

                        Rectangle {
                            anchors.horizontalCenter: parent.horizontalCenter
                            width: Math.min(parent.width, 5.2 * unit)
                            height: 1.4 * unit
                            radius: height / 2
                            opacity: updater.phase === 1 || updater.dlState === 1 ? 0.5 : 1
                            color: updCheckArea.pressed ? swTheme.neonGreen : "transparent"
                            border.color: swTheme.neonGreen
                            border.width: 3
                            Text {
                                anchors.centerIn: parent
                                text: updater.phase === 1 ? "CHECKING..." : "↻  CHECK FOR UPDATES"
                                color: updCheckArea.pressed ? swTheme.background : swTheme.neonGreen
                                font.family: "Exan"
                                font.pixelSize: 0.32 * unit
                            }
                            MouseArea {
                                id: updCheckArea
                                anchors.fill: parent
                                enabled: updater.phase !== 1 && updater.dlState !== 1
                                onClicked: updater.check()
                            }
                        }

                        SwLText {
                            width: parent.width
                            horizontalAlignment: Text.AlignHCenter
                            wrapMode: Text.WordWrap
                            font.pixelSize: fontSizeSmall
                            color: updater.phase === 3 ? "#FFB300" : swTheme.neonGreen
                            text: updater.message !== "" ? updater.message
                                : "Checks GitHub for the latest rider release. Only tagged, bench-tested releases are offered, never development builds. Needs the phone's internet connection."
                        }

                        // package
                        Rectangle {
                            visible: !!updater.rel
                            width: parent.width
                            height: pkgCol.implicitHeight + 0.3 * unit
                            radius: 0.08 * unit
                            readonly property color tone: updater.pkgFit === "newer" ? "#FFB300" : swTheme.neonGreen
                            color: updater.pkgFit === "newer" ? "#2A1F00" : "#0d2a12"
                            border.color: tone
                            border.width: 2
                            Column {
                                id: pkgCol
                                anchors.centerIn: parent
                                width: parent.width - 0.3 * unit
                                spacing: 0.12 * unit
                                Text {
                                    width: parent.width
                                    horizontalAlignment: Text.AlignHCenter
                                    wrapMode: Text.WordWrap
                                    color: parent.parent.tone
                                    font.family: "Exan"
                                    font.pixelSize: 0.26 * unit
                                    text: updater.pkgFit === "newer" ? "PACKAGE UPDATE AVAILABLE"
                                        : updater.pkgFit === "same" ? "PACKAGE UP TO DATE"
                                        : updater.pkgFit === "older" ? "PACKAGE NEWER THAN THE RELEASE" : "PACKAGE"
                                }
                                Text {
                                    width: parent.width
                                    horizontalAlignment: Text.AlignHCenter
                                    wrapMode: Text.WordWrap
                                    color: "#ead6ff"
                                    font.pixelSize: fontSizeSmall
                                    text: !updater.rel ? ""
                                        : updater.pkgFit === "newer" ? updater.rel.version + " is out (you have " + lcmFw.pkgVersion + "). Download it, then install it in VESC Tool › VESC Packages. Update the package first, then the light module."
                                        : updater.pkgFit === "same" ? "You have the latest release, " + lcmFw.pkgVersion + "."
                                        : updater.pkgFit === "older" ? "You have " + lcmFw.pkgVersion + ", newer than the latest release (" + updater.rel.version + "): a development build."
                                        : "Latest release: " + updater.rel.version + "."
                                }
                                SwPill {
                                    visible: updater.pkgFit === "newer" && !!updater.rel && updater.rel.pkgUrl !== ""
                                    anchors.horizontalCenter: parent.horizontalCenter
                                    minWidth: 3.6 * unit
                                    label: "DOWNLOAD PACKAGE"
                                    lit: true
                                    onClicked: Qt.openUrlExternally(updater.rel.pkgUrl)
                                }
                            }
                        }

                        // light module (SLCM)
                        Rectangle {
                            visible: !!updater.rel
                            width: parent.width
                            height: slcmCol.implicitHeight + 0.3 * unit
                            radius: 0.08 * unit
                            readonly property bool attention: updater.lcmFit === "newer" || updater.lcmFit === "other" || updater.lcmFit === "unknown"
                            readonly property color tone: attention ? "#FFB300" : (updater.lcmFit === "same" ? swTheme.neonGreen : swTheme.neonPurple)
                            color: attention ? "#2A1F00" : (updater.lcmFit === "same" ? "#0d2a12" : "#140c26")
                            border.color: tone
                            border.width: 2
                            Column {
                                id: slcmCol
                                anchors.centerIn: parent
                                width: parent.width - 0.3 * unit
                                spacing: 0.12 * unit
                                Text {
                                    width: parent.width
                                    horizontalAlignment: Text.AlignHCenter
                                    wrapMode: Text.WordWrap
                                    color: parent.parent.tone === swTheme.neonPurple ? "#c98bff" : parent.parent.tone
                                    font.family: "Exan"
                                    font.pixelSize: 0.26 * unit
                                    text: updater.lcmFit === "newer" ? "LCM UPDATE AVAILABLE"
                                        : updater.lcmFit === "same" ? "LCM UP TO DATE"
                                        : updater.lcmFit === "older" ? "LCM NEWER THAN THE RELEASE"
                                        : updater.lcmFit === "other" ? "DIFFERENT LCM BUILD"
                                        : "LIGHT MODULE (SLCM)"
                                }
                                Text {
                                    width: parent.width
                                    horizontalAlignment: Text.AlignHCenter
                                    wrapMode: Text.WordWrap
                                    color: "#ead6ff"
                                    font.pixelSize: fontSizeSmall
                                    readonly property string relText: updater.relSlcm ? "SLCM " + lcmFw.verText(updater.relSlcm) : ""
                                    readonly property string lcmText: "SLCM " + lcmFw.verText(lcmFw.lcmVer)
                                    text: updater.lcmFit === "newer" ? "The release has " + relText + ", your light module runs " + lcmText + "."
                                        : updater.lcmFit === "same" ? "Your light module runs " + lcmText + ", the release's build. You can still reflash it."
                                        : updater.lcmFit === "older" ? "Your light module runs " + lcmText + ", newer than the release's " + relText + ". Flashing would downgrade it."
                                        : updater.lcmFit === "other" ? "Your light module runs " + lcmText + ", a different build from the release's " + relText + " (e.g. a custom build)."
                                        : updater.lcmFit === "unknown" ? "This release doesn't list its SLCM version: download it to see which build it is."
                                        : updater.lcmFit === "missing" ? "This release has no SLCM.hex."
                                        : updater.lcmFit === "nolcm" ? (relText ? "The release has " + relText + ". " : "")
                                            + "No SLCM with the bootloader answered" + (lcmFw.nameKnown ? "" : " (board connected and powered on?)")
                                            + ". A light module needs SLCM.hex flashed once with an ST-Link before it can update from the app."
                                        : ""
                                }
                                SwPill {
                                    visible: !!updater.rel && updater.rel.hexUrl !== "" && updater.lcmFit !== "nolcm" && updater.dlState !== 2
                                    anchors.horizontalCenter: parent.horizontalCenter
                                    minWidth: 3.6 * unit
                                    label: updater.dlState === 1 ? "DOWNLOADING..."
                                        : updater.lcmFit === "same" ? "DOWNLOAD TO REFLASH"
                                        : updater.lcmFit === "older" ? "DOWNLOAD (DOWNGRADE)" : "DOWNLOAD UPDATE"
                                    lit: updater.lcmFit === "newer"
                                    enabledLook: updater.dlState !== 1 && !lcmFw.active
                                    onClicked: updater.download()
                                }
                                SwPill {
                                    visible: updater.dlState === 2
                                    anchors.horizontalCenter: parent.horizontalCenter
                                    minWidth: 3.6 * unit
                                    label: "FLASH UPDATE"
                                    lit: true
                                    enabledLook: !lcmFw.active
                                    onClicked: updatePrompt.open()
                                }
                                Text {
                                    visible: updater.dlMessage !== ""
                                    width: parent.width
                                    horizontalAlignment: Text.AlignHCenter
                                    wrapMode: Text.WordWrap
                                    color: updater.dlState === 3 ? "#FFB300" : swTheme.neonGreen
                                    font.pixelSize: fontSizeSmall
                                    text: updater.dlMessage
                                }
                            }
                        }

                        // release notes
                        SwLText {
                            visible: !!updater.rel && updater.rel.notes !== ""
                            width: parent.width
                            wrapMode: Text.WordWrap
                            font.pixelSize: fontSizeSmall
                            textFormat: Text.PlainText
                            text: updater.rel ? "Release notes (" + updater.rel.tag + "):\n" + updater.rel.notes.substr(0, 1200) : ""
                        }

                        SwPill {
                            anchors.horizontalCenter: parent.horizontalCenter
                            minWidth: 3.6 * unit
                            label: "OPEN RELEASE PAGE"
                            onClicked: Qt.openUrlExternally(updater.rel ? updater.rel.page : updater.releasesPage)
                        }
                    }

                    Column {
                        width: parent.width
                        spacing: 0.14 * unit
                        visible: ledWindow.section === "fw"

                        LedHeading { text: "Light module" }

                        SwLText {
                            visible: !slcmDetect.present && !lcmFw.active
                            width: parent.width
                            horizontalAlignment: Text.AlignHCenter
                            wrapMode: Text.WordWrap
                            font.pixelSize: fontSizeSmall
                            color: "#FFB300"
                            text: "This only applies to Floatwheel, XRV, Pint V and GTV light modules with the SLCM firmware installed."
                        }

                        Rectangle {
                            width: parent.width
                            height: lcmFittedText.implicitHeight + 0.24 * unit
                            radius: 0.08 * unit
                            readonly property color tone: lcmFw.checkState === 2 || lcmFw.active ? swTheme.neonGreen
                                : (lcmFw.checkState === 3 ? "#FFB300" : swTheme.neonPurple)
                            color: lcmFw.checkState === 2 || lcmFw.active ? "#0d2a12" : (lcmFw.checkState === 3 ? "#2A1F00" : "#140c26")
                            border.color: tone
                            border.width: 2
                            Text {
                                id: lcmFittedText
                                anchors.centerIn: parent
                                width: parent.width - 0.24 * unit
                                horizontalAlignment: Text.AlignHCenter
                                wrapMode: Text.WordWrap
                                color: parent.tone === swTheme.neonPurple ? "#ead6ff" : parent.tone
                                font.pixelSize: fontSizeSmall
                                text: lcmFw.fittedText
                            }
                        }

                        // step 1: CHECK LCM (required before FLASH LCM shows)
                        Rectangle {
                            visible: !lcmFw.canFlash
                            anchors.horizontalCenter: parent.horizontalCenter
                            width: Math.min(parent.width, 4.6 * unit)
                            height: 1.4 * unit
                            radius: height / 2
                            opacity: lcmFw.checkState === 1 ? 0.5 : 1
                            color: checkBtnArea.pressed ? "#FFB300" : "transparent"
                            border.color: "#FFB300"
                            border.width: 3
                            Text {
                                anchors.centerIn: parent
                                text: lcmFw.checkState === 1 ? "CHECKING..." : (lcmFw.checkState === 0 ? "\u2714  CHECK LCM" : "\u21BB  CHECK AGAIN")
                                color: checkBtnArea.pressed ? swTheme.background : "#FFB300"
                                font.family: "Exan"
                                font.pixelSize: 0.36 * unit
                            }
                            MouseArea {
                                id: checkBtnArea
                                anchors.fill: parent
                                enabled: lcmFw.checkState !== 1
                                onClicked: lcmFw.check()
                            }
                        }

                        SwLText {
                            visible: !lcmFw.canFlash
                            width: parent.width
                            horizontalAlignment: Text.AlignHCenter
                            wrapMode: Text.WordWrap
                            font.pixelSize: fontSizeSmall
                            text: "Board powered on and connected. The check asks the package which light module firmware is fitted; FLASH LCM only appears when it has the bootloader."
                        }

                        LedHeading { visible: lcmFw.canFlash; text: "Firmware to flash" }

                        Flow {
                            visible: lcmFw.canFlash
                            width: parent.width
                            spacing: 0.12 * unit
                            SwPill {
                                visible: lcmFw.builtinImage
                                minWidth: 2.4 * unit
                                label: "BUILT-IN"
                                lit: !lcmFw.usePicked
                                enabledLook: !!lcmFw.builtin && !lcmFw.active
                                onClicked: if (lcmFw.builtin && !lcmFw.active) lcmFw.usePicked = false
                            }
                            SwPill {
                                minWidth: 2.4 * unit
                                label: lcmFw.picked ? "PICKED .HEX" : "PICK .HEX FILE..."
                                lit: lcmFw.usePicked || !lcmFw.builtinImage
                                enabledLook: !lcmFw.active
                                onClicked: {
                                    if (lcmFw.active) return;
                                    if (lcmFw.picked && !lcmFw.usePicked && lcmFw.builtinImage) lcmFw.usePicked = true;
                                    else hexLoadDialog.show();
                                }
                            }
                            SwPill {
                                visible: !!lcmFw.picked
                                minWidth: 1.6 * unit
                                label: "CHANGE..."
                                enabledLook: !lcmFw.active
                                onClicked: if (!lcmFw.active) hexLoadDialog.show()
                            }
                        }

                        SwLText {
                            visible: lcmFw.canFlash
                            width: parent.width
                            wrapMode: Text.WordWrap
                            font.pixelSize: fontSizeSmall
                            text: lcmFw.image === lcmFw.picked && lcmFw.picked
                                ? "File: " + lcmFw.picked.file + " \u00B7 " + (lcmFw.picked.slcm ? "SLCM " + lcmFw.verText(lcmFw.parseVer(lcmFw.picked.slcm)) : "version unknown")
                                    + " (" + lcmFw.picked.size + " bytes)."
                                    + (lcmFw.pkgVer && lcmFw.picked.slcm && lcmFw.parseVer(lcmFw.picked.slcm).hash !== lcmFw.pkgVer.hash ? " Note: this package goes with SLCM " + lcmFw.verText(lcmFw.pkgVer) + "." : "")
                                : (lcmFw.builtinImage
                                    ? "Built into this package: SLCM build " + lcmFw.builtin.version + " (" + lcmFw.builtin.size + " bytes)."
                                    : "Use the UPDATES tab (CHECK FOR UPDATES) to download the latest SLCM, or download SLCM.hex from the lcm-latest release (github.com/thedukesedge-collab/scott-wheelz/releases/tag/lcm-latest) and PICK .HEX FILE."
                                        + (lcmFw.pkgVer ? " This package goes with SLCM " + lcmFw.verText(lcmFw.pkgVer) + "." : ""))
                        }

                        Rectangle {
                            visible: lcmFw.canFlash
                            anchors.horizontalCenter: parent.horizontalCenter
                            width: Math.min(parent.width, 4.6 * unit)
                            height: 1.4 * unit
                            radius: height / 2
                            opacity: lcmFw.image && !lcmFw.active ? 1 : 0.4
                            color: fwBtnArea.pressed ? swTheme.neonGreen : "transparent"
                            border.color: swTheme.neonGreen
                            border.width: 3
                            Text {
                                anchors.centerIn: parent
                                text: lcmFw.active ? "FLASHING..." : "\u21BB  FLASH LCM"
                                color: fwBtnArea.pressed ? swTheme.background : swTheme.neonGreen
                                font.family: "Exan"
                                font.pixelSize: 0.36 * unit
                            }
                            MouseArea {
                                id: fwBtnArea
                                anchors.fill: parent
                                enabled: !!lcmFw.image && !lcmFw.active && lcmFw.canFlash
                                onClicked: { lcmFwConfirm.ack = false; lcmFwConfirm.open(); }
                            }
                        }

                        // progress
                        Rectangle {
                            visible: lcmFw.active || lcmFw.progress > 0
                            width: parent.width
                            height: 0.22 * unit
                            radius: height / 2
                            color: "transparent"
                            border.color: swTheme.neonPurple
                            border.width: 2
                            Rectangle {
                                x: 2; y: 2
                                height: parent.height - 4
                                radius: height / 2
                                width: Math.max(0, (parent.width - 4) * lcmFw.progress)
                                color: swTheme.neonGreen
                            }
                        }

                        SwLText {
                            width: parent.width
                            horizontalAlignment: Text.AlignHCenter
                            wrapMode: Text.WordWrap
                            font.pixelSize: fontSizeSmall
                            color: lcmFw.pkgState === 4 || lcmFw.message.indexOf("Not ") === 0 || lcmFw.message.indexOf("No ") === 0
                                   || lcmFw.message.indexOf("This .hex") === 0 || lcmFw.message.indexOf("The vector") === 0
                                   || lcmFw.message.indexOf("Checksum") === 0 || lcmFw.message.indexOf("Couldn't") === 0
                                   ? "#FFB300" : swTheme.neonGreen
                            text: lcmFw.message
                        }

                        SwPill {
                            anchors.horizontalCenter: parent.horizontalCenter
                            visible: lcmFw.active
                            minWidth: 2.4 * unit
                            label: "CANCEL"
                            onClicked: lcmFw.cancel()
                        }

                        SwLText {
                            width: parent.width
                            wrapMode: Text.WordWrap
                            font.pixelSize: fontSizeSmall
                            text: "\u2022 Only for LCMs with the bootloader, installed once with an ST-Link (SLCM.hex). Stock LCM firmware can't be flashed from the app: it has no update code and only listens for the VESC's basic data.\n"
                                + "\u2022 Board powered on and idle. The update is refused while riding; don't ride until it's done.\n"
                                + "\u2022 Headlights and beeper go off while it updates (about a minute). Keep the app connected.\n"
                                + "\u2022 If it's interrupted, the LCM keeps the power on and waits for the update. Press FLASH LCM again, or power the board off and on first. Hold the button 2 s to power off."
                        }
                    }
                }
            }

            SwLText {
                // head / bar are Refloat's own settings (any controller)
                // rf92: also not in RGB LIGHTS / BEEPER / UPDATES (not SLCM things)
                visible: slcmDetect.present || ["head", "bar", "rgb", "sound", "updates"].indexOf(ledWindow.section) < 0
                Layout.fillWidth: true
                horizontalAlignment: Text.AlignHCenter
                wrapMode: Text.WordWrap
                font.pixelSize: 0.17 * unit
                color: slcmDetect.present ? swTheme.neonGreen : "#FFB300"
                text: slcmDetect.present ? "\u2714 SLCM " + slcmDetect.version + " detected"
                    : (ledWindow.section === "head" || ledWindow.section === "bar"
                        ? "Brightness also sets controller-driven LEDs (any controller); the rest needs SLCM"
                        : "\u26A0 Needs the SLCM light module firmware")
            }
        }
    }

    // Re-RinkFloat: battery gauge, advanced mode (full screen): my own cell
    // (name, size, resistance, capacity, curve), manual sag compensation
    Popup {
        id: batteryAdvanced
        parent: mainItem
        x: 0
        y: 0
        width: mainItem.width
        height: mainItem.height
        modal: true
        dim: true
        padding: 0.25 * unit
        closePolicy: Popup.CloseOnEscape

        readonly property var editPoints: batteryCurve.custom ? batteryCurve.custom.points : batteryCurve.current.points

        background: Rectangle {
            color: "#0b0718"
            border.color: swTheme.neonPurple
            border.width: 2
        }

        ColumnLayout {
            anchors.fill: parent
            spacing: 0.15 * unit

            RowLayout {
                Layout.fillWidth: true
                SwPill {
                    minWidth: 1.8 * unit
                    label: "\u2039 BACK"
                    onClicked: batteryAdvanced.close()
                }
                SwNeonLabel {
                    Layout.fillWidth: true
                    horizontalAlignment: Text.AlignHCenter
                    font.pixelSize: 0.32 * unit
                    text: "BATTERY \u00B7 ADVANCED"
                }
                Item { implicitWidth: 1.8 * unit; implicitHeight: 1 }
            }

            Rectangle { Layout.fillWidth: true; height: 2; color: swTheme.neonPurple; opacity: 0.6 }

            Flickable {
                Layout.fillWidth: true
                Layout.fillHeight: true
                clip: true
                contentHeight: batAdvCol.height + 0.4 * unit
                boundsBehavior: Flickable.StopAtBounds

                Column {
                    id: batAdvCol
                    width: parent.width
                    spacing: 0.14 * unit

                    SwLText {
                        width: parent.width
                        horizontalAlignment: Text.AlignHCenter
                        wrapMode: Text.WordWrap
                        font.pixelSize: fontSizeSmall
                        color: swTheme.neonGreen
                        text: batteryCurve.cells > 0
                            ? "Now: " + batteryCurve.volts.toFixed(1) + " V \u00B7 " + batteryCurve.cells + "s \u00B7 "
                                + (batteryCurve.volts / batteryCurve.cells).toFixed(2) + " V/cell \u2192 "
                                + (batteryCurve.percent <= 100 ? batteryCurve.percent + " %" : "VESC's own %")
                            : "Waiting for the board..."
                    }

                    LedHeading { text: "My cell" }

                    RowLayout {
                        width: parent.width
                        SwLText { text: "NAME"; font.pixelSize: fontSizeSmall }
                        TextField {
                            Layout.fillWidth: true
                            maximumLength: 16
                            color: swTheme.neonGreen
                            text: batteryCurve.custom ? batteryCurve.custom.name : "MY CELL"
                            onEditingFinished: {
                                var t = text.trim() || "MY CELL";
                                batteryCurve.editCustom(function (c) { c.name = t; });
                            }
                        }
                    }

                    Row {
                        anchors.horizontalCenter: parent.horizontalCenter
                        spacing: 0.15 * unit
                        Repeater {
                            model: ["18650", "21700"]
                            SwPill {
                                minWidth: 2.2 * unit
                                label: modelData
                                lit: (batteryCurve.custom ? batteryCurve.custom.size : swSettings.batSize) === modelData
                                onClicked: batteryCurve.editCustom(function (c) { c.size = modelData; })
                            }
                        }
                    }

                    SwStepper {
                        label: "RESISTANCE (DC)"
                        value: batteryCurve.custom ? batteryCurve.custom.ir : batteryCurve.current.ir
                        from: 3; to: 80; step: 1; suffix: " m\u03A9"
                        onMoved: {
                            batteryCurve.editCustom(function (c) { c.ir = newValue; });
                            if (swSettings.batCell === "MY CELL") batteryCurve.changed();
                        }
                    }

                    SwStepper {
                        label: "CAPACITY"
                        value: batteryCurve.custom ? batteryCurve.custom.cap : 3000
                        from: 1000; to: 7000; step: 50; suffix: " mAh"
                        onMoved: batteryCurve.editCustom(function (c) { c.cap = newValue; })
                    }

                    SwLText {
                        width: parent.width
                        wrapMode: Text.WordWrap
                        font.pixelSize: fontSizeSmall
                        text: "Start the curve from a known cell:"
                    }

                    Flow {
                        width: parent.width
                        spacing: 0.12 * unit
                        Repeater {
                            model: batteryCurve.cellList
                            SwPill {
                                minWidth: 1.5 * unit
                                label: modelData.name
                                onClicked: {
                                    var src = modelData;
                                    batteryCurve.editCustom(function (c) { c.points = src.points.slice(); c.ir = src.ir; c.size = src.size; });
                                    if (swSettings.batCell === "MY CELL") batteryCurve.changed();
                                }
                            }
                        }
                    }

                    LedHeading { text: "Volts per cell" }

                    Repeater {
                        model: 11
                        SwStepper {
                            label: (100 - 10 * index) + " %"
                            value: batteryAdvanced.editPoints[index]
                            // keep the curve falling: stay between the neighbours
                            from: index < 10 ? batteryAdvanced.editPoints[index + 1] + 1 : 0
                            to: index > 0 ? batteryAdvanced.editPoints[index - 1] - 1 : 255
                            step: 1
                            valueText: (batteryCurve.mv(value) / 1000).toFixed(2) + " V"
                            onMoved: batteryCurve.setCustomPoint(index, newValue)
                        }
                    }

                    SwPill {
                        anchors.horizontalCenter: parent.horizontalCenter
                        minWidth: 3.4 * unit
                        label: swSettings.batCell === "MY CELL" ? "USING MY CELL" : "USE MY CELL"
                        lit: swSettings.batCell === "MY CELL"
                        onClicked: batteryCurve.useCustom()
                    }

                    LedHeading { text: "Sag compensation" }

                    Row {
                        anchors.horizontalCenter: parent.horizontalCenter
                        spacing: 0.15 * unit
                        SwPill {
                            minWidth: 2.2 * unit
                            label: "AUTO"
                            lit: swSettings.batResAuto
                            onClicked: { swSettings.batResAuto = true; batteryCurve.changed(); }
                        }
                        SwPill {
                            minWidth: 2.2 * unit
                            label: "MANUAL"
                            lit: !swSettings.batResAuto
                            onClicked: { swSettings.batResAuto = false; batteryCurve.changed(); }
                        }
                    }

                    SwStepper {
                        visible: !swSettings.batResAuto
                        label: "PACK RESISTANCE"
                        value: swSettings.batRes
                        from: 0; to: 250; step: 5
                        valueText: (2 * value) + " m\u03A9"
                        onMoved: { swSettings.batRes = newValue; batteryCurve.changed(); }
                    }

                    SwLText {
                        width: parent.width
                        wrapMode: Text.WordWrap
                        font.pixelSize: fontSizeSmall
                        text: "AUTO = cell resistance \u00D7 series \u00F7 parallel: " + batteryCurve.current.ir + " m\u03A9 \u00D7 " + batteryCurve.series
                            + " \u00F7 " + swSettings.batParallel + " \u2248 " + (2 * batteryCurve.autoRes) + " m\u03A9"
                            + (batteryCurve.current.irEst ? " (cell resistance estimated)" : "") + ". "
                            + "It adds back the voltage drop while riding so the gauge doesn't dip under load. Raise it if the gauge still drops when you accelerate, lower it if it jumps up.\n\n"
                            + "The package turns the voltage into a % with the curve and sends it to the LCM status bar (SLCM firmware). Series cells come from the VESC motor config (Additional Info \u203A battery cells in series)."
                    }
                }
            }
        }
    }

    // Re-RinkFloat: FLASH LCM warning - must be acknowledged first
    Popup {
        id: lcmFwConfirm
        parent: mainItem
        x: (mainItem.width - width) / 2
        y: (mainItem.height - height) / 2
        width: mainItem.width * 0.92
        modal: true
        dim: true
        padding: 0.3 * unit
        closePolicy: Popup.CloseOnEscape

        property bool ack: false

        background: Rectangle {
            color: "#140d02"
            radius: 0.25 * unit
            border.color: "#FFB300"
            border.width: 3
        }

        Column {
            width: parent.width
            spacing: 0.18 * unit

            Text {
                width: parent.width
                horizontalAlignment: Text.AlignHCenter
                text: "\u26A0 FLASH LCM FIRMWARE"
                color: "#FFB300"
                font.family: "Exan"
                font.pixelSize: 0.36 * unit
            }

            Text {
                width: parent.width
                wrapMode: Text.WordWrap
                color: "#ffe3a3"
                font.pixelSize: fontSizeSmall
                text: "This rewrites the firmware of your board's light control module (LCM), the part that also switches the board's power.\n\n"
                    + "Firmware: " + (lcmFw.image ? (lcmFw.usePicked ? "file " : "built-in ") + lcmFw.image.version + " (" + lcmFw.image.size + " bytes)" : "none") + "\n\n"
                    + "\u2022 Only for light modules (Floatwheel LCM board, tested target: XRV) that already have the SLCM bootloader (SLCM.hex, flashed once with an ST-Link). Stock LCM firmware can't be flashed from the app.\n"
                    + "\u2022 Only flash files built for this bootloader (SLCM) from a source you trust.\n"
                    + "\u2022 Board powered on, idle, on a stand. Do not ride, step on it or switch it off until it says Done (about a minute).\n"
                    + "\u2022 Headlights and beeper are off while it flashes. Keep this app open and connected.\n"
                    + "\u2022 If it's interrupted, the LCM keeps the board on and waits: press FLASH LCM again (power-cycle first if needed). Hold the button 2 s to power off.\n"
                    + "\u2022 Experimental, at your own risk. Keep an ST-Link and your old LCM firmware as a fallback."
            }

            Row {
                spacing: 0.15 * unit
                Rectangle {
                    width: 0.5 * unit; height: width; radius: 0.08 * unit
                    color: lcmFwConfirm.ack ? "#FFB300" : "transparent"
                    border.color: "#FFB300"; border.width: 2
                    Text { anchors.centerIn: parent; text: lcmFwConfirm.ack ? "\u2713" : ""; color: "#140d02"; font.pixelSize: 0.36 * unit }
                    MouseArea { anchors.fill: parent; onClicked: lcmFwConfirm.ack = !lcmFwConfirm.ack }
                }
                Text {
                    width: lcmFwConfirm.width - 1.4 * unit
                    anchors.verticalCenter: parent.verticalCenter
                    wrapMode: Text.WordWrap
                    color: "#ffe3a3"
                    font.pixelSize: fontSizeSmall
                    text: "I understand and my board is idle on a stand"
                    MouseArea { anchors.fill: parent; onClicked: lcmFwConfirm.ack = !lcmFwConfirm.ack }
                }
            }

            Row {
                anchors.horizontalCenter: parent.horizontalCenter
                spacing: 0.3 * unit
                SwPill {
                    minWidth: 2.2 * unit
                    label: "CANCEL"
                    onClicked: lcmFwConfirm.close()
                }
                SwPill {
                    minWidth: 2.6 * unit
                    label: "FLASH LCM"
                    lit: lcmFwConfirm.ack
                    enabledLook: lcmFwConfirm.ack
                    onClicked: {
                        if (!lcmFwConfirm.ack) return;
                        lcmFwConfirm.close();
                        if (lcmFw.canFlash) lcmFw.start();
                    }
                }
            }
        }
    }

    // Re-Float Rink-Mixed (rf81): neon number pad for the settings' number
    // fields (IntTextField) - themed like the rest, DONE applies the value
    // (kept within the field's range) and closes it
    Popup {
        id: numPad
        parent: mainItem
        x: 0
        y: mainItem.height - height
        width: mainItem.width
        modal: true
        dim: true
        padding: 0.25 * unit
        closePolicy: Popup.CloseOnEscape | Popup.CloseOnPressOutside

        property string label: ""
        property string unitText: ""
        property string entry: ""
        property bool fresh: true  // the first key replaces the old value
        property int minValue: 0
        property int maxValue: 100
        property var apply: null

        function edit(lbl, value, mn, mx, unitTxt, fn) {
            label = lbl;
            unitText = unitTxt || "";
            minValue = mn;
            maxValue = mx;
            entry = String(value);
            fresh = true;
            apply = fn;
            open();
        }
        function key(k) {
            if (k === "<") {
                entry = fresh ? "" : entry.slice(0, -1);
            } else if (entry.length < 4 || fresh) {
                entry = (fresh ? "" : entry) + k;
                if (entry.length > 1 && entry.charAt(0) === "0") entry = entry.substr(1);
            }
            fresh = false;
        }
        function done() {
            if (entry !== "" && apply) {
                apply(Math.max(minValue, Math.min(maxValue, parseInt(entry))));
            }
            close();
        }

        background: Rectangle {
            color: "#0b0718"
            radius: 0.25 * unit
            border.color: swTheme.neonPurple
            border.width: 2
        }

        Column {
            width: parent.width
            spacing: 0.15 * unit

            SwNeonLabel {
                width: parent.width
                horizontalAlignment: Text.AlignHCenter
                text: numPad.label.toUpperCase()
            }

            Text {
                width: parent.width
                horizontalAlignment: Text.AlignHCenter
                color: swTheme.neonGreen
                font.family: "Exan"
                font.pixelSize: 0.6 * unit
                text: (numPad.entry === "" ? "-" : numPad.entry) + (numPad.unitText !== "" ? " " + numPad.unitText : "")
            }

            SwLText {
                width: parent.width
                horizontalAlignment: Text.AlignHCenter
                font.pixelSize: fontSizeSmall
                readonly property int v: numPad.entry === "" ? -1 : parseInt(numPad.entry)
                color: v >= 0 && (v < numPad.minValue || v > numPad.maxValue) ? "#FFB300" : "#c98bff"
                text: numPad.minValue + " \u2013 " + numPad.maxValue
                    + (v >= 0 && (v < numPad.minValue || v > numPad.maxValue) ? " \u00B7 DONE keeps it in range" : "")
            }

            Grid {
                anchors.horizontalCenter: parent.horizontalCenter
                columns: 3
                spacing: 0.15 * unit
                Repeater {
                    model: ["1", "2", "3", "4", "5", "6", "7", "8", "9", "<", "0", "DONE"]
                    Rectangle {
                        width: (numPad.availableWidth - 0.3 * unit) / 3
                        height: 0.95 * unit
                        radius: 0.2 * unit
                        readonly property bool isDone: modelData === "DONE"
                        color: padKey.pressed || isDone ? swTheme.neonGreen : "#140a26"
                        border.color: isDone || padKey.pressed ? swTheme.neonGreen : swTheme.neonPurple
                        border.width: 2
                        Text {
                            anchors.centerIn: parent
                            text: modelData === "<" ? "\u232B" : modelData
                            color: padKey.pressed || parent.isDone ? swTheme.background : swTheme.neonGreen
                            font.family: modelData === "<" ? "" : "Exan"
                            font.pixelSize: (parent.isDone ? 0.3 : 0.42) * unit
                        }
                        MouseArea {
                            id: padKey
                            anchors.fill: parent
                            onClicked: parent.isDone ? numPad.done() : numPad.key(modelData)
                        }
                    }
                }
            }
        }
    }

    // Re-Float Rink-Mixed: SLCM update downloaded (UPDATES tab) -> flash it?
    Popup {
        id: updatePrompt
        parent: mainItem
        x: (mainItem.width - width) / 2
        y: (mainItem.height - height) / 2
        width: mainItem.width * 0.92
        modal: true
        dim: true
        padding: 0.3 * unit
        closePolicy: Popup.CloseOnEscape

        background: Rectangle {
            color: "#06180b"
            radius: 0.25 * unit
            border.color: swTheme.neonGreen
            border.width: 3
        }

        Column {
            width: parent.width
            spacing: 0.2 * unit

            Text {
                width: parent.width
                horizontalAlignment: Text.AlignHCenter
                text: "\u2714 LCM UPDATE DOWNLOADED"
                color: swTheme.neonGreen
                font.family: "Exan"
                font.pixelSize: 0.34 * unit
            }

            Text {
                width: parent.width
                wrapMode: Text.WordWrap
                color: "#c9ffd8"
                font.pixelSize: fontSizeSmall
                text: (updater.dlMessage + "\n\n")
                    + (lcmFw.hasBootloader ? "Your light module runs SLCM " + lcmFw.verText(lcmFw.lcmVer) + ".\n\n" : "")
                    + "FLASH UPDATE opens the LCM firmware tools with this file selected and runs CHECK LCM. Then CONTINUE and FLASH LCM, as always.\n\n"
                    + "Board powered on and idle, app connected. The board won't start while it updates (about a minute)."
            }

            Row {
                anchors.horizontalCenter: parent.horizontalCenter
                spacing: 0.3 * unit
                SwPill {
                    minWidth: 2.2 * unit
                    label: "LATER"
                    onClicked: updatePrompt.close()
                }
                SwPill {
                    minWidth: 3.2 * unit
                    label: "FLASH UPDATE"
                    lit: true
                    onClicked: {
                        updatePrompt.close();
                        updater.flash();
                    }
                }
            }
        }
    }

    // Re-Float Rink-Mixed: result of CHECK LCM (LEDS > LCM firmware tools)
    Popup {
        id: lcmCheckPopup
        parent: mainItem
        x: (mainItem.width - width) / 2
        y: (mainItem.height - height) / 2
        width: mainItem.width * 0.92
        modal: true
        dim: true
        padding: 0.3 * unit
        closePolicy: Popup.CloseOnEscape

        readonly property bool passed: lcmFw.checkState === 2
        readonly property color tone: passed ? swTheme.neonGreen : "#FFB300"

        background: Rectangle {
            color: lcmCheckPopup.passed ? "#06180b" : "#140d02"
            radius: 0.25 * unit
            border.color: lcmCheckPopup.tone
            border.width: 3
        }

        Column {
            width: parent.width
            spacing: 0.2 * unit

            Text {
                width: parent.width
                horizontalAlignment: Text.AlignHCenter
                text: lcmCheckPopup.passed ? "\u2714 LCM CHECK PASSED" : "\u26A0 LCM CHECK FAILED"
                color: lcmCheckPopup.tone
                font.family: "Exan"
                font.pixelSize: 0.36 * unit
            }

            // firmware version verdict (passed checks)
            Rectangle {
                visible: lcmCheckPopup.passed && lcmFw.fitTitle !== "" && lcmFw.fitted !== "recovery" && lcmFw.fitted !== "legacy"
                anchors.horizontalCenter: parent.horizontalCenter
                width: fitTitleText.implicitWidth + 0.5 * unit
                height: 0.6 * unit
                radius: height / 2
                color: "transparent"
                border.width: 2
                border.color: lcmFw.fit === "same" ? swTheme.neonGreen : "#FFB300"
                Text {
                    id: fitTitleText
                    anchors.centerIn: parent
                    text: lcmFw.fitTitle
                    color: parent.border.color
                    font.family: "Exan"
                    font.pixelSize: 0.22 * unit
                }
            }

            Text {
                width: parent.width
                wrapMode: Text.WordWrap
                color: lcmCheckPopup.passed ? "#c9ffd8" : "#ffe3a3"
                font.pixelSize: fontSizeSmall
                text: lcmCheckPopup.passed
                    ? (lcmFw.fitted === "recovery"
                        ? "The LCM bootloader is waiting for firmware (an earlier update didn't finish). Continue to flash it and recover the light module."
                        : lcmFw.fitted === "legacy"
                        ? "Your light module is talking to the package (your LED settings work), but it's an older SLCM / ALCM VP build from before r15 that doesn't report its version, so the package can't tell whether it has the bootloader.\n\n"
                            + "TRY UPDATE is safe: if it was installed with the bootloader (SLCM.hex, rf58 or later) it updates; if not, nothing happens and after 15 s the app says so - then flash SLCM.hex once with an ST-Link."
                            + (lcmFw.pkgVer ? "\n\nThis package goes with SLCM " + lcmFw.verText(lcmFw.pkgVer) + "." : "")
                        : "Found SLCM light module firmware with the bootloader, so the package can update it over Bluetooth.\n\n"
                            + lcmFw.fitText)
                    : "This is most likely because your board is running a version of LCM firmware that doesn't contain a bootloader for flashing over BLE.\n\n"
                        + "To resolve this, first flash the LCM with an ST-Link using the correct firmware: SLCM.hex (lcm-latest release). After that, CHECK LCM passes and future updates work from the app.\n\n"
                        + "What the package saw: " + (!lcmFw.nameKnown && !lcmFw.gotStatus ? "no answer from the board (check the connection)."
                            : lcmFw.fitted === "vp" ? "SLCM " + lcmFw.verText(lcmFw.lcmVer) + " without the bootloader."
                            : lcmFw.fitted === "other" ? "LCM firmware \u201C" + lcmFw.lcmName + "\u201D (not SLCM)."
                            : lcmFw.lcmPolling ? "a light module is talking to the package but doesn't name itself, so it isn't running SLCM r15 or newer (older SLCM / ALCM VP builds from before rf63, original ALCM, or other LCM firmware)."
                            : "no light module is talking to the package. Stock Floatwheel LCM firmware never does (it only reads the VESC's basic data); or the LCM isn't connected.")
                        + (lcmFw.builtin ? "\n\nThis package carries SLCM " + lcmFw.verText(lcmFw.pkgVer) + ": the SLCM.hex for the ST-Link must be that build or newer." : "")
            }

            Row {
                anchors.horizontalCenter: parent.horizontalCenter
                spacing: 0.3 * unit
                SwPill {
                    minWidth: 2.2 * unit
                    label: lcmCheckPopup.passed ? "CANCEL" : "OK"
                    onClicked: lcmCheckPopup.close()
                }
                SwPill {
                    visible: lcmCheckPopup.passed
                    minWidth: 3.2 * unit
                    label: lcmFw.continueLabel
                    lit: lcmFw.fit !== "newer"
                    onClicked: {
                        lcmCheckPopup.close();
                        if (lcmFw.capable) lcmFw.unlocked = true;
                    }
                }
            }
        }
    }

    Popup {
        id: myMelodiesPopup
        parent: mainItem
        x: 0
        width: mainItem.width
        height: mainItem.height * 0.6
        y: mainItem.height - height
        modal: true
        dim: true
        padding: 0.3 * unit
        closePolicy: Popup.CloseOnEscape | Popup.CloseOnPressOutside
        onClosed: savedMelodyList.deleteArmed = ""

        background: Rectangle {
            color: "#0b0718"
            radius: 0.3 * unit
            border.color: swTheme.neonPurple
            border.width: 2
        }

        ColumnLayout {
            anchors.fill: parent
            spacing: 0.2 * unit

            RowLayout {
                Layout.fillWidth: true

                SwNeonLabel {
                    Layout.fillWidth: true
                    horizontalAlignment: Text.AlignLeft
                    font.pixelSize: 0.36 * unit
                    text: "MY MELODIES"
                }

                SwPill {
                    minWidth: 1.0 * unit
                    label: "\u2715"
                    onClicked: myMelodiesPopup.close()
                }
            }

            SwLText {
                Layout.fillWidth: true
                wrapMode: Text.WordWrap
                font.pixelSize: fontSizeSmall
                text: "Tap a melody to play it at bootup. \u29C9 copies it as text, \u270E re-records it, \u2715 (tap twice) deletes it."
            }

            // clipboard helper for \u29C9
            TextEdit { id: melodyClip; visible: false }

            Flickable {
                Layout.fillWidth: true
                Layout.fillHeight: true
                clip: true
                contentHeight: savedMelodyList.height
                boundsBehavior: Flickable.StopAtBounds

                Item {
                    width: parent.width
                    height: savedMelodyList.height

                    Column {
                        id: savedMelodyList
                        anchors.horizontalCenter: parent.horizontalCenter
                        spacing: 0.12 * unit
                        property string deleteArmed: ""
                        property string current: {
                            swSettings.melodyRec;  // re-evaluate when the melody changes
                            return melodyLib.currentName();
                        }

                        SwLText {
                            width: 8.4 * unit
                            horizontalAlignment: Text.AlignHCenter
                            wrapMode: Text.WordWrap
                            visible: melodyLib.items.length === 0
                            font.pixelSize: fontSizeSmall
                            text: "No saved melodies yet: record one in MIXER \u25B8 REC, then SAVE."
                        }

                        Repeater {
                            model: melodyLib.items

                            Row {
                                spacing: 0.12 * unit
                                property string name: modelData.name

                                SwPill {
                                    width: 3.7 * unit
                                    label: parent.name
                                    lit: swSettings.hornBootMelody && swSettings.hornBootCustom && savedMelodyList.current === parent.name
                                    onClicked: { savedMelodyList.deleteArmed = ""; melodyLib.select(parent.name); }
                                }

                                SwPill {
                                    minWidth: 1.0 * unit
                                    label: "\u270E"
                                    onClicked: {
                                        // open it in the MIXER recorder (boot setting unchanged)
                                        savedMelodyList.deleteArmed = "";
                                        var i = melodyLib.find(parent.name);
                                        if (i >= 0) {
                                            swSettings.melodyRec = JSON.stringify(melodyLib.items[i].notes);
                                            hornSettingsSender.sendMelody();
                                        }
                                        myMelodiesPopup.close();
                    melodyPad.startRecording();
                                    }
                                }

                                // copy the notes as text (to share it, or send it to the developer)
                                SwPill {
                                    minWidth: 0.8 * unit
                                    label: "\u29C9"
                                    onClicked: {
                                        var i = melodyLib.find(parent.name);
                                        if (i < 0) return;
                                        melodyClip.text = "RFMELODY " + parent.name + " " + JSON.stringify(melodyLib.items[i].notes);
                                        melodyClip.selectAll();
                                        melodyClip.copy();
                                        VescIf.emitStatusMessage("Melody code copied: paste it in a message", true);
                                    }
                                }

                                SwPill {
                                    minWidth: savedMelodyList.deleteArmed === parent.name ? 1.9 * unit : 1.0 * unit
                                    label: savedMelodyList.deleteArmed === parent.name ? "DELETE?" : "\u2715"
                                    lit: savedMelodyList.deleteArmed === parent.name
                                    onClicked: {
                                        if (savedMelodyList.deleteArmed === parent.name) {
                                            savedMelodyList.deleteArmed = "";
                                            melodyLib.remove(parent.name);
                                        } else {
                                            savedMelodyList.deleteArmed = parent.name;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Row {
                Layout.alignment: Qt.AlignHCenter
                spacing: 0.2 * unit

                SwPill {
                    label: "DEFAULT MELODY"
                    lit: swSettings.hornBootMelody && !swSettings.hornBootCustom
                    onClicked: { swSettings.hornBootMelody = true; swSettings.hornBootCustom = false; hornSettingsSender.send(); }
                }

                SwPill {
                    label: "+ RECORD NEW"
                    lit: true
                    onClicked: { myMelodiesPopup.close(); melodyPad.startRecording(); }
                }
            }

            // rf99: classics - tap to add one to MY MELODIES (and use it at boot)
            SwNeonLabel {
                Layout.alignment: Qt.AlignHCenter
                font.pixelSize: 0.26 * unit
                text: "CLASSICS"
            }
            Flow {
                Layout.fillWidth: true
                spacing: 0.15 * unit
                Repeater {
                    model: melodyLib.presets
                    SwPill {
                        label: modelData[0].toUpperCase()
                        lit: melodyLib.find(modelData[0]) >= 0
                        onClicked: melodyLib.addPreset(index)
                    }
                }
            }
        }
    }

    // Re-RinkFloat: name a melody from the MIXER recorder
    BaseDialog {
        id: saveMelodyDialog
        parent: ApplicationWindow.overlay

        title: "Save Melody"
        standardButtons: Dialog.Save | Dialog.Cancel

        function show() {
            var cur = melodyLib.currentName();
            melodyNameInput.text = cur.length ? cur : melodyLib.nextName();
            open();
            melodyNameInput.selectAll();
            melodyNameInput.forceActiveFocus();
        }

        onAccepted: melodyLib.save(melodyNameInput.text, hornSettingsSender.notes())

        Column {
            width: saveMelodyDialog.availableWidth
            spacing: 10

            TextField {
                id: melodyNameInput
                width: parent.width
                maximumLength: 20
                placeholderText: "Melody name"
            }

            NText {
                width: parent.width
                font.pointSize: 11
                wrapMode: Text.WordWrap
                text: "Saved in this app. Pick it as your boot melody under CONTROL ▸ BOOT MELODY. Using an existing name replaces that melody."
            }
        }
    }

    BaseDialog {
        id: editTuneDialog

        title: tune ? "Edit Tune" : "Save Tune"
        standardButtons: !!tune ? Dialog.Save | Dialog.Discard | Dialog.Close : Dialog.Save | Dialog.Close

        property var tuneSlot
        property var tune: null

        function show(slot) {
            tuneSlot = slot;
            tune = tuneManager.loadTune(slot);
            editTuneDiff.setModel(packageConfig.diffConfig(tune, true).differs);
            editTuneDiff.reset();

            standardButton(Dialog.Save).enabled = !!tune;
            if (!!tune) {
                standardButton(Dialog.Discard).text = "Erase"
            }

            open();
        }

        function tuneAttr(key) {
            return tune ? tune[key] : "";
        }

        onAccepted: {
            if (saveTuneNameInput.text) {
                if (!tune) {
                    tune = tuneManager.createTune(saveTuneNameInput.text, saveTuneDescInput.text, packageConfig.fetchConfig(true));
                } else {
                    var success = tuneManager.updateTune(tune, saveTuneNameInput.text, saveTuneDescInput.text, saveTuneOverwrite.checked ? packageConfig.fetchConfig(true) : null);
                    if (!success) {
                        return;
                    }
                }
                tuneManager.saveTune(tuneSlot, tune);
                VescIf.emitStatusMessage(saveTuneNameInput.text + " saved", true);
            }
        }

        onDiscarded: {
            tuneManager.eraseTune(tuneSlot);
            VescIf.emitStatusMessage(tune.name + " erased", true);
            close();
        }

        ColumnLayout {
            width: editTuneDialog.availableWidth

            NText {
                Layout.fillWidth: true

                visible: editTuneDialog.tune
                text: "Last saved: %1".arg(Qt.formatDateTime(new Date(editTuneDialog.tuneAttr("date"))));
            }

            RowLayout {
                Layout.fillWidth: true

                LText {
                    text: "Name:"
                }

                TextField {
                    id: saveTuneNameInput
                    Layout.fillWidth: true

                    maximumLength: 30
                    text: editTuneDialog.tuneAttr("name")

                    onTextEdited: {
                        editTuneDialog.standardButton(Dialog.Save).enabled = !!text;
                    }
                }
            }

            LText {
                Layout.fillWidth: true
                text: "Description:"
            }

            TextArea {
                id: saveTuneDescInput
                Layout.fillWidth: true
                implicitHeight: 80

                wrapMode: TextEdit.WordWrap
                text: editTuneDialog.tuneAttr("description") || ""
            }

            ConfigDiff {
                id: editTuneDiff
                Layout.fillWidth: true
                dialog: editTuneDialog
                isTune: true
            }

            CheckBox {
                id: saveTuneOverwrite

                checked: true
                visible: editTuneDialog.tune && !editTuneDiff.isEmpty
                text: "Overwrite with current tune"
            }

            // Re-RinkFloat: neon color for this preset button (saved right away)
            LText {
                Layout.fillWidth: true
                text: "Button color: " + swTheme.neonNames[tuneColorRow.selected]
            }

            Flow {
                id: tuneColorRow
                Layout.fillWidth: true
                spacing: 0.15 * unit

                property int selected: editTuneDialog.tuneSlot ? swTheme.tuneColorIndex(editTuneDialog.tuneSlot) : 0

                Repeater {
                    model: swTheme.neonColors.length

                    Rectangle {
                        width: 0.8 * unit
                        height: width
                        radius: width / 2
                        color: "#0b0718"
                        border.width: index === tuneColorRow.selected ? 4 : 2
                        border.color: swTheme.neonColors[index]

                        Rectangle {
                            anchors.centerIn: parent
                            width: parent.width * 0.45
                            height: width
                            radius: width / 2
                            color: swTheme.neonColors[index]
                            opacity: index === tuneColorRow.selected ? 1 : 0.6
                        }

                        RectangularGlow {
                            anchors.fill: parent
                            z: -1
                            visible: index === tuneColorRow.selected
                            glowRadius: 0.15 * unit
                            spread: 0.3
                            cornerRadius: parent.radius + glowRadius
                            color: swTheme.neonColors[index]
                        }

                        MouseArea {
                            anchors.fill: parent
                            onClicked: swTheme.setTuneColor(editTuneDialog.tuneSlot, index)
                        }
                    }
                }
            }
        }
    }

    BaseDialog {
        id: tuneArchiveDialog
        implicitHeight: fullHeight
        clip: true

        title: "Tune Archive"
        // rf91: Neon Future look - neon cards, neon pill buttons
        standardButtons: Dialog.NoButton
        footer: Item {
            implicitHeight: 1.3 * unit
            Row {
                anchors.centerIn: parent
                spacing: 0.3 * unit
                NeonButton { text: "Refresh"; onClicked: tuneArchiveDialog.download() }
                NeonButton { text: "Close"; lit: true; onClicked: tuneArchiveDialog.close() }
            }
        }

        function download() {
            tuneArchiveDownloadStatus.text = "Downloading tunes...";
            var http = new XMLHttpRequest();
            var url = "http://us-central1-mimetic-union-377520.cloudfunctions.net/float_package_tunes_via_http";
            http.open("GET", url, true);
            http.onreadystatechange = function() {
                if (http.readyState === XMLHttpRequest.DONE) {
                    if (http.status === 200) {
                        tuneArchiveDownloadStatus.text = "Download succesful.";

                        var tunes = tuneManager.parseCsv(http.responseText);
                        tuneManager.saveTuneArchive(tunes);
                        downloadedTunesModel.setTunes(tunes);
                    } else if (http.status === 0) {
                        tuneArchiveDownloadStatus.text = "Download failed: Connection error";
                    } else {
                        tuneArchiveDownloadStatus.text = "Download failed: %1 - %2".arg(http.status).arg(http.statusText);
                    }
                }

            };

            http.send();
        }

        function show() {
            open();

            var tuneArchive = tuneManager.loadTuneArchive();
            // backwards compatibility: Check for the first item settings not being an array (if it is, redownload)
            if (tuneArchive && tuneArchive.length > 0 && !Array.isArray(tuneArchive[0].settings)) {
                downloadedTunesModel.setTunes(tuneArchive);
                tuneArchiveDownloadStatus.text = "Tunes downloaded on %1".arg(tuneManager.getTuneArchiveDate());
            } else {
                download();
            }
        }

        ColumnLayout {
            anchors.centerIn: parent
            width: parent.width * 0.95
            height: parent.height
            spacing: 15
            clip: true

            Text {
                id: tuneArchiveDownloadStatus
                Layout.fillWidth: true
                Layout.alignment: Qt.AlignHCenter

                color: swTheme.neonPurple
                font.family: "Exan"
                font.pixelSize: 0.2 * unit
                font.letterSpacing: 0.02 * unit
                horizontalAlignment: Text.AlignHCenter
                wrapMode: Text.WordWrap
            }

            ListView {
                id: tuneArchiveTunesList
                Layout.fillWidth: true
                Layout.fillHeight: true
                Layout.alignment: Qt.AlignHCenter
                spacing: 10
                clip: true

                model: ListModel {
                    id: downloadedTunesModel

                    function setTunes(tunes) {
                        clear();
                        for (var i in tunes) {
                            append({"tune": tunes[i]});
                        }
                    }
                }

                // rf91: neon card per tune - title in neon, rider below, date tag;
                // "RIDER - TITLE (DATE)" names are split for that
                delegate: Rectangle {
                    id: tuneCard
                    width: tuneArchiveTunesList.width
                    height: tuneCardCol.implicitHeight + 0.36 * unit
                    radius: 0.2 * unit
                    readonly property color neon: swTheme.neonColors[index % swTheme.neonColors.length]
                    readonly property var parts: {
                        var n = String(tune.name), date = "", m = n.match(/\s*\(([^)]*)\)\s*$/);
                        if (m) { date = m[1]; n = n.substring(0, m.index); }
                        var i = n.indexOf(" - ");
                        return i > 0 ? [n.substring(i + 3), n.substring(0, i), date] : [n, "", date];
                    }
                    color: tuneCardArea.pressed ? Qt.rgba(neon.r, neon.g, neon.b, 0.25) : "#140a26"
                    border.color: neon
                    border.width: 2

                    Column {
                        id: tuneCardCol
                        anchors.left: parent.left
                        anchors.right: tuneCardDate.left
                        anchors.leftMargin: 0.3 * unit
                        anchors.rightMargin: 0.15 * unit
                        anchors.verticalCenter: parent.verticalCenter
                        spacing: 0.04 * unit
                        Text {
                            width: parent.width
                            wrapMode: Text.WordWrap
                            text: tuneCard.parts[0].toUpperCase()
                            color: tuneCard.neon
                            font.family: "Exan"
                            font.pixelSize: 0.28 * unit
                            font.letterSpacing: 0.02 * unit
                        }
                        Text {
                            visible: text !== ""
                            width: parent.width
                            elide: Text.ElideRight
                            text: tuneCard.parts[1]
                            color: "#ead6ff"
                            font.pixelSize: 0.22 * unit
                        }
                    }
                    Rectangle {
                        id: tuneCardDate
                        visible: tuneCard.parts[2] !== ""
                        anchors.right: parent.right
                        anchors.rightMargin: 0.25 * unit
                        anchors.verticalCenter: parent.verticalCenter
                        width: visible ? tuneCardDateText.implicitWidth + 0.3 * unit : 0
                        height: 0.42 * unit
                        radius: height / 2
                        color: "transparent"
                        border.color: swTheme.neonPurple
                        border.width: 1
                        Text {
                            id: tuneCardDateText
                            anchors.centerIn: parent
                            text: tuneCard.parts[2].toUpperCase()
                            color: swTheme.neonPurple
                            font.family: "Exan"
                            font.pixelSize: 0.17 * unit
                        }
                    }
                    MouseArea {
                        id: tuneCardArea
                        anchors.fill: parent
                        onClicked: applyConfigDialog.show(tune, false, true)
                    }
                }
            }
        }
    }

    BaseDialog {
        id: alertsDialog

        title: "Alerts"
        standardButtons: Dialog.Close

        function show() {
            alertsDialogListModel.set(alerts.alertsLog);
            activeAlertsItem.visible = alerts.activeAlertCount > 0;
            open();
        }

        Connections {
            target: alerts

            function onAlertAdded(alert) {
                if (alertsDialog.visible) {
                    alertsDialogListModel.add(alert);
                }
            }

            function onActiveAlertCountChanged() {
                if (alerts.activeAlertCount > 0) {
                    activeAlertsItem.visible = true;
                }
            }
        }

        ScrollView {
            anchors.fill: parent
            contentWidth: alertsDialog.availableWidth
            clip: true

            ColumnLayout {
                anchors.fill: parent

                component ErrHeader : NText {
                    Layout.fillWidth: true
                    font.pixelSize: 16
                    horizontalAlignment: Text.AlignHCenter
                }

                component ErrText : NText {
                    Layout.fillWidth: true
                    font.pixelSize: 12
                    font.family: "Mono"
                    color: Utility.getAppHexColor("red")
                }

                component ErrDesc : NText {
                    Layout.fillWidth: true
                    font.pixelSize: 12
                    horizontalAlignment: Text.AlignHCenter
                    wrapMode: Text.WordWrap
                }

                ErrHeader {
                    text: "Package Disabled"
                    visible: state.pkgState === state.s_Disabled
                }

                ErrDesc {
                    text: "{{PACKAGE_NAME}} package is disabled. After you're done with board setup, re-enable it."
                    visible: state.pkgState === state.s_Disabled
                }

                Button {
                    Layout.alignment: Qt.AlignHCenter

                    text: "Enable {{PACKAGE_NAME}}"
                    visible: state.pkgState === state.s_Disabled

                    onClicked: {
                        packageConfig.setDisabled(false);
                    }
                }

                ErrHeader {
                    text: "Connection Errors"
                    visible: state.configLoadingError || state.pkgState === state.s_Disconnected
                }

                ErrText {
                    text: "Refloat Cfg failed to load"
                    visible: state.configLoadingError
                }

                ErrDesc {
                    text: "Reconnecting to the board usually fixes this. If problem persists, try reinstalling the package."
                    visible: state.configLoadingError
                }

                ErrText {
                    text: "Package disconnected"
                    visible: state.pkgState === state.s_Disconnected
                }

                ErrDesc {
                    text: "Package is not responding. May occur temporarily with spotty connection. If board doesn't engage, the package is dead. Restart the board, if problem persists, try reinstalling the package.";
                    visible: state.pkgState === state.s_Disconnected
                }

                Item {
                    id: activeAlertsItem
                    Layout.fillWidth: true

                    Column {
                        id: activeAlertsColumn
                        width: parent.width
                        property bool resetHeight: true

                        ErrHeader {
                            width: parent.width
                            text: "Active Alerts"
                        }

                        Item {
                            width: parent.width
                            height: 5
                        }

                        Repeater {
                            model: alerts.activeAlerts

                            ErrText {
                                property var alert: alerts.getActiveAlertData(modelData)
                                text: alert.name
                                color: alerts.severityColors.get(alert.severity)
                            }
                        }

                        onHeightChanged: {
                            if (resetHeight || !activeAlertsItem.visible || activeAlertsItem.implicitHeight < height) {
                                activeAlertsItem.implicitHeight = height;
                                resetHeight = false;
                            }
                        }
                    }

                    onVisibleChanged: {
                        activeAlertsColumn.resetHeight = true;
                    }
                }

                ErrHeader {
                    text: "Fatal Error"
                    visible: state.fatalError
                }

                // Fatal Error is so far only used for FW Fault
                ErrDesc {
                    text: "VESC reported a fault. Be very careful. You should not continue riding before you fix the root cause. " + (alerts.isFatalActive ? "The Fault is still active, you need to resolve the fault and then clear the error." : "The package will stay in an error state until you clear the error.")
                    visible: state.fatalError
                }

                Button {
                    Layout.alignment: Qt.AlignHCenter

                    text: "Clear Fatal Error"
                    visible: state.fatalError
                    enabled: !alerts.isFatalActive

                    onClicked: {
                        alerts.clearFatalError();
                    }
                }

                ErrHeader {
                    text: "Alert Log"
                }

                Rectangle {
                    color: Utility.getAppHexColor("darkBackground")
                    Layout.fillWidth: true
                    Layout.minimumHeight: 200

                    ListView {
                        id: alertsDialogList
                        anchors.fill: parent
                        anchors.margins: 6
                        clip: true

                        model: ListModel {
                            id: alertsDialogListModel

                            function add(alert) {
                                var wasAtEnd = alertsDialogList.atYEnd;

                                var model = Object.assign({}, alert);
                                Object.assign(model, alerts.getAlertLogData(alert.id));
                                if (!alert.active) {
                                    model.name = model.name + " ended";
                                } else {
                                    if (alert.id === alerts.alert_fwFault) {
                                        model.name = model.name + ": %1 (%2)".arg(model.text).arg(model.code);
                                    }
                                }
                                append(model);

                                if (wasAtEnd) {
                                    alertsDialogList.positionViewAtEnd();
                                }
                            }

                            function set(alertList) {
                                clear();
                                for (var alert of alertList.values()) {
                                    add(alert);
                                }
                            }
                        }

                        delegate: NText {
                            id: alertRecordText
                            width: alertsDialogList.width

                            font.pixelSize: 12
                            font.family: "Mono"
                            wrapMode: Text.WordWrap
                            text: "%1: [<font color=\"%2\">%3</font>] <font color=\"%4\">%5</font>".arg(Qt.formatTime(new Date(time), "hh:mm:ss.zzz")).arg(alerts.severityColors.get(severity)).arg(severity).arg(active ? Utility.getAppHexColor("lightText") : Utility.getAppHexColor("disabledText")).arg(name)
                        }
                    }
                }

                ErrText {
                    text: "Stop Condition: <font color=\"%1\">%2</font>".arg(Utility.getAppHexColor("lightText")).arg(state.stopConditionString)
                    visible: state.stopConditionString
                    color: Utility.getAppHexColor("normalText")
                }

                ErrText {
                    text: "Last Beep Reason: <font color=\"%1\">%2</font>".arg(Utility.getAppHexColor("lightText")).arg(state.beepReasonString)
                    visible: state.beepReasonString
                    color: Utility.getAppHexColor("normalText")
                }
            }
        }
    }

    component ConfigDiff : ColumnLayout {
        id: configDiff

        property BaseDialog dialog
        property bool isTune: false

        property bool isEmpty: diffModel.count === 0

        property real rowHeight: 30
        property real valueColumnWidth: 60

        property real animation: 0
        property real contentHeight: Math.min(maxHeight, diffView.contentHeight + diffHeader.height + 5)
        property real autoHeight: animation * contentHeight
        property real maxHeight

        Behavior on animation {
            id: animBehavior
            NumberAnimation {
                easing.type: Easing.InOutExpo
                duration: 400
            }
        }

        function reset() {
            animBehavior.enabled = false;
            diffCheckbox.checked = false;
            animation = 0;
            animBehavior.enabled = true;
        }

        function showHideDiff(show) {
            if (show) {
                maxHeight = dialog.fullHeight - dialog.height;
            }
            animation = show ? 1 : 0;
        }

        function displayValue(item, value) {
            var type = packageConfig.getParamType(item.name);
            if (type === "Double" || type === "Int") {
                return value.toString();
            } else if (type === "Bool") {
                return value ? "On" : "Off";
            } else if (type === "Enum") {
                return packageConfig.getEnumNames(item.name)[value];
            } else if (type === "String") {
                return value;
            } else if (type === "Bitfield") {
                return "[option set]";
            }

            return "[unknown]";
        }

        function setModel(m) {
            var model = diffModel;
            model.clear();
            var empty = true;
            for (var item of m) {
                item.value = displayValue(item, item.value);
                item.otherValue = displayValue(item, item.otherValue);
                model.append(item);
                empty = false;
            }
            if (empty) {
                diffCheckbox.checked = false;
            }
        }

        CheckBox {
            id: diffCheckbox
            implicitHeight: indicator.height
            Layout.leftMargin: -4
            visible: !isEmpty

            checked: false

            onCheckedChanged: {
                configDiff.showHideDiff(checked);
            }

            contentItem: Item {
                implicitWidth: checkLabel.implicitWidth + 22
                implicitHeight: checkLabel.implicitHeight

                Label {
                    id: checkLabel
                    anchors.left: parent.left
                    anchors.verticalCenter: parent.verticalCenter
                    anchors.leftMargin: 22
                    text: "Differences (%1)".arg(diffModel.count)
                    color: Utility.getAppHexColor("lightText")
                    verticalAlignment: Text.AlignVCenter
                }
            }

            MouseArea {
                anchors.fill: parent
                onClicked: parent.checked = !parent.checked
            }

            indicator: Item {
                width: 30
                height: 30
                Item {
                    anchors.centerIn: parent
                    height: 18
                    width: height / 2
                    clip: true
                    rotation: 90 * animation

                    Rectangle {
                        height: parent.height
                        width: height
                        x: -parent.width
                        rotation: 45
                        scale: 0.707
                        color: Utility.getAppHexColor("lightText")
                    }
                }
            }
        }

        Item {
            implicitHeight: configDiff.autoHeight
            Layout.fillWidth: true
            clip: true

            Row {
                id: diffHeader
                anchors.horizontalCenter: parent.horizontalCenter

                NText {
                    width: diffView.width - 2 * valueColumnWidth - 10
                    horizontalAlignment: Text.AlignLeft
                    verticalAlignment: Text.AlignVCenter
                    text: "Option"
                }

                NText {
                    width: valueColumnWidth
                    horizontalAlignment: Text.AlignRight
                    verticalAlignment: Text.AlignVCenter
                    text: isTune ? "Tune" : "Current";
                }

                NText {
                    width: valueColumnWidth
                    horizontalAlignment: Text.AlignRight
                    verticalAlignment: Text.AlignVCenter
                    text: isTune ? "Current" : "Backup";
                }
            }

            TableView {
                id: diffView
                anchors.top: diffHeader.bottom
                anchors.topMargin: 5
                height: parent.height - diffHeader.height - 5
                width: parent.width
                clip: true

                model: ListModel {
                    id: diffModel
                }

                delegate: Rectangle {
                    color: index % 2 === 0 ? Utility.getAppHexColor("lightBackground") : Utility.getAppHexColor("normalBackground")
                    implicitWidth: diffView.width
                    implicitHeight: rowHeight

                    Row {
                        id: diffRow
                        anchors.centerIn: parent

                        NText {
                            width: diffView.width - 2 * valueColumnWidth - 10
                            height: rowHeight
                            horizontalAlignment: Text.AlignLeft
                            verticalAlignment: Text.AlignVCenter
                            wrapMode: Text.WordWrap
                            fontSizeMode: Text.Fit
                            minimumPointSize: 4
                            text: packageConfig.getDisplayName(name)
                            color: Utility.getAppHexColor("lightText")
                        }

                        NText {
                            width: valueColumnWidth
                            height: rowHeight
                            horizontalAlignment: Text.AlignRight
                            verticalAlignment: Text.AlignVCenter
                            wrapMode: Text.WordWrap
                            fontSizeMode: Text.Fit
                            minimumPointSize: 4
                            text: isTune ? otherValue : value
                        }

                        NText {
                            width: valueColumnWidth
                            height: rowHeight
                            horizontalAlignment: Text.AlignRight
                            verticalAlignment: Text.AlignVCenter
                            wrapMode: Text.WordWrap
                            fontSizeMode: Text.Fit
                            minimumPointSize: 4
                            text: isTune ? value : otherValue
                            color: Utility.getAppHexColor("lightAccent")
                        }
                    }
                }
            }
        }

        NText {
            Layout.fillWidth: true
            horizontalAlignment: Text.AlignHCenter
            visible: isEmpty
            text: "There are no differences to your current config."
        }

        Item {
            Layout.fillWidth: true
        }
    }

    BaseDialog {
        id: applyConfigDialog
        parent: ApplicationWindow.overlay

        title: isTune ? "Apply Tune" : "Restore Config"

        property var config
        property bool automatic: false
        property bool isTune: false

        property var name: config ? config.name : "(Unknown)"
        property var date: config && config.date ? Qt.formatDateTime(new Date(config.date)) : ""
        property var pkg: config && config.package ? "%1 %2".arg(config.package.name).arg(config.package.version) : ""
        property var description: config && config.description ? config.description : ""
        property var diff: config ? packageConfig.diffConfig(config, isTune).differs : []

        onDiffChanged: {
            applyConfigDiff.setModel(diff);
        }

        function show(cfg, auto, tune) {
            config = cfg;
            automatic = !!auto;
            isTune = !!tune;
            applyConfigDiff.reset();
            applyConfigDiff.isTune = isTune;
            if (!applyConfigDiff.isEmpty && !isTune) {
                standardButton(Dialog.Apply).text = "Restore";
            }
            open();
        }

        // workaround: the buttons sometimes wouldn't appear if declared via `standardButtons` only
        footer: DialogButtonBox {
            standardButtons: applyConfigDiff.isEmpty ? Dialog.Close : Dialog.Apply | Dialog.Close
        }

        function set(cfg) {
            config = cfg;
        }

        onApplied: {
            packageConfig.applyConfig(config, isTune);
            close();
            tuneArchiveDialog.close();
        }

        ColumnLayout {
            width: applyConfigDialog.availableWidth

            LText {
                Layout.fillWidth: true
                Layout.bottomMargin: 16
                horizontalAlignment: Text.AlignHCenter
                verticalAlignment: Text.AlignVCenter
                wrapMode: Text.WordWrap
                visible: applyConfigDialog.automatic
                text: "Your package config has been reset after installing a new version. Do you want to restore a backup?"
            }

            LText {
                id: applyConfigName
                Layout.fillWidth: true
                font.pointSize: 14
                horizontalAlignment: Text.AlignHCenter
                text: applyConfigDialog.name;
            }

            NText {
                Layout.fillWidth: true
                font.pointSize: 11
                horizontalAlignment: Text.AlignHCenter
                visible: !!applyConfigDialog.date
                text: applyConfigDialog.date
            }

            NText {
                Layout.fillWidth: true
                font.pointSize: 11
                horizontalAlignment: Text.AlignHCenter
                visible: !!applyConfigDialog.pkg
                text: "Stored by: " + applyConfigDialog.pkg
            }

            LText {
                Layout.fillWidth: true
                visible: !!applyConfigDialog.description
                text: "Description:"
            }

            LText {
                Layout.fillWidth: true
                font.pointSize: 11
                horizontalAlignment: Text.AlignHCenter
                wrapMode: Text.WordWrap
                visible: !!applyConfigDialog.description
                text: applyConfigDialog.description
            }

            ConfigDiff {
                id: applyConfigDiff
                Layout.fillWidth: true
                dialog: applyConfigDialog
            }

            LText {
                Layout.fillWidth: true
                Layout.topMargin: 16
                horizontalAlignment: Text.AlignHCenter
                verticalAlignment: Text.AlignVCenter
                wrapMode: Text.WordWrap
                visible: !applyConfigDiff.isEmpty && !applyConfigDialog.isTune
                text: "Restoring this backup will overwrite your current config."
            }
        }
    }

    Rectangle {
        id: welcomeDialog
        anchors.fill: parent
        z: 100
        visible: false

        color: "#AA000000"

        function show() {
            visible = true;
        }

        Page {
            title: "Welcome to {{PACKAGE_NAME}}"
            anchors.centerIn: parent
            width: parent.width - 20
            padding: 10

            Material.background: Utility.getAppHexColor("normalBackground")

            header: Label {
                text: parent.title
                visible: parent.title
                font.bold: true
                padding: 12
            }

            footer: DialogButtonBox {
                standardButtons: Dialog.Yes | Dialog.No

                onAccepted: {
                    welcomeDialog.visible = false;
                    settingsDialog.show(1);
                }

                onRejected: {
                    welcomeDialog.visible = false;
                }
            }

            ColumnLayout {
                id: welcomeDialogContent
                anchors.fill: parent

                LText {
                    id: welcomeMessage
                    Layout.fillWidth: true
                    wrapMode: Text.WordWrap
                    text: "If you haven't configured your board yet, make sure to configure your motor and IMU before you try to ride the board.\n\nTo run the motor wizard, you need to disable the {{PACKAGE_NAME}} package first. You can do so in {{PACKAGE_NAME}} Settings > Setup, which you can access using the cog button in the top right corner of the main {{PACKAGE_NAME}} screen.\n\nAfter the setup, you can safely verify your board balances correctly using the Handtest mode.\n\nTo configure {{PACKAGE_NAME}}, you need to set the High and Low Voltage Thresholds in Refloat Cfg > Specs according to your battery voltage. The rest of the configuration options has defaults that should provide you with a well-behaving, rideable board.\n\nHappy shredding!\n\nGo to Settings > Setup now?"
                }

                CheckBox {
                    id: welcomeShowAgain

                    checked: !preferences.showWelcomeDialog
                    text: "Don't show again"

                    onCheckedChanged: {
                        preferences.showWelcomeDialog = !checked
                    }
                }
            }
        }
    }

    Rectangle {
        id: uiHintsRect
        anchors.fill: parent
        z: 90
        visible: uiHintsSwipe.count > 0

        color: "#CC000000"

        SwipeView {
            id: uiHintsSwipe
            anchors.fill: parent
            clip: true

            property bool seenAll

            onCurrentIndexChanged: {
                if (currentIndex > 0) {
                    itemAt(currentIndex - 1).shown = true;
                }

                if (currentIndex == count - 1) {
                    seenAll = true;
                }
            }

            function clear() {
                for (let i = count - 1; i >= 0; i--) {
                    takeItem(i);
                }
            }

            function markAllShown() {
                for (let i = 0; i < count; i++) {
                    itemAt(i).shown = true;
                }
            }
        }

        NText {
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.top: parent.top
            anchors.margins: 20
            font.pixelSize: 24
            text: "Tips & Tricks"
        }

        PageIndicator {
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.bottom: uiHintsClose.top
            anchors.bottomMargin: 10

            currentIndex: uiHintsSwipe.currentIndex
            count: uiHintsSwipe.count
        }

        Button {
            anchors.bottom: parent.bottom
            anchors.bottomMargin: 20
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.horizontalCenterOffset: -parent.width * 0.25
            visible: !uiHintsSwipe.seenAll
            text: "Skip now"
            onClicked: {
                uiHintsSwipe.clear();
            }
        }

        Button {
            id: uiHintsClose
            anchors.bottom: parent.bottom
            anchors.bottomMargin: 20
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.horizontalCenterOffset: uiHintsSwipe.seenAll ? 0 : parent.width * 0.25
            text: uiHintsSwipe.seenAll ? "Close" : "Don't show again"
            onClicked: {
                uiHintsSwipe.markAllShown();
                uiHintsSwipe.clear();
            }
        }

        function fill(doDataRecord=false) {
            uiHints.fill(uiHintsSwipe);
            if (doDataRecord) {
                uiHints.fillDataRecord(uiHintsSwipe);
            }

            uiHintsSwipe.seenAll = uiHintsSwipe.currentIndex == uiHintsSwipe.count - 1;
        }

        function fillDataRecord() {
            uiHints.fillDataRecord(uiHintsSwipe);
            uiHintsSwipe.seenAll = uiHintsSwipe.currentIndex == uiHintsSwipe.count - 1;
        }

        // rf90: upstream's hint pages no longer open on start (the
        // Rink-Mixed tour replaces them)
    }

    // rf87: Neon Future tour of the Re-Float Rink-Mixed features (SETTINGS >
    // Show tips & tricks). Swipe or NEXT / BACK; tap outside does nothing.
    Rectangle {
        id: rinkTour
        anchors.fill: parent
        z: 95
        visible: false
        color: "#E6050210"

        function open() { tourSwipe.currentIndex = 0; visible = true; }
        function close() { visible = false; swSettings.tourSeen = true; }

        // [glyph, title, where, text]
        readonly property var pages: [
            ["✦", "RE:FLOAT RINK-MIXED", "WELCOME", "Refloat 1.2.3 under the hood, Neon Future on top. Swipe through what's new; it takes a minute."],
            ["◔", "HOME SCREEN", "MAIN VIEW", "Speed, duty and current on the neon speedo. The side and front views tilt with your board, the battery bar shows your real charge. TILT slider and MAX SPEED / DUTY right there."],
            ["≡", "PULL-UP SHEET", "SWIPE UP", "Drag the sheet up for TUNES, CONTROL, MIXER, DATA, BOARD STYLE and LEDS. Tap anywhere on the main view to put it away."],
            ["♫", "HORN", "HOME + CONTROL", "Hold HORN to beep through the motor, no extra hardware. Sound and volume (10/10 = 4 V) in CONTROL › HORN SETTINGS. It stays well within safe, low motor current."],
            ["♪", "THE MIXER", "MIXER TAB", "Your board is an instrument. Ten neon tiles, ten notes, played right through the motor. Tap and hold a tile in LIVE to jam."],
            ["●", "RECORD A MELODY", "MIXER › REC", "Hit REC, then play your tune on the tiles: recording starts with your first note. The timeline fills as you go; CLEAR to start over."],
            ["▶", "PLAY & SAVE", "MIXER › PLAY / SAVE", "PLAY to hear it back, SAVE to keep it, DONE to make it the melody your board plays when it boots."],
            ["♥", "MY MELODIES", "MIXER › MY MELODIES", "All your saved tunes in one place. Tap one to make it your boot melody, ✎ to edit it on the tiles, ⧉ to copy, ✕ to delete. DEFAULT MELODY brings the original back; MELODY VOLUME sets how loud."],
            ["◢", "BOARD STYLE", "BOARD STYLE TAB", "Pick rails, tire and colors so the board on screen looks like yours."],
            ["◉", "LIGHTS", "LEDS TAB", "HEAD/TAIL LIGHTS: IN MOTION and IDLE levels, SNOOZE before the board powers off. STATUS BAR: idle and riding animations. RGB LIGHTS for controller-driven LEDs (Thor), linked with Refloat's settings."],
            ["▮", "BATTERY GAUGE", "LEDS › BATTERY GAUGE", "Pick your cells and pack for a battery % you can trust, on screen and on the status bar."],
            ["♬", "BEEPER", "LEDS › BEEPER", "Controller beeper on/off with a TEST BEEP, plus the light module's own beeper."],
            ["↻", "UPDATES", "LEDS › UPDATES", "Check for new package and SLCM releases from GitHub, download and flash in a few taps. Floatwheel, XRV, Pint V and GTV light modules with SLCM update over Bluetooth."],
            ["★", "CREDIT WHERE IT'S DUE", "THE ORIGINAL", "Built on Refloat by Lukáš Hrázký (lukash), itself built on the Float package by Mitch Lustig, Dado Mista and Nico Aleman. All the credit for this great package goes to them. I take no credit for any of it."],
            ["⚠", "SAME RIDE", "RIDE WITH CONFIDENCE", "How the board rides is unchanged: balance, tunes, pushbacks, footpads and alerts are Refloat's own code. Everything else was carefully gone through and is mostly quality-of-life and user-experience upgrades: the look, lights, sounds and setup tools. (MAX SPEED is the one opt-in exception: it sets a VESC limit, only if you turn it on.) Have fun out there."]
        ]

        MouseArea { anchors.fill: parent }  // block the screen behind

        Rectangle {
            id: tourCard
            anchors.centerIn: parent
            width: Math.min(parent.width - 0.6 * unit, 9 * unit)
            height: Math.min(parent.height - 1.2 * unit, 11 * unit)
            radius: 0.35 * unit
            color: "#0b0718"
            border.color: swTheme.neonPurple
            border.width: 2

            Text {
                id: tourHead
                anchors.top: parent.top
                anchors.topMargin: 0.3 * unit
                anchors.horizontalCenter: parent.horizontalCenter
                textFormat: Text.StyledText
                text: "<font color='#b14cff'>RE:</font><font color='#ead6ff'>FLOAT</font> <font color='#7a3fc0'>—</font> <font color='#39ff7a'>RINK-MIXED</font>"
                font.family: "Exan"
                font.pixelSize: 0.28 * unit
            }

            SwipeView {
                id: tourSwipe
                anchors.top: tourHead.bottom
                anchors.topMargin: 0.2 * unit
                anchors.left: parent.left
                anchors.right: parent.right
                anchors.bottom: tourDots.top
                anchors.margins: 0.3 * unit
                clip: true

                Repeater {
                    model: rinkTour.pages

                    Item {
                        Column {
                            anchors.centerIn: parent
                            width: parent.width
                            spacing: 0.25 * unit

                            Item {
                                anchors.horizontalCenter: parent.horizontalCenter
                                width: 2.2 * unit
                                height: 2.2 * unit
                                Rectangle {
                                    id: tourRing
                                    anchors.fill: parent
                                    radius: width / 2
                                    color: "transparent"
                                    border.color: swTheme.neonGreen
                                    border.width: 3
                                }
                                Glow {
                                    anchors.fill: tourRing
                                    source: tourRing
                                    radius: Math.round(0.25 * unit)
                                    samples: 2 * radius + 1
                                    color: swTheme.neonGreen
                                    opacity: 0.6
                                }
                                Text {
                                    id: tourGlyph
                                    anchors.centerIn: parent
                                    text: modelData[0]
                                    color: "#d6ffe4"
                                    font.pixelSize: 0.95 * unit
                                }
                                Glow {
                                    anchors.fill: tourGlyph
                                    source: tourGlyph
                                    radius: Math.round(0.2 * unit)
                                    samples: 2 * radius + 1
                                    color: swTheme.neonGreen
                                    opacity: 0.8
                                }
                            }

                            Text {
                                anchors.horizontalCenter: parent.horizontalCenter
                                text: modelData[2]
                                color: swTheme.neonPurple
                                font.family: "Exan"
                                font.pixelSize: 0.2 * unit
                                font.letterSpacing: 0.06 * unit
                            }

                            Item {
                                anchors.horizontalCenter: parent.horizontalCenter
                                width: parent.width
                                height: tourTitle.implicitHeight
                                Text {
                                    id: tourTitle
                                    width: parent.width
                                    horizontalAlignment: Text.AlignHCenter
                                    wrapMode: Text.WordWrap
                                    text: modelData[1]
                                    color: swTheme.neonGreen
                                    font.family: "Exan"
                                    font.pixelSize: 0.42 * unit
                                    font.letterSpacing: 0.04 * unit
                                }
                                Glow {
                                    anchors.fill: tourTitle
                                    source: tourTitle
                                    radius: Math.round(0.15 * unit)
                                    samples: 2 * radius + 1
                                    color: swTheme.neonGreen
                                    opacity: 0.6
                                }
                            }

                            Text {
                                width: parent.width
                                horizontalAlignment: Text.AlignHCenter
                                wrapMode: Text.WordWrap
                                text: modelData[3]
                                color: "#ead6ff"
                                font.pixelSize: 0.27 * unit
                                lineHeight: 1.15
                            }
                        }
                    }
                }
            }

            Row {
                id: tourDots
                anchors.bottom: tourButtons.top
                anchors.bottomMargin: 0.25 * unit
                anchors.horizontalCenter: parent.horizontalCenter
                spacing: 0.12 * unit
                Repeater {
                    model: rinkTour.pages.length
                    Rectangle {
                        width: index === tourSwipe.currentIndex ? 0.4 * unit : 0.14 * unit
                        height: 0.14 * unit
                        radius: height / 2
                        color: index === tourSwipe.currentIndex ? swTheme.neonGreen : "#4a2a73"
                        Behavior on width { NumberAnimation { duration: 150 } }
                    }
                }
            }

            Row {
                id: tourButtons
                anchors.bottom: parent.bottom
                anchors.bottomMargin: 0.3 * unit
                anchors.horizontalCenter: parent.horizontalCenter
                spacing: 0.3 * unit
                NeonButton {
                    text: tourSwipe.currentIndex === 0 ? "Skip" : "Back"
                    onClicked: tourSwipe.currentIndex === 0 ? rinkTour.close() : tourSwipe.decrementCurrentIndex()
                }
                NeonButton {
                    lit: true
                    text: tourSwipe.currentIndex === rinkTour.pages.length - 1 ? "Done" : "Next"
                    onClicked: tourSwipe.currentIndex === rinkTour.pages.length - 1 ? rinkTour.close() : tourSwipe.incrementCurrentIndex()
                }
            }
        }
    }

// Color Preview dialog with an overview of the colors. Uncomment this and the
// FloatingToolButton that shows it to enable it.
