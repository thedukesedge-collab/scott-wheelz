import Qt.labs.settings 1.0
import QtQuick 2.15
import QtQuick.Controls 2.15
import QtQuick.Layouts 1.15
import QtQuick.Dialogs 1.3 as Dl
import QtQuick.Window 2.2
import QtGraphicalEffects 1.15

import Vedder.vesc.vescinterface 1.0
import Vedder.vesc.codeloader 1.0
import Vedder.vesc.commands 1.0
import Vedder.vesc.configparams 1.0
import Vedder.vesc.utility 1.0
import QtQuick.Controls.Material 2.2

Item {
    id: mainItem
    property string tabTitle: "{{PACKAGE_NAME}}"
    property Commands vescCommands: VescIf.commands()

    function round(num) {
        if (num != num) {
            return "--";
        }
        return Math.round(num);
    }

    // Used to fix the float negative zero problem where applicable
    function toFixed1Zero(num) {
        if (num != num) {
            return "-.-";
        }
        return num.toFixed(1).replace("-0.0", "0.0");
    }

    function toFixed2Zero(num) {
        if (num != num) {
            return "-.--";
        }
        return num.toFixed(2).replace("-0.00", "0.00");
    }

    function clamp(val, min, max) {
        if (val > max) {
            return max;
        }

        if (val < min) {
            return min;
        }

        return val;
    }

    function arraysEqual(a, b) {
        if (a === b) return true;
        if (a == null || b == null) return false;
        if (a.length !== b.length) return false;

        for (var i = 0; i < a.length; ++i) {
            if (a[i] !== b[i]) return false;
        }
        return true;
    }

    function dist(a, b) {
        return Math.abs(a - b);
    }

    function parseVersion(ver) {
        var dotSplit = ver.split(".");
        if (dotSplit.length < 3) {
            return [0, 0, 0, ""];
        }

        var lastPart = dotSplit[2];
        var dashPos = lastPart.search("-");
        var patch = lastPart;
        var suffix = "";
        if (dashPos > 0) {
            patch = lastPart.substring(0, dashPos);
            suffix = lastPart.substring(dashPos + 1);
        }

        return [Number(dotSplit[0]), Number(dotSplit[1]), Number(patch), suffix];
    }

    function versionMajorMinor(ver) {
        var arr = ver.split(".");
        if (arr.length < 2) {
            return [0, 0];
        }

        return [Number(arr[0]), Number(arr[1])];
    }

    // Expects arrays containing 3 numbers, returns -1 if a < b, 1 if a > b and 0 if a == b
    function cmpVersion(a, b) {
        for (var i = 0; i < 3; i++) {
            if (a[i] < b[i]) {
                return -1;
            } else if (a[i] > b[i]) {
                return 1;
            }
        }
        return 0;
    }

    function getDarkThemeColor(name) {
        switch (name) {
        case "normalBackground":
            return "#303030";
            break;
        case "darkBackground":
            return "#272727";
            break;
        case "normalText":
            return "#b4b4b4";
            break;
        case "lightText":
            return "#dcdcdc";
            break;
        case "disabledText":
            return "#7f7f7f";
            break;
        }
    }

    // 5s timeout for connection to package
    Timer {
        id: packageConnectionWatchdog
        interval: 5000
        running: true

        onTriggered: {
            state.pkgState = state.s_Disconnected;
        }
    }

    // 10hz for realtime data
    Timer {
        running: true
        repeat: true
        interval: 100
        onTriggered: {
            vescCommands.getValuesSetup();

            if (state.commsState === state.comms_Info) {
                commands.sendGetInfo();
            } else if (state.commsState === state.comms_RTDataIDs) {
                commands.sendGetRtDataIds();
            } else {
                commands.sendGetRtData();
            }

            if (moveSlider.value != 0) {
                commands.sendRcMove(moveSlider.value);
            }

            // Re-RinkFloat: free-spin limiter, resent every second (the board
            // forgets it on power cycle)
            freespinSender.tick();

            // Re-RinkFloat: keep the horn alive while the button is held
            hornFrame.tick();
            if (hornFrame.honking) {
                commands.sendHorn(1);
            }

            // Re-RinkFloat: main-screen TILT slider wins while it's in use; one
            // final 0 is sent after it springs back
            var swTiltActive = swTiltSlider.pressed || swTiltSlider.value != 0;
            if (swTiltActive || swTiltSlider.sentNonZero) {
                vescCommands.lispSendReplCmd("(set-remote-state " + swTiltSlider.input().toFixed(3) + " 0 0 0 0)");
                swTiltSlider.sentNonZero = swTiltActive;
            } else if (tiltEnabled.checked) {
                vescCommands.lispSendReplCmd("(set-remote-state " + tiltSlider.value + " 0 0 0 0)");
            }
        }
    }

    // Re-RinkFloat: once-a-second sender (light / horn settings). rf102: no
    // longer sends the removed free-spin limit (COMMAND_FREESPIN_LIMIT, ignored
    // by the package since rf75) - one less BLE packet every second.
    QtObject {
        id: freespinSender

        property int count: 0

        function tick() {
            if (++count >= 10) {
                count = 0;
                ledSender.tick();
                // horn settings every second; the melody only when it changed, or every 10 s
                hornSettingsSender.send(++hornSettingsSender.melodyTick % 10 === 0);
            }
        }
    }

    // Re-RinkFloat: horn-only sound settings, resent every second (kept on
    // the board too since rf49)
    QtObject {
        id: hornSettingsSender

        // simple levels -> real values
        function simpleBuzz(level) { return level * 1.5; }
        function simpleBeep(level) { return level * 0.4; }  // rf81: 10/10 = 4 V
        // boot melody 1-10 -> 0.25-2.5 V; the package caps it at 2.5 V too
        function bootVolume(level) { return Math.max(1, Math.min(10, level)) * 0.25; }
        function simplePitch(level) { return Math.round((300 + (level - 1) * 700 / 9) / 25) * 25; }

        // the values actually sent: [beep V, beep Hz, buzz A, buzz Hz]
        function values() {
            if (swSettings.hornAdvanced) {
                return [Math.min(4, swSettings.hornBeepStrength), swSettings.hornBeepFreq,
                        swSettings.hornBuzzStrength, swSettings.hornBuzzFreq];
            }
            return [simpleBeep(swSettings.hornSimpleVolume), simplePitch(swSettings.hornSimplePitch),
                    simpleBuzz(swSettings.hornSimpleStrength), 70];
        }

        // switching modes carries the sound over, so nothing jumps
        function setAdvanced(on) {
            if (on === swSettings.hornAdvanced) return;
            var v = values();
            if (on) {
                swSettings.hornBeepStrength = Math.round(v[0] * 5) / 5;
                swSettings.hornBeepFreq = v[1];
                swSettings.hornBuzzStrength = Math.round(v[2]);
                swSettings.hornBuzzFreq = v[3];
            } else {
                swSettings.hornSimpleVolume = Math.max(1, Math.min(10, Math.round(v[0] / 0.4)));
                swSettings.hornSimplePitch = Math.max(1, Math.min(10, Math.round((v[1] - 300) * 9 / 700) + 1));
                swSettings.hornSimpleStrength = Math.max(0, Math.min(10, Math.round(v[2] / 1.5)));
            }
            swSettings.hornAdvanced = on;
            send();
        }

        property string lastMelody: ""
        property int melodyTick: 0

        function send(forceMelody) {
            var v = values();
            var data = commands.createData(10, commands.c_HORN_SETTINGS);
            data.setUint8(2, Math.round(v[0] * 10));
            data.setUint16(3, v[1]);
            data.setUint8(5, Math.round(v[2] * 10));
            data.setUint16(6, v[3]);
            data.setUint8(8, (swSettings.hornBootMelody ? 1 : 0) | (swSettings.hornBootCustom ? 2 : 0));
            data.setUint8(9, Math.round(bootVolume(swSettings.bootMelodyVolume) * 10));
            vescCommands.sendCustomAppData(data.buffer);
            // the melody is a big packet: only when it changed (keeps Bluetooth free
            // so setting changes aren't dropped)
            if (forceMelody || swSettings.melodyRec !== lastMelody) sendMelody();
        }

        // a horn setting was changed with the arrows: send now and once more
        // shortly after, in case Bluetooth dropped it. (No preview beep: only the
        // HORN button sounds the horn, so presses and setting changes can't mix.)
        function changed() {
            send();
            hornRetryTimer.restart();
        }

        property Timer retryTimer: Timer {
            id: hornRetryTimer
            interval: 300
            onTriggered: hornSettingsSender.send()
        }

        // custom melody: notes + rests (level 0), 4 s total, 2 s per note; sent as
        // (level, 20 ms units). Levels 1-10 are the notes E4 F4 G4 A4 B4 C5 D5 E5 F5 G5.
        function notes() {
            try {
                var n = JSON.parse(swSettings.melodyRec);
                return Array.isArray(n) ? n.slice(0, 32) : [];
            } catch (e) {
                return [];
            }
        }

        function sendMelody() {
            var n = notes();
            lastMelody = swSettings.melodyRec;
            var data = commands.createData(2 + 2 * n.length, commands.c_MELODY_SET);
            for (var i = 0; i < n.length; i++) {
                data.setUint8(2 + 2 * i, Math.max(0, Math.min(10, n[i][0])));
                data.setUint8(3 + 2 * i, Math.max(2, Math.min(100, Math.round(n[i][1] / 20))));
            }
            vescCommands.sendCustomAppData(data.buffer);
        }

        // melody tiles: live tone while a tile is held (level 0 = stop)
        function liveTone(level) {
            var data = commands.createData(3, commands.c_LIVE_TONE);
            data.setUint8(2, level);
            vescCommands.sendCustomAppData(data.buffer);
        }

        function playMelody(custom) {
            send();  // so it plays with the current volume / notes
            var data = commands.createData(3, commands.c_PLAY_MELODY);
            data.setUint8(2, custom ? 1 : 0);
            vescCommands.sendCustomAppData(data.buffer);
        }
    }

    // Re-RinkFloat: light module settings (SLCM build, see lcm/README.md).
    // Sent on every change (plus one retry) and every 5 s once the LEDS tab
    // has been used; the board stores them and passes them to the light
    // module in every poll reply, so they also apply without the phone.
    QtObject {
        id: ledSender

        readonly property var animNames: ["STANDARD", "RAINBOW SCAN", "RAINBOW MIRROR", "KNIGHT RIDER",
            "RAINBOW BAR", "THE FUZZ", "FIRE", "PULSE OUT", "PULSE IN", "120 SCROLL", "COMP. WAVE",
            "CLASSIC", "COLOR SCAN", "BATTERY LEVEL", "CUSTOM"]

        // CUSTOM animation (SLCM r19+): 8 bytes, see the SLCM's status_leds.c
        // [0] bit0 engine (0 fill, 1 scan), bits1-3 colors, bits4-6 pattern;
        // [1] brightness (fill: 0 steady, 1 breathe, 2 flash); [2], [3] hues / 2;
        // [4] color speed, [5] motion speed: (n + 1) * 50 ms; [6] lowest brightness
        function custom() {
            try {
                var c = JSON.parse(swSettings.ledCustom);
                if (Array.isArray(c) && c.length === 8) return c;
            } catch (e) {}
            return [0x24, 1, 0, 150, 39, 29, 60, 0];
        }
        function setCustom(i, v) {
            var c = custom();
            c[i] = Math.max(0, Math.min(255, Math.round(v)));
            swSettings.ledCustom = JSON.stringify(c);
            changed();
        }
        // field helpers: engine, colors, pattern
        function customField(f) {
            var c0 = custom()[0];
            return f === 0 ? (c0 & 1) : f === 1 ? ((c0 >> 1) & 7) : ((c0 >> 4) & 7);
        }
        function setCustomField(f, v) {
            var c0 = custom()[0];
            if (f === 0) c0 = (c0 & ~1) | (v & 1);
            else if (f === 1) c0 = (c0 & ~0x0E) | ((v & 7) << 1);
            else c0 = (c0 & ~0x70) | ((v & 7) << 4);
            if (f === 0) c0 &= ~0x70;  // pattern lists differ: start at the first
            setCustom(0, c0);
        }
        // what 0 does depends on where it's used: idle / boot / shutdown show the
        // standard battery + footpad display, riding and snooze show nothing
        // (riding still shows a low battery)
        readonly property var animContexts: [["IDLE", "ledAnimIdle", "STANDARD"], ["RIDING", "ledAnimRide", "OFF"],
            ["SNOOZE", "ledAnimDoze", "OFF"], ["BOOT", "ledAnimBoot", "STANDARD"], ["SHUTDOWN", "ledAnimShutdown", "STANDARD"]]
        function animLabel(ctx, v) {
            return v === 128 || v === 15 ? "STATUS BAR" : v === 0 ? animContexts[ctx][2] : (animNames[v] || "");
        }

        // ---- Refloat's own Status Idle animation (rf72): the one idle
        // animation every controller understands. Stored in the Refloat
        // config (leds.status_idle.*, leds.status.idle_timeout); Refloat's
        // LEDs play it themselves, for an SLCM the package translates it
        // (IDLE = 128, see lcm.c refloat_idle_anim).
        readonly property var rfModes: ["SOLID", "FADE", "PULSE", "STROBE", "KNIGHT RIDER", "FELONY",
            "RAINBOW CYCLE", "RAINBOW FADE", "RAINBOW ROLL"]
        readonly property var rfColors: ["BLACK", "WHITE", "WHITE (RGB)", "WHITE (SINGLE)", "RED", "FERRARI",
            "FLAME", "CORAL", "SUNSET", "SUNRISE", "GOLD", "ORANGE", "YELLOW", "BANANA", "LIME", "ACID", "SAGE",
            "GREEN", "MINT", "TIFFANY", "CYAN", "STEEL", "SKY", "AZURE", "SAPPHIRE", "BLUE", "VIOLET", "AMETHYST",
            "MAGENTA", "PINK", "FUCHSIA", "LAVENDER"]
        // hue / 2 per color, as in lcm.c (-1: black / white)
        readonly property var rfHue: [-1, -1, -1, -1, 0, 7, 9, 5, 10, 13, 13, 14, 19, 18, 30, 41, 46, 60, 69, 83, 90,
            107, 100, 101, 107, 120, 135, 132, 150, 157, 167, 170]
        function rfQColor(i) {
            // rf101: real color objects (strings broke the preview's blending: WHITE background = invisible)
            return i === 0 ? Qt.rgba(0.125, 0.125, 0.125, 1) : rfHue[i] < 0 ? Qt.rgba(1, 1, 1, 1) : Qt.hsla(rfHue[i] * 2 / 360, 1, 0.5, 1);
        }
        property int rfMode: 4
        property int rfColor1: 4
        property int rfColor2: 0
        property real rfSpeed: 1.0
        property int rfTimeout: 0  // 0: Refloat's idle animation off (battery display)
        property bool rfLoaded: false  // read from the Refloat config (never write defaults over it)
        readonly property bool rfOn: rfTimeout > 0
        // Refloat's riding status bar: battery level, the duty bar above
        // leds.status.duty_threshold (Refloat uses at least 15%; 100% = never),
        // footpad sensors (leds.status.show_sensors_while_running)
        property real rfDutyTh: 0.5
        property bool rfSensors: true
        property bool rfStatusAvail: false  // Refloat's own status strip is set up
        // rf85: LED Mode includes an external light module (LCM). Without one
        // (e.g. a Thor on controller-driven LEDs) the LCM firmware tools are hidden.
        property bool lcmModule: true
        property bool ctrlBeep: true  // is_beeper_enabled (Refloat's beeper on Servo/PPM, also the write beep)
        // rf87: the colors offered (Refloat's enum indexes): the basic ones;
        // a color set in VESC Tool outside this list still shows by its name
        // and is kept until changed here
        readonly property var rfColorSet: [0, 1, 4, 11, 12, 14, 17, 18, 19, 20, 22, 25, 26, 28, 29]
        function rfColorNext(cur, dir) {
            var l = rfColorSet;
            if (dir > 0) {
                for (var i = 0; i < l.length; i++) if (l[i] > cur) return l[i];
            } else {
                for (var j = l.length - 1; j >= 0; j--) if (l[j] < cur) return l[j];
            }
            return cur;
        }
        // readable text color for a Refloat LED color (black shown dim grey)
        function rfTextColor(i) {
            return i === 0 ? "#8a8a8a" : rfHue[i] < 0 ? "#ffffff" : Qt.hsla(rfHue[i] * 2 / 360, 1, 0.62, 1);
        }
        readonly property bool idleFollows: swSettings.ledAnimIdle === 128
        readonly property string rfSummary: !rfOn ? "IDLE: BATTERY" : "IDLE: " + rfModes[rfMode]
        function setRf(key, v) {
            if (!rfLoaded) fromConfig();
            ledSender[key] = v;
            swSettings.ledAnimIdle = 128;  // the SLCM follows it again
            changed();
        }
        property int count: 0

        function send() {
            if (!swSettings.ledConfigured) return;
            var data = commands.createData(25, commands.c_LCM_VP_SETTINGS);
            data.setUint8(2, (swSettings.ledHeadlights ? 1 : 0) | (swSettings.ledStatusBar ? 2 : 0) | (swSettings.ledBeep ? 4 : 0)
                | (swSettings.ledSnoozeStyle === 2 ? 0x20 : 0));  // rf97: DARK snooze
            data.setUint8(3, swSettings.ledHeadlightPct);
            data.setUint8(4, swSettings.ledStatusIdlePct);
            data.setUint8(5, swSettings.ledStatusRidePct);
            data.setUint8(6, swSettings.ledAnimIdle);
            data.setUint8(7, swSettings.ledAnimRide);
            data.setUint8(8, swSettings.ledAnimDoze);
            data.setUint8(9, swSettings.ledAnimBoot);
            data.setUint8(10, swSettings.ledAnimShutdown);
            data.setUint16(11, swSettings.ledColor);
            data.setUint8(13, swSettings.ledHeadlightIdlePct);
            var cu = custom();
            for (var ci = 0; ci < 8; ci++) data.setUint8(14 + ci, cu[ci]);
            data.setUint8(22, swSettings.ledSnoozeMin);  // rf86: controller LEDs snooze (255 AUTO)
            data.setUint8(23, swSettings.ledRideMode);  // rf97
            data.setUint8(24, swSettings.ledSnoozeStyle);
            vescCommands.sendCustomAppData(data.buffer);
        }

        // ---- quick light switches (LEDS > Lights; any controller): they
        // override the other light settings (brightness etc. are kept) and work
        // riding and idle. controller-driven LEDs follow via its lights control,
        // an SLCM via the VP flags.
        readonly property bool quickAvailable: lights.enabled || slcmDetect.present || swSettings.ledConfigured
        readonly property bool allOn: swSettings.ledHeadlights && swSettings.ledStatusBar && (!lights.enabled || lights.on)
        readonly property string overrideText: !quickAvailable ? ""
            : (!swSettings.ledHeadlights && !swSettings.ledStatusBar) || (lights.enabled && !lights.on) ? "ALL LIGHTS OFF"
            : !swSettings.ledHeadlights ? "HEAD/TAIL LIGHTS OFF"
            : !swSettings.ledStatusBar ? "STATUS LIGHTS OFF" : ""
        function setHead(on) {
            swSettings.ledHeadlights = on;
            changed();
            if (lights.enabled) commands.sendLightsControl(on ? true : undefined, on);
        }
        function setStatus(on) {
            swSettings.ledStatusBar = on;
            changed();
            if (on && lights.enabled && !lights.on) commands.sendLightsControl(true);
        }
        function setAll(on) {
            swSettings.ledHeadlights = on;
            swSettings.ledStatusBar = on;
            changed();
            if (lights.enabled) commands.sendLightsControl(on, on);
        }

        function changed() {
            swSettings.ledConfigured = true;
            send();
            ledRetryTimer.restart();
            ledCfgWriteTimer.restart();  // mirror into the Refloat LED config
        }

        // controller beeper (Refloat's, on Servo/PPM)
        function setCtrlBeep(on) {
            if (!rfLoaded) fromConfig();
            ctrlBeep = on;
            ledCfgWriteTimer.restart();
        }
        function testCtrlBeep() {
            var data = commands.createData(3, commands.c_LCM_TEST_BEEP);
            data.setUint8(2, 1);
            vescCommands.sendCustomAppData(data.buffer);
        }

        // LCM test beep: settings first (the beep request rides in the VP block)
        function testBeep() {
            if (!swSettings.ledConfigured) {
                swSettings.ledConfigured = true;
                ledCfgWriteTimer.restart();
            }
            send();
            vescCommands.sendCustomAppData(commands.createData(2, commands.c_LCM_TEST_BEEP).buffer);
        }

        // ---- two-way sync with the Refloat LED config (VESC Tool > Refloat Cfg > LEDs)
        // headlights on        <-> leds.headlights_on
        // headlights riding %  <-> leds.headlights.brightness
        // headlights idle %    <-> leds.front.brightness (Refloat's idle level for light modules)
        // status bar idle %    <-> leds.status_idle.brightness
        // status bar riding %  <-> leds.status.brightness_headlights_on (and _off)
        // Animations, color and the beeper have no Refloat setting.
        readonly property var cfgMap: [
            ["ledHeadlightPct", "leds.headlights.brightness"],
            ["ledHeadlightIdlePct", "leds.front.brightness"],
            ["ledStatusIdlePct", "leds.status_idle.brightness"],
            ["ledStatusRidePct", "leds.status.brightness_headlights_on"],
            ["ledStatusRidePct", "leds.status.brightness_headlights_off"]
        ]

        function cfgReady() {
            return !!packageConfig.pkgConfig && VescIf.customConfigsLoaded();
        }

        // What each mirrored setting was when last read from / written to the
        // Refloat config: only settings changed here since then are written,
        // so custom values set in VESC Tool (e.g. different status brightness
        // with headlights on / off, or 37.5%) are never rounded or overwritten.
        property var cfgSnap: ({})

        // ---- RGB LIGHTS (Refloat's own LED animations, for RGB strips such as
        // Thor's): the four Refloat light bars. HEAD/TAIL play with the
        // headlights on, FRONT/REAR (running lights) with them off; Refloat
        // swaps front and rear when riding backwards. Only shown when Refloat's
        // LEDs are set up (hardware.leds.mode not off, a front or rear strip).
        readonly property var rgbBars: ["headlights", "taillights", "front", "rear"]
        readonly property var rgbBarNames: ["HEAD", "TAIL", "FRONT", "REAR"]
        property var rgb: [{}, {}, {}, {}]  // {mode, c1, c2, speed, bri}
        property var rgbSnap: [{}, {}, {}, {}]
        property bool rgbLifted: false  // leds.lights_off_when_lifted
        property bool rgbLiftedSnap: false
        property bool rgbAvail: false
        property bool rgbLoaded: false
        // brightness 0..100. HEAD and FRONT brightness are the HEADLIGHTS
        // window's RIDING / RUNNING levels (same Refloat settings), so they go
        // through those
        function rgbBri(bar) {
            return bar === 0 ? swSettings.ledHeadlightPct : bar === 2 ? swSettings.ledHeadlightIdlePct
                : Math.round((rgb[bar].bri || 0) * 100);
        }
        function rgbSetBri(bar, pct) {
            if (bar === 0 || bar === 2) {
                swSettings[bar === 0 ? "ledHeadlightPct" : "ledHeadlightIdlePct"] = pct;
                changed();
            } else {
                rgbSet(bar, "bri", pct / 100);
            }
        }
        // rf102: FADE, PULSE, STROBE, KNIGHT RIDER are one-color animations
        // (color 2 = the background / "off" color): picking one from another
        // kind of animation starts it with a BLACK background (BACKGROUND OFF)
        function oneColor(m) { return m >= 1 && m <= 4; }
        function rgbSet(bar, key, v) {
            if (!rgbLoaded) return;
            var r = rgb.slice();
            var b = Object.assign({}, r[bar]);
            if (key === "mode" && oneColor(v) && !oneColor(b.mode)) b.c2 = 0;
            b[key] = v;
            r[bar] = b;
            rgb = r;
            ledCfgWriteTimer.restart();
        }
        function rgbSetLifted(on) {
            if (!rgbLoaded) return;
            rgbLifted = on;
            ledCfgWriteTimer.restart();
        }

        function toConfig() {
            if (!cfgReady()) return;
            // rf77 safety: never mirror into the Refloat config (a config
            // write) while riding - try again once the board is stopped (the
            // package also defers the flash write until it's at rest)
            if (mainItem.boardRunning) {
                ledCfgWriteTimer.restart();
                return;
            }
            var c = packageConfig.pkgConfig;
            var dirty = false;
            if (c.getParamBool("leds.headlights_on") !== swSettings.ledHeadlights) {
                c.updateParamBool("leds.headlights_on", swSettings.ledHeadlights);
                dirty = true;
            }
            var snap = cfgSnap;
            for (var i = 0; i < cfgMap.length; i++) {
                var k = cfgMap[i][0];
                // unchanged here since it was read: leave the exact value alone
                if (snap[k] !== undefined && snap[k] === swSettings[k]) continue;
                if (Math.round(c.getParamDouble(cfgMap[i][1]) * 100) !== swSettings[k]) {
                    c.updateParamDouble(cfgMap[i][1], swSettings[k] / 100);
                    dirty = true;
                }
            }
            for (var j = 0; j < cfgMap.length; j++) snap[cfgMap[j][0]] = swSettings[cfgMap[j][0]];
            cfgSnap = snap;
            if (rgbLoaded) {
                for (var b = 0; b < 4; b++) {
                    var n = "leds." + rgbBars[b] + ".", r = rgb[b], o = rgbSnap[b];
                    if (r.mode !== o.mode) { c.updateParamEnum(n + "mode", r.mode); dirty = true; }
                    if (r.c1 !== o.c1) { c.updateParamEnum(n + "color1", r.c1); dirty = true; }
                    if (r.c2 !== o.c2) { c.updateParamEnum(n + "color2", r.c2); dirty = true; }
                    if (Math.abs(r.speed - o.speed) > 0.0001) { c.updateParamDouble(n + "speed", r.speed); dirty = true; }
                    // (HEAD / FRONT brightness: via cfgMap above)
                    if (b % 2 === 1 && Math.abs(r.bri - o.bri) > 0.0001) { c.updateParamDouble(n + "brightness", r.bri); dirty = true; }
                }
                rgbSnap = rgb.slice();
                if (rgbLifted !== rgbLiftedSnap) {
                    c.updateParamBool("leds.lights_off_when_lifted", rgbLifted);
                    rgbLiftedSnap = rgbLifted;
                    dirty = true;
                }
            }
            var en = !rfLoaded ? [] : [["leds.status_idle.mode", rfMode], ["leds.status_idle.color1", rfColor1],
                ["leds.status_idle.color2", rfColor2]];
            for (var e = 0; e < en.length; e++) {
                if (c.getParamEnum(en[e][0]) !== en[e][1]) {
                    c.updateParamEnum(en[e][0], en[e][1]);
                    dirty = true;
                }
            }
            if (rfLoaded && Math.abs(c.getParamDouble("leds.status_idle.speed") - rfSpeed) > 0.001) {
                c.updateParamDouble("leds.status_idle.speed", rfSpeed);
                dirty = true;
            }
            if (rfLoaded && c.getParamInt("leds.status.idle_timeout") !== rfTimeout) {
                c.updateParamInt("leds.status.idle_timeout", rfTimeout);
                dirty = true;
            }
            if (rfLoaded && Math.abs(c.getParamDouble("leds.status.duty_threshold") - rfDutyTh) > 0.001) {
                c.updateParamDouble("leds.status.duty_threshold", rfDutyTh);
                dirty = true;
            }
            if (rfLoaded && c.getParamBool("is_beeper_enabled") !== ctrlBeep) {
                c.updateParamBool("is_beeper_enabled", ctrlBeep);
                dirty = true;
            }
            if (rfLoaded && c.getParamBool("leds.status.show_sensors_while_running") !== rfSensors) {
                c.updateParamBool("leds.status.show_sensors_while_running", rfSensors);
                dirty = true;
            }
            if (dirty) packageConfig.writeConfig();
        }

        function fromConfig() {
            if (!cfgReady() || ledCfgWriteTimer.running) return;  // our own change is newer
            var c = packageConfig.pkgConfig;
            var changedAny = false;
            var on = c.getParamBool("leds.headlights_on");
            if (on !== swSettings.ledHeadlights) {
                swSettings.ledHeadlights = on;
                changedAny = true;
            }
            var snap = cfgSnap;
            for (var i = 0; i < cfgMap.length - 1; i++) {  // RIDING shows _on (_off is written only when RIDING is changed)
                var pct = Math.max(0, Math.min(100, Math.round(c.getParamDouble(cfgMap[i][1]) * 100)));
                if (pct !== swSettings[cfgMap[i][0]]) {
                    swSettings[cfgMap[i][0]] = pct;
                    changedAny = true;
                }
                snap[cfgMap[i][0]] = pct;
            }
            cfgSnap = snap;
            var r = [];
            for (var b = 0; b < 4; b++) {
                var n = "leds." + rgbBars[b] + ".";
                r.push({mode: c.getParamEnum(n + "mode"), c1: c.getParamEnum(n + "color1"), c2: c.getParamEnum(n + "color2"),
                        speed: c.getParamDouble(n + "speed"), bri: c.getParamDouble(n + "brightness")});
            }
            rgb = r;
            rgbSnap = r.slice();
            rgbLifted = rgbLiftedSnap = c.getParamBool("leds.lights_off_when_lifted");
            rgbAvail = c.getParamEnum("hardware.leds.mode") !== 0
                && (c.getParamInt("hardware.leds.front.count") > 0 || c.getParamInt("hardware.leds.rear.count") > 0);
            rgbLoaded = true;
            rfMode = c.getParamEnum("leds.status_idle.mode");
            rfColor1 = c.getParamEnum("leds.status_idle.color1");
            rfColor2 = c.getParamEnum("leds.status_idle.color2");
            rfSpeed = c.getParamDouble("leds.status_idle.speed");
            rfTimeout = c.getParamInt("leds.status.idle_timeout");  // the package reads these itself
            rfDutyTh = c.getParamDouble("leds.status.duty_threshold");
            rfSensors = c.getParamBool("leds.status.show_sensors_while_running");
            ctrlBeep = c.getParamBool("is_beeper_enabled");
            rfStatusAvail = c.getParamEnum("hardware.leds.mode") !== 0 && c.getParamInt("hardware.leds.status.count") > 0;
            lcmModule = (c.getParamEnum("hardware.leds.mode") & 2) !== 0;
            rfLoaded = true;
            if (changedAny) send();  // only goes out once the LEDS tab has been used
        }

        property Timer cfgWriteTimer: Timer {
            id: ledCfgWriteTimer
            interval: 1500
            onTriggered: ledSender.toConfig()
        }

        property Connections cfgConns: Connections {
            target: packageConfig
            function onUpdate() { ledSender.fromConfig(); }
        }

        // called every second (with the free-spin limiter)
        function tick() {
            if (++count >= 5) {
                count = 0;
                send();
            }
        }

        property Timer retryTimer: Timer {
            id: ledRetryTimer
            interval: 300
            onTriggered: ledSender.send()
        }
    }

    // Re-RinkFloat: LCM firmware update over the VESC link (needs the LCM
    // bootloader, installed once with an ST-Link). The image is built with
    // the package (lcm/alcm, BL=1) and embedded here. The package relays it
    // to the LCM bootloader two 128-byte pages at a time: we poll STATUS and
    // send the page the LCM wants plus the next one. See lcm_fw.h.
    // Re-Float Rink-Mixed: is an SLCM (Smart LCM: our ALCM-based light
    // module firmware) answering? It names itself "VP-..." / "VPBL-..." in its
    // LCM polls; the package passes the name on (COMMAND_LCM_DEVICE_INFO).
    // Asked every few seconds while the LEDS tab is open. Only decides what the
    // LEDS tab shows; flashing still needs CHECK LCM. Any other controller /
    // LCM keeps Refloat's own LED controls.
    QtObject {
        id: slcmDetect
        readonly property bool present: lcmFw.lcmName.indexOf("VP-") === 0 || lcmFw.lcmName.indexOf("VPBL-") === 0 || lcmFw.legacy
        readonly property bool known: lcmFw.nameKnown
        readonly property string version: lcmFw.legacy ? "older build (before r15)" : lcmFw.verText(lcmFw.lcmVer)
        property bool tabOpen: false
        property Timer pollTimer: Timer {
            interval: 3000
            repeat: true
            triggeredOnStart: true
            running: slcmDetect.tabOpen && !lcmFw.active && lcmFw.checkState !== 1
            onTriggered: lcmFw.probe()  // name + STATUS (is an LCM polling at all)
        }
    }

    QtObject {
        id: lcmFw

        // {size, crc, version, b64}, or null if this build has no LCM image
        readonly property var builtin: {{LCM_FW_JSON}}
        // a .hex picked by the user: {size, crc, version (file name), bytes}
        property var picked: null
        property bool usePicked: false
        // what FLASH LCM sends
        // rf70+: the package normally carries only the SLCM version ({version}),
        // not the image (it made the package heavy): the rider picks the .hex
        readonly property bool builtinImage: !!builtin && !!builtin.b64
        readonly property var image: picked && (usePicked || !builtinImage) ? picked : (builtinImage ? builtin : null)
        property var builtinBytes: null
        property var bytes: null

        // package state: 0 idle, 1 staged, 2 sending, 3 ok, 4 failed
        property int pkgState: 0
        property int pkgError: 0
        property int want: 0
        property bool active: false  // an update this app started is in progress
        property real progress: 0
        property string message: ""
        property int noReply: 0

        // --- what's fitted (fail-safe): the LCM names itself in its polls
        // ("VPBL-<hash>" = SLCM with the bootloader, "VP-<hash>" = ALCM VP
        // without it, anything else / nothing = stock or other firmware).
        // The rider must press CHECK LCM first; FLASH LCM only appears after
        // the check passed (a VPBL LCM, or a bootloader asking for pages right
        // now: recovery after an interrupted update) and they chose CONTINUE.
        // Closing the window forgets the check.
        property string lcmName: ""
        property bool nameKnown: false  // the package answered at least once
        property bool blActive: false  // STATUS flag: a bootloader is asking
        property bool lcmPolling: false  // STATUS flag: some LCM polls the package (rf68+)
        readonly property bool hasBootloader: lcmName.indexOf("VPBL-") === 0
        // an LCM that polls but doesn't name itself: SLCM / ALCM VP from before
        // r15 (or stock ALCM). It may have the bootloader (rf58-rf62 BL builds)
        // - a TRY UPDATE is safe: without one the LCM ignores the update flag
        // and the package gives up after 15 s.
        readonly property bool legacy: lcmName === "" && lcmPolling && !blActive
        readonly property bool capable: hasBootloader || blActive || legacy
        property int checkState: 0  // 0 not checked, 1 checking, 2 passed, 3 failed
        property bool gotStatus: false
        property bool unlocked: false  // check passed + CONTINUE
        readonly property bool canFlash: (unlocked && capable) || active
        property int checkTicks: 0

        function check() {
            if (active || checkState === 1) return;
            lcmName = "";
            nameKnown = false;
            blActive = false;
            gotStatus = false;
            unlocked = false;
            checkTicks = 0;
            checkState = 1;
            lcmCheckTimer.restart();
        }

        function forgetCheck() {
            if (active) return;
            lcmCheckTimer.stop();
            checkState = 0;
            unlocked = false;
        }

        property Timer checkTimer: Timer {
            id: lcmCheckTimer
            interval: 300
            repeat: true
            triggeredOnStart: true
            onTriggered: {
                // ask a few times (Bluetooth can drop one), then decide
                if (++lcmFw.checkTicks <= 6) {
                    lcmFw.probe();
                    return;
                }
                stop();
                lcmFw.checkState = lcmFw.capable ? 2 : 3;
                lcmCheckPopup.open();
            }
        }
        // --- is it the best fit? Versions are "r<N>-<hash>": N counts the
        // commits that changed the LCM code (higher = newer), hash = that
        // code exactly. rf63/rf64 builds named themselves with the hash only:
        // those are older than any r<N> build.
        readonly property string pkgVersion: "{{VERSION}}"
        function parseVer(v) {
            var m = /^r(\d+)-([0-9a-f]+)$/.exec(v || "");
            return m ? {rev: parseInt(m[1]), hash: m[2]} : {rev: -1, hash: v || ""};
        }
        function verText(v) { return v.rev > 0 ? "r" + v.rev + " (" + v.hash + ")" : (v.rev === 0 ? v.hash : v.hash + ", pre-rf65"); }
        readonly property var lcmVer: parseVer(hasBootloader ? lcmName.substr(5) : (lcmName.indexOf("VP-") === 0 ? lcmName.substr(3) : ""))
        readonly property var pkgVer: builtin ? parseVer(builtin.version) : null
        // UPDATES tab: an SLCM.hex downloaded from a release is compared with
        // that release's build, not with this package's built-in one
        readonly property string relTag: usePicked && picked && picked.fromRelease ? picked.fromRelease : ""
        readonly property var refVer: relTag !== "" && picked.slcm ? parseVer(picked.slcm) : pkgVer
        // "same", "older", "newer", "other" (same revision, different build), "" (can't tell)
        readonly property string fit: !hasBootloader || !refVer ? ""
            : lcmVer.hash === refVer.hash ? "same"
            : (lcmVer.rev > 0 && refVer.rev > 0) ? (lcmVer.rev < refVer.rev ? "older" : (lcmVer.rev > refVer.rev ? "newer" : "other"))
            : (lcmVer.rev < 0 && refVer.rev !== -1 ? "older" : "other")
        readonly property bool upToDate: fit === "same"
        readonly property string fitTitle: fit === "same" ? (relTag !== "" ? "UP TO DATE \u00B7 SAME AS RELEASE" : "UP TO DATE \u00B7 BEST FIT")
            : fit === "older" ? "UPDATE AVAILABLE" : fit === "newer" ? (relTag !== "" ? "LCM NEWER THAN THE RELEASE" : "LCM NEWER THAN THIS PACKAGE")
            : fit === "other" ? "DIFFERENT BUILD" : ""
        readonly property string fitText: !refVer ? "This package has no built-in LCM firmware to compare with."
            : relTag !== "" ? (
                fit === "same" ? "Your LCM runs SLCM " + verText(lcmVer) + ", the same build as the downloaded release (" + relTag + "). Nothing to update. You can still reflash it if you want."
                : fit === "older" ? "Your LCM runs SLCM " + verText(lcmVer) + ". The downloaded release (" + relTag + ") has SLCM " + verText(refVer) + ", built and tested with that release's package. Updating is recommended."
                : fit === "newer" ? "Your LCM runs SLCM " + verText(lcmVer) + ", newer than the " + verText(refVer) + " in the downloaded release (" + relTag + "). Flashing it would downgrade the LCM."
                : fit === "other" ? "Your LCM runs a different SLCM build (" + verText(lcmVer) + ") from the downloaded release's (" + verText(refVer) + ", " + relTag + "), for example a custom build."
                : "")
            : fit === "same" ? "Your LCM runs SLCM " + verText(lcmVer) + ", the exact LCM firmware built and tested with this package (Re-Float Rink-Mixed " + pkgVersion + "). Nothing to update. You can still reflash it if you want."
            : fit === "older" ? "Your LCM runs SLCM " + verText(lcmVer) + ". This package (" + pkgVersion + ") carries " + verText(pkgVer) + ", the LCM firmware built and tested with it. Updating is recommended so the LCM and package stay matched."
            : fit === "newer" ? "Your LCM runs SLCM " + verText(lcmVer) + ", newer than the " + verText(pkgVer) + " this package (" + pkgVersion + ") carries. Best fit: update the VESC package to the latest build so they match. Flashing from this package would downgrade the LCM."
            : fit === "other" ? "Your LCM runs a different SLCM build (" + verText(lcmVer) + ") than the one made for this package (" + verText(pkgVer) + "), for example a custom build. Flashing this package's build is recommended for the best fit."
            : ""
        readonly property string continueLabel: fitted === "recovery" ? "CONTINUE TO FLASH"
            : fitted === "legacy" ? "TRY UPDATE"
            : fit === "same" ? "REFLASH ANYWAY" : fit === "older" ? "UPDATE LCM"
            : fit === "newer" ? "DOWNGRADE ANYWAY" : fit === "other" ? (relTag !== "" ? "FLASH RELEASE BUILD" : "FLASH PACKAGE BUILD") : "CONTINUE TO FLASH"
        readonly property string fitted: blActive && !hasBootloader ? "recovery"
            : (hasBootloader ? "vpbl" : (lcmName.indexOf("VP-") === 0 ? "vp" : (lcmName !== "" ? "other" : (legacy ? "legacy" : "none"))))
        readonly property string fittedText: checkState === 0 ? "Press CHECK LCM to see whether this light module can be updated from the app."
            : checkState === 1 ? "Checking the light module..."
            : !nameKnown && !gotStatus ? "The board didn't answer. Check the connection and that the board is powered on, then press CHECK LCM again."
            : fitted === "recovery" ? "LCM bootloader is waiting for firmware (an earlier update didn't finish). Flash it now to recover the light module."
            : fitted === "legacy" ? "Older SLCM / ALCM VP light module (before r15: it doesn't report its version). Your LED settings work. TRY UPDATE works if it was installed with the bootloader."
            : fitted === "vpbl" ? "SLCM with bootloader \u00B7 " + verText(lcmVer)
                + (fitTitle ? " \u00B7 " + fitTitle.toLowerCase() : "")
                + (refVer && !upToDate ? (relTag !== "" ? " (release " + relTag + ": " : " (this package: ") + verText(refVer) + ")" : "")
            : fitted === "vp" ? "SLCM " + verText(lcmVer) + " WITHOUT the bootloader. It can't be flashed from the app: install SLCM.hex once with an ST-Link, after that updates work from here."
            : fitted === "other" ? "Light module firmware \u201C" + lcmName + "\u201D can't be flashed from the app. It needs SLCM with the bootloader, installed once with an ST-Link (SLCM.hex)."
            : "No SLCM light module answered (stock or other LCM firmware, or none). Flashing from the app needs SLCM with the bootloader, installed once with an ST-Link (SLCM.hex)."

        function probe() {
            vescCommands.sendCustomAppData(commands.createData(2, commands.c_LCM_DEVICE_INFO).buffer);
            if (!active) send(3, []);
        }

        function onName(dv, ind) {
            var n = "";
            while (ind < dv.byteLength) {
                var c = dv.getUint8(ind++);
                if (c === 0) break;
                n += String.fromCharCode(c);
            }
            lcmName = n;
            nameKnown = true;
        }


        readonly property var errorText: [
            "",
            "The board is running. Stop riding and try again.",
            "The firmware image is broken (bad size).",
            "The LCM didn't start updating: it has no bootloader. Install SLCM.hex once with an ST-Link.",
            "The LCM got nothing and went back to its old firmware.",
            "Checksum mismatch: the LCM is retrying."
        ]

        function send(sub, extra) {
            var data = commands.createData(3 + extra.length, commands.c_LCM_FW);
            data.setUint8(2, sub);
            for (var i = 0; i < extra.length; i++) data.setUint8(3 + i, extra[i]);
            vescCommands.sendCustomAppData(data.buffer);
        }

        function u32(v) { return [(v >>> 24) & 255, (v >>> 16) & 255, (v >>> 8) & 255, v & 255]; }

        function decode() {
            if (image.bytes) {
                bytes = image.bytes;
                return;
            }
            if (!builtinBytes) {
                var s = Qt.atob(image.b64);
                var b = new Uint8Array(s.length);
                for (var i = 0; i < s.length; i++) b[i] = s.charCodeAt(i) & 255;
                builtinBytes = b;
            }
            bytes = builtinBytes;
        }

        function crc16(b, n) {
            var crc = 0;
            for (var i = 0; i < n; i++) {
                crc ^= b[i] << 8;
                for (var k = 0; k < 8; k++) {
                    crc = (crc & 0x8000) ? ((crc << 1) ^ 0x1021) & 0xFFFF : (crc << 1) & 0xFFFF;
                }
            }
            return crc;
        }

        // Intel .hex -> update image, with the bootloader's own checks.
        // Returns {size, crc, version, bytes} or {error}.
        function parseHex(text, name) {
            var APP = 0x08000600, END = 0x08003F80;
            var mem = {}, base = 0, maxA = -1, n = 0;
            var lines = text.split(/\r?\n/);
            for (var li = 0; li < lines.length; li++) {
                var l = lines[li].trim();
                if (l === "") continue;
                if (l[0] !== ":" || l.length < 11 || (l.length - 1) % 2) return {error: "Not an Intel .hex file (line " + (li + 1) + ")."};
                var r = [];
                for (var i = 1; i < l.length; i += 2) {
                    var v = parseInt(l.substr(i, 2), 16);
                    if (isNaN(v)) return {error: "Not an Intel .hex file (line " + (li + 1) + ")."};
                    r.push(v);
                }
                var sum = 0;
                for (i = 0; i < r.length; i++) sum = (sum + r[i]) & 255;
                if (sum !== 0 || r.length !== r[0] + 5) return {error: "Checksum error in the .hex (line " + (li + 1) + ")."};
                var type = r[3], addr = (r[1] << 8) | r[2];
                if (type === 0) {
                    for (i = 0; i < r[0]; i++) {
                        var a = base + addr + i;
                        if (a >= APP && a < END) {
                            mem[a] = r[4 + i];
                            if (a > maxA) maxA = a;
                            n++;
                        } else if (a >= END && a < 0x08004000) {
                            return {error: "This .hex writes the battery LUT page (0x08003F80+): not an update image."};
                        }
                        // anything below 0x08000600 (a full image's bootloader part) is ignored
                    }
                } else if (type === 4) {
                    base = ((r[4] << 8) | r[5]) * 65536;
                } else if (type === 2) {
                    base = ((r[4] << 8) | r[5]) * 16;
                } else if (type === 1) {
                    break;
                }
            }
            if (n === 0) {
                return {error: "No firmware for 0x08000600 in this .hex. It must be built for the bootloader (SLCM.hex or a BL=1 build), not a plain ALCM .hex."};
            }
            var size = Math.ceil((maxA + 1 - APP) / 128) * 128;
            var b = new Uint8Array(size);
            for (i = 0; i < size; i++) b[i] = mem[APP + i] !== undefined ? mem[APP + i] : 0xFF;
            var sp = (b[0] | (b[1] << 8) | (b[2] << 16) | (b[3] << 24)) >>> 0;
            var pc = (b[4] | (b[5] << 8) | (b[6] << 16) | (b[7] << 24)) >>> 0;
            if (sp < 0x20000001 || sp > 0x20000800 || !(pc & 1) || pc < APP || pc >= END) {
                return {error: "The vector table at 0x08000600 doesn't look like an ALCM app built for the bootloader."};
            }
            // the SLCM names itself in its poll packet: "VPBL-r<N>-<hash>"
            var slcm = "";
            for (i = 0; i + 6 < size && !slcm; i++) {
                if (b[i] === 86 && b[i + 1] === 80 && b[i + 2] === 66 && b[i + 3] === 76 && b[i + 4] === 45) {
                    var j = i + 5, v = "";
                    while (j < size && j < i + 25 && b[j] >= 45 && b[j] <= 122) v += String.fromCharCode(b[j++]);
                    slcm = v;
                }
            }
            return {size: size, crc: crc16(b, size), version: slcm ? "SLCM " + slcm : name, file: name, slcm: slcm, bytes: b};
        }

        function loadHexText(text, name) {
            var r = parseHex(text, name);
            if (r.error) {
                message = r.error;
                return false;
            }
            picked = r;
            usePicked = true;
            progress = 0;
            message = "Picked " + name + (r.slcm ? " (SLCM " + r.slcm + ")" : "") + ": checked and ready.";
            return true;
        }

        function start() {
            if (!image || active || !canFlash) return;
            decode();
            // the update flag rides in the VP block, so the LED settings must be on
            swSettings.ledConfigured = true;
            ledSender.send();
            active = true;
            progress = 0;
            noReply = 0;
            message = "Starting... (the board must be powered on and idle)";
            send(1, u32(image.size).concat([(image.crc >> 8) & 255, image.crc & 255]));
            lcmFwTimer.start();
        }

        function cancel() {
            send(4, []);
            active = false;
            lcmFwTimer.stop();
            message = "Cancelled. If the LCM had already started, power the board off and on, then press FLASH LCM again.";
        }

        function sendPage(off) {
            if (off < 0 || off >= image.size) return;
            var d = u32(off);
            for (var i = 0; i < 128; i++) d.push(bytes[off + i]);
            send(2, d);
        }

        // STATUS reply: state, error, wanted offset (u32), size (u32), flags
        function onReply(dv, ind) {
            if (dv.byteLength < ind + 11 || dv.getUint8(ind++) !== 3) return;
            pkgState = dv.getUint8(ind++);
            pkgError = dv.getUint8(ind++);
            want = dv.getUint32(ind); ind += 4;
            ind += 4;  // size
            // flags (older packages: none) - bit0 a bootloader is asking
            blActive = dv.byteLength > ind ? (dv.getUint8(ind) & 1) !== 0 : false;
            lcmPolling = dv.byteLength > ind ? (dv.getUint8(ind) & 4) !== 0 : false;
            gotStatus = true;
            noReply = 0;
            if (!active) return;
            var pages = image.size / 128;
            if (pkgState === 1) {
                message = "Waiting for the LCM to start its bootloader...";
                sendPage(128);  // ready for its first requests
                sendPage(256);
            } else if (pkgState === 2) {
                var done = want === 0 ? pages - 1 : Math.max(0, want / 128 - 1);
                progress = done / pages;
                message = (pkgError === 5 ? errorText[5] + " " : "") + "Updating the LCM: " + Math.round(progress * 100) + "%. Keep the app connected, don't ride.";
                sendPage(want);
                sendPage(want === 0 ? -1 : (want + 128 < image.size ? want + 128 : 0));
            } else if (pkgState === 3) {
                progress = 1;
                active = false;
                lcmFwTimer.stop();
                message = "Done: the LCM firmware is updated and running.";
            } else if (pkgState === 4) {
                active = false;
                lcmFwTimer.stop();
                message = errorText[pkgError] || "The update failed.";
            }
        }

        property Timer pollTimer: Timer {
            id: lcmFwTimer
            interval: 80
            repeat: true
            onTriggered: {
                if (++lcmFw.noReply > 150) {  // ~12 s without any reply
                    lcmFw.active = false;
                    stop();
                    lcmFw.message = "Lost the connection to the board. The LCM keeps its power on and waits: reconnect and press FLASH LCM again (or power the board off and on).";
                    return;
                }
                lcmFw.send(3, []);
            }
        }
    }

    // Re-Float Rink-Mixed: CHECK FOR UPDATES (UPDATES tab). Asks GitHub for
    // the latest RIDER release (tagged, bench-tested; dev builds are never
    // offered), compares its package version with this one and its SLCM
    // version with the light module's, downloads SLCM.hex on request,
    // checks it (parseHex + the version must match what the release says)
    // and hands it to the normal LCM flash flow (CHECK LCM, confirm, FLASH).
    QtObject {
        id: updater
        readonly property string repo: "thedukesedge-collab/scott-wheelz"
        readonly property string latestApi: "https://api.github.com/repos/" + repo + "/releases/latest"
        readonly property string releasesPage: "https://github.com/" + repo + "/releases/latest"

        property int phase: 0  // 0 not checked, 1 checking, 2 checked, 3 failed
        property int dlState: 0  // 0 -, 1 downloading, 2 downloaded, 3 failed
        property string message: ""
        property string dlMessage: ""
        property var rel: null  // {tag, version, name, notes, page, pkgUrl, hexUrl, slcm}
        property var hex: null  // parsed SLCM.hex (lcmFw.parseHex result)
        property var xhr: null

        // "1.2.3-rf77" -> {base: "1.2.3", rf: 77}
        function parsePkg(v) {
            var m = /^v?(\d+\.\d+\.\d+)(?:-rf(\d+))?$/.exec(v || "");
            return m ? {base: m[1], rf: m[2] ? parseInt(m[2]) : 0} : null;
        }
        function cmpBase(a, b) {
            var x = a.split("."), y = b.split(".");
            for (var i = 0; i < 3; i++) {
                var d = parseInt(x[i]) - parseInt(y[i]);
                if (d !== 0) return d;
            }
            return 0;
        }
        // "newer" (release newer than this package), "same", "older", ""
        readonly property string pkgFit: {
            if (!rel) return "";
            var a = parsePkg(rel.version), b = parsePkg(lcmFw.pkgVersion);
            if (!a || !b) return "";
            var d = cmpBase(a.base, b.base) || (a.rf - b.rf);
            return d > 0 ? "newer" : (d === 0 ? "same" : "older");
        }
        // release SLCM vs the fitted light module: "newer", "same", "older",
        // "other", "unknown" (release doesn't say), "nolcm" (no SLCM with
        // the bootloader answered), "" (not checked)
        readonly property var relSlcm: rel && rel.slcm ? lcmFw.parseVer(rel.slcm) : null
        readonly property string lcmFit: {
            if (!rel) return "";
            if (!rel.hexUrl) return "missing";
            if (!relSlcm) return "unknown";
            if (!lcmFw.hasBootloader) return "nolcm";
            var l = lcmFw.lcmVer;
            if (l.hash === relSlcm.hash) return "same";
            if (l.rev > 0 && relSlcm.rev > 0) return relSlcm.rev > l.rev ? "newer" : (relSlcm.rev < l.rev ? "older" : "other");
            return "other";
        }

        property Timer timeout: Timer {
            interval: 20000
            onTriggered: {
                if (updater.xhr) updater.xhr.abort();
                updater.xhr = null;
                if (updater.phase === 1) { updater.phase = 3; updater.message = "No answer from GitHub (timed out). Check the phone's internet connection and try again."; }
                if (updater.dlState === 1) { updater.dlState = 3; updater.dlMessage = "The download timed out. Try again, or use OPEN RELEASE PAGE."; }
            }
        }
        // the light module's name, asked a few times while checking
        property Timer lcmAsk: Timer {
            interval: 400
            repeat: true
            property int n: 0
            onTriggered: { lcmFw.probe(); if (++n >= 5) stop(); }
        }

        function get(url, accept, done) {
            var r = new XMLHttpRequest();
            xhr = r;
            r.open("GET", url, true);
            if (accept) r.setRequestHeader("Accept", accept);
            r.onreadystatechange = function() {
                if (r.readyState !== XMLHttpRequest.DONE || xhr !== r) return;
                xhr = null;
                timeout.stop();
                done(r.status, r.responseText);
            };
            timeout.restart();
            r.send();
        }

        function check() {
            if (phase === 1 || dlState === 1) return;
            phase = 1;
            rel = null;
            hex = null;
            dlState = 0;
            dlMessage = "";
            message = "Checking GitHub for the latest release...";
            lcmAsk.n = 0;
            lcmAsk.restart();
            get(latestApi, "application/vnd.github+json", function(status, text) {
                if (status === 404) {
                    phase = 3;
                    message = "No rider release has been published yet.";
                    return;
                }
                if (status !== 200) {
                    phase = 3;
                    message = status === 0 ? "Couldn't reach GitHub. Check the phone's internet connection and try again."
                        : (status === 403 ? "GitHub is limiting requests right now (about 60 an hour per network). Try again later."
                        : "GitHub answered " + status + ". Try again later.");
                    return;
                }
                var j;
                try { j = JSON.parse(text); } catch (e) { j = null; }
                if (!j || !j.tag_name) {
                    phase = 3;
                    message = "GitHub's answer couldn't be read. Try again later.";
                    return;
                }
                var r = {tag: j.tag_name, version: j.tag_name.replace(/^v/, ""), name: j.name || j.tag_name,
                         notes: j.body || "", page: j.html_url || releasesPage, pkgUrl: "", hexUrl: "", slcm: ""};
                var assets = j.assets || [];
                for (var i = 0; i < assets.length; i++) {
                    var n = assets[i].name || "";
                    if (n === "refloatrm.vescpkg") r.pkgUrl = assets[i].browser_download_url;
                    else if (n === "SLCM.hex") r.hexUrl = assets[i].browser_download_url;
                    else {
                        // CI adds "slcm-r<N>-<hash>.txt": the SLCM version, readable without a download
                        var m = /^slcm-(r\d+-[0-9a-f]+)\.txt$/.exec(n);
                        if (m) r.slcm = m[1];
                    }
                }
                rel = r;
                phase = 2;
                message = "Latest release: " + r.name + ".";
            });
        }

        function download() {
            if (!rel || !rel.hexUrl || dlState === 1 || lcmFw.active) return;
            dlState = 1;
            dlMessage = "Downloading SLCM.hex...";
            get(rel.hexUrl, "", function(status, text) {
                if (status !== 200 || !text) {
                    dlState = 3;
                    dlMessage = "Download failed (" + (status === 0 ? "no connection" : "HTTP " + status) + "). Try again, or use OPEN RELEASE PAGE.";
                    return;
                }
                var h = lcmFw.parseHex(text, "SLCM.hex (" + rel.tag + ")");
                if (h.error) {
                    dlState = 3;
                    dlMessage = "The downloaded file failed its checks, nothing was changed: " + h.error;
                    return;
                }
                // the file must be the build the release says it is
                if (rel.slcm && h.slcm !== "VPBL-" + rel.slcm && h.slcm !== rel.slcm) {
                    dlState = 3;
                    dlMessage = "The downloaded SLCM (" + (h.slcm || "no version") + ") doesn't match the release (" + rel.slcm + "). Nothing was changed.";
                    return;
                }
                hex = h;
                dlState = 2;
                dlMessage = "Downloaded and checked: SLCM " + lcmFw.verText(lcmFw.parseVer(h.slcm.replace(/^VPBL-/, ""))) + " (" + h.size + " bytes).";
                updatePrompt.open();
            });
        }

        // hand the downloaded image to the normal flash flow
        function flash() {
            if (!hex || lcmFw.active) return;
            hex.fromRelease = rel.tag;
            lcmFw.picked = hex;
            lcmFw.usePicked = true;
            lcmFw.progress = 0;
            lcmFw.message = "Downloaded " + hex.file + ": checked and ready.";
            ledWindow.show("fw");
            lcmFw.check();  // CHECK LCM, then CONTINUE and FLASH LCM as always
        }
    }

    // Re-RinkFloat: battery curve for the LCM status bar. The package turns
    // the pack voltage into a % with this per-cell curve and sends it to the
    // LCM in the VP block (src/battery_curve.c). Presets are floatwheel's own
    // tables (as in lcm/alcm/tools/battery_lut_patch/examples).
    QtObject {
        id: batteryCurve

        // Per-cell curves: cell mV = 2500 + 10 * p at 100, 90, ... 0 %.
        // Floatwheel's own tables (P42A, 50S, DG40, VTC6, RS50, as in
        // lcm/alcm/tools/battery_lut_patch/examples). Molicel publishes no
        // voltage-vs-charge tables, so P28A / P30B / P45B / P50B use the
        // P42A table (same maker) and are marked approximate. ir = DC
        // resistance per cell in mOhm: Molicel datasheets for P28A (20),
        // P30B (17), P45B (15), P50B (12.8); the others are estimates.
        readonly property var p42a: [170, 156, 144, 135, 128, 120, 112, 104, 96, 84, 50]
        readonly property var cellList: [
            {name: "P28A", size: "18650", points: p42a, ir: 20, approx: true, irEst: false},
            {name: "P30B", size: "18650", points: p42a, ir: 17, approx: true, irEst: false},
            {name: "VTC6", size: "18650", points: [170, 156, 152, 140, 132, 124, 116, 106, 96, 79, 50], ir: 20, approx: false, irEst: true},
            {name: "P42A", size: "21700", points: p42a, ir: 19, approx: false, irEst: true},
            {name: "P45B", size: "21700", points: p42a, ir: 15, approx: true, irEst: false},
            {name: "P50B", size: "21700", points: p42a, ir: 13, approx: true, irEst: false},
            {name: "50S", size: "21700", points: [170, 158, 154, 140, 132, 124, 114, 102, 88, 66, 50], ir: 15, approx: false, irEst: true},
            {name: "RS50", size: "21700", points: [170, 156, 150, 139, 129, 117, 103, 89, 70, 49, 20], ir: 15, approx: false, irEst: true},
            {name: "DG40", size: "21700", points: [170, 155, 144, 137, 130, 122, 110, 100, 88, 74, 50], ir: 20, approx: false, irEst: true}
        ]
        readonly property var styleNames: ["CONSERVATIVE", "BALANCED", "OPTIMISTIC"]

        readonly property var custom: {
            try {
                var c = JSON.parse(swSettings.batCustom);
                if (c && Array.isArray(c.points) && c.points.length === 11) return c;
            } catch (e) {}
            return null;
        }

        function cellsOfSize(size) {
            var r = [];
            for (var i = 0; i < cellList.length; i++) if (cellList[i].size === size) r.push(cellList[i].name);
            if (custom && custom.size === size) r.push("MY CELL");
            return r;
        }

        function cell(name) {
            if (name === "MY CELL") return custom;
            for (var i = 0; i < cellList.length; i++) if (cellList[i].name === name) return cellList[i];
            return null;
        }

        readonly property var current: cell(swSettings.batCell) || cellList[2]

        // the curve that is sent: the cell's, shifted by the gauge style
        // (conservative reads lower: every point 30 mV higher; optimistic
        // the other way), kept falling
        readonly property var points: {
            var base = current.points, shift = -3 * swSettings.batStyle, p = [];
            for (var i = 0; i < 11; i++) p.push(i === 0 ? base[0] : Math.max(0, Math.min(255, base[i] + shift)));
            for (i = 1; i < 11; i++) p[i] = Math.max(0, Math.min(p[i], p[i - 1] - 1));
            return p;
        }

        // live, from the package
        property int cells: 0
        property real volts: 0
        property int percent: 255
        property bool synced: false

        readonly property int series: cells > 0 ? cells : 18
        readonly property int autoRes: Math.max(0, Math.min(255, Math.round(current.ir * series / Math.max(1, swSettings.batParallel) / 2)))
        readonly property int resistance: swSettings.batResAuto ? autoRes : swSettings.batRes

        function mv(p) { return 2500 + 10 * p; }

        function pickSize(size) {
            swSettings.batSize = size;
            var list = cellsOfSize(size);
            if (list.indexOf(swSettings.batCell) < 0) swSettings.batCell = list[0];
            changed();
        }

        function pickCell(name) {
            swSettings.batCell = name;
            changed();
        }

        // my cell: created from the selected cell the first time it's edited
        function editCustom(fn) {
            var c = custom ? JSON.parse(JSON.stringify(custom))
                           : {name: "MY CELL", size: swSettings.batSize, points: current.points.slice(), ir: current.ir, cap: 3000};
            fn(c);
            swSettings.batCustom = JSON.stringify(c);
        }

        function useCustom() {
            if (!custom) editCustom(function (c) {});
            swSettings.batSize = custom.size;
            swSettings.batCell = "MY CELL";
            swSettings.batStyle = 0;
            changed();
        }

        function setCustomPoint(i, p) {
            editCustom(function (c) { c.points[i] = p; });
            if (swSettings.batCell === "MY CELL") changed();
        }

        function send(set) {
            var data = commands.createData(set ? 16 : 3, commands.c_LCM_BATTERY);
            data.setUint8(2, set ? 1 : 0);
            if (set) {
                data.setUint8(3, swSettings.batCurveOn ? 1 : 0);
                data.setUint8(4, resistance);
                for (var i = 0; i < 11; i++) data.setUint8(5 + i, points[i]);
            }
            vescCommands.sendCustomAppData(data.buffer);
        }

        function changed() {
            synced = true;  // our settings win from now on
            send(true);
            batteryRetry.restart();
        }

        // reply: 0, enabled, resistance, 11 points, cells, voltage (u16 0.1 V), %
        function onReply(dv, ind) {
            if (dv.byteLength < ind + 18 || dv.getUint8(ind++) !== 0) return;
            var on = dv.getUint8(ind++) !== 0;
            ind += 12;  // resistance, points (the app's own selection is shown)
            var oldCells = cells;
            cells = dv.getUint8(ind++);
            volts = dv.getUint16(ind) / 10; ind += 2;
            percent = dv.getUint8(ind++);
            if (!synced) {
                synced = true;
                swSettings.batCurveOn = on;  // show what the board has
            } else if (cells !== oldCells && oldCells !== 0 && swSettings.batResAuto) {
                send(true);  // series count known now: auto sag compensation changed
            }
        }

        property Timer retry: Timer {
            id: batteryRetry
            interval: 400
            onTriggered: batteryCurve.send(true)
        }

        // live readout while a battery panel is open
        property Timer poll: Timer {
            interval: 1000
            repeat: true
            running: (ledWindow.visible && ledWindow.section === "battery") || batteryAdvanced.visible
            triggeredOnStart: true
            onTriggered: batteryCurve.send(false)
        }
    }

    // Re-RinkFloat: saved melodies, kept in the app (swSettings.savedMelodies,
    // JSON [{name, notes: [[level, ms], ...]}]). The board only holds the one
    // custom melody in use (swSettings.melodyRec); choosing a saved melody
    // copies it there and sends it.
    QtObject {
        id: melodyLib

        readonly property int maxSaved: 12
        readonly property var items: {
            try {
                var a = JSON.parse(swSettings.savedMelodies);
                return Array.isArray(a) ? a : [];
            } catch (e) {
                return [];
            }
        }

        function find(name) {
            for (var i = 0; i < items.length; i++) {
                if (items[i].name === name) return i;
            }
            return -1;
        }

        // the saved melody whose notes match the current custom melody, or ""
        function currentName() {
            var cur = JSON.stringify(hornSettingsSender.notes());
            for (var i = 0; i < items.length; i++) {
                if (JSON.stringify(items[i].notes) === cur) return items[i].name;
            }
            return "";
        }

        function nextName() {
            for (var k = items.length + 1; ; k++) {
                if (find("Melody " + k) < 0) return "Melody " + k;
            }
        }

        function save(name, notes) {
            name = name.trim().substring(0, 20);
            if (!name.length || !notes.length) return false;
            var a = items.slice();
            var i = find(name);
            if (i < 0 && a.length >= maxSaved) {
                VescIf.emitStatusMessage("You can save up to %1 melodies: delete one first".arg(maxSaved), false);
                return false;
            }
            var m = {name: name, notes: notes};
            if (i < 0) a.push(m); else a[i] = m;
            swSettings.savedMelodies = JSON.stringify(a);
            VescIf.emitStatusMessage("Saved \"%1\"".arg(name), true);
            return true;
        }

        // rf99: classic tunes (public domain) for the tiles E4 F4 G4 A4 B4 C5 D5
        // E5 F5 G5 = levels 1-10: [name, beat ms, [[level, beats], ...]]; each
        // note gets a short gap so repeated notes are heard as two
        readonly property var presets: [
            ["Ode to Joy", 220, [[8,1],[8,1],[9,1],[10,1],[10,1],[9,1],[8,1],[7,1],[6,1],[6,1],[7,1],[8,1],[8,1.5],[7,0.5],[7,2]]],
            ["Twinkle Twinkle", 200, [[3,1],[3,1],[7,1],[7,1],[8,1],[8,1],[7,2],[6,1],[6,1],[5,1],[5,1],[4,1],[4,1],[3,2]]],
            ["Jingle Bells", 220, [[8,1],[8,1],[8,2],[8,1],[8,1],[8,2],[8,1],[10,1],[6,1.5],[7,0.5],[8,4]]],
            ["Saints Go Marching", 220, [[6,1],[8,1],[9,1],[10,3],[6,1],[8,1],[9,1],[10,3]]],
            ["Charge!", 160, [[3,1],[6,1],[8,1],[10,2],[8,1],[10,4]]]
        ]
        function addPreset(i) {
            var p = presets[i], n = [];
            for (var k = 0; k < p[2].length; k++) {
                var ms = Math.round(p[2][k][1] * p[1] / 20) * 20;
                n.push([p[2][k][0], Math.min(2000, ms - 40)]);
                n.push([0, 40]);
            }
            n.pop();  // no gap at the end
            if (save(p[0], n)) select(p[0]);
        }

        function remove(name) {
            var a = items.slice();
            var i = find(name);
            if (i >= 0) {
                a.splice(i, 1);
                swSettings.savedMelodies = JSON.stringify(a);
            }
        }

        // use a saved melody as the boot melody
        function select(name) {
            var i = find(name);
            if (i < 0) return;
            swSettings.melodyRec = JSON.stringify(items[i].notes);
            swSettings.hornBootMelody = true;
            swSettings.hornBootCustom = true;
            hornSettingsSender.send();
            VescIf.emitStatusMessage("Boot melody: %1".arg(name), true);
        }
    }

    // 4Hz timer to poll for lights status if enabled
    Timer {
        running: lights.enabled
        repeat: true
        interval: 250
        triggeredOnStart: true
        onTriggered: {
            commands.sendLightsControl();
        }
    }

    // 100hz for for UI updates
    Timer {
        running: true
        repeat: true
        interval: 10
        onTriggered: {
            if (!moveSlider.pressed) {
                var stepSize = 0.05;
                if (moveSlider.value > 0) {
                    if (moveSlider.value < stepSize) {
                        moveSlider.value = 0;
                    } else {
                        moveSlider.value -= stepSize;
                    }
                } else if (moveSlider.value < 0) {
                    if (moveSlider.value > -stepSize) {
                        moveSlider.value = 0;
                    } else {
                        moveSlider.value += stepSize;
                    }
                }
            }

            if (!swTiltSlider.pressed) {
                var stepSize = 0.05;
                if (swTiltSlider.value > 0) {
                    swTiltSlider.value = swTiltSlider.value < stepSize ? 0 : swTiltSlider.value - stepSize;
                } else if (swTiltSlider.value < 0) {
                    swTiltSlider.value = swTiltSlider.value > -stepSize ? 0 : swTiltSlider.value + stepSize;
                }
            }

            if (!tiltSlider.pressed) {
                var stepSize = 0.05;
                if (tiltSlider.value > 0) {
                    if (tiltSlider.value < stepSize) {
                        tiltSlider.value = 0;
                    } else {
                        tiltSlider.value -= stepSize;
                    }
                } else if (tiltSlider.value < 0) {
                    if (tiltSlider.value > -stepSize) {
                        tiltSlider.value = 0;
                    } else {
                        tiltSlider.value += stepSize;
                    }
                }
            }
        }
    }

    QtObject {
        id: board

        function getId() {
            return VescIf.getLastBleAddr();
        }

        function getName() {
            var name = VescIf.getBleName(VescIf.getLastBleAddr());
            if (!name) {
                return null;
            }
            return name;
        }

        function setName(name) {
            VescIf.storeBleName(VescIf.getLastBleAddr(), name);
            VescIf.storeSettings();
        }

        function getFwVersion() {
            var params = VescIf.getLastFwRxParams();
            return [params.major, params.minor];
        }
    }

    Connections {
        id: vescConfig
        target: VescIf

        property bool useImperial: VescIf.useImperialUnits()
        property string distanceUnit: useImperial ? "mi" : "km"
        property string speedUnit: useImperial ? "mph" : "km/h"
        property real imperialFactor: useImperial ? 0.621371192 : 1.0;

        function onUseImperialUnitsChanged(useImperialUnits) {
            useImperial = useImperialUnits;
        }
    }

    // rf88: VESC's power-off timer (App Settings > General > Shutdown Mode),
    // shown with SNOOZE AFTER; the package blinks the lights before it
    Connections {
        id: vescAppConfig
        property ConfigParams appConfig: VescIf.appConfig()
        target: appConfig
        property int shutdownMode: appConfig.getParamEnum("shutdown_mode", 0)
        // minutes, 0 = no power-off timer (SHUTDOWN_MODE in VESC's datatypes.h)
        readonly property real offMinutes: [0, 0, 0, 10 / 60, 1, 5, 10, 30, 60, 300][shutdownMode] || 0
        function onParamChangedEnum(src, name, newParam) {
            if (name === "shutdown_mode") shutdownMode = newParam;
        }
        function onUpdated() { shutdownMode = appConfig.getParamEnum("shutdown_mode", 0); }
    }

    Connections {
        id: motorConfig
        property ConfigParams mcConfig: VescIf.mcConfig()
        target: mcConfig

        property int batteryCells: mcConfig.getParamInt("si_battery_cells")
        property real tempMotorStart: mcConfig.getParamDouble("l_temp_motor_start")
        property real tempFetStart: mcConfig.getParamDouble("l_temp_fet_start")
        property real currentMin: mcConfig.getParamDouble("l_current_min")
        property real currentMax: mcConfig.getParamDouble("l_current_max")
        property real inCurrentMin: mcConfig.getParamDouble("l_in_current_min")
        property real inCurrentMax: mcConfig.getParamDouble("l_in_current_max")

        function onParamChangedDouble(src, name, newParam) {
            if (name === "l_temp_motor_start") {
                tempMotorStart = newParam;
            } else if (name === "l_temp_fet_start") {
                tempFetStart = newParam;
            } else if (name === "l_current_min") {
                currentMin = newParam;
            } else if (name === "l_current_max") {
                currentMax = newParam;
            } else if (name === "l_in_current_min") {
                inCurrentMin = newParam;
            } else if (name === "l_in_current_max") {
                inCurrentMax = newParam;
            }
        }

        function onParamChangedInt(src, name, newParam) {
            if (name === "si_battery_cells") {
                batteryCells = newParam;
            }
        }
    }

    Connections {
        id: packageConfig
        target: VescIf

        property ConfigParams pkgConfig: VescIf.customConfig(0);

        property bool updateDue: false
        signal update

        property Connections pkgConns: Connections {
            target: packageConfig.pkgConfig

            function onParamChangedDouble(src, name, newParam) {
                packageConfig.pendingUpdate();
            }

            function onParamChangedInt(src, name, newParam) {
                packageConfig.pendingUpdate();
            }

            function onParamChangedEnum(src, name, newParam) {
                packageConfig.pendingUpdate();
            }

            function onParamChangedQString(src, name, newParam) {
                packageConfig.pendingUpdate();
            }

            function onParamChangedBool(src, name, newParam) {
                packageConfig.pendingUpdate();
            }
        }

        // There is no reliable signal for when the whole config changes,
        // instead, we hook onto property changes and run a timer for a short
        // while before we fire off the actual update() signal
        property Timer updateTimer: Timer {
            id: updateTimer
            interval: 100

            onTriggered: {
                packageConfig.fireDueUpdate();
            }
        }

        property Timer dueTimer: Timer {
            id: dueTimer
            interval: 2000

            onTriggered: {
                packageConfig.fireDueUpdate();
            }
        }

        function pendingUpdate() {
            updateTimer.restart();
        }

        function armDueUpdate() {
            updateDue = true;
            dueTimer.restart();
        }

        function disarmDueUpdate() {
            updateDue = false;
            dueTimer.stop();
        }

        function fireDueUpdate() {
            if (updateDue) {
                updateDue = false;
                update();
            }
        }

        function onCustomConfigLoadDone() {
            pkgConfig = VescIf.customConfig(0);

            // Config was just loaded and...
            if (isDefault()) {
                // ... it's default, fire a delayed update based on the config values changing
                //
                // Config being the default one here doesn't necessarily mean
                // the actual package config has been reset, this sometimes
                // triggers with the config being default at this point, but
                // the config is updated later (and there is no signal sent on
                // that event).
                //
                // We delay the actual check / update until a bit later when
                // the actual data is loaded.
                armDueUpdate();
            } else {
                // ... it's not default, trigger the update signal right away
                update();
            }
        }

        // Called explicitly after the Write button in Refloat Cfg qml page is pressed
        function configWritten() {
            disarmDueUpdate();
            unsetDefault();
            update();
        }

        function checkConfig() {
            state.configLoadingError = !pkgConfig;
            return !!pkgConfig;
        }

        function writeConfig() {
            if (!checkConfig()) return;

            unsetDefault();
            vescCommands.customConfigSet(0, pkgConfig);
            update();
        }

        function isDefault() {
            if (!checkConfig()) return null;

            return pkgConfig.getParamBool("meta.is_default");
        }

        // We unset the is_default flag on every config write. Once we write
        // something, it's no longer default. This flag is being reset on the
        // pacakge side as well, but the config is not re-read after write, so
        // we need to reset it here too.
        function unsetDefault() {
            if (!checkConfig()) return;
            pkgConfig.updateParamBool("meta.is_default", false);
        }

        function setDisabled(disabled) {
            if (!checkConfig()) return;

            pkgConfig.updateParamBool("disabled", disabled);
            writeConfig();
        }

        function getParamValue(name) {
            if (pkgConfig.isParamDouble(name)) {
                return pkgConfig.getParamDouble(name);
            } else if (pkgConfig.isParamInt(name)) {
                return pkgConfig.getParamInt(name);
            } else if (pkgConfig.isParamEnum(name)) {
                return pkgConfig.getParamEnum(name);
            } else if (pkgConfig.isParamBool(name)) {
                return pkgConfig.getParamBool(name);
            } else if (pkgConfig.isParamQString(name)) {
                return pkgConfig.getParamQString(name);
            } else if (pkgConfig.isParamBitfield(name)) {
                return pkgConfig.getParamInt(name);
            }

            return null;
        }

        function getParamType(name) {
            if (pkgConfig.isParamDouble(name)) {
                return "Double";
            } else if (pkgConfig.isParamInt(name)) {
                return "Int";
            } else if (pkgConfig.isParamEnum(name)) {
                return "Enum";
            } else if (pkgConfig.isParamBool(name)) {
                return "Bool";
            } else if (pkgConfig.isParamQString(name)) {
                return "String";
            } else if (pkgConfig.isParamBitfield(name)) {
                return "Bitfield";
            }

            return null;
        }

        function getDisplayName(name) {
            return pkgConfig.getLongName(name);
        }

        function getEnumNames(name) {
            return pkgConfig.getParamEnumNames(name);
        }

        function paramIsTune(name) {
            var tuneBlacklist = [
                "tiltback_return_speed",
                "tiltback_duty",
                "tiltback_duty_angle",
                "tiltback_duty_speed",
                "is_dutybeep_enabled",
                "tiltback_hv_angle",
                "tiltback_hv_speed",
                "tiltback_lv_angle",
                "tiltback_lv_speed",
                "persistent_fatal_error",
                "disabled",
                "fault_adc1",
                "fault_adc2",
                "hertz",
                "inputtilt_remote_type",
                "inputtilt_deadband",
                "is_footbeep_enabled",
                "is_beeper_enabled",
                "tiltback_hv",
                "tiltback_lv",
                "tiltback_speed",
            ];

            // Re-RinkFloat: LED settings belong to the LEDS tab, not to tunes
            return !name.startsWith("haptic.") && !name.startsWith("hardware.") && !name.startsWith("leds.") && !tuneBlacklist.includes(name);
        }

        function fetchConfig(tuneOnly) {
            if (!checkConfig()) return null;

            var settings = {};
            for (let subGroup of pkgConfig.getParamSubgroups("General")) {
                for (let param of pkgConfig.getParamsFromSubgroup("General", subGroup)) {
                    if (tuneOnly && !paramIsTune(param)) {
                        continue;
                    }

                    var value = getParamValue(param);
                    if (value !== null) {
                        settings[param] = getParamValue(param);
                    }
                }
            }

            return settings;
        }

        function versionCompatible(config) {
            var [major, minor] = versionMajorMinor(config.version);
            if (major !== tuneManager.formatVersionMajor || minor > tuneManager.formatVersionMinor) {
                VescIf.emitStatusMessage("Error: Incompatible version: %1".arg(config.version), false);
                return false;
            }

            return true;
        }

        // tuneOnly: skip the LED settings (tunes saved before they were
        // excluded still contain them)
        function applyConfig(config, tuneOnly) {
            if (!checkConfig()) return;

            if (!versionCompatible(config)) {
                return;
            }

            for (let [key, value] of Object.entries(config.settings)) {
                if (tuneOnly && key.startsWith("leds.")) {
                    continue;
                }
                if (pkgConfig.isParamDouble(key)) {
                    pkgConfig.updateParamDouble(key, value);
                } else if (pkgConfig.isParamInt(key)) {
                    pkgConfig.updateParamInt(key, value);
                } else if (pkgConfig.isParamBool(key)) {
                    pkgConfig.updateParamBool(key, value);
                } else if (pkgConfig.isParamEnum(key)) {
                    pkgConfig.updateParamEnum(key, value);
                } else if (pkgConfig.isParamQString(key)) {
                    pkgConfig.updateParamString(key, value);
                } else if (pkgConfig.isParamBitfield(key)) {
                    pkgConfig.updateParamInt(key, value);
                }
            }

            writeConfig();
        }

        function diffConfig(other, tuneOnly) {
            var differs = [];
            var otherMissing = [];
            var otherSettings = {};

            if (other && other.settings) {
                otherSettings = Object.assign({}, other.settings);
                if (VescIf.customConfigsLoaded()) {
                    for (let subGroup of pkgConfig.getParamSubgroups("General")) {
                        for (let paramName of pkgConfig.getParamsFromSubgroup("General", subGroup)) {
                            if (tuneOnly && paramName.startsWith("leds.")) {
                                delete otherSettings[paramName];
                                continue;
                            }
                            var value = getParamValue(paramName);
                            if (value === null) {
                                continue;
                            }

                            if (otherSettings.hasOwnProperty(paramName)) {
                                var otherValue = otherSettings[paramName];
                                if (value !== otherValue) {
                                    differs.push({
                                        "name": paramName,
                                        "value": value,
                                        "otherValue": otherValue
                                    });
                                }
                                delete otherSettings[paramName];
                            } else {
                                otherMissing.push(paramName);
                            }
                        }
                    }
                }
            }

            return {
                "differs": differs,
                "missing": Object.values(otherSettings),
                "otherMissing": otherMissing,
            }
        }

        // TODO don't do this...
        function setInputTiltRemoteType(type) {
            if (!checkConfig()) return;

            if (pkgConfig.getParamEnum("inputtilt_remote_type", 0) != 1) {
                pkgConfig.updateParamEnum("inputtilt_remote_type", 1);
                writeConfig();
            }
        }
    }

    Connections {
        id: commands
        target: vescCommands

        readonly property int c_INFO: 0
        readonly property int c_RC_MOVE: 7
        readonly property int c_HANDTEST: 13
        readonly property int c_LIGHTS_CONTROL: 20
        readonly property int c_FLYWHEEL: 22
        readonly property int c_REALTIME_DATA: 31
        readonly property int c_REALTIME_DATA_IDS: 32
        readonly property int c_ALERTS_LIST: 35
        readonly property int c_ALERTS_CONTROL: 36
        readonly property int c_DATA_RECORD_REQUEST: 41
        readonly property int c_DATA_RECORD_HEADER: 42
        readonly property int c_DATA_RECORD_DATA: 43
        readonly property int c_SW_HORN: 120  // Re-RinkFloat
        readonly property int c_FREESPIN_LIMIT: 121  // Re-RinkFloat
        readonly property int c_HORN_SETTINGS: 122  // Re-RinkFloat
        readonly property int c_PLAY_MELODY: 123  // Re-RinkFloat
        readonly property int c_MELODY_SET: 124  // Re-RinkFloat
        readonly property int c_LIVE_TONE: 125  // Re-RinkFloat
        readonly property int c_LCM_VP_SETTINGS: 126  // Re-RinkFloat: light module (ALCM VP)
        readonly property int c_LCM_TEST_BEEP: 127  // Re-RinkFloat: light module test beep
        readonly property int c_LCM_FW: 128  // Re-RinkFloat: LCM firmware update relay
        readonly property int c_LCM_BATTERY: 129  // Re-RinkFloat: battery curve for the LCM status bar
        readonly property int c_LCM_DEVICE_INFO: 27  // Refloat: the LCM's own name (Re-Float: "VPBL-<hash>")

        // IEEE-754 16-bit floating-point format (without infinity and NaNs)
        // Dynamic range: +-131008.0
        // Normal numbers closest to zero: +-6.1035156E-5
        // Subnormal numbers closes to zero: +-5.9604645E-8
        // Precision: 3.311 digits
        //
        // https://stackoverflow.com/a/60047308
        function getFloat16(dataView, ind) {
            var x = dataView.getUint16(ind);
            var e = (x&0x7C00)>>10; // exponent
            var m16 = x&0x03FF; // original float16 mantissa
            var m = m16<<13; // new float 32 mantissa
            var v = m16>0 ? 140+Math.floor(Math.log2(m16)) : 0;
            // sign | normalized | denormalized
            var r = (x&0x8000)<<16 | (e!=0)*((e+112)<<23|m) | ((e==0)&(m!=0))*((v-37)<<23|((m<<(150-v))&0x007FE000));
            return new Float32Array(new Uint32Array([r]).buffer)[0];
        }

        function getString(dataView, ind) {
            var str = "";
            var size = dataView.getUint8(ind++);
            for (var j = 0; j < size; j++) {
                str += String.fromCharCode(dataView.getUint8(ind++));
            }
            return [str, ind];
        }

        function getStrings(dataView, ind) {
            var num = dataView.getUint8(ind++);
            var strs = [];
            for (var i = 0; i < num; i++) {
                var str;
                [str, ind] = getString(dataView, ind);
                strs.push(str);
            }
            return [strs, ind];
        }

        function createData(size, command) {
            var data = new DataView(new ArrayBuffer(size));
            var ind = 0;
            data.setUint8(ind++, 101);
            data.setUint8(ind++, command);
            return data;
        }

        function sendGetInfo() {
            var data = createData(4, c_INFO);

            data.setUint8(2, 2); // version 2 of the INFO command
            vescCommands.sendCustomAppData(data.buffer);
        }

        function sendGetRtData() {
            vescCommands.sendCustomAppData(createData(2, c_REALTIME_DATA).buffer);
        }

        function sendGetRtDataIds() {
            vescCommands.sendCustomAppData(createData(2, c_REALTIME_DATA_IDS).buffer);
        }

        function sendLightsControl(on, headlightsOn) {
            var data = createData(7, c_LIGHTS_CONTROL);

            var mask = 0;
            var value = 0;

            if (on !== undefined) {
                mask |= 0b01;
                if (on) {
                    value |= 0b01;
                }
            }

            if (headlightsOn !== undefined) {
                mask |= 0b10;
                if (headlightsOn) {
                    value |= 0b10;
                }
            }
            data.setUint32(2, mask);
            data.setUint8(6, value);

            vescCommands.sendCustomAppData(data.buffer);
        }

        function sendAlertsList(startTime) {
            var data = createData(6, c_ALERTS_LIST);

            if (startTime !== undefined && startTime !== null) {
                data.setUint32(2, startTime);
            }

            vescCommands.sendCustomAppData(data.buffer);
        }

        function sendAlertsClearFatal() {
            var data = createData(3, c_ALERTS_CONTROL);

            data.setUint8(2, 0x1);  // clear the fatal error flag

            vescCommands.sendCustomAppData(data.buffer);
        }

        function sendRcMove(value) {
            var data = createData(6, c_RC_MOVE);

            var current = Math.abs(Math.round(value * 70)) + 10;

            data.setUint8(2, value > 0 ? 1 : 0); // direction
            data.setUint8(3, current); // current
            data.setUint8(4, 1); // time
            data.setUint8(5, current + 1); // sum = time + current

            vescCommands.sendCustomAppData(data.buffer);
        }

        // Re-RinkFloat: haptic horn. on=true starts / keeps it alive (resend
        // at least every 300ms), on=false stops it immediately.
        // req: 0 off, 1 keepalive, 2 start a new press
        function sendHorn(req) {
            var data = createData(4, c_SW_HORN);
            data.setUint8(2, req);
            data.setUint8(3, 3); // HORN_MODE_BOTH: tone + vibrate (tone only when idle)
            vescCommands.sendCustomAppData(data.buffer);
        }

        function sendHandtest(on) {
            var data = createData(3, c_HANDTEST);
            data.setUint8(2, on); // on (1) / off (0)
            vescCommands.sendCustomAppData(data.buffer);
        }

        function sendFlywheel(on) {
            var data = createData(9, c_FLYWHEEL);

            data.setUint8(2, on ? 130 : 128); // on, force calibration (130) / off (128)
            if (on) {
                data.setUint8(3, 0); // use default kp
                data.setUint8(4, 0); // use default kp2
                data.setUint8(5, 0); // use default duty angle
                data.setUint8(6, 0); // use default duty start
                data.setUint8(7, 1); // allow abort with footpads
                data.setUint8(8, 0); // use default duty speed
            }
            vescCommands.sendCustomAppData(data.buffer);
        }

        readonly property int dr_RECORD: 1
        readonly property int dr_AUTOSTART: 2
        readonly property int dr_AUTOSTOP: 3

        // @param key One of the above dr_ properties
        // @param value Value to set, true or false
        function sendDataRecordControl(key, value) {
            var data = createData(5, c_DATA_RECORD_REQUEST);
            data.setUint8(2, 1); // control
            data.setUint8(3, key);
            data.setUint8(4, value);

            vescCommands.sendCustomAppData(data.buffer);
        }

        function sendDataRecordRequest(header, offset) {
            if (header) {
                var data = createData(4, c_DATA_RECORD_REQUEST);
                data.setUint8(2, 2); // send
                data.setUint8(3, 1); // header
            } else {
                var data = createData(8, c_DATA_RECORD_REQUEST);
                data.setUint8(2, 2); // send
                data.setUint8(3, 2); // data
                data.setUint32(4, offset);
            }

            vescCommands.sendCustomAppData(data.buffer);
        }

        function onValuesSetupReceived(values, mask) {
            batteryBar.value = values.battery_level * 100;

            odometer.value = values.odometer * 0.001 * vescConfig.imperialFactor;
            tachometer.value = values.tachometer_abs * 0.001 * vescConfig.imperialFactor;

            // Re-RinkFloat: trip counter went backwards = board was power cycled,
            // so start fresh ride peaks
            if (values.tachometer_abs < swSettings.peakTach) {
                swSettings.peakSpeed = 0;
                swSettings.peakDuty = 0;
            }
            swSettings.peakTach = values.tachometer_abs;

            var speed = Math.abs(values.speed * 3.6 * vescConfig.imperialFactor);
            consumption.add(Math.max(Math.min(values.current_in * values.v_in / Math.max(speed, 1e-6), 60) , -60));
        }

        function onCustomAppDataReceived(data) {
            var dv = new DataView(data, 0);
            var ind = 0;

            var packageId = dv.getUint8(ind++);
            if (packageId !== 101) {
                return;
            }

            var msgtype = dv.getUint8(ind++);

            if (msgtype == c_INFO) {
                ind += 1;  // skip version, should always be the current one
                var flags = dv.getUint8(ind++);
                ind += 47;  // 20 bytes package name, 3 version numbers, 20 bytes suffix, 4 bytes git hash
                state.ticksPerSecond = dv.getUint32(ind); ind += 4;
                var capabilities = dv.getUint32(ind); ind += 4;
                state.setCapabilities(capabilities);

                var extraFlags = dv.getUint8(ind++);

                state.commsState = state.comms_RTDataIDs;
            } else if (msgtype === c_LCM_FW) {
                lcmFw.onReply(dv, ind);
            } else if (msgtype === c_LCM_DEVICE_INFO) {
                lcmFw.onName(dv, ind);
            } else if (msgtype === c_LCM_BATTERY) {
                batteryCurve.onReply(dv, ind);
            } else if (msgtype == c_LIGHTS_CONTROL) {
                var values = dv.getUint8(ind++);
                lights.on = values & 0b01;
                lights.headlightsOn = values & 0b10;
            } else if (msgtype === c_ALERTS_LIST) {
                alerts.receiveAlertsList(dv, ind);
            } else if (msgtype === c_REALTIME_DATA) {
                if (state.commsState !== state.comms_Initialized) {
                    // rt data came because another client app requested them,
                    // ignore until info is received
                    return;
                }

                var mask = dv.getUint8(ind++);
                var hasRuntime = !!(mask & 0x1);
                var hasCharging = !!(mask & 0x2);
                var hasAlerts = !!(mask & 0x4);

                var extraFlags = dv.getUint8(ind++);
                state.extraRecording = extraFlags & 0x1;
                state.extraRecAutostart = extraFlags & 0x2;
                state.extraRecAutostop = extraFlags & 0x4;
                state.fatalError = extraFlags & 0x8;

                var time = dv.getUint32(ind); ind += 4;
                state.setTimeReference(time);

                var modeAndState = dv.getUint8(ind++);
                state.pkgMode = modeAndState >> 4;
                var pkgState = modeAndState & 0xF;
                state.pkgState = pkgState;

                var sensorAndFlags = dv.getUint8(ind++);
                var fpState = sensorAndFlags >> 6;
                state.fpState = fpState;
                var wheelslip = sensorAndFlags & 0b00000001;
                state.wheelslip = wheelslip;
                state.darkride = sensorAndFlags & 0b00000010;
                state.freespinLimiting = !!(sensorAndFlags & 0b00000100);
                state.charging = sensorAndFlags & 0b00100000;

                var setpointAndStop = dv.getUint8(ind++);
                var sat = setpointAndStop >> 4;
                state.setpointAdjustmentType = sat;
                state.stopCondition = setpointAndStop & 0xF;

                state.beepReason = dv.getUint8(ind++);

                var rtDataIdleIts = state.rtDataIdleItems;
                var rtDataAllIts = state.rtDataAllItems;
                var newRt = Array(rtDataAllIts.length).fill(NaN);

                // if runtime values are not in the message, limit the loop to
                // read only values that are always present
                var i = 0;
                for (; i < rtDataIdleIts.length; i++) {
                    newRt[i] = getFloat16(dv, ind);
                    ind += 2;
                }
                if (hasRuntime) {
                    for (; i < rtDataAllIts.length; i++) {
                        newRt[i] = getFloat16(dv, ind);
                        ind += 2;
                    }
                }

                state.rtData = state.newRtData(newRt);

                // Re-RinkFloat: ride peaks, with free spin filtered out. A sample
                // only counts when ALL of these have held for the last 0.5 s:
                //  - package is running (not idle / flywheel / darkride)
                //  - no wheelslip flag (the package's free-spin detector)
                //  - at least one footpad sensor pressed (a rider is on it)
                //  - the motor is under real load (>= 4 A either way); a
                //    tire spinning in the air hits high duty on almost no current
                var pkSpeed = Math.abs(state.rtData["motor.speed"]);
                var pkDuty = Math.abs(state.rtData["motor.duty_cycle"]);
                var pkAmps = Math.abs(state.rtData["motor.current"]);
                var pkOk = state.pkgState === state.s_Running && !state.wheelslip && !state.darkride
                        && state.fpState !== state.fs_None
                        && (pkAmps !== pkAmps || pkAmps >= 4);  // NaN = not reported, don't block
                var pkNow = Date.now();
                if (!pkOk) {
                    state.peakOkSince = 0;
                } else if (state.peakOkSince === 0) {
                    state.peakOkSince = pkNow;
                } else if (pkNow - state.peakOkSince >= 500) {
                    if (pkSpeed === pkSpeed && pkSpeed > swSettings.peakSpeed) swSettings.peakSpeed = pkSpeed;
                    if (pkDuty === pkDuty && pkDuty > swSettings.peakDuty) swSettings.peakDuty = Math.min(1, pkDuty);
                }

                if (hasCharging) {
                    chargingInfo.current = getFloat16(dv, ind); ind += 2;
                    chargingInfo.voltage = getFloat16(dv, ind); ind += 2;
                }

                if (hasAlerts) {
                    ind += 9; // unused here
                }

                var running = +(state.pkgState === state.s_Running);
                rtPlotData.addSample([time, running, wheelslip, sat, fpState].concat(newRt));
                rtPlotData.makeReady();
            } else if (msgtype === c_REALTIME_DATA_IDS) {
                if (state.commsState !== state.comms_RTDataIDs) {
                    return;
                }
                [state.rtDataIdleItems, ind] = getStrings(dv, ind);
                [state.rtDataRuntimeItems, ind] = getStrings(dv, ind);
                state.rtDataAllItems = state.rtDataIdleItems.concat(state.rtDataRuntimeItems);

                state.commsState = state.comms_Initialized;
            } else if (msgtype === c_DATA_RECORD_HEADER) {
                recordedPlotData.receiveHeader(dv, ind);
            } else if (msgtype === c_DATA_RECORD_DATA) {
                recordedPlotData.receiveData(dv, ind);
            }

            packageConnectionWatchdog.restart();
        }
    }

    Settings {
        id: preferences
        category: "preferences"

        property int speedDialMax: vescConfig.useImperial ? 40 : 64
        property alias showBattVoltage: prefShowBattVoltage.checked
        property alias showBattVoltagePerCell: prefShowBattVoltagePerCell.checked
        property alias battCurrentLog: prefBattCurrentLog.checked
        property int tempWarningOffset: 10
        property alias tuneSlotCount: prefTuneSlotCount.value
        property alias showTuneDiffCount: prefShowTuneDiffCount.checked
        property int plotMaxWindowMinutes: 30
        property alias showWelcomeDialog: prefShowWelcomeDialog.checked
        property alias checkForNewVersions: prefCheckForNewVersions.checked
    }

    // Re-RinkFloat: app-side display settings
    Settings {
        id: swSettings
        category: "scottWheelz"  // old name kept so saved settings survive the rename

        property int railStyle: 0  // 0 straight, 1 WTF, 2 Atom
        property int tireStyle: 0  // 0 treaded, 1 slick
        property bool flipView: false  // side view mirrored: nose on the right
        property real sheetFraction: 0      // bottom sheet: 0 = collapsed, 1 = fully up
        property string tuneColors: "{}"    // tune slot -> neon palette index (JSON)
        property int activeTuneSlot: 0      // last tune applied from this app (0 = none yet)
        // free-spin limiter (sent to the board, which doesn't save it)
        property bool freespinOn: false
        property bool tempF: false  // show temperatures in °F (tap the engine icon)
        // horn-only sound settings (sent to the board, which doesn't save them)
        property real hornBeepStrength: 2.5   // V
        property int hornBeepFreq: 495        // Hz
        property real hornBuzzStrength: 8     // A
        property int hornBuzzFreq: 70         // Hz
        // simple mode (default): plain 0-10 levels mapped onto the values above
        property bool hornAdvanced: false
        property bool hornBootMelody: true    // 3 rising notes at power-up
        property bool hornBootCustom: false   // play the custom melody at boot instead
        property string melodyRec: "[[1,500],[2,500],[3,500]]"  // custom melody: [pitch 1-10, ms]
        property string savedMelodies: "[]"  // saved melodies: [{name, notes}]
        // light module (SLCM build) - defaults match ALCM's own
        property bool ledConfigured: false  // set once the LEDS tab is used
        property bool ledHeadlights: true
        property bool ledStatusBar: true
        property bool ledBeep: true
        property int ledHeadlightPct: 80
        property int ledHeadlightIdlePct: 50
        // battery curve for the LCM status bar (computed in the package)
        property bool batCurveOn: false
        property string batSize: "18650"  // cell size picked first
        property string batCell: "VTC6"  // cell type, or "MY CELL"
        property int batStyle: 0  // -1 conservative, 0 balanced, 1 optimistic
        property int batParallel: 2  // parallel groups (for the sag compensation)
        property bool batResAuto: true  // sag compensation from the cell's resistance
        property int batRes: 0  // manual pack resistance, 2 mOhm steps
        property string batCustom: ""  // my cell: {name, size, points, ir, cap}
        property int ledStatusIdlePct: 80
        property int ledStatusRidePct: 80
        property int ledAnimIdle: 128  // 128: Refloat's Status Idle animation (rf72)
        property int ledAnimRide: 0
        property int ledAnimDoze: 0
        property bool ledDozeBreath: true  // headlights breathe in snooze (SLCM; off = dark)
        property bool hideDisclaimer: false  // rf93: "don't show this again" on the start disclaimer
        property bool tourSeen: false  // rf90: the tips & tricks tour opens once on first start
        property int ledSnoozeMin: 5  // rf100: minutes BEFORE the board powers off (0 = never)
        property int ledRideMode: 0  // rf97: riding status bar: 0 battery / duty, else Refloat mode + 1
        property int ledSnoozeStyle: 0  // rf97: 0 breathe, 1 dim, 2 dark
        property int rfBgLast: 1  // rf101: background color brought back by BACKGROUND ON (WHITE)  // rf86: controller-driven LEDs snooze after this many idle minutes (0 = never)
        property string ledCustom: ""  // CUSTOM animation, 8 numbers (JSON), see ledSender.custom()
        property int ledAnimBoot: 11
        property int ledAnimShutdown: 0
        property int ledColor: 200
        property int hornSimpleStrength: 5    // 0-10 -> buzz 0-15 A
        property int hornSimpleVolume: 5      // 1-10 -> beep 0.4-4 V (rf81)
        property int bootMelodyVolume: 6      // 1-10 -> 0.25-2.5 V (capped low on purpose)
        property int hornSimplePitch: 3       // 1-10 -> beep 300-1000 Hz
        property real freespinLimitKmh: 72.4  // 45 mph
        property bool speedo40Migrated: false  // one-time bump of a saved 30 mph dial to 40
        // ride peaks, kept until the board's trip counter resets (power cycle)
        // or you press and hold either readout
        property real peakSpeed: 0     // raw motor.speed units (x imperialFactor to show)
        property real peakDuty: 0      // 0..1
        property real peakTach: -1     // trip counter when last seen, to spot a reset
    }

    Settings {
        id: persistentData
        category: "persistentData"

        property var lastPackageUpdateCheck
        property var packageUpdateSnooze
    }

    QtObject {
        id: updateChecker

        property CodeLoader packageLoader: CodeLoader {
            id: packageLoader

            function getPackageVersion(pkgName) {
                var pkgs = reloadPackageArchive();

                for (var pkg of pkgs) {
                    if (!pkg.isLibrary && shouldShowPackage(pkg) && pkg.name === pkgName) {
                        // HTML text
                        var li = pkg.description.match(/<li>Version: [a-zA-Z0-9._-]+<\/li>/g);
                        if (li) {
                            var version = li[0];
                            return version.substring(13, version.length - 5);
                        }

                        // markdown text
                        var md_bullet = pkg.description.match(/\n- Version: [a-zA-Z0-9._-]+\n/g);
                        if (md_bullet) {
                            var version = md_bullet[0];
                            return version.substring(11, version.length);
                        }
                    }
                }

                return null;
            }

            Component.onCompleted: {
                setVesc(VescIf)
            }
        }

        function check() {
            if (!preferences.checkForNewVersions) {
                return;
            }

            var pkgName = "{{PACKAGE_NAME}}";
            var pkgVersion = "{{VERSION}}";
            if (pkgName.includes("PACKAGE_NAME")) {
                // Don't run when loading the teplate itself for development/debugging
                return;
            }

            var now = Date.now();
            var oneDayMs = 24 * 60 * 60 * 1000;

            var lpuc = persistentData.lastPackageUpdateCheck;
            if (!lpuc || now - lpuc > oneDayMs) {
                packageLoader.downloadPackageArchive();
                persistentData.lastPackageUpdateCheck = Date.now();
            }

            var pus = persistentData.packageUpdateSnooze;
            if (pus && now - pus < 30 * oneDayMs) {
                return;
            }

            var version = packageLoader.getPackageVersion(pkgName);
            if (!version) {
                print("{{PACKAGE_NAME}}: Failed to retrieve package version");
                return;
            }

            if (cmpVersion(parseVersion(version), parseVersion(pkgVersion)) == 1) {
                newPackageVersionDialog.show(version);
            }
        }
    }

    component UIHint : Item {
        id: hint
        // Workaround: Dynamically added SwipeView items are all visible at x=0
        // until SwipeView preloads them. Only show when properly positioned.
        visible: SwipeView.view ? (SwipeView.isCurrentItem || SwipeView.isPreviousItem || SwipeView.isNextItem) : false

        property var target
        property real targetX
        property real targetY
        property real targetWidth
        property real targetHeight

        property Settings settings
        property string settingName
        property bool shown

        function updateTarget() {
            if (target !== null) {
                var p = mapFromItem(target, 0, 0);
                targetX = p.x;
                targetY = p.y;
            }
        }

        onTargetChanged: {
            targetWidth = target.width;
            targetHeight = target.height;
            updateTarget();
        }

        Connections {
            target: hint.target

            function onXChanged() {
                hint.updateTarget();
            }

            function onYChanged() {
                hint.updateTarget();
            }

            function onWidthChanged() {
                hint.targetWidth = target.width;
                hint.updateTarget();
            }

            function onHeightChanged() {
                hint.targetHeight = target.height;
                hint.updateTarget();
            }
        }

        Component.onCompleted: {
            shown = settings[settingName];
        }

        onShownChanged: {
            settings[settingName] = shown;
        }

        MouseArea {
            z: 10
            anchors.fill: parent
        }
    }

    component UIHintText : NText {
        anchors.margins: 50
        width: parent.width - 50
        font.pointSize: 15
        horizontalAlignment: TextInput.AlignHCenter
        wrapMode: Text.WordWrap
    }

    component UIHintFrame : Rectangle {
        anchors.fill: parent
        anchors.margins: -5
        color: "transparent"
        border.color: Utility.getAppHexColor("lightAccent")
        border.width: 1
        radius: 8
        opacity: 0.7
    }

    component UIHintUnderline : Rectangle {
        anchors.left: parent.left
        anchors.top: parent.top
        width: unit * 0.8
        height: 3
        color: Utility.getAppHexColor("lightAccent")
        opacity: 0.7
    }

    // Workaround for `state` getting resolved to all kinds of different things in different contexts
    property var gState: state
    Component {
        id: statusTextComp

        UIHint {
            target: statusText

            StatusText {
                id: statusTextSubject
                x: parent.targetX
                y: parent.targetY
                width: parent.targetWidth
                height: parent.targetHeight
                globState: gState

                UIHintFrame {}
            }

            UIHintText {
                anchors.horizontalCenter: statusTextSubject.horizontalCenter
                anchors.bottom: statusTextSubject.top
                text: "Tap the state text to show more board state details like Stop Condition, Last Beep Reason, errors and faults."
            }
        }
    }

    Component {
        id: plotComp

        UIHint {
            target: rtPlot

            property int stage: settingName === "plotCursor" ? 0 : settingName === "drGeneral" ? 1 : settingName === "drStartStop" ? 2 : 3

            Plot {
                id: subject
                x: parent.targetX
                y: parent.targetY
                width: parent.targetWidth
                height: parent.targetHeight

                showRecordDownload: gState.capDataRecord
                dotsEnabled: false

                plotData: PlotData {
                    id: pd
                    seriesMetaData: plotSeriesMetaData
                }

                Component.onCompleted: {
                    pd.init(["motor.current"], 1);
                    subject.init(1);
                    pd.addSample([0, 0,0,0,0, 10], 0);
                    pd.addSample([2,0,0,0,0, 22], 1);
                    pd.addSample([4,0,0,0,0, 15], 2);
                    pd.addSample([9,0,0,0,0, 30], 3);
                    pd.makeReady();
                    if (stage === 0) {
                        subject.spawnCursor(4);
                    }
                }

                UIHintFrame {}

                UIHintUnderline {
                    anchors.topMargin: unit
                    anchors.leftMargin: unit
                    width: unit * 1.7
                    visible: stage === 1
                }

                UIHintUnderline {
                    anchors.topMargin: unit
                    anchors.leftMargin: 1.9 * unit
                    visible: stage === 2
                }

                UIHintUnderline {
                    anchors.topMargin: unit
                    anchors.leftMargin: unit
                    visible: stage === 3
                }
            }

            UIHintText {
                anchors.horizontalCenter: subject.horizontalCenter
                anchors.bottom: subject.top
                text: "View a plot of realtime data (log) from the package on the Data tab.\n\nLong press anywhere in the plot area to spawn a cursor.\n\nYou can dismiss the cursor by a swipe up gesture on it."
                visible: stage === 0
            }

            UIHintText {
                anchors.horizontalCenter: subject.horizontalCenter
                anchors.bottom: subject.top
                text: "Congratulations, you have the Data Record firmware installed. You are now part of the secret Data Recording society.\n\nYour board has the ability to store a short detailed data \"log\" by itself, you don't need to be connected.\n\nIt's controlled by these two buttons."
                visible: stage === 1
            }

            UIHintText {
                anchors.horizontalCenter: subject.horizontalCenter
                anchors.bottom: subject.top
                text: "This button indicates whether the board is recording. You can use it to start and stop the recording manually.\n\nThe board automatically starts recording when engaged and stops recording on disengage. You can disable the autostart and autostop functionality by long-pressing the button.\n\nIf you nosedive, check the recording before engaging again!"
                visible: stage == 2
            }

            UIHintText {
                anchors.horizontalCenter: subject.horizontalCenter
                anchors.bottom: subject.top
                text: "You can download the stored data using this button. It automatically stops recording. Do not start it while you're downloading, or you'll corrupt your data."
                visible: stage == 3
            }
        }
    }

    QtObject {
        id: uiHints

        property Settings uiHintsSettings: Settings {
            id: uiHintsSettings
            category: "uiHints"

            property bool statusText
            property bool plotCursor

            property bool drGeneral
            property bool drStartStop
            property bool drDownload
        }

        readonly property var hints: new Map([
            ["statusText", statusTextComp],
            ["plotCursor", plotComp],
        ])

        readonly property var dataRecordHints: new Map([
            ["drGeneral", plotComp],
            ["drStartStop", plotComp],
            ["drDownload", plotComp],
        ])

        function fill(container) {
            for (let [key, value] of hints) {
                if (!uiHintsSettings[key]) {
                    if (key == "plotCursor") {
                        bottomStackTabs.currentIndex = 3;
                        bottomSheet.open();
                    }
                    value.createObject(container, {settings: uiHintsSettings, settingName: key});
                }
            }
        }

        function fillDataRecord(container) {
            if (state.capDataRecord) {
                for (let [key, value] of dataRecordHints) {
                    if (!uiHintsSettings[key]) {
                        bottomStackTabs.currentIndex = 3;
                        bottomSheet.open();
                        value.createObject(container, {settings: uiHintsSettings, settingName: key});
                    }
                }
            }
        }

        function reset(container) {
            for (let key of hints.keys()) {
                uiHintsSettings[key] = false;
            }

            if (state.capDataRecord) {
                for (let key of dataRecordHints.keys()) {
                    uiHintsSettings[key] = false;
                }
            }
        }
    }

    Connections {
        id: tuneManager
        target: packageConfig

        readonly property int formatVersionMajor: 1
        readonly property int formatVersionMinor: 0
        readonly property string formatVersion: "%1.%2".arg(formatVersionMajor).arg(formatVersionMinor)
        readonly property string packageName: "{{PACKAGE_NAME}}"
        readonly property string packageVersion: "{{VERSION}}"
        readonly property int maxTunes: 6

        signal idBackupFinished(var backup)
        signal autoBackupFinished(var backup)

        // Storage for tunes as well as full package configs
        property var tuneStorage: Settings {
            id: tuneStorage
            category: "configs"

            property var tuneArchive
            property var tuneArchiveDownloadDate

            property var fullBackup
        }

        property var tunes: {
            var tunes = {}
            for (var slot = 1; slot <= maxTunes; slot++) {
                var tune = loadTune(slot);
                if (tune) {
                    tunes[slot] = tune;
                }
            }

            return tunes;
        }

        // Major package versions require a migration, minor don't.
        // Migration functions should return: [tuneObject, [newMajor, newMinor]]
        property var migrations: {
            "1.1": function(tune) {
                var [fwMajor, fwMinor] = board.getFwVersion();
                if (fwMajor > 6 || (fwMajor == 6 && fwMinor >= 5) && motorConfig.batteryCells > 0) {
                    if (tune.settings["tiltback_hv"] > 10) {
                        tune.settings["tiltback_hv"] /= motorConfig.batteryCells;
                    }
                    if (tune.settings["tiltback_lv"] > 10) {
                        tune.settings["tiltback_lv"] /= motorConfig.batteryCells;
                    }
                }

                return [tune, [1, 2]];
            },
        }

        function onUpdate() {
            triggerAutoRestore();
            // force recalculation of dependent variables
            tunes = tunes;
        }

        property alias fullBackup: tuneStorage.fullBackup

        function convertToOldFormat(tune) {
            if (Array.isArray(tune.settings)) {
                return tune;
            }

            var res = Object.assign({}, tune);
            res.settings = [];
            for (let [name, value] of Object.entries(tune.settings)) {
                res.settings.push({
                    "name": name,
                    "value": value,
                    "type": packageConfig.getParamType(name)
                });
            }
            return res;
        }

        function convertFromOldFormat(tune) {
            if (!Array.isArray(tune.settings)) {
                return tune;
            }

            var res = Object.assign({}, tune);
            res.settings = {};
            for (let item of tune.settings) {
                res.settings[item.name] = item.value;
            }
            return res;
        }

        function tuneId(slot) {
            return "tune_slot_" + slot;
        }

        function createTune(name, description, settings) {
            var tune = {
                "version": formatVersion,
                "name": name,
                "date": new Date(),
                "package": {
                    "name": packageName,
                    "version": packageVersion
                },
                "board": {
                    "id": board.getId(),
                },
                "settings": settings
            };

            var boardName = board.getName();
            if (boardName) {
                tune.board.name = boardName;
            }

            if (description) {
                tune.description = description;
            }

            return tune;
        }

        function updateTune(tune, name, description, settings) {
            if (!packageConfig.versionCompatible(tune)) {
                return false;
            }

            tune.name = name;
            if (description) {
                tune.description = description;
            }
            if (settings) {
                tune.settings = settings;
                tune.date = new Date();
            }
            tune.version = formatVersion;

            return true;
        }

        function migrateTune(tune) {
            var [major, minor] = versionMajorMinor(tune.package.version);
            // Zero or NaN
            if (!major) {
                return tune;
            }

            var [pMajor, pMinor] = versionMajorMinor(packageVersion);

            while (major < pMajor || (major == pMajor && minor < pMinor)) {
                var versionKey = [major, minor].join(".");
                if (migrations.hasOwnProperty(versionKey)) {
                    [tune, [major, minor]] = migrations[versionKey](tune);
                } else {
                    minor++;
                }
            }
            return tune;
        }

        function createBackup() {
            var config = packageConfig.fetchConfig(false);
            if (!config) {
                return null;
            }
            return createTune("Full Backup", "", config);
        }

        function loadBackup(name) {
            var backup = tuneStorage.value(name);
            if (!backup) {
                return null;
            }

            return migrateTune(convertFromOldFormat(backup));
        }

        function saveBackup(name, backup) {
            tuneStorage.setValue(name, convertToOldFormat(backup));
        }

        function globalBackup() {
            var backup = createBackup();
            if (!backup) {
                return;
            }
            fullBackup = backup;
        }

        function globalRestore() {
            var backup = loadBackup("fullBackup");
            if (!backup) {
                return;
            }
            applyConfigDialog.show(backup, false, false);
        }

        function idBackup() {
            var backup = createBackup();
            if (!backup) {
                return;
            }
            saveBackup("backup_" + board.getId(), backup);
            idBackupFinished(backup);
        }

        function idRestore() {
            var backup = loadBackup("backup_" + board.getId());
            if (!backup) {
                return;
            }
            applyConfigDialog.show(backup, false, false);
        }

        function autoBackup() {
            var backup = createBackup();
            if (!backup) {
                return;
            }

            saveBackup("auto_backup_" + board.getId(), backup);
            autoBackupFinished(backup);
        }

        function autoRestore() {
            var backup = loadBackup("auto_backup_" + board.getId());
            if (!backup) {
                return;
            }
            applyConfigDialog.show(backup, false, false);
        }

        function triggerAutoRestore() {
            if (!packageConfig.checkConfig()) {
                return;
            }

            if (packageConfig.isDefault()) {
                var backup = loadBackup("auto_backup_" + board.getId());
                if (backup) {
                    print("{{PACKAGE_NAME}}: Automatic backup restore.");
                    applyConfigDialog.show(backup, true, false);
                } else {
                    print("{{PACKAGE_NAME}}: No automatic backup to restore.");
                }
            } else {
                print("{{PACKAGE_NAME}}: Automatic config backup.");
                autoBackup();
            }
        }

        function saveTune(slot, tune) {
            var id = tuneId(slot);
            tuneStorage.setValue(id, JSON.stringify(convertToOldFormat(tune)));

            tunes[slot] = tune;
            // workaround needed so that the change is written through to the storage
            tunes = tunes;
        }

        function loadTune(slot) {
            var tune = tuneStorage.value(tuneId(slot));
            if (tune) {
                if (typeof tune === "string") {
                    tune = JSON.parse(tune);
                }
                return migrateTune(convertFromOldFormat(tune));
            }
            return null;
        }

        function eraseTune(slot) {
            tuneStorage.setValue(tuneId(slot), "");
            tunes[slot] = null;
            // workaround needed so that the change is written through to the storage
            tunes = tunes;
        }

        function slotEmpty(slot) {
            return !tuneStorage.value(tuneId(slot), null);
        }

        function saveTuneArchive(tuneArchive) {
            tuneStorage.tuneArchive = JSON.stringify(tuneArchive);
            tuneStorage.tuneArchiveDownloadDate = new Date();
        }

        function loadTuneArchive() {
            if (tuneStorage.tuneArchive) {
                if (typeof tuneStorage.tuneArchive === "string") {
                    return JSON.parse(tuneStorage.tuneArchive);
                } else {
                    return tuneStorage.tuneArchive;
                }
            }
            return null;
        }

        function getTuneArchiveDate() {
            return Qt.formatDateTime(tuneStorage.tuneArchiveDownloadDate);
        }

        function parseCsv(csv) {
            var lines = csv.split("\r\n");
            var tuneCount = lines[0].split(",").length - 1;

            var result = [];
            for (var i = 0; i < tuneCount; i++) {
                // set the version to the current one to always pass the version check
                result.push({"version": formatVersion, "settings": {}});
            }

            for (var i in lines) {
                var currentLine = lines[i].split(",");

                for (var j = 0; j < tuneCount; j++) {
                    var value = currentLine[j + 1];
                    if (value) {
                        var key = currentLine[0];
                        var name;

                        if (key === "_name") {
                            result[j].name = value;
                            continue;
                        } else if (key.startsWith("double_")) {
                            name = key.substring(7);
                            value = parseFloat(value);
                        } else if (key.startsWith("int_")) {
                            name = key.substring(4);
                            value = parseInt(value);
                        } else if (key.startsWith("bool_")) {
                            name = key.substring(5);
                            value = !!parseInt(value);
                        } else if (key.startsWith("enum_")) {
                            name = key.substring(5);
                            value = parseInt(value);
                        }

                        if (Number.isNaN(value)) {
                            continue;
                        }

                        result[j].settings[name] = value;
                    }
                }
            }

            return result;
        }

        Component.onCompleted: {
            var idBackup = loadBackup("backup_" + board.getId());
            if (idBackup) {
                idBackupFinished(idBackup);
            }
            var autoBackup = loadBackup("auto_backup_" + board.getId());
            if (autoBackup) {
                autoBackupFinished(autoBackup);
            }
        }
    }

    // for components (inside one, "state" is the item's own state property)
    readonly property bool boardRunning: state.pkgState === state.s_Running

    property var state: QtObject {
        id: state

        readonly property int comms_Info: 1
        readonly property int comms_RTDataIDs: 2
        readonly property int comms_Initialized: 3

        property int commsState: comms_Info

        signal commsInitialized

        onCommsStateChanged: {
            if (commsState == comms_Initialized) {
                commsInitialized();
            }
        }

        property bool extraRecording: false
        property bool extraRecAutostart: false
        property bool extraRecAutostop: false

        property int ticksPerSecond

        // package capabilities
        readonly property int cap_Lights: 1
        readonly property int cap_LightsExternal: 2
        readonly property int cap_DataRecord: 2**31

        property bool capLights
        property bool capLightsExternal
        property bool capDataRecord

        function setCapabilities(caps) {
            capLights = caps & cap_Lights;
            capLightsExternal = caps & cap_LightsExternal;
            // Javascript can't work with 32bit ints, an "&" check doesn't work for 2**31 (on Android).
            // The >>> 0 hack is needed for desktop.
            capDataRecord = caps >= (cap_DataRecord >>> 0);
        }

        // package state
        readonly property int s_Disabled: 0
        readonly property int s_Startup: 1
        readonly property int s_Ready: 2
        readonly property int s_Running: 3
        readonly property int s_Connecting: 254
        readonly property int s_Disconnected: 255

        readonly property var pkgStateToString: new Map([
            [s_Disabled, "DISABLED"],
            [s_Startup, "STARTUP"],
            [s_Ready, "READY"],
            [s_Running, "RUNNING"],
            [s_Connecting, "CONNECTING..."],
            [s_Disconnected, "DISCONNECTED"],
        ])

        property int pkgState: s_Connecting
        property string pkgStateString: pkgStateToString.get(pkgState) ?? "UNKNOWN (%1)".arg(pkgState)

        // package mode
        readonly property int m_Normal: 0
        readonly property int m_Handtest: 1
        readonly property int m_Flywheel: 2

        property int pkgMode: m_Normal

        property string pkgModeString: {
            if (pkgState != s_Disconnected) {
                if (pkgMode == m_Flywheel) {
                    return "FLYWHEEL";
                } else if (pkgMode == m_Handtest) {
                    return "HANDTEST";
                }
            }

            return "";
        }

        // footpad sensor state
        readonly property int fs_None: 0
        readonly property int fs_Left: 1
        readonly property int fs_Right: 2
        readonly property int fs_Both: 3

        property int fpState: fs_None
        property double peakOkSince: 0  // Re-RinkFloat: when ride-peak conditions last became true

        onFpStateChanged: {
            leftSensor.on = false;
            rightSensor.on = false;

            if (fpState & fs_Left) {
                leftSensor.on = true;
            }

            if (fpState & fs_Right) {
                rightSensor.on = true;
            }
        }

        // setpoint adjustment type
        readonly property int sat_None: 0
        readonly property int sat_Centering: 1
        readonly property int sat_ReverseStop: 2
        readonly property int sat_Speed: 5
        readonly property int sat_Duty: 6
        readonly property int sat_PushbackError: 7
        readonly property int sat_HighVoltage: 10
        readonly property int sat_LowVoltage: 11
        readonly property int sat_Temperature: 12

        // setpoint adjustment class
        readonly property int sac_Normal: 0
        readonly property int sac_Warning: 1
        readonly property int sac_Error: 2

        readonly property var setpointAdjustmentTypeToString: new Map([
            [sat_None, ""],
            [sat_Centering, "centering"],
            [sat_ReverseStop, "reverse stop"],
            [sat_Speed, "pushback: speed"],
            [sat_Duty, "pushback: duty"],
            [sat_PushbackError, "pushback: error"],
            [sat_HighVoltage, "pushback: high voltage"],
            [sat_LowVoltage, "pushback: low voltage"],
            [sat_Temperature, "pushback: temperature"],
        ])

        property int setpointAdjustmentType: sat_None
        property string setpointAdjustmentTypeString
        property int setpointAdjustmentClass
        onSetpointAdjustmentTypeChanged: {
            // do these in one function to keep them consistent, order is important to display and fade correctly in pitchPushbackText
            setpointAdjustmentClass = setpointAdjustmentType >= sat_HighVoltage ? sac_Error : setpointAdjustmentType >= sat_Speed ? sac_Warning : sac_Normal;
            setpointAdjustmentTypeString = setpointAdjustmentTypeToString.get(setpointAdjustmentType) ?? "unknown (%1)".arg(setpointAdjustmentType);
        }

        // stop condition
        readonly property int sc_None: 0
        readonly property int sc_Pitch: 1
        readonly property int sc_Roll: 2
        readonly property int sc_SensorHalf: 3
        readonly property int sc_SensorFull: 4
        readonly property int sc_ReverseStop: 5
        readonly property int sc_Quickstop: 6
        readonly property int sc_ImuTimeout: 7

        readonly property var stopConditionToString: new Map([
            [sc_None, ""],
            [sc_Pitch, "Pitch"],
            [sc_Roll, "Roll"],
            [sc_SensorHalf, "Sensor Half"],
            [sc_SensorFull, "Sensor Full"],
            [sc_ReverseStop, "Reverse Stop"],
            [sc_Quickstop, "Quickstop"],
            [sc_ImuTimeout, "IMU Timeout"],
        ])

        property int stopCondition: sc_None
        property string stopConditionString: stopConditionToString.get(stopCondition) ?? "unknown (%1)".arg(stopCondition)

        property bool darkride: false
        property bool freespinLimiting: false  // Re-RinkFloat: free-spin limiter holding the wheel
        property bool wheelslip: false
        property bool charging: false

        readonly property var beepReasonToString: new Map([
            [0, ""],
            [1, "Low Voltage"],
            [2, "High Voltage"],
            [3, "Controller Temp"],
            [4, "Motor Temp"],
            [5, "Overcurrent"],
            [6, "Duty Cycle"],
            [7, "Foot Sensors"],
            [8, "Low Battery"],
            [9, "Board Idle"],
            [10, "Other"],
            [11, "Speed"],
            [12, "BMS: Cell Under Temp"],
            [13, "BMS: Cell Over Temp"],
            [14, "BMS: Cell Low Voltage"],
            [15, "BMS: Cell High Voltage"],
            [16, "BMS: Cell Balance"],
            [17, "BMS: Connection Error"],
            [18, "BMS: BMS Temp"],
            [19, "Firmware Fault"],
        ])

        property int beepReason: 0
        property string beepReasonString: beepReasonToString.get(beepReason) ?? "unknown (%1)".arg(beepReason)

        property bool pkgStateIsError: ![s_Startup, s_Ready, s_Running, s_Connecting].includes(pkgState)
        property bool configLoadingError: false
        property bool fatalError: false

        property bool isError: pkgStateIsError || configLoadingError || fatalError

        property var timeReference

        function ticksToMsSinceEpoch(t) {
            if (timeReference === undefined) {
                return undefined;
            }

            return timeReference + t * 1000 / ticksPerSecond;
        }

        function setTimeReference(t) {
            var timeRef = ticksToMsSinceEpoch(t);
            var now = Date.now();

            // if time is in the past, it's either a board reboot or the ticks have overflown
            // reset the time reference either way
            if (timeRef === undefined || timeRef < now - 8000) {
                timeReference = now - t * 1000 / ticksPerSecond;
            }
        }

        property var rtDataIdleItems: []
        property var rtDataRuntimeItems: []
        property var rtDataAllItems: []

        property var rtData: newRtData();

        function newRtData(values) {
            let newData = new Proxy({}, {
                get: function(target, name) {
                    return target.hasOwnProperty(name) ? target[name] : NaN;
                }
            });

            if (!values) {
                return newData;
            }

            var names = rtDataAllItems;
            for (var i = 0; i < names.length; i++) {
                newData[names[i]] = values[i];
            }
            return newData;
        }
    }

    QtObject {
        id: alerts

        property int activeAlertsMask: 0
        property int activeAlertHighlight: 0
        property int activeAlertCount: 0
        property bool isFatalActive: false
        property var activeAlerts: []
        property int activeFwFaultCode: 0
        property string activeFwFaultName: ""
        property var alertsLog: new Map()
        property int lastAlertsLogTicks: 0

        signal alertAdded(var alert)

        property Connections connections: Connections {
            target: state

            function onTimeReferenceChanged() {
                alerts.lastAlertsLogTicks = 0;
            }
        }

        readonly property int alert_fwFault: 1

        readonly property var alertData: new Map([
            [0, {
                "name": "None",
                "severity": "WARNING",
            }],
            [alert_fwFault, {
                "name": "Fault",
                "severity": "FATAL",
            }],
        ])

        readonly property var severityColors: new Map([
            ["FATAL", Utility.getAppHexColor("red")],
            ["ERROR", Utility.getAppHexColor("orange")],
            ["WARNING", Utility.getAppHexColor("lightText")],
        ])

        property Timer alertsListPollTimer: Timer {
            running: state.commsState === state.comms_Initialized
            repeat: true
            interval: 500
            triggeredOnStart: true
            onTriggered: {
                commands.sendAlertsList(alerts.lastAlertsLogTicks ? alerts.lastAlertsLogTicks : undefined);
            }
        }

        function getActiveAlertData(alertId) {
            if (alertId == alert_fwFault) {
                var data = Object.assign({}, alertData.get(alertId));
                data.name = data.name + ": " + activeFwFaultName;
                return data;
            } else {
                return alertData.get(alertId);
            }
        }

        function getAlertLogData(alertId, data) {
            return alertData.get(alertId);
        }

        function updateActiveAlerts() {
            if (activeAlertsMask & alert_fwFault) {
                activeAlertHighlight = alert_fwFault;
                activeAlertCount = 1;
                isFatalActive = true;
                activeAlerts = [
                    alert_fwFault,
                ];
            } else {
                activeAlertHighlight = 0;
                activeAlertCount = 0;
                isFatalActive = false;
                activeAlerts = [];
            }
        }

        function receiveAlertsList(dv, ind) {
            activeAlertsMask = dv.getUint32(ind); ind += 4;
            ind += 4;  // skip unused 4 bytes
            activeFwFaultCode = dv.getUint8(ind++);
            if (activeFwFaultCode > 0) {
                [activeFwFaultName, ind] = commands.getString(dv, ind);
            } else {
                activeFwFaultName = "";
            }
            updateActiveAlerts();

            var count = dv.getUint8(ind++);

            var ids = [];
            for (var i = 0; i < count; i++) {
                var ticks = dv.getUint32(ind); ind += 4;
                var record = {
                    "ticks": ticks,
                    "id": dv.getUint8(ind++),
                    "active": dv.getUint8(ind++) & 0x1,
                    "code": dv.getUint8(ind++),
                };

                if (record.code > 0) {
                    [record.text, ind] = commands.getString(dv, ind);
                }

                var realTime = state.ticksToMsSinceEpoch(ticks);
                if (realTime === undefined) {
                    break;
                }

                record.time = realTime;

                var key = "%1_%2_%3".arg(ticks).arg(record.id).arg(record.active);
                if (alertsLog.has(key) && Math.abs(realTime - alertsLog.get(key).time) < 5000) {
                    continue;
                }

                alertsLog.set(key, record);
                lastAlertsLogTicks = ticks;
                alertAdded(record);
            }
        }

        function clearFatalError() {
            commands.sendAlertsClearFatal();
        }
    }

    QtObject {
        id: lights

        property bool enabled: state.capLights
        property bool lcm: state.capLightsExternal

        property bool on: false
        property bool headlightsOn: false
    }

    // A distance unit used for most dimensions throughout the layouts.
    // Basing on width ensures uniform scaling of the whole UI, height is a
    // factor of width and we rely on vertical aspect ratio to have some space
    // at the bottom for a StackLayout of Tunes / Control / ...
    property real unit: width * 0.1

    property real fontSizeBig: 0.4 * unit
    property real fontSizeNormal: 0.35 * unit
    property real fontSizeSmall: 0.3 * unit
    property real fontSizeSuperSmall: 0.25 * unit

