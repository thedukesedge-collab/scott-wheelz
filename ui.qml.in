        "#788554",
        "#cd3763",
        "#63c339",
    ]

    anchors.fill: parent

    component NText : Text {
        color: Utility.getAppHexColor("normalText")
    }

    component LText : Text {
        color: Utility.getAppHexColor("lightText")
    }

    component DText : Text {
        color: Utility.getAppHexColor("disabledText")
    }

    // Refloat Glow: neon green + purple theme for the main screen.
    // Warning colors (red, orange) are kept so alerts still read as alerts.
    QtObject {
        id: swTheme

        readonly property color neonGreen: "#39ff7a"
        readonly property color neonPurple: "#b14cff"
        readonly property color background: "#05060d"
        readonly property color grid: "#160d2b"

        // Refloat Glow: neon palette for the tune preset buttons
        readonly property var neonNames: ["Green", "Purple", "Cyan", "Magenta", "Orange", "Yellow", "Red", "Blue"]
        readonly property var neonColors: ["#39ff7a", "#b14cff", "#00f0ff", "#ff2bd6", "#ff8a1f", "#f5ff3b", "#ff2b4f", "#3b7bff"]

        function tuneColorIndex(slot) {
            var map = {};
            try { map = JSON.parse(swSettings.tuneColors || "{}"); } catch (e) {}
            var i = map[slot];
            return (i === undefined || i < 0 || i >= neonColors.length) ? ((slot - 1) % neonColors.length) : i;
        }

        function tuneColor(slot) {
            return neonColors[tuneColorIndex(slot)];
        }

        function setTuneColor(slot, index) {
            var map = {};
            try { map = JSON.parse(swSettings.tuneColors || "{}"); } catch (e) {}
            map[slot] = index;
            swSettings.tuneColors = JSON.stringify(map);
        }

        function color(name) {
            switch (name) {
            case "lightAccent":
            case "green":
                return "#39ff7a";
            case "lightText":
                return "#d6ffe4";
            case "normalText":
                return "#c3a6ff";
            case "disabledText":
                return "#7d68ab";
            case "lightBackground":
                return "#24123f";
            case "lightestBackground":
                return "#3d2266";
            case "darkBackground":
                return "#05060d";
            case "purpleAccent":
                return "#7b2fd0";
            case "swPurple":
                return "#b14cff";
            case "swBalance":
                return "#6a4a9e";
            default:
                return Utility.getAppHexColor(name);
            }
        }
    }

    // Refloat Glow: Neon Future grid used behind the main screen and the bottom sheet
    component SwGrid : Canvas {
        contextType: "2d"
        onWidthChanged: requestPaint()
        onHeightChanged: requestPaint()
        onPaint: {
            var ctx = getContext("2d");
            ctx.reset();
            ctx.strokeStyle = swTheme.grid;
            ctx.lineWidth = 1;
            var step = Math.max(12, Math.round(0.5 * unit));
            ctx.beginPath();
            for (var x = 0; x < width; x += step) {
                ctx.moveTo(x + 0.5, 0);
                ctx.lineTo(x + 0.5, height);
            }
            for (var y = 0; y < height; y += step) {
                ctx.moveTo(0, y + 0.5);
                ctx.lineTo(width, y + 0.5);
            }
            ctx.stroke();
        }
    }

    component SwNText : Text {
        color: swTheme.color("normalText")
    }

    component SwLText : Text {
        color: swTheme.color("lightText")
    }

    component SwDText : Text {
        color: swTheme.color("disabledText")
    }

    // Refloat Glow: home-screen labels/values in the speedo's digital font,
    // neon purple with a soft glow
    component SwNeonLabel : Text {
        color: "#c98bff"
        font.family: "Exan"
        font.pixelSize: 0.3 * unit
        font.letterSpacing: 0.02 * unit
        fontSizeMode: width > 0 ? Text.HorizontalFit : Text.FixedSize
        minimumPixelSize: 0.14 * unit
    }

    component SwNeonValue : SwNeonLabel {
        color: "#ead6ff"
        font.pixelSize: 0.42 * unit
        minimumPixelSize: 0.2 * unit
    }

    // Refloat Glow: "check engine" style motor symbol (outline after the
    // Material Design "engine" icon, Apache 2.0)
    component SwEngineIcon : Canvas {
        id: engineIcon
        property color color: "#c98bff"
        onColorChanged: requestPaint()
        onWidthChanged: requestPaint()
        onHeightChanged: requestPaint()
        contextType: "2d"
        onPaint: {
            var pts = [[14,8],[14,12],[20,12],[20,16],[14,16],[10,20],[10,26],[6,26],[6,20],[2,20],[2,36],[6,36],
                       [6,30],[10,30],[10,36],[16,36],[20,40],[36,40],[36,32],[40,32],[40,38],[46,38],[46,18],
                       [40,18],[40,24],[36,24],[36,16],[24,16],[24,12],[30,12],[30,8]];
            var ctx = getContext("2d");
            ctx.reset();
            var s = Math.min(width / 48, height / 48);
            ctx.translate((width - 48 * s) / 2, (height - 48 * s) / 2);
            ctx.scale(s, s);
            ctx.lineJoin = "round";
            ctx.beginPath();
            ctx.moveTo(pts[0][0], pts[0][1]);
            for (var i = 1; i < pts.length; i++) {
                ctx.lineTo(pts[i][0], pts[i][1]);
            }
            ctx.closePath();
            ctx.strokeStyle = swTheme.neonPurple;
            ctx.globalAlpha = 0.3;
            ctx.lineWidth = 8;
            ctx.stroke();
            ctx.globalAlpha = 1.0;
            ctx.strokeStyle = engineIcon.color;
            ctx.lineWidth = 3;
            ctx.stroke();
        }
    }

    // Refloat Glow: small up/down arrow button with hold-to-repeat
    component SwArrow : Rectangle {
        id: arrow
        property bool up: true
        property bool atLimit: false
        signal step()
        width: 0.8 * unit
        height: 0.7 * unit
        radius: 0.12 * unit
        color: arrowArea.pressed && !atLimit ? swTheme.neonPurple : "#140a26"
        border.color: atLimit ? "#4a2a73" : swTheme.neonPurple
        border.width: 2

        Canvas {
            anchors.centerIn: parent
            width: 0.32 * unit
            height: 0.24 * unit
            property color col: arrow.atLimit ? "#4a2a73" : arrowArea.pressed ? swTheme.background : swTheme.neonGreen
            onColChanged: requestPaint()
            onPaint: {
                var ctx = getContext("2d");
                ctx.reset();
                ctx.beginPath();
                if (arrow.up) {
                    ctx.moveTo(0, height); ctx.lineTo(width / 2, 0); ctx.lineTo(width, height);
                } else {
                    ctx.moveTo(0, 0); ctx.lineTo(width / 2, height); ctx.lineTo(width, 0);
                }
                ctx.closePath();
                ctx.fillStyle = col;
                ctx.fill();
            }
        }

        MouseArea {
            id: arrowArea
            anchors.fill: parent
            onPressed: { if (!arrow.atLimit) arrow.step(); arrowRepeat.interval = 450; arrowRepeat.start(); }
            onReleased: arrowRepeat.stop()
            onCanceled: arrowRepeat.stop()
        }

        Timer {
            id: arrowRepeat
            repeat: true
            onTriggered: { interval = 110; if (!arrow.atLimit) arrow.step(); }
        }
    }

    // Refloat Glow: neon pill button
    component SwPill : Rectangle {
        id: pill
        property string label
        property bool lit: false
        property bool enabledLook: true
        property real minWidth: 2.0 * unit
        property real labelSize: 0.24 * unit  // rf132
        property color litColor: swTheme.neonGreen  // rf134: e.g. the orange BEEP
        signal clicked()
        // implicit size, so pills also work inside Row/ColumnLayouts
        implicitWidth: Math.max(minWidth, pillText.implicitWidth + 0.6 * unit)
        implicitHeight: 0.72 * unit
        radius: height / 2
        opacity: enabledLook ? 1 : 0.4
        color: lit || pillArea.pressed ? litColor : "transparent"
        border.color: lit || pillArea.pressed ? litColor : swTheme.neonPurple
        border.width: 2

        Text {
            id: pillText
            anchors.centerIn: parent
            width: Math.min(implicitWidth, pill.width - 0.3 * unit)
            elide: Text.ElideRight
            horizontalAlignment: Text.AlignHCenter
            text: pill.label
            color: pill.lit || pillArea.pressed ? swTheme.background : swTheme.neonPurple
            font.family: "Exan"
            font.pixelSize: pill.labelSize
        }

        MouseArea {
            id: pillArea
            anchors.fill: parent
            onClicked: pill.clicked()
        }
    }

    // Refloat Glow: neon outline button for dialogs (settings window)
    component NeonButton : Rectangle {
        id: nbtn
        property string text
        property bool lit: false
        signal clicked()
        implicitWidth: Math.max(2.6 * unit, nbtnText.implicitWidth + 0.8 * unit)
        implicitHeight: 0.8 * unit
        radius: height / 2
        opacity: enabled ? 1 : 0.4
        color: nbtnArea.pressed ? swTheme.neonGreen : (lit ? "#123a20" : "transparent")
        border.color: swTheme.neonGreen
        border.width: 2
        Text {
            id: nbtnText
            anchors.centerIn: parent
            text: nbtn.text.toUpperCase()
            color: nbtnArea.pressed ? swTheme.background : swTheme.neonGreen
            font.family: "Exan"
            font.pixelSize: 0.24 * unit
            font.letterSpacing: 0.02 * unit
        }
        MouseArea {
            id: nbtnArea
            anchors.fill: parent
            onClicked: nbtn.clicked()
        }
    }

    // Refloat Glow: a framed group in the settings window
    component SettingsCard : Rectangle {
        id: scard
        property string title
        default property alias content: scardCol.data
        Layout.fillWidth: true
        Layout.leftMargin: 0.1 * unit
        Layout.rightMargin: 0.1 * unit
        // delayed: the wrapped texts' height depends on the card's width,
        // which the layout sets - a direct binding loops
        Binding on implicitHeight { value: scardCol.implicitHeight + 0.5 * unit; delayed: true }
        radius: 0.22 * unit
        color: "#100a24"
        border.color: "#3a2266"
        border.width: 2
        ColumnLayout {
            id: scardCol
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.top: parent.top
            anchors.margins: 0.25 * unit
            spacing: 0.15 * unit
            Text {
                Layout.fillWidth: true
                text: scard.title
                color: swTheme.neonPurple
                font.family: "Exan"
                font.pixelSize: 0.28 * unit
                font.letterSpacing: 0.04 * unit
            }
        }
    }

    // Refloat Glow: section heading (neon green, digital font)
    component LedHeading : SwLText {
        anchors.horizontalCenter: parent ? parent.horizontalCenter : undefined
        font.pixelSize: 0.38 * unit
        font.family: "Exan"
        font.letterSpacing: 0.03 * unit
        color: swTheme.neonGreen
    }

    // rf124: a rounded neon card with a centered title, for one light / group
    component OffNote : Rectangle {
        property alias text: offNoteText.text
        property color tone: "#ff2b4f"
        z: 3
        width: offNoteText.implicitWidth + 0.3 * unit
        height: offNoteText.implicitHeight + 0.1 * unit
        radius: height / 2
        color: "#0b0718"
        border.color: tone
        border.width: 1
        Text {
            id: offNoteText
            anchors.centerIn: parent
            color: parent.tone
            font.family: "Exan"
            font.pixelSize: 0.2 * unit
        }
    }

    // rf167: a small (?) that opens a plain explanation window (infoHelp)
    component SwHelpDot : Rectangle {
        property string helpTitle: ""
        property string helpText: ""
        width: 0.5 * unit
        height: width
        radius: width / 2
        color: helpDotArea.pressed ? swTheme.neonPurple : "transparent"
        border.color: swTheme.neonPurple
        border.width: 2
        Text {
            anchors.centerIn: parent
            text: "?"
            color: helpDotArea.pressed ? swTheme.background : swTheme.neonGreen
            font.family: "Exan"
            font.pixelSize: 0.28 * unit
        }
        MouseArea {
            id: helpDotArea
            anchors.fill: parent
            anchors.margins: -0.2 * unit
            onClicked: infoHelp.show(parent.helpTitle, parent.helpText)
        }
    }

    // rf167: a card heading with an optional (?) on the right
    component SwCardHead : Item {
        property string title: ""
        property string helpText: ""
        width: parent ? parent.width : 0
        height: 0.5 * unit
        Text {
            anchors.centerIn: parent
            text: parent.title
            color: swTheme.neonGreen
            font.family: "Exan"
            font.pixelSize: 0.26 * unit
            font.letterSpacing: 0.03 * unit
        }
        SwHelpDot {
            visible: parent.helpText !== ""
            anchors.right: parent.right
            anchors.verticalCenter: parent.verticalCenter
            helpTitle: parent.title
            helpText: parent.helpText
        }
    }

    component LedCard : Rectangle {
        id: ledCard
        property string title
        default property alias content: cardCol.data
        width: parent ? parent.width : 0
        height: cardCol.implicitHeight + 0.3 * unit
        radius: 0.18 * unit
        color: "#120a22"
        border.color: Qt.rgba(0.66, 0.33, 1, 0.55)
        border.width: 2
        Column {
            id: cardCol
            x: 0.15 * unit
            y: 0.15 * unit
            width: parent.width - 0.3 * unit
            spacing: 0.1 * unit
            Text {
                visible: ledCard.title !== ""
                width: parent.width
                horizontalAlignment: Text.AlignHCenter
                text: ledCard.title
                color: swTheme.neonGreen
                font.family: "Exan"
                font.pixelSize: 0.28 * unit
                font.letterSpacing: 0.03 * unit
            }
        }
    }

    // Refloat Glow: LEDS tab tile - opens a full-screen settings window
    component LedTile : Rectangle {
        id: tile
        property string title
        property string summary
        property string glyph
        property bool lit: false
        property color swatch: "transparent"
        property bool slcmOnly: false  // needs the SLCM light module firmware
        // rf92: small animated picture instead of the glyph: 2 status bar
        // (LEDs filling up), 3 the neon board (HEAD/TAIL LIGHTS, rf98),
        // 4 the board's front with a live status bar (rf136)
        property int art: 0
        signal clicked()
        Layout.fillWidth: true
        Layout.preferredHeight: 1.9 * unit
        opacity: slcmOnly && !slcmDetect.present ? 0.5 : 1
        radius: 0.22 * unit
        color: tileArea.pressed ? "#1b2a1f" : "#0b0718"
        border.color: lit ? swTheme.neonGreen : swTheme.neonPurple
        border.width: 2

        Text {
            visible: tile.art === 0
            anchors.left: parent.left
            anchors.top: parent.top
            anchors.margins: 0.18 * unit
            text: tile.glyph
            color: tile.lit ? swTheme.neonGreen : swTheme.neonPurple
            font.pixelSize: 0.42 * unit
        }

        // ---- rf98 art 3: HEAD/TAIL LIGHTS - the neon board (Canvas)
        Canvas {
            id: boardArt
            visible: tile.art === 3
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.top: parent.top
            anchors.margins: 0.12 * unit
            height: parent.height - 1.0 * unit
            property real t: 0
            readonly property bool live: visible && tile.lit && Qt.application.state === Qt.ApplicationActive
            onLiveChanged: requestPaint()
            onWidthChanged: requestPaint()
            onHeightChanged: requestPaint()
            Connections { target: tile; function onLitChanged() { boardArt.requestPaint(); } }
            Timer {
                interval: 40
                repeat: true
                running: boardArt.live
                onTriggered: { boardArt.t += 0.04; boardArt.requestPaint(); }
            }
                // rf98: HEAD/TAIL LIGHTS tile art - the neon board, its lights fading
                // between neon (purple tail / green nose) and regular (red tail / white
                // head), the fade sweeping left to right. Coordinates from the 1774x887 art.
                function drawBoardArt(c, w, h, t, lit) {
                    c.clearRect(0, 0, w, h);
                    var sc = Math.min(w / 1774, h / 887), ox = (w - 1774 * sc) / 2, oy = (h - 887 * sc) / 2;
                    var X = function(x) { return ox + x * sc; }, Y = function(y) { return oy + y * sc; };
                    var mixc = function(a, b, k) { return [a[0] + (b[0] - a[0]) * k, a[1] + (b[1] - a[1]) * k, a[2] + (b[2] - a[2]) * k]; };
                    var css = function(v, a) { return "rgba(" + Math.round(v[0]) + "," + Math.round(v[1]) + "," + Math.round(v[2]) + "," + a + ")"; };
                    var green = [57, 255, 60], purple = [176, 40, 255], red = [255, 40, 60], white = [240, 248, 255];
                    // fade 0 (neon) -> 1 (regular) and back, the left end first
                    var ph = function(lag) { var p = (t / 7 - lag) % 1; if (p < 0) p += 1; return p < 0.35 ? 0 : p < 0.5 ? (p - 0.35) / 0.15 : p < 0.85 ? 1 : 1 - (p - 0.85) / 0.15; };
                    var kl = ph(0), kr = ph(0.06);
                    var lc = lit ? mixc(purple, red, kl) : [90, 60, 140], rc = lit ? mixc(green, white, kr) : [90, 60, 140];
                    var line = lit ? green : [110, 70, 170];
                    c.lineJoin = "round"; c.lineCap = "round";
                    // ground glow
                    if (lit) {
                        var g = c.createLinearGradient(X(150), 0, X(1650), 0);
                        g.addColorStop(0, css(lc, 0)); g.addColorStop(0.15, css(lc, 0.75)); g.addColorStop(0.28, css(mixc(lc, line, 0.5), 0.6));
                        g.addColorStop(0.5, css(line, 0.75)); g.addColorStop(0.85, css(rc, 0.75)); g.addColorStop(1, css(rc, 0));
                        c.strokeStyle = g; c.lineWidth = Math.max(2, 14 * sc); c.shadowColor = css(line, 0.8); c.shadowBlur = 30 * sc;
                        c.beginPath(); c.moveTo(X(150), Y(710)); c.lineTo(X(1650), Y(710)); c.stroke();
                        // beams / glows at the ends
                        var gl = c.createRadialGradient(X(225), Y(470), 0, X(225), Y(470), 260 * sc);
                        gl.addColorStop(0, css(lc, 0.85)); gl.addColorStop(1, css(lc, 0));
                        c.shadowBlur = 0; c.fillStyle = gl;
                        c.beginPath(); c.moveTo(X(260), Y(450)); c.lineTo(X(0), Y(380)); c.lineTo(X(0), Y(560)); c.closePath(); c.fill();
                        var gr = c.createRadialGradient(X(1550), Y(462), 0, X(1550), Y(462), 220 * sc);
                        gr.addColorStop(0, css(rc, 0.75)); gr.addColorStop(1, css(rc, 0));
                        c.fillStyle = gr; c.beginPath(); c.arc(X(1550), Y(462), 220 * sc, 0, 2 * Math.PI); c.fill();
                    }
                    c.lineWidth = Math.max(1.5, 7 * sc);
                    c.shadowColor = css(line, 0.9); c.shadowBlur = lit ? 22 * sc : 0;
                    c.strokeStyle = css(line, 1);
                    // wheel
                    c.beginPath(); c.arc(X(880), Y(460), 252 * sc, 0, 2 * Math.PI); c.stroke();
                    c.beginPath(); c.arc(X(880), Y(460), 145 * sc, 0, 2 * Math.PI); c.stroke();
                    // deck (filled dark so it hides the wheel behind it)
                    var p = [[218, 390], [290, 382], [405, 406], [592, 406], [615, 432], [1158, 432], [1180, 406], [1335, 406], [1450, 376],
                             [1545, 372], [1560, 388], [1558, 418], [1452, 507], [330, 507], [220, 442]];
                    c.beginPath(); c.moveTo(X(p[0][0]), Y(p[0][1]));
                    for (var i = 1; i < p.length; i++) c.lineTo(X(p[i][0]), Y(p[i][1]));
                    c.closePath();
                    c.shadowBlur = 0; c.fillStyle = "#06030d"; c.fill();
                    c.shadowBlur = lit ? 22 * sc : 0; c.stroke();
                    c.beginPath(); c.moveTo(X(232), Y(432)); c.lineTo(X(1548), Y(432)); c.stroke();
                    // light strips
                    c.lineWidth = Math.max(2, 10 * sc);
                    c.strokeStyle = css(lit ? mixc(lc, white, 0.55) : lc, 1); c.shadowColor = css(lc, 1); c.shadowBlur = lit ? 30 * sc : 0;
                    c.beginPath(); c.moveTo(X(224), Y(452)); c.lineTo(X(288), Y(490)); c.stroke();
                    c.strokeStyle = css(lit ? mixc(rc, white, 0.55) : rc, 1); c.shadowColor = css(rc, 1);
                    c.beginPath(); c.moveTo(X(1490), Y(488)); c.lineTo(X(1553), Y(440)); c.stroke();
                    c.shadowBlur = 0;
                }

            onPaint: drawBoardArt(getContext("2d"), width, height, t, tile.lit)
        }

        // ---- rf136 art 4: STATUS BAR (Refloat view) - the board's front (the
        // user's neon drawing) with its status bar playing Refloat's Status Idle
        // animation (or the battery gauge) on ten LEDs. Coordinates from the
        // 1254x1254 art.
        Canvas {
            id: statusArt
            visible: tile.art === 4
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.top: parent.top
            anchors.margins: 0.12 * unit
            height: parent.height - 1.0 * unit
            property real t: 0
            readonly property bool live: visible && tile.lit && Qt.application.state === Qt.ApplicationActive
            onLiveChanged: requestPaint()
            onWidthChanged: requestPaint()
            onHeightChanged: requestPaint()
            Connections { target: tile; function onLitChanged() { statusArt.requestPaint(); } }
            Timer {
                interval: 40
                repeat: true
                running: statusArt.live
                onTriggered: { statusArt.t += 0.04; statusArt.requestPaint(); }
            }
            function rgbOf(i) {  // Refloat color index -> [r, g, b] (BLACK = off)
                if (i === 0) return [0, 0, 0];
                var q = ledSender.rfQColor(i);
                return [q.r * 255, q.g * 255, q.b * 255];
            }
            function hue(h) { var q = Qt.hsla(((h % 1) + 1) % 1, 1, 0.5, 1); return [q.r * 255, q.g * 255, q.b * 255]; }
            function mix(a, b, k) { return [a[0] + (b[0] - a[0]) * k, a[1] + (b[1] - a[1]) * k, a[2] + (b[2] - a[2]) * k]; }
            // one LED (i of n) of Refloat's Status Idle animation at time t (approximate)
            function led(i, n, t) {
                if (!ledSender.rfOn) {  // battery display: drains, blinks red near the end, refills
                    var p = (t / 6) % 1, lv = Math.max(0, 1 - p / 0.8), blink = Math.floor(t * 4) % 2 === 0;
                    var x = (i + 0.5) / n;
                    if (x > lv) return lv <= 0 && blink ? [120, 0, 20] : [0, 0, 0];
                    var c = lv > 0.5 ? [57, 255, 60] : lv > 0.25 ? [255, 230, 40] : [255, 40, 60];
                    return lv < 0.25 && !blink ? mix(c, [0, 0, 0], 0.7) : c;
                }
                var c1 = rgbOf(ledSender.rfColor1), c2 = rgbOf(ledSender.rfColor2), f = Math.max(0.1, ledSender.rfSpeed), ph = t * f;
                switch (ledSender.rfMode) {
                case 1: return mix(c1, c2, (Math.sin(ph * 2 * Math.PI) + 1) / 2);  // FADE
                case 2: return mix(c2, c1, Math.pow((Math.sin(ph * 2 * Math.PI) + 1) / 2, 2));  // PULSE
                case 3: return (ph * 4) % 1 < 0.5 ? c1 : c2;  // STROBE
                case 4: {  // KNIGHT RIDER
                    var pos = (n - 1) * (1 - Math.abs(((ph * 0.8) % 2) - 1));
                    return mix(c2, c1, Math.max(0, 1 - Math.abs(i - pos) / 1.6));
                }
                case 5: {  // FELONY: halves flashing
                    var side = i < n / 2, on = Math.floor(ph * 6) % 2 === 0;
                    return side === on ? c1 : c2;
                }
                case 6: return hue(ph * 0.25);  // RAINBOW CYCLE
                case 7: return mix(hue(ph * 0.25), [0, 0, 0], (1 - Math.cos(ph * 2 * Math.PI)) * 0.25);  // RAINBOW FADE
                case 8: return hue(ph * 0.25 + i / n);  // RAINBOW ROLL
                default: return c1;  // SOLID
                }
            }
            function drawStatusArt(c, w, h, t, lit) {
                c.clearRect(0, 0, w, h);
                // the drawing spans x 165..1085, y 170..1070
                var sc = Math.min(w / 940, h / 920), ox = (w - 940 * sc) / 2 - 155 * sc, oy = (h - 920 * sc) / 2 - 160 * sc;
                var X = function(x) { return ox + x * sc; }, Y = function(y) { return oy + y * sc; };
                var css = function(v, a) { return "rgba(" + Math.round(v[0]) + "," + Math.round(v[1]) + "," + Math.round(v[2]) + "," + a + ")"; };
                var green = lit ? [57, 255, 60] : [110, 70, 170];
                c.lineJoin = "round"; c.lineCap = "round";
                // outline: rounded top, straight sides, the curved bottom edge with the two feet
                c.beginPath();
                c.moveTo(X(176), Y(1040));
                c.lineTo(X(176), Y(340));
                c.quadraticCurveTo(X(176), Y(188), X(330), Y(186));
                c.quadraticCurveTo(X(625), Y(180), X(918), Y(186));
                c.quadraticCurveTo(X(1072), Y(190), X(1072), Y(340));
                c.lineTo(X(1078), Y(1040));
                c.quadraticCurveTo(X(1062), Y(1062), X(1040), Y(1062));
                c.quadraticCurveTo(X(1012), Y(1062), X(1000), Y(1030));
                c.quadraticCurveTo(X(990), Y(1018), X(960), Y(1014));
                c.quadraticCurveTo(X(625), Y(985), X(290), Y(1014));
                c.quadraticCurveTo(X(258), Y(1018), X(250), Y(1030));
                c.quadraticCurveTo(X(238), Y(1062), X(210), Y(1062));
                c.quadraticCurveTo(X(186), Y(1062), X(176), Y(1040));
                c.lineWidth = Math.max(1.5, 9 * sc);
                c.strokeStyle = css(green, 1);
                c.shadowColor = css(green, 0.9); c.shadowBlur = lit ? 26 * sc : 0;
                c.stroke();
                c.lineWidth = Math.max(1, 5 * sc);
                c.beginPath(); c.arc(X(210), Y(1033), 14 * sc, 0, 2 * Math.PI); c.stroke();
                c.beginPath(); c.arc(X(1037), Y(1033), 14 * sc, 0, 2 * Math.PI); c.stroke();
                // the status bar: a purple light pipe with ten LEDs behind it
                var x0 = 445, x1 = 800, yb = 950, n = 10, segW = (x1 - x0) / n;
                c.shadowBlur = 0;
                c.lineWidth = Math.max(2, 34 * sc);
                c.strokeStyle = lit ? "rgba(140,40,230,0.55)" : "rgba(80,50,130,0.6)";
                c.beginPath(); c.moveTo(X(x0), Y(yb)); c.lineTo(X(x1), Y(yb)); c.stroke();
                c.shadowColor = "rgba(176,40,255,0.9)"; c.shadowBlur = lit ? 50 * sc : 0; c.stroke(); c.shadowBlur = 0;
                for (var i = 0; i < n; i++) {
                    var col = lit ? led(i, n, t) : [40, 26, 70];
                    var on = col[0] + col[1] + col[2] > 30;
                    c.fillStyle = css(on ? col : [24, 14, 40], 1);
                    c.shadowColor = css(col, 1); c.shadowBlur = lit && on ? 60 * sc : 0;
                    var sx = X(x0 + i * segW + 3), sw = Math.max(1, (segW - 6) * sc), sy = Y(yb - 13), sh = Math.max(1, 26 * sc);
                    c.fillRect(sx, sy, sw, sh);
                }
                c.shadowBlur = 0;
            }
            onPaint: drawStatusArt(getContext("2d"), width, height, t, tile.lit)
        }

        // ---- rf92 art: status bar - ten LEDs filling up like the battery bar
        Row {
            id: barArt
            visible: tile.art === 2
            anchors.left: parent.left
            anchors.top: parent.top
            anchors.leftMargin: 0.22 * unit
            anchors.topMargin: 0.35 * unit
            spacing: 0.06 * unit
            property real level: 0
            SequentialAnimation on level {
                running: barArt.visible && tile.lit && Qt.application.state === Qt.ApplicationActive
                loops: Animation.Infinite
                NumberAnimation { from: 0; to: 1; duration: 1600; easing.type: Easing.OutCubic }
                PauseAnimation { duration: 900 }
                NumberAnimation { to: 0.8; duration: 500 }
                PauseAnimation { duration: 700 }
            }
            Repeater {
                model: 10
                Rectangle {
                    readonly property bool on: tile.lit && (index + 0.5) / 10 <= barArt.level
                    width: 0.13 * unit
                    height: 0.3 * unit
                    radius: 0.04 * unit
                    color: !on ? "#21143a" : index < 2 ? "#ff2b4f" : index < 4 ? "#f5ff3b" : swTheme.neonGreen
                    border.color: tile.lit ? "#3d2a63" : swTheme.neonPurple
                    border.width: 1
                }
            }
        }
        Rectangle {
            visible: tile.swatch.a > 0
            anchors.right: parent.right
            anchors.top: parent.top
            anchors.margins: 0.22 * unit
            width: 0.3 * unit; height: width; radius: width / 2
            color: tile.swatch
        }
        Rectangle {
            visible: tile.slcmOnly
            anchors.right: parent.right
            anchors.top: parent.top
            anchors.topMargin: 0.2 * unit
            anchors.rightMargin: tile.swatch.a > 0 ? 0.65 * unit : 0.2 * unit
            width: slcmBadge.implicitWidth + 0.2 * unit
            height: 0.34 * unit
            radius: height / 2
            color: "transparent"
            border.width: 1
            border.color: slcmDetect.present ? swTheme.neonGreen : "#FFB300"
            Text {
                id: slcmBadge
                anchors.centerIn: parent
                text: "SLCM"
                color: parent.border.color
                font.family: "Exan"
                font.pixelSize: 0.16 * unit
            }
        }
        Text {
            anchors.right: parent.right
            anchors.bottom: parent.bottom
            anchors.margins: 0.14 * unit
            text: "\u203A"
            color: swTheme.neonPurple
            font.pixelSize: 0.4 * unit
        }
        Column {
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.bottom: parent.bottom
            anchors.leftMargin: 0.18 * unit
            anchors.rightMargin: 0.4 * unit
            anchors.bottomMargin: 0.16 * unit
            spacing: 0.04 * unit
            Text {
                width: parent.width
                text: tile.title
                color: swTheme.neonGreen
                font.family: "Exan"
                font.pixelSize: 0.27 * unit
                elide: Text.ElideRight
            }
            Text {
                width: parent.width
                text: tile.summary
                color: "#ead6ff"
                font.pixelSize: 0.17 * unit
                wrapMode: Text.WordWrap
                maximumLineCount: 2
                elide: Text.ElideRight
            }
        }
        MouseArea {
            id: tileArea
            anchors.fill: parent
            onClicked: tile.clicked()
        }
    }

    // Refloat Glow: label + [down] value [up] stepper with hold-to-repeat
    // Refloat Glow: an LED animation's name drawn the way the status
    // bar plays it: each letter is an "LED" (rainbow, red scanner, fire...),
    // with a glow from a blurred copy of the letters. Mirrors status_leds.c.
    component AnimName : Item {
        id: an
        property int anim: 0
        property string text: ""
        property real hue: 0  // personal color (degrees)
        property var rf: null  // anim 15: {mode, c1, c2, speed} of a Refloat light bar (else the Status Idle animation)
        property real basePixelSize: 0.32 * unit
        property real t: 0
        readonly property real pixelSize: Math.max(0.14 * unit,
            basePixelSize * Math.min(1, (width - 0.1 * unit) / Math.max(1, anTm.advanceWidth)))

        TextMetrics { id: anTm; font.family: "Exan"; font.pixelSize: an.basePixelSize; text: an.text }

        Timer {
            interval: 50
            repeat: true
            running: an.visible && an.anim > 0
            onTriggered: an.t = (an.t + 0.05) % 600
        }

        // brightness of a scanner spot at c (0..1) seen from letter position x
        function spot(x, c) { return Math.max(0.3, 1 - Math.abs(x - c) * 3.2); }
        function sweep(t, period) { return 0.5 - 0.5 * Math.cos(2 * Math.PI * t / period); }
        function frac(v) { return v - Math.floor(v); }

        // rf125: BATTERY (Refloat view): a gauge draining full -> empty, green ->
        // yellow -> red, blinking red near the end, then refilling (6 s loop)
        function batteryCol(x, t) {
            var p = frac(t / 6), lv = Math.max(0, 1 - p / 0.8);
            var low = lv < 0.25, blink = Math.floor(t * 4) % 2 === 0;
            var hc = lv > 0.5 ? 0.33 : lv > 0.25 ? 0.14 : 0;
            if (x > lv || lv <= 0) {
                return lv <= 0 ? Qt.hsla(0, 1, 0.5, blink ? 0.55 : 0.12) : Qt.rgba(0.92, 0.84, 1, 0.16);
            }
            return Qt.hsla(hc, 1, 0.5, low && !blink ? 0.25 : 1);
        }

        function col(i, n, t) {
            var x = n > 1 ? i / (n - 1) : 0.5, h = 0, l = 0.6, a = 1, sat = 1, hu = an.hue / 360;
            var m = Math.abs(x - 0.5) * 2;  // 0 centre .. 1 ends
            switch (an.anim) {
            case 1:  // RAINBOW SCAN: one spot sweeping, its hue cycling
                h = 1 - frac(t / 3); a = spot(x, sweep(t, 2)); break;
            case 2:  // RAINBOW MIRROR: rainbow mirrored from the centre, flowing
                h = frac(m * 0.8 + t / 1.5); break;
            case 3:  // KNIGHT RIDER: red scanner
                h = 0; l = 0.5; a = spot(x, sweep(t, 2)); break;
            case 4:  // RAINBOW BAR: full rainbow across, scrolling
                h = frac(x - t / 1.0); break;
            case 5: {  // THE FUZZ: red / blue strobes
                var ph = Math.floor(t / 0.5) % 2, k = frac(t / 0.5);
                h = ph ? 0.667 : 0; l = 0.55;
                a = (k < 0.5 && Math.floor(t * 16) % 2 === 0) ? 1 : 0.15;
                if ((x < 0.5) === (ph === 1)) a = Math.min(a, 0.35);
                break;
            }
            case 6: {  // FIRE: flickering red / orange / yellow
                var f = 0.5 + 0.5 * Math.sin(t * 9.1 + i * 2.3) * Math.sin(t * 5.7 + i * 1.7 + 1);
                h = 0.01 + 0.12 * f; l = 0.38 + 0.25 * f; a = 0.55 + 0.45 * f; break;
            }
            case 7:  // PULSE OUT: personal color from the centre out
                h = hu + 0.04 * Math.sin(t * 2); a = spot(m, frac(t / 1.4)); break;
            case 8:  // PULSE IN: from the ends in
                h = hu + 0.04 * Math.sin(t * 2); a = spot(m, 1 - frac(t / 1.4)); break;
            case 9:  // 120 SCROLL: personal color + 120 degrees, scrolling
                h = hu + (1 / 3) * (0.5 - 0.5 * Math.cos(2 * Math.PI * (x - t / 2))); break;
            case 10:  // COMP. WAVE: personal color and its opposite, mirrored
                h = hu + 0.5 * (0.5 - 0.5 * Math.cos(2 * Math.PI * (m - t / 2))); break;
            case 11:  // CLASSIC: fills with the personal color, left to right
                h = hu; a = x <= Math.min(1, frac(t / 6.5) * 6.5 / 5.5) ? 1 : 0.15; break;
            case 12:  // COLOR SCAN: personal color scanner
                h = hu; a = spot(x, sweep(t, 2)); break;
            case 13:  // BATTERY LEVEL: a gauge, white, filled to ~80 %
                return x <= 0.8 ? "#f4f0ff" : Qt.rgba(1, 1, 1, 0.22);
            case 14: {  // CUSTOM: an approximation of the SLCM's fill / scan engines
                var c = ledSender.custom();
                var scan = (c[0] & 1) === 1, cm = (c[0] >> 1) & 7, pat = (c[0] >> 4) & 7;
                var ha = c[2] * 2 / 360, hb = c[3] * 2 / 360;
                var cs = (c[4] + 1) * 0.05, ms = (c[5] + 1) * 0.05;
                var pos = scan ? 0.5 : (pat === 1 ? x : (pat === 2 ? m : 0));
                var k = cm === 0 ? frac(pos + t / cs) : cm === 1 ? frac(pos - t / cs)
                    : cm === 2 ? 0.5 - 0.5 * Math.cos(2 * Math.PI * (t / cs + pos * 0.5))
                    : (Math.floor(t / cs + pos) % 2);
                h = cm === 4 ? hu : (cm === 3 ? (k ? hb : ha) : ha + (hb - ha) * k);
                if (scan) {
                    var u = frac(t / ms);
                    var p = pat === 0 ? u : pat === 1 ? 1 - u : pat === 2 ? 0.5 + 0.5 * u : pat === 3 ? 1 - 0.5 * u
                        : pat === 4 ? u : pat === 5 ? 1 - u : sweep(t, ms * 2);
                    var xx = pat === 2 || pat === 3 ? 0.5 + Math.abs(x - 0.5) : x;
                    a = pat === 4 ? (x <= p ? 1 : 0.15) : pat === 5 ? (x >= p ? 1 : 0.15) : spot(xx, p);
                } else if (c[1] === 1) {
                    a = c[6] / 255 + (1 - c[6] / 255) * (0.5 - 0.5 * Math.cos(2 * Math.PI * t / ms));
                } else if (c[1] === 2) {
                    a = frac(t / ms) < 0.5 ? 1 : Math.max(0.12, c[6] / 255);
                }
                break;
            }
            case 15: {  // Refloat's Status Idle animation (approximation)
                // rf112: snooze looks: -2 breathe, -3 dim, -4 dark (and -1 battery / normal)
                if (an.rf && an.rf.mode <= -2) {
                    var wa = an.rf.mode === -2 ? 0.2 + 0.8 * (0.5 - 0.5 * Math.cos(2 * Math.PI * t / 4)) : an.rf.mode === -3 ? 0.4 : 0.15;
                    return Qt.rgba(0.92, 0.84, 1, wa);
                }
                if ((!an.rf && !ledSender.rfOn) || (an.rf && an.rf.mode < 0))  // battery display
                    return an.text.indexOf("BATTERY") === 0 ? batteryCol(x, t) : an.text === "OFF" ? "#5c5470" : "#ead6ff";
                var c1 = ledSender.rfQColor(an.rf ? an.rf.c1 : ledSender.rfColor1), c2 = ledSender.rfQColor(an.rf ? an.rf.c2 : ledSender.rfColor2);
                var sp = Math.max(0.1, an.rf ? an.rf.speed : ledSender.rfSpeed), md = an.rf ? an.rf.mode : ledSender.rfMode;
                var mix = function(p) { return Qt.rgba(c1.r + (c2.r - c1.r) * p, c1.g + (c2.g - c1.g) * p, c1.b + (c2.b - c1.b) * p, 1); };
                var dim = function(cc, k) { return Qt.rgba(cc.r, cc.g, cc.b, Math.max(0.15, k)); };
                var has2 = (an.rf ? an.rf.c2 : ledSender.rfColor2) !== 0;  // rf92: black = dim, not invisible
                var c1black = (an.rf ? an.rf.c1 : ledSender.rfColor1) === 0;
                if (c1black && (md === 0 || !has2)) return "#5c5470";  // all black: shown dim grey
                if (md === 0) return c1;
                if (c1black) { var sw = c1; c1 = c2; c2 = sw; has2 = false; }
                if (md === 1) { var pf = 0.5 - 0.5 * Math.cos(2 * Math.PI * t * sp); return has2 ? mix(pf) : dim(c1, 1 - pf); }
                // rf91: PULSE / STROBE / KNIGHT RIDER show color 2 (background) unless it's black
                if (md === 2) { var kp = spot(m, frac(t * sp)); return has2 ? mix(1 - kp) : dim(c1, kp); }
                if (md === 3) return frac(t * sp * 2) < 0.5 ? c1 : (has2 ? c2 : dim(c1, 0));
                if (md === 4) { var kk = spot(x, sweep(t, 2 / sp)); return has2 ? mix(1 - kk) : dim(c1, kk); }
                if (md === 5) {
                    var fp = Math.floor(t * sp * 2) % 2;
                    var side = (x < 0.5) === (fp === 0), fl = Math.floor(t * 16) % 2 === 0 ? 1 : 0.2;
                    return side || has2 ? dim(side ? c1 : c2, fl) : dim(c1, 0.15);
                }
                if (md === 8) { h = frac(x - t * sp); break; }
                h = frac(t * sp / 3); break;
            }
            default:  // STANDARD (white) / OFF (dark)
                return an.text === "OFF" ? "#5c5470" : "#ead6ff";
            }
            return Qt.hsla(frac(h), sat, l, a);
        }

        Item {
            id: anLetters
            anchors.centerIn: parent
            width: anRow.implicitWidth
            height: anRow.implicitHeight

            Row {
                id: anRow
                Repeater {
                    model: an.text.length
                    Text {
                        text: an.text.charAt(index)
                        color: an.col(index, an.text.length, an.t)
                        font.family: "Exan"
                        font.pixelSize: an.pixelSize
                    }
                }
            }
        }

        // the glow: the same letters, blurred, behind
        FastBlur {
            z: -1
            anchors.fill: anLetters
            source: anLetters
            radius: 14
            transparentBorder: true
        }
    }

    // rf114: COLOR 1 / COLOR 2 (BACKGROUND + ON/OFF for one-color animations)
    // / SPEED for a Refloat animation, like the Status Idle settings
    component RfColorsBlock : Column {
        id: rcb
        property int mode: 0
        property int c1: 4
        property int c2: 0
        property real speed: 1
        signal setC1(int v)
        signal setC2(int v)
        signal setSpeed(real v)
        width: parent ? parent.width : 0
        spacing: 0.14 * unit
        SwStepper {
            visible: rcb.mode < 6
            label: "COLOR 1"
            valueWidth: 3.2 * unit
            value: rcb.c1
            from: 0; to: 29; step: 1
            valueText: ledSender.rfColors[value]
            valueColor: ledSender.rfTextColor(value)
            sideArrows: true
            onMoved: rcb.setC1(ledSender.rfColorNext(value, newValue > value ? 1 : -1))
        }
        SwStepper {
            visible: rcb.mode >= 1 && rcb.mode <= 5
            label: rcb.mode === 4 ? "BACKGROUND" : "COLOR 2"  // rf151: FADE / PULSE / STROBE say COLOR 2
            toggle: ledSender.oneColor(rcb.mode) ? (rcb.c2 !== 0 ? 1 : 0) : -1
            onToggleClicked: {
                if (rcb.c2 !== 0) { swSettings.rfBgLast = rcb.c2; rcb.setC2(0); }
                else rcb.setC2(swSettings.rfBgLast || 1);
            }
            valueWidth: 3.2 * unit
            value: rcb.c2
            from: 0; to: 29; step: 1
            valueText: ledSender.rfColors[value]
            valueColor: ledSender.rfTextColor(value)
            sideArrows: true
            onMoved: rcb.setC2(ledSender.rfColorNext(value, newValue > value ? 1 : -1))
        }
        SwStepper {
            visible: rcb.mode !== 0
            label: "SPEED"
            value: rcb.speed
            from: 0.1; to: 5; step: 0.1; decimals: 1; suffix: "/s"
            onMoved: rcb.setSpeed(Math.round(newValue * 10) / 10)
        }
    }

    component SwStepper : Item {
        id: stepper
        width: parent ? parent.width : 0
        height: 0.95 * unit

        property string label
        property real value
        property real from
        property real to
        property real step: 1
        property int decimals: 0
        property string suffix: ""
        property string valueText: ""  // overrides the number if set
        property color valueColor: swTheme.neonGreen
        property real valueWidth: 2.1 * unit  // wider for names (animations)
        property bool animName: false  // draw valueText as an LED animation (AnimName)
        // Refloat animation as the value (AnimName anim 15): rfAnim for the
        // Status Idle animation, rf = {mode, c1, c2, speed} for a light bar
        property bool rfAnim: false
        property bool sideArrows: false  // rf123: left / right arrows (colors)
        property var rf: null
        // the animation itself is the selector: no label, [down] NAME [up]
        // across the full width
        property bool bigName: false
        signal moved(real newValue)
        property bool editable: false  // rf160: tap the value to type it (numPad)
        signal valueClicked()
        // rf101: optional ON / OFF switch between the label and the arrows
        // (-1 = none, 0 off, 1 on), e.g. the background color
        property int toggle: -1
        signal toggleClicked()

        function nudge(dir) {
            var v = Math.round((value + dir * step) / step) * step;
            v = Math.max(from, Math.min(to, v));
            if (v !== value) moved(v);
        }

        SwNeonLabel {
            visible: !stepper.bigName
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter
            width: parent.width - stepper.valueWidth - 2.5 * unit - (stepper.toggle >= 0 ? 1.3 * unit : 0)
            font.pixelSize: 0.28 * unit
            text: stepper.label
        }

        Rectangle {
            visible: stepper.toggle >= 0 && !stepper.bigName
            anchors.verticalCenter: parent.verticalCenter
            anchors.right: parent.right
            anchors.rightMargin: stepper.valueWidth + 2.55 * unit
            width: 1.1 * unit
            height: 0.5 * unit
            radius: height / 2
            color: stepper.toggle === 1 ? swTheme.neonGreen : "transparent"
            border.color: stepper.toggle === 1 ? swTheme.neonGreen : swTheme.neonPurple
            border.width: 2
            Text {
                anchors.centerIn: parent
                text: stepper.toggle === 1 ? "ON" : "OFF"
                color: stepper.toggle === 1 ? swTheme.background : swTheme.neonPurple
                font.family: "Exan"
                font.pixelSize: 0.2 * unit
            }
            MouseArea { anchors.fill: parent; anchors.margins: -0.1 * unit; onClicked: stepper.toggleClicked() }
        }

        Row {
            anchors.right: stepper.bigName ? undefined : parent.right
            anchors.horizontalCenter: stepper.bigName ? parent.horizontalCenter : undefined
            anchors.verticalCenter: parent.verticalCenter
            spacing: 0.1 * unit

            Repeater {
                model: [-1, 0, 1]

                Item {
                    width: modelData !== 0 ? 1.1 * unit
                        : stepper.bigName ? stepper.width - 2.4 * unit : stepper.valueWidth
                    height: 0.8 * unit

                    AnimName {
                        visible: modelData === 0 && (stepper.animName || stepper.rfAnim || !!stepper.rf)
                        anchors.fill: parent
                        anim: stepper.rfAnim || stepper.rf ? 15 : stepper.value
                        rf: stepper.rf
                        text: stepper.valueText
                        hue: swSettings.ledColor
                        basePixelSize: stepper.bigName ? 0.4 * unit : 0.32 * unit
                    }

                    Text {
                        visible: modelData === 0 && !stepper.animName && !stepper.rfAnim && !stepper.rf
                        anchors.centerIn: parent
                        width: parent.width
                        horizontalAlignment: Text.AlignHCenter
                        fontSizeMode: Text.HorizontalFit
                        minimumPixelSize: 0.16 * unit
                        color: stepper.valueColor
                        font.family: "Exan"
                        font.pixelSize: 0.32 * unit
                        text: stepper.valueText !== "" ? stepper.valueText : stepper.value.toFixed(stepper.decimals) + stepper.suffix
                    }
                    // rf160: a typed value: dashed line under it, tap opens the number pad
                    Row {
                        visible: modelData === 0 && stepper.editable
                        anchors.horizontalCenter: parent.horizontalCenter
                        anchors.bottom: parent.bottom
                        spacing: 0.06 * unit
                        Repeater {
                            model: 6
                            Rectangle { width: 0.12 * unit; height: 2; color: swTheme.neonPurple }
                        }
                    }
                    MouseArea {
                        enabled: modelData === 0 && stepper.editable
                        anchors.fill: parent
                        onClicked: stepper.valueClicked()
                    }

                    Rectangle {
                        visible: modelData !== 0
                        anchors.fill: parent
                        radius: 0.15 * unit
                        property bool atLimit: modelData < 0 ? stepper.value <= stepper.from : stepper.value >= stepper.to
                        color: arrowMouse.pressed && !atLimit ? swTheme.neonPurple : "#140a26"
                        border.color: atLimit ? "#4a2a73" : swTheme.neonPurple
                        border.width: 2

                        // arrow
                        Canvas {
                            anchors.centerIn: parent
                            width: stepper.sideArrows ? 0.3 * unit : 0.4 * unit
                            height: stepper.sideArrows ? 0.4 * unit : 0.3 * unit
                            property bool up: modelData > 0
                            property color col: parent.atLimit ? "#4a2a73" : arrowMouse.pressed ? swTheme.background : swTheme.neonGreen
                            onColChanged: requestPaint()
                            onPaint: {
                                var ctx = getContext("2d");
                                ctx.reset();
                                ctx.beginPath();
                                if (stepper.sideArrows) {
                                    if (up) { ctx.moveTo(0, 0); ctx.lineTo(width, height / 2); ctx.lineTo(0, height); }
                                    else { ctx.moveTo(width, 0); ctx.lineTo(0, height / 2); ctx.lineTo(width, height); }
                                } else if (up) {
                                    ctx.moveTo(0, height); ctx.lineTo(width / 2, 0); ctx.lineTo(width, height);
                                } else {
                                    ctx.moveTo(0, 0); ctx.lineTo(width / 2, height); ctx.lineTo(width, 0);
                                }
                                ctx.closePath();
                                ctx.fillStyle = col;
                                ctx.fill();
                            }
                        }

                        MouseArea {
                            id: arrowMouse
                            anchors.fill: parent
                            onPressed: { stepper.nudge(modelData); repeatTimer.interval = 450; repeatTimer.start(); }
                            onReleased: repeatTimer.stop()
                            onCanceled: repeatTimer.stop()
                        }

                        Timer {
                            id: repeatTimer
                            repeat: true
                            onTriggered: { interval = 90; stepper.nudge(modelData); }
                        }
                    }
                }
            }
        }
    }

    // Refloat Glow: value over a neon label (or the engine symbol)
    component SwStat : Item {
        width: 1.7 * unit
        height: 0.95 * unit

        property string labelText
        property bool engineIcon: false
        property string unitText: ""
        property real value
        property real warningThreshold: 0
        property bool warn: !!warningThreshold && value > warningThreshold
        property bool fahrenheit: false  // value stays in °C; only the display converts
        readonly property real shownValue: fahrenheit ? value * 1.8 + 32 : value

        SwNeonValue {
            anchors.top: parent.top
            width: parent.width
            horizontalAlignment: Text.AlignHCenter
            color: parent.warn ? swTheme.color("red") : "#ead6ff"
            font.pixelSize: 0.4 * unit
            text: toFixed1Zero(parent.shownValue) + parent.unitText
        }

        SwNeonLabel {
            anchors.bottom: parent.bottom
            width: parent.width
            horizontalAlignment: Text.AlignHCenter
            visible: !parent.engineIcon
            text: parent.labelText
        }

        SwEngineIcon {
            anchors.bottom: parent.bottom
            anchors.horizontalCenter: parent.horizontalCenter
            width: 0.75 * unit
            height: 0.55 * unit
            visible: parent.engineIcon
            color: parent.warn ? swTheme.color("red") : "#c98bff"
        }
    }

    component FloatingToolButton : RoundButton {
        id: button
        anchors.margins: 4
        width: unit
        height: unit
        padding: 0
        leftInset: 0
        rightInset: 0
        topInset: 0
        bottomInset: 0

        property Path iconPath
        property Path fillIconPath
        property real iconSize: width * 0.7
        property color strokeColor: Utility.getAppHexColor("normalText")
        property color fillColor: Utility.getAppHexColor("normalText")
        property color bgColor: Utility.getAppHexColor("darkBackground")
        property var customBgColor
        property real iconLineWidth: 2
        property color iconGlowColor: "transparent"
        property real iconGlowBlur: 0

        onIconPathChanged: iconCanvas.requestPaint()
        onStrokeColorChanged: iconCanvas.requestPaint()
        onFillColorChanged: iconCanvas.requestPaint()
        onFillIconPathChanged: iconCanvas.requestPaint()

        contentItem: Item {
            Canvas {
                id: iconCanvas
                anchors.centerIn: parent
                implicitWidth: iconSize
                implicitHeight: iconSize
                contextType: "2d"

                onPaint: {
                    var context = getContext("2d");
                    context.reset();
                    if (iconPath) {
                        context.lineCap = "round";
                        context.lineJoin = "round";
                        iconPath.scale = Qt.size(iconSize / 50, iconSize / 50);
                        context.path = iconPath;
                        // Refloat Glow: soft halo as a wide translucent stroke (crisper
                        // than canvas shadowBlur), then the sharp line on top
                        if (button.iconGlowBlur > 0 && button.iconGlowColor.a > 0) {
                            context.strokeStyle = button.iconGlowColor;
                            context.globalAlpha = 0.28;
                            context.lineWidth = button.iconLineWidth * 3;
                            context.stroke();
                            context.globalAlpha = 1.0;
                        }
                        context.strokeStyle = button.strokeColor;
                        context.lineWidth = button.iconLineWidth;
                        context.stroke();
                    }
                    if (fillIconPath) {
                        context.fillStyle = button.fillColor;
                        fillIconPath.scale = Qt.size(iconSize / 50, iconSize / 50);
                        context.path = fillIconPath;
                        context.fill();
                    }
                }
            }
        }

        background: Rectangle {
            id: buttonBg
            radius: parent.width / 2
            opacity: 0.9

            color: button.customBgColor ?? button.bgColor

            states: [
                State {
                    name: "change"
                    when: button.pressed && !button.customBgColor
                    PropertyChanges {target: buttonBg; color: Utility.getAppHexColor("lightestBackground");}
                }
            ]

            transitions: Transition {
                ColorAnimation {property: "color"; duration: 200; easing.type: Easing.InOutCirc;}
            }
        }
    }

    component ToolButton : FloatingToolButton {
        anchors.margins: 0
        bgColor: Utility.getAppHexColor("normalBackground")
    }

    // Refloat Glow: Neon Future-style round button - dark core, neon purple ring
    // with a soft glow, glowing neon green icon. Flips to solid purple when pressed.
    component NeonToolButton : FloatingToolButton {
        id: neonButton
        anchors.margins: 0
        iconSize: width * 0.56
        iconLineWidth: 2.5
        strokeColor: pressed ? swTheme.background : swTheme.neonGreen
        iconGlowColor: pressed ? "transparent" : swTheme.neonGreen
        iconGlowBlur: 0.12 * unit

        background: Item {
            RectangularGlow {
                anchors.fill: neonRing
                glowRadius: 0.15 * unit
                spread: 0.15
                cornerRadius: neonRing.radius + glowRadius
                color: swTheme.neonPurple
                opacity: neonButton.pressed ? 0.9 : 0.45
            }

            Rectangle {
                id: neonRing
                anchors.fill: parent
                anchors.margins: 0.1 * unit
                radius: width / 2
                color: neonButton.pressed ? swTheme.neonPurple : swTheme.background
                border.color: swTheme.neonPurple
                border.width: 2

                Behavior on color {
                    ColorAnimation {duration: 150}
                }
            }
        }
    }

    component ToggleFloatingToolButton : FloatingToolButton {
        property bool autonomous: true
        property bool value: false

        property Path trueIconPath
        property Path falseIconPath
        property Path trueFillIconPath
        property Path falseFillIconPath

        iconPath: value ? trueIconPath : falseIconPath
        fillIconPath: value ? trueFillIconPath : falseFillIconPath

        onClicked: {
            if (autonomous) {
                value = !value;
            }
        }
    }

    component Dial : Item {
        id: dial

        property real lineWidth: width * 0.075
        property real maxValue
        property real minValue
        property real value
        property real topValue
        property real warnThresholdAbs: 0
        property bool allowNegative: false
        property string valueUnit: ""
        property real valueFontSize: fontSizeNormal

        property real valueAngle: value > 0 ? Math.min(360 * value / maxValue, 360) : Math.max(360 * value / -minValue, -360)
        property real topAngle: Math.min(360 * topValue / maxValue, 360)

        property real topAngleRads: topAngle * Math.PI / 180

        property real dialRadius: width * 0.3

        Behavior on value {
            NumberAnimation {
                easing.type: Easing.OutCirc
                duration: 100
            }
        }

        Behavior on topValue {
            NumberAnimation {
                easing.type: Easing.OutCirc
                duration: 100
            }
        }

        onValueAngleChanged: canvas.requestPaint();
        onTopAngleChanged: canvas.requestPaint();

        Canvas {
            id: canvas
            anchors.fill: parent

            contextType: "2d"

            Path {
                id: dialBackground

                PathAngleArc {
                    centerX: width * 0.5
                    centerY: centerX
                    radiusX: dialRadius + lineWidth * 0.5
                    radiusY: radiusX
                    startAngle: -270
                    sweepAngle: 360
                }
            }

            Path {
                id: topFill

                PathAngleArc {
                    centerX: width * 0.5
                    centerY: centerX
                    radiusX: dialRadius + lineWidth * 0.5
                    radiusY: radiusX
                    startAngle: -270
                    sweepAngle: topAngle
                }
            }

            Path {
                id: valueFill

                PathAngleArc {
                    centerX: width * 0.5
                    centerY: centerX
                    radiusX: dialRadius + lineWidth * 0.5
                    radiusY: radiusX
                    startAngle: -270
                    sweepAngle: valueAngle
                }
            }

            onPaint: {
                var context = getContext("2d");
                context.reset();
                context.lineWidth = lineWidth;
                context.strokeStyle = swTheme.color("lightBackground");
                context.path = dialBackground;
                context.stroke();

                if (!allowNegative) {
                    context.strokeStyle = swTheme.color("lightestBackground");
                    context.path = topFill;
                    context.stroke();
                }

                if (warnThresholdAbs > 0 && Math.abs(value) > warnThresholdAbs) {
                    context.strokeStyle = swTheme.color("orange");
                } else {
                    if (valueAngle > 0) {
                        context.strokeStyle = swTheme.color("lightAccent");
                    } else {
                        context.strokeStyle = swTheme.color("green");
                    }
                }

                context.path = valueFill;
                context.stroke();
            }
        }

        Rectangle {
            id: zeroMarker
            width: 1
            height: 1.3 * lineWidth
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.top: parent.verticalCenter
            anchors.topMargin: dialRadius
            z: 1
            color: swTheme.color("lightText")
        }

        Rectangle {
            id: topMarker
            width: 1
            height: 1.3 * lineWidth
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.top: parent.verticalCenter
            anchors.topMargin: dialRadius
            visible: !allowNegative && topAngle > 0
            z: 3
            color: swTheme.color("lightText")
            transform: Rotation {origin.x: 0; origin.y: -dialRadius; angle: topAngle}
            antialiasing: true
        }

        SwNeonValue {
            id: valueText
            anchors.centerIn: parent

            font.pixelSize: valueFontSize
            horizontalAlignment: Text.AlignHCenter
            text: round(parent.value)
        }

        SwNeonLabel {
            id: valueUnit
            anchors.left: valueText.right
            anchors.baseline: valueText.baseline
            anchors.leftMargin: 0.04 * unit

            text: parent.valueUnit
        }

        SwLText {
            id: topValueLabel
            anchors.centerIn: parent
            anchors.horizontalCenterOffset: -Math.sin(topAngleRads) * (dialRadius + lineWidth + font.pixelSize * 1.7)
            anchors.verticalCenterOffset: Math.cos(topAngleRads) * (dialRadius + lineWidth + font.pixelSize * 1.1)
            visible: !allowNegative && topAngle > 0
            z: 4
            font.pixelSize: fontSizeSmall
            text: toFixed1Zero(topValue)
        }
    }

    // Refloat Glow: digital Neon Future speedometer. Segmented neon arc for speed
    // (green, then purple, red at the top end), thin inner arc for duty, and
    // a big glowing digital readout in the middle.
    component NeonSpeedo : Item {
        id: speedo

        property real value: 0
        property real maxValue: 30
        property real duty: 0  // 0..1
        property real dutyWarn: 0.8
        property real erpm: 0
        property string unitText: ""
        property bool wheelslip: false
        property bool spinLimiting: false  // Refloat Glow

        property int segments: 40
        property real sweepDeg: 240
        property real radius: Math.max(unit, Math.min(width * 0.46, (height - 0.4 * unit) / 1.58))
        property real centerY: radius * 1.08 + 0.05 * unit

        Behavior on value {
            NumberAnimation {easing.type: Easing.OutCirc; duration: 100}
        }

        Behavior on duty {
            NumberAnimation {easing.type: Easing.OutCirc; duration: 100}
        }

        onValueChanged: speedoCanvas.requestPaint()
        onDutyChanged: speedoCanvas.requestPaint()
        onMaxValueChanged: speedoCanvas.requestPaint()

        Canvas {
            id: speedoCanvas
            anchors.fill: parent
            contextType: "2d"
            onWidthChanged: requestPaint()
            onHeightChanged: requestPaint()

            onPaint: {
                var ctx = getContext("2d");
                ctx.reset();

                var green = "#39ff7a";
                var purple = "#b14cff";
                var red = "#ff2b4f";
                var orange = "#ff8a1f";
                var dim = "#1d1238";

                var cx = width / 2;
                var cy = speedo.centerY;
                var R = speedo.radius;
                var sweep = speedo.sweepDeg * Math.PI / 180;
                var start = Math.PI / 2 + (2 * Math.PI - sweep) / 2;
                var n = speedo.segments;
                var frac = speedo.maxValue > 0 ? Math.max(0, Math.min(1, speedo.value / speedo.maxValue)) : 0;
                if (frac !== frac) frac = 0;

                var t = R * 0.17;
                var rSeg = R - t / 2;
                var gap = sweep / n * 0.25;
                var rDuty = R - t - R * 0.07;
                var rLabel = rDuty - R * 0.14;

                // outer guide line + ticks every 10%
                ctx.lineWidth = Math.max(1, R * 0.014);
                ctx.strokeStyle = purple;
                ctx.globalAlpha = 0.85;
                ctx.beginPath();
                ctx.arc(cx, cy, R * 1.05, start, start + sweep, false);
                ctx.stroke();
                for (var k = 0; k <= 10; k++) {
                    var ak = start + sweep * k / 10;
                    var r0 = R * 1.05;
                    var r1 = R * (k % 5 === 0 ? 1.13 : 1.09);
                    ctx.beginPath();
                    ctx.moveTo(cx + Math.cos(ak) * r0, cy + Math.sin(ak) * r0);
                    ctx.lineTo(cx + Math.cos(ak) * r1, cy + Math.sin(ak) * r1);
                    ctx.stroke();
                }
                ctx.globalAlpha = 1;

                // speed segments: unlit first, then a soft halo under the lit ones,
                // then the lit segments crisp on top
                var segCol = function(pos) { return pos < 0.7 ? green : pos < 0.9 ? purple : red; };
                for (var pass = 0; pass < 3; pass++) {
                    ctx.lineWidth = pass === 1 ? t + R * 0.07 : t;
                    ctx.globalAlpha = pass === 1 ? 0.22 : 1.0;
                    for (var i = 0; i < n; i++) {
                        var pos = (i + 0.5) / n;
                        var lit = pos <= frac;
                        if ((pass === 0) === lit) continue;
                        var a0 = start + sweep * i / n + gap / 2;
                        var a1 = start + sweep * (i + 1) / n - gap / 2;
                        ctx.beginPath();
                        ctx.arc(cx, cy, rSeg, a0, a1, false);
                        ctx.strokeStyle = lit ? segCol(pos) : dim;
                        ctx.stroke();
                    }
                }
                ctx.globalAlpha = 1.0;

                // duty arc
                ctx.lineWidth = Math.max(2, R * 0.045);
                ctx.strokeStyle = dim;
                ctx.beginPath();
                ctx.arc(cx, cy, rDuty, start, start + sweep, false);
                ctx.stroke();
                var d = Math.max(0, Math.min(1, speedo.duty));
                if (d === d && d > 0.002) {
                    var dcol = d >= 0.9 ? red : d >= speedo.dutyWarn ? orange : purple;
                    ctx.strokeStyle = dcol;
                    ctx.beginPath();
                    ctx.arc(cx, cy, rDuty, start, start + sweep * d, false);
                    var dutyW = ctx.lineWidth;
                    ctx.globalAlpha = 0.25;
                    ctx.lineWidth = dutyW * 2.6;
                    ctx.stroke();
                    ctx.globalAlpha = 1.0;
                    ctx.lineWidth = dutyW;
                    ctx.stroke();
                }

                // inner guide line
                ctx.lineWidth = Math.max(1, R * 0.01);
                ctx.strokeStyle = purple;
                ctx.globalAlpha = 0.35;
                ctx.beginPath();
                ctx.arc(cx, cy, rDuty - R * 0.06, start, start + sweep, false);
                ctx.stroke();
                ctx.globalAlpha = 1;

                // scale labels at 0, 25, 50, 75, 100 %
                ctx.fillStyle = "#7d68ab";
                ctx.font = Math.round(Math.max(9, R * 0.1)) + "px sans-serif";
                ctx.textAlign = "center";
                ctx.textBaseline = "middle";
                for (var j = 0; j <= 4; j++) {
                    var aj = start + sweep * j / 4;
                    ctx.fillText(Math.round(speedo.maxValue * j / 4), cx + Math.cos(aj) * rLabel, cy + Math.sin(aj) * rLabel);
                }
            }
        }

        Text {
            id: speedoWheelslip
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.bottom: speedoDigits.top
            color: swTheme.color("red")
            font.family: "Exan"
            font.pixelSize: Math.max(fontSizeSuperSmall, speedo.radius * 0.11)
            text: speedo.spinLimiting ? "SPIN LIMIT" : "WHEELSLIP"
            opacity: speedo.wheelslip ? 1 : 0

            Behavior on opacity {
                NumberAnimation {duration: speedo.wheelslip ? 200 : 1000; easing.type: Easing.OutExpo}
            }
        }

        Text {
            id: speedoDigits
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.verticalCenter: parent.top
            anchors.verticalCenterOffset: speedo.centerY - speedo.radius * 0.08
            color: "#d6ffe4"
            font.family: "Exan"
            font.pixelSize: speedo.radius * 0.5
            text: round(speedo.value)
        }

        Glow {
            anchors.fill: speedoDigits
            source: speedoDigits
            radius: Math.round(0.2 * unit)
            samples: 2 * radius + 1
            spread: 0.2
            color: swTheme.neonGreen
            opacity: 0.7
        }

        Column {
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.top: speedoDigits.bottom
            spacing: 0

            Text {
                anchors.horizontalCenter: parent.horizontalCenter
                color: swTheme.neonGreen
                font.family: "Exan"
                font.pixelSize: Math.max(fontSizeSuperSmall, speedo.radius * 0.12)
                text: speedo.unitText.toUpperCase()
            }

            SwDText {
                anchors.horizontalCenter: parent.horizontalCenter
                font.family: "monospace"
                font.pixelSize: Math.max(fontSizeSuperSmall, speedo.radius * 0.095)
                text: "%1 ERPM".arg(round(speedo.erpm))
            }

            Text {
                anchors.horizontalCenter: parent.horizontalCenter
                color: speedo.duty >= 0.9 ? "#ff2b4f" : speedo.duty >= speedo.dutyWarn ? "#ff8a1f" : swTheme.neonPurple
                font.family: "monospace"
                font.pixelSize: Math.max(fontSizeSuperSmall, speedo.radius * 0.095)
                text: "DUTY %1%".arg(round(speedo.duty * 100))
            }

        }
    }


    component BaseDialog : Dialog {
        id: baseDialog
        x: 10
        y: (parent.height / 2 - implicitHeight / 2) / (placeAtTop ? 2 : 1)
        implicitWidth: parent.width - 20

        property real fullHeight: parent.height - 20
        // place dialog at the top part of the screen, so that the phone
        // keyboard doesn't just exactly cover the buttons
        property bool placeAtTop: false
        property color titleColor: swTheme.neonGreen  // rf107: red for warnings
        // Refloat Glow: every dialog in the Neon Future look - dark
        // panel, purple neon frame, title in the digital font, green accents
        Material.theme: Material.Dark
        Material.accent: swTheme.neonGreen
        Material.foreground: "#ead6ff"
        Material.background: "#0b0718"

        background: Rectangle {
            color: "#0b0718"
            radius: 0.25 * unit
            border.color: swTheme.neonPurple
            border.width: 2
        }

        header: Item {
            visible: baseDialog.title !== ""
            implicitHeight: baseDialog.title !== "" ? dialogTitle.implicitHeight + 0.5 * unit : 0
            Text {
                id: dialogTitle
                color: baseDialog.titleColor
                anchors.centerIn: parent
                width: parent.width - 0.6 * unit
                horizontalAlignment: Text.AlignHCenter
                wrapMode: Text.WordWrap
                text: baseDialog.title.toUpperCase()
                font.family: "Exan"
                font.pixelSize: 0.36 * unit
                font.letterSpacing: 0.03 * unit
            }
            Rectangle {
                anchors.bottom: parent.bottom
                anchors.horizontalCenter: parent.horizontalCenter
                width: parent.width - 0.6 * unit
                height: 2
                color: swTheme.neonPurple
                opacity: 0.6
            }
        }

        modal: true
        focus: true
        closePolicy: Popup.CloseOnEscape
        parent: mainItem

        Overlay.modal: Rectangle {
            color: "#AA000000"
        }
    }

    component PlotData : QtObject {
        property int sampleSize: 0
        property var seriesIds
        property var series: []
        property var seriesSorted: []
        property var data: []
        property int ticksPerSecond
        // an offset added to timestamps if timestamps older than the last one
        // arrive, to ensure time is always increasing
        property real timeOffset: 0

        property var mins: []
        property var maxs: []
        property var scales: []

        property real timeStart
        property real timeEnd
        property real timeRange
        property real positiveRatio

        property int sampleNr: 0

        property bool initialized: true
        property bool dataReady: false

        signal dataUpdate
        signal scalesUpdate

        property var seriesMetaData
        property var seriesExtraColors
        // Static flags always added to data series, not part of the dynamic data series
        property var extraFlags: [
            "state.running",
            "state.wheelslip",
            "state.sat",
            "footpad.state",
        ]

        function reset() {
            sampleNr = 0;
            data = [];
            initialized = false;
            dataReady = false;
        }

        function init(seriesIds, ticksPerSec) {
            ticksPerSecond = ticksPerSec;
            initSeries(seriesIds, false);
        }

        function initSeries(ids, allVisible) {
            var smplSize = ids.length + extraFlags.length;
            sampleSize = smplSize;
            mins = Array(smplSize).fill(0);
            maxs = Array(smplSize).fill(0);
            scales = Array(smplSize).fill(1);

            if (arraysEqual(ids, seriesIds)) {
                initialized = true;
                return;
            }

            seriesIds = ids;
            var seriesMeta = seriesMetaData;

            var tmpMd = {};
            for (var i =0; i < seriesMeta.length; i++) {
                var sm = seriesMeta[i];
                var smDataCopy = Object.assign({}, sm[1]);
                tmpMd[sm[0]] = smDataCopy;
                smDataCopy.sortOrder = i + 100;
            }

            var srs = [];
            var srsSorted = [];
            var extrasOrder = 0;

            var push_series = function(id, i, visible) {
                var seriesMd = tmpMd[id] ?? {
                    "name": id,
                    "color": seriesExtraColors[extrasOrder],
                    "sortOrder": extrasOrder++,
                    "visible": true,
                };
                if (visible) {
                    seriesMd.visible = visible;
                }
                seriesMd.dataOrder = i;
                srs.push(seriesMd);
                srsSorted.push(seriesMd);
            }

            for (var i = 0; i < extraFlags.length; i++) {
                push_series(extraFlags[i], i, false);
            }

            for (var i = 0; i < ids.length; i++) {
                push_series(ids[i], i + extraFlags.length, !!allVisible);
            }

            srsSorted.sort((a, b) => a.sortOrder - b.sortOrder);
            series = srs;
            seriesSorted = srsSorted;
            initialized = true;
        }

        function addSample(sample, offset) {
            var sampleTime = sample[0] + timeOffset;
            var lastTime = data.length > 0 ? data[data.length - 1][0] : undefined;

            // only push sample if it's the next in row, assuming messages
            // can't change order, this should guarantee consistency
            //
            // also don't push if the timestamp is the same as that of the last
            // record, this can happen if two clients are connected to the same
            // VESC (they both poll for data and the messages get sent twice)
            if ((offset !== undefined && offset !== data.length) || lastTime === sampleTime) {
                return;
            }

            if (sampleTime < lastTime) {
                if (lastTime - sampleTime > 2 ** 31) {
                    // assume ticks have overflown
                    timeOffset = timeOffset + 2 ** 32;
                } else {
                    // a temporary disconnect (as of writing this code, doesn't
                    // normally occur without the AppUI being brought down)
                    timeOffset += lastTime + 10 * ticksPerSecond;
                }
            }

            if (timeOffset > 0) {
                sample[0] += timeOffset;
            }

            data.push(sample);

            for (var i = 0; i < sampleSize; i++) {
                if (sample[i + 1] > maxs[i]) {
                    maxs[i] = sample[i + 1];
                }
                if (sample[i + 1] < mins[i]) {
                    mins[i] = sample[i + 1];
                }
            }

            sampleNr = data.length;
        }

        function makeReady() {
            calculateRanges();
            dataReady = true;
            dataUpdate();
        }

        function calculateRanges() {
            if (data.length == 0) {
                return;
            }

            var lowestRatio = 1;
            var highestRatio = 0;
            var lMins = mins;
            var lMaxs = maxs;
            var srs = series;
            for (var i = 0; i < sampleSize; i++) {
                if (!srs[i].visible) {
                    continue;
                }

                if (lMaxs[i] > 1 || lMins[i] < -1) {
                    var ratio = clamp(lMaxs[i] / (lMaxs[i] - lMins[i]), 0, 1);
                    lowestRatio = Math.min(lowestRatio, ratio);
                    highestRatio = Math.max(highestRatio, ratio);
                }
            }

            var newRatio;
            if (lowestRatio < 0.5) {
                if (highestRatio > 0.5) {
                    newRatio = 0.5;
                } else {
                    newRatio = highestRatio;
                }
            } else {
                newRatio = lowestRatio;
            }

            positiveRatio = clamp(newRatio, 0.15, 0.85);

            var setScale = function(i, s) {
                if (s != scales[i]) {
                    scalesUpdate();
                }
                scales[i] = s;
            }

            var newScale;
            for (var i = 0; i < sampleSize; i++) {
                var minRatio = (1 - positiveRatio) / lMins[i];
                var maxRatio = positiveRatio / lMaxs[i];
                if (lMaxs[i] > 0) {
                    if (lMins[i] < 0) {
                        newScale = Math.min(maxRatio, -minRatio);
                    } else {
                        newScale = isFinite(maxRatio) ? maxRatio : 1;
                    }
                } else {
                    newScale = isFinite(minRatio) ? -minRatio : 1;
                }
                var rns = Math.min(newScale, srs[i].maxScale ?? 1);
                setScale(i, rns);
            }

            timeStart = data[0][0];
            timeEnd = data[data.length - 1][0];
            timeRange = timeEnd - timeStart;
        }
    }

    component RecordedPlotData : PlotData {
        id: recPlotData

        property bool noData: false
        property bool timeout: false

        property int sampleCount: 0
        property int requestTries: 0

        property Timer receiveTimeout: Timer {
            interval: 1000

            onTriggered: {
                recPlotData.requestPlot(true);
            }
        }

        function fetch(ticksPerSec) {
            reset();
            ticksPerSecond = ticksPerSec;
            noData = false;
            timeout = false;
            requestPlot();
        }

        function requestPlot(isARetry) {
            var reqTries = requestTries;

            if (!isARetry) {
                reqTries = 1;
            } else if (reqTries > 5) {
                timeout = true;
                return;
            }

            if (!initialized) {
                commands.sendDataRecordRequest(true);
            } else {
                commands.sendDataRecordRequest(false, sampleNr);
            }

            reqTries++;
            requestTries = reqTries;

            receiveTimeout.start();
        }

        function receiveHeader(dv, ind) {
            if (initialized) {
                // prevent processing messages in more than one AppUI instance
                return;
            }

            receiveTimeout.stop();

            sampleCount = dv.getUint32(ind); ind += 4;

            var sampleSize = dv.getUint8(ind++);
            var ids = [];
            for (var i = 0; i < sampleSize; i++) {
                var id = "";
                var size = dv.getUint8(ind++);
                for (var j = 0; j < size; j++) {
                    id += String.fromCharCode(dv.getUint8(ind++));
                }
                ids.push(id);
            }
            initSeries(ids, true);

            if (sampleCount === 0) {
                noData = true;
            } else {
                requestPlot();
            }
        }

        function receiveData(dv, ind) {
            receiveTimeout.stop();

            var offset = dv.getUint32(ind); ind += 4;

            var getFloat16 = commands.getFloat16;
            while (ind < dv.byteLength) {
                var time = dv.getUint32(ind); ind += 4;
                var flags = dv.getUint8(ind++);
                var sat = flags >> 4;
                var fp_state = (flags & 0b1100) >> 2;
                var wheelslip = (flags & 0b10) >> 1;
                var running = flags & 0b1;
                var data = [time, running, wheelslip, sat, fp_state];

                var remainingSampleSize = sampleSize - extraFlags.length;
                for (var i = 0; i < remainingSampleSize; i++) {
                    data.push(getFloat16(dv, ind)); ind += 2;
                }
                addSample(data, offset++);
            }

            if (sampleNr < sampleCount) {
                requestPlot();
            } else {
                makeReady();
            }
        }
    }

    component Plot : Rectangle {
        id: plot
        color: neon ? swTheme.background : "#0b0b0b"

        // Refloat Glow: neon axes / labels (series keep their own colors)
        property bool neon: false

        function themeColor(name) {
            return neon ? swTheme.color(name) : getDarkThemeColor(name);
        }

        property var plotData
        property int ticksPerSecond
        property bool followEnd: false
        property real startWindow: 10

        property real toolbarOffset: 0

        property bool showRecordDownload: false
        property int maxWindowMinutes
        property bool dotsEnabled: true

        function init(ticksPerSec) {
            ticksPerSecond = ticksPerSec;
            reset();
            // solves updating the plot (series) menu when the series in plotData have changed
            plotData = plotData;
        }

        function reset() {
            plotCanvas.reset();
        }

        function spawnCursor(cursorPos) {
            plotCanvas.spawnCursor(cursorPos);
        }

        function hideCursor() {
            plotCanvas.fadeCursor();
        }

        onVisibleChanged: {
            if (!visible) {
                menu.visible = false;
            }
        }

        Row {
            anchors.left: parent.left
            anchors.top: parent.top
            anchors.leftMargin: toolbarOffset * unit + 0.1 * unit
            anchors.topMargin: 0.1 * unit
            spacing: 0.1 * unit
            z: parent.z + 5

            FloatingToolButton {
                width: 0.8 * unit
                height: 0.8 * unit
                visible: plotData.initialized

                iconPath: Path {
                    PathSvg {path: "M 10 15 L 40 15 M 10 25 L 40 25 M 10 35 L 40 35"}
                }

                onClicked: {
                    menu.visible = !menu.visible;
                }
            }

            FloatingToolButton {
                width: 0.8 * unit
                height: 0.8 * unit
                visible: plot.showRecordDownload

                iconPath: Path {
                    PathSvg {path: "M 8 38 L 42 38 M 25 10 L 25 38 M 14 23 L 25 38 M 36 23 L 25 38"}
                }

                onClicked: {
                    recordedPlot.show();
                }
            }

            ToggleFloatingToolButton {
                width: 0.8 * unit
                height: 0.8 * unit
                visible: plot.showRecordDownload

                autonomous: false
                value: mainItem.state.extraRecording

                customBgColor: value ? Utility.getAppHexColor("red") : Utility.getAppHexColor("normalBackground")
                fillColor: value ? Utility.getAppHexColor("normalText") : Utility.getAppHexColor("red")

                trueFillIconPath: Path {
                    PathSvg {path: "M 13 13 L 13 37 L 37 37 L 37 13 L 13 13"}
                }

                falseFillIconPath: Path {
                    PathAngleArc {centerX: 25; centerY: 25; radiusX: 12; radiusY: 12; sweepAngle: 360;}
                }

                onClicked: {
                    commands.sendDataRecordControl(commands.dr_RECORD, !value);
                }

                onPressAndHold: {
                    recMenu.visible = true;
                }

                Menu {
                    id: recMenu

                    CheckBox {
                        text: "Autostart"
                        checkable: true
                        checked: mainItem.state.extraRecAutostart
                        onClicked: {
                            commands.sendDataRecordControl(commands.dr_AUTOSTART, checked);
                        }
                    }

                    CheckBox {
                        text: "Autostop"
                        checkable: true
                        checked: mainItem.state.extraRecAutostop
                        onClicked: {
                            commands.sendDataRecordControl(commands.dr_AUTOSTOP, checked);
                        }
                    }
                }
            }

//            FloatingToolButton {
//                width: 0.8 * unit
//                height: 0.8 * unit
//
//                iconPath: Path {
//                    PathAngleArc {centerX: 25; centerY: 25; radiusX: 12; radiusY: 12; startAngle: 45; sweepAngle: 270;}
//                }
//
//                onClicked: {
//                    colorPreview.show();
//                }
//            }
        }

        Rectangle {
            id: menu
            z: parent.z + 10
            anchors.top: parent.top
            anchors.left: parent.left
            anchors.topMargin: topMargin
            anchors.leftMargin: sideMargin
            height: menuScrollView.height
            width: menuScrollView.width
            visible: false

            property real topMargin: unit
            property real sideMargin: 0.2 * unit
            property real hPadding: 8
            property real vPadding: 4

            color: plot.themeColor("darkBackground");

            ScrollView {
                id: menuScrollView
                anchors.top: parent.top
                anchors.left: parent.left
                height: Math.min(contentHeight, plot.height - parent.topMargin - parent.sideMargin)
                width: menuColumn.width + 2 * menu.hPadding + 4
                contentWidth: availableWidth
                contentHeight: menuColumn.height + menu.vPadding
                clip: true

                Column {
                    id: menuColumn
                    anchors.top: parent.top
                    anchors.left: parent.left
                    anchors.topMargin: menu.vPadding * 0.5
                    spacing: 0

                    Repeater {
                        model: plotData.seriesSorted

                        Item {
                            width: menuRow.width
                            height: label.height + 2 * menu.vPadding

                            MouseArea {
                                anchors.top: parent.top
                                anchors.left: parent.left
                                width: menuColumn.width
                                height: parent.height
                                onClicked: itemCheckBox.toggle()
                            }

                            Row {
                                id: menuRow
                                anchors.left: parent.left
                                anchors.verticalCenter: parent.verticalCenter
                                anchors.leftMargin: menu.hPadding
                                spacing: 4

                                CheckBox {
                                    id: itemCheckBox
                                    height: label.height
                                    width: height

                                    checked: modelData.visible

                                    onCheckedChanged: {
                                        plot.plotData.seriesSorted[index].visible = checked;
                                        plot.plotData.calculateRanges();
                                        plotCanvas.requestPaint();
                                    }

                                    indicator: Rectangle {
                                        implicitHeight: parent.height * 0.9
                                        implicitWidth: implicitHeight
                                        y: parent.height / 2 - height / 2
                                        radius: 2
                                        color: "transparent"
                                        border.color: parent.checked ? plot.themeColor("lightText") : plot.themeColor("normalText")

                                        Rectangle {
                                            height: parent.height * 0.5
                                            width: height
                                            x: parent.width / 2 - width / 2
                                            y: parent.height / 2 - height / 2
                                            radius: 1
                                            color: parent.border.color
                                            visible: parent.parent.checked
                                        }
                                    }
                                }

                                Text {
                                    id: label
                                    text: modelData.name
                                    font.pointSize: 16
                                    color: modelData.color
                                }
                            }
                        }
                    }
                }
            }
        }

        PinchArea {
            anchors.fill: parent

            property real initialPlotWindow
            property real initialX
            property real lastScale

            onPinchStarted: {
                initialPlotWindow = plotCanvas.window;
                initialX = plotMouse.x(pinch.center);
                plotMover.grab();
            }

            onPinchUpdated: {
                plotMover.move(initialX - plotMouse.x(pinch.center), pinch.scale != lastScale);
                plotMover.zoom(initialPlotWindow / pinch.scale, plotMouse.x(pinch.center));
                lastScale = pinch.scale;
            }

            onPinchFinished: {
                plotMouse.release();
            }

            MouseArea {
                id: plotMouse
                anchors.fill: parent
                preventStealing: true

                property real initialX
                property real initialY

                property bool moving: false
                property bool holdCursor: false
                property bool moveCursor: false
                property bool cancelAction: false

                property real snap: 20

                function x(obj) {
                    return obj.x - plotCanvas.padding;
                }

                function dist2d(event) {
                    var dx = initialX - x(event);
                    var dy = initialY - event.y;
                    return Math.sqrt(dx * dx + dy * dy);
                }

                function release() {
                    moving = false;
                    holdCursor = false;
                    moveCursor = false;
                    cancelAction = false;
                    plotCanvas.fadeCursor(1);
                    plotMover.flick();
                }

                onWheel: {
                    if (!plotMover.grabbed) {
                        plotMover.grab();
                    }

                    plotMover.zoomAnimated(Math.max(0.75, 1 + wheel.angleDelta.y / 120 * 0.25), x(wheel));
                }

                onPressed: {
                    menu.visible = false;

                    initialX = x(mouse);
                    initialY = mouse.y;

                    var cursorPos = plotCanvas.getCursorPosIfCan();
                    if (plotMover.rolling) {
                        moving = true;
                    } else if (cursorPos !== null && dist(initialX, cursorPos) < snap) {
                        holdCursor = true;
                        return;
                    }

                    plotMover.grab();
                }

                onPositionChanged: {
                    if (cancelAction) {
                        return;
                    }

                    var d = initialX - x(mouse);
                    if (holdCursor) {
                        if (moveCursor) {
                            plotCanvas.spawnCursorCoord(x(mouse));
                        } else {
                            var yd = initialY - mouse.y;
                            var dist = Math.sqrt(yd * yd + d * d);
                            var angle = Math.acos(yd / dist);

                            // a cone of 30 degrees (15 to each side) or further than 10 pixels
                            if (angle > 0.2618 && dist > snap) {
                                if (yd > 30) {
                                    cancelAction = true;
                                } else {
                                    moveCursor = true;
                                }
                                plotCanvas.fadeCursor(1);
                                return;
                            }

                            plotCanvas.fadeCursor(clamp(1 - (yd - snap) / 100, 0, 1));
                        }
                    } else {
                        if (Math.abs(d) > snap) {
                            moving = true;
                        }
                        plotMover.move(d);
                    }
                }

                onReleased: {
                    release();
                }

                onPressAndHold: {
                    if (cancelAction) {
                        return;
                    }

                    if (!moving && (dist2d(mouse) < snap || !holdCursor)) {
                        holdCursor = true;
                        moveCursor = true;
                        plotCanvas.spawnCursorCoord(x(mouse));
                    }
                }
            }

            Canvas {
                id: plotCanvas
                anchors.centerIn: parent
                width: parent.width
                height: parent.height
                visible: plotData.dataReady
                contextType: "2d"

                property real position: NaN
                property real window

                property int padding: 8
                property int toolbarHeight: unit
                property int bottomHeight: 20

                property real length: width
                property real xLength: width - 2 * padding
                property real yLength: height - toolbarHeight - bottomHeight

                property var cursor: null
                property real cursorOpacity: 1

                // for hysteresis (to prevent blinking)
                property bool paintDotsHyst: false
                property real hystWindow

                Connections {
                    target: plotData

                    function onDataUpdate() {
                        if (isNaN(plotCanvas.position)) {
                            if (plot.followEnd) {
                                plotCanvas.position = plotData.timeEnd - plotCanvas.window;
                                plotMover.followPosition();
                            } else {
                                plotCanvas.position = plotData.timeStart;
                                plotCanvas.window = plotData.timeRange;
                            }
                        }

                        if (plot.followEnd && plotMover.following) {
                            plotMover.positionFollower = plotData.timeEnd - plotCanvas.window;
                        }
                    }

                    function onScalesUpdate() {
                        plotCanvas.requestPaint();
                    }
                }

                onVisibleChanged: requestPaint();
                onPositionChanged: requestPaint();
                onWindowChanged: requestPaint();
                onCursorChanged: requestPaint();
                onCursorOpacityChanged: requestPaint();

                QtObject {
                    id: plotMover

                    property real bounceOffset: 0.05
                    property real minWindow: 0.001 * plot.ticksPerSecond
                    property real maxWindow: Math.max(plot.followEnd ? plot.startWindow * plot.ticksPerSecond : 0, Math.min(plot.maxWindowMinutes * 60 * plot.ticksPerSecond, plotData.timeRange))

                    property real moveReferencePos
                    property real moveUnbluntedPos
                    property real animWin

                    property real zoomCenter

                    property real lastDist
                    property real lastTime
                    property real speed
                    property real zoomDampen
                    property real positionFollower
                    property real lastZoomCenter

                    property bool grabbed
                    property bool moving
                    property bool rolling
                    property bool following

                    onAnimWinChanged: {
                        zoom(animWin, zoomCenter);
                    }

                    onPositionFollowerChanged: {
                        if (following) {
                            plotCanvas.position = positionFollower;
                        }
                    }

                    Behavior on positionFollower {
                        id: positionFollowerBehavior
                        NumberAnimation {
                            easing.type: Easing.OutExpo
                            duration: 800
                        }
                    }

                    function followPosition() {
                        positionFollowerBehavior.enabled = false;
                        positionFollower = plotCanvas.position;
                        positionFollowerBehavior.enabled = true;
                        following = true;
                    }

                    function grab() {
                        moveReferencePos = plotCanvas.position;
                        animWin = plotCanvas.window;

                        lastDist = 0;
                        lastTime = 0;
                        speed = 0;

                        grabbed = true;
                        moving = false;
                        rolling = false;
                        following = false;

                        zoomAnim.stop();
                        bounceBack.stop();
                        bounceBackZoom.stop();
                    }

                    function release() {
                        if (grabbed) {
                            snapToBounds();
                        }
                        grabbed = false;
                    }

                    function blunt(x, a) {
                        return a * Math.exp(x / a) - a;
                    }

                    function moveRelative(pos, x) {
                        moveUnbluntedPos = plotCanvas.toPlotPos(pos, x);
                        var newPos = moveUnbluntedPos;

                        var endPos = plotData.timeEnd - plotCanvas.window;
                        var startPos = plot.followEnd && plotCanvas.window > plotData.timeRange ? endPos : plotData.timeStart;

                        var startDist = newPos - startPos;
                        if (startDist < 0) {
                            newPos += -startDist + blunt(startDist / plotCanvas.window, bounceOffset) * plotCanvas.window;
                        }

                        var endDist = endPos - newPos;
                        if (endDist < 0) {
                            newPos += endDist - blunt(endDist / plotCanvas.window, bounceOffset) * plotCanvas.window;
                        }

                        var ret = plotCanvas.toCanvasPos(newPos);
                        plotCanvas.position = newPos;

                        return ret;
                    }

                    function move(dist, isZooming) {
                        moveRelative(moveReferencePos, dist);

                        var now = Date.now();
                        var dt = now - lastTime;
                        if (dt === 0) {
                            // seems to happen on desktop with mouse only
                            return;
                        }

                        var alpha = 0.9;
                        if (isZooming) {
                            zoomDampen = alpha;
                        } else {
                            alpha -= zoomDampen;
                        }
                        var s = (dist - lastDist) / dt * 1000;
                        speed += alpha * (s - speed);
                        zoomDampen = Math.max(zoomDampen * 0.98 - 0.002, 0);

                        moving = true;
                        lastDist = dist;
                        lastTime = now;
                    }

                    function zoomPosOffset(oldWindow, newWindow, center) {
                        var perc = oldWindow / newWindow - 1;
                        return (plotCanvas.toPlotPos(plotCanvas.position, center, newWindow) - plotCanvas.position) * perc;
                    }

                    function zoom(newWindow, center) {
                        bounceBackZoom.stop();
                        lastZoomCenter = center;

                        var maxWin = maxWindow;
                        var maxDist = maxWin - newWindow;
                        if (maxDist < 0) {
                            newWindow = (1 - blunt(maxDist / maxWin, bounceOffset * 2)) * maxWin;
                        }

                        var minDist = newWindow - minWindow;
                        if (minDist < 0) {
                            newWindow = (1 + blunt(minDist / minWindow, bounceOffset * 2)) * minWindow;
                        }

                        var posOffset = zoomPosOffset(plotCanvas.window, newWindow, center);
                        moveReferencePos += posOffset;
                        plotCanvas.position = plotCanvas.position + posOffset;
                        plotCanvas.window = newWindow;
                    }

                    function flick() {
                        grabbed = false;
                        rolling = true;
                    }

                    function snapToBounds() {
                        var windowTo = clamp(plotCanvas.window, minWindow, maxWindow);

                        bounceBackZoom.stop();
                        bounceBackZoom.to = windowTo;
                        bounceBackZoom.start();

                        if (plot.followEnd && (plotCanvas.window > plotData.timeRange || plotCanvas.position > plotData.timeEnd - plotCanvas.window * 1.05)) {
                            plotMover.followPosition();
                        } else {
                            bounceBack.stop();
                            var newPos = plotCanvas.position + zoomPosOffset(plotCanvas.window, windowTo, lastZoomCenter);
                            bounceBack.to = clamp(newPos, plotData.timeStart, plotData.timeEnd - windowTo);
                            bounceBack.start();
                        }
                    }

                    function zoomAnimated(by, center) {
                        zoomCenter = center;

                        if (!zoomAnim.running) {
                            zoomAnim.to = animWin / by;
                        } else {
                            zoomAnim.stop();
                            zoomAnim.to /= by;
                        }

                        zoomAnim.start();
                    }
                }

                Timer {
                    id: plotFlickTimer
                    repeat: true
                    interval: dt * 1000
                    running: plotCanvas.visible

                    property real dt: 1 / 30

                    onTriggered: {
                        var sign = plotMover.speed < 0 ? -1 : 1;
                        if (plotMover.speed * sign > 0) {
                            var d = plotMover.speed * dt;

                            if (plotMover.rolling) {
                                var realD = plotMover.moveRelative(plotMover.moveUnbluntedPos, d);

                                if (sign * realD < sign * d - 0.000001) {
                                    // we hit the edge, real speed is now much slower
                                    plotMover.speed = realD / dt;
                                    plotMover.speed -= sign * 0.1;
                                } else {
                                    // very gradual deceleration during normal rolling
                                    plotMover.speed *= 0.98;
                                    plotMover.speed -= sign * 2;
                                }
                            } else if (!plotMover.moving) {
                                // fast decay when plot is being held in place without moving (i.e. no mouse events incoming)
                                plotMover.speed *= 0.7;
                                plotMover.speed -= sign * 20;
                            }

                            plotMover.moving = false;
                        }

                        if (plotMover.speed * sign <= 0) {
                            plotMover.speed = 0;
                            if (plotMover.rolling) {
                                plotMover.snapToBounds();
                            }
                            plotMover.rolling = false;
                        }
                    }
                }

                NumberAnimation {
                    id: zoomAnim
                    target: plotMover
                    property: "animWin"
                    easing.type: Easing.OutQuad
                    duration: 200

                    onFinished: {
                        plotMover.release();
                    }
                }

                NumberAnimation {
                    id: bounceBack
                    target: plotCanvas
                    property: "position"
                    easing {
                        type: Easing.OutBack
                        amplitude: 2.0
                        period: 0.5
                    }
                    duration: 300
                }

                NumberAnimation {
                    id: bounceBackZoom
                    target: plotCanvas
                    property: "window"
                    easing {
                        type: Easing.OutBack
                        amplitude: 2.0
                        period: 0.5
                    }
                    duration: 300
                }

                function toPlotPos(oldPos, x, win) {
                    if (win === undefined) {
                        win = window;
                    }
                    return oldPos + x / xLength * win;
                }

                function toCanvasPos(pos) {
                    return (pos - position) / window * xLength;
                }

                function isCursorPosValid(pos) {
                    if (pos < plotData.timeStart || pos < position || pos > position + window || pos > plotData.timeEnd) {
                        return false;
                    }

                    return true;
                }

                function spawnCursorCoord(x) {
                    spawnCursor(toPlotPos(position, x));
                }

                function spawnCursor(cursorPos) {
                    if (!isCursorPosValid(cursorPos)) {
                        return;
                    }

                    for (var i = 0; i < plotData.data.length; i++) {
                        var time1 = plotData.data[i][0];
                        if (cursorPos < time1) {
                            if (i === 0) {
                                cursor = plotData.data[i];
                            } else {
                                var time2 = plotData.data[i - 1][0];
                                if (dist(cursorPos, time1) < dist(cursorPos, time2)) {
                                    cursor = plotData.data[i];
                                } else {
                                    cursor = plotData.data[i - 1];
                                }
                            }
                            break;
                        }
                    }
                }

                function getCursorPosIfCan() {
                    if (!cursor) {
                        return null;
                    }

                    var pos = cursor[0];
                    if (!isCursorPosValid(pos)) {
                        return null;
                    }

                    return toCanvasPos(pos);
                }

                function fadeCursor(a=0) {
                    a = a * a * a;
                    if (a <= 0.05) {
                        cursor = null;
                    } else {
                        cursorOpacity = a;
                    }
                }

                function reset() {
                    position = NaN;
                    window = plot.startWindow * plot.ticksPerSecond;
                    cursor = null;
                }

                function pointYCoord(point, n) {
                    return point[n + 1] * yLength * plotData.scales[n];
                }

                function timeFormat(s, decimals) {
                    var res = "";
                    if (s > 60) {
                        var m = Math.floor(s / 60);
                        s -= m * 60;
                        if (m > 60) {
                            var h = Math.floor(m / 60);
                            m = String(m - h * 60).padStart(2, "0");
                            res += h + ":";
                        }
                        res += m + ":";
                    }

                    if (s < 10) {
                        res += "0";
                    }

                    if (decimals !== undefined) {
                        res += s.toFixed(decimals);
                    } else {
                        res += s.toFixed(6) / 1;
                    }

                    return res;
                }

                function paintXAxis(ctx, yMax, yMin) {
                    ctx.beginPath();
                    ctx.lineWidth = 1;
                    ctx.strokeStyle = plot.themeColor("disabledText");

                    ctx.moveTo(-padding, 0);
                    ctx.lineTo(xLength + padding, 0);
                    ctx.stroke();

                    if (window == 0 || xLength == 0) {
                        // prevent an infinite loop
                        return;
                    }

                    var basePixelsPerTick = 60;

                    var calcTick = function(extraWidth) {
                        var mult = 1;
                        var tick = window / xLength * (basePixelsPerTick + extraWidth);

                        while (tick < 1) {
                            mult *= 0.1;
                            tick *= 10;
                        }

                        while (tick > 10) {
                            mult *= 10;
                            tick *= 0.1;
                        }

                        if (tick > 5) {
                            tick = 5;
                        } else if (tick > 2) {
                            tick = 2;
                        } else {
                            tick = 1;
                        }

                        return tick * mult;
                    }

                    // estimate label width
                    var digitSize = ctx.measureText("8").width;
                    var sepSize = ctx.measureText(":").width;
                    var sampleTime = plotData.timeEnd;
                    var decs = Math.max(-Math.log10(window / xLength * basePixelsPerTick), 0);
                    var estimatedExtraWidth = decs * digitSize + sepSize;
                    if (sampleTime >= 60) {
                        estimatedExtraWidth += digitSize + sepSize;
                    }
                    if (sampleTime >= 600) {
                        estimatedExtraWidth += digitSize;
                    }
                    if (sampleTime >= 3600) {
                        estimatedExtraWidth += digitSize + sepSize;
                    }

                    var tick = calcTick(Math.max(0, estimatedExtraWidth - 10) * 3.6);

                    ctx.beginPath();
                    ctx.textAlign = "center";
                    ctx.fillStyle = plot.themeColor("disabledText");
                    ctx.strokeStyle = plot.themeColor("darkBackground");
                    var notch = Math.floor(position / tick) * tick;
                    var maxNotch = Math.ceil((position + window) / tick) * tick;
                    var ticksPerSec = plot.ticksPerSecond;
                    while (notch <= maxNotch) {
                        var coord = toCanvasPos(notch);
                        ctx.moveTo(coord, -yMax);
                        ctx.lineTo(coord, -yMin);

                        var decimals = Math.max(Math.ceil(-Math.log10(tick / ticksPerSec)), 0);
                        ctx.fillText(timeFormat(notch / ticksPerSec, decimals), coord, -yMin + 15);
                        ctx.stroke();

                        notch += tick;
                    }

                    ctx.stroke();
                }

                function paintCursor(ctx, yMax, yMin) {
                    var time = cursor[0];
                    if (time < position || time > position + window) {
                        return;
                    }

                    var originalAlpha = ctx.globalAlpha;
                    ctx.globalAlpha = cursorOpacity;

                    ctx.beginPath();
                    ctx.lineWidth = 1;
                    ctx.strokeStyle = plot.themeColor("normalText");

                    var cursorCoord = toCanvasPos(cursor[0]);
                    ctx.moveTo(cursorCoord, -yMax - 3);
                    ctx.lineTo(cursorCoord, -yMin + 3);
                    ctx.stroke();

                    ctx.textAlign = "center";
                    ctx.textBaseline = "top";
                    ctx.fillStyle = plot.themeColor("normalText");
                    var text = timeFormat(time / plot.ticksPerSecond);
                    var rectWidth = ctx.measureText(text).width + 20;
                    var rectHalfWidth = rectWidth / 2;
                    var removePadding = padding + 5;
                    var xTextCoord = clamp(cursorCoord, rectHalfWidth - removePadding, xLength - rectHalfWidth + removePadding - 1);
                    var yTextCoord = -yMin + 5;
                    ctx.rect(xTextCoord - rectHalfWidth, yTextCoord, rectWidth, 14);

                    var pc = plot.color;
                    ctx.fillStyle = Qt.rgba(pc.r, pc.g, pc.b, 0.7);
                    ctx.fill();
                    ctx.fillStyle = plot.themeColor("normalText");
                    ctx.fillText(text, xTextCoord, yTextCoord);
                    ctx.textBaseline = "alphabetic";

                    var textHeight = 10;
                    var yOffset = 4;
                    var labelHeight = textHeight + yOffset;
                    var topLimit = yMax - textHeight - 1;
                    var bottomLimit = yMin + 1;
                    var pd = plotData;
                    var series = pd.series;

                    var textX = cursorCoord;
                    var textFormat;
                    if (cursorCoord > xLength / 2) {
                        textX -= 4;
                        ctx.textAlign = "right";
                        textFormat = "%2  %1";
                    } else {
                        textX += 4;
                        ctx.textAlign = "left";
                        textFormat = "%1  %2";
                    }

                    var vals = [];
                    for (var n = 0; n < pd.sampleSize; n++) {
                        if (!series[n].visible) {
                            continue;
                        }
                        var y = pointYCoord(cursor, n);
                        if (!Number.isNaN(y)) {
                            vals.push([y, series[n].sortOrder, n]);
                        }
                    }

                    vals.sort((a, b) => b[0] !== a[0] ? b[0] - a[0] : a[1] - b[1]);

                    ctx.strokeStyle = "#000000";
                    ctx.lineWidth = 3;
                    for (var i = 0; i < vals.length; i++) {
                        var p = vals[i];
                        var n = p[2];
                        ctx.fillStyle = series[n].color;
                        var str = textFormat.arg(Number(cursor[n + 1].toPrecision(4))).arg(series[n].name);
                        var textY = Math.min(p[0] + yOffset, topLimit);
                        textY = Math.max(bottomLimit + (vals.length - i - 1) * labelHeight, textY);
                        topLimit = textY - labelHeight;

                        ctx.strokeText(str, textX, -textY);
                        ctx.fillText(str, textX, -textY);
                    }

                    ctx.globalAlpha = originalAlpha;
                }

                function paintSeries(ctx, yMax, yMin) {
                    var lineWidth = 1;
                    ctx.lineWidth = lineWidth;

                    // optimization: local variables are much faster than property resolution
                    var pd = plotData;
                    var data = pd.data;
                    var scales = pd.scales;
                    var sampleSize = pd.sampleSize;
                    var yLen = yLength;
                    var pos = position;
                    var win = window;
                    var xLen = xLength;
                    var dotsEnbld = plot.dotsEnabled;

                    // calculate start and end indices according to window
                    var start = 0;
                    var end = data.length;

                    var winNotChangedFactor = Math.abs(win - hystWindow) < 0.0001 ? 2 : 1;
                    hystWindow = win;

                    var pixelsPerTimeUnit = xLen / win;
                    var prevTime = null;
                    var paintDots = true;
                    var dotsThreshold = 20 / (paintDotsHyst ? 1 : (0.8 / winNotChangedFactor));
                    var distanceSum = 0;
                    var minDistance = 1e10;
                    var windowSize = 4;
                    var lastFour = [];
                    for (var i = start; i < end; i++) {
                        var t = data[i][0];
                        if (t < pos) {
                            start = i;
                        } else {
                            if (t > pos + win) {
                                end = Math.min(i + 1, data.length);
                                break;
                            }

                            // measure point distance until we measure enough to disable painting plot dots
                            // (or never reach enough distance and paint the dots)
                            if (prevTime !== null) {
                                var distance = (t - prevTime) * pixelsPerTimeUnit;
                                distanceSum += distance;
                                lastFour.push(distance);

                                if (lastFour.length > 4) {
                                    distanceSum -= lastFour.shift();
                                }

                                if (lastFour.length === 4) {
                                    if (distanceSum / 4 < dotsThreshold) {
                                        paintDots = false;
                                    }

                                    minDistance = Math.min(minDistance, distanceSum);
                                }
                            }
                            prevTime = t;
                        }
                    }

                    if (lastFour.length < 4 && distanceSum / lastFour.length < dotsThreshold) {
                        paintDots = false;
                    }
                    minDistance = Math.min(minDistance, distanceSum);

                    var dotDistThreshold = Math.max(minDistance / lastFour.length * 3, 10);

                    paintDotsHyst = paintDots;

                    var step = 0.5 / Screen.devicePixelRatio;
                    var justOutOfMinMax = false;
                    var halfASecondPixels = 0.5 * plot.ticksPerSecond * xLen / win;

                    var srsSorted = pd.seriesSorted;
                    for (var k = srsSorted.length - 1; k >= 0; k--) {
                        var series = srsSorted[k];
                        if (!series.visible) {
                            continue;
                        }

                        ctx.beginPath();
                        var color = series.color;
                        ctx.strokeStyle = color;
                        ctx.fillStyle = color;

                        var n = series.dataOrder;
                        var nScale = scales[n];
                        var min = -1e30;
                        var max = 1e30;
                        var lastX = -0.001;
                        var lastSampleX = -0.001;
                        var lastY = 0;
                        var lastDrawnX = 0;
                        var minMaxMode = false;
                        var drawnLastDot = false;
                        for (var i = start; i < end; i++) {
                            var point = data[i];
                            var nPoint = point[n + 1];

                            // optimization: instead of toCanvasPos(point[0])
                            var x = (point[0] - pos) / win * xLen;

                            // optimization: NaN check by comparison instead of Number.isNaN()
                            if (nPoint !== nPoint) {
                                lastSampleX = x;
                                continue;
                            }

                            var y = -nPoint * yLen * nScale;
                            var origX = x;

                            // handle trimming lines at plot edges
                            if (i === start && x < 0) {
                                var nextPoint = data[i + 1];
                                var nextX = (nextPoint[0] - pos) / win * xLen;
                                var nextY = -nextPoint[n + 1] * yLen * nScale;
                                y += (nextY - y) * x / (x - nextX);
                                x = 0;
                            } else if (i === end - 1 && x > xLen) {
                                y -= (y - lastY) * (x - xLen) / (x - lastX);
                                x = xLen;
                            }

                            if (i > start && x - lastX < step) {
                                minMaxMode = true;
                            }

                            if (minMaxMode) {
                                // min-max algorithm for dynamically "downsampling" the series
                                if (x - lastDrawnX > step) {
                                    var miny = min;
                                    var maxy = max;
                                    var dist = miny - maxy;
                                    if (dist < lineWidth) {
                                        var offset = (lineWidth - dist) / 2;
                                        miny += offset;
                                        maxy -= offset;
                                    }

                                    ctx.moveTo(lastX, miny);
                                    ctx.lineTo(lastX, maxy);

                                    var tmp = min;
                                    min = max;
                                    max = tmp;

                                    lastDrawnX = x;

                                    if (x - lastX > step) {
                                        minMaxMode = false;
                                        justOutOfMinMax = true;
                                        ctx.moveTo(lastX, lastY);
                                    }
                                }

                                min = y > min ? y : min;
                                max = y < max ? y : max;
                            }

                            if (!minMaxMode) {
                                if (dotsEnbld && origX - lastX > halfASecondPixels) {
                                    ctx.moveTo(x, y);
                                } else {
                                    ctx.lineTo(x, y);
                                }

                                min = y;
                                max = y;
                                lastDrawnX = x;
                                justOutOfMinMax = false;
                            }

                            if (dotsEnbld && i > start && origX >= 0 && (paintDots || x - lastSampleX > dotDistThreshold || origX - lastSampleX > halfASecondPixels)) {
                                ctx.stroke();
                                ctx.beginPath();
                                if (!drawnLastDot && lastX >= 0) {
                                    ctx.arc(lastX, lastY, 2.5, 0, 2 * Math.PI, false);
                                }
                                if (origX <= xLen + 0.001) {
                                    ctx.arc(x, y, 2.5, 0, 2 * Math.PI, false);
                                }
                                ctx.fill();
                                ctx.beginPath();
                                if (justOutOfMinMax) {
                                    ctx.moveTo(lastX, lastY);
                                } else {
                                    ctx.moveTo(x, y);
                                }
                                drawnLastDot = true;
                            } else {
                                // move to the same point to draw a series of disconnected lines,
                                // which is much faster
                                ctx.moveTo(x, y);
                                drawnLastDot = false;
                            }

                            lastX = origX;
                            lastSampleX = origX;
                            lastY = y;
                        }
                        ctx.stroke();
                    }
                }

                onPaint: {
                    if (!visible) {
                        return;
                    }

                    var ctx = getContext("2d");
                    ctx.reset();

                    if (!plotData.dataReady) {
                        return;
                    }

                    var yMax = yLength * plotData.positiveRatio;
                    var yMin = yLength * (plotData.positiveRatio - 1);

                    ctx.translate(padding, yMax + toolbarHeight);

                    paintXAxis(ctx, yMax, yMin);

                    paintSeries(ctx, yMax, yMin);

                    if (cursor !== null) {
                        paintCursor(ctx, yMax, yMin);
                    }
                }
            }
        }
    }

    component OverlayPlot : Plot {
        anchors.centerIn: parent
        height: vertical ? parent.width : parent.height
        width: vertical ? parent.height : parent.width
        rotation: vertical ? 90 : 0
        z: 100
        visible: false

        property bool vertical: parent.height > parent.width

        showRecordDownload: parent.state.capDataRecord
        toolbarOffset: 0.9

        FloatingToolButton {
            anchors.top: parent.top
            anchors.left: parent.left
            width: 0.8 * unit
            height: 0.8 * unit

            iconPath: Path {
                PathSvg {path: "M 15 15 L 35 35 M 15 35 L 35 15"}
            }

            onClicked: {
                parent.visible = false;
            }
        }
    }

    component StatusText : Item {
        property var globState

        MouseArea {
            anchors.fill: parent
            onClicked: alertsDialog.show()
        }

        states: [
            State {
                name: "specialMode"
                when: statusTextMode.visible || statusTextAlert.visible
                AnchorChanges {target: statusTextState; anchors.top: parent.top; anchors.verticalCenter: undefined;}
            }
        ]

        SwLText {
            id: statusTextState
            anchors.verticalCenter: parent.verticalCenter
            width: parent.width
            font.pixelSize: (statusTextMode.visible && statusTextAlert.visible ? 0.3 : globState.pkgStateString.length >= 10 ? 0.42 : 0.55) * unit
            font.family: "Exan"
            horizontalAlignment: Text.AlignHCenter
            verticalAlignment: Text.AlignVCenter
            text: globState.pkgStateString
        }

        Glow {
            property bool red: globState.isError
            property bool dark: globState.darkride
            property bool blue: globState.pkgState == globState.s_Running

            anchors.fill: statusTextState
            radius: Math.round((dark ? 0.2 : 0.12) * unit)
            samples: radius * 2 + 1
            spread: red ? 0.6 : (dark ? 0.7 : 0.5)
            opacity: red || dark || blue ? 0.8 : 0.3

            color: {
                if (red) {
                    return swTheme.color("red");
                } else if (dark) {
                    return Utility.isDarkMode() ? swTheme.color("black") : swTheme.color("disabledText");
                } else if (blue) {
                    return swTheme.color("lightAccent");
                } else {
                    return swTheme.color("lightText");
                }
            }
            source: statusTextState
        }

        Text {
            id: statusTextMode
            anchors.top: statusTextState.bottom
            width: parent.width
            color: globState.pkgMode == globState.m_Flywheel ? swTheme.color("lightAccent") : swTheme.color("lightText")
            font.pixelSize: statusTextAlert.visible ? fontSizeSuperSmall : fontSizeSmall
            font.family: "Exan"
            horizontalAlignment: Text.AlignHCenter
            verticalAlignment: Text.AlignVCenter
            visible: globState.pkgMode != globState.m_Normal
            text: globState.pkgModeString
        }

        Glow {
            anchors.fill: statusTextMode
            radius: Math.round(0.12 * unit)
            samples: radius * 2 + 1
            opacity: 0.3
            color: statusTextMode.color
            visible: globState.pkgMode != globState.m_Normal
            source: statusTextMode
        }

        Text {
            id: statusTextAlert

            property var alert: alerts.getActiveAlertData(alerts.activeAlertHighlight)
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.top: statusTextMode.visible ? statusTextMode.bottom : statusTextState.bottom
            width: parent.width * 1.2
            color: alerts.severityColors.get(alert.severity)
            font.pixelSize: fontSizeSuperSmall
            font.family: "Mono"
            horizontalAlignment: Text.AlignHCenter
            verticalAlignment: Text.AlignVCenter
            elide: Text.ElideMiddle
            visible: alerts.activeAlertCount > 0
            text: alert.name
        }

        Glow {
            anchors.fill: statusTextAlert
            radius: Math.round(0.12 * unit)
            samples: radius * 2 + 1
            opacity: 0.3
            color: statusTextAlert.color
            visible: statusTextAlert.visible
            source: statusTextAlert
        }
    }

    function locateButton(comp, name) {
        for (var i = 0; i < comp.children.length; i++) {
            var child = comp.children[i];
            if (child.toString().startsWith("Button_QMLTYPE") && child.text === name) {
                return child;
            }
            var res = locateButton(child, name);
            if (res) {
                return res;
            }
        }

        return null;
    }

    Timer {
        id: onStartupTimer
        interval: 10

        onTriggered: {
            updateChecker.check();
        }
    }

    property var customConfigWriteButton: null

    Component.onCompleted: {
        if (typeof confCustomLoader !== typeof undefined) {
            // There is no reliable "config updated" signal, we have to hook onto
            // the VESC Tool custom config buttons (works for QML only, not
            // for the desktop app config page).
            print("{{PACKAGE_NAME}}: Hooking custom config Write button...");
            customConfigWriteButton = locateButton(confCustomLoader.item, "Write");
            if (customConfigWriteButton) {
                customConfigWriteButton.clicked.connect(packageConfig.configWritten);
            } else {
                print("{{PACKAGE_NAME}}: Failed to locate Write button.");
            }
        }

        // rf90: no welcome dialog / upstream hint pages on start; the
        // Refloat Glow tour opens once instead (SKIP closes it)
        // rf93: the disclaimer opens every time (until "don't show again"),
        // the tour after it on first start
        if (swSettings.ledSnoozeMin === 255) swSettings.ledSnoozeMin = 5;  // rf100: old AUTO
        // rf97: SNOOZE BREATHING OFF from before -> DARK snooze style
        if (!swSettings.ledDozeBreath && swSettings.ledSnoozeStyle === 0) swSettings.ledSnoozeStyle = 2;
        // rf150: the notice waits until this package's tab is on screen
        // (startNoticeTimer), then the tour as before
        if (swSettings.hideDisclaimerVer !== "{{VERSION}}") startNoticeTimer.start();  // rf104: again after every update
        else if (swSettings.tourSeenVer !== "{{VERSION}}") rinkTour.open();  // rf170: once per new version

        onStartupTimer.start();
    }

    // rf150: the start notice is drawn over the whole app, so it must not
    // open while VESC Tool shows another tab (e.g. right after installing
    // the package): it opens once this package's own tab has been on screen
    // for a moment. If you switch to another tab while it's open, it closes
    // and comes back when you return, until you press CONTINUE.
    property bool startNoticeDone: false
    // rf170: VESC Tool (mobile) hosts this UI in a page of its main SwipeView
    // and hands us that SwipeView (uiApp.swipeViewItem). The notice waits
    // until the rider actually SELECTS this tab: it has to be seen not
    // selected first (e.g. still on VESC Packages right after installing)
    // and then selected, or the rider touches this UI. Being the current
    // page right when the package loads doesn't count. Desktop VESC Tool (no
    // SwipeView handed over): on screen + a touch.
    property bool tabLeftOnce: false
    property bool touchedOnce: false
    function hostSelected() {
        var host = mainItem.parent;
        if (host && host.swipeViewItem && host.parent)
            return host.swipeViewItem.currentItem === host.parent && mainItem.packageOnScreen();
        return mainItem.packageOnScreen();
    }
    MouseArea {  // rf170: notices the first touch, passes it on untouched
        anchors.fill: parent
        z: 1000
        enabled: !mainItem.touchedOnce && !mainItem.startNoticeDone
        onPressed: function (mouse) { mainItem.touchedOnce = true; mouse.accepted = false; }
    }
    function packageOnScreen() {
        if (!mainItem.visible || mainItem.width <= 0 || mainItem.height <= 0) return false;
        var w = mainItem.Window.width, h = mainItem.Window.height;
        if (!(w > 0 && h > 0)) return false;
        var p = mainItem.mapToItem(null, mainItem.width / 2, mainItem.height / 2);
        return p.x > 0 && p.x < w && p.y > 0 && p.y < h;
    }
    Timer {
        id: startNoticeTimer
        interval: 400
        repeat: true
        property int seen: 0
        onTriggered: {
            if (mainItem.startNoticeDone) {
                stop();
                return;
            }
            var sel = mainItem.hostSelected();
            if (!sel) mainItem.tabLeftOnce = true;
            var on = sel && (mainItem.tabLeftOnce || mainItem.touchedOnce);
            seen = on ? seen + 1 : 0;
            if (disclaimerDialog.visible) {
                if (!on) disclaimerDialog.close();
            } else if (seen >= 2) {
                disclaimerDialog.open();
            }
        }
    }

    Component.onDestruction: {
        if (typeof confCustomLoader !== typeof undefined) {
            print("{{PACKAGE_NAME}}: Unhooking custom config Write button...");
            if (customConfigWriteButton) {
                customConfigWriteButton.clicked.disconnect(packageConfig.configWritten);
            } else {
                print("{{PACKAGE_NAME}}: Write button was not set.");
            }
        }
    }

    Dl.FileDialog {
        id: jsonSaveDialog
        title: "Choose a file to save"
        nameFilters: ["JSON (*.json)"]
        selectExisting: false

        property string jsonData

        function show(data) {
            if (!Utility.requestFilePermission()) {
                VescIf.emitMessageDialog(
                            "File Permissions",
                            "Unable to request file system permission.",
                            false, false);
                return;
            }

            jsonData = JSON.stringify(data, null, 4);
            open();
        }

        onAccepted: {
            var fUrl = fileUrl.toString();
            if (!fUrl.toLowerCase().endsWith(".json")) {
                fUrl += ".json";
            }

            var request = new XMLHttpRequest();
            request.open("PUT", fUrl, false);
            request.send(jsonData);

            if (request.status === 0) {
                VescIf.emitStatusMessage("File saved", true);
            } else {
                VescIf.emitStatusMessage("Save failed: %1".arg(request.status), false);
            }
        }
    }

    // Refloat Glow: pick an LCM firmware .hex for FLASH LCM
    Dl.FileDialog {
        id: hexLoadDialog
        title: "Choose an LCM firmware .hex"
        nameFilters: ["Intel HEX (*.hex)", "All files (*)"]
        selectExisting: true

        function show() {
            if (!Utility.requestFilePermission()) {
                VescIf.emitMessageDialog("File Permissions", "Unable to request file system permission.", false, false);
                return;
            }
            open();
        }

        onAccepted: {
            var fUrl = fileUrl.toString();
            var request = new XMLHttpRequest();
            request.open("GET", fUrl, false);
            request.send(null);
            if (request.status === 200 || (request.status === 0 && request.responseText.length > 0)) {
                lcmFw.loadHexText(request.responseText, decodeURIComponent(fUrl.split("/").pop()));
            } else {
                lcmFw.message = "Couldn't open the file (%1).".arg(request.status);
            }
        }
    }

    Dl.FileDialog {
        id: jsonLoadDialog
        title: "Choose a file to load"
        nameFilters: ["JSON (*.json)"]
        selectExisting: true

        function show() {
            if (!Utility.requestFilePermission()) {
                VescIf.emitMessageDialog(
                            "File Permissions",
                            "Unable to request file system permission.",
                            false, false);
                return;
            }

            applyConfigDialog.open();
            open();
        }

        onAccepted: {
            var fUrl = fileUrl.toString();

            var request = new XMLHttpRequest();
            request.open("GET", fUrl, false);
            request.send(null);

            if (request.status === 200) {
                applyConfigDialog.set(JSON.parse(request.responseText));
            } else {
                VescIf.emitStatusMessage("Opening file failed: %1".arg(request.status), false);
            }
        }

        onRejected: {
            applyConfigDialog.close();
        }
    }

    BaseDialog {
        id: settingsDialog
        implicitHeight: fullHeight

        title: "Settings"
        standardButtons: Dialog.NoButton

        footer: Item {
            implicitHeight: 1.2 * unit
            SwPill {
                anchors.centerIn: parent
                minWidth: 3.0 * unit
                label: "CLOSE"
                onClicked: settingsDialog.close()
            }
        }

        function show(tab) {
            settingsTabBar.currentIndex = tab || 0;
            open();
        }

        component RightSwitch : RowLayout {
            Layout.fillWidth: true

            property string label
            property alias checked: swtch.checked

            LText {
                color: swTheme.neonGreen  // rf81: neon settings text
                Layout.fillWidth: true
                text: parent.label
            }

            Switch {
                id: swtch
            }
        }

        component IntTextField : RowLayout {
            Layout.fillWidth: true

            property string label
            property string valueUnit: ""
            property int value
            property int sourceValue

            property int minValue: 0
            property int maxValue: 100

            LText {
                color: swTheme.neonGreen  // rf81: neon settings text
                Layout.fillWidth: true
                text: parent.label
            }

            TextField {
                id: textField
                implicitWidth: 50

                maximumLength: 4
                horizontalAlignment: TextInput.AlignRight
                inputMethodHints: Qt.ImhDigitsOnly
                // rf81: our own neon number pad (with DONE) instead of the
                // phone's grey keyboard
                readOnly: true
                color: swTheme.neonGreen
                font.family: "Exan"

                MouseArea {
                    anchors.fill: parent
                    onClicked: numPad.edit(textField.parent.label, textField.parent.value, textField.parent.minValue,
                        textField.parent.maxValue, textField.parent.valueUnit, function(v) { textField.text = String(v); })
                }

                property string prevText

                onTextChanged: {
                    if (text !== "") {
                        var number = Number(text);
                        if (number > maxValue) {
                            text = prevText;
                        } else if (number < minValue) {
                            parent.value = Math.max(number, minValue);
                        } else {
                            parent.value = number;
                            prevText = text;
                        }
                    }
                }

                onActiveFocusChanged: {
                    if (!activeFocus) {
                        text = parent.value;
                    }
                }

                Component.onCompleted: {
                    text = parent.sourceValue;
                    prevText = text;
                }
            }

            LText {
                color: swTheme.neonGreen  // rf81: neon settings text
                text: parent.valueUnit
            }
        }

        component Heading : LText {
            Layout.fillWidth: true
            Layout.topMargin: 10
            horizontalAlignment: TextInput.AlignHCenter
            color: swTheme.neonGreen
            font.family: "Exan"
            font.pixelSize: 0.32 * unit
        }

        component SubHeading : LText {
            Layout.fillWidth: true
            Layout.topMargin: 10
            horizontalAlignment: TextInput.AlignHCenter
            font.pointSize: 14
        }

        component OptionDescription : NText {
            Layout.fillWidth: true
            Layout.leftMargin: 20
            Layout.rightMargin: 20
            Layout.topMargin: -7
            color: "#9d8ac0"
            font.pixelSize: 0.2 * unit
            horizontalAlignment: TextInput.AlignHCenter
            wrapMode: Text.WordWrap
        }

        component SetupDescription : NText {
            Layout.fillWidth: true
            horizontalAlignment: TextInput.AlignHCenter
            wrapMode: Text.WordWrap
            color: "#cbb8ec"
            font.pixelSize: 0.22 * unit
        }

        ColumnLayout {
            width: settingsDialog.availableWidth
            height: parent.height
            spacing: 0.15 * unit

            // Refloat Glow: neon tab pills instead of the stock TabBar
            Row {
                id: settingsTabBar
                Layout.alignment: Qt.AlignHCenter
                spacing: 0.12 * unit
                property int currentIndex: 0
                onCurrentIndexChanged: settingsStackLayout.currentIndex = currentIndex

                Repeater {
                    model: ["SETUP", "PREFERENCES", "RIDE", "WATCHDOG"]  // rf167: RIDE = haptic feedback + pushback; rf182: WATCHDOG
                    SwPill {
                        minWidth: 1.6 * unit
                        labelSize: 0.2 * unit
                        label: modelData
                        lit: settingsTabBar.currentIndex === index
                        onClicked: settingsTabBar.currentIndex = index
                    }
                }
            }

            StackLayout {
                id: settingsStackLayout
                Layout.fillWidth: true
                Layout.fillHeight: true
                clip: true

                ScrollView {
                    Layout.fillWidth: true
                    Layout.fillHeight: true
                    contentWidth: availableWidth
                    clip: true

                    ColumnLayout {
                        width: parent.width
                        spacing: 0.25 * unit

                        SettingsCard {
                            title: "PACKAGE"

                            SetupDescription {
                                text: "Before running the motor wizard, disable the package so the two don't fight over the motor. Re-enable it after configuring your motor."
                            }

                            NeonButton {
                                Layout.alignment: Qt.AlignHCenter
                                lit: state.pkgState === state.s_Disabled
                                text: state.pkgState === state.s_Disabled ? "Enable package" : "Disable package"
                                onClicked: packageConfig.setDisabled(state.pkgState !== state.s_Disabled)
                            }
                        }

                        SettingsCard {
                            title: "HANDTEST"

                            SetupDescription {
                                text: "After setup, turn on Handtest and engage the board by hand to check it balances the right way. Motor currents are limited to a safe level."
                            }

                            NeonButton {
                                Layout.alignment: Qt.AlignHCenter
                                // Only allow if no other mode is active
                                enabled: [state.m_Normal, state.m_Handtest].includes(state.pkgMode)
                                lit: state.pkgMode === state.m_Handtest
                                text: state.pkgMode === state.m_Handtest ? "Handtest off" : "Handtest on"
                                onClicked: commands.sendHandtest(state.pkgMode === state.m_Normal)
                            }

                            SetupDescription {
                                visible: state.pkgMode === state.m_Handtest
                                color: "#FFB300"
                                text: "Balances in reverse (shoots off)? Your Imu Rotation Yaw is off by 180\u00B0. Erratic? Likely off by 90\u00B0.\nWhile Handtest is on, writing the configuration is disabled."
                            }
                        }

                        SettingsCard {
                            title: "BACKUP / RESTORE"

                            SetupDescription {
                                text: "Backups are stored in VESC Tool's internal storage."
                            }

                            // one row per backup: name + date on the left, buttons on the right
                            RowLayout {
                                Layout.fillWidth: true
                                spacing: 0.15 * unit
                                ColumnLayout {
                                    Layout.fillWidth: true
                                    spacing: 0
                                    LText { text: "Automatic"; font.pixelSize: 0.26 * unit; color: swTheme.neonGreen }
                                    NText {
                                        id: setupAutoBackupDate
                                        property var backup: null
                                        font.pixelSize: 0.2 * unit
                                        color: "#9d8ac0"
                                        text: backup ? Qt.formatDateTime(backup.date) : "none yet"
                                        Connections {
                                            target: tuneManager
                                            function onAutoBackupFinished(backup) {
                                                setupAutoBackupDate.backup = backup;
                                            }
                                        }
                                    }
                                }
                                NeonButton { text: "View"; implicitWidth: 1.8 * unit; onClicked: tuneManager.autoRestore() }
                            }

                            Rectangle { Layout.fillWidth: true; height: 1; color: "#3a2266" }

                            RowLayout {
                                Layout.fillWidth: true
                                spacing: 0.15 * unit
                                ColumnLayout {
                                    Layout.fillWidth: true
                                    spacing: 0
                                    LText { text: "This board"; font.pixelSize: 0.26 * unit; color: swTheme.neonGreen }
                                    NText {
                                        id: setupIdBackupDate
                                        property var backup: null
                                        font.pixelSize: 0.2 * unit
                                        color: "#9d8ac0"
                                        text: backup ? Qt.formatDateTime(backup.date) : "none yet"
                                        Connections {
                                            target: tuneManager
                                            function onIdBackupFinished(backup) {
                                                setupIdBackupDate.backup = backup;
                                            }
                                        }
                                    }
                                }
                                NeonButton { text: "Backup"; implicitWidth: 1.8 * unit; onClicked: tuneManager.idBackup() }
                                NeonButton { text: "View"; implicitWidth: 1.8 * unit; onClicked: tuneManager.idRestore() }
                            }

                            Rectangle { Layout.fillWidth: true; height: 1; color: "#3a2266" }

                            RowLayout {
                                Layout.fillWidth: true
                                spacing: 0.15 * unit
                                ColumnLayout {
                                    Layout.fillWidth: true
                                    spacing: 0
                                    LText { text: "Shared"; font.pixelSize: 0.26 * unit; color: swTheme.neonGreen }
                                    NText {
                                        font.pixelSize: 0.2 * unit
                                        color: "#9d8ac0"
                                        text: tuneManager.fullBackup ? Qt.formatDateTime(tuneManager.fullBackup.date) : "none yet"
                                    }
                                }
                                NeonButton { text: "Backup"; implicitWidth: 1.8 * unit; onClicked: tuneManager.globalBackup() }
                                NeonButton { text: "View"; implicitWidth: 1.8 * unit; onClicked: tuneManager.globalRestore() }
                            }
                        }

                        Item { Layout.fillWidth: true; height: 0.2 * unit }
                    }
                }

                ScrollView {
                    Layout.fillWidth: true
                    Layout.fillHeight: true
                    contentWidth: availableWidth
                    clip: true

                    ColumnLayout {
                        width: parent.width
                        spacing: 0.25 * unit

                        SettingsCard {
                            title: "DASHBOARD"

                            IntTextField {
                                label: "Speed dial max"
                                valueUnit: vescConfig.speedUnit
                                sourceValue: preferences.speedDialMax
                                minValue: 10
                                maxValue: 200
                                onValueChanged: {
                                    preferences.speedDialMax = value
                                }
                            }

                            RightSwitch {
                                id: prefShowBattVoltage
                                checked: true
                                label: "Show battery voltage"
                            }

                            RightSwitch {
                                id: prefShowBattVoltagePerCell
                                label: "Battery voltage per cell"
                            }

                            RightSwitch {
                                id: prefBattCurrentLog
                                checked: true
                                label: "Log scale for the battery current bar"
                            }

                            IntTextField {
                                label: "Temperature warning offset"
                                valueUnit: "\u00B0C"
                                sourceValue: preferences.tempWarningOffset
                                onValueChanged: {
                                    preferences.tempWarningOffset = value
                                }
                            }

                            OptionDescription {
                                Layout.topMargin: 0
                                text: "Temps turn red above TEMP - OFFSET (TEMP = Motor / MOSFET Temp Cutoff Start). Beep at TEMP - 3\u00B0C, pushback at TEMP - 2\u00B0C."
                            }
                        }

                        SettingsCard {
                            title: "TUNES"

                            RowLayout {
                                Layout.fillWidth: true

                                LText {
                                    color: swTheme.neonGreen  // rf81: neon settings text
                                    text: "Tune slots"
                                }

                                Slider {
                                    id: prefTuneSlotCount
                                    Layout.fillWidth: true

                                    from: 2
                                    to: tuneManager.maxTunes
                                    value: 4
                                    stepSize: 1
                                }

                                Text {
                                    text: prefTuneSlotCount.value
                                    color: swTheme.neonGreen
                                    font.family: "Exan"
                                    font.pixelSize: 0.32 * unit
                                }
                            }

                            RightSwitch {
                                id: prefShowTuneDiffCount
                                checked: false
                                label: "Show changed options count"
                            }
                        }

                        SettingsCard {
                            title: "DATA & APP"

                            IntTextField {
                                label: "Realtime plot window"
                                valueUnit: "min"
                                sourceValue: preferences.plotMaxWindowMinutes
                                minValue: 1
                                maxValue: 1000
                                onValueChanged: {
                                    preferences.plotMaxWindowMinutes = value
                                }
                            }

                            RightSwitch {
                                id: prefShowWelcomeDialog
                                visible: false  // rf90: the welcome dialog no longer opens
                                checked: true
                                label: "Show Welcome dialog"
                            }

                            RightSwitch {
                                id: prefCheckForNewVersions
                                checked: true
                                label: "Check for new package versions"
                            }

                            NeonButton {
                                Layout.alignment: Qt.AlignHCenter
                                text: "Show tips & tricks"
                                onClicked: {
                                    settingsDialog.close();
                                    rinkTour.open();  // rf87: Neon Future tour of the Refloat Glow features
                                }
                            }
                        }

                        // rf182: MAX AIR (ported from FloPilot)
                        SettingsCard {
                            title: "MAX AIR"
                            RightSwitch {
                                label: "Show MAX AIR"
                                checked: swSettings.airShow
                                onCheckedChanged: swSettings.airShow = checked
                            }
                            SetupDescription {
                                text: "Air time off jumps, read from the tire: the board must be balancing with your feet on the pads, the tire spinning free, then a landing. 0.3 s and up. Just for fun: it can miss small hops."
                            }
                            Text {
                                Layout.fillWidth: true
                                text: "AIR RECORDS"
                                color: swTheme.neonPurple
                                font.family: "Exan"
                                font.pixelSize: 0.24 * unit
                            }
                            SetupDescription {
                                horizontalAlignment: Text.AlignLeft
                                text: { airTime.cur; swSettings.airRecords; return airTime.recordsText(); }
                            }
                            NeonButton {
                                id: airClearBtn
                                Layout.alignment: Qt.AlignHCenter
                                property bool sure: false
                                text: sure ? "Tap again to clear" : "Clear records"
                                onClicked: {
                                    if (!sure) { sure = true; return; }
                                    sure = false;
                                    airTime.clearAll();
                                    VescIf.emitStatusMessage("Air records cleared", true);
                                }
                            }
                        }

                        // rf182: UI
                        SettingsCard {
                            title: "UI"
                            RightSwitch {
                                label: "Overlap home screen"
                                checked: swSettings.sheetOverlap
                                onCheckedChanged: swSettings.sheetOverlap = checked
                            }
                            SetupDescription {
                                text: swSettings.sheetOverlap ? "ON: the swipe-up window slides over the home screen, which keeps its size." : "OFF: the home screen shrinks to make room for the swipe-up window."
                            }
                        }

                        Item { Layout.fillWidth: true; height: 0.2 * unit }
                    }
                }

                // rf167: RIDE - Refloat's own haptic feedback and pushback settings
                ScrollView {
                    id: settingsRidePage
                    Layout.fillWidth: true
                    Layout.fillHeight: true
                    contentWidth: availableWidth
                    clip: true

                    ColumnLayout {
                        width: parent.width
                        spacing: 0.25 * unit

                        SettingsCard {
                            id: settingsHapticCard  // Onboarding Tour target
                            title: "HAPTIC FEEDBACK"
                            SetupDescription {
                                text: "A warning tone through the motor at your duty or speed (Refloat's Haptic Feedback)."
                            }
                            NeonButton {
                                Layout.alignment: Qt.AlignHCenter
                                lit: hapticCfg.on
                                text: hapticCfg.on ? "Haptic feedback: ON ›" : "Haptic feedback: OFF ›"
                                onClicked: hapticCfg.openWindow()
                            }
                        }

                        // rf173: the controller beeper (Refloat's), moved here from LEDS
                        SettingsCard {
                            id: settingsBeeperCard  // Onboarding Tour target
                            title: "BEEPER"
                            Column {
                                Layout.fillWidth: true
                                spacing: 0.1 * unit
                        Row {
                            anchors.horizontalCenter: parent.horizontalCenter
                            spacing: 0.15 * unit
                            SwPill {
                                minWidth: 3.0 * unit
                                label: ledSender.ctrlBeep ? "BEEPER ON" : "BEEPER OFF"
                                lit: ledSender.ctrlBeep
                                onClicked: ledSender.setCtrlBeep(!ledSender.ctrlBeep)
                            }
                            SwPill {
                                minWidth: 3.0 * unit
                                label: "\u266A TEST BEEP"
                                lit: true
                                onClicked: {
                                    ledSender.testCtrlBeep();
                                    VescIf.emitStatusMessage(ledSender.ctrlBeep ? "Test beep sent to the controller"
                                        : "Controller beeper is off - turn it on to hear the test beep", true);
                                }
                            }
                        }
                        SwLText {
                            width: parent.width
                            horizontalAlignment: Text.AlignHCenter
                            wrapMode: Text.WordWrap
                            font.pixelSize: 0.22 * unit  // rf173: like the other Settings cards
                            text: "Refloat's beeper. OFF also mutes the warnings."
                        }
                        // rf157: Refloat's Persistent Fatal Error as a toggle, (?) explains
                        Row {
                            anchors.horizontalCenter: parent.horizontalCenter
                            spacing: 0.2 * unit
                            SwPill {
                                anchors.verticalCenter: parent.verticalCenter
                                minWidth: 6.15 * unit
                                label: ledSender.fatalPersist ? "PERSISTENT FATAL BEEP ON" : "PERSISTENT FATAL BEEP OFF"
                                lit: ledSender.fatalPersist
                                onClicked: ledSender.setFatalPersist(!ledSender.fatalPersist)
                            }
                            Rectangle {
                                anchors.verticalCenter: parent.verticalCenter
                                width: 0.5 * unit
                                height: width
                                radius: width / 2
                                color: fatalHelpArea.pressed ? swTheme.neonPurple : "transparent"
                                border.color: swTheme.neonPurple
                                border.width: 2
                                Text {
                                    anchors.centerIn: parent
                                    text: "?"
                                    color: fatalHelpArea.pressed ? swTheme.background : swTheme.neonGreen
                                    font.family: "Exan"
                                    font.pixelSize: 0.28 * unit
                                }
                                MouseArea {
                                    id: fatalHelpArea
                                    anchors.fill: parent
                                    anchors.margins: -0.2 * unit
                                    onClicked: fatalHelp.open()
                                }
                            }
                        }
                        SwLText {
                            width: parent.width
                            horizontalAlignment: Text.AlignHCenter
                            wrapMode: Text.WordWrap
                            font.pixelSize: 0.22 * unit  // rf173: like the other Settings cards
                            text: "Keeps beeping after a fault until the board is power-cycled."
                        }
                            }
                        }

                        SettingsCard {
                            id: settingsPushbackCard  // Onboarding Tour target
                            title: "PUSHBACK"
                            SetupDescription {
                                text: "When and how much the nose lifts to slow you down: duty, speed, battery voltage (Refloat's Pushback)."
                            }
                            NeonButton {
                                Layout.alignment: Qt.AlignHCenter
                                text: "Pushback settings ›"
                                onClicked: pushbackCfg.openWindow()
                            }
                        }

                        Item { Layout.fillWidth: true; height: 0.2 * unit }
                    }
                }

                // rf182: WATCHDOG - Ghosting Protection (ported from FloPilot)
                ScrollView {
                    id: settingsWatchdogPage
                    Layout.fillWidth: true
                    Layout.fillHeight: true
                    contentWidth: availableWidth
                    clip: true

                    ColumnLayout {
                        width: parent.width
                        spacing: 0.25 * unit

                        SettingsCard {
                            title: "GHOSTING PROTECTION"
                            Text {
                                Layout.fillWidth: true
                                horizontalAlignment: Text.AlignHCenter
                                font.family: "Exan"
                                font.pixelSize: 0.24 * unit
                                readonly property var st: { watchdog.rev;
                                    return watchdog.status === "check" ? ["MONITORING", "#39ff7a"] : watchdog.status === "wait" ? ["WAITING", "#f5ff3b"] : ["NOT MONITORING", "#ff8a1f"]; }
                                color: st[1]
                                text: st[0]
                            }
                            SetupDescription {
                                text: { watchdog.rev;
                                    return watchdog.status === "check" ? "Board parked: checking both pads."
                                        : watchdog.status === "wait" ? "Checks run when the board is stopped and parked on its tail (tilted " + swSettings.wdTail + "°+), so nobody is on it."
                                        : "No footpad data right now (not connected?). The board is not being watched."; }
                            }
                            RowLayout {
                                Layout.fillWidth: true
                                spacing: 0.2 * unit
                                Repeater {
                                    model: [1, 2]
                                    Rectangle {
                                        id: gz
                                        Layout.fillWidth: true
                                        implicitHeight: 2.2 * unit
                                        radius: 0.2 * unit
                                        color: "transparent"
                                        border.width: 2
                                        readonly property real v: { watchdog.rev; return watchdog.volts(modelData); }
                                        readonly property real swv: { watchdog.rev; return watchdog.sw(modelData); }
                                        readonly property bool live: { watchdog.rev; return watchdog.fresh(); }
                                        readonly property string lvl: live ? watchdog.classify(v, swv) : "ok"
                                        readonly property string held: { watchdog.rev; return watchdog.pads[modelData - 1].level; }
                                        readonly property bool off: { watchdog.rev; var e = watchdog.emerg(); return !!(e && e.applied && e.pad === modelData); }
                                        readonly property color c: live ? watchdog.color[lvl] : "#5c5470"
                                        border.color: c
                                        function pct(x) { return Math.max(0, Math.min(1, x / 3.3)); }
                                        Column {
                                            anchors.fill: parent
                                            anchors.margins: 0.12 * unit
                                            spacing: 0.04 * unit
                                            Text { anchors.horizontalCenter: parent.horizontalCenter; text: "ADC" + modelData; color: "#c98bff"; font.family: "Exan"; font.pixelSize: 0.22 * unit }
                                            Text { anchors.horizontalCenter: parent.horizontalCenter; text: (gz.live ? gz.v.toFixed(2) : "--") + " V"; color: gz.c; font.family: "Exan"; font.pixelSize: 0.42 * unit }
                                            Rectangle {
                                                width: parent.width; height: 0.14 * unit; radius: height / 2; color: "#1c1235"
                                                Rectangle { height: parent.height; radius: parent.radius; width: parent.width * (gz.live ? gz.pct(gz.v) : 0); color: gz.c }
                                                Repeater {
                                                    model: [[swSettings.wdEarly, "#f5ff3b"], [swSettings.wdHigh, "#ff8a1f"], [gz.swv, "#ff2b4f"]]
                                                    Rectangle { visible: modelData[0] > 0 && modelData[0] <= 3.3; x: parent.width * modelData[0] / 3.3; y: -0.05 * unit; width: 2; height: parent.height + 0.1 * unit; color: modelData[1] }
                                                }
                                            }
                                            Text {
                                                anchors.horizontalCenter: parent.horizontalCenter
                                                color: gz.c
                                                font.family: "Exan"
                                                font.pixelSize: 0.2 * unit
                                                text: !gz.live ? "—" : gz.off ? "SWITCHED OFF" : watchdog.word[gz.held !== "ok" ? gz.held : gz.lvl]
                                            }
                                            Text {
                                                anchors.horizontalCenter: parent.horizontalCenter
                                                color: "#9d8cc0"
                                                font.pixelSize: 0.17 * unit
                                                text: { watchdog.rev; var s = watchdog.stuckFor(modelData - 1); return s ? "above normal " + s + " s" : " "; }
                                            }
                                        }
                                    }
                                }
                            }
                            SetupDescription {
                                text: { watchdog.rev;
                                    return "Switch voltage: ADC1 " + watchdog.cfg("fault_adc1").toFixed(2) + " V · ADC2 " + watchdog.cfg("fault_adc2").toFixed(2) + " V · Posi " + (watchdog.cfg("fault_is_dual_switch") ? "ON" : "OFF")
                                        + "\nNormal 0–" + swSettings.wdEarly + " V · Early > " + swSettings.wdEarly + " V · High > " + swSettings.wdHigh + " V · Stuck ≥ switch voltage · " + swSettings.wdDur + " s"; }
                            }
                        }

                        SettingsCard {
                            title: "GHOSTING PAD EMERGENCY"
                            Column {
                                id: wdEmCard
                                Layout.fillWidth: true
                                spacing: 0.15 * unit
                                readonly property var e: { watchdog.rev; return watchdog.emerg(); }
                                readonly property bool emOn: !!(e && e.applied)
                                Text {
                                    visible: wdEmCard.emOn
                                    width: parent.width
                                    horizontalAlignment: Text.AlignHCenter
                                    wrapMode: Text.WordWrap
                                    color: "#ff2b4f"
                                    font.family: "Exan"
                                    font.pixelSize: 0.22 * unit
                                    text: "\u26A0 EMERGENCY SENSOR CONFIGURATION ON"
                                }
                                Text {
                                    width: parent.width
                                    horizontalAlignment: Text.AlignHCenter
                                    wrapMode: Text.WordWrap
                                    color: "#cbb8ec"
                                    font.pixelSize: 0.22 * unit
                                    text: { watchdog.rev; var e = wdEmCard.e, bad = watchdog.singleBad();
                                        if (wdEmCard.emOn) return "ADC" + e.pad + " switched off (" + watchdog.emergV.toFixed(1) + " V), Posi ON since " + new Date(e.t).toLocaleString() + ". Only ADC" + (e.pad === 1 ? 2 : 1) + " engages the board. Replace the faulty sensor before your next ride.";
                                        if (watchdog.both) return "Both pads look stuck: no single-pad emergency. Stop using the board.";
                                        return bad ? "ADC" + bad + " reads high. If that sensor has failed, this switches it off so ADC" + (bad === 1 ? 2 : 1) + " engages alone."
                                            : "Shows up when one pad reads HIGH or STUCK while the board is parked."; }
                                }
                                Text {
                                    visible: { watchdog.rev; return watchdog.changed(); }
                                    width: parent.width
                                    wrapMode: Text.WordWrap
                                    color: "#ff2b4f"
                                    font.pixelSize: 0.22 * unit
                                    text: { watchdog.rev; var e = watchdog.emerg(); return e ? "The board's footpad settings no longer match the emergency values (changed in VESC Tool?). ADC" + e.pad + " may be active again." : ""; }
                                }
                                Text {
                                    visible: wdEmCard.emOn
                                    width: parent.width
                                    wrapMode: Text.WordWrap
                                    color: "#cbb8ec"
                                    font.pixelSize: 0.22 * unit
                                    text: { var t = watchdog.test, e = watchdog.emerg(); if (!e) return ""; var g = e.pad === 1 ? 2 : 1;
                                        return "PAD TEST (board stopped, on its tail)\n"
                                            + (t.pressed ? "\u2713 " : "\u25CB ") + "Press ADC" + g + ": the board sees it\n"
                                            + (t.released ? "\u2713 " : "\u25CB ") + "Release ADC" + g + ": it goes off\n"
                                            + (t.badQuiet && t.released ? "\u2713 " : "\u25CB ") + "Touch ADC" + e.pad + ": it must stay off" + (t.badQuiet ? "" : "  \u2715 ADC" + e.pad + " still registers: don't ride, RESTORE"); }
                                }
                                NeonButton {
                                    anchors.horizontalCenter: parent.horizontalCenter
                                    visible: !wdEmCard.emOn
                                    opacity: { watchdog.rev; return watchdog.singleBad() ? 1 : 0.45; }
                                    text: "Emergency settings"
                                    onClicked: {
                                        var b = watchdog.singleBad();
                                        if (!b) { VescIf.emitStatusMessage(watchdog.both ? "Both pads look stuck: no single-pad emergency" : "Only when one pad reads HIGH or STUCK while parked", false); return; }
                                        wdEmergency.openFor(b);
                                    }
                                }
                                NeonButton {
                                    anchors.horizontalCenter: parent.horizontalCenter
                                    visible: wdEmCard.emOn
                                    text: "Restore original settings"
                                    onClicked: wdRestoreConfirm.open()
                                }
                            }
                        }

                        SettingsCard {
                            title: "HISTORY"
                            SetupDescription {
                                horizontalAlignment: Text.AlignLeft
                                text: { watchdog.rev; return watchdog.histText(); }
                            }
                            NeonButton {
                                Layout.alignment: Qt.AlignHCenter
                                text: "Clear history"
                                onClicked: watchdog.clearHist()
                            }
                        }

                        SettingsCard {
                            title: "RESTING VOLTAGE (DAILY)"
                            SetupDescription {
                                horizontalAlignment: Text.AlignLeft
                                text: { watchdog.rev; var d = watchdog.driftText(), t = watchdog.daysText();
                                    return (d ? d : "Builds up over a few days of parking the board: a slow rise means a sensor is wearing out.") + (t ? "\n" + t : ""); }
                            }
                        }

                        SettingsCard {
                            title: "ADVANCED"
                            SwStepper {
                                Layout.fillWidth: true
                                Layout.preferredHeight: 0.95 * unit
                                label: "EARLY ABOVE"
                                value: swSettings.wdEarly
                                from: 0.1; to: 1.0; step: 0.05; decimals: 2; suffix: " V"
                                onMoved: { if (newValue < swSettings.wdHigh) swSettings.wdEarly = Math.round(newValue * 100) / 100; }
                            }
                            SwStepper {
                                Layout.fillWidth: true
                                Layout.preferredHeight: 0.95 * unit
                                label: "HIGH ABOVE"
                                value: swSettings.wdHigh
                                from: 0.3; to: 3.0; step: 0.1; decimals: 1; suffix: " V"
                                onMoved: { if (newValue > swSettings.wdEarly) swSettings.wdHigh = Math.round(newValue * 10) / 10; }
                            }
                            SwStepper {
                                Layout.fillWidth: true
                                Layout.preferredHeight: 0.95 * unit
                                label: "HOLD FOR"
                                value: swSettings.wdDur
                                from: 3; to: 60; step: 1; suffix: " s"
                                onMoved: swSettings.wdDur = newValue
                            }
                            SwStepper {
                                Layout.fillWidth: true
                                Layout.preferredHeight: 0.95 * unit
                                label: "PARKED TILT"
                                value: swSettings.wdTail
                                from: 5; to: 30; step: 1; suffix: "°"
                                onMoved: swSettings.wdTail = newValue
                            }
                            NeonButton {
                                Layout.alignment: Qt.AlignHCenter
                                text: "Defaults"
                                onClicked: { swSettings.wdEarly = 0.2; swSettings.wdHigh = 1.0; swSettings.wdDur = 10; swSettings.wdTail = 10; }
                            }
                        }

                        Item { Layout.fillWidth: true; height: 0.2 * unit }
                    }
                }
            }
        }
    }

    BaseDialog {
        id: newPackageVersionDialog
        parent: ApplicationWindow.overlay

        title: "New Package Version"
        standardButtons: Dialog.Ok | Dialog.Abort

        property string version

        function show(newVersion) {
            version = newVersion;
            standardButton(Dialog.Abort).text = "Snooze for one month"

            open();
        }

        onRejected: {
            persistentData.packageUpdateSnooze = Date.now();
        }

        NText {
            width: newPackageVersionDialog.availableWidth
            font.pointSize: 12
            horizontalAlignment: Text.AlignHCenter
            wrapMode: TextEdit.WordWrap
            text: "New {{PACKAGE_NAME}} package version available: %1\n\nIt's recommended you update it in the Package Store.\n\nYour package configuration will be migrated automatically, no extra steps needed unless mentioned in package description. Having a manual XML or Start Page \"Backup Configs\" backup is still recommended.".arg(newPackageVersionDialog.version)
        }
    }

    // rf89: MAX SPEED - VESC's own Max ERPM (motor config), worked out from
    // the wheel diameter, motor poles and gear ratio set in VESC Tool. Near
    // the cap the motor's forward push fades to zero (ERPM Limit Start ->
    // Max ERPM) so a free-spinning tire coasts at about the cap; braking is
    // not limited. No package (C) change. Writes go read-modify-write: the
    // motor config is read fresh from the board first.
    Connections {
        id: maxSpeed
        property ConfigParams mc: VescIf.mcConfig()
        target: mc

        readonly property real erpmDefault: 100000  // VESC's default Max ERPM (no limit)
        readonly property real minKmh: 64.4  // 40 mph: lowest cap offered (rf96)
        readonly property real maxKmh: 120.7  // 75 mph
        property real wheelD: 0
        property int poles: 0
        property real gear: 1
        property real maxErpm: 0
        property real erpmStart: 0.8
        property int pending: 0  // 1 set, 2 remove (waiting for a fresh motor config)
        property real targetKmh: 72.4
        // ERPM per km/h: wheel turns per km/h x pole pairs x gear ratio
        readonly property real erpmPerKmh: wheelD > 0.05 && poles >= 2 ? (1000 / 60) / (Math.PI * wheelD) * (poles / 2) * gear : 0
        readonly property bool ready: erpmPerKmh > 0
        readonly property bool limited: ready && maxErpm > 0 && maxErpm < erpmDefault * 0.99
        readonly property real capKmh: limited ? maxErpm / erpmPerKmh : 0
        // rf96: a cap the rider set here (not a huge VESC Tool value): shown on the speedo
        readonly property bool shown: limited && capKmh < 161

        function load() {
            wheelD = mc.getParamDouble("si_wheel_diameter");
            poles = mc.getParamInt("si_motor_poles");
            gear = Math.max(0.01, mc.getParamDouble("si_gear_ratio"));
            maxErpm = mc.getParamDouble("l_max_erpm");
            erpmStart = mc.getParamDouble("l_erpm_start");
            if (!targetTouched && limited) targetKmh = Math.min(maxKmh, Math.max(minKmh, capKmh));
        }
        property bool targetTouched: false
        function onUpdated() {
            load();
            if (pending === 3) verify();
            else if (pending) apply();
        }
        // rf107: after a write the board's motor config is read back and checked
        property real expectErpm: 0
        property int verified: 0  // 0 not checked, 1 confirmed on the board, -1 mismatch / no answer
        property string verifyText: ""
        function verify() {
            pending = 0;
            maxSpeedTimer.stop();
            var got = mc.getParamDouble("l_max_erpm");
            var ok = Math.abs(got - expectErpm) <= 1 && Math.abs(mc.getParamDouble("l_min_erpm") + expectErpm) <= 1;
            verified = ok ? 1 : -1;
            verifyText = ok ? ("\u2714 Confirmed on the board: Max ERPM %1".arg(Math.round(got))
                               + (limited ? " = %1 %2".arg(Math.round(capKmh * vescConfig.imperialFactor)).arg(vescConfig.speedUnit) : " (no limit)"))
                            : "\u26A0 The board reports Max ERPM %1, not %2. Check Motor Settings \u203A General \u203A RPM in VESC Tool before riding.".arg(Math.round(got)).arg(Math.round(expectErpm));
            VescIf.emitStatusMessage(verifyText, ok);
        }
        function onParamChangedDouble(src, name, v) { if (name.indexOf("l_") === 0 || name.indexOf("si_") === 0) load(); }
        function onParamChangedInt(src, name, v) { if (name === "si_motor_poles") load(); }
        Component.onCompleted: load()

        function request(kind) {
            // rf107: VESC Tool in limited mode (firmware / app version mismatch)
            // can't read or write the motor config reliably: refuse
            if (typeof VescIf.getFwSupportsConfiguration === "function" && !VescIf.getFwSupportsConfiguration()) {
                VescIf.emitStatusMessage("VESC Tool is in limited mode (versions differ): motor settings can't be changed safely. Update VESC Tool or the firmware first.", false);
                return;
            }
            // writing the motor config resets the motor: never while riding
            if (boardRunning) {
                VescIf.emitStatusMessage("Stop riding first: the motor settings can't be changed while the board is engaged", false);
                return;
            }
            pending = kind;
            maxSpeedTimer.restart();
            vescCommands.getMcconf();  // apply() runs when it arrives
        }
        function apply() {
            var kind = pending;
            pending = 0;
            maxSpeedTimer.stop();
            if (boardRunning) return;
            if (!ready) {
                VescIf.emitStatusMessage("Set the wheel diameter and motor poles in VESC Tool first", false);
                return;
            }
            // VESC's optional overspeed fault would STOP the motor past Max ERPM
            var faults = mc.getParamInt("l_additional_faults");
            if (kind === 1 && faults > 0 && (faults & 2)) {
                VescIf.emitStatusMessage("Turn off the Overspeed fault (Motor Settings > General > Additional Faults) first: it stops the motor at the limit", false);
                return;
            }
            var e = kind === 1 ? Math.round(targetKmh * erpmPerKmh) : erpmDefault;
            mc.updateParamDouble("l_max_erpm", e);
            mc.updateParamDouble("l_min_erpm", -e);
            if (kind === 1 && mc.getParamDouble("l_erpm_start") < 0.95) {
                mc.updateParamDouble("l_erpm_start", 0.95);  // push fades only in the last 5%
            }
            vescCommands.setMcconf(false);
            load();
            // rf107: read it back from the board and check it took
            expectErpm = e;
            verified = 0;
            verifyText = "Checking the board\u2026";
            maxSpeedVerifyTimer.restart();
        }
        property Timer verifyTimer: Timer {
            id: maxSpeedVerifyTimer
            interval: 1500
            onTriggered: {
                maxSpeed.pending = 3;
                maxSpeedTimer.restart();
                vescCommands.getMcconf();  // verify() runs when it arrives
            }
        }
        property Timer timer: Timer {
            id: maxSpeedTimer
            interval: 4000
            onTriggered: {
                if (maxSpeed.pending === 3) {
                    maxSpeed.pending = 0;
                    maxSpeed.verified = -1;
                    maxSpeed.verifyText = "\u26A0 Couldn't read the motor settings back to confirm the limit. Check Motor Settings \u203A General \u203A RPM in VESC Tool before riding.";
                    VescIf.emitStatusMessage(maxSpeed.verifyText, false);
                } else if (maxSpeed.pending) {
                    maxSpeed.pending = 0;
                    VescIf.emitStatusMessage("Couldn't read the motor settings from the board - nothing changed", false);
                }
            }
        }
    }

    // rf93: shown each time the package UI opens, until "don't show again"
    BaseDialog {
        id: disclaimerDialog
        parent: ApplicationWindow.overlay
        title: "Before you start"
        standardButtons: Dialog.NoButton
        closePolicy: Popup.NoAutoClose
        onOpened: disclaimerHide.checked = false
        function finish() {
            mainItem.startNoticeDone = true;  // rf150: the tab watcher stops
            if (disclaimerHide.checked) swSettings.hideDisclaimerVer = "{{VERSION}}";
            close();
            rinkTour.open();  // rf178: the tour follows every start notice (SKIP to leave; "don't show again" stops both)
        }

        Column {
            width: disclaimerDialog.availableWidth
            spacing: 0.3 * unit

        // rf137: scrolls on small screens
        Flickable {
            width: disclaimerDialog.availableWidth
            height: Math.min(disclaimerCol.implicitHeight, (disclaimerDialog.parent ? disclaimerDialog.parent.height : 800) * 0.6)
            contentHeight: disclaimerCol.implicitHeight
            clip: true
            boundsBehavior: Flickable.StopAtBounds
            ScrollIndicator.vertical: ScrollIndicator {}

        Column {
            id: disclaimerCol
            width: disclaimerDialog.availableWidth
            spacing: 0.25 * unit

            // credit to Refloat, first thing on the notice
            Text {
                width: parent.width
                horizontalAlignment: Text.AlignHCenter
                wrapMode: Text.WordWrap
                color: swTheme.neonGreen
                font.pixelSize: fontSizeSmall * 1.05
                font.italic: true
                text: "None of this would be possible without all the hard work Lukáš Hrázký (lukash) and the Refloat community have put into Refloat. Thank you!"
            }

            // rf162: optional, understated donation link for Refloat (lukash).
            // Opens the external browser; no reminders, nothing else changes.
            Column {
                width: parent.width
                spacing: 0.12 * unit
                Text {
                    width: parent.width
                    horizontalAlignment: Text.AlignHCenter
                    color: swTheme.neonPurple
                    font.family: "Exan"
                    font.pixelSize: 0.22 * unit
                    font.letterSpacing: 0.02 * unit
                    text: "SUPPORT REFLOAT DEVELOPMENT"
                }
                Text {
                    width: parent.width
                    horizontalAlignment: Text.AlignHCenter
                    wrapMode: Text.WordWrap
                    color: "#d6ffe4"
                    font.pixelSize: fontSizeSmall
                    text: "Refloat is a community-driven project made possible by countless hours of work. If you'd like to show your appreciation and support its continued development, you can donate directly to Lukáš. Completely optional."
                }
                Rectangle {
                    anchors.horizontalCenter: parent.horizontalCenter
                    width: donateText.implicitWidth + 0.5 * unit
                    height: 0.55 * unit
                    radius: height / 2
                    color: donateArea.pressed ? swTheme.neonGreen : "transparent"
                    border.color: swTheme.neonGreen
                    border.width: 1
                    Text {
                        id: donateText
                        anchors.centerIn: parent
                        color: donateArea.pressed ? swTheme.background : swTheme.neonGreen
                        font.family: "Exan"
                        font.pixelSize: 0.2 * unit
                        text: "DONATE TO REFLOAT \u2197"
                    }
                    MouseArea {
                        id: donateArea
                        anchors.fill: parent
                        anchors.margins: -0.1 * unit
                        onClicked: Qt.openUrlExternally("https://riddimrider.one/donate/")
                    }
                }
            }

            NText {
                width: parent.width
                font.pointSize: 12
                wrapMode: Text.WordWrap
                text: "Refloat Glow is an unofficial side project, built for fun, to make a few things simpler, like the LED controls. It's not an official Refloat release.\n\n"
                    + "Everything in Refloat Glow works off your current Refloat settings: tunes, lights, sounds and the rest read and write Refloat's own configuration.\n\n"
                    + "To use its features properly you need a working board that is set up and rides correctly on Refloat, and working LEDs for the light features.\n\n"
                    + "Based on Refloat 1.2.3. Later Refloat versions are known to ride quite differently, so if you're coming back from a newer version your board will likely feel noticeably different.\n\n"
                    + "All credit goes to Lukáš Hrázký (lukash), the author of Refloat, and to the original Float package authors (Mitch Lustig, Dado Mista, Nico Aleman). I take zero credit for any of it.\n\n"
                    + "If something doesn't work, check the board and its Refloat settings in VESC Tool first. As always, ride at your own risk."
            }

            CheckBox {
                id: disclaimerHide
                width: parent.width
                text: "Don't show this again (until the next update)"
            }

        }
        }

        NeonButton {
            anchors.horizontalCenter: parent.horizontalCenter
            text: "Continue \u203A"
            lit: true
            onClicked: disclaimerDialog.finish()
        }
        }
    }

    // rf108: HAPTIC FEEDBACK - Refloat's own settings: Warning Audible Strength
    // (haptic.duty.strength, 0 = off) and the Duty Cycle / Speed Pushback
    // thresholds the tone plays at (tiltback_duty, tiltback_speed km/h)
    QtObject {
        id: hapticCfg
        property bool loaded: false
        property real strength: 3
        property real duty: 0.8
        property int speedKmh: 0
        readonly property bool on: strength > 0
        function cfg() { return packageConfig.pkgConfig; }
        function load() {
            if (!packageConfig.checkConfig()) return false;
            var c = cfg();
            strength = c.getParamDouble("haptic.duty.strength");
            duty = c.getParamDouble("tiltback_duty");
            speedKmh = c.getParamInt("tiltback_speed");
            loaded = true;
            return true;
        }
        function openWindow() {
            if (!load()) { VescIf.emitStatusMessage("Refloat's settings aren't loaded yet", false); return; }
            pushbackCfg.load();  // rf172: for the LINK TO PUSHBACK toggle
            hapticWindow.open();
        }
        function set(key, v) {
            if (!loaded) return;
            hapticCfg[key] = v;
            hapticWriteTimer.restart();
        }
        function write() {
            if (!packageConfig.checkConfig() || !loaded) return;
            if (mainItem.boardRunning) { hapticWriteTimer.restart(); return; }  // never mid-ride
            var c = cfg(), dirty = false;
            if (Math.abs(c.getParamDouble("haptic.duty.strength") - strength) > 0.001) { c.updateParamDouble("haptic.duty.strength", strength); dirty = true; }
            if (Math.abs(c.getParamDouble("tiltback_duty") - duty) > 0.0005) { c.updateParamDouble("tiltback_duty", duty); dirty = true; }
            if (c.getParamInt("tiltback_speed") !== speedKmh) { c.updateParamInt("tiltback_speed", speedKmh); dirty = true; }
            if (dirty) {
                packageConfig.writeConfig();
                cfgVerify.start({"haptic.duty.strength": strength, "tiltback_duty": duty, "tiltback_speed": speedKmh});  // rf167
                rideState.refresh();  // rf171
            }
        }
        property Timer writeTimer: Timer { id: hapticWriteTimer; interval: 1500; onTriggered: hapticCfg.write() }
    }

    BaseDialog {
        id: hapticWindow
        parent: ApplicationWindow.overlay
        title: "Haptic feedback"
        standardButtons: Dialog.Close

        Column {
            width: hapticWindow.availableWidth
            spacing: 0.2 * unit

            SwPill {
                anchors.horizontalCenter: parent.horizontalCenter
                minWidth: 3.6 * unit
                label: hapticCfg.on ? "HAPTIC FEEDBACK ON" : "HAPTIC FEEDBACK OFF"
                lit: hapticCfg.on
                onClicked: {
                    if (hapticCfg.on) { swSettings.hapticLast = hapticCfg.strength; hapticCfg.set("strength", 0); }
                    else hapticCfg.set("strength", swSettings.hapticLast > 0 ? swSettings.hapticLast : 3);
                }
            }
            // rf172: LINKED = the tone plays where the nose lifts (Refloat's normal
            // behaviour); OFF = tone only, no nose lift (Pushback Angle 0, the
            // same switch as Settings › RIDE › PUSHBACK ON / OFF)
            SwPill {
                anchors.horizontalCenter: parent.horizontalCenter
                minWidth: 3.6 * unit
                label: pushbackCfg.liftOn ? "LINKED TO PUSHBACK" : "NOT LINKED: TONE ONLY"
                lit: pushbackCfg.liftOn
                onClicked: pushbackCfg.liftOn ? pushbackOffConfirm.open() : pushbackCfg.setLift(true)
            }
            SwLText {
                width: parent.width
                horizontalAlignment: Text.AlignHCenter
                wrapMode: Text.WordWrap
                font.pixelSize: fontSizeSmall
                color: pushbackCfg.liftOn ? swTheme.neonGreen : "#ff2b4f"
                text: pushbackCfg.liftOn ? "The nose also lifts (pushback) at AT DUTY / AT SPEED."
                    : "Tone and beep only at AT DUTY / AT SPEED: the nose doesn't lift (pushback is off)."
            }
            SwStepper {
                visible: hapticCfg.on
                label: "STRENGTH"
                value: hapticCfg.strength
                from: 0.5; to: 12; step: 0.5; decimals: 1; suffix: " V"
                onMoved: hapticCfg.set("strength", newValue)
            }
            SwStepper {
                label: "AT DUTY"
                value: Math.round(hapticCfg.duty * 100)
                from: 50; to: 100; step: 1
                valueText: value >= 100 ? "OFF" : value + "%"
                onMoved: hapticCfg.set("duty", newValue / 100)
            }
            SwStepper {
                id: atSpeedStep
                label: "AT SPEED"
                // rf160: 1 mph (or km/h) steps in the rider's unit; Refloat keeps
                // whole km/h, and 1 mph <-> rounded km/h round-trips exactly.
                // Tap the number to type it (number pad, DONE).
                readonly property real f: vescConfig.imperialFactor > 0 ? vescConfig.imperialFactor : 1
                value: Math.round(hapticCfg.speedKmh * f)
                from: 0; to: Math.round(100 * f); step: 1
                editable: true
                valueText: value === 0 ? "OFF" : value + " " + vescConfig.speedUnit
                onMoved: hapticCfg.set("speedKmh", Math.round(newValue / f))
                onValueClicked: {
                    numPad.edit("AT SPEED (0 = OFF)", value, 0, to, vescConfig.speedUnit,
                        function (v) { hapticCfg.set("speedKmh", Math.round(v / atSpeedStep.f)); });
                }
            }
            SwLText {
                width: parent.width
                wrapMode: Text.WordWrap
                font.pixelSize: fontSizeSmall
                text: "A warning tone through the motor at the duty or speed set here (solid a little above it). "
                    + "Refloat's own settings: STRENGTH = Warning Audible Strength, AT DUTY / AT SPEED = its pushback thresholds, so the nose lifts there too unless PUSHBACK is OFF. Saved when the board is idle."
            }
            Text {
                width: parent.width
                wrapMode: Text.WordWrap
                font.pixelSize: fontSizeSmall
                color: "#ff2b4f"
                text: "Above about 85% duty there's little margin before the motor runs out of power. Not sure? Keep your old AT DUTY."
            }
            SwLText {  // rf167: read back from the board after each save
                visible: cfgVerify.text !== ""
                width: parent.width
                horizontalAlignment: Text.AlignHCenter
                wrapMode: Text.WordWrap
                font.pixelSize: fontSizeSmall
                color: cfgVerify.ok ? swTheme.neonGreen : "#FFB300"
                text: cfgVerify.text
            }
        }
    }

    // rf167: after a Refloat config write: wait for the board's ACK, read the
    // config back (VESC Tool loads it into the same ConfigParams) and compare
    QtObject {
        id: cfgVerify
        property var expected: null
        property int phase: 0  // 0 idle, 1 waiting for ACK, 2 waiting for the read-back
        property bool ok: false
        property string text: ""
        property var onDone: null  // rf182: called with ok after the read-back (or timeout)
        function finish(r) { if (onDone) { var f = onDone; onDone = null; f(r); } }
        function start(map, done) {
            expected = map;
            onDone = done || null;
            phase = 1;
            ok = false;
            text = "Saving to the board\u2026";
            cfgVerifyTimeout.restart();
        }
        function check() {
            if (phase !== 2 || !packageConfig.checkConfig()) return;
            phase = 0;
            cfgVerifyTimeout.stop();
            var bad = [];
            for (var k in expected) {
                var got = packageConfig.getParamValue(k);
                if (got === null || Math.abs(got - expected[k]) > 0.002) bad.push(k);
            }
            ok = bad.length === 0;
            text = ok ? "\u2714 Saved and confirmed on the board"
                : "\u26A0 The board reports different values (" + bad.join(", ") + "). Check Refloat Cfg in VESC Tool.";
            VescIf.emitStatusMessage(text, ok);
            finish(ok);
        }
        property Connections conns: Connections {
            target: vescCommands
            function onCustomConfigAckReceived(confId) {
                if (cfgVerify.phase === 1 && confId === 0) {
                    cfgVerify.phase = 2;
                    vescCommands.customConfigGet(0, false);
                }
            }
            function onCustomConfigRx(confInd, data) {
                if (cfgVerify.phase === 2 && confInd === 0) Qt.callLater(cfgVerify.check);
            }
        }
        property Timer timeout: Timer {
            id: cfgVerifyTimeout
            interval: 5000
            onTriggered: {
                if (cfgVerify.phase === 0) return;
                cfgVerify.phase = 0;
                cfgVerify.ok = false;
                cfgVerify.text = "\u26A0 Couldn't confirm the save. Check Refloat Cfg in VESC Tool.";
                cfgVerify.finish(false);
            }
        }
    }

    // rf167: plain explanation window for the (?) buttons
    BaseDialog {
        id: infoHelp
        parent: ApplicationWindow.overlay
        title: ""
        standardButtons: Dialog.NoButton
        property string body: ""
        function show(t, b) { title = t; body = b; open(); }
        footer: Item {
            implicitHeight: 1.2 * unit
            SwPill {
                anchors.centerIn: parent
                minWidth: 3.0 * unit
                label: "GOT IT"
                onClicked: infoHelp.close()
            }
        }
        Text {
            width: infoHelp.availableWidth
            wrapMode: Text.WordWrap
            color: "#ead6ff"
            font.pixelSize: 0.3 * unit
            lineHeight: 1.15
            text: infoHelp.body
        }
    }

    // rf171: what the home screen notes show, from the board's Refloat config
    // (read on every config update, and after our own writes)
    QtObject {
        id: rideState
        property bool known: false
        property bool pushbackOn: true
        property bool hapticOn: true
        function refresh() {
            var c = packageConfig.pkgConfig;
            known = !!c && VescIf.isPortConnected() && state.pkgState !== state.s_Connecting;
            if (!c) return;
            // duty / speed pushback (the nose lift): Refloat lifts to
            // tiltback_duty_angle at either threshold; 0 = no lift (Refloat
            // then only beeps / plays the haptic tone there)
            var ang = c.getParamDouble("tiltback_duty_angle");
            var duty = c.getParamDouble("tiltback_duty"), spd = c.getParamInt("tiltback_speed");
            pushbackOn = ang > 0 && (duty < 0.995 || spd > 0);
            hapticOn = c.getParamDouble("haptic.duty.strength") > 0;
        }
        property Connections conns: Connections {
            target: packageConfig
            function onUpdate() { rideState.refresh(); }
        }
        property Timer poll: Timer {  // connection / state changes
            interval: 1000
            repeat: true
            running: true
            onTriggered: rideState.refresh()
        }
    }

    // rf182: DISABLE MOVING FAULTS (CONTROL) - Refloat's own
    // fault_moving_fault_disabled, with Refloat's warning before it turns on.
    // Written only while the board is stopped, then read back.
    QtObject {
        id: dmfCfg
        property bool on: false
        property bool known: false
        function refresh() {
            var c = packageConfig.pkgConfig;
            known = !!c && VescIf.isPortConnected();
            if (c) on = c.getParamBool("fault_moving_fault_disabled");
        }
        function set(v) {
            if (!packageConfig.checkConfig()) { VescIf.emitStatusMessage("Refloat's settings aren't loaded yet", false); return; }
            if (mainItem.boardRunning) { VescIf.emitStatusMessage("Stop the board first: DMF only saves while the board is stopped", false); return; }
            var c = packageConfig.pkgConfig;
            if (c.getParamBool("fault_moving_fault_disabled") === v) { on = v; return; }
            c.updateParamBool("fault_moving_fault_disabled", v);
            packageConfig.writeConfig();
            cfgVerify.start({"fault_moving_fault_disabled": v ? 1 : 0});
            on = v;
            VescIf.emitStatusMessage(v ? "DMF on" : "DMF off: the footpad can stop the board again", true);
        }
        property Connections conns: Connections {
            target: packageConfig
            function onUpdate() { dmfCfg.refresh(); }
        }
        property Timer poll: Timer { interval: 1500; repeat: true; running: true; onTriggered: dmfCfg.refresh() }
    }

    BaseDialog {
        id: dmfConfirm
        parent: ApplicationWindow.overlay
        title: "⚠ Disable moving faults"
        titleColor: "#ff2b4f"
        standardButtons: Dialog.Ok | Dialog.Cancel
        onOpened: standardButton(Dialog.Ok).text = "Turn DMF on"
        onAccepted: dmfCfg.set(true)
        Text {
            width: dmfConfirm.availableWidth
            wrapMode: Text.WordWrap
            color: "#ead6ff"
            font.pixelSize: 0.3 * unit
            lineHeight: 1.15
            text: "While you ride forward above twice the Half State Fault ERPM, with the board within 40° of level, lifting off the footpad sensor won't disengage the board. Outside that, the sensor works as usual.\n\n"
                + "Refloat's warning: needs correct speed calibration and a tail-heavy board. The board WILL ghost if your normal speeds read negative or the board is nose-heavy."
        }
    }

    // rf182: MAX AIR (ported from FloPilot) - air time off jumps, read from the
    // tire (Refloat's realtime data has no accelerometer). STRICT: balancing
    // with a footpad pressed the whole time, the motor carrying a rider in
    // the second before take-off, Refloat's wheelslip flag with low motor
    // current (tire unloaded), a landing current spike, the rider still on
    // after it, 0.3-3 s, no data gaps. Display only: writes nothing to the board.
    QtObject {
        id: airTime
        readonly property real minS: 0.3
        readonly property real maxS: 3.0
        readonly property real lowA: 15
        readonly property real landA: 25
        readonly property real preA: 8
        readonly property real postA: 6
        property string st: "ground"
        property double t0: 0
        property double last: 0
        property double land: 0
        property bool ok: true
        property var pre: []
        property var post: []
        property var cur: ({"max": 0, "total": 0, "jumps": 0, "start": 0})
        property double lastTach: -1

        function key() { return board.getId() || "board"; }
        function all() { try { return JSON.parse(swSettings.airRecords) || {}; } catch (e) { return {}; } }
        function mine(o) {
            var k = key();
            if (!o[k]) o[k] = {"name": board.getName() || k, "cur": {"max": 0, "total": 0, "jumps": 0, "start": Date.now()}, "trips": [], "best": 0};
            return o[k];
        }
        function load() { cur = mine(all()).cur; }
        function best() { return mine(all()).best || 0; }
        function reset() { st = "ground"; pre = []; post = []; last = 0; }

        // one realtime sample
        function feed(t, running, pads, slip, amps) {
            var gap = last > 0 && t - last > 300;
            last = t;
            var a = Math.abs(amps);
            if (amps !== amps) a = 0;  // NaN
            if (st === "cool") { if (!slip) st = "ground"; return; }
            if (st === "ground") {
                if (gap) pre = [];
                var loaded = false;
                for (var i = 0; i < pre.length; i++) if (pre[i][1] >= preA) loaded = true;
                if (running && pads && slip && a < lowA) {
                    st = "air"; t0 = t; ok = loaded; land = 0; post = [];
                    return;
                }
                pre.push([t, a]);
                while (pre.length && t - pre[0][0] > 1000) pre.shift();
                return;
            }
            if (gap || !running || !pads) ok = false;
            if (st === "air") {
                var spike = a >= landA;
                if (spike && t - t0 >= 100) { st = "landed"; land = t; }
                else if (!slip && a >= lowA) ok = false;
                else if (!slip && t - t0 > 200) { st = "ground"; return; }
                if (t - t0 > maxS * 1000) st = "cool";
                return;
            }
            post.push(a);
            if (t - land >= 400) {
                var s = 0;
                for (var j = 0; j < post.length; j++) s += post[j];
                var sec = (land - t0) / 1000, good = ok && s / post.length >= postA && sec >= minS && sec <= maxS;
                st = "ground"; pre = [];
                if (good) landed(Math.round(sec * 100) / 100);
            }
        }
        function landed(sec) {
            var o = all(), b = mine(o);
            b.cur.jumps++;
            b.cur.total = Math.round((b.cur.total + sec) * 100) / 100;
            var rec = sec > b.cur.max;
            if (rec) b.cur.max = sec;
            var isBest = sec > (b.best || 0);
            if (isBest) b.best = sec;
            swSettings.airRecords = JSON.stringify(o);
            cur = b.cur;
            if (swSettings.airShow) VescIf.emitStatusMessage("Air " + sec.toFixed(2) + " s" + (isBest ? " · new board record!" : rec ? " · new trip max" : ""), true);
        }
        // the board's trip counter went back (power cycle): keep the trip, start a new one
        function onTach(tach) {
            if (lastTach >= 0 && tach < lastTach) {
                var o = all(), b = mine(o);
                if (b.cur.jumps) { b.trips.unshift(Object.assign({"end": Date.now()}, b.cur)); b.trips = b.trips.slice(0, 50); }
                b.cur = {"max": 0, "total": 0, "jumps": 0, "start": Date.now()};
                swSettings.airRecords = JSON.stringify(o);
                cur = b.cur;
            }
            lastTach = tach;
        }
        function resetMax() {
            var o = all(), b = mine(o);
            b.cur.max = 0;
            swSettings.airRecords = JSON.stringify(o);
            cur = b.cur;
            VescIf.emitStatusMessage("Max air reset", true);
        }
        function clearAll() { swSettings.airRecords = "{}"; load(); }
        function recordsText() {
            var o = all(), out = [];
            for (var k in o) {
                var b = o[k], rows = [];
                if (b.cur.jumps) rows.push("This trip: max " + b.cur.max.toFixed(2) + " s, total " + b.cur.total.toFixed(2) + " s, " + b.cur.jumps + " jumps");
                for (var i = 0; i < Math.min(20, b.trips.length); i++) {
                    var t = b.trips[i];
                    rows.push(new Date(t.start).toLocaleDateString() + ": max " + t.max.toFixed(2) + " s, total " + t.total.toFixed(2) + " s, " + t.jumps + " jumps");
                }
                if (rows.length) out.push(b.name + " · BEST " + (b.best || 0).toFixed(2) + " s\n" + rows.join("\n"));
            }
            return out.length ? out.join("\n\n") : "No jumps yet.";
        }
        Component.onCompleted: load()
    }

    BaseDialog {
        id: airDetails
        parent: ApplicationWindow.overlay
        title: "Air time"
        standardButtons: Dialog.Close
        Column {
            width: airDetails.availableWidth
            spacing: 0.2 * unit
            Row {
                anchors.horizontalCenter: parent.horizontalCenter
                spacing: 0.15 * unit
                Repeater {
                    model: [[airTime.cur.max.toFixed(2) + "s", "MAX AIR"], [airTime.cur.total.toFixed(2) + "s", "TOTAL AIR"], ["" + airTime.cur.jumps, "JUMPS"]]
                    Rectangle {
                        width: 2.4 * unit
                        height: 1.1 * unit
                        radius: 0.12 * unit
                        color: "transparent"
                        border.color: swTheme.neonPurple
                        border.width: 2
                        Text { anchors.horizontalCenter: parent.horizontalCenter; y: 0.1 * unit; text: modelData[0]; color: swTheme.neonGreen; font.family: "Exan"; font.pixelSize: 0.38 * unit }
                        Text { anchors.horizontalCenter: parent.horizontalCenter; anchors.bottom: parent.bottom; anchors.bottomMargin: 0.1 * unit; text: modelData[1]; color: "#c98bff"; font.family: "Exan"; font.pixelSize: 0.17 * unit }
                    }
                }
            }
            SwLText {
                width: parent.width
                horizontalAlignment: Text.AlignHCenter
                wrapMode: Text.WordWrap
                font.pixelSize: fontSizeSmall
                text: "This trip. Board record: " + airTime.best().toFixed(2) + " s. Hold the MAX AIR box to reset max air; past trips: Settings › PREFERENCES › MAX AIR."
            }
        }
    }

    // rf182: WATCHDOG - Ghosting Protection (ported from FloPilot, Settings ›
    // WATCHDOG). Watches ADC1 / ADC2 (Refloat's realtime footpad volts); a
    // stuck-sensor check only counts with the board stopped, not balancing and
    // parked on its tail / nose (tilted past wdTail degrees), held wdDur s.
    // Levels: OK / EARLY (> wdEarly V) / HIGH (> wdHigh V) / STUCK (at / over
    // the pad's switch voltage). Both STUCK = possible ghosting.
    // Ghosting Pad Emergency (the user's tested workaround, never automatic):
    // the bad pad's switch voltage to 5.0 V (past Refloat's 3.3 V editor
    // limit, so it can't trip) + Posi ON, so the good pad engages alone.
    // Refuses unless stopped, the good pad reads normal and is on, and the bad
    // pad reads under 4 V; read back after saving; originals kept for RESTORE;
    // tunes / config restores can't put the footpad settings back meanwhile.
    // Refloat 1.2.3 footpad logic (src/footpad_sensor.c): pressed = volts >
    // switch voltage; one pad at 0 V = ignored; BOTH at 0 V = always pressed.
    QtObject {
        id: watchdog
        readonly property real emergV: 5.0
        property string status: "nodata"  // nodata | wait | check
        property var pads: [{"level": "ok", "cand": "ok", "since": 0}, {"level": "ok", "cand": "ok", "since": 0}]
        property bool both: false
        property double lastRt: 0
        property var lastNote: ({})
        property int rev: 0  // bumps on any change, for bindings
        property var test: ({"pressed": false, "released": false, "badQuiet": true})
        readonly property var color: ({"ok": "#39ff7a", "early": "#f5ff3b", "high": "#ff8a1f", "crit": "#ff2b4f"})
        readonly property var word: ({"ok": "OK", "early": "EARLY", "high": "HIGH", "crit": "STUCK"})
        readonly property var rank: ({"ok": 0, "early": 1, "high": 2, "crit": 3})

        function key() { return board.getId() || "board"; }
        function all() { try { return JSON.parse(swSettings.wdData) || {}; } catch (e) { return {}; } }
        function mine(o) { var k = key(); if (!o[k]) o[k] = {"hist": [], "days": {}}; return o[k]; }
        function store(o) { swSettings.wdData = JSON.stringify(o); rev++; }
        function emerg() { return mine(all()).emerg || null; }
        function cfg(n) { var c = packageConfig.pkgConfig; return c ? packageConfig.getParamValue(n) : NaN; }
        // the voltage a pad is judged against (the original one while the emergency is on)
        function sw(i) { var e = emerg(); return e && e.pad === i ? e.orig["fault_adc" + i] : cfg("fault_adc" + i); }
        function classify(v, s) {
            if (v !== v) return "ok";
            if (s > 0 && v >= s) return "crit";
            if (v > swSettings.wdHigh) return "high";
            if (v > swSettings.wdEarly) return "early";
            return "ok";
        }
        function volts(i) { return state.rtData["footpad.adc" + i]; }
        function fresh() { return VescIf.isPortConnected() && Date.now() - lastRt < 2500 && volts(1) === volts(1); }

        function tick() {
            var now = Date.now(), i;
            protect();
            if (!fresh()) { status = "nodata"; for (i = 0; i < 2; i++) { pads[i].cand = pads[i].level; pads[i].since = now; } rev++; return; }
            var spd = Math.abs(state.rtData["motor.speed"]), pitch = Math.abs(state.rtData["imu.pitch"]);
            var unloaded = state.pkgState !== state.s_Running && !(spd >= 0.8) && pitch >= swSettings.wdTail;
            if (!unloaded) { status = "wait"; for (i = 0; i < 2; i++) { pads[i].cand = pads[i].level; pads[i].since = now; } rev++; testStep(); return; }
            status = "check";
            for (i = 0; i < 2; i++) {
                var p = pads[i], v = volts(i + 1), lvl = classify(v, sw(i + 1));
                if (lvl !== p.cand) { p.cand = lvl; p.since = now; }
                if (lvl !== p.level && now - p.since >= swSettings.wdDur * 1000) {
                    var up = rank[lvl] > rank[p.level];
                    p.level = lvl;
                    if (up) event(i + 1, lvl, v);
                    else if (lvl === "ok") VescIf.emitStatusMessage("ADC" + (i + 1) + " back to normal", true);
                }
            }
            var b = pads[0].level === "crit" && pads[1].level === "crit";
            if (b && !both) event(0, "crit", Math.max(volts(1), volts(2)));
            both = b;
            sample();
            testStep();
            rev++;
        }
        function stuckFor(i) { var p = pads[i]; return status === "check" && p.cand !== "ok" ? Math.round((Date.now() - p.since) / 1000) : 0; }
        function record(pad, level, v) {
            var o = all(), m = mine(o);
            m.hist.unshift({"t": Date.now(), "pad": pad, "level": level, "v": Math.round((v || 0) * 100) / 100});
            m.hist = m.hist.slice(0, 50);
            store(o);
        }
        function ack() { var o = all(), m = mine(o); if (m.hist.length) { m.hist[0].ack = Date.now(); store(o); } }
        function event(pad, level, v) {
            var e = emerg();
            if (e && pad === e.pad) return;  // the pad the emergency already switched off
            var goodStuck = e && pad && pad !== e.pad && level === "crit";
            record(pad, goodStuck || !pad ? "crit-both" : level, v);
            var k = pad + level;
            if (Date.now() - (lastNote[k] || 0) < 600000) return;  // no repeats within 10 min
            lastNote[k] = Date.now();
            if (!pad || goodStuck) {
                wdAlert.show("‼ CRITICAL — POSSIBLE GHOSTING HAZARD",
                    (goodStuck ? "The remaining footpad sensor appears stuck active (the other one is already switched off by the emergency setting). "
                               : "Both footpad sensors appear stuck active. ") + "Your Onewheel may engage unexpectedly without a rider.\n\nStop using the board and disable the Float Package when safe. Keep clear of the wheel; power the board off if you can.", true);
            } else if (level === "crit") {
                wdAlert.show("⚠ ADC" + pad + " LOOKS STUCK",
                    "ADC" + pad + " reads " + v.toFixed(2) + " V (at or over its switch voltage) for " + swSettings.wdDur + " s while the board is parked on its tail, so nobody should be on it.\n\nCheck the sensor and its plug before riding. If the sensor has failed, Settings › WATCHDOG has a Ghosting Pad Emergency setting to get you home on the other pad.", false);
            } else {
                wdBanner.show("ADC" + pad + " " + (level === "early" ? "EARLY WARNING" : "HIGH WARNING") + ": " + v.toFixed(2) + " V with nobody on the board. Tap for WATCHDOG.", color[level]);
            }
        }
        function day(t) { var d = new Date(t); return d.getFullYear() + "-" + ("0" + (d.getMonth() + 1)).slice(-2) + "-" + ("0" + d.getDate()).slice(-2); }
        property int sampleN: 0
        function sample() {
            var a1 = volts(1), a2 = volts(2);
            if (!(a1 <= swSettings.wdHigh && a2 <= swSettings.wdHigh)) return;
            if (++sampleN % 10 !== 1) return;  // every 10 s while parked
            var o = all(), m = mine(o), d = day(Date.now()), x = m.days[d] || {"s1": 0, "s2": 0, "n": 0};
            if (x.n >= 360) return;
            x.s1 += a1; x.s2 += a2; x.n++;
            m.days[d] = x;
            var ks = Object.keys(m.days).sort();
            while (ks.length > 60) delete m.days[ks.shift()];
            store(o);
        }
        function driftText() {
            var m = mine(all()), ks = Object.keys(m.days).sort(), today = day(Date.now()), t = m.days[today];
            if (!t || !t.n) return "";
            var prev = ks.filter(function (k) { return k < today; }).slice(-7).map(function (k) { return m.days[k]; }).filter(function (x) { return x.n; });
            if (prev.length < 2) return "";
            var out = [];
            for (var i = 1; i <= 2; i++) {
                var base = 0;
                for (var j = 0; j < prev.length; j++) base += prev[j]["s" + i] / prev[j].n;
                var dv = t["s" + i] / t.n - base / prev.length;
                out.push("ADC" + i + " resting " + (dv >= 0 ? "+" : "") + dv.toFixed(2) + " V vs last week" + (dv >= 0.1 ? " ⚠ rising" : ""));
            }
            return out.join(" · ");
        }
        function daysText() {
            var m = mine(all()), ks = Object.keys(m.days).sort().slice(-7).reverse();
            return ks.map(function (k) { var x = m.days[k]; return k.slice(5) + "   ADC1 " + (x.s1 / x.n).toFixed(2) + " V   ADC2 " + (x.s2 / x.n).toFixed(2) + " V"; }).join("\n");
        }
        function histText() {
            var h = mine(all()).hist;
            if (!h.length) return "No warnings yet.";
            var lv = {"early": "EARLY", "high": "HIGH", "crit": "STUCK", "crit-both": "BOTH / GHOSTING", "emerg": "EMERGENCY ON", "restore": "RESTORED"};
            return h.map(function (x) { return new Date(x.t).toLocaleString() + "  " + (x.pad ? "ADC" + x.pad : "BOTH") + "  " + (lv[x.level] || x.level) + "  " + x.v.toFixed(2) + " V" + (x.ack ? " ✓" : ""); }).join("\n");
        }
        function clearHist() { var o = all(); mine(o).hist = []; store(o); }

        // the single faulty pad (HIGH or STUCK), or 0
        function singleBad() {
            if (both) return 0;
            var b = [1, 2].filter(function (i) { return rank[pads[i - 1].level] >= 2; });
            return b.length === 1 ? b[0] : 0;
        }
        // the emergency plan for pad `bad`: {err} or {values, orig}
        function plan(bad) {
            if (bad !== 1 && bad !== 2) return {"err": "Pick the faulty pad"};
            if (!packageConfig.checkConfig()) return {"err": "Refloat's settings aren't loaded yet"};
            if (!fresh()) return {"err": "No live footpad readings"};
            var spd = Math.abs(state.rtData["motor.speed"]);
            if (mainItem.boardRunning || spd >= 0.8) return {"err": "Stop the board first (not balancing, not rolling)"};
            var good = bad === 1 ? 2 : 1, gv = volts(good), bv = volts(bad), gsw = cfg("fault_adc" + good);
            if (!(gsw > 0)) return {"err": "ADC" + good + " is switched off in Refloat (0 V): the board would have no working pad"};
            if (gv > swSettings.wdEarly) return {"err": "ADC" + good + " (the good pad) also reads high (" + gv.toFixed(2) + " V). Both pads may be faulty: no single-pad emergency"};
            if (bv >= 4.0) return {"err": "ADC" + bad + " reads " + bv.toFixed(2) + " V: too close to 5.0 V, the switch-off may not hold on this controller"};
            var vals = {}; vals["fault_adc" + bad] = emergV; vals["fault_is_dual_switch"] = true;
            return {"good": good, "values": vals, "orig": {"fault_adc1": cfg("fault_adc1"), "fault_adc2": cfg("fault_adc2"), "fault_is_dual_switch": !!cfg("fault_is_dual_switch")}};
        }
        // write the footpad settings, read them back, then done(ok)
        function writeFootpad(values, done) {
            var c = packageConfig.pkgConfig, exp = {};
            for (var k in values) {
                if (typeof values[k] === "boolean") { c.updateParamBool(k, values[k]); exp[k] = values[k] ? 1 : 0; }
                else { c.updateParamDouble(k, values[k]); exp[k] = values[k]; }
            }
            packageConfig.writeConfig();
            cfgVerify.start(exp, done);
        }
        function apply(bad) {
            var p = plan(bad);
            if (p.err) { VescIf.emitStatusMessage(p.err, false); return; }
            var o = all(), m = mine(o);
            m.emerg = {"pad": bad, "orig": p.orig, "t": Date.now(), "applied": false};  // originals first
            store(o);
            writeFootpad(p.values, function (ok) {
                var o2 = all(), m2 = mine(o2);
                var on = ok || Math.abs(cfg("fault_adc" + bad) - emergV) < 0.01;
                if (on) { m2.emerg.applied = true; store(o2); record(bad, "emerg", volts(bad)); }
                else { delete m2.emerg; store(o2); }
                protect();
                test = {"pressed": false, "released": false, "badQuiet": true};
                VescIf.emitStatusMessage(ok ? "Emergency settings saved and read back. Do the PAD TEST before riding"
                    : on ? "Couldn't confirm every value: the board shows the emergency switch voltage. Check Refloat Cfg; RESTORE is in WATCHDOG"
                    : "The board didn't take the emergency settings: nothing changed. Check Refloat Cfg in VESC Tool", ok);
            });
        }
        function restore() {
            var e = emerg();
            if (!e) return;
            if (mainItem.boardRunning) { VescIf.emitStatusMessage("Stop the board first", false); return; }
            unprotect();
            writeFootpad(e.orig, function (ok) {
                if (!ok) { protect(); VescIf.emitStatusMessage("Couldn't confirm the restore: check Refloat Cfg in VESC Tool", false); return; }
                var o = all(), m = mine(o);
                delete m.emerg;
                store(o);
                record(e.pad, "restore", volts(e.pad));
                protect();
                VescIf.emitStatusMessage("Original settings restored. Test both pads before riding", true);
            });
        }
        // keys a tune / config restore must not change while the emergency is on
        property var protectedKeys: ({})
        function protect() {
            var e = emerg(), k = {};
            if (e && e.applied) { k["fault_adc" + e.pad] = emergV; k["fault_is_dual_switch"] = true; }
            protectedKeys = k;
        }
        function unprotect() { protectedKeys = ({}); }
        function isProtected(n) { return protectedKeys[n] !== undefined; }
        // VESC Tool (or anything else) changed the emergency values on the board
        function changed() {
            var e = emerg();
            if (!e || !e.applied || !packageConfig.pkgConfig) return false;
            return Math.abs(cfg("fault_adc" + e.pad) - emergV) > 0.01 || !cfg("fault_is_dual_switch");
        }
        // pad test: press the good pad (on), release (off), touch the bad pad (stays off)
        function testStep() {
            var e = emerg();
            if (!e || !e.applied) return;
            var g = e.pad === 1 ? 2 : 1, st = state.fpState;
            var goodOn = !!(st & (g === 1 ? state.fs_Left : state.fs_Right)), badOn = !!(st & (e.pad === 1 ? state.fs_Left : state.fs_Right));
            var t = {"pressed": test.pressed || goodOn, "released": test.released || (test.pressed && !goodOn), "badQuiet": test.badQuiet && !badOn};
            test = t;
        }
        property Timer timer: Timer { interval: 1000; repeat: true; running: true; onTriggered: watchdog.tick() }
    }

    // rf182: WATCHDOG warning banner (EARLY / HIGH) - tap opens Settings › WATCHDOG
    Popup {
        id: wdBanner
        parent: ApplicationWindow.overlay
        x: 0.2 * unit
        y: 0.2 * unit
        width: (parent ? parent.width : 0) - 0.4 * unit
        modal: false
        closePolicy: Popup.NoAutoClose
        padding: 0
        property color tone: "#f5ff3b"
        property string text: ""
        function show(t, c) { text = t; tone = c; open(); wdBannerTimer.restart(); }
        background: Rectangle { color: "#0b0718"; radius: 0.2 * unit; border.color: wdBanner.tone; border.width: 2 }
        contentItem: Text {
            padding: 0.2 * unit
            wrapMode: Text.WordWrap
            color: wdBanner.tone
            font.pixelSize: 0.26 * unit
            text: wdBanner.text + "   ✕"
            MouseArea { anchors.fill: parent; onClicked: { wdBanner.close(); if (mouse.x < width * 0.85) settingsDialog.show(3); } }
        }
        property Timer hide: Timer { id: wdBannerTimer; interval: 20000; onTriggered: wdBanner.close() }
    }

    // rf182: WATCHDOG window for STUCK / CRITICAL
    BaseDialog {
        id: wdAlert
        parent: ApplicationWindow.overlay
        titleColor: "#ff2b4f"
        standardButtons: Dialog.NoButton
        property string body: ""
        property bool critical: false
        function show(t, b, c) { title = t; body = b; critical = c; open(); }
        footer: Item {
            implicitHeight: wdAlertBtns.implicitHeight + 0.4 * unit
            Flow {
                id: wdAlertBtns
                anchors.centerIn: parent
                width: parent.width - 0.4 * unit
                spacing: 0.15 * unit
                SwPill { label: "DIAGNOSTICS"; minWidth: 2.4 * unit; onClicked: { wdAlert.close(); settingsDialog.show(3); } }
                SwPill {
                    visible: wdAlert.critical
                    label: "DISABLE PACKAGE"; minWidth: 2.4 * unit; litColor: "#ff2b4f"
                    onClicked: {
                        if (mainItem.boardRunning || Math.abs(state.rtData["motor.speed"]) >= 0.8) { VescIf.emitStatusMessage("The board is balancing or rolling: only when stopped", false); return; }
                        wdAlert.close(); wdDisableConfirm.open();
                    }
                }
                SwPill { label: wdAlert.critical ? "ACK / FALSE POSITIVE" : "ACKNOWLEDGE"; minWidth: 2.4 * unit; onClicked: { watchdog.ack(); wdAlert.close(); } }
            }
        }
        Text {
            width: wdAlert.availableWidth
            wrapMode: Text.WordWrap
            color: "#ead6ff"
            font.pixelSize: 0.28 * unit
            lineHeight: 1.15
            text: wdAlert.body
        }
    }

    BaseDialog {
        id: wdDisableConfirm
        parent: ApplicationWindow.overlay
        title: "Disable package?"
        titleColor: "#ff2b4f"
        standardButtons: Dialog.Ok | Dialog.Cancel
        onOpened: standardButton(Dialog.Ok).text = "Disable"
        onAccepted: packageConfig.setDisabled(true)
        Text {
            width: wdDisableConfirm.availableWidth
            wrapMode: Text.WordWrap
            color: "#ead6ff"
            font.pixelSize: 0.3 * unit
            text: "Turns Refloat off (its own Disable setting): the board will not balance or engage until you enable it again in Settings › SETUP."
        }
    }

    // rf182: Ghosting Pad Emergency window
    BaseDialog {
        id: wdEmergency
        parent: ApplicationWindow.overlay
        title: "⚠ Emergency sensor configuration"
        titleColor: "#ff2b4f"
        implicitHeight: fullHeight
        standardButtons: Dialog.NoButton
        property int pick: 1
        property bool agreed: false
        property var p: ({})
        function openFor(bad) { pick = bad; agreed = false; open(); refresh(); }
        function refresh() { p = watchdog.plan(pick); }
        property Timer t: Timer { interval: 1000; repeat: true; running: wdEmergency.visible; onTriggered: wdEmergency.refresh() }
        footer: Item {
            implicitHeight: 1.2 * unit
            Row {
                anchors.centerIn: parent
                spacing: 0.3 * unit
                SwPill { label: "CANCEL"; minWidth: 2.4 * unit; onClicked: wdEmergency.close() }
                SwPill {
                    label: "APPLY"; minWidth: 2.4 * unit; litColor: "#ff2b4f"
                    enabledLook: wdEmergency.agreed && !wdEmergency.p.err
                    onClicked: {
                        if (!wdEmergency.agreed) { VescIf.emitStatusMessage("Tick the box first", false); return; }
                        wdEmergency.refresh();
                        if (wdEmergency.p.err) { VescIf.emitStatusMessage(wdEmergency.p.err, false); return; }
                        wdEmergency.close();
                        watchdog.apply(wdEmergency.pick);
                    }
                }
            }
        }
        ScrollView {
            anchors.fill: parent
            contentWidth: availableWidth
            clip: true
            Column {
                width: wdEmergency.availableWidth
                spacing: 0.2 * unit
                Text {
                    width: parent.width
                    wrapMode: Text.WordWrap
                    color: "#ead6ff"
                    font.bold: true
                    font.pixelSize: 0.27 * unit
                    text: "This configuration is intended for emergency recovery when one footpad sensor has failed. It reduces rider-presence detection redundancy and may change engagement or stopping behavior. Replace the faulty sensor before your next ride."
                }
                Row {
                    anchors.horizontalCenter: parent.horizontalCenter
                    spacing: 0.2 * unit
                    Repeater {
                        model: [1, 2]
                        SwPill {
                            readonly property real v: { watchdog.rev; return watchdog.volts(modelData); }
                            minWidth: 3.6 * unit
                            lit: wdEmergency.pick === modelData
                            litColor: "#ff2b4f"
                            label: "ADC" + modelData + (wdEmergency.pick === modelData ? " FAULTY" : " OK") + " · " + (v === v ? v.toFixed(2) + " V" : "--")
                            onClicked: { wdEmergency.pick = modelData; wdEmergency.refresh(); }
                        }
                    }
                }
                SwLText {
                    width: parent.width
                    wrapMode: Text.WordWrap
                    font.pixelSize: fontSizeSmall
                    text: { watchdog.rev; var g = wdEmergency.pick === 1 ? 2 : 1;
                        return "Now: ADC1 " + watchdog.cfg("fault_adc1").toFixed(2) + " V · ADC2 " + watchdog.cfg("fault_adc2").toFixed(2) + " V · Posi " + (watchdog.cfg("fault_is_dual_switch") ? "ON" : "OFF")
                            + "\nNew: ADC" + wdEmergency.pick + " " + watchdog.emergV.toFixed(2) + " V (never reached: switched off) · ADC" + g + " unchanged · Posi ON"
                            + "\nOnly ADC" + g + " will engage the board. Your original values are kept for RESTORE."; }
                }
                Text {
                    visible: !!wdEmergency.p.err
                    width: parent.width
                    wrapMode: Text.WordWrap
                    color: "#ff2b4f"
                    font.pixelSize: 0.26 * unit
                    text: wdEmergency.p.err || ""
                }
                Text {
                    width: parent.width
                    wrapMode: Text.WordWrap
                    color: "#c98bff"
                    font.pixelSize: 0.22 * unit
                    text: "Not a repair and not guaranteed safe for riding. The heel-lift (half-switch) stop is gone; only the good pad tells the board you're on it. It works only while the bad pad reads under 5.0 V, so the app checks that first; check it on the bench on your controller."
                }
                Row {
                    width: parent.width
                    spacing: 0.1 * unit
                    CheckBox {
                        id: wdAgree
                        anchors.verticalCenter: parent.verticalCenter
                        checked: wdEmergency.agreed
                        onToggled: wdEmergency.agreed = checked
                    }
                    Text {
                        anchors.verticalCenter: parent.verticalCenter
                        width: parent.width - wdAgree.width - 0.1 * unit
                        wrapMode: Text.WordWrap
                        color: "#ead6ff"
                        font.pixelSize: 0.26 * unit
                        text: "I understand. The board is stopped and nobody is on it."
                        MouseArea { anchors.fill: parent; onClicked: wdEmergency.agreed = !wdEmergency.agreed }
                    }
                }
            }
        }
    }

    BaseDialog {
        id: wdRestoreConfirm
        parent: ApplicationWindow.overlay
        title: "Restore original settings"
        standardButtons: Dialog.Ok | Dialog.Cancel
        onOpened: standardButton(Dialog.Ok).text = "Restore"
        onAccepted: watchdog.restore()
        Text {
            width: wdRestoreConfirm.availableWidth
            wrapMode: Text.WordWrap
            color: "#ead6ff"
            font.pixelSize: 0.3 * unit
            text: { watchdog.rev; var e = watchdog.emerg();
                return e ? "Puts back ADC1 " + e.orig.fault_adc1.toFixed(2) + " V, ADC2 " + e.orig.fault_adc2.toFixed(2) + " V, Posi " + (e.orig.fault_is_dual_switch ? "ON" : "OFF") + ".\n\nOnly after the sensor has been inspected, repaired or replaced and tested. A still-faulty pad becomes active again." : ""; }
        }
    }

    // rf167: Settings › RIDE › PUSHBACK - Refloat 1.2.3's own pushback /
    // tiltback settings (Refloat Cfg), with Refloat's ranges and steps. Read
    // from the board's config when the window opens, written only while the
    // board is stopped, then read back to confirm. No new behaviour.
    QtObject {
        id: pushbackCfg
        property bool loaded: false
        property var v: ({})
        // name: [type, min, max]  (Refloat's settings.xml limits)
        readonly property var spec: ({
            "tiltback_duty": ["d", 0, 1], "tiltback_duty_angle": ["d", 0, 30], "tiltback_duty_speed": ["d", 0, 30],
            "tiltback_speed": ["i", 0, 100],
            "tiltback_hv": ["d", 0, 150], "tiltback_hv_angle": ["d", 0, 30], "tiltback_hv_speed": ["d", 0, 30],
            "tiltback_lv": ["d", 0, 150], "tiltback_lv_angle": ["d", 0, 30], "tiltback_lv_speed": ["d", 0, 30],
            "tiltback_return_speed": ["d", 0, 10],
            "tiltback_constant": ["d", -10, 10], "tiltback_constant_erpm": ["i", 200, 100000],
            "tiltback_variable": ["d", 0, 5], "tiltback_variable_max": ["d", -10, 10], "tiltback_variable_erpm": ["i", 0, 100000]
        })
        function load() {
            if (!packageConfig.checkConfig()) return false;
            var c = packageConfig.pkgConfig, o = {};
            for (var k in spec) o[k] = spec[k][0] === "i" ? c.getParamInt(k) : c.getParamDouble(k);
            v = o;
            loaded = true;
            return true;
        }
        function val(k) { return v[k] !== undefined ? v[k] : 0; }
        function openWindow() {
            if (!load()) { VescIf.emitStatusMessage("Refloat's settings aren't loaded yet", false); return; }
            pushbackWindow.open();
        }
        function set(k, x) {
            if (!loaded || !spec[k]) return;
            x = Math.max(spec[k][1], Math.min(spec[k][2], x));
            if (spec[k][0] === "i") x = Math.round(x);
            var o = {};
            for (var n in v) o[n] = v[n];
            o[k] = x;
            v = o;  // a new object so the bindings update
            pushbackWriteTimer.restart();
        }
        function write() {
            if (!packageConfig.checkConfig() || !loaded) return;
            if (mainItem.boardRunning) { pushbackWriteTimer.restart(); return; }  // never mid-ride
            var c = packageConfig.pkgConfig, dirty = {}, any = false;
            for (var k in spec) {
                if (spec[k][0] === "i") {
                    if (c.getParamInt(k) !== v[k]) { c.updateParamInt(k, v[k]); dirty[k] = v[k]; any = true; }
                } else if (Math.abs(c.getParamDouble(k) - v[k]) > 0.0005) {
                    c.updateParamDouble(k, v[k]); dirty[k] = v[k]; any = true;
                }
            }
            if (any) {
                packageConfig.writeConfig();
                cfgVerify.start(dirty);
                rideState.refresh();
            }
        }
        property Timer writeTimer: Timer { id: pushbackWriteTimer; interval: 1500; onTriggered: pushbackCfg.write() }
        // rf171: PUSHBACK ON / OFF = the duty / speed nose lift (Pushback Angle).
        // OFF = angle 0: Refloat keeps the thresholds, beeps and the haptic tone
        // there, but the nose doesn't lift. HV / LV pushback are not touched.
        readonly property bool liftOn: val("tiltback_duty_angle") > 0
        function setLift(on) {
            if (on) set("tiltback_duty_angle", swSettings.pbLastAngle > 0 ? swSettings.pbLastAngle : 5);
            else {
                if (val("tiltback_duty_angle") > 0) swSettings.pbLastAngle = val("tiltback_duty_angle");
                set("tiltback_duty_angle", 0);
            }
        }
    }

    BaseDialog {
        id: pushbackOffConfirm
        parent: ApplicationWindow.overlay
        title: "\u26A0 Turn pushback off?"
        titleColor: "#ff2b4f"
        standardButtons: Dialog.Ok | Dialog.Cancel
        onOpened: standardButton(Dialog.Ok).text = "Turn off"
        onAccepted: pushbackCfg.setLift(false)
        Text {
            width: pushbackOffConfirm.availableWidth
            wrapMode: Text.WordWrap
            color: "#ead6ff"
            font.pixelSize: 0.3 * unit
            lineHeight: 1.15
            text: "The nose won't lift at AT DUTY or AT SPEED; you only get the beep and haptic tone.\n\nNear max duty the motor runs out of power: riding past it causes a nosedive. Battery voltage pushback stays on."
        }
    }

    BaseDialog {
        id: pushbackWindow
        parent: ApplicationWindow.overlay
        title: "Pushback"
        implicitHeight: fullHeight
        standardButtons: Dialog.NoButton
        property bool advanced: false
        footer: Item {
            implicitHeight: 1.2 * unit
            SwPill {
                anchors.centerIn: parent
                minWidth: 3.0 * unit
                label: "CLOSE"
                onClicked: pushbackWindow.close()
            }
        }

        ScrollView {
            anchors.fill: parent
            contentWidth: availableWidth
            clip: true

            Column {
                width: pushbackWindow.availableWidth
                spacing: 0.2 * unit

                SwLText {
                    width: parent.width
                    horizontalAlignment: Text.AlignHCenter
                    wrapMode: Text.WordWrap
                    font.pixelSize: fontSizeSmall
                    text: "Pushback lifts the nose to slow you down. Refloat's own settings; changes save while the board is stopped."
                }
                SwLText {
                    visible: mainItem.boardRunning
                    width: parent.width
                    horizontalAlignment: Text.AlignHCenter
                    wrapMode: Text.WordWrap
                    font.pixelSize: fontSizeSmall
                    color: "#FFB300"
                    text: "The board is running: changes wait until it stops."
                }

                // rf171: the simple view: PUSHBACK ON / OFF and the two thresholds
                SwPill {
                    anchors.horizontalCenter: parent.horizontalCenter
                    minWidth: 3.6 * unit
                    label: pushbackCfg.liftOn ? "PUSHBACK ON" : "PUSHBACK OFF"
                    lit: pushbackCfg.liftOn
                    onClicked: pushbackCfg.liftOn ? pushbackOffConfirm.open() : pushbackCfg.setLift(true)
                }
                Text {
                    visible: !pushbackCfg.liftOn
                    width: parent.width
                    horizontalAlignment: Text.AlignHCenter
                    wrapMode: Text.WordWrap
                    font.pixelSize: fontSizeSmall
                    color: "#ff2b4f"
                    text: "Pushback is off: at AT DUTY / AT SPEED you only get the beep and haptic tone. Battery voltage pushback stays on."
                }

                LedCard {
                    width: parent.width
                    SwCardHead {
                        title: "DUTY & SPEED"
                        helpText: "Duty pushback starts at AT DUTY (100% = off). The real maximum is about 95%: reaching it means a nosedive, so start well before.\n\nSpeed pushback starts at AT SPEED (0 = off).\n\nBoth lift the nose to ANGLE at RATE (ADVANCED). A fast rate can be dangerous.\n\nHaptic Feedback uses the same AT DUTY / AT SPEED. PUSHBACK OFF keeps the tone and beep but stops the nose lift."
                    }
                    SwStepper {
                        width: parent.width
                        label: "AT DUTY"
                        value: Math.round(pushbackCfg.val("tiltback_duty") * 100)
                        from: 50; to: 100; step: 1
                        valueText: value >= 100 ? "OFF" : value + "%"
                        onMoved: pushbackCfg.set("tiltback_duty", newValue / 100)
                    }
                    SwStepper {
                        id: pbSpeedStep
                        width: parent.width
                        label: "AT SPEED"
                        readonly property real f: vescConfig.imperialFactor > 0 ? vescConfig.imperialFactor : 1
                        value: Math.round(pushbackCfg.val("tiltback_speed") * f)
                        from: 0; to: Math.round(100 * f); step: 1
                        editable: true
                        valueText: value === 0 ? "OFF" : value + " " + vescConfig.speedUnit
                        onMoved: pushbackCfg.set("tiltback_speed", Math.round(newValue / f))
                        onValueClicked: numPad.edit("AT SPEED (0 = OFF)", value, 0, to, vescConfig.speedUnit,
                            function (x) { pushbackCfg.set("tiltback_speed", Math.round(x / pbSpeedStep.f)); })
                    }
                    SwStepper {
                        visible: pushbackWindow.advanced && pushbackCfg.liftOn
                        width: parent.width
                        label: "ANGLE"
                        value: pushbackCfg.val("tiltback_duty_angle")
                        from: 0; to: 30; step: 1; decimals: 1; suffix: "\u00B0"
                        onMoved: pushbackCfg.set("tiltback_duty_angle", newValue)
                    }
                    SwStepper {
                        visible: pushbackWindow.advanced && pushbackCfg.liftOn
                        width: parent.width
                        label: "RATE"
                        value: pushbackCfg.val("tiltback_duty_speed")
                        from: 0; to: 30; step: 0.5; decimals: 1; suffix: "\u00B0/s"
                        onMoved: pushbackCfg.set("tiltback_duty_speed", newValue)
                    }
                    Text {
                        visible: pushbackCfg.val("tiltback_duty") > 0.85 && pushbackCfg.val("tiltback_duty") < 1
                        width: parent.width
                        wrapMode: Text.WordWrap
                        font.pixelSize: fontSizeSmall
                        color: "#ff2b4f"
                        text: "Duty above about 85% leaves little margin before the motor runs out of power."
                    }
                }

                SwPill {
                    anchors.horizontalCenter: parent.horizontalCenter
                    minWidth: 3.6 * unit
                    label: pushbackWindow.advanced ? "HIDE ADVANCED" : "SHOW ADVANCED"
                    lit: pushbackWindow.advanced
                    onClicked: pushbackWindow.advanced = !pushbackWindow.advanced
                }

                // rf167: no extra properties on a LedCard instance: with one, its
                // children skip the card's content column (same as the rf150 head/tail bug)
                LedCard {
                    id: pbHvCard
                    visible: pushbackWindow.advanced
                    width: parent.width
                    SwCardHead { title: "HIGH VOLTAGE"; helpText: "Pushback above this voltage, mostly braking or downhill on a full battery (the tail can drag, take care). Per cell on VESC 6.05+ (default 4.30 V), pack total on 6.02. ANGLE = how far, RATE = how fast." }
                    SwStepper {
                        width: parent.width
                        label: "AT"
                        value: pushbackCfg.val("tiltback_hv")
                        from: 0; to: 150; step: 0.05; decimals: 2; suffix: " V"
                        onMoved: pushbackCfg.set("tiltback_hv", newValue)
                    }
                    SwStepper {
                        width: parent.width
                        label: "ANGLE"
                        value: pushbackCfg.val("tiltback_hv_angle")
                        from: 0; to: 30; step: 1; decimals: 1; suffix: "\u00B0"
                        onMoved: pushbackCfg.set("tiltback_hv_angle", newValue)
                    }
                    SwStepper {
                        width: parent.width
                        label: "RATE"
                        value: pushbackCfg.val("tiltback_hv_speed")
                        from: 0; to: 30; step: 0.5; decimals: 1; suffix: "\u00B0/s"
                        onMoved: pushbackCfg.set("tiltback_hv_speed", newValue)
                    }
                }

                // rf167: no extra properties on a LedCard instance: with one, its
                // children skip the card's content column (same as the rf150 head/tail bug)
                LedCard {
                    id: pbLvCard
                    visible: pushbackWindow.advanced
                    width: parent.width
                    SwCardHead { title: "LOW VOLTAGE"; helpText: "Pushback below this voltage, before the pack sags too far. Per cell on VESC 6.05+ (default 3.00 V), pack total on 6.02. Keep it above your battery's real cut-off. ANGLE = how far, RATE = how fast." }
                    SwStepper {
                        width: parent.width
                        label: "AT"
                        value: pushbackCfg.val("tiltback_lv")
                        from: 0; to: 150; step: 0.05; decimals: 2; suffix: " V"
                        onMoved: pushbackCfg.set("tiltback_lv", newValue)
                    }
                    SwStepper {
                        width: parent.width
                        label: "ANGLE"
                        value: pushbackCfg.val("tiltback_lv_angle")
                        from: 0; to: 30; step: 1; decimals: 1; suffix: "\u00B0"
                        onMoved: pushbackCfg.set("tiltback_lv_angle", newValue)
                    }
                    SwStepper {
                        width: parent.width
                        label: "RATE"
                        value: pushbackCfg.val("tiltback_lv_speed")
                        from: 0; to: 30; step: 0.5; decimals: 1; suffix: "\u00B0/s"
                        onMoved: pushbackCfg.set("tiltback_lv_speed", newValue)
                    }
                }

                LedCard {
                    visible: pushbackWindow.advanced
                    width: parent.width
                    SwCardHead { title: "RETURN"; helpText: "How fast the nose comes back to level after a pushback ends." }
                    SwStepper {
                        width: parent.width
                        label: "RETURN RATE"
                        value: pushbackCfg.val("tiltback_return_speed")
                        from: 0; to: 10; step: 0.5; decimals: 1; suffix: "\u00B0/s"
                        onMoved: pushbackCfg.set("tiltback_return_speed", newValue)
                    }
                }


                LedCard {
                    visible: pushbackWindow.advanced
                    width: parent.width
                    SwCardHead {
                        title: "CONSTANT TILTBACK"
                        helpText: "A fixed nose angle above a minimum ERPM (negative = nose down). Not for tilted rails: fix the IMU calibration instead.\n\nERPM = RPM \u00D7 poles / 2. 11\" tire + Hypercore (30 poles): 1000 ERPM \u2248 2.2 mph."
                    }
                    SwStepper {
                        width: parent.width
                        label: "ANGLE"
                        value: pushbackCfg.val("tiltback_constant")
                        from: -10; to: 10; step: 0.2; decimals: 1; suffix: "\u00B0"
                        onMoved: pushbackCfg.set("tiltback_constant", newValue)
                    }
                    SwStepper {
                        id: pbConstErpm
                        width: parent.width
                        label: "ABOVE ERPM"
                        value: pushbackCfg.val("tiltback_constant_erpm")
                        from: 200; to: 100000; step: 50
                        editable: true
                        onMoved: pushbackCfg.set("tiltback_constant_erpm", newValue)
                        onValueClicked: numPad.edit("CONSTANT TILTBACK ERPM", value, 200, 100000, "ERPM",
                            function (x) { pushbackCfg.set("tiltback_constant_erpm", x); })
                    }
                }

                LedCard {
                    visible: pushbackWindow.advanced
                    width: parent.width
                    SwCardHead {
                        title: "VARIABLE TILTBACK"
                        helpText: "Above START ERPM the nose moves toward TARGET (can be negative) at RATE degrees per 1000 ERPM. Adds to Constant Tiltback; doesn't affect the alert pushbacks.\n\n11\" tire + Hypercore (30 poles): 1000 ERPM \u2248 2.2 mph."
                    }
                    SwStepper {
                        width: parent.width
                        label: "RATE"
                        value: pushbackCfg.val("tiltback_variable")
                        from: 0; to: 5; step: 0.05; decimals: 2; suffix: "\u00B0/k"
                        onMoved: pushbackCfg.set("tiltback_variable", newValue)
                    }
                    SwStepper {
                        width: parent.width
                        label: "TARGET"
                        value: pushbackCfg.val("tiltback_variable_max")
                        from: -10; to: 10; step: 0.2; decimals: 1; suffix: "\u00B0"
                        onMoved: pushbackCfg.set("tiltback_variable_max", newValue)
                    }
                    SwStepper {
                        id: pbVarErpm
                        width: parent.width
                        label: "START ERPM"
                        value: pushbackCfg.val("tiltback_variable_erpm")
                        from: 0; to: 100000; step: 50
                        editable: true
                        onMoved: pushbackCfg.set("tiltback_variable_erpm", newValue)
                        onValueClicked: numPad.edit("VARIABLE TILTBACK START ERPM", value, 0, 100000, "ERPM",
                            function (x) { pushbackCfg.set("tiltback_variable_erpm", x); })
                    }
                }

                SwLText {
                    visible: cfgVerify.text !== ""
                    width: parent.width
                    horizontalAlignment: Text.AlignHCenter
                    wrapMode: Text.WordWrap
                    font.pixelSize: fontSizeSmall
                    color: cfgVerify.ok ? swTheme.neonGreen : "#FFB300"
                    text: cfgVerify.text
                }
                Item { width: 1; height: 0.2 * unit }
            }
        }
    }

    // rf96: terms before the MAX SPEED window opens (every time)
    BaseDialog {
        id: maxSpeedTerms
        parent: ApplicationWindow.overlay
        title: "\u26A0 Max speed limiter"
        titleColor: "#ff2b4f"
        standardButtons: Dialog.Ok | Dialog.Cancel

        onOpened: {
            maxSpeedAck.checked = false;
            standardButton(Dialog.Ok).text = "Continue";
            standardButton(Dialog.Ok).enabled = false;
        }
        onAccepted: if (maxSpeedAck.checked) maxSpeedPanel.open()

        // rf176: scrolls on small screens (longer explanation)
        Flickable {
            width: maxSpeedTerms.availableWidth
            height: Math.min(maxSpeedTermsCol.implicitHeight, (maxSpeedTerms.parent ? maxSpeedTerms.parent.height : 800) * 0.62)
            contentHeight: maxSpeedTermsCol.implicitHeight
            clip: true
            boundsBehavior: Flickable.StopAtBounds
            ScrollIndicator.vertical: ScrollIndicator {}
        Column {
            id: maxSpeedTermsCol
            width: maxSpeedTerms.availableWidth
            spacing: 0.25 * unit

            NText {
                width: parent.width
                font.pointSize: 12
                wrapMode: Text.WordWrap
                text: "For limiting how fast the tire free-spins in the air (off a jump). It sets VESC's Max ERPM from your wheel diameter; off unless you set it."
            }

            // rf107: the warning in red
            Text {
                width: parent.width
                font.pointSize: 12
                font.bold: true
                wrapMode: Text.WordWrap
                color: "#ff2b4f"
                text: "WARNING: the limit also applies while riding. If you ever reach this speed on the ground, the motor can no longer push the nose back up and the board WILL NOSEDIVE."
            }

            // rf176: VERIFY YOUR SPEED - how the limit is worked out, from what
            Text {
                width: parent.width
                font.pointSize: 13
                font.bold: true
                wrapMode: Text.WordWrap
                horizontalAlignment: Text.AlignHCenter
                color: "#FFB300"
                text: "\u26A0 VERIFY YOUR SPEED IS CORRECT"
            }
            NText {
                width: parent.width
                font.pointSize: 12
                wrapMode: Text.WordWrap
                text: "The limit is VESC's Max ERPM (motor electrical RPM), worked out from Motor Settings \u203A Additional Info: wheel diameter, motor poles and gear ratio.\n\n"
                    + "ERPM = wheel RPM \u00D7 gear ratio \u00D7 motor poles \u00F7 2 (electrical RPM counts pole pairs: a 30-pole Hypercore has 15).\n\n"
                    + (maxSpeed.ready
                        ? "Your board now: wheel " + (maxSpeed.wheelD * 39.3701).toFixed(1) + "\" (" + Math.round(maxSpeed.wheelD * 1000) + " mm), " + maxSpeed.poles + " poles, gear " + maxSpeed.gear.toFixed(2)
                            + " \u2192 1 " + vescConfig.speedUnit + " \u2248 " + Math.round(maxSpeed.erpmPerKmh / vescConfig.imperialFactor) + " ERPM."
                        : "Your board's motor settings aren't read yet.")
            }
            Text {
                width: parent.width
                font.pointSize: 12
                font.bold: true
                wrapMode: Text.WordWrap
                color: "#ff2b4f"
                text: "If any of these is entered wrong, the app's speed is wrong too and the limit kicks in at a different real speed: the board can NOSEDIVE sooner than you expect."
            }
            NText {
                width: parent.width
                font.pointSize: 12
                wrapMode: Text.WordWrap
                text: "Check first: compare the speed here with a GPS speed app at a steady speed. If they differ, fix the values in VESC Tool before setting a limit.\n\n"
                    + "Set it well above your fastest riding. Re-check after changing the wheel or tire. Ride at your own risk."
            }

            CheckBox {
                id: maxSpeedAck
                width: parent.width
                text: "I understand and accept these terms"
                onCheckedChanged: maxSpeedTerms.standardButton(Dialog.Ok).enabled = checked
            }
        }
        }
    }

    // rf96: the MAX SPEED window (behind the terms)
    BaseDialog {
        id: maxSpeedPanel
        parent: ApplicationWindow.overlay
        title: "Max speed"
        onOpened: if (maxSpeed.pending === 0) maxSpeed.verifyText = ""
        standardButtons: Dialog.Close

        Column {
            width: maxSpeedPanel.availableWidth
            spacing: 0.2 * unit

            // rf89: MAX SPEED (VESC's Max ERPM from the wheel diameter)
            SwLText {
                width: parent.width
                horizontalAlignment: Text.AlignHCenter
                wrapMode: Text.WordWrap
                font.pixelSize: fontSizeSmall
                color: maxSpeed.limited ? swTheme.neonGreen : "#ead6ff"
                text: !maxSpeed.ready ? "Set the wheel diameter and motor poles in VESC Tool (Motor Settings \u203A Additional Info) first."
                    : (maxSpeed.limited ? "Now: %1 %2 (Max ERPM %3)".arg(Math.round(maxSpeed.capKmh * vescConfig.imperialFactor)).arg(vescConfig.speedUnit).arg(Math.round(maxSpeed.maxErpm))
                                        : "Now: no limit")
                      + " \u00B7 wheel %1 mm, %2 poles".arg(Math.round(maxSpeed.wheelD * 1000)).arg(maxSpeed.poles)
            }

            SwStepper {
                visible: maxSpeed.ready
                label: "LIMIT"
                // rf107: the maths shown, so it can be checked
                value: Math.round(maxSpeed.targetKmh * vescConfig.imperialFactor)
                from: Math.ceil(maxSpeed.minKmh * vescConfig.imperialFactor)
                to: Math.floor(maxSpeed.maxKmh * vescConfig.imperialFactor)
                step: 1
                suffix: " " + vescConfig.speedUnit
                onMoved: { maxSpeed.targetTouched = true; maxSpeed.targetKmh = newValue / vescConfig.imperialFactor; }
            }

            SwLText {
                visible: maxSpeed.ready
                width: parent.width
                horizontalAlignment: Text.AlignHCenter
                wrapMode: Text.WordWrap
                font.pixelSize: fontSizeSmall
                text: "= %1 ERPM (wheel %2 mm, %3 poles, gear %4). Check these match your board in VESC Tool."
                    .arg(Math.round(maxSpeed.targetKmh * maxSpeed.erpmPerKmh)).arg(Math.round(maxSpeed.wheelD * 1000)).arg(maxSpeed.poles).arg(maxSpeed.gear)
            }

            SwLText {
                visible: maxSpeed.verifyText !== ""
                width: parent.width
                horizontalAlignment: Text.AlignHCenter
                wrapMode: Text.WordWrap
                font.pixelSize: fontSizeSmall
                color: maxSpeed.verified === 1 ? swTheme.neonGreen : maxSpeed.verified === -1 ? "#ff2b4f" : "#FFB300"
                text: maxSpeed.verifyText
            }

            Row {
                visible: maxSpeed.ready
                anchors.horizontalCenter: parent.horizontalCenter
                spacing: 0.2 * unit
                SwPill {
                    minWidth: 2.8 * unit
                    label: "SET LIMIT"
                    lit: true
                    onClicked: maxSpeed.request(1)
                }
                SwPill {
                    visible: maxSpeed.limited
                    minWidth: 2.8 * unit
                    label: "REMOVE"
                    onClicked: maxSpeed.request(2)
                }
            }

            SwLText {
                width: parent.width
                wrapMode: Text.WordWrap
                font.pixelSize: fontSizeSmall
                text: "Caps how fast the tire spins up in the air off a jump. "
                    + "Uses VESC's Max ERPM. It also caps riding speed: set it well above your top speed."
            }

            Item { width: parent.width; height: 0.3 * unit }

        }
    }

    BaseDialog {
        id: editBoardNameDialog

        title: "Board Name"
        placeAtTop: true  // keep it above the phone keyboard

        onAccepted: {
            board.setName(boardNameInput.text);
            boardNameText.load();
        }
        onOpened: { boardNameInput.text = boardNameText.name; boardNameInput.forceActiveFocus(); }

        Column {
            width: editBoardNameDialog.availableWidth
            spacing: 0.3 * unit

            // neon input field: green digital text in a purple frame
            Rectangle {
                width: parent.width
                height: 1.1 * unit
                radius: 0.2 * unit
                color: "#100a24"
                border.color: boardNameInput.activeFocus ? swTheme.neonGreen : swTheme.neonPurple
                border.width: 2

                TextInput {
                    id: boardNameInput
                    anchors.fill: parent
                    anchors.leftMargin: 0.3 * unit
                    anchors.rightMargin: 0.3 * unit
                    verticalAlignment: TextInput.AlignVCenter
                    maximumLength: 30
                    clip: true
                    color: swTheme.neonGreen
                    selectionColor: swTheme.neonPurple
                    font.family: "Exan"
                    font.pixelSize: 0.4 * unit
                    text: boardNameText.name
                    onAccepted: editBoardNameDialog.accept()
                }

                Text {
                    anchors.left: parent.left
                    anchors.leftMargin: 0.3 * unit
                    anchors.verticalCenter: parent.verticalCenter
                    visible: boardNameInput.text === ""
                    text: "NAME YOUR BOARD"
                    color: "#4a3a70"
                    font.family: "Exan"
                    font.pixelSize: 0.36 * unit
                }
            }

            Text {
                width: parent.width
                horizontalAlignment: Text.AlignHCenter
                text: boardNameInput.text.length + " / 30 \u00B7 shown at the top of the dashboard"
                color: "#9d8ac0"
                font.pixelSize: 0.2 * unit
            }

            Row {
                anchors.horizontalCenter: parent.horizontalCenter
                spacing: 0.3 * unit
                SwPill {
                    minWidth: 2.4 * unit
                    label: "CANCEL"
                    onClicked: editBoardNameDialog.reject()
                }
                SwPill {
                    minWidth: 2.4 * unit
                    label: "SAVE"
                    lit: true
                    onClicked: editBoardNameDialog.accept()
                }
            }
        }
    }

    // Refloat Glow: MY MELODIES window (CONTROL > BOOT MELODY): the saved
    // melodies, kept out of the CONTROL tab so it stays short. Tap a name to
    // make it the boot melody, pencil to re-record it, x twice to delete.
    // Refloat Glow: full-screen window for one LEDS tab section
    Popup {
        id: ledWindow
        parent: mainItem
        x: 0
        // half the screen, from the bottom (the LEDS tiles stay visible above)
        width: mainItem.width
        height: mainItem.height * 0.5
        y: mainItem.height - height
        modal: true
        dim: true
        padding: 0.25 * unit
        closePolicy: Popup.CloseOnEscape | Popup.CloseOnPressOutside

        property string section: "head"
        readonly property var titles: ({"head": "HEAD/TAIL LIGHTS", "bar": "STATUS BAR", "anim": "STATUS BAR ANIMATIONS", "sound": "BEEPER", "battery": "BATTERY GAUGE", "fw": "LCM FIRMWARE", "custom": "CUSTOM ANIMATION", "updates": "UPDATES", "rgb": "HEAD/TAIL LIGHTS"})

        function show(which) {
            section = which;
            ledWindowFlick.contentY = 0;
            ledSender.fromConfig();  // Refloat's LED settings may have changed in VESC Tool
            if (which === "fw") lcmFw.forgetCheck();
            open();
        }

        // the LCM check must be done again each time the tools are opened
        onClosed: lcmFw.forgetCheck()

        background: Rectangle {
            color: "#0b0718"
            radius: 0.3 * unit
            border.color: swTheme.neonPurple
            border.width: 2
        }

        ColumnLayout {
            anchors.fill: parent
            spacing: 0.15 * unit

            RowLayout {
                Layout.fillWidth: true

                SwPill {
                    minWidth: 1.8 * unit
                    label: "\u2039 BACK"
                    onClicked: ledWindow.section === "custom" ? ledWindow.show("anim") : ledWindow.close()
                }

                SwNeonLabel {
                    Layout.fillWidth: true
                    horizontalAlignment: Text.AlignHCenter
                    font.pixelSize: 0.36 * unit
                    text: ledWindow.titles[ledWindow.section] || ""
                }

                // balances the BACK pill so the title stays centred
                Item { implicitWidth: 1.8 * unit; implicitHeight: 1 }
            }

            Rectangle { Layout.fillWidth: true; height: 2; color: swTheme.neonPurple; opacity: 0.6 }

            // rf131: AUTO APPLY off: send the changes made here to the board
            SwPill {
                visible: !ledSender.autoApply
                Layout.alignment: Qt.AlignHCenter
                minWidth: 5.0 * unit
                label: ledSender.pending ? "\u2713 APPLY CHANGES" : "NO CHANGES TO APPLY"
                lit: ledSender.pending
                onClicked: if (ledSender.pending) {
                    ledSender.apply();
                    VescIf.emitStatusMessage(mainItem.boardRunning ? "LED changes applied (saved once the board stops)" : "LED changes applied", true);
                }
            }

            Flickable {
                id: ledWindowFlick
                Layout.fillWidth: true
                Layout.fillHeight: true
                clip: true
                contentHeight: ledWindowCol.height + 0.4 * unit
                boundsBehavior: Flickable.StopAtBounds

                Column {
                    id: ledWindowCol
                    width: parent.width
                    spacing: 0.14 * unit
                    topPadding: 0.1 * unit

                    // rf116: SLCM boards: the head / tail lights as with the SLCM (rf82)
                    Column {
                        width: parent.width
                        spacing: 0.14 * unit
                        visible: ledWindow.section === "head" && ledSender.slcmPresets

                        SwPill {
                            anchors.horizontalCenter: parent.horizontalCenter
                            minWidth: 3.4 * unit
                            label: swSettings.ledHeadlights ? "HEADLIGHTS ON" : "HEADLIGHTS OFF"
                            lit: swSettings.ledHeadlights
                            onClicked: ledSender.setHead(!swSettings.ledHeadlights)
                        }

                        SwStepper {
                            label: "RIDING LIGHTS"
                            value: swSettings.ledHeadlightPct
                            from: 0; to: 100; step: 5
                            valueText: value === 0 ? "OFF" : value + "%"
                            onMoved: { swSettings.ledHeadlightPct = newValue; ledSender.changed(); }
                        }

                        SwStepper {
                            label: "RUNNING LIGHTS (IDLE)"
                            value: swSettings.ledHeadlightIdlePct
                            from: 0; to: 100; step: 5
                            valueText: value === 0 ? "OFF" : value + "%"
                            onMoved: { swSettings.ledHeadlightIdlePct = newValue; ledSender.changed(); }
                        }

                        SwPill {
                            visible: slcmDetect.present
                            anchors.horizontalCenter: parent.horizontalCenter
                            minWidth: 3.4 * unit
                            label: swSettings.ledDozeBreath ? "SNOOZE BREATHING ON" : "SNOOZE BREATHING OFF"
                            lit: swSettings.ledDozeBreath
                            onClicked: { swSettings.ledDozeBreath = !swSettings.ledDozeBreath; swSettings.ledSnoozeStyle = swSettings.ledDozeBreath ? 0 : 2; ledSender.changed(); }
                        }

                        SwLText {
                            width: parent.width
                            wrapMode: Text.WordWrap
                            font.pixelSize: fontSizeSmall
                            text: "HEADLIGHTS OFF = always off. RIDING LIGHTS while engaged, RUNNING LIGHTS otherwise; 0% = off. "
                                + "Same as Refloat's Headlight Brightness (riding) and Front Brightness (idle). "
                                + "SNOOZE BREATHING: lights slowly breathe while snoozing; off = dark."
                        }
                    }
                    Column {
                        width: parent.width
                        spacing: 0.14 * unit
                        visible: ledWindow.section === "head" && !ledSender.slcmPresets

                        SwPill {
                            anchors.horizontalCenter: parent.horizontalCenter
                            minWidth: 3.4 * unit
                            label: swSettings.ledHeadlights ? "HEAD/TAIL LIGHTS ON" : "HEAD/TAIL LIGHTS OFF"
                            lit: swSettings.ledHeadlights
                            onClicked: ledSender.setHead(!swSettings.ledHeadlights)
                        }

                        // rf128: HEAD/TAIL LIGHTS and RGB LIGHTS merged for controller-driven RGB
                        // LEDs: the effect cards, brightness and RESTORE live in this window
                        // Refloat Glow: RGB LIGHTS - Refloat's own light bar
                        // animations (Refloat Cfg > LEDs), for RGB strips (Thor...)
                        Column {
                            id: rgbCol
                            width: parent.width
                            spacing: 0.14 * unit
                            visible: ledSender.rgbUi  // rf128: inside HEAD/TAIL LIGHTS (rf175: not with NON-RGB)
                            property int sel: 0
                            readonly property var bar: ledSender.rgb[sel] || ({})

                            Row {
                                anchors.horizontalCenter: parent.horizontalCenter
                                spacing: 0.15 * unit
                                SwPill {
                                    minWidth: 2.4 * unit
                                    label: "SIMPLE"
                                    lit: !swSettings.rgbAdvanced
                                    onClicked: swSettings.rgbAdvanced = false
                                }
                                SwPill {
                                    minWidth: 2.8 * unit
                                    label: "ADVANCED ›"
                                    lit: swSettings.rgbAdvanced
                                    onClicked: swSettings.rgbAdvanced = true
                                }
                            }

                            // rf126: SIMPLE: one card per light (HEADLIGHT = Refloat's headlights
                            // + front bars, TAIL LIGHT = taillights + rear), RIDING and IDLE
                            // inside, each effect with its COLOR below it
                            Column {
                                width: parent.width
                                spacing: 0.14 * unit
                                visible: !swSettings.rgbAdvanced
                                Repeater {
                                    model: [["HEADLIGHT", 0, 2], ["TAIL LIGHT", 1, 3]]
                                    LedCard {
                                        id: rgbLightCard
                                        width: rgbCol.width
                                        // rf150: own content column. As a Repeater delegate, LedCard's
                                        // default content alias didn't apply: the RIDING / IDLE rows
                                        // were parented to the card itself and drawn on top of each
                                        // other. The body is positioned and sized explicitly instead.
                                        title: ""
                                        height: rgbCardBody.y + rgbCardBody.height + 0.15 * unit
                                        readonly property var bars: [modelData[1], modelData[2]]
                                        Column {
                                            id: rgbCardBody
                                            parent: rgbLightCard
                                            x: 0.15 * unit
                                            y: 0.15 * unit
                                            width: rgbLightCard.width - 0.3 * unit
                                            spacing: 0.1 * unit
                                            Text {
                                                width: parent.width
                                                horizontalAlignment: Text.AlignHCenter
                                                text: modelData[0]
                                                color: swTheme.neonGreen
                                                font.family: "Exan"
                                                font.pixelSize: 0.28 * unit
                                                font.letterSpacing: 0.03 * unit
                                            }
                                        Repeater {
                                            model: [["RIDING", 0], ["IDLE", 1]]
                                            Column {
                                                id: rgbSimpleBar
                                                width: rgbCardBody.width
                                                spacing: 0.1 * unit
                                                readonly property int barIdx: rgbLightCard.bars[modelData[1]]
                                                readonly property var b: ledSender.rgb[barIdx] || ({mode: 0, c1: 1, c2: 0, speed: 1})
                                                Rectangle {  // thin divider between RIDING and IDLE
                                                    visible: modelData[1] === 1
                                                    width: parent.width; height: 1
                                                    color: Qt.rgba(0.66, 0.33, 1, 0.35)
                                                }
                                                // rf127: IDLE can be OFF (that light's idle brightness 0)
                                                readonly property bool idle: modelData[1] === 1
                                                readonly property bool off: idle && ledSender.rgbLoaded && ledSender.rgbBri(barIdx) === 0
                                                SwStepper {
                                                    width: parent.width
                                                    label: modelData[0]
                                                    valueWidth: 3.6 * unit
                                                    rf: rgbSimpleBar.off ? ({mode: -1, c1: 0, c2: 0, speed: 1}) : rgbSimpleBar.b
                                                    value: rgbSimpleBar.off ? -1 : (rgbSimpleBar.b.mode || 0)
                                                    from: rgbSimpleBar.idle ? -1 : 0; to: ledSender.rfModes.length - 1; step: 1
                                                    valueText: value < 0 ? "OFF" : (ledSender.rfModes[value] || "")
                                                    onMoved: {
                                                        var bi = rgbSimpleBar.barIdx, key = bi === 2 ? "rgbIdleLastFront" : "rgbIdleLastRear";
                                                        if (newValue < 0) {
                                                            var cur = ledSender.rgbBri(bi);
                                                            if (cur > 0) swSettings[key] = cur;
                                                            ledSender.rgbSetBri(bi, 0);
                                                            return;
                                                        }
                                                        if (rgbSimpleBar.off) ledSender.rgbSetBri(bi, swSettings[key] > 0 ? swSettings[key] : 50);
                                                        ledSender.rgbSet(bi, "mode", newValue);  // rf123: with the effect's colors
                                                    }
                                                }
                                                SwStepper {
                                                    visible: (rgbSimpleBar.b.mode || 0) < 6 && !rgbSimpleBar.off
                                                    width: parent.width
                                                    label: "COLOR"
                                                    sideArrows: true
                                                    valueWidth: 3.6 * unit
                                                    value: rgbSimpleBar.b.c1 || 0
                                                    from: 0; to: 29; step: 1
                                                    valueText: ledSender.rfColors[value]
                                                    valueColor: ledSender.rfTextColor(value)
                                                    onMoved: ledSender.rgbSet(rgbSimpleBar.barIdx, "c1", ledSender.rfColorNext(value, newValue > value ? 1 : -1))
                                                }
                                            }
                                        }
                                        }
                                    }
                                }
                                LedCard {
                                    width: rgbCol.width
                                    title: "BRIGHTNESS"
                                    Repeater {
                                        model: [["RIDING", 0], ["IDLE", 2]]
                                        SwStepper {
                                            width: rgbCol.width - 0.3 * unit
                                            label: modelData[0]
                                            valueWidth: 3.6 * unit
                                            value: ledSender.rgbLoaded ? ledSender.rgbBri(modelData[1]) : 0
                                            from: 0; to: 100; step: 5; suffix: "%"
                                            onMoved: ledSender.rgbSetBri(modelData[1], newValue)
                                        }
                                    }
                                }
                                // rf126: back to Refloat's look: solid white headlight, solid red tail light
                                SwPill {
                                    anchors.horizontalCenter: parent.horizontalCenter
                                    minWidth: 4.4 * unit
                                    label: "RESTORE DEFAULTS"
                                    lit: true
                                    onClicked: {
                                        ledSender.rgbRestore();
                                        VescIf.emitStatusMessage("Riding: solid white headlight, solid red tail light. Idle: off", true);
                                    }
                                }
                                SwLText {
                                    horizontalAlignment: Text.AlignHCenter
                                    width: parent.width
                                    wrapMode: Text.WordWrap
                                    font.pixelSize: fontSizeSmall
                                    text: "RIDING: while engaged; IDLE: otherwise. Each effect starts in its own colors. "
                                        + "IDLE OFF: dark when idle. RESTORE DEFAULTS: solid white / red while riding, off when idle. ADVANCED: second color, speed, tail brightness, OFF WHEN LIFTED."
                                }
                            }

                            Column {
                                width: parent.width
                                spacing: 0.14 * unit
                                visible: swSettings.rgbAdvanced
                                // rf131: AUTO APPLY (ADVANCED only; SIMPLE always applies right away)
                                LedCard {
                                    width: parent.width
                                    title: "APPLY"
                                    SwPill {
                                        anchors.horizontalCenter: parent.horizontalCenter
                                        minWidth: 3.4 * unit
                                        label: swSettings.ledAutoApply ? "AUTO APPLY ON" : "AUTO APPLY OFF"
                                        lit: swSettings.ledAutoApply
                                        onClicked: ledSender.setAutoApply(!swSettings.ledAutoApply)
                                    }
                                    SwLText {
                                        width: parent.width
                                        horizontalAlignment: Text.AlignHCenter
                                        wrapMode: Text.WordWrap
                                        font.pixelSize: fontSizeSmall
                                        text: swSettings.ledAutoApply ? "Changes go to the board right away."
                                            : "Make your changes, then tap APPLY CHANGES at the top. Light switches still apply right away."
                                    }
                                }


                                // RIDING (engaged, headlights on) = Refloat's
                                // headlights / taillights bars; IDLE = front / rear
                                Repeater {
                                    model: [["RIDING", 0], ["IDLE", 2]]
                                    Item {
                                        id: rgbGroup
                                        width: rgbCol.width
                                        height: 0.8 * unit
                                        SwNeonLabel {
                                            anchors.left: parent.left
                                            anchors.verticalCenter: parent.verticalCenter
                                            width: parent.width - 4.6 * unit
                                            font.pixelSize: 0.28 * unit
                                            text: modelData[0]
                                        }
                                        Row {
                                            anchors.right: parent.right
                                            anchors.verticalCenter: parent.verticalCenter
                                            spacing: 0.15 * unit
                                            Repeater {
                                                model: ["HEAD", "TAIL"]
                                                SwPill {
                                                    readonly property int bar: rgbGroup.base + (modelData === "HEAD" ? 0 : 1)
                                                    minWidth: 2.0 * unit
                                                    label: modelData === "HEAD" ? "HEADLIGHT" : "TAIL LIGHT"  // rf126: same names riding and idle
                                                    lit: rgbCol.sel === bar
                                                    onClicked: rgbCol.sel = bar
                                                }
                                            }
                                        }
                                        readonly property int base: modelData[1]
                                    }
                                }

                                // the animation preview is the selector
                                SwStepper {
                                    bigName: true
                                    rf: rgbCol.bar
                                    value: rgbCol.bar.mode || 0
                                    from: 0; to: ledSender.rfModes.length - 1; step: 1
                                    valueText: ledSender.rfModes[value] || ""
                                    onMoved: ledSender.rgbSet(rgbCol.sel, "mode", newValue)
                                }
                                SwStepper {
                                    visible: (rgbCol.bar.mode || 0) < 6
                                    label: "COLOR 1"
                                    valueWidth: 3.2 * unit
                                    value: rgbCol.bar.c1 || 0
                                    from: 0; to: 29; step: 1
                                    valueText: ledSender.rfColors[value]
                                    valueColor: ledSender.rfTextColor(value)
                                    sideArrows: true
                                    onMoved: ledSender.rgbSet(rgbCol.sel, "c1", ledSender.rfColorNext(value, newValue > value ? 1 : -1))
                                }
                                SwStepper {
                                    visible: rgbCol.bar.mode >= 1 && rgbCol.bar.mode <= 5  // rf91, see Status Idle
                                    label: rgbCol.bar.mode === 4 ? "BACKGROUND" : "COLOR 2"  // rf151
                                    toggle: ledSender.oneColor(rgbCol.bar.mode) ? ((rgbCol.bar.c2 || 0) !== 0 ? 1 : 0) : -1  // rf101
                                    onToggleClicked: {
                                        if ((rgbCol.bar.c2 || 0) !== 0) { swSettings.rfBgLast = rgbCol.bar.c2; ledSender.rgbSet(rgbCol.sel, "c2", 0); }
                                        else ledSender.rgbSet(rgbCol.sel, "c2", swSettings.rfBgLast || 1);
                                    }
                                    valueWidth: 3.2 * unit
                                    value: rgbCol.bar.c2 || 0
                                    from: 0; to: 29; step: 1
                                    valueText: ledSender.rfColors[value]
                                    valueColor: ledSender.rfTextColor(value)
                                    sideArrows: true
                                    onMoved: ledSender.rgbSet(rgbCol.sel, "c2", ledSender.rfColorNext(value, newValue > value ? 1 : -1))
                                }
                                SwStepper {
                                    visible: (rgbCol.bar.mode || 0) !== 0
                                    label: "SPEED"
                                    value: rgbCol.bar.speed || 1
                                    from: 0.1; to: 5; step: 0.1; decimals: 1; suffix: "/s"
                                    onMoved: ledSender.rgbSet(rgbCol.sel, "speed", newValue)
                                }
                                SwStepper {
                                    label: "BRIGHTNESS"
                                    value: ledSender.rgbLoaded ? ledSender.rgbBri(rgbCol.sel) : 0
                                    from: 0; to: 100; step: 5; suffix: "%"
                                    onMoved: ledSender.rgbSetBri(rgbCol.sel, newValue)
                                }

                                SwPill {
                                    anchors.horizontalCenter: parent.horizontalCenter
                                    minWidth: 4.4 * unit
                                    label: ledSender.rgbLifted ? "OFF WHEN LIFTED: ON" : "OFF WHEN LIFTED: OFF"
                                    lit: ledSender.rgbLifted
                                    onClicked: ledSender.rgbSetLifted(!ledSender.rgbLifted)
                                }

                            }

                            SwLText {
                                width: parent.width
                                horizontalAlignment: Text.AlignHCenter
                                wrapMode: Text.WordWrap
                                font.pixelSize: fontSizeSmall
                                text: "Refloat's LED settings (Refloat Cfg \u203A LEDs), linked both ways."
                            }
                        }

                        SwStepper {
                            visible: !ledSender.rgbUi  // rf128: in the BRIGHTNESS card
                            label: "RIDING"
                            value: swSettings.ledHeadlightPct
                            from: 0; to: 100; step: 5
                            valueText: value === 0 ? "OFF" : value + "%"
                            onMoved: { swSettings.ledHeadlightPct = newValue; ledSender.changed(); }
                        }

                        SwStepper {
                            visible: !ledSender.rgbUi  // rf128: in the BRIGHTNESS card
                            label: "IDLE"
                            value: swSettings.ledHeadlightIdlePct
                            from: 0; to: 100; step: 5
                            valueText: value === 0 ? "OFF" : value + "%"
                            onMoved: { swSettings.ledHeadlightIdlePct = newValue; ledSender.changed(); }
                        }

                        // rf86: snooze for controller-driven LEDs (head/tail and status
                        // bar), kept by the package; an SLCM snoozes by itself
                        // rf128: snooze in its own card (like the other light settings)
                        LedCard {
                            width: parent.width
                            title: "SNOOZE LOOK"

                            // rf97 / rf112: how the head / tail lights look while snoozing, as a
                            // row like the SLCM ANIMATIONS (DIM only for controller-driven LEDs)
                            SwStepper {
                                id: htSnoozeLook
                                readonly property bool ctl: ledSender.rgbAvail || ledSender.rfStatusAvail
                                width: parent.width
                                label: "LOOK"
                                valueWidth: 3.6 * unit
                                value: !ctl && swSettings.ledSnoozeStyle === 1 ? 0 : swSettings.ledSnoozeStyle
                                rf: ({mode: [-2, -3, -4][value], c1: 1, c2: 0, speed: 1})
                                from: 0; to: 2; step: 1
                                valueText: ["BREATHE", "DIM", "DARK"][value]
                                onMoved: {
                                    var v = newValue;
                                    if (!ctl && v === 1) v = value === 0 ? 2 : 0;  // an SLCM: breathe or dark
                                    swSettings.ledSnoozeStyle = v;
                                    swSettings.ledDozeBreath = v !== 2;
                                    ledSender.changed();
                                }
                            }

                        }

                        SwLText {
                            width: parent.width
                            wrapMode: Text.WordWrap
                            font.pixelSize: fontSizeSmall
                            text: (ledSender.rgbUi ? "HEAD/TAIL LIGHTS OFF = always off. " : "RIDING: while engaged. IDLE: otherwise. 0% = off; HEAD/TAIL LIGHTS OFF = always off. "
                                + "Same as Refloat's Headlight Brightness (riding) and Front Brightness (idle). ")
                                + "SNOOZE uses VESC's power-off idle clock: riding or rolling the wheel restarts it and wakes the lights. "
                                + "When: LEDS \u203A SNOOZE. BREATHE: slow breath; DIM: low glow; DARK: off. For controller-driven LEDs (an SLCM has its own timer)."
                        }
                    }
                    Column {
                        width: parent.width
                        spacing: 0.14 * unit
                        visible: ledWindow.section === "bar"

                        SwPill {
                            anchors.horizontalCenter: parent.horizontalCenter
                            minWidth: 3.4 * unit
                            label: swSettings.ledStatusBar ? "STATUS BAR ON" : "STATUS BAR OFF"
                            lit: swSettings.ledStatusBar
                            onClicked: ledSender.setStatus(!swSettings.ledStatusBar)
                        }

                        SwStepper {
                            label: "IDLE BRIGHTNESS"
                            value: swSettings.ledStatusIdlePct
                            from: 0; to: 100; step: 5; suffix: "%"
                            onMoved: { swSettings.ledStatusIdlePct = newValue; ledSender.changed(); }
                        }

                        SwStepper {
                            label: "RIDING BRIGHTNESS"
                            value: swSettings.ledStatusRidePct
                            from: 0; to: 100; step: 5; suffix: "%"
                            onMoved: { swSettings.ledStatusRidePct = newValue; ledSender.changed(); }
                        }

                        SwLText {
                            width: parent.width
                            wrapMode: Text.WordWrap
                            font.pixelSize: fontSizeSmall
                            text: "Same as Refloat's Status Idle Brightness (idle) and Status Brightness (riding)."
                        }

                        // rf117: SLCM boards: brightness only (rf71); the animations are
                        // the SLCM's own presets in SLCM EXTRAS > ANIMATIONS
                        Column {
                            width: parent.width
                            spacing: 0.14 * unit
                            visible: ledSender.slcmPresets
                            // rf117: as when the SLCM was first tied in (rf71): brightness here,
                            // the SLCM presets (THE FUZZ, FIRE, ...) in ANIMATIONS
                            SwPill {
                                anchors.horizontalCenter: parent.horizontalCenter
                                minWidth: 4.4 * unit
                                label: "ANIMATIONS \u203A"
                                lit: true
                                onClicked: ledWindow.show("anim")
                            }
                        }

                        // rf118: SIMPLE (one row per moment, like the SLCM ANIMATIONS
                        // screen, one COLOR) / ADVANCED (every Refloat setting) for
                        // controller-driven LEDs
                        Row {
                            visible: !ledSender.slcmPresets
                            anchors.horizontalCenter: parent.horizontalCenter
                            spacing: 0.15 * unit
                            SwPill {
                                minWidth: 2.4 * unit
                                label: "SIMPLE"
                                lit: !swSettings.barAdvanced
                                onClicked: swSettings.barAdvanced = false
                            }
                            SwPill {
                                minWidth: 2.8 * unit
                                label: "ADVANCED ›"
                                lit: swSettings.barAdvanced
                                onClicked: swSettings.barAdvanced = true
                            }
                        }

                        Column {
                            width: parent.width
                            spacing: 0.14 * unit
                            visible: !ledSender.slcmPresets && !swSettings.barAdvanced

                            LedHeading { text: "Animations" }
                            LedCard {
                                // one color for all three (rf123: on top, left / right arrows)
                                SwStepper {
                                    width: parent.width
                                    label: "COLOR"
                                    sideArrows: true
                                    valueWidth: 3.6 * unit
                                    value: ledSender.rfColor1
                                    from: 0; to: 29; step: 1
                                    valueText: ledSender.rfColors[value]
                                    valueColor: ledSender.rfTextColor(value)
                                    onMoved: {
                                        var c = ledSender.rfColorNext(value, newValue > value ? 1 : -1);
                                        // rf123: the same color 1 for riding / snooze (FELONY keeps red / blue)
                                        if (swSettings.rideC1 >= 0 && swSettings.ledRideMode !== 6) swSettings.rideC1 = c;
                                        if (swSettings.snzAdvanced && swSettings.ledStatusSnooze !== 9) swSettings.snzC1 = c;
                                        ledSender.setRf("rfColor1", c);
                                    }
                                }
                                SwStepper {
                                    width: parent.width
                                    label: "IDLE"
                                    valueWidth: 3.6 * unit
                                    value: ledSender.rfOn ? ledSender.rfMode : -1
                                    rf: ({mode: value, c1: ledSender.rfColor1, c2: ledSender.rfColor2, speed: ledSender.rfSpeed})
                                    from: -1; to: ledSender.rfModes.length - 1; step: 1
                                    valueText: value < 0 ? "BATTERY" : ledSender.rfModes[value]
                                    onMoved: {
                                        if (newValue < 0) {
                                            ledSender.setRf("rfTimeout", 0);
                                        } else {
                                            if (ledSender.oneColor(newValue) && !(ledSender.rfOn && ledSender.oneColor(ledSender.rfMode))) ledSender.rfColor2 = 0;
                                            if (!(ledSender.rfOn && ledSender.rfMode === newValue)) ledSender.idleEffect(newValue);  // rf123
                                            ledSender.rfMode = newValue;
                                            ledSender.setRf("rfTimeout", ledSender.rfOn ? ledSender.rfTimeout : 10);
                                        }
                                    }
                                }
                                SwStepper {
                                    visible: ledSender.rfStatusAvail
                                    width: parent.width
                                    label: "RIDING"
                                    valueWidth: 3.6 * unit
                                    value: swSettings.ledRideMode
                                    readonly property bool own: swSettings.rideC1 >= 0
                                    rf: ({mode: value - 1, c1: own ? swSettings.rideC1 : ledSender.rfColor1, c2: own ? swSettings.rideC2 : ledSender.rfColor2,
                                          speed: own ? swSettings.rideSpeed : ledSender.rfSpeed})
                                    from: 0; to: ledSender.rfModes.length; step: 1
                                    valueText: value === 0 ? "BATTERY/DUTY" : ledSender.rfModes[value - 1]
                                    onMoved: {
                                        if (own && ledSender.oneColor(newValue - 1) && !ledSender.oneColor(swSettings.ledRideMode - 1)) swSettings.rideC2 = 0;
                                        if (newValue !== swSettings.ledRideMode) ledSender.rideEffect(newValue);  // rf123
                                        swSettings.ledRideMode = newValue; ledSender.changed();
                                    }
                                }
                                SwStepper {
                                    visible: ledSender.rfStatusAvail
                                    width: parent.width
                                    label: "SNOOZE"
                                    valueWidth: 3.6 * unit
                                    value: swSettings.ledStatusSnooze
                                    rf: ({mode: value >= 4 ? value - 4 : [-2, -3, -4, -1][value],
                                          c1: swSettings.snzAdvanced ? swSettings.snzC1 : ledSender.rfColor1, c2: swSettings.snzAdvanced ? swSettings.snzC2 : ledSender.rfColor2,
                                          speed: swSettings.snzAdvanced ? swSettings.snzSpeed : ledSender.rfSpeed})
                                    from: 0; to: 3 + ledSender.rfModes.length; step: 1
                                    valueText: value >= 4 ? ledSender.rfModes[value - 4] : ["BREATHE", "DIM", "DARK", "NORMAL"][value]
                                    onMoved: {
                                        if (swSettings.snzAdvanced && ledSender.oneColor(newValue - 4) && !ledSender.oneColor(swSettings.ledStatusSnooze - 4)) swSettings.snzC2 = 0;
                                        if (newValue !== swSettings.ledStatusSnooze) ledSender.snoozeEffect(newValue);  // rf123
                                        swSettings.ledStatusSnooze = newValue; ledSender.changed();
                                    }
                                }
                            }
                            SwLText {
                                horizontalAlignment: Text.AlignHCenter
                                width: parent.width
                                wrapMode: Text.WordWrap
                                font.pixelSize: fontSizeSmall
                                text: "Refloat's status bar animations. Each effect starts in its own colors; COLOR changes them all. "
                                    + "ADVANCED: second color, speed, BATTERY FOR, duty bar, footpad sensors, riding / snooze colors."
                            }
                        }

                        Column {
                            width: parent.width
                            spacing: 0.14 * unit
                            visible: !ledSender.slcmPresets && swSettings.barAdvanced

                            // rf131: AUTO APPLY (ADVANCED only; SIMPLE always applies right away)
                            LedCard {
                                width: parent.width
                                title: "APPLY"
                                SwPill {
                                    anchors.horizontalCenter: parent.horizontalCenter
                                    minWidth: 3.4 * unit
                                    label: swSettings.ledAutoApply ? "AUTO APPLY ON" : "AUTO APPLY OFF"
                                    lit: swSettings.ledAutoApply
                                    onClicked: ledSender.setAutoApply(!swSettings.ledAutoApply)
                                }
                                SwLText {
                                    width: parent.width
                                    horizontalAlignment: Text.AlignHCenter
                                    wrapMode: Text.WordWrap
                                    font.pixelSize: fontSizeSmall
                                    text: swSettings.ledAutoApply ? "Changes go to the board right away."
                                        : "Make your changes, then tap APPLY CHANGES at the top. Light switches still apply right away."
                                }
                            }


                        // rf72: Refloat's Status Idle animation - one setting for
                        // every controller (controller-driven LEDs play it, an SLCM gets it
                        // translated by the package)
                        LedHeading { text: "Idle animation" }

                        // the animation preview is the selector; first choice
                        // BATTERY = Refloat's idle animation off (idle_timeout 0)
                        SwStepper {
                            bigName: true
                            rfAnim: true
                            value: ledSender.rfOn ? ledSender.rfMode : -1
                            from: -1; to: ledSender.rfModes.length - 1; step: 1
                            valueText: value < 0 ? "BATTERY" : ledSender.rfModes[value]
                            onMoved: {
                                if (newValue < 0) {
                                    ledSender.setRf("rfTimeout", 0);
                                } else {
                                    // rf102: one-color animations start with a BLACK background
                                    if (ledSender.oneColor(newValue) && !(ledSender.rfOn && ledSender.oneColor(ledSender.rfMode))) ledSender.rfColor2 = 0;
                                    if (!(ledSender.rfOn && ledSender.rfMode === newValue)) ledSender.idleEffect(newValue);  // rf123
                                    ledSender.rfMode = newValue;
                                    ledSender.setRf("rfTimeout", ledSender.rfOn ? ledSender.rfTimeout : 10);
                                }
                            }
                        }

                        Column {
                            width: parent.width
                            spacing: 0.14 * unit
                            visible: ledSender.rfOn

                            SwStepper {
                                visible: ledSender.rfMode < 6
                                label: "COLOR 1"
                                valueWidth: 3.2 * unit
                                value: ledSender.rfColor1
                                from: 0; to: 29; step: 1
                                valueText: ledSender.rfColors[value]
                                valueColor: ledSender.rfTextColor(value)
                                sideArrows: true
                                onMoved: ledSender.setRf("rfColor1", ledSender.rfColorNext(value, newValue > value ? 1 : -1))
                            }
                            SwStepper {
                                // rf91: Refloat uses color 2 in FADE, STROBE, FELONY and as the
                                // background of PULSE and KNIGHT RIDER (BLACK = one color)
                                visible: ledSender.rfMode >= 1 && ledSender.rfMode <= 5
                                label: ledSender.oneColor(ledSender.rfMode) ? "BACKGROUND" : "COLOR 2"
                                // rf101: BACKGROUND ON / OFF (off = BLACK)
                                toggle: ledSender.oneColor(ledSender.rfMode) ? (ledSender.rfColor2 !== 0 ? 1 : 0) : -1
                                onToggleClicked: {
                                    if (ledSender.rfColor2 !== 0) { swSettings.rfBgLast = ledSender.rfColor2; ledSender.setRf("rfColor2", 0); }
                                    else ledSender.setRf("rfColor2", swSettings.rfBgLast || 1);
                                }
                                valueWidth: 3.2 * unit
                                value: ledSender.rfColor2
                                from: 0; to: 29; step: 1
                                valueText: ledSender.rfColors[value]
                                valueColor: ledSender.rfTextColor(value)
                                sideArrows: true
                                onMoved: ledSender.setRf("rfColor2", ledSender.rfColorNext(value, newValue > value ? 1 : -1))
                            }
                            Rectangle {
                                visible: ledSender.rfMode < 6
                                anchors.horizontalCenter: parent.horizontalCenter
                                width: parent.width * 0.7; height: 0.14 * unit; radius: height / 2
                                gradient: Gradient {
                                    orientation: Gradient.Horizontal
                                    GradientStop { position: 0; color: ledSender.rfQColor(ledSender.rfColor1) }
                                    GradientStop {
                                        position: 1
                                        color: ledSender.rfQColor(ledSender.rfMode >= 1 && ledSender.rfMode <= 5 ? ledSender.rfColor2 : ledSender.rfColor1)
                                    }
                                }
                            }
                            SwStepper {
                                visible: ledSender.rfMode !== 0
                                label: "SPEED"
                                value: ledSender.rfSpeed
                                from: 0.1; to: 5; step: 0.1; decimals: 1; suffix: "/s"
                                onMoved: ledSender.setRf("rfSpeed", newValue)
                            }
                            SwStepper {
                                label: "BATTERY FOR"  // rf173: was START AFTER
                                value: ledSender.rfTimeout
                                from: 1; to: 300; step: 1; suffix: " s"
                                onMoved: ledSender.setRf("rfTimeout", newValue)
                            }
                            SwLText {
                                width: parent.width
                                horizontalAlignment: Text.AlignHCenter
                                wrapMode: Text.WordWrap
                                font.pixelSize: fontSizeSmall
                                text: "Battery shows this long, then the idle animation."
                            }
                        }

                        SwLText {
                            width: parent.width
                            wrapMode: Text.WordWrap
                            font.pixelSize: fontSizeSmall
                            text: "Refloat's Status Idle animation, the same on every controller; "
                                + "an SLCM plays the closest SLCM animation (r19+). "
                                + "BATTERY = battery level. BATTERY FOR: controller-driven LEDs only."
                                + (slcmDetect.present && !ledSender.idleFollows
                                    ? " Right now the SLCM plays " + ledSender.animLabel(0, swSettings.ledAnimIdle) + " from SLCM EXTRAS \u203A ANIMATIONS instead; change anything here to follow this again."
                                    : "")
                        }

                        // rf109: the status bar's own snooze look (same timing as the
                        // head / tail lights: HEAD/TAIL LIGHTS > SNOOZE BEFORE OFF)
                        LedHeading { visible: ledSender.rfStatusAvail; text: "Snooze" }
                        // rf111: the animation preview is the selector, like idle / riding:
                        // BREATHE, DIM, DARK, NORMAL, then every Refloat animation
                        SwStepper {
                            visible: ledSender.rfStatusAvail
                            width: parent.width
                            label: "SNOOZE"  // rf112: same look as the SLCM ANIMATIONS rows
                            valueWidth: 3.6 * unit
                            value: swSettings.ledStatusSnooze
                            rf: ({mode: value >= 4 ? value - 4 : [-2, -3, -4, -1][value],
                                  c1: swSettings.snzAdvanced ? swSettings.snzC1 : ledSender.rfColor1, c2: swSettings.snzAdvanced ? swSettings.snzC2 : ledSender.rfColor2,
                                  speed: swSettings.snzAdvanced ? swSettings.snzSpeed : ledSender.rfSpeed})
                            from: 0; to: 3 + ledSender.rfModes.length; step: 1
                            valueText: value >= 4 ? ledSender.rfModes[value - 4] : ["BREATHE", "DIM", "DARK", "NORMAL"][value]
                            onMoved: {
                                if (swSettings.snzAdvanced && ledSender.oneColor(newValue - 4) && !ledSender.oneColor(swSettings.ledStatusSnooze - 4)) swSettings.snzC2 = 0;
                                if (newValue !== swSettings.ledStatusSnooze) ledSender.snoozeEffect(newValue);  // rf123
                                swSettings.ledStatusSnooze = newValue; ledSender.changed();
                            }
                        }

                        // rf114: SIMPLE (the idle animation's colors / speed) or ADVANCED
                        // (its own colors / speed, like the idle animation)
                        Row {
                            visible: ledSender.rfStatusAvail && swSettings.ledStatusSnooze >= 4
                            anchors.horizontalCenter: parent.horizontalCenter
                            spacing: 0.15 * unit
                            SwPill {
                                minWidth: 2.4 * unit
                                label: "SIMPLE"
                                lit: !swSettings.snzAdvanced
                                onClicked: { swSettings.snzAdvanced = false; ledSender.changed(); }
                            }
                            SwPill {
                                minWidth: 2.8 * unit
                                label: "ADVANCED \u203A"
                                lit: swSettings.snzAdvanced
                                onClicked: {
                                    if (!swSettings.snzAdvanced) {
                                        swSettings.snzC1 = ledSender.rfColor1; swSettings.snzC2 = ledSender.rfColor2; swSettings.snzSpeed = ledSender.rfSpeed;
                                    }
                                    swSettings.snzAdvanced = true; ledSender.changed();
                                }
                            }
                        }
                        RfColorsBlock {
                            visible: ledSender.rfStatusAvail && swSettings.ledStatusSnooze >= 4 && swSettings.snzAdvanced
                            mode: swSettings.ledStatusSnooze - 4
                            c1: swSettings.snzC1; c2: swSettings.snzC2; speed: swSettings.snzSpeed
                            onSetC1: function(v) { swSettings.snzC1 = v; ledSender.changed(); }
                            onSetC2: function(v) { swSettings.snzC2 = v; ledSender.changed(); }
                            onSetSpeed: function(v) { swSettings.snzSpeed = v; ledSender.changed(); }
                        }
                        SwLText {
                            visible: ledSender.rfStatusAvail
                            width: parent.width
                            wrapMode: Text.WordWrap
                            font.pixelSize: fontSizeSmall
                            text: "How the status bar looks while the board snoozes; it snoozes together with the head / tail lights (LEDS \u203A SNOOZE"
                                + (swSettings.ledSnoozeMin > 0 && vescAppConfig.offMinutes > swSettings.ledSnoozeMin ? ": at " + (vescAppConfig.offMinutes - swSettings.ledSnoozeMin) + " min idle" : "")
                                + "). BREATHE / DIM / DARK: brightness; NORMAL: idle look; an animation uses the idle colors (SIMPLE) or its own (ADVANCED)."
                        }

                        // rf84: Refloat's riding status bar (Thor etc.; an SLCM
                        // uses SLCM EXTRAS > ANIMATIONS > RIDING)
                        LedHeading { visible: ledSender.rfStatusAvail; text: "Riding animation" }

                        // rf97: riding animation for the controller's status strip:
                        // BATTERY / DUTY (Refloat) or a Refloat animation in the idle colors
                        SwStepper {
                            visible: ledSender.rfStatusAvail
                            bigName: true
                            value: swSettings.ledRideMode
                            rf: ({mode: value - 1, c1: Math.max(0, swSettings.rideC1), c2: swSettings.rideC2, speed: swSettings.rideSpeed})
                            from: 0; to: ledSender.rfModes.length; step: 1
                            valueText: value === 0 ? "BATTERY / DUTY" : ledSender.rfModes[value - 1]
                            onMoved: {
                                // rf114: one-color animations start with a BLACK background
                                if (ledSender.oneColor(newValue - 1) && !ledSender.oneColor(swSettings.ledRideMode - 1)) swSettings.rideC2 = 0;
                                if (newValue !== swSettings.ledRideMode) ledSender.rideEffect(newValue);  // rf123
                                swSettings.ledRideMode = newValue; ledSender.changed();
                            }
                        }

                        // rf114: the same adjustments as the idle animation
                        RfColorsBlock {
                            visible: ledSender.rfStatusAvail && swSettings.ledRideMode > 0
                            mode: swSettings.ledRideMode - 1
                            c1: Math.max(0, swSettings.rideC1); c2: swSettings.rideC2; speed: swSettings.rideSpeed
                            onSetC1: function(v) { swSettings.rideC1 = v; ledSender.changed(); }
                            onSetC2: function(v) { if (swSettings.rideC1 < 0) swSettings.rideC1 = ledSender.rfColor1; swSettings.rideC2 = v; ledSender.changed(); }
                            onSetSpeed: function(v) { if (swSettings.rideC1 < 0) swSettings.rideC1 = ledSender.rfColor1; swSettings.rideSpeed = v; ledSender.changed(); }
                        }

                        SwStepper {
                            visible: ledSender.rfStatusAvail
                            label: "DUTY BAR FROM"
                            value: Math.max(15, Math.round(ledSender.rfDutyTh * 20) * 5)
                            from: 15; to: 100; step: 5
                            valueText: value >= 100 ? "NEVER" : value + "%"
                            onMoved: { if (!ledSender.rfLoaded) ledSender.fromConfig(); ledSender.rfDutyTh = newValue / 100; ledSender.changed(); }
                        }

                        SwPill {
                            visible: ledSender.rfStatusAvail
                            anchors.horizontalCenter: parent.horizontalCenter
                            minWidth: 4.4 * unit
                            label: ledSender.rfSensors ? "FOOTPAD SENSORS ON" : "FOOTPAD SENSORS OFF"
                            lit: ledSender.rfSensors
                            onClicked: { if (!ledSender.rfLoaded) ledSender.fromConfig(); ledSender.rfSensors = !ledSender.rfSensors; ledSender.changed(); }
                        }

                        SwLText {
                            visible: ledSender.rfStatusAvail
                            width: parent.width
                            wrapMode: Text.WordWrap
                            font.pixelSize: fontSizeSmall
                            text: "BATTERY / DUTY: battery, then the duty bar from the set duty (NEVER = battery only). Other animations have their own colors and speed; the duty bar still takes over. FOOTPAD SENSORS: show a released sensor while riding. "
                                + "Same as Refloat's Status Duty Threshold and Show Sensor Indicators While Running."
                        }
                        }
                    }
                    Column {
                        width: parent.width
                        spacing: 0.14 * unit
                        visible: ledWindow.section === "anim"

                        SwLText {
                            width: parent.width
                            horizontalAlignment: Text.AlignHCenter
                            wrapMode: Text.WordWrap
                            font.pixelSize: fontSizeSmall
                            text: "Status bar only (SLCM). XRV / GTV / Pint V head and tail lights are plain strips."
                        }

                        Repeater {
                            model: ledSender.animContexts

                            SwStepper {
                                width: ledWindowCol.width
                                label: modelData[0]
                                valueWidth: 3.6 * unit
                                animName: true
                                // IDLE: one more choice at the end, STATUS BAR = Refloat's
                                // Status Idle animation (stored as 128)
                                value: index === 0 && swSettings.ledAnimIdle === 128 ? 15 : swSettings[modelData[1]]
                                from: 0; to: ledSender.animNames.length - (index === 0 ? 0 : 1); step: 1
                                valueText: ledSender.animLabel(index, value)
                                onMoved: { swSettings[modelData[1]] = index === 0 && newValue === 15 ? 128 : newValue; ledSender.changed(); }
                            }
                        }

                        SwStepper {
                            label: "COLOR"
                            value: swSettings.ledColor
                            from: 0; to: 350; step: 10; suffix: "\u00B0"
                            onMoved: { swSettings.ledColor = newValue; ledSender.changed(); }
                        }

                        // personal color (used by the CLASSIC / COLOR SCAN / PULSE / WAVE animations)
                        Rectangle {
                            anchors.horizontalCenter: parent.horizontalCenter
                            width: parent.width * 0.7
                            height: 0.18 * unit
                            radius: height / 2
                            color: Qt.hsla(swSettings.ledColor / 360, 1.0, 0.5, 1.0)
                        }

                        SwLText {
                            width: parent.width
                            wrapMode: Text.WordWrap
                            font.pixelSize: fontSizeSmall
                            text: "OFF = nothing (riding still warns on low battery). STANDARD = battery, footpad sensors when stepped on. "
                                + "BATTERY LEVEL: the battery gauge (live when riding; needs this package's SLCM). "
                                + "IDLE STATUS BAR = Refloat's Status Idle animation, closest SLCM look."
                        }

                        SwPill {
                            anchors.horizontalCenter: parent.horizontalCenter
                            minWidth: 4.6 * unit
                            label: "DESIGN CUSTOM \u203A"
                            lit: true
                            onClicked: ledWindow.show("custom")
                        }
                    }

                    // Refloat Glow: CUSTOM animation designer (SLCM r19+).
                    // The light module runs it itself (stored there too, so it
                    // also plays with the package off).
                    Column {
                        width: parent.width
                        spacing: 0.14 * unit
                        visible: ledWindow.section === "custom"

                        AnimName {
                            width: parent.width
                            height: 0.9 * unit
                            anim: 14
                            text: "CUSTOM PREVIEW"
                            hue: swSettings.ledColor
                            basePixelSize: 0.4 * unit
                        }

                        LedHeading { text: "Style" }
                        Row {
                            anchors.horizontalCenter: parent.horizontalCenter
                            spacing: 0.15 * unit
                            Repeater {
                                model: ["FILL", "SCANNER"]
                                SwPill {
                                    minWidth: 2.8 * unit
                                    label: modelData
                                    lit: { swSettings.ledCustom; return ledSender.customField(0) === index; }
                                    onClicked: ledSender.setCustomField(0, index)
                                }
                            }
                        }

                        LedHeading { text: "Colors" }
                        Flow {
                            width: parent.width
                            spacing: 0.12 * unit
                            Repeater {
                                model: ["RAINBOW \u2192", "RAINBOW \u2190", "WAVE A\u2194B", "FLIP A/B", "MY COLOR"]
                                SwPill {
                                    minWidth: 2.2 * unit
                                    label: modelData
                                    lit: { swSettings.ledCustom; return ledSender.customField(1) === index; }
                                    onClicked: ledSender.setCustomField(1, index)
                                }
                            }
                        }

                        LedHeading { text: "Pattern" }
                        Flow {
                            width: parent.width
                            spacing: 0.12 * unit
                            Repeater {
                                model: { swSettings.ledCustom; return ledSender.customField(0) === 1
                                    ? ["LEFT \u2192 RIGHT", "RIGHT \u2192 LEFT", "MIRROR OUT", "MIRROR IN", "FILL \u2192", "FILL \u2190", "BOUNCE"]
                                    : ["SOLID", "GRADIENT", "MIRROR"]; }
                                SwPill {
                                    minWidth: 2.2 * unit
                                    label: modelData
                                    lit: { swSettings.ledCustom; return ledSender.customField(2) === index; }
                                    onClicked: ledSender.setCustomField(2, index)
                                }
                            }
                        }

                        SwStepper {
                            label: "COLOR A"
                            value: { swSettings.ledCustom; return ledSender.custom()[2] * 2; }
                            from: 0; to: 358; step: 6; suffix: "\u00B0"
                            onMoved: ledSender.setCustom(2, newValue / 2)
                        }
                        Rectangle {
                            anchors.horizontalCenter: parent.horizontalCenter
                            width: parent.width * 0.7; height: 0.14 * unit; radius: height / 2
                            gradient: Gradient {
                                orientation: Gradient.Horizontal
                                GradientStop { position: 0; color: { swSettings.ledCustom; return Qt.hsla(ledSender.custom()[2] * 2 / 360, 1, 0.5, 1); } }
                                GradientStop { position: 1; color: { swSettings.ledCustom; return Qt.hsla(ledSender.custom()[3] * 2 / 360, 1, 0.5, 1); } }
                            }
                        }
                        SwStepper {
                            label: "COLOR B"
                            value: { swSettings.ledCustom; return ledSender.custom()[3] * 2; }
                            from: 0; to: 358; step: 6; suffix: "\u00B0"
                            onMoved: ledSender.setCustom(3, newValue / 2)
                        }
                        SwStepper {
                            label: "COLOR SPEED"
                            value: { swSettings.ledCustom; return ledSender.custom()[4]; }
                            from: 0; to: 255; step: 1
                            valueText: ((value + 1) * 0.05).toFixed(2) + " s"
                            onMoved: ledSender.setCustom(4, newValue)
                        }
                        SwStepper {
                            label: { swSettings.ledCustom; return ledSender.customField(0) === 1 ? "SCAN SPEED" : "PULSE SPEED"; }
                            value: { swSettings.ledCustom; return ledSender.custom()[5]; }
                            from: 0; to: 255; step: 1
                            valueText: ((value + 1) * 0.05).toFixed(2) + " s"
                            onMoved: ledSender.setCustom(5, newValue)
                        }

                        LedHeading { visible: ledSender.customField(0) === 0; text: "Brightness" }
                        Row {
                            visible: { swSettings.ledCustom; return ledSender.customField(0) === 0; }
                            anchors.horizontalCenter: parent.horizontalCenter
                            spacing: 0.15 * unit
                            Repeater {
                                model: ["STEADY", "BREATHE", "FLASH"]
                                SwPill {
                                    minWidth: 2.2 * unit
                                    label: modelData
                                    lit: { swSettings.ledCustom; return ledSender.custom()[1] === index; }
                                    onClicked: ledSender.setCustom(1, index)
                                }
                            }
                        }
                        SwStepper {
                            visible: { swSettings.ledCustom; return ledSender.customField(0) === 0 && ledSender.custom()[1] > 0; }
                            label: "LOWEST BRIGHTNESS"
                            value: { swSettings.ledCustom; return Math.round(ledSender.custom()[6] / 2.55); }
                            from: 0; to: 100; step: 5; suffix: "%"
                            onMoved: ledSender.setCustom(6, newValue * 2.55)
                        }

                        SwLText {
                            width: parent.width
                            wrapMode: Text.WordWrap
                            font.pixelSize: fontSizeSmall
                            text: "Pick CUSTOM for IDLE / RIDING / SNOOZE / BOOT / SHUTDOWN in ANIMATIONS. The light module keeps it, even with the package off. "
                                + "MY COLOR uses the COLOR from ANIMATIONS. Needs SLCM r19 or newer (CHECK LCM)."
                        }
                    }
                    Column {
                        width: parent.width
                        spacing: 0.14 * unit
                        visible: ledWindow.section === "sound"

                        // rf173: the controller beeper is in Settings › RIDE (gear)
                        SwLText {
                            width: parent.width
                            horizontalAlignment: Text.AlignHCenter
                            wrapMode: Text.WordWrap
                            font.pixelSize: fontSizeSmall
                            text: "The controller's beeper (Refloat's) is in Settings (gear) \u203A RIDE \u203A BEEPER."
                        }

                        LedHeading { text: "Light module" }

                        SwPill {
                            anchors.horizontalCenter: parent.horizontalCenter
                            minWidth: 3.4 * unit
                            label: swSettings.ledBeep ? "LCM BEEPER ON" : "LCM BEEPER OFF"
                            lit: swSettings.ledBeep
                            onClicked: { swSettings.ledBeep = !swSettings.ledBeep; ledSender.changed(); }
                        }

                        Item { width: parent.width; height: 0.2 * unit }

                        Rectangle {
                            id: testBeepBtn
                            anchors.horizontalCenter: parent.horizontalCenter
                            width: Math.min(parent.width, 4.6 * unit)
                            height: 1.4 * unit
                            radius: height / 2
                            color: testBeepArea.pressed ? swTheme.neonGreen : "transparent"
                            border.color: swTheme.neonGreen
                            border.width: 3
                            Text {
                                anchors.centerIn: parent
                                text: "\u266A  TEST BEEP"
                                color: testBeepArea.pressed ? swTheme.background : swTheme.neonGreen
                                font.family: "Exan"
                                font.pixelSize: 0.36 * unit
                            }
                            MouseArea {
                                id: testBeepArea
                                anchors.fill: parent
                                onClicked: {
                                    ledSender.testBeep();
                                    VescIf.emitStatusMessage(swSettings.ledBeep ? "Test beep sent to the light module"
                                    : "Test beep sent - turn the LCM beeper on to hear it", true);
                                }
                            }
                        }

                        SwLText {
                            width: parent.width
                            horizontalAlignment: Text.AlignHCenter
                            wrapMode: Text.WordWrap
                            font.pixelSize: fontSizeSmall
                            text: swSettings.ledBeep
                            ? "One short beep from the light module. No beep = no SLCM or not connected."
                            : "The LCM beeper is off, so the test beep is silent. Turn it on above first."
                        }
                    }

                    Column {
                        width: parent.width
                        spacing: 0.14 * unit
                        visible: ledWindow.section === "battery"

                        SwPill {
                            anchors.horizontalCenter: parent.horizontalCenter
                            minWidth: 3.4 * unit
                            label: swSettings.batCurveOn ? "BATTERY CURVE ON" : "BATTERY CURVE OFF"
                            lit: swSettings.batCurveOn
                            onClicked: { swSettings.batCurveOn = !swSettings.batCurveOn; batteryCurve.changed(); }
                        }

                        SwLText {
                            width: parent.width
                            horizontalAlignment: Text.AlignHCenter
                            wrapMode: Text.WordWrap
                            font.pixelSize: fontSizeSmall
                            color: swTheme.neonGreen
                            text: batteryCurve.cells > 0
                                ? "Now: " + batteryCurve.volts.toFixed(1) + " V \u00B7 " + batteryCurve.cells + "s \u00B7 "
                                    + (batteryCurve.volts / batteryCurve.cells).toFixed(2) + " V/cell \u2192 "
                                    + (batteryCurve.percent <= 100 ? batteryCurve.percent + " %" : "VESC's own %")
                                : "Waiting for the board..."
                        }

                        LedHeading { text: "1. Cell size" }
                        Row {
                            anchors.horizontalCenter: parent.horizontalCenter
                            spacing: 0.15 * unit
                            Repeater {
                                model: ["18650", "21700"]
                                SwPill {
                                    minWidth: 2.2 * unit
                                    label: modelData
                                    lit: swSettings.batSize === modelData
                                    onClicked: batteryCurve.pickSize(modelData)
                                }
                            }
                        }

                        LedHeading { text: "2. Cell" }
                        Flow {
                            width: parent.width
                            spacing: 0.12 * unit
                            Repeater {
                                model: batteryCurve.cellsOfSize(swSettings.batSize)
                                SwPill {
                                    minWidth: 1.6 * unit
                                    label: modelData
                                    lit: swSettings.batCell === modelData
                                    onClicked: batteryCurve.pickCell(modelData)
                                }
                            }
                        }

                        LedHeading { text: "3. Pack" }
                        Row {
                            anchors.horizontalCenter: parent.horizontalCenter
                            spacing: 0.12 * unit
                            Repeater {
                                model: [1, 2, 3]  // rf181: 4P removed
                                SwPill {
                                    minWidth: 1.2 * unit
                                    label: modelData + "P"
                                    lit: batteryCurve.parallel === modelData
                                    onClicked: { swSettings.batParallel = modelData; batteryCurve.changed(); }
                                }
                            }
                        }

                        LedHeading { text: "4. Gauge" }
                        Flow {
                            width: parent.width
                            spacing: 0.12 * unit
                            Repeater {
                                model: 3
                                SwPill {
                                    minWidth: 2.2 * unit
                                    label: batteryCurve.styleNames[index]
                                    lit: swSettings.batStyle === index - 1
                                    onClicked: { swSettings.batStyle = index - 1; batteryCurve.changed(); }
                                }
                            }
                        }

                        SwLText {
                            width: parent.width
                            wrapMode: Text.WordWrap
                            font.pixelSize: fontSizeSmall
                            text: (swSettings.batStyle < 0 ? "Conservative: reads a bit low, so it warns you earlier. "
                                    : swSettings.batStyle > 0 ? "Optimistic: reads a bit high, closer to the last bit of range. " : "Balanced: the cell's own curve. ")
                                + (batteryCurve.current.approx ? batteryCurve.current.name + ": approximate curve (" + batteryCurve.current.basis + "). " : "")
                                + "Sag compensation: " + (swSettings.batResAuto ? "automatic, " + (2 * batteryCurve.resistance) + " m\u03A9 for " + batteryCurve.series + "s" + batteryCurve.parallel + "p." : "manual (Advanced).")
                        }

                        SwPill {
                            anchors.horizontalCenter: parent.horizontalCenter
                            minWidth: 3.4 * unit
                            label: "ADVANCED \u203A"
                            onClicked: batteryAdvanced.open()
                        }
                    }

                    // Refloat Glow: UPDATES (CHECK FOR UPDATES on GitHub)
                    Column {
                        width: parent.width
                        spacing: 0.16 * unit
                        visible: ledWindow.section === "updates"

                        // what's installed
                        Rectangle {
                            width: parent.width
                            height: installedText.implicitHeight + 0.24 * unit
                            radius: 0.08 * unit
                            color: "#140c26"
                            border.color: swTheme.neonPurple
                            border.width: 2
                            Text {
                                id: installedText
                                anchors.centerIn: parent
                                width: parent.width - 0.24 * unit
                                horizontalAlignment: Text.AlignHCenter
                                wrapMode: Text.WordWrap
                                color: "#ead6ff"
                                font.pixelSize: fontSizeSmall
                                text: "This package: Refloat Glow " + lcmFw.pkgVersion + "\n"
                                    + "Light module: " + (lcmFw.hasBootloader ? "SLCM " + lcmFw.verText(lcmFw.lcmVer)
                                        : (lcmFw.nameKnown ? (lcmFw.lcmName !== "" ? "“" + lcmFw.lcmName + "” (not updatable from the app)" : "no SLCM detected")
                                        : "not asked yet"))
                            }
                        }

                        Rectangle {
                            anchors.horizontalCenter: parent.horizontalCenter
                            width: Math.min(parent.width, 5.2 * unit)
                            height: 1.4 * unit
                            radius: height / 2
                            opacity: updater.phase === 1 || updater.dlState === 1 ? 0.5 : 1
                            color: updCheckArea.pressed ? swTheme.neonGreen : "transparent"
                            border.color: swTheme.neonGreen
                            border.width: 3
                            Text {
                                anchors.centerIn: parent
                                text: updater.phase === 1 ? "CHECKING..." : "↻  CHECK FOR UPDATES"
                                color: updCheckArea.pressed ? swTheme.background : swTheme.neonGreen
                                font.family: "Exan"
                                font.pixelSize: 0.32 * unit
                            }
                            MouseArea {
                                id: updCheckArea
                                anchors.fill: parent
                                enabled: updater.phase !== 1 && updater.dlState !== 1
                                onClicked: updater.check()
                            }
                        }

                        SwLText {
                            width: parent.width
                            horizontalAlignment: Text.AlignHCenter
                            wrapMode: Text.WordWrap
                            font.pixelSize: fontSizeSmall
                            color: updater.phase === 3 ? "#FFB300" : swTheme.neonGreen
                            text: updater.message !== "" ? updater.message
                                : "Checks GitHub for the latest bench-tested rider release (never dev builds). Needs internet."
                        }

                        // package
                        Rectangle {
                            visible: !!updater.rel
                            width: parent.width
                            height: pkgCol.implicitHeight + 0.3 * unit
                            radius: 0.08 * unit
                            readonly property color tone: updater.pkgFit === "newer" ? "#FFB300" : swTheme.neonGreen
                            color: updater.pkgFit === "newer" ? "#2A1F00" : "#0d2a12"
                            border.color: tone
                            border.width: 2
                            Column {
                                id: pkgCol
                                anchors.centerIn: parent
                                width: parent.width - 0.3 * unit
                                spacing: 0.12 * unit
                                Text {
                                    width: parent.width
                                    horizontalAlignment: Text.AlignHCenter
                                    wrapMode: Text.WordWrap
                                    color: parent.parent.tone
                                    font.family: "Exan"
                                    font.pixelSize: 0.26 * unit
                                    text: updater.pkgFit === "newer" ? "PACKAGE UPDATE AVAILABLE"
                                        : updater.pkgFit === "same" ? "PACKAGE UP TO DATE"
                                        : updater.pkgFit === "older" ? "PACKAGE NEWER THAN THE RELEASE" : "PACKAGE"
                                }
                                Text {
                                    width: parent.width
                                    horizontalAlignment: Text.AlignHCenter
                                    wrapMode: Text.WordWrap
                                    color: "#ead6ff"
                                    font.pixelSize: fontSizeSmall
                                    text: !updater.rel ? ""
                                        : updater.pkgFit === "newer" ? updater.rel.version + " is out (you have " + lcmFw.pkgVersion + "). Install it in VESC Tool › VESC Packages, then update the light module."
                                        : updater.pkgFit === "same" ? "You have the latest release, " + lcmFw.pkgVersion + "."
                                        : updater.pkgFit === "older" ? "You have " + lcmFw.pkgVersion + ", newer than the latest release (" + updater.rel.version + "): a development build."
                                        : "Latest release: " + updater.rel.version + "."
                                }
                                SwPill {
                                    visible: updater.pkgFit === "newer" && !!updater.rel && updater.rel.pkgUrl !== ""
                                    anchors.horizontalCenter: parent.horizontalCenter
                                    minWidth: 3.6 * unit
                                    label: "DOWNLOAD PACKAGE"
                                    lit: true
                                    onClicked: Qt.openUrlExternally(updater.rel.pkgUrl)
                                }
                            }
                        }

                        // light module (SLCM)
                        Rectangle {
                            visible: !!updater.rel
                            width: parent.width
                            height: slcmCol.implicitHeight + 0.3 * unit
                            radius: 0.08 * unit
                            readonly property bool attention: updater.lcmFit === "newer" || updater.lcmFit === "other" || updater.lcmFit === "unknown"
                            readonly property color tone: attention ? "#FFB300" : (updater.lcmFit === "same" ? swTheme.neonGreen : swTheme.neonPurple)
                            color: attention ? "#2A1F00" : (updater.lcmFit === "same" ? "#0d2a12" : "#140c26")
                            border.color: tone
                            border.width: 2
                            Column {
                                id: slcmCol
                                anchors.centerIn: parent
                                width: parent.width - 0.3 * unit
                                spacing: 0.12 * unit
                                Text {
                                    width: parent.width
                                    horizontalAlignment: Text.AlignHCenter
                                    wrapMode: Text.WordWrap
                                    color: parent.parent.tone === swTheme.neonPurple ? "#c98bff" : parent.parent.tone
                                    font.family: "Exan"
                                    font.pixelSize: 0.26 * unit
                                    text: updater.lcmFit === "newer" ? "LCM UPDATE AVAILABLE"
                                        : updater.lcmFit === "same" ? "LCM UP TO DATE"
                                        : updater.lcmFit === "older" ? "LCM NEWER THAN THE RELEASE"
                                        : updater.lcmFit === "other" ? "DIFFERENT LCM BUILD"
                                        : "LIGHT MODULE (SLCM)"
                                }
                                Text {
                                    width: parent.width
                                    horizontalAlignment: Text.AlignHCenter
                                    wrapMode: Text.WordWrap
                                    color: "#ead6ff"
                                    font.pixelSize: fontSizeSmall
                                    readonly property string relText: updater.relSlcm ? "SLCM " + lcmFw.verText(updater.relSlcm) : ""
                                    readonly property string lcmText: "SLCM " + lcmFw.verText(lcmFw.lcmVer)
                                    text: updater.lcmFit === "newer" ? "The release has " + relText + ", your light module runs " + lcmText + "."
                                        : updater.lcmFit === "same" ? "Your light module runs " + lcmText + ", the release's build. You can still reflash it."
                                        : updater.lcmFit === "older" ? "Your light module runs " + lcmText + ", newer than the release's " + relText + ". Flashing would downgrade it."
                                        : updater.lcmFit === "other" ? "Your light module runs " + lcmText + ", a different build from the release's " + relText + " (e.g. a custom build)."
                                        : updater.lcmFit === "unknown" ? "This release doesn't list its SLCM version: download it to see which build it is."
                                        : updater.lcmFit === "missing" ? "This release has no SLCM.hex."
                                        : updater.lcmFit === "nolcm" ? (relText ? "The release has " + relText + ". " : "")
                                            + "No SLCM with the bootloader answered" + (lcmFw.nameKnown ? "" : " (board connected and powered on?)")
                                            + ". A light module needs SLCM.hex flashed once with an ST-Link before it can update from the app."
                                        : ""
                                }
                                SwPill {
                                    visible: !!updater.rel && updater.rel.hexUrl !== "" && updater.lcmFit !== "nolcm" && updater.dlState !== 2
                                    anchors.horizontalCenter: parent.horizontalCenter
                                    minWidth: 3.6 * unit
                                    label: updater.dlState === 1 ? "DOWNLOADING..."
                                        : updater.lcmFit === "same" ? "DOWNLOAD TO REFLASH"
                                        : updater.lcmFit === "older" ? "DOWNLOAD (DOWNGRADE)" : "DOWNLOAD UPDATE"
                                    lit: updater.lcmFit === "newer"
                                    enabledLook: updater.dlState !== 1 && !lcmFw.active
                                    onClicked: updater.download()
                                }
                                SwPill {
                                    visible: updater.dlState === 2
                                    anchors.horizontalCenter: parent.horizontalCenter
                                    minWidth: 3.6 * unit
                                    label: "FLASH UPDATE"
                                    lit: true
                                    enabledLook: !lcmFw.active
                                    onClicked: updatePrompt.open()
                                }
                                Text {
                                    visible: updater.dlMessage !== ""
                                    width: parent.width
                                    horizontalAlignment: Text.AlignHCenter
                                    wrapMode: Text.WordWrap
                                    color: updater.dlState === 3 ? "#FFB300" : swTheme.neonGreen
                                    font.pixelSize: fontSizeSmall
                                    text: updater.dlMessage
                                }
                            }
                        }

                        // release notes
                        SwLText {
                            visible: !!updater.rel && updater.rel.notes !== ""
                            width: parent.width
                            wrapMode: Text.WordWrap
                            font.pixelSize: fontSizeSmall
                            textFormat: Text.PlainText
                            text: updater.rel ? "Release notes (" + updater.rel.tag + "):\n" + updater.rel.notes.substr(0, 1200) : ""
                        }

                        SwPill {
                            anchors.horizontalCenter: parent.horizontalCenter
                            minWidth: 3.6 * unit
                            label: "OPEN RELEASE PAGE"
                            onClicked: Qt.openUrlExternally(updater.rel ? updater.rel.page : updater.releasesPage)
                        }
                    }

                    Column {
                        width: parent.width
                        spacing: 0.14 * unit
                        visible: ledWindow.section === "fw"

                        LedHeading { text: "Light module" }

                        SwLText {
                            visible: !slcmDetect.present && !lcmFw.active
                            width: parent.width
                            horizontalAlignment: Text.AlignHCenter
                            wrapMode: Text.WordWrap
                            font.pixelSize: fontSizeSmall
                            color: "#FFB300"
                            text: "This only applies to Floatwheel, XRV, Pint V and GTV light modules with the SLCM firmware installed."
                        }

                        Rectangle {
                            width: parent.width
                            height: lcmFittedText.implicitHeight + 0.24 * unit
                            radius: 0.08 * unit
                            readonly property color tone: lcmFw.checkState === 2 || lcmFw.active ? swTheme.neonGreen
                                : (lcmFw.checkState === 3 ? "#FFB300" : swTheme.neonPurple)
                            color: lcmFw.checkState === 2 || lcmFw.active ? "#0d2a12" : (lcmFw.checkState === 3 ? "#2A1F00" : "#140c26")
                            border.color: tone
                            border.width: 2
                            Text {
                                id: lcmFittedText
                                anchors.centerIn: parent
                                width: parent.width - 0.24 * unit
                                horizontalAlignment: Text.AlignHCenter
                                wrapMode: Text.WordWrap
                                color: parent.tone === swTheme.neonPurple ? "#ead6ff" : parent.tone
                                font.pixelSize: fontSizeSmall
                                text: lcmFw.fittedText
                            }
                        }

                        // step 1: CHECK LCM (required before FLASH LCM shows)
                        Rectangle {
                            visible: !lcmFw.canFlash
                            anchors.horizontalCenter: parent.horizontalCenter
                            width: Math.min(parent.width, 4.6 * unit)
                            height: 1.4 * unit
                            radius: height / 2
                            opacity: lcmFw.checkState === 1 ? 0.5 : 1
                            color: checkBtnArea.pressed ? "#FFB300" : "transparent"
                            border.color: "#FFB300"
                            border.width: 3
                            Text {
                                anchors.centerIn: parent
                                text: lcmFw.checkState === 1 ? "CHECKING..." : (lcmFw.checkState === 0 ? "\u2714  CHECK LCM" : "\u21BB  CHECK AGAIN")
                                color: checkBtnArea.pressed ? swTheme.background : "#FFB300"
                                font.family: "Exan"
                                font.pixelSize: 0.36 * unit
                            }
                            MouseArea {
                                id: checkBtnArea
                                anchors.fill: parent
                                enabled: lcmFw.checkState !== 1
                                onClicked: lcmFw.check()
                            }
                        }

                        SwLText {
                            visible: !lcmFw.canFlash
                            width: parent.width
                            horizontalAlignment: Text.AlignHCenter
                            wrapMode: Text.WordWrap
                            font.pixelSize: fontSizeSmall
                            text: "Board on and connected. CHECK LCM finds the light module firmware; FLASH LCM appears only with the bootloader."
                        }

                        LedHeading { visible: lcmFw.canFlash; text: "Firmware to flash" }

                        Flow {
                            visible: lcmFw.canFlash
                            width: parent.width
                            spacing: 0.12 * unit
                            SwPill {
                                visible: lcmFw.builtinImage
                                minWidth: 2.4 * unit
                                label: "BUILT-IN"
                                lit: !lcmFw.usePicked
                                enabledLook: !!lcmFw.builtin && !lcmFw.active
                                onClicked: if (lcmFw.builtin && !lcmFw.active) lcmFw.usePicked = false
                            }
                            SwPill {
                                minWidth: 2.4 * unit
                                label: lcmFw.picked ? "PICKED .HEX" : "PICK .HEX FILE..."
                                lit: lcmFw.usePicked || !lcmFw.builtinImage
                                enabledLook: !lcmFw.active
                                onClicked: {
                                    if (lcmFw.active) return;
                                    if (lcmFw.picked && !lcmFw.usePicked && lcmFw.builtinImage) lcmFw.usePicked = true;
                                    else hexLoadDialog.show();
                                }
                            }
                            SwPill {
                                visible: !!lcmFw.picked
                                minWidth: 1.6 * unit
                                label: "CHANGE..."
                                enabledLook: !lcmFw.active
                                onClicked: if (!lcmFw.active) hexLoadDialog.show()
                            }
                        }

                        SwLText {
                            visible: lcmFw.canFlash
                            width: parent.width
                            wrapMode: Text.WordWrap
                            font.pixelSize: fontSizeSmall
                            text: lcmFw.image === lcmFw.picked && lcmFw.picked
                                ? "File: " + lcmFw.picked.file + " \u00B7 " + (lcmFw.picked.slcm ? "SLCM " + lcmFw.verText(lcmFw.parseVer(lcmFw.picked.slcm)) : "version unknown")
                                    + " (" + lcmFw.picked.size + " bytes)."
                                    + (lcmFw.pkgVer && lcmFw.picked.slcm && lcmFw.parseVer(lcmFw.picked.slcm).hash !== lcmFw.pkgVer.hash ? " Note: this package goes with SLCM " + lcmFw.verText(lcmFw.pkgVer) + "." : "")
                                : (lcmFw.builtinImage
                                    ? "Built into this package: SLCM build " + lcmFw.builtin.version + " (" + lcmFw.builtin.size + " bytes)."
                                    : "Get the latest SLCM in UPDATES, or download SLCM.hex (github.com/thedukesedge-collab/scott-wheelz, release lcm-latest) and PICK .HEX FILE."
                                        + (lcmFw.pkgVer ? " This package goes with SLCM " + lcmFw.verText(lcmFw.pkgVer) + "." : ""))
                        }

                        Rectangle {
                            visible: lcmFw.canFlash
                            anchors.horizontalCenter: parent.horizontalCenter
                            width: Math.min(parent.width, 4.6 * unit)
                            height: 1.4 * unit
                            radius: height / 2
                            opacity: lcmFw.image && !lcmFw.active ? 1 : 0.4
                            color: fwBtnArea.pressed ? swTheme.neonGreen : "transparent"
                            border.color: swTheme.neonGreen
                            border.width: 3
                            Text {
                                anchors.centerIn: parent
                                text: lcmFw.active ? "FLASHING..." : "\u21BB  FLASH LCM"
                                color: fwBtnArea.pressed ? swTheme.background : swTheme.neonGreen
                                font.family: "Exan"
                                font.pixelSize: 0.36 * unit
                            }
                            MouseArea {
                                id: fwBtnArea
                                anchors.fill: parent
                                enabled: !!lcmFw.image && !lcmFw.active && lcmFw.canFlash
                                onClicked: { lcmFwConfirm.ack = false; lcmFwConfirm.open(); }
                            }
                        }

                        // progress
                        Rectangle {
                            visible: lcmFw.active || lcmFw.progress > 0
                            width: parent.width
                            height: 0.22 * unit
                            radius: height / 2
                            color: "transparent"
                            border.color: swTheme.neonPurple
                            border.width: 2
                            Rectangle {
                                x: 2; y: 2
                                height: parent.height - 4
                                radius: height / 2
                                width: Math.max(0, (parent.width - 4) * lcmFw.progress)
                                color: swTheme.neonGreen
                            }
                        }

                        SwLText {
                            width: parent.width
                            horizontalAlignment: Text.AlignHCenter
                            wrapMode: Text.WordWrap
                            font.pixelSize: fontSizeSmall
                            color: lcmFw.pkgState === 4 || lcmFw.message.indexOf("Not ") === 0 || lcmFw.message.indexOf("No ") === 0
                                   || lcmFw.message.indexOf("This .hex") === 0 || lcmFw.message.indexOf("The vector") === 0
                                   || lcmFw.message.indexOf("Checksum") === 0 || lcmFw.message.indexOf("Couldn't") === 0
                                   ? "#FFB300" : swTheme.neonGreen
                            text: lcmFw.message
                        }

                        SwPill {
                            anchors.horizontalCenter: parent.horizontalCenter
                            visible: lcmFw.active
                            minWidth: 2.4 * unit
                            label: "CANCEL"
                            onClicked: lcmFw.cancel()
                        }

                        SwLText {
                            width: parent.width
                            wrapMode: Text.WordWrap
                            font.pixelSize: fontSizeSmall
                            text: "\u2022 Only for LCMs with the bootloader (SLCM.hex, flashed once with an ST-Link). Stock LCM firmware can't be flashed from the app.\n"
                                + "\u2022 Board on and idle; refused while riding. Don't ride until done.\n"
                                + "\u2022 Lights and beeper go off for about a minute. Keep the app connected.\n"
                                + "\u2022 If interrupted, the LCM stays on and waits: FLASH LCM again (power-cycle first if needed). Hold the button 2 s to power off."
                        }
                    }
                }
            }

            SwLText {
                // head / bar are Refloat's own settings (any controller)
                // rf92: also not in RGB LIGHTS / BEEPER / UPDATES (not SLCM things)
                visible: slcmDetect.present || ["head", "bar", "rgb", "sound", "updates"].indexOf(ledWindow.section) < 0
                Layout.fillWidth: true
                horizontalAlignment: Text.AlignHCenter
                wrapMode: Text.WordWrap
                font.pixelSize: 0.17 * unit
                color: slcmDetect.present ? swTheme.neonGreen : "#FFB300"
                text: slcmDetect.present ? "\u2714 SLCM " + slcmDetect.version + " detected"
                    : (ledWindow.section === "head" || ledWindow.section === "bar"
                        ? "Brightness also sets controller-driven LEDs (any controller); the rest needs SLCM"
                        : "\u26A0 Needs the SLCM light module firmware")
            }
        }
    }

    // Refloat Glow: battery gauge, advanced mode (full screen): my own cell
    // (name, size, resistance, capacity, curve), manual sag compensation
    Popup {
        id: batteryAdvanced
        parent: mainItem
        x: 0
        y: 0
        width: mainItem.width
        height: mainItem.height
        modal: true
        dim: true
        padding: 0.25 * unit
        closePolicy: Popup.CloseOnEscape

        readonly property var editPoints: batteryCurve.custom ? batteryCurve.custom.points : batteryCurve.current.points

        background: Rectangle {
            color: "#0b0718"
            border.color: swTheme.neonPurple
            border.width: 2
        }

        ColumnLayout {
            anchors.fill: parent
            spacing: 0.15 * unit

            RowLayout {
                Layout.fillWidth: true
                SwPill {
                    minWidth: 1.8 * unit
                    label: "\u2039 BACK"
                    onClicked: batteryAdvanced.close()
                }
                SwNeonLabel {
                    Layout.fillWidth: true
                    horizontalAlignment: Text.AlignHCenter
                    font.pixelSize: 0.32 * unit
                    text: "BATTERY \u00B7 ADVANCED"
                }
                Item { implicitWidth: 1.8 * unit; implicitHeight: 1 }
            }

            Rectangle { Layout.fillWidth: true; height: 2; color: swTheme.neonPurple; opacity: 0.6 }

            Flickable {
                Layout.fillWidth: true
                Layout.fillHeight: true
                clip: true
                contentHeight: batAdvCol.height + 0.4 * unit
                boundsBehavior: Flickable.StopAtBounds

                Column {
                    id: batAdvCol
                    width: parent.width
                    spacing: 0.14 * unit

                    SwLText {
                        width: parent.width
                        horizontalAlignment: Text.AlignHCenter
                        wrapMode: Text.WordWrap
                        font.pixelSize: fontSizeSmall
                        color: swTheme.neonGreen
                        text: batteryCurve.cells > 0
                            ? "Now: " + batteryCurve.volts.toFixed(1) + " V \u00B7 " + batteryCurve.cells + "s \u00B7 "
                                + (batteryCurve.volts / batteryCurve.cells).toFixed(2) + " V/cell \u2192 "
                                + (batteryCurve.percent <= 100 ? batteryCurve.percent + " %" : "VESC's own %")
                            : "Waiting for the board..."
                    }

                    LedHeading { text: "My cell" }

                    RowLayout {
                        width: parent.width
                        SwLText { text: "NAME"; font.pixelSize: fontSizeSmall }
                        TextField {
                            Layout.fillWidth: true
                            maximumLength: 16
                            color: swTheme.neonGreen
                            text: batteryCurve.custom ? batteryCurve.custom.name : "MY CELL"
                            onEditingFinished: {
                                var t = text.trim() || "MY CELL";
                                batteryCurve.editCustom(function (c) { c.name = t; });
                            }
                        }
                    }

                    Row {
                        anchors.horizontalCenter: parent.horizontalCenter
                        spacing: 0.15 * unit
                        Repeater {
                            model: ["18650", "21700"]
                            SwPill {
                                minWidth: 2.2 * unit
                                label: modelData
                                lit: (batteryCurve.custom ? batteryCurve.custom.size : swSettings.batSize) === modelData
                                onClicked: batteryCurve.editCustom(function (c) { c.size = modelData; })
                            }
                        }
                    }

                    SwStepper {
                        label: "RESISTANCE (DC)"
                        value: batteryCurve.custom ? batteryCurve.custom.ir : batteryCurve.current.ir
                        from: 3; to: 80; step: 1; suffix: " m\u03A9"
                        onMoved: {
                            batteryCurve.editCustom(function (c) { c.ir = newValue; });
                            if (swSettings.batCell === "MY CELL") batteryCurve.changed();
                        }
                    }

                    SwStepper {
                        label: "CAPACITY"
                        value: batteryCurve.custom ? batteryCurve.custom.cap : 3000
                        from: 1000; to: 7000; step: 50; suffix: " mAh"
                        onMoved: batteryCurve.editCustom(function (c) { c.cap = newValue; })
                    }

                    SwLText {
                        width: parent.width
                        wrapMode: Text.WordWrap
                        font.pixelSize: fontSizeSmall
                        text: "Start the curve from a known cell:"
                    }

                    Flow {
                        width: parent.width
                        spacing: 0.12 * unit
                        Repeater {
                            model: batteryCurve.cellList
                            SwPill {
                                minWidth: 1.5 * unit
                                label: modelData.name
                                onClicked: {
                                    var src = modelData;
                                    batteryCurve.editCustom(function (c) { c.points = src.points.slice(); c.ir = src.ir; c.size = src.size; });
                                    if (swSettings.batCell === "MY CELL") batteryCurve.changed();
                                }
                            }
                        }
                    }

                    LedHeading { text: "Volts per cell" }

                    Repeater {
                        model: 11
                        SwStepper {
                            label: (100 - 10 * index) + " %"
                            value: batteryAdvanced.editPoints[index]
                            // keep the curve falling: stay between the neighbours
                            from: index < 10 ? batteryAdvanced.editPoints[index + 1] + 1 : 0
                            to: index > 0 ? batteryAdvanced.editPoints[index - 1] - 1 : 255
                            step: 1
                            valueText: (batteryCurve.mv(value) / 1000).toFixed(2) + " V"
                            onMoved: batteryCurve.setCustomPoint(index, newValue)
                        }
                    }

                    SwPill {
                        anchors.horizontalCenter: parent.horizontalCenter
                        minWidth: 3.4 * unit
                        label: swSettings.batCell === "MY CELL" ? "USING MY CELL" : "USE MY CELL"
                        lit: swSettings.batCell === "MY CELL"
                        onClicked: batteryCurve.useCustom()
                    }

                    LedHeading { text: "Sag compensation" }

                    Row {
                        anchors.horizontalCenter: parent.horizontalCenter
                        spacing: 0.15 * unit
                        SwPill {
                            minWidth: 2.2 * unit
                            label: "AUTO"
                            lit: swSettings.batResAuto
                            onClicked: { swSettings.batResAuto = true; batteryCurve.changed(); }
                        }
                        SwPill {
                            minWidth: 2.2 * unit
                            label: "MANUAL"
                            lit: !swSettings.batResAuto
                            onClicked: { swSettings.batResAuto = false; batteryCurve.changed(); }
                        }
                    }

                    SwStepper {
                        visible: !swSettings.batResAuto
                        label: "PACK RESISTANCE"
                        value: swSettings.batRes
                        from: 0; to: 250; step: 5
                        valueText: (2 * value) + " m\u03A9"
                        onMoved: { swSettings.batRes = newValue; batteryCurve.changed(); }
                    }

                    SwLText {
                        width: parent.width
                        wrapMode: Text.WordWrap
                        font.pixelSize: fontSizeSmall
                        text: "AUTO = cell resistance \u00D7 series \u00F7 parallel: " + batteryCurve.current.ir + " m\u03A9 \u00D7 " + batteryCurve.series
                            + " \u00F7 " + batteryCurve.parallel + " \u2248 " + (2 * batteryCurve.autoRes) + " m\u03A9"
                            + (batteryCurve.current.irEst ? " (cell resistance estimated)" : "") + ". "
                            + "Adds back the voltage drop under load. Raise it if the gauge drops when you accelerate, lower it if it jumps up.\n\n"
                            + "The curve turns voltage into a % for the SLCM status bar. Series cells come from the motor config (Additional Info)."
                    }
                }
            }
        }
    }

    // Refloat Glow: FLASH LCM warning - must be acknowledged first
    Popup {
        id: lcmFwConfirm
        parent: mainItem
        x: (mainItem.width - width) / 2
        y: (mainItem.height - height) / 2
        width: mainItem.width * 0.92
        modal: true
        dim: true
        padding: 0.3 * unit
        closePolicy: Popup.CloseOnEscape

        property bool ack: false

        background: Rectangle {
            color: "#140d02"
            radius: 0.25 * unit
            border.color: "#FFB300"
            border.width: 3
        }

        Column {
            width: parent.width
            spacing: 0.18 * unit

            Text {
                width: parent.width
                horizontalAlignment: Text.AlignHCenter
                text: "\u26A0 FLASH LCM FIRMWARE"
                color: "#FFB300"
                font.family: "Exan"
                font.pixelSize: 0.36 * unit
            }

            Text {
                width: parent.width
                wrapMode: Text.WordWrap
                color: "#ffe3a3"
                font.pixelSize: fontSizeSmall
                text: "This rewrites the firmware of your board's light control module (LCM), the part that also switches the board's power.\n\n"
                    + "Firmware: " + (lcmFw.image ? (lcmFw.usePicked ? "file " : "built-in ") + lcmFw.image.version + " (" + lcmFw.image.size + " bytes)" : "none") + "\n\n"
                    + "\u2022 Only for Floatwheel LCMs (tested: XRV) with the SLCM bootloader (SLCM.hex via ST-Link once). Not stock LCM firmware.\n"
                    + "\u2022 Only flash files built for this bootloader (SLCM) from a source you trust.\n"
                    + "\u2022 Board on, idle, on a stand. Don't ride, step on it or switch it off until Done (about a minute).\n"
                    + "\u2022 Headlights and beeper are off while it flashes. Keep this app open and connected.\n"
                    + "\u2022 If interrupted, the LCM stays on and waits: FLASH LCM again (power-cycle first if needed). Hold the button 2 s to power off.\n"
                    + "\u2022 Experimental, at your own risk. Keep an ST-Link and your old LCM firmware as a fallback."
            }

            Row {
                spacing: 0.15 * unit
                Rectangle {
                    width: 0.5 * unit; height: width; radius: 0.08 * unit
                    color: lcmFwConfirm.ack ? "#FFB300" : "transparent"
                    border.color: "#FFB300"; border.width: 2
                    Text { anchors.centerIn: parent; text: lcmFwConfirm.ack ? "\u2713" : ""; color: "#140d02"; font.pixelSize: 0.36 * unit }
                    MouseArea { anchors.fill: parent; onClicked: lcmFwConfirm.ack = !lcmFwConfirm.ack }
                }
                Text {
                    width: lcmFwConfirm.width - 1.4 * unit
                    anchors.verticalCenter: parent.verticalCenter
                    wrapMode: Text.WordWrap
                    color: "#ffe3a3"
                    font.pixelSize: fontSizeSmall
                    text: "I understand and my board is idle on a stand"
                    MouseArea { anchors.fill: parent; onClicked: lcmFwConfirm.ack = !lcmFwConfirm.ack }
                }
            }

            Row {
                anchors.horizontalCenter: parent.horizontalCenter
                spacing: 0.3 * unit
                SwPill {
                    minWidth: 2.2 * unit
                    label: "CANCEL"
                    onClicked: lcmFwConfirm.close()
                }
                SwPill {
                    minWidth: 2.6 * unit
                    label: "FLASH LCM"
                    lit: lcmFwConfirm.ack
                    enabledLook: lcmFwConfirm.ack
                    onClicked: {
                        if (!lcmFwConfirm.ack) return;
                        lcmFwConfirm.close();
                        if (lcmFw.canFlash) lcmFw.start();
                    }
                }
            }
        }
    }

    // Refloat Glow (rf81): neon number pad for the settings' number
    // fields (IntTextField) - themed like the rest, DONE applies the value
    // (kept within the field's range) and closes it
    Popup {
        id: numPad
        parent: mainItem
        x: 0
        y: mainItem.height - height
        width: mainItem.width
        modal: true
        dim: true
        padding: 0.25 * unit
        closePolicy: Popup.CloseOnEscape | Popup.CloseOnPressOutside

        property string label: ""
        property string unitText: ""
        property string entry: ""
        property bool fresh: true  // the first key replaces the old value
        property int minValue: 0
        property int maxValue: 100
        property var apply: null

        function edit(lbl, value, mn, mx, unitTxt, fn) {
            label = lbl;
            unitText = unitTxt || "";
            minValue = mn;
            maxValue = mx;
            entry = String(value);
            fresh = true;
            apply = fn;
            open();
        }
        function key(k) {
            if (k === "<") {
                entry = fresh ? "" : entry.slice(0, -1);
            } else if (entry.length < Math.max(4, String(maxValue).length) || fresh) {
                entry = (fresh ? "" : entry) + k;
                if (entry.length > 1 && entry.charAt(0) === "0") entry = entry.substr(1);
            }
            fresh = false;
        }
        function done() {
            if (entry !== "" && apply) {
                apply(Math.max(minValue, Math.min(maxValue, parseInt(entry))));
            }
            close();
        }

        background: Rectangle {
            color: "#0b0718"
            radius: 0.25 * unit
            border.color: swTheme.neonPurple
            border.width: 2
        }

        Column {
            width: parent.width
            spacing: 0.15 * unit

            SwNeonLabel {
                width: parent.width
                horizontalAlignment: Text.AlignHCenter
                text: numPad.label.toUpperCase()
            }

            Text {
                width: parent.width
                horizontalAlignment: Text.AlignHCenter
                color: swTheme.neonGreen
                font.family: "Exan"
                font.pixelSize: 0.6 * unit
                text: (numPad.entry === "" ? "-" : numPad.entry) + (numPad.unitText !== "" ? " " + numPad.unitText : "")
            }

            SwLText {
                width: parent.width
                horizontalAlignment: Text.AlignHCenter
                font.pixelSize: fontSizeSmall
                readonly property int v: numPad.entry === "" ? -1 : parseInt(numPad.entry)
                color: v >= 0 && (v < numPad.minValue || v > numPad.maxValue) ? "#FFB300" : "#c98bff"
                text: numPad.minValue + " \u2013 " + numPad.maxValue
                    + (v >= 0 && (v < numPad.minValue || v > numPad.maxValue) ? " \u00B7 DONE keeps it in range" : "")
            }

            Grid {
                anchors.horizontalCenter: parent.horizontalCenter
                columns: 3
                spacing: 0.15 * unit
                Repeater {
                    model: ["1", "2", "3", "4", "5", "6", "7", "8", "9", "<", "0", "DONE"]
                    Rectangle {
                        width: (numPad.availableWidth - 0.3 * unit) / 3
                        height: 0.95 * unit
                        radius: 0.2 * unit
                        readonly property bool isDone: modelData === "DONE"
                        color: padKey.pressed || isDone ? swTheme.neonGreen : "#140a26"
                        border.color: isDone || padKey.pressed ? swTheme.neonGreen : swTheme.neonPurple
                        border.width: 2
                        Text {
                            anchors.centerIn: parent
                            text: modelData === "<" ? "\u232B" : modelData
                            color: padKey.pressed || parent.isDone ? swTheme.background : swTheme.neonGreen
                            font.family: modelData === "<" ? "" : "Exan"
                            font.pixelSize: (parent.isDone ? 0.3 : 0.42) * unit
                        }
                        MouseArea {
                            id: padKey
                            anchors.fill: parent
                            onClicked: parent.isDone ? numPad.done() : numPad.key(modelData)
                        }
                    }
                }
            }
        }
    }

    // Refloat Glow: SLCM update downloaded (UPDATES tab) -> flash it?
    Popup {
        id: updatePrompt
        parent: mainItem
        x: (mainItem.width - width) / 2
        y: (mainItem.height - height) / 2
        width: mainItem.width * 0.92
        modal: true
        dim: true
        padding: 0.3 * unit
        closePolicy: Popup.CloseOnEscape

        background: Rectangle {
            color: "#06180b"
            radius: 0.25 * unit
            border.color: swTheme.neonGreen
            border.width: 3
        }

        Column {
            width: parent.width
            spacing: 0.2 * unit

            Text {
                width: parent.width
                horizontalAlignment: Text.AlignHCenter
                text: "\u2714 LCM UPDATE DOWNLOADED"
                color: swTheme.neonGreen
                font.family: "Exan"
                font.pixelSize: 0.34 * unit
            }

            Text {
                width: parent.width
                wrapMode: Text.WordWrap
                color: "#c9ffd8"
                font.pixelSize: fontSizeSmall
                text: (updater.dlMessage + "\n\n")
                    + (lcmFw.hasBootloader ? "Your light module runs SLCM " + lcmFw.verText(lcmFw.lcmVer) + ".\n\n" : "")
                    + "FLASH UPDATE opens the LCM tools with this file and runs CHECK LCM; then CONTINUE and FLASH LCM.\n\n"
                    + "Board on and idle, app connected. It won't start while updating (about a minute)."
            }

            Row {
                anchors.horizontalCenter: parent.horizontalCenter
                spacing: 0.3 * unit
                SwPill {
                    minWidth: 2.2 * unit
                    label: "LATER"
                    onClicked: updatePrompt.close()
                }
                SwPill {
                    minWidth: 3.2 * unit
                    label: "FLASH UPDATE"
                    lit: true
                    onClicked: {
                        updatePrompt.close();
                        updater.flash();
                    }
                }
            }
        }
    }

    // Refloat Glow: result of CHECK LCM (LEDS > LCM firmware tools)
    Popup {
        id: lcmCheckPopup
        parent: mainItem
        x: (mainItem.width - width) / 2
        y: (mainItem.height - height) / 2
        width: mainItem.width * 0.92
        modal: true
        dim: true
        padding: 0.3 * unit
        closePolicy: Popup.CloseOnEscape

        readonly property bool passed: lcmFw.checkState === 2
        readonly property color tone: passed ? swTheme.neonGreen : "#FFB300"

        background: Rectangle {
            color: lcmCheckPopup.passed ? "#06180b" : "#140d02"
            radius: 0.25 * unit
            border.color: lcmCheckPopup.tone
            border.width: 3
        }

        Column {
            width: parent.width
            spacing: 0.2 * unit

            Text {
                width: parent.width
                horizontalAlignment: Text.AlignHCenter
                text: lcmCheckPopup.passed ? "\u2714 LCM CHECK PASSED" : "\u26A0 LCM CHECK FAILED"
                color: lcmCheckPopup.tone
                font.family: "Exan"
                font.pixelSize: 0.36 * unit
            }

            // firmware version verdict (passed checks)
            Rectangle {
                visible: lcmCheckPopup.passed && lcmFw.fitTitle !== "" && lcmFw.fitted !== "recovery" && lcmFw.fitted !== "legacy"
                anchors.horizontalCenter: parent.horizontalCenter
                width: fitTitleText.implicitWidth + 0.5 * unit
                height: 0.6 * unit
                radius: height / 2
                color: "transparent"
                border.width: 2
                border.color: lcmFw.fit === "same" ? swTheme.neonGreen : "#FFB300"
                Text {
                    id: fitTitleText
                    anchors.centerIn: parent
                    text: lcmFw.fitTitle
                    color: parent.border.color
                    font.family: "Exan"
                    font.pixelSize: 0.22 * unit
                }
            }

            Text {
                width: parent.width
                wrapMode: Text.WordWrap
                color: lcmCheckPopup.passed ? "#c9ffd8" : "#ffe3a3"
                font.pixelSize: fontSizeSmall
                text: lcmCheckPopup.passed
                    ? (lcmFw.fitted === "recovery"
                        ? "The LCM bootloader is waiting (an update didn't finish). Continue to flash and recover it."
                        : lcmFw.fitted === "legacy"
                        ? "Your light module works with the package, but it's an older build (before r15) that doesn't say whether it has the bootloader.\n\n"
                            + "TRY UPDATE is safe: with the bootloader it updates; without, nothing happens and after 15 s the app says so (then flash SLCM.hex with an ST-Link)."
                            + (lcmFw.pkgVer ? "\n\nThis package goes with SLCM " + lcmFw.verText(lcmFw.pkgVer) + "." : "")
                        : "Found SLCM light module firmware with the bootloader, so the package can update it over Bluetooth.\n\n"
                            + lcmFw.fitText)
                    : "Most likely the LCM firmware has no bootloader for BLE updates.\n\n"
                        + "Flash SLCM.hex (lcm-latest release) once with an ST-Link; after that, updates work from the app.\n\n"
                        + "What the package saw: " + (!lcmFw.nameKnown && !lcmFw.gotStatus ? "no answer from the board (check the connection)."
                            : lcmFw.fitted === "vp" ? "SLCM " + lcmFw.verText(lcmFw.lcmVer) + " without the bootloader."
                            : lcmFw.fitted === "other" ? "LCM firmware \u201C" + lcmFw.lcmName + "\u201D (not SLCM)."
                            : lcmFw.lcmPolling ? "a light module answers but doesn't name itself: not SLCM r15+ (older SLCM, original ALCM or other firmware)."
                            : "no light module answers. Stock Floatwheel LCM firmware never does, or the LCM isn't connected.")
                        + (lcmFw.builtin ? "\n\nThis package carries SLCM " + lcmFw.verText(lcmFw.pkgVer) + ": the SLCM.hex for the ST-Link must be that build or newer." : "")
            }

            Row {
                anchors.horizontalCenter: parent.horizontalCenter
                spacing: 0.3 * unit
                SwPill {
                    minWidth: 2.2 * unit
                    label: lcmCheckPopup.passed ? "CANCEL" : "OK"
                    onClicked: lcmCheckPopup.close()
                }
                SwPill {
                    visible: lcmCheckPopup.passed
                    minWidth: 3.2 * unit
                    label: lcmFw.continueLabel
                    lit: lcmFw.fit !== "newer"
                    onClicked: {
                        lcmCheckPopup.close();
                        if (lcmFw.capable) lcmFw.unlocked = true;
                    }
                }
            }
        }
    }

    Popup {
        id: myMelodiesPopup
        parent: mainItem
        x: 0
        width: mainItem.width
        height: mainItem.height * 0.6
        y: mainItem.height - height
        modal: true
        dim: true
        padding: 0.3 * unit
        closePolicy: Popup.CloseOnEscape | Popup.CloseOnPressOutside
        onClosed: savedMelodyList.deleteArmed = ""

        background: Rectangle {
            color: "#0b0718"
            radius: 0.3 * unit
            border.color: swTheme.neonPurple
            border.width: 2
        }

        ColumnLayout {
            anchors.fill: parent
            spacing: 0.2 * unit

            RowLayout {
                Layout.fillWidth: true

                SwNeonLabel {
                    Layout.fillWidth: true
                    horizontalAlignment: Text.AlignLeft
                    font.pixelSize: 0.36 * unit
                    text: "MY MELODIES"
                }

                SwPill {
                    minWidth: 1.0 * unit
                    label: "\u2715"
                    onClicked: myMelodiesPopup.close()
                }
            }

            SwLText {
                Layout.fillWidth: true
                wrapMode: Text.WordWrap
                font.pixelSize: fontSizeSmall
                text: "Tap a melody to play it at bootup. \u29C9 copies it as text, \u270E re-records it, \u2715 (tap twice) deletes it."
            }

            // clipboard helper for \u29C9
            TextEdit { id: melodyClip; visible: false }

            Flickable {
                Layout.fillWidth: true
                Layout.fillHeight: true
                clip: true
                contentHeight: savedMelodyList.height
                boundsBehavior: Flickable.StopAtBounds

                Item {
                    width: parent.width
                    height: savedMelodyList.height

                    Column {
                        id: savedMelodyList
                        anchors.horizontalCenter: parent.horizontalCenter
                        spacing: 0.12 * unit
                        property string deleteArmed: ""
                        property string current: {
                            swSettings.melodyRec;  // re-evaluate when the melody changes
                            return melodyLib.currentName();
                        }

                        SwLText {
                            width: 8.4 * unit
                            horizontalAlignment: Text.AlignHCenter
                            wrapMode: Text.WordWrap
                            visible: melodyLib.items.length === 0
                            font.pixelSize: fontSizeSmall
                            text: "No saved melodies yet: record one in MIXER \u25B8 REC, then SAVE."
                        }

                        Repeater {
                            model: melodyLib.items

                            Row {
                                spacing: 0.12 * unit
                                property string name: modelData.name

                                SwPill {
                                    width: 3.7 * unit
                                    label: parent.name
                                    lit: swSettings.hornBootMelody && swSettings.hornBootCustom && savedMelodyList.current === parent.name
                                    onClicked: { savedMelodyList.deleteArmed = ""; melodyLib.select(parent.name); }
                                }

                                SwPill {
                                    minWidth: 1.0 * unit
                                    label: "\u270E"
                                    onClicked: {
                                        // open it in the MIXER recorder (boot setting unchanged)
                                        savedMelodyList.deleteArmed = "";
                                        var i = melodyLib.find(parent.name);
                                        if (i >= 0) {
                                            swSettings.melodyRec = JSON.stringify(melodyLib.items[i].notes);
                                            hornSettingsSender.sendMelody();
                                        }
                                        myMelodiesPopup.close();
                    melodyPad.startRecording();
                                    }
                                }

                                // copy the notes as text (to share it, or send it to the developer)
                                SwPill {
                                    minWidth: 0.8 * unit
                                    label: "\u29C9"
                                    onClicked: {
                                        var i = melodyLib.find(parent.name);
                                        if (i < 0) return;
                                        melodyClip.text = "RFMELODY " + parent.name + " " + JSON.stringify(melodyLib.items[i].notes);
                                        melodyClip.selectAll();
                                        melodyClip.copy();
                                        VescIf.emitStatusMessage("Melody code copied: paste it in a message", true);
                                    }
                                }

                                SwPill {
                                    minWidth: savedMelodyList.deleteArmed === parent.name ? 1.9 * unit : 1.0 * unit
                                    label: savedMelodyList.deleteArmed === parent.name ? "DELETE?" : "\u2715"
                                    lit: savedMelodyList.deleteArmed === parent.name
                                    onClicked: {
                                        if (savedMelodyList.deleteArmed === parent.name) {
                                            savedMelodyList.deleteArmed = "";
                                            melodyLib.remove(parent.name);
                                        } else {
                                            savedMelodyList.deleteArmed = parent.name;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // rf106: TEST the boot melody right here (big neon button)
            Rectangle {
                Layout.alignment: Qt.AlignHCenter
                Layout.preferredWidth: Math.min(parent.width, 5.0 * unit)
                Layout.preferredHeight: 1.1 * unit
                radius: height / 2
                readonly property bool ready: state.pkgState === state.s_Ready
                color: melTestArea.pressed ? swTheme.neonGreen : "transparent"
                border.color: ready ? swTheme.neonGreen : swTheme.neonPurple
                border.width: 3
                Text {
                    anchors.centerIn: parent
                    text: "\u266A  TEST"
                    color: melTestArea.pressed ? swTheme.background : (parent.ready ? swTheme.neonGreen : swTheme.neonPurple)
                    font.family: "Exan"
                    font.pixelSize: 0.36 * unit
                }
                MouseArea {
                    id: melTestArea
                    anchors.fill: parent
                    onClicked: {
                        if (parent.ready) {
                            hornSettingsSender.playMelody(swSettings.hornBootCustom);
                        } else {
                            VescIf.emitStatusMessage("Melody test works when the board is idle (READY)", false);
                        }
                    }
                }
            }

            Row {
                Layout.alignment: Qt.AlignHCenter
                spacing: 0.2 * unit

                SwPill {
                    label: "DEFAULT MELODY"
                    lit: swSettings.hornBootMelody && !swSettings.hornBootCustom
                    onClicked: { swSettings.hornBootMelody = true; swSettings.hornBootCustom = false; hornSettingsSender.send(); }
                }

                SwPill {
                    label: "+ RECORD NEW"
                    lit: true
                    onClicked: { myMelodiesPopup.close(); melodyPad.startRecording(); }
                }
            }

            // rf99: classics - tap to add one to MY MELODIES (and use it at boot)
            SwNeonLabel {
                Layout.alignment: Qt.AlignHCenter
                font.pixelSize: 0.26 * unit
                text: "CLASSICS"
            }
            Flow {
                Layout.fillWidth: true
                spacing: 0.15 * unit
                Repeater {
                    model: melodyLib.presets
                    SwPill {
                        label: modelData[0].toUpperCase()
                        lit: melodyLib.find(modelData[0]) >= 0
                        onClicked: melodyLib.addPreset(index)
                    }
                }
            }
        }
    }

    // Refloat Glow: name a melody from the MIXER recorder
    BaseDialog {
        id: saveMelodyDialog
        parent: ApplicationWindow.overlay

        title: "Save Melody"
        standardButtons: Dialog.Save | Dialog.Cancel

        function show() {
            var cur = melodyLib.currentName();
            melodyNameInput.text = cur.length ? cur : melodyLib.nextName();
            open();
            melodyNameInput.selectAll();
            melodyNameInput.forceActiveFocus();
        }

        onAccepted: melodyLib.save(melodyNameInput.text, hornSettingsSender.notes())

        Column {
            width: saveMelodyDialog.availableWidth
            spacing: 10

            TextField {
                id: melodyNameInput
                width: parent.width
                maximumLength: 20
                placeholderText: "Melody name"
            }

            NText {
                width: parent.width
                font.pointSize: 11
                wrapMode: Text.WordWrap
                text: "Saved in this app; pick it in CONTROL ▸ BOOT MELODY. An existing name is replaced."
            }
        }
    }

    BaseDialog {
        id: editTuneDialog

        title: tune ? "Edit Tune" : "Save Tune"
        standardButtons: !!tune ? Dialog.Save | Dialog.Discard | Dialog.Close : Dialog.Save | Dialog.Close

        property var tuneSlot
        property var tune: null

        function show(slot) {
            tuneSlot = slot;
            tune = tuneManager.loadTune(slot);
            editTuneDiff.setModel(packageConfig.diffConfig(tune, true).differs);
            editTuneDiff.reset();

            standardButton(Dialog.Save).enabled = !!tune;
            if (!!tune) {
                standardButton(Dialog.Discard).text = "Erase"
            }

            open();
        }

        function tuneAttr(key) {
            return tune ? tune[key] : "";
        }

        onAccepted: {
            if (saveTuneNameInput.text) {
                if (!tune) {
                    tune = tuneManager.createTune(saveTuneNameInput.text, saveTuneDescInput.text, packageConfig.fetchConfig(true));
                } else {
                    var success = tuneManager.updateTune(tune, saveTuneNameInput.text, saveTuneDescInput.text, saveTuneOverwrite.checked ? packageConfig.fetchConfig(true) : null);
                    if (!success) {
                        return;
                    }
                }
                tuneManager.saveTune(tuneSlot, tune);
                VescIf.emitStatusMessage(saveTuneNameInput.text + " saved", true);
            }
        }

        onDiscarded: {
            tuneManager.eraseTune(tuneSlot);
            VescIf.emitStatusMessage(tune.name + " erased", true);
            close();
        }

        ColumnLayout {
            width: editTuneDialog.availableWidth

            NText {
                Layout.fillWidth: true

                visible: editTuneDialog.tune
                text: "Last saved: %1".arg(Qt.formatDateTime(new Date(editTuneDialog.tuneAttr("date"))));
            }

            RowLayout {
                Layout.fillWidth: true

                LText {
                    text: "Name:"
                }

                TextField {
                    id: saveTuneNameInput
                    Layout.fillWidth: true

                    maximumLength: 30
                    text: editTuneDialog.tuneAttr("name")

                    onTextEdited: {
                        editTuneDialog.standardButton(Dialog.Save).enabled = !!text;
                    }
                }
            }

            LText {
                Layout.fillWidth: true
                text: "Description:"
            }

            TextArea {
                id: saveTuneDescInput
                Layout.fillWidth: true
                implicitHeight: 80

                wrapMode: TextEdit.WordWrap
                text: editTuneDialog.tuneAttr("description") || ""
            }

            ConfigDiff {
                id: editTuneDiff
                Layout.fillWidth: true
                dialog: editTuneDialog
                isTune: true
            }

            CheckBox {
                id: saveTuneOverwrite

                checked: true
                visible: editTuneDialog.tune && !editTuneDiff.isEmpty
                text: "Overwrite with current tune"
            }

            // Refloat Glow: neon color for this preset button (saved right away)
            LText {
                Layout.fillWidth: true
                text: "Button color: " + swTheme.neonNames[tuneColorRow.selected]
            }

            Flow {
                id: tuneColorRow
                Layout.fillWidth: true
                spacing: 0.15 * unit

                property int selected: editTuneDialog.tuneSlot ? swTheme.tuneColorIndex(editTuneDialog.tuneSlot) : 0

                Repeater {
                    model: swTheme.neonColors.length

                    Rectangle {
                        width: 0.8 * unit
                        height: width
                        radius: width / 2
                        color: "#0b0718"
                        border.width: index === tuneColorRow.selected ? 4 : 2
                        border.color: swTheme.neonColors[index]

                        Rectangle {
                            anchors.centerIn: parent
                            width: parent.width * 0.45
                            height: width
                            radius: width / 2
                            color: swTheme.neonColors[index]
                            opacity: index === tuneColorRow.selected ? 1 : 0.6
                        }

                        RectangularGlow {
                            anchors.fill: parent
                            z: -1
                            visible: index === tuneColorRow.selected
                            glowRadius: 0.15 * unit
                            spread: 0.3
                            cornerRadius: parent.radius + glowRadius
                            color: swTheme.neonColors[index]
                        }

                        MouseArea {
                            anchors.fill: parent
                            onClicked: swTheme.setTuneColor(editTuneDialog.tuneSlot, index)
                        }
                    }
                }
            }
        }
    }

    BaseDialog {
        id: tuneArchiveDialog
        implicitHeight: fullHeight
        clip: true

        title: "Tune Archive"
        // rf91: Neon Future look - neon cards, neon pill buttons
        standardButtons: Dialog.NoButton
        footer: Item {
            implicitHeight: 1.3 * unit
            Row {
                anchors.centerIn: parent
                spacing: 0.3 * unit
                NeonButton { text: "Refresh"; onClicked: tuneArchiveDialog.download() }
                NeonButton { text: "Close"; lit: true; onClicked: tuneArchiveDialog.close() }
            }
        }

        function download() {
            tuneArchiveDownloadStatus.text = "Downloading tunes...";
            var http = new XMLHttpRequest();
            var url = "http://us-central1-mimetic-union-377520.cloudfunctions.net/float_package_tunes_via_http";
            http.open("GET", url, true);
            http.onreadystatechange = function() {
                if (http.readyState === XMLHttpRequest.DONE) {
                    if (http.status === 200) {
                        tuneArchiveDownloadStatus.text = "Download succesful.";

                        var tunes = tuneManager.parseCsv(http.responseText);
                        tuneManager.saveTuneArchive(tunes);
                        downloadedTunesModel.setTunes(tunes);
                    } else if (http.status === 0) {
                        tuneArchiveDownloadStatus.text = "Download failed: Connection error";
                    } else {
                        tuneArchiveDownloadStatus.text = "Download failed: %1 - %2".arg(http.status).arg(http.statusText);
                    }
                }

            };

            http.send();
        }

        function show() {
            open();

            var tuneArchive = tuneManager.loadTuneArchive();
            // backwards compatibility: Check for the first item settings not being an array (if it is, redownload)
            if (tuneArchive && tuneArchive.length > 0 && !Array.isArray(tuneArchive[0].settings)) {
                downloadedTunesModel.setTunes(tuneArchive);
                tuneArchiveDownloadStatus.text = "Tunes downloaded on %1".arg(tuneManager.getTuneArchiveDate());
            } else {
                download();
            }
        }

        ColumnLayout {
            anchors.centerIn: parent
            width: parent.width * 0.95
            height: parent.height
            spacing: 15
            clip: true

            Text {
                id: tuneArchiveDownloadStatus
                Layout.fillWidth: true
                Layout.alignment: Qt.AlignHCenter

                color: swTheme.neonPurple
                font.family: "Exan"
                font.pixelSize: 0.2 * unit
                font.letterSpacing: 0.02 * unit
                horizontalAlignment: Text.AlignHCenter
                wrapMode: Text.WordWrap
            }

            ListView {
                id: tuneArchiveTunesList
                Layout.fillWidth: true
                Layout.fillHeight: true
                Layout.alignment: Qt.AlignHCenter
                spacing: 10
                clip: true

                model: ListModel {
                    id: downloadedTunesModel

                    function setTunes(tunes) {
                        clear();
                        for (var i in tunes) {
                            append({"tune": tunes[i]});
                        }
                    }
                }

                // rf91: neon card per tune - title in neon, rider below, date tag;
                // "RIDER - TITLE (DATE)" names are split for that
                delegate: Rectangle {
                    id: tuneCard
                    width: tuneArchiveTunesList.width
                    height: tuneCardCol.implicitHeight + 0.36 * unit
                    radius: 0.2 * unit
                    readonly property color neon: swTheme.neonColors[index % swTheme.neonColors.length]
                    readonly property var parts: {
                        var n = String(tune.name), date = "", m = n.match(/\s*\(([^)]*)\)\s*$/);
                        if (m) { date = m[1]; n = n.substring(0, m.index); }
                        var i = n.indexOf(" - ");
                        return i > 0 ? [n.substring(i + 3), n.substring(0, i), date] : [n, "", date];
                    }
                    color: tuneCardArea.pressed ? Qt.rgba(neon.r, neon.g, neon.b, 0.25) : "#140a26"
                    border.color: neon
                    border.width: 2

                    Column {
                        id: tuneCardCol
                        anchors.left: parent.left
                        anchors.right: tuneCardDate.left
                        anchors.leftMargin: 0.3 * unit
                        anchors.rightMargin: 0.15 * unit
                        anchors.verticalCenter: parent.verticalCenter
                        spacing: 0.04 * unit
                        Text {
                            width: parent.width
                            wrapMode: Text.WordWrap
                            text: tuneCard.parts[0].toUpperCase()
                            color: tuneCard.neon
                            font.family: "Exan"
                            font.pixelSize: 0.28 * unit
                            font.letterSpacing: 0.02 * unit
                        }
                        Text {
                            visible: text !== ""
                            width: parent.width
                            elide: Text.ElideRight
                            text: tuneCard.parts[1]
                            color: "#ead6ff"
                            font.pixelSize: 0.22 * unit
                        }
                    }
                    Rectangle {
                        id: tuneCardDate
                        visible: tuneCard.parts[2] !== ""
                        anchors.right: parent.right
                        anchors.rightMargin: 0.25 * unit
                        anchors.verticalCenter: parent.verticalCenter
                        width: visible ? tuneCardDateText.implicitWidth + 0.3 * unit : 0
                        height: 0.42 * unit
                        radius: height / 2
                        color: "transparent"
                        border.color: swTheme.neonPurple
                        border.width: 1
                        Text {
                            id: tuneCardDateText
                            anchors.centerIn: parent
                            text: tuneCard.parts[2].toUpperCase()
                            color: swTheme.neonPurple
                            font.family: "Exan"
                            font.pixelSize: 0.17 * unit
                        }
                    }
                    MouseArea {
                        id: tuneCardArea
                        anchors.fill: parent
                        onClicked: applyConfigDialog.show(tune, false, true)
                    }
                }
            }
        }
    }

    BaseDialog {
        id: alertsDialog

        title: "Alerts"
        standardButtons: Dialog.Close

        function show() {
            alertsDialogListModel.set(alerts.alertsLog);
            activeAlertsItem.visible = alerts.activeAlertCount > 0;
            open();
        }

        Connections {
            target: alerts

            function onAlertAdded(alert) {
                if (alertsDialog.visible) {
                    alertsDialogListModel.add(alert);
                }
            }

            function onActiveAlertCountChanged() {
                if (alerts.activeAlertCount > 0) {
                    activeAlertsItem.visible = true;
                }
            }
        }

        ScrollView {
            anchors.fill: parent
            contentWidth: alertsDialog.availableWidth
            clip: true

            ColumnLayout {
                anchors.fill: parent

                component ErrHeader : NText {
                    Layout.fillWidth: true
                    font.pixelSize: 16
                    horizontalAlignment: Text.AlignHCenter
                }

                component ErrText : NText {
                    Layout.fillWidth: true
                    font.pixelSize: 12
                    font.family: "Mono"
                    color: Utility.getAppHexColor("red")
                }

                component ErrDesc : NText {
                    Layout.fillWidth: true
                    font.pixelSize: 12
                    horizontalAlignment: Text.AlignHCenter
                    wrapMode: Text.WordWrap
                }

                ErrHeader {
                    text: "Package Disabled"
                    visible: state.pkgState === state.s_Disabled
                }

                ErrDesc {
                    text: "{{PACKAGE_NAME}} package is disabled. After you're done with board setup, re-enable it."
                    visible: state.pkgState === state.s_Disabled
                }

                Button {
                    Layout.alignment: Qt.AlignHCenter

                    text: "Enable {{PACKAGE_NAME}}"
                    visible: state.pkgState === state.s_Disabled

                    onClicked: {
                        packageConfig.setDisabled(false);
                    }
                }

                ErrHeader {
                    text: "Connection Errors"
                    visible: state.configLoadingError || state.pkgState === state.s_Disconnected
                }

                ErrText {
                    text: "Refloat Cfg failed to load"
                    visible: state.configLoadingError
                }

                ErrDesc {
                    text: "Reconnecting to the board usually fixes this. If problem persists, try reinstalling the package."
                    visible: state.configLoadingError
                }

                ErrText {
                    text: "Package disconnected"
                    visible: state.pkgState === state.s_Disconnected
                }

                ErrDesc {
                    text: "Package is not responding. May occur temporarily with spotty connection. If board doesn't engage, the package is dead. Restart the board, if problem persists, try reinstalling the package.";
                    visible: state.pkgState === state.s_Disconnected
                }

                Item {
                    id: activeAlertsItem
                    Layout.fillWidth: true

                    Column {
                        id: activeAlertsColumn
                        width: parent.width
                        property bool resetHeight: true

                        ErrHeader {
                            width: parent.width
                            text: "Active Alerts"
                        }

                        Item {
                            width: parent.width
                            height: 5
                        }

                        Repeater {
                            model: alerts.activeAlerts

                            ErrText {
                                property var alert: alerts.getActiveAlertData(modelData)
                                text: alert.name
                                color: alerts.severityColors.get(alert.severity)
                            }
                        }

                        onHeightChanged: {
                            if (resetHeight || !activeAlertsItem.visible || activeAlertsItem.implicitHeight < height) {
                                activeAlertsItem.implicitHeight = height;
                                resetHeight = false;
                            }
                        }
                    }

                    onVisibleChanged: {
                        activeAlertsColumn.resetHeight = true;
                    }
                }

                ErrHeader {
                    text: "Fatal Error"
                    visible: state.fatalError
                }

                // Fatal Error is so far only used for FW Fault
                ErrDesc {
                    text: "VESC reported a fault. Be very careful. You should not continue riding before you fix the root cause. " + (alerts.isFatalActive ? "The Fault is still active, you need to resolve the fault and then clear the error." : "The package will stay in an error state until you clear the error.")
                    visible: state.fatalError
                }

                Button {
                    Layout.alignment: Qt.AlignHCenter

                    text: "Clear Fatal Error"
                    visible: state.fatalError
                    enabled: !alerts.isFatalActive

                    onClicked: {
                        alerts.clearFatalError();
                    }
                }

                ErrHeader {
                    text: "Alert Log"
                }

                Rectangle {
                    color: Utility.getAppHexColor("darkBackground")
                    Layout.fillWidth: true
                    Layout.minimumHeight: 200

                    ListView {
                        id: alertsDialogList
                        anchors.fill: parent
                        anchors.margins: 6
                        clip: true

                        model: ListModel {
                            id: alertsDialogListModel

                            function add(alert) {
                                var wasAtEnd = alertsDialogList.atYEnd;

                                var model = Object.assign({}, alert);
                                Object.assign(model, alerts.getAlertLogData(alert.id));
                                if (!alert.active) {
                                    model.name = model.name + " ended";
                                } else {
                                    if (alert.id === alerts.alert_fwFault) {
                                        model.name = model.name + ": %1 (%2)".arg(model.text).arg(model.code);
                                    }
                                }
                                append(model);

                                if (wasAtEnd) {
                                    alertsDialogList.positionViewAtEnd();
                                }
                            }

                            function set(alertList) {
                                clear();
                                for (var alert of alertList.values()) {
                                    add(alert);
                                }
                            }
                        }

                        delegate: NText {
                            id: alertRecordText
                            width: alertsDialogList.width

                            font.pixelSize: 12
                            font.family: "Mono"
                            wrapMode: Text.WordWrap
                            text: "%1: [<font color=\"%2\">%3</font>] <font color=\"%4\">%5</font>".arg(Qt.formatTime(new Date(time), "hh:mm:ss.zzz")).arg(alerts.severityColors.get(severity)).arg(severity).arg(active ? Utility.getAppHexColor("lightText") : Utility.getAppHexColor("disabledText")).arg(name)
                        }
                    }
                }

                ErrText {
                    text: "Stop Condition: <font color=\"%1\">%2</font>".arg(Utility.getAppHexColor("lightText")).arg(state.stopConditionString)
                    visible: state.stopConditionString
                    color: Utility.getAppHexColor("normalText")
                }

                ErrText {
                    text: "Last Beep Reason: <font color=\"%1\">%2</font>".arg(Utility.getAppHexColor("lightText")).arg(state.beepReasonString)
                    visible: state.beepReasonString
                    color: Utility.getAppHexColor("normalText")
                }
            }
        }
    }

    component ConfigDiff : ColumnLayout {
        id: configDiff

        property BaseDialog dialog
        property bool isTune: false

        property bool isEmpty: diffModel.count === 0

        property real rowHeight: 30
        property real valueColumnWidth: 60

        property real animation: 0
        property real contentHeight: Math.min(maxHeight, diffView.contentHeight + diffHeader.height + 5)
        property real autoHeight: animation * contentHeight
        property real maxHeight

        Behavior on animation {
            id: animBehavior
            NumberAnimation {
                easing.type: Easing.InOutExpo
                duration: 400
            }
        }

        function reset() {
            animBehavior.enabled = false;
            diffCheckbox.checked = false;
            animation = 0;
            animBehavior.enabled = true;
        }

        function showHideDiff(show) {
            if (show) {
                maxHeight = dialog.fullHeight - dialog.height;
            }
            animation = show ? 1 : 0;
        }

        function displayValue(item, value) {
            var type = packageConfig.getParamType(item.name);
            if (type === "Double" || type === "Int") {
                return value.toString();
            } else if (type === "Bool") {
                return value ? "On" : "Off";
            } else if (type === "Enum") {
                return packageConfig.getEnumNames(item.name)[value];
            } else if (type === "String") {
                return value;
            } else if (type === "Bitfield") {
                return "[option set]";
            }

            return "[unknown]";
        }

        function setModel(m) {
            var model = diffModel;
            model.clear();
            var empty = true;
            for (var item of m) {
                item.value = displayValue(item, item.value);
                item.otherValue = displayValue(item, item.otherValue);
                model.append(item);
                empty = false;
            }
            if (empty) {
                diffCheckbox.checked = false;
            }
        }

        CheckBox {
            id: diffCheckbox
            implicitHeight: indicator.height
            Layout.leftMargin: -4
            visible: !isEmpty

            checked: false

            onCheckedChanged: {
                configDiff.showHideDiff(checked);
            }

            contentItem: Item {
                implicitWidth: checkLabel.implicitWidth + 22
                implicitHeight: checkLabel.implicitHeight

                Label {
                    id: checkLabel
                    anchors.left: parent.left
                    anchors.verticalCenter: parent.verticalCenter
                    anchors.leftMargin: 22
                    text: "Differences (%1)".arg(diffModel.count)
                    color: Utility.getAppHexColor("lightText")
                    verticalAlignment: Text.AlignVCenter
                }
            }

            MouseArea {
                anchors.fill: parent
                onClicked: parent.checked = !parent.checked
            }

            indicator: Item {
                width: 30
                height: 30
                Item {
                    anchors.centerIn: parent
                    height: 18
                    width: height / 2
                    clip: true
                    rotation: 90 * animation

                    Rectangle {
                        height: parent.height
                        width: height
                        x: -parent.width
                        rotation: 45
                        scale: 0.707
                        color: Utility.getAppHexColor("lightText")
                    }
                }
            }
        }

        Item {
            implicitHeight: configDiff.autoHeight
            Layout.fillWidth: true
            clip: true

            Row {
                id: diffHeader
                anchors.horizontalCenter: parent.horizontalCenter

                NText {
                    width: diffView.width - 2 * valueColumnWidth - 10
                    horizontalAlignment: Text.AlignLeft
                    verticalAlignment: Text.AlignVCenter
                    text: "Option"
                }

                NText {
                    width: valueColumnWidth
                    horizontalAlignment: Text.AlignRight
                    verticalAlignment: Text.AlignVCenter
                    text: isTune ? "Tune" : "Current";
                }

                NText {
                    width: valueColumnWidth
                    horizontalAlignment: Text.AlignRight
                    verticalAlignment: Text.AlignVCenter
                    text: isTune ? "Current" : "Backup";
                }
            }

            TableView {
                id: diffView
                anchors.top: diffHeader.bottom
                anchors.topMargin: 5
                height: parent.height - diffHeader.height - 5
                width: parent.width
                clip: true

                model: ListModel {
                    id: diffModel
                }

                delegate: Rectangle {
                    color: index % 2 === 0 ? Utility.getAppHexColor("lightBackground") : Utility.getAppHexColor("normalBackground")
                    implicitWidth: diffView.width
                    implicitHeight: rowHeight

                    Row {
                        id: diffRow
                        anchors.centerIn: parent

                        NText {
                            width: diffView.width - 2 * valueColumnWidth - 10
                            height: rowHeight
                            horizontalAlignment: Text.AlignLeft
                            verticalAlignment: Text.AlignVCenter
                            wrapMode: Text.WordWrap
                            fontSizeMode: Text.Fit
                            minimumPointSize: 4
                            text: packageConfig.getDisplayName(name)
                            color: Utility.getAppHexColor("lightText")
                        }

                        NText {
                            width: valueColumnWidth
                            height: rowHeight
                            horizontalAlignment: Text.AlignRight
                            verticalAlignment: Text.AlignVCenter
                            wrapMode: Text.WordWrap
                            fontSizeMode: Text.Fit
                            minimumPointSize: 4
                            text: isTune ? otherValue : value
                        }

                        NText {
                            width: valueColumnWidth
                            height: rowHeight
                            horizontalAlignment: Text.AlignRight
                            verticalAlignment: Text.AlignVCenter
                            wrapMode: Text.WordWrap
                            fontSizeMode: Text.Fit
                            minimumPointSize: 4
                            text: isTune ? value : otherValue
                            color: Utility.getAppHexColor("lightAccent")
                        }
                    }
                }
            }
        }

        NText {
            Layout.fillWidth: true
            horizontalAlignment: Text.AlignHCenter
            visible: isEmpty
            text: "There are no differences to your current config."
        }

        Item {
            Layout.fillWidth: true
        }
    }

    BaseDialog {
        id: applyConfigDialog
        parent: ApplicationWindow.overlay

        title: isTune ? "Apply Tune" : "Restore Config"

        property var config
        property bool automatic: false
        property bool isTune: false

        property var name: config ? config.name : "(Unknown)"
        property var date: config && config.date ? Qt.formatDateTime(new Date(config.date)) : ""
        property var pkg: config && config.package ? "%1 %2".arg(config.package.name).arg(config.package.version) : ""
        property var description: config && config.description ? config.description : ""
        property var diff: config ? packageConfig.diffConfig(config, isTune).differs : []

        onDiffChanged: {
            applyConfigDiff.setModel(diff);
        }

        function show(cfg, auto, tune) {
            config = cfg;
            automatic = !!auto;
            isTune = !!tune;
            applyConfigDiff.reset();
            applyConfigDiff.isTune = isTune;
            if (!applyConfigDiff.isEmpty && !isTune) {
                standardButton(Dialog.Apply).text = "Restore";
            }
            open();
        }

        // workaround: the buttons sometimes wouldn't appear if declared via `standardButtons` only
        footer: DialogButtonBox {
            standardButtons: applyConfigDiff.isEmpty ? Dialog.Close : Dialog.Apply | Dialog.Close
        }

        function set(cfg) {
            config = cfg;
        }

        onApplied: {
            packageConfig.applyConfig(config, isTune);
            close();
            tuneArchiveDialog.close();
        }

        ColumnLayout {
            width: applyConfigDialog.availableWidth

            LText {
                Layout.fillWidth: true
                Layout.bottomMargin: 16
                horizontalAlignment: Text.AlignHCenter
                verticalAlignment: Text.AlignVCenter
                wrapMode: Text.WordWrap
                visible: applyConfigDialog.automatic
                text: "Your package config has been reset after installing a new version. Do you want to restore a backup?"
            }

            LText {
                id: applyConfigName
                Layout.fillWidth: true
                font.pointSize: 14
                horizontalAlignment: Text.AlignHCenter
                text: applyConfigDialog.name;
            }

            NText {
                Layout.fillWidth: true
                font.pointSize: 11
                horizontalAlignment: Text.AlignHCenter
                visible: !!applyConfigDialog.date
                text: applyConfigDialog.date
            }

            NText {
                Layout.fillWidth: true
                font.pointSize: 11
                horizontalAlignment: Text.AlignHCenter
                visible: !!applyConfigDialog.pkg
                text: "Stored by: " + applyConfigDialog.pkg
            }

            LText {
                Layout.fillWidth: true
                visible: !!applyConfigDialog.description
                text: "Description:"
            }

            LText {
                Layout.fillWidth: true
                font.pointSize: 11
                horizontalAlignment: Text.AlignHCenter
                wrapMode: Text.WordWrap
                visible: !!applyConfigDialog.description
                text: applyConfigDialog.description
            }

            ConfigDiff {
                id: applyConfigDiff
                Layout.fillWidth: true
                dialog: applyConfigDialog
            }

            LText {
                Layout.fillWidth: true
                Layout.topMargin: 16
                horizontalAlignment: Text.AlignHCenter
                verticalAlignment: Text.AlignVCenter
                wrapMode: Text.WordWrap
                visible: !applyConfigDiff.isEmpty && !applyConfigDialog.isTune
                text: "Restoring this backup will overwrite your current config."
            }
        }
    }

    Rectangle {
        id: welcomeDialog
        anchors.fill: parent
        z: 100
        visible: false

        color: "#AA000000"

        function show() {
            visible = true;
        }

        Page {
            title: "Welcome to {{PACKAGE_NAME}}"
            anchors.centerIn: parent
            width: parent.width - 20
            padding: 10

            Material.background: Utility.getAppHexColor("normalBackground")

            header: Label {
                text: parent.title
                visible: parent.title
                font.bold: true
                padding: 12
            }

            footer: DialogButtonBox {
                standardButtons: Dialog.Yes | Dialog.No

                onAccepted: {
                    welcomeDialog.visible = false;
                    settingsDialog.show(1);
                }

                onRejected: {
                    welcomeDialog.visible = false;
                }
            }

            ColumnLayout {
                id: welcomeDialogContent
                anchors.fill: parent

                LText {
                    id: welcomeMessage
                    Layout.fillWidth: true
                    wrapMode: Text.WordWrap
                    text: "If you haven't configured your board yet, make sure to configure your motor and IMU before you try to ride the board.\n\nTo run the motor wizard, you need to disable the {{PACKAGE_NAME}} package first. You can do so in {{PACKAGE_NAME}} Settings > Setup, which you can access using the cog button in the top right corner of the main {{PACKAGE_NAME}} screen.\n\nAfter the setup, you can safely verify your board balances correctly using the Handtest mode.\n\nTo configure {{PACKAGE_NAME}}, you need to set the High and Low Voltage Thresholds in Refloat Cfg > Specs according to your battery voltage. The rest of the configuration options has defaults that should provide you with a well-behaving, rideable board.\n\nHappy shredding!\n\nGo to Settings > Setup now?"
                }

                CheckBox {
                    id: welcomeShowAgain

                    checked: !preferences.showWelcomeDialog
                    text: "Don't show again"

                    onCheckedChanged: {
                        preferences.showWelcomeDialog = !checked
                    }
                }
            }
        }
    }

    Rectangle {
        id: uiHintsRect
        anchors.fill: parent
        z: 90
        visible: uiHintsSwipe.count > 0

        color: "#CC000000"

        SwipeView {
            id: uiHintsSwipe
            anchors.fill: parent
            clip: true

            property bool seenAll

            onCurrentIndexChanged: {
                if (currentIndex > 0) {
                    itemAt(currentIndex - 1).shown = true;
                }

                if (currentIndex == count - 1) {
                    seenAll = true;
                }
            }

            function clear() {
                for (let i = count - 1; i >= 0; i--) {
                    takeItem(i);
                }
            }

            function markAllShown() {
                for (let i = 0; i < count; i++) {
                    itemAt(i).shown = true;
                }
            }
        }

        NText {
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.top: parent.top
            anchors.margins: 20
            font.pixelSize: 24
            text: "Tips & Tricks"
        }

        PageIndicator {
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.bottom: uiHintsClose.top
            anchors.bottomMargin: 10

            currentIndex: uiHintsSwipe.currentIndex
            count: uiHintsSwipe.count
        }

        Button {
            anchors.bottom: parent.bottom
            anchors.bottomMargin: 20
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.horizontalCenterOffset: -parent.width * 0.25
            visible: !uiHintsSwipe.seenAll
            text: "Skip now"
            onClicked: {
                uiHintsSwipe.clear();
            }
        }

        Button {
            id: uiHintsClose
            anchors.bottom: parent.bottom
            anchors.bottomMargin: 20
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.horizontalCenterOffset: uiHintsSwipe.seenAll ? 0 : parent.width * 0.25
            text: uiHintsSwipe.seenAll ? "Close" : "Don't show again"
            onClicked: {
                uiHintsSwipe.markAllShown();
                uiHintsSwipe.clear();
            }
        }

        function fill(doDataRecord=false) {
            uiHints.fill(uiHintsSwipe);
            if (doDataRecord) {
                uiHints.fillDataRecord(uiHintsSwipe);
            }

            uiHintsSwipe.seenAll = uiHintsSwipe.currentIndex == uiHintsSwipe.count - 1;
        }

        function fillDataRecord() {
            uiHints.fillDataRecord(uiHintsSwipe);
            uiHintsSwipe.seenAll = uiHintsSwipe.currentIndex == uiHintsSwipe.count - 1;
        }

        // rf90: upstream's hint pages no longer open on start (the
        // Refloat Glow tour replaces them)
    }

    // rf87: Neon Future tour of the Refloat Glow features (SETTINGS >
    // Show tips & tricks). Swipe or NEXT / BACK; tap outside does nothing.
    Rectangle {
        id: rinkTour
        anchors.fill: parent
        z: 95
        visible: false
        // rf166: dims everything except the spotlight (four panels below)
        color: hasSpot ? "transparent" : "#E6050210"

        // rf166: the Onboarding Tour walks through the real interface: it opens
        // the SUW on the right tab, scrolls the control into view and puts a
        // neon spotlight on it. Strictly visual: the whole screen stays covered
        // by the blocking MouseArea, nothing is pressed, no setting or board
        // command is sent. The SUW and its tab are put back on close.
        property real savedFrac: 0
        property int savedTab: 0
        property var spot: null  // {x, y, w, h} in rinkTour coordinates
        readonly property bool hasSpot: visible && spot !== null
        property bool realTarget: false  // the page's own control (not the LEDS tab fallback)
        // rf174: LIGHTS page, by board: Floatwheel kits with the SLCM light
        // module vs controller-driven LEDs (Thor and every other controller)
        // rf175: LIGHTS page: both kinds of boards, yours first (bold), the other below
        readonly property string lightsSlcm: "<b>Floatwheel kit (SLCM)</b>: HEAD/TAIL LIGHTS on/off and brightness, STATUS BAR animations, BATTERY GAUGE and the light module's BEEPER, sent straight to your light module."
        readonly property string lightsCtl: "<b>Controller LEDs</b> (most non-Floatwheel setups, e.g. Thor): HEAD/TAIL LIGHTS effects, colors and brightness, a STATUS BAR and SNOOZE, linked with Refloat's LED settings."
        readonly property string lightsText: slcmDetect.present
            ? "Your board: " + lightsSlcm + "<br><br><font color=\"#9a86b8\">" + lightsCtl + "</font>"
            : (ledSender.rgbAvail || ledSender.rfStatusAvail)
                ? "Your board: " + lightsCtl + "<br><br><font color=\"#9a86b8\">" + lightsSlcm + "</font>"
                : "No lights found yet. " + lightsCtl + " Turn them on in VESC Tool \u203A Refloat Cfg \u203A Hardware (LED Mode).<br><br>" + lightsSlcm + " An LCM with SLCM firmware shows up here by itself."

        // per page (by title): [SUW tab (-1 = SUW down), [targets, first visible wins]]
        function steps(i) {
            switch (pages[i] ? pages[i][1] : "") {
            case "HOME SCREEN": return [-1, [speedo]];
            case "PULL-UP SHEET": return [0, [bottomStackTabs]];
            case "HORN": return [-1, [hornFrame]];
            // rf167: the gear; Settings itself is a window above the tour, so the
            // card shows a picture of its RIDE tab instead of opening it
            case "RIDE SETTINGS": return [-1, [settingsButton]];
            case "THE MIXER": return [2, [mixerGrid]];
            case "RECORD A MELODY": return [2, [mixerModeRow]];
            case "PLAY & SAVE": return [2, [mixerActRow, mixerModeRow]];
            case "MY MELODIES": return [1, [ctlMelodyRow]];
            case "BOARD STYLE": return [4, [styleTabPage]];
            case "LIGHTS": return [5, [ledMainTiles]];
            case "BATTERY GAUGE": return [5, [slcmBattTile]];
            case "BEEPER": return [-1, [settingsButton]];  // rf173: moved to Settings
            case "GHOSTING PROTECTION": return [-1, [settingsButton]];  // rf182
            case "UPDATES": return [5, [slcmUpdTile]];
            default: return [-1, []];
            }
        }
        function shown(it) {
            for (var p = it; p; p = p.parent) {
                if (!p.visible) return false;
                if (p === mainItem) return it.width > 0 && it.height > 0;
            }
            return false;
        }
        property var target: null
        function apply(i) {
            var st = steps(i);
            if (st[0] < 0) {
                bottomSheet.fraction = 0;
            } else {
                bottomStackTabs.currentIndex = st[0];
                bottomSheet.fraction = 1;
            }
            // rf168: pick the new control right away and keep the spotlight on
            // screen while the SUW slides: it glides to the new control instead
            // of switching off for a moment (that was the flicker: no spot =
            // card jumps to the centre and the whole screen dims, then back)
            target = pick();
            if (!target) spot = null;
            settleTimer.restart();
        }
        function pick() {
            var st = steps(tourSwipe.currentIndex);
            for (var k = 0; k < st[1].length; k++) {
                if (st[1][k] && shown(st[1][k])) { realTarget = true; return st[1][k]; }
            }
            realTarget = false;
            // not on this board (e.g. SLCM-only tiles): point at the LEDS tab itself
            return st[0] === 5 ? bottomStackTabs.itemAt(5) : null;
        }
        function scrollIntoView(it) {
            for (var p = it.parent; p && p !== mainItem; p = p.parent) {
                if (p.contentY !== undefined && p.contentHeight !== undefined && p.contentItem !== undefined) {
                    var y = it.mapToItem(p.contentItem, 0, 0).y;
                    var maxY = Math.max(0, p.contentHeight - p.height);
                    var want = y + it.height <= p.contentY + p.height && y >= p.contentY ? p.contentY
                        : Math.max(0, Math.min(maxY, y - 0.2 * unit));
                    p.contentY = want;
                    return;
                }
            }
        }
        Timer {
            id: settleTimer  // after the SUW has slid open
            interval: 300
            onTriggered: {
                var t = rinkTour.pick();  // again, now the SUW has settled
                if (t !== rinkTour.target) rinkTour.target = t;
                if (t) rinkTour.scrollIntoView(t);
                else rinkTour.spot = null;
            }
        }
        Timer {
            interval: 33
            repeat: true
            running: rinkTour.visible
            onTriggered: {
                var t = rinkTour.target;
                if (!t) { rinkTour.spot = null; return; }
                if (!rinkTour.shown(t)) return;  // rf168: keep the last spot, don't blink
                var p = t.mapToItem(rinkTour, 0, 0);
                var m = 0.12 * unit;
                // keep the spot inside the SUW's visible part when the control sits in it
                var x0 = p.x - m, y0 = p.y - m, x1 = p.x + t.width + m, y1 = p.y + t.height + m;
                if (bottomSheet.fraction > 0.5 && t !== bottomStackTabs) {
                    var sTop = bottomSheet.mapToItem(rinkTour, 0, 0).y;
                    if (y0 < sTop && y1 > sTop) y0 = sTop + 2;
                    y1 = Math.min(y1, rinkTour.height - 2);
                }
                x0 = Math.max(2, x0); x1 = Math.min(rinkTour.width - 2, x1);
                if (y1 - y0 < 4) return;  // still sliding in: keep the last spot (rf168)
                var s = rinkTour.spot;
                if (!s || Math.abs(s.x - x0) > 0.5 || Math.abs(s.y - y0) > 0.5 || Math.abs(s.w - (x1 - x0)) > 0.5 || Math.abs(s.h - (y1 - y0)) > 0.5)
                    rinkTour.spot = {x: x0, y: y0, w: x1 - x0, h: y1 - y0};
            }
        }

        function open() {
            savedFrac = bottomSheet.fraction;
            savedTab = bottomStackTabs.currentIndex;
            tourSwipe.currentIndex = 0;
            visible = true;
            apply(0);
        }
        function close() {
            visible = false;
            swSettings.tourSeenVer = "{{VERSION}}";  // rf170
            spot = null;
            target = null;
            bottomStackTabs.currentIndex = savedTab;
            bottomSheet.fraction = savedFrac;
            swSettings.tourSeen = true;
        }

        // [glyph, title, where, text, demo]  rf165: optional demo ("updates" = a
        // non-interactive picture of the real UPDATES section, "credit" = a
        // quiet attribution line); nothing in the tour touches the board
        readonly property var pages: [
            ["✦", "REFLOAT GLOW", "WELCOME", "Built on Refloat 1.2.3 by Lukáš Hrázký (lukash) and the Refloat community, reimagined with a Neon Future style theme and a bunch of extra features. Swipe through what's new; it takes a minute."],
            ["◔", "HOME SCREEN", "MAIN VIEW", "Speed, duty and current on the neon speedo. The side and front views tilt with your board, the battery bar shows your real charge. TILT slider and MAX SPEED / DUTY right there (plus MAX AIR, if you turn it on in Settings › PREFERENCES)."],
            ["≡", "PULL-UP SHEET", "SWIPE UP", "Drag the sheet up for TUNES, CONTROL, MIXER, DATA, BOARD STYLE and LEDS. Tap anywhere on the main view (except HORN) to put it away."],
            ["♫", "HORN", "HOME + CONTROL", "Hold HORN to beep through the motor, no extra hardware. Sound and volume (10/10 = 4 V) in CONTROL › HORN SETTINGS. It stays well within safe, low motor current."],
            ["⚙", "RIDE SETTINGS", "SETTINGS › RIDE", "Tap the gear, then RIDE. HAPTIC FEEDBACK: the warning tone at your duty or speed. PUSHBACK: when and how much the nose lifts (duty, speed, battery voltage). Both are Refloat's own settings and only save while the board is stopped.", "ride"],
            ["♪", "THE MIXER", "MIXER TAB", "Your board is an instrument. Ten neon tiles, ten notes, played right through the motor. Tap and hold a tile in LIVE to jam."],
            ["●", "RECORD A MELODY", "MIXER › REC", "Hit REC, then play your tune on the tiles: recording starts with your first note. \u266A BEEP adds a controller beep. The timeline fills as you go; CLEAR to start over."],
            ["▶", "PLAY & SAVE", "MIXER › PLAY / SAVE", "PLAY to hear it back, SAVE to keep it, DONE to make it the melody your board plays when it boots."],
            ["♥", "MY MELODIES", "CONTROL › MY MELODIES", "All your saved tunes in one place. Tap one to make it your boot melody, ✎ to edit it on the tiles, ⧉ to copy, ✕ to delete. DEFAULT MELODY brings the original back; MELODY VOLUME sets how loud."],
            ["◢", "BOARD STYLE", "BOARD STYLE TAB", "Pick rails, tire and colors so the board on screen looks like yours."],
            ["◉", "LIGHTS", "LEDS TAB", "HEAD/TAIL LIGHTS: riding and idle effects, colors and brightness (RGB LEDs like Thor), SNOOZE before the board powers off. STATUS BAR: idle and riding animations. All linked with Refloat's settings."],
            ["▮", "BATTERY GAUGE", "LEDS › BATTERY GAUGE", "Pick your cells and pack for a battery % you can trust, on screen and on the status bar."],
            ["♬", "BEEPER", "SETTINGS › RIDE › BEEPER", "Controller beeper on/off with a TEST BEEP and PERSISTENT FATAL BEEP, in Settings (gear) › RIDE. The light module's own beeper stays in LEDS › BEEPER."],
            ["↻", "UPDATES", "LEDS › UPDATES", "NEW: update your light module (LCM) right from Refloat Glow over Bluetooth. No laptop, no cables, just a few taps. New Refloat Glow releases show up here too. (Your LCM needs the SLCM base firmware for Bluetooth updates.)", "updates"],
            ["⛨", "GHOSTING PROTECTION", "SETTINGS › WATCHDOG", "Refloat Glow watches both footpad sensors while your board is parked on its tail. A pad that keeps reading high with nobody on it gets a warning; both pads stuck = ghosting alert. One failed pad? WATCHDOG's emergency setting can switch it off until you replace the sensor."],
            ["★", "CREDIT WHERE IT'S DUE", "THE ORIGINAL", "Refloat Glow builds on Refloat by Lukáš Hrázký (lukash), which itself builds on the Float package by Mitch Lustig, Dado Mista and Nico Aleman. Their work made this project possible. Full credit and appreciation go to the original developers and community.", "credit"],
            ["⚠", "SAME RIDE", "RIDE WITH CONFIDENCE", "Underneath the new interface, Refloat Glow retains Refloat 1.2.3's core riding behavior, including balance, pushback, footpad handling and alerts. Most additions focus on customization, lighting and sounds. Optional settings such as MAX SPEED can change how your board behaves, so review them carefully."]
        ]

        MouseArea { anchors.fill: parent }  // block the screen behind (spotlight included)

        // rf166: the spotlight: dark all around, a neon frame on the control
        Item {
            id: spotLayer
            visible: rinkTour.hasSpot
            anchors.fill: parent
            // rf168: eased copy of the spot so it glides between controls and
            // follows the SUW smoothly (no easing for the first frame)
            property bool glide: false
            readonly property var r: rinkTour.spot || {x: 0, y: 0, w: 0, h: 0}
            onVisibleChanged: glide = false
            property QtObject s: QtObject {
                property real x: 0; property real y: 0; property real w: 0; property real h: 0
                Behavior on x { enabled: spotLayer.glide; NumberAnimation { duration: 140; easing.type: Easing.OutCubic } }
                Behavior on y { enabled: spotLayer.glide; NumberAnimation { duration: 140; easing.type: Easing.OutCubic } }
                Behavior on w { enabled: spotLayer.glide; NumberAnimation { duration: 140; easing.type: Easing.OutCubic } }
                Behavior on h { enabled: spotLayer.glide; NumberAnimation { duration: 140; easing.type: Easing.OutCubic } }
            }
            onRChanged: {
                s.x = r.x; s.y = r.y; s.w = r.w; s.h = r.h;
                if (rinkTour.hasSpot) glide = true;
            }
            readonly property color dim: "#D9050210"
            Rectangle { x: 0; y: 0; width: parent.width; height: parent.s.y; color: parent.dim }
            Rectangle { x: 0; y: parent.s.y + parent.s.h; width: parent.width; height: Math.max(0, parent.height - y); color: parent.dim }
            Rectangle { x: 0; y: parent.s.y; width: parent.s.x; height: parent.s.h; color: parent.dim }
            Rectangle { x: parent.s.x + parent.s.w; y: parent.s.y; width: Math.max(0, parent.width - x); height: parent.s.h; color: parent.dim }
            Rectangle {
                id: spotFrame
                x: parent.s.x; y: parent.s.y; width: parent.s.w; height: parent.s.h
                radius: 0.18 * unit
                color: "transparent"
                border.color: swTheme.neonGreen
                border.width: 3
                SequentialAnimation on opacity {
                    running: rinkTour.hasSpot
                    loops: Animation.Infinite
                    NumberAnimation { from: 1.0; to: 0.35; duration: 650; easing.type: Easing.InOutSine }
                    NumberAnimation { from: 0.35; to: 1.0; duration: 650; easing.type: Easing.InOutSine }
                }
            }
            RectangularGlow {
                anchors.fill: spotFrame
                glowRadius: 0.15 * unit
                spread: 0.1
                cornerRadius: spotFrame.radius + glowRadius
                color: swTheme.neonGreen
                opacity: 0.35 * spotFrame.opacity
                z: -1
            }
        }

        Rectangle {
            id: tourCard
            // rf166: with a spotlight the card is shorter and sits on the other half
            readonly property bool spotBelow: rinkTour.hasSpot && rinkTour.spot.y + rinkTour.spot.h / 2 > parent.height / 2
            anchors.horizontalCenter: parent.horizontalCenter
            width: Math.min(parent.width - 0.6 * unit, 9 * unit)
            height: rinkTour.hasSpot ? Math.min(parent.height * 0.62, 9.5 * unit, Math.max(5.5 * unit, (spotBelow ? rinkTour.spot.y : parent.height - rinkTour.spot.y - rinkTour.spot.h) - 0.8 * unit))
                : Math.min(parent.height - 1.2 * unit, 11 * unit)
            y: !rinkTour.hasSpot ? (parent.height - height) / 2
                : spotBelow ? Math.max(0.3 * unit, Math.min(rinkTour.spot.y - height - 0.45 * unit, 0.6 * unit))
                : Math.min(parent.height - height - 0.3 * unit, Math.max(rinkTour.spot.y + rinkTour.spot.h + 0.45 * unit, parent.height - height - 0.6 * unit))
            Behavior on y { NumberAnimation { duration: 200; easing.type: Easing.OutCubic } }
            Behavior on height { NumberAnimation { duration: 200; easing.type: Easing.OutCubic } }

            // pointer toward the spotlight
            Canvas {
                visible: rinkTour.hasSpot
                width: 0.5 * unit
                height: 0.32 * unit
                x: rinkTour.hasSpot ? Math.max(0.4 * unit, Math.min(tourCard.width - width - 0.4 * unit, rinkTour.spot.x + rinkTour.spot.w / 2 - tourCard.x - width / 2)) : 0
                y: tourCard.spotBelow ? tourCard.height - 1 : -height + 1
                property bool down: tourCard.spotBelow
                onDownChanged: requestPaint()
                onPaint: {
                    var c = getContext("2d");
                    c.reset();
                    c.beginPath();
                    if (down) { c.moveTo(0, 0); c.lineTo(width, 0); c.lineTo(width / 2, height); }
                    else { c.moveTo(0, height); c.lineTo(width, height); c.lineTo(width / 2, 0); }
                    c.closePath();
                    c.fillStyle = swTheme.neonPurple;
                    c.fill();
                }
            }
            radius: 0.35 * unit
            color: "#0b0718"
            border.color: swTheme.neonPurple
            border.width: 2

            Text {
                id: tourHead
                anchors.top: parent.top
                anchors.topMargin: 0.3 * unit
                anchors.horizontalCenter: parent.horizontalCenter
                textFormat: Text.StyledText
                text: "<font color='#b14cff'>RE</font><font color='#ead6ff'>FLOAT</font> <font color='#7a3fc0'>—</font> <font color='#39ff7a'>GLOW</font>"
                font.family: "Exan"
                font.pixelSize: 0.28 * unit
            }

            SwipeView {
                id: tourSwipe
                anchors.top: tourHead.bottom
                anchors.topMargin: 0.2 * unit
                anchors.left: parent.left
                anchors.right: parent.right
                anchors.bottom: tourDots.top
                anchors.margins: 0.3 * unit
                clip: true
                onCurrentIndexChanged: if (rinkTour.visible) rinkTour.apply(currentIndex)

                Repeater {
                    model: rinkTour.pages

                    // rf165: a page scrolls if it doesn't fit (small phones, demo pages)
                    Flickable {
                        id: tourPage
                        readonly property string demo: modelData.length > 4 ? modelData[4] : ""
                        readonly property bool current: SwipeView.isCurrentItem && rinkTour.visible
                        clip: true
                        contentWidth: width
                        contentHeight: Math.max(height, tourPageCol.implicitHeight)
                        interactive: tourPageCol.implicitHeight > height
                        flickableDirection: Flickable.VerticalFlick
                        boundsBehavior: Flickable.StopAtBounds
                        Column {
                            id: tourPageCol
                            y: Math.max(0, (tourPage.height - implicitHeight) / 2)
                            width: tourPage.width
                            spacing: 0.25 * unit

                            Item {
                                anchors.horizontalCenter: parent.horizontalCenter
                                width: rinkTour.hasSpot ? 1.1 * unit : tourPage.demo === "updates" ? 1.5 * unit : 2.2 * unit
                                height: width
                                Rectangle {
                                    id: tourRing
                                    anchors.fill: parent
                                    radius: width / 2
                                    color: "transparent"
                                    border.color: swTheme.neonGreen
                                    border.width: 3
                                }
                                Glow {
                                    anchors.fill: tourRing
                                    source: tourRing
                                    radius: Math.round(0.25 * unit)
                                    samples: 2 * radius + 1
                                    color: swTheme.neonGreen
                                    opacity: 0.6
                                }
                                Text {
                                    id: tourGlyph
                                    anchors.centerIn: parent
                                    text: modelData[0]
                                    color: "#d6ffe4"
                                    font.pixelSize: (rinkTour.hasSpot ? 0.48 : tourPage.demo === "updates" ? 0.65 : 0.95) * unit
                                }
                                Glow {
                                    anchors.fill: tourGlyph
                                    source: tourGlyph
                                    radius: Math.round(0.2 * unit)
                                    samples: 2 * radius + 1
                                    color: swTheme.neonGreen
                                    opacity: 0.8
                                }
                            }

                            Text {
                                anchors.horizontalCenter: parent.horizontalCenter
                                text: modelData[2]
                                color: swTheme.neonPurple
                                font.family: "Exan"
                                font.pixelSize: 0.2 * unit
                                font.letterSpacing: 0.06 * unit
                            }

                            Item {
                                anchors.horizontalCenter: parent.horizontalCenter
                                width: parent.width
                                height: tourTitle.implicitHeight
                                Text {
                                    id: tourTitle
                                    width: parent.width
                                    horizontalAlignment: Text.AlignHCenter
                                    wrapMode: Text.WordWrap
                                    text: modelData[1]
                                    color: swTheme.neonGreen
                                    font.family: "Exan"
                                    font.pixelSize: 0.42 * unit
                                    font.letterSpacing: 0.04 * unit
                                }
                                Glow {
                                    anchors.fill: tourTitle
                                    source: tourTitle
                                    radius: Math.round(0.15 * unit)
                                    samples: 2 * radius + 1
                                    color: swTheme.neonGreen
                                    opacity: 0.6
                                }
                            }

                            Text {
                                width: parent.width
                                horizontalAlignment: Text.AlignHCenter
                                wrapMode: Text.WordWrap
                                textFormat: Text.StyledText
                                text: modelData[1] === "LIGHTS" ? rinkTour.lightsText : modelData[3]
                                color: "#ead6ff"
                                font.pixelSize: 0.27 * unit
                                lineHeight: 1.15
                            }

                            // rf165: UPDATES - a picture of the real section, nothing pressable.
                            // Same names as the LEDS tab; the real one keeps every check.
                            Column {
                                visible: tourPage.demo === "updates" && !(tourPage.current && rinkTour.realTarget)
                                width: parent.width
                                spacing: 0.15 * unit
                                Text {
                                    width: parent.width
                                    horizontalAlignment: Text.AlignHCenter
                                    text: "SWIPE UP  ›  LEDS  ›  UPDATES"
                                    color: swTheme.neonPurple
                                    font.family: "Exan"
                                    font.pixelSize: 0.2 * unit
                                }
                                Item {
                                    anchors.horizontalCenter: parent.horizontalCenter
                                    width: Math.min(parent.width, 6.5 * unit)
                                    height: 0.75 * unit
                                    Rectangle {
                                        id: tourUpdPill
                                        anchors.centerIn: parent
                                        width: parent.width - 0.3 * unit
                                        height: 0.55 * unit
                                        radius: height / 2
                                        color: "#0d2a12"
                                        border.color: swTheme.neonGreen
                                        border.width: 2
                                        Text {
                                            anchors.centerIn: parent
                                            text: "↻  CHECK FOR UPDATES"
                                            color: swTheme.neonGreen
                                            font.family: "Exan"
                                            font.pixelSize: 0.22 * unit
                                        }
                                    }
                                    Rectangle {  // the "look here" ring
                                        anchors.fill: parent
                                        radius: height / 2
                                        color: "transparent"
                                        border.color: "#FFB300"
                                        border.width: 2
                                        SequentialAnimation on opacity {
                                            running: tourPage.current && tourPage.demo === "updates"
                                            loops: Animation.Infinite
                                            NumberAnimation { from: 1.0; to: 0.15; duration: 700 }
                                            NumberAnimation { from: 0.15; to: 1.0; duration: 700 }
                                        }
                                    }
                                }
                                Row {
                                    anchors.horizontalCenter: parent.horizontalCenter
                                    spacing: 0.15 * unit
                                    Repeater {
                                        model: [["PACKAGE", "DOWNLOAD PACKAGE", "then install it in VESC Tool (VESC Packages)"],
                                                ["LIGHT MODULE", "FLASH UPDATE", "SLCM over Bluetooth, board at rest"]]
                                        Rectangle {
                                            width: (tourPageCol.width - 0.15 * unit) / 2
                                            height: laneCol.implicitHeight + 0.2 * unit
                                            radius: 0.12 * unit
                                            color: "#140a26"
                                            border.color: index === 0 ? swTheme.neonGreen : swTheme.neonPurple
                                            border.width: 1
                                            Column {
                                                id: laneCol
                                                anchors.centerIn: parent
                                                width: parent.width - 0.2 * unit
                                                spacing: 0.05 * unit
                                                Text {
                                                    width: parent.width
                                                    horizontalAlignment: Text.AlignHCenter
                                                    text: modelData[0]
                                                    color: index === 0 ? swTheme.neonGreen : swTheme.neonPurple
                                                    font.family: "Exan"
                                                    font.pixelSize: 0.18 * unit
                                                }
                                                Text {
                                                    width: parent.width
                                                    horizontalAlignment: Text.AlignHCenter
                                                    fontSizeMode: Text.HorizontalFit
                                                    minimumPixelSize: 0.1 * unit
                                                    text: modelData[1]
                                                    color: "#d6ffe4"
                                                    font.family: "Exan"
                                                    font.pixelSize: 0.16 * unit
                                                }
                                                Text {
                                                    width: parent.width
                                                    horizontalAlignment: Text.AlignHCenter
                                                    wrapMode: Text.WordWrap
                                                    text: modelData[2]
                                                    color: "#ead6ff"
                                                    font.pixelSize: 0.19 * unit
                                                }
                                            }
                                        }
                                    }
                                }
                                Text {
                                    width: parent.width
                                    horizontalAlignment: Text.AlignHCenter
                                    wrapMode: Text.WordWrap
                                    text: "Shown when an SLCM light module is connected. Only tagged releases; the tour never downloads or flashes anything."
                                    color: "#9a86b8"
                                    font.pixelSize: 0.18 * unit
                                }
                            }

                            // rf167: RIDE SETTINGS - a picture of Settings › RIDE (nothing pressable)
                            Column {
                                visible: tourPage.demo === "ride"
                                width: parent.width
                                spacing: 0.12 * unit
                                Row {
                                    anchors.horizontalCenter: parent.horizontalCenter
                                    spacing: 0.12 * unit
                                    Repeater {
                                        model: ["SETUP", "PREFERENCES", "RIDE", "WATCHDOG"]  // rf182
                                        Rectangle {
                                            width: 1.6 * unit
                                            height: 0.45 * unit
                                            radius: height / 2
                                            color: index === 2 ? swTheme.neonGreen : "transparent"
                                            border.color: index === 2 ? swTheme.neonGreen : swTheme.neonPurple
                                            border.width: 1
                                            Text {
                                                anchors.centerIn: parent
                                                text: modelData
                                                color: index === 2 ? swTheme.background : "#c98bff"
                                                font.family: "Exan"
                                                font.pixelSize: 0.15 * unit
                                            }
                                        }
                                    }
                                }
                                Repeater {
                                    model: ["HAPTIC FEEDBACK", "PUSHBACK"]
                                    Rectangle {
                                        anchors.horizontalCenter: parent.horizontalCenter
                                        width: Math.min(parent.width, 6 * unit)
                                        height: 0.5 * unit
                                        radius: 0.12 * unit
                                        color: "#100a24"
                                        border.color: "#FFB300"
                                        border.width: 2
                                        Text {
                                            anchors.centerIn: parent
                                            text: modelData + "  \u203A"
                                            color: swTheme.neonGreen
                                            font.family: "Exan"
                                            font.pixelSize: 0.18 * unit
                                        }
                                    }
                                }
                            }

                            // rf165: CREDIT - a quiet attribution line
                            Text {
                                visible: tourPage.demo === "credit"
                                width: parent.width
                                horizontalAlignment: Text.AlignHCenter
                                wrapMode: Text.WordWrap
                                text: "Refloat · GPL-3.0 · github.com/lukash/refloat"
                                color: "#9a86b8"
                                font.family: "Exan"
                                font.pixelSize: 0.17 * unit
                            }
                        }
                    }
                }
            }

            Row {
                id: tourDots
                anchors.bottom: tourButtons.top
                anchors.bottomMargin: 0.25 * unit
                anchors.horizontalCenter: parent.horizontalCenter
                spacing: 0.12 * unit
                Repeater {
                    model: rinkTour.pages.length
                    Rectangle {
                        width: index === tourSwipe.currentIndex ? 0.4 * unit : 0.14 * unit
                        height: 0.14 * unit
                        radius: height / 2
                        color: index === tourSwipe.currentIndex ? swTheme.neonGreen : "#4a2a73"
                        Behavior on width { NumberAnimation { duration: 150 } }
                    }
                }
            }

            Row {
                id: tourButtons
                anchors.bottom: parent.bottom
                anchors.bottomMargin: 0.3 * unit
                anchors.horizontalCenter: parent.horizontalCenter
                spacing: 0.3 * unit
                NeonButton {
                    text: tourSwipe.currentIndex === 0 ? "Skip" : "Back"
                    onClicked: tourSwipe.currentIndex === 0 ? rinkTour.close() : tourSwipe.decrementCurrentIndex()
                }
                NeonButton {
                    lit: true
                    text: tourSwipe.currentIndex === rinkTour.pages.length - 1 ? "Done" : "Next"
                    onClicked: tourSwipe.currentIndex === rinkTour.pages.length - 1 ? rinkTour.close() : tourSwipe.incrementCurrentIndex()
                }
            }
        }
    }

// Color Preview dialog with an overview of the colors. Uncomment this and the
// FloatingToolButton that shows it to enable it.
//    Rectangle {
//        id: colorPreview
//        anchors.fill: parent
//        z: 100
//        visible: false
//
//        color: "#0b0b0b"
//
//        property var cData: []
//
//        Component.onCompleted: {
//            for (var i of plotSeriesMetaData) {
//                cData.push([i[0], i[1]["color"]]);
//            }
//            for (var i of plotSeriesExtraColors) {
//                cData.push(["", i]);
//            }
//            cData = cData;
//        }
//
//        function show() {
//            visible = true;
//        }
//
//        FloatingToolButton {
//            anchors.bottom: parent.bottom
//            anchors.right: parent.right
