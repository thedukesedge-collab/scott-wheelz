//                    }
//
//                    NText {
//                        anchors.left: colRect.right
//                        anchors.top: colRect.top
//                        anchors.leftMargin: 4
//                        anchors.topMargin: 2
//                        text: modelData[1]
//                        font.pixelSize: fontSizeSuperSmall
//                    }
//
//                    NText {
//                        anchors.right: parent.right
//                        anchors.top: colRect.top
//                        anchors.topMargin: 2
//                        text: modelData[0]
//                        font.pixelSize: fontSizeSuperSmall
//                    }
//                }
//            }
//        }
//    }

    OverlayPlot {
        id: recordedPlot
        neon: true

        maxWindowMinutes: preferences.plotMaxWindowMinutes

        plotData: RecordedPlotData {
            id: recordedPlotData
            seriesMetaData: plotSeriesMetaData
            seriesExtraColors: plotSeriesExtraColors
        }

        function show() {
            init(state.ticksPerSecond);
            plotData.fetch(state.ticksPerSecond);
            visible = true;
        }

        function hide() {
            visible = false;
        }

        Text {
            anchors.centerIn: parent
            visible: !recordedPlotData.dataReady

            property bool timeout: recordedPlotData.timeout

            color: timeout ? Utility.getAppHexColor("red") : getDarkThemeColor("lightText")
            font.pixelSize: fontSizeNormal
            horizontalAlignment: Text.AlignHCenter
            text: timeout ? "timeout" : recordedPlotData.noData ? "no plot data" : recordedPlotData.initialized ? "loading: %1".arg(recordedPlotData.sampleNr) : "loading..."
        }
    }

    // Refloat Glow: Neon Future grid behind the main screen stats
    Rectangle {
        x: root.x
        y: root.y
        width: root.width
        // rf182: OVERLAP (Settings › PREFERENCES › UI): keeps its size under the sheet
        height: root.height - (swSettings.sheetOverlap ? bottomSheet.minHeight : bottomSheet.height) - 0.1 * unit
        color: swTheme.background
        border.color: swTheme.neonPurple
        border.width: 1
        radius: 4

        SwGrid {
            anchors.fill: parent
            anchors.margins: 1
        }
    }

    ColumnLayout {
        id: root
        anchors.fill: parent
        anchors.margins: 5

        ColumnLayout {
            id: swHudTop
            Layout.fillWidth: true
            Layout.fillHeight: true
            // leave room for the collapsed Tunes / Control / Data sheet
            Layout.bottomMargin: bottomSheet.minHeight + 0.1 * unit

            // Refloat Glow: the main view keeps its full-size layout and is
            // scaled down (from the top center) to fit above the sheet as it
            // comes up. A transform doesn't affect layout, so no feedback.
            property real fitScale: swSettings.sheetOverlap ? 1 : Math.min(1, (root.height - bottomSheet.height - 0.1 * unit) / Math.max(1, root.height - bottomSheet.minHeight - 0.1 * unit))
            transform: Scale {
                origin.x: swHudTop.width / 2
                origin.y: 0
                xScale: swHudTop.fitScale
                yScale: swHudTop.fitScale
            }
            spacing: 0

            property real centralMargin: 0.08 * unit

            Rectangle {
                id: batteryBar
                Layout.fillWidth: true
                Layout.preferredHeight: 0.8 * unit

                color: swTheme.color("lightBackground")

                property real voltage: state.rtData["motor.batt_voltage"]
                property int value: 0

                Behavior on voltage {
                    NumberAnimation {
                        easing.type: Easing.OutExpo
                        duration: 200
                    }
                }

                // Refloat Glow: glowing purple digital battery %
                Text {
                    id: batteryBarValue
                    anchors.centerIn: parent
                    z: 3

                    color: "#d9a6ff"
                    font.family: "Exan"
                    font.pixelSize: parent.height * 0.62
                    font.letterSpacing: 0.04 * unit
                    style: Text.Outline
                    styleColor: "#12051f"
                    text: Math.round(parent.value) + "%"
                }

                Glow {
                    anchors.fill: batteryBarValue
                    source: batteryBarValue
                    z: 2
                    radius: Math.round(0.18 * unit)
                    samples: radius * 2 + 1
                    spread: 0.45
                    color: swTheme.neonPurple
                }

                // Refloat Glow: neon fill that fades smoothly from green (full)
                // through yellow/orange to red (empty), glowing harder as it drops
                property real level: clamp(value / 100, 0, 1)
                property color fillColor: Qt.hsva(level * 140 / 360, 0.85, 1.0, 1.0)

                Behavior on fillColor {
                    ColorAnimation {duration: 1500}
                }

                Rectangle {
                    id: batteryBarFill
                    width: parent.width * parent.level
                    height: parent.height
                    z: 1

                    color: parent.fillColor
                }

                Glow {
                    anchors.fill: batteryBarFill
                    source: batteryBarFill
                    z: 1
                    radius: Math.round(0.25 * unit)
                    samples: radius * 2 + 1
                    spread: 0.35
                    color: parent.fillColor
                    opacity: 0.45 + 0.55 * (1 - parent.level)
                    visible: parent.level > 0
                }

                // Refloat Glow: voltage in the same glowing purple digital style as the %
                Glow {
                    anchors.fill: batteryBarVoltageValue
                    source: batteryBarVoltageValue
                    z: 2
                    radius: Math.round(0.12 * unit)
                    samples: radius * 2 + 1
                    spread: 0.45
                    color: swTheme.neonPurple
                }

                Text {
                    id: batteryBarVoltageValue
                    anchors.horizontalCenter: parent.horizontalCenter
                    anchors.horizontalCenterOffset: -parent.width / 4
                    anchors.baseline: batteryBarValue.baseline
                    anchors.leftMargin: 0.3 * unit
                    z: 3

                    color: "#d9a6ff"
                    font.family: "Exan"
                    font.pixelSize: 0.34 * unit
                    font.letterSpacing: 0.02 * unit
                    style: Text.Outline
                    styleColor: "#12051f"
                    text: {
                        var voltageString = "";

                        if (preferences.showBattVoltage) {
                            voltageString = "%1V".arg(toFixed1Zero(parent.voltage));
                        }

                        if (preferences.showBattVoltagePerCell) {
                            if (preferences.showBattVoltage) {
                                voltageString += " / ";
                            }
                            voltageString += "%1V".arg(toFixed2Zero(parent.voltage / motorConfig.batteryCells));
                        }

                        return voltageString;
                    }
                }

                Item {
                    id: chargingInfo
                    anchors.centerIn: parent
                    anchors.horizontalCenterOffset: parent.width / 4
                    height: parent.height - 0.08 * unit
                    width: 2 * unit
                    z: 2

                    property real current: 0
                    property real voltage: 0
                    visible: state.charging

                    SwLText {
                        anchors.horizontalCenter: parent.horizontalCenter
                        font.pixelSize: fontSizeSmall
                        text: "charging"
                    }

                    SwLText {
                        anchors.bottom: parent.bottom
                        width: parent.width / 2
                        font.pixelSize: fontSizeSmall
                        horizontalAlignment: Text.AlignHCenter
                        text: "%1A".arg(toFixed1Zero(parent.current))
                    }

                    SwLText {
                        anchors.bottom: parent.bottom
                        anchors.right: parent.right
                        width: parent.width / 2
                        font.pixelSize: fontSizeSmall
                        horizontalAlignment: Text.AlignHCenter
                        text: "%1V".arg(toFixed1Zero(parent.voltage))
                    }
                }
            }

            RowLayout {
                id: boardNameRow
                Layout.fillWidth: true
                Layout.leftMargin: 0.25 * unit
                Layout.rightMargin: 0.1 * unit
                Layout.topMargin: 0.06 * unit
                Layout.bottomMargin: 0.06 * unit

                Text {
                    id: boardNameText
                    Layout.fillWidth: true
                    Layout.alignment: Qt.AlignVCenter

                    property string name
                    property string nameOrId

                    // Refloat Glow: neon green, in the same digital font as the rest
                    color: name ? swTheme.neonGreen : "#1d9b4c"
                    font.family: "Exan"
                    font.pixelSize: 0.5 * unit
                    font.letterSpacing: 0.03 * unit
                    elide: Text.ElideRight
                    text: nameOrId

                    function load() {
                        var boardName = board.getName();
                        name = boardName;
                        nameOrId = boardName ?? board.getId();
                    }

                    Component.onCompleted: load();
                }

                // Refloat Glow: which lights the quick switches turned off
                // (neon orange, small, next to the name - doesn't move anything)
                Text {
                    Layout.alignment: Qt.AlignVCenter
                    Layout.maximumWidth: 3.2 * unit
                    visible: ledSender.overrideText !== ""
                    horizontalAlignment: Text.AlignRight
                    wrapMode: Text.WordWrap
                    maximumLineCount: 2
                    text: ledSender.overrideText.replace(" LIGHTS ", "\nLIGHTS ")
                    color: "#ff8a1f"
                    font.family: "Exan"
                    font.pixelSize: 0.19 * unit
                    font.letterSpacing: 0.02 * unit
                    layer.enabled: true
                    layer.effect: Glow { radius: 6; samples: 13; color: "#ff8a1f"; spread: 0.15 }
                }

                NeonToolButton {
                    id: editBoardNameButton
                    Layout.alignment: Qt.AlignVCenter
                    Layout.preferredWidth: 1.1 * unit
                    Layout.preferredHeight: 1.1 * unit
                    height: 1.1 * unit

                    iconPath: Path {
                        PathSvg {path: "M 10.59 24 L 17.63 32.42 L 6 35 L 10.59 24 M 10.59 24 L 34.39 4 L 41.49 12.42 L 17.69 32.42 M 4 42 L 46 42"}
                    }

                    onClicked: {
                        editBoardNameDialog.open();
                    }
                }

                NeonToolButton {
                    id: settingsButton
                    Layout.alignment: Qt.AlignVCenter
                    Layout.preferredWidth: 1.1 * unit
                    Layout.preferredHeight: 1.1 * unit
                    height: 1.1 * unit

                    iconPath: Path {
                        PathSvg {path: "M 14.25 37.81 L 10.59 39.42 A 3 3 0 0 1 6.98 38.47 22.5 22.5 0 0 1 4.32 33.87 A 3 3 0 0 1 5.30 30.27 L 8.53 27.9 A 3.6 3.6 0 0 0 8.53 22.1 L 5.30 19.73 A 3 3 0 0 1 4.32 16.13 A 22.5 22.5 0 0 1 6.98 11.53 A 3 3 0 0 1 10.59 10.58 L 14.25 12.19 A 3.6 3.6 0 0 0 19.28 9.29 L 19.79 5.31 A 3 3 0 0 1 22.35 2.66 A 22.5 22.5 0 0 1 27.65 2.66 A 3 3 0 0 1 30.28 5.31 L 30.72 9.29 A 3.6 3.6 0 0 0 35.75 12.19 L 39.41 10.58 A 3 3 0 0 1 43.02 11.53 A 22.5 22.5 0 0 1 45.67 16.13 A 3 3 0 0 1 44.7 19.73 L 41.47 22.1 A 3.6 3.6 0 0 0 41.47 27.9 L 44.7 30.27 A 3 3 0 0 1 45.68 33.87 A 22.5 22.5 0 0 1 43.02 38.47 A 3 3 0 0 1 39.41 39.42 L 35.75 37.81 A 3.6 3.6 0 0 0 30.72 40.71 L 30.28 44.69 A 3 3 0 0 1 27.65 47.34 A 22.5 22.5 0 0 1 22.35 47.34 A 3 3 0 0 1 19.72 44.69 L 19.28 40.71 A 3.6 3.6 0 0 0 14.25 37.81"}
                        PathAngleArc {centerX: 25; centerY: 25; radiusX: 6.5; radiusY: 6.5; sweepAngle: 360;}
                    }

                    onClicked: {
                        settingsDialog.show();
                    }
                }
            }

            Item {Layout.fillHeight: true}  // Refloat Glow: spread out to fill the screen

            // Refloat Glow: digital Neon Future speedometer, takes whatever height is left
            NeonSpeedo {
                id: neonSpeedo
                Layout.fillWidth: true
                // rf184: MAX AIR on: room for its box above the speedo
                Layout.topMargin: swSettings.airShow ? 1.1 * unit : 0
                Layout.preferredHeight: Math.max(1.8 * unit, Math.min(7 * unit, root.height - bottomSheet.minHeight - 0.1 * unit - bottomSheet.hudFixedHeight - (swSettings.airShow ? 1.1 * unit : 0)))

                maxValue: preferences.speedDialMax
                unitText: vescConfig.speedUnit
                value: Math.abs(state.rtData["motor.speed"]) * vescConfig.imperialFactor
                duty: Math.abs(state.rtData["motor.duty_cycle"])
                erpm: Math.abs(state.rtData["motor.erpm"])
                wheelslip: state.wheelslip
                spinLimiting: state.freespinLimiting

                // Refloat Glow: trip (left) / lifetime (right) mileage, small and
                // semi-transparent inside the dial, above the big digits
                component SpeedoMini : Column {
                    property string labelText
                    property real value: 0
                    width: neonSpeedo.radius * 0.36
                    spacing: 0
                    opacity: neonSpeedo.wheelslip ? 0 : 0.75

                    Text {
                        id: miniValue
                        width: parent.width
                        horizontalAlignment: Text.AlignHCenter
                        color: "#ead6ff"
                        font.family: "Exan"
                        font.pixelSize: Math.max(0.22 * unit, neonSpeedo.radius * 0.1)
                        fontSizeMode: Text.HorizontalFit
                        minimumPixelSize: 0.14 * unit
                        text: toFixed1Zero(parent.value) + vescConfig.distanceUnit
                    }

                    Text {
                        width: parent.width
                        horizontalAlignment: Text.AlignHCenter
                        color: "#c98bff"
                        font.family: "Exan"
                        font.pixelSize: Math.max(0.17 * unit, neonSpeedo.radius * 0.07)
                        font.letterSpacing: 0.02 * unit
                        text: parent.labelText
                    }
                }

                SpeedoMini {
                    id: tachometer
                    labelText: "TRIP"
                    x: neonSpeedo.width / 2 - neonSpeedo.radius * 0.44
                    y: neonSpeedo.centerY - neonSpeedo.radius * 0.55
                }

                SpeedoMini {
                    id: odometer
                    labelText: "LIFE"
                    x: neonSpeedo.width / 2 + neonSpeedo.radius * 0.08
                    y: neonSpeedo.centerY - neonSpeedo.radius * 0.55
                }

                // Refloat Glow: ride peaks as little digital boxes in the top
                // corners. Press and hold either one to reset both.
                component PeakBox : Rectangle {
                    id: peakBox
                    property string labelText
                    property string valueText
                    property bool warn: false
                    width: 2.0 * unit
                    height: 0.95 * unit
                    radius: 0.12 * unit
                    color: "#0b0718"
                    border.color: warn ? swTheme.color("red") : swTheme.neonPurple
                    border.width: 2

                    RectangularGlow {
                        anchors.fill: parent
                        z: -1
                        glowRadius: 0.12 * unit
                        spread: 0.2
                        cornerRadius: parent.radius + glowRadius
                        color: parent.border.color
                        opacity: 0.4
                    }

                    Text {
                        anchors.top: parent.top
                        anchors.topMargin: 0.06 * unit
                        width: parent.width
                        horizontalAlignment: Text.AlignHCenter
                        color: peakBox.warn ? swTheme.color("red") : swTheme.neonGreen
                        font.family: "Exan"
                        font.pixelSize: 0.42 * unit
                        fontSizeMode: Text.HorizontalFit
                        minimumPixelSize: 0.2 * unit
                        text: peakBox.valueText
                    }

                    Text {
                        anchors.bottom: parent.bottom
                        anchors.bottomMargin: 0.06 * unit
                        width: parent.width
                        horizontalAlignment: Text.AlignHCenter
                        color: "#c98bff"
                        font.family: "Exan"
                        font.pixelSize: 0.2 * unit
                        font.letterSpacing: 0.03 * unit
                        text: peakBox.labelText
                    }

                    MouseArea {
                        anchors.fill: parent
                        onPressAndHold: neonSpeedo.resetPeaks()
                    }
                }

                PeakBox {
                    id: peakSpeedStat
                    anchors.top: parent.top
                    anchors.left: parent.left
                    anchors.leftMargin: 0.1 * unit
                    labelText: "TOP SPEED"
                    valueText: toFixed1Zero(swSettings.peakSpeed * vescConfig.imperialFactor) + vescConfig.speedUnit
                }

                PeakBox {
                    id: peakDutyStat
                    anchors.top: parent.top
                    anchors.right: parent.right
                    anchors.rightMargin: 0.1 * unit
                    labelText: "MAX DUTY"
                    warn: swSettings.peakDuty >= 0.9
                    valueText: toFixed1Zero(swSettings.peakDuty * 100) + "%"
                }

                // rf171: PUSHBACK OFF (red, under TOP SPEED) / HAPTIC OFF (pink,
                // under MAX DUTY), from the board's Refloat settings
                OffNote {
                    visible: rideState.known && !rideState.pushbackOn
                    anchors.top: peakSpeedStat.bottom
                    anchors.topMargin: 0.08 * unit
                    anchors.left: peakSpeedStat.left  // rf171: never past the screen edge
                    tone: "#ff2b4f"
                    text: "PUSHBACK OFF"
                }
                // rf182: HAPTIC OFF sits top left, just under the board name
                OffNote {
                    visible: rideState.known && !rideState.hapticOn
                    x: { neonSpeedo.x; boardNameRow.x; return parent.mapFromItem(boardNameRow, 0, 0).x; }
                    y: { neonSpeedo.y; boardNameRow.y; boardNameRow.height; return parent.mapFromItem(boardNameRow, 0, boardNameRow.height).y + 0.02 * unit; }
                    tone: "#ff4fd8"
                    text: "HAPTIC OFF"
                }

                // rf182: MAX AIR (Settings › PREFERENCES › MAX AIR), centered above
                // the speedo in the gap under the board name; tap for this trip's
                // total / jumps, hold to reset max air
                PeakBox {
                    id: peakAirStat
                    visible: swSettings.airShow
                    anchors.horizontalCenter: parent.horizontalCenter
                    readonly property real gap: { neonSpeedo.y; boardNameRow.y; return -parent.mapFromItem(boardNameRow, 0, boardNameRow.height).y; }
                    y: -(gap > height ? (gap + height) / 2 : gap)
                    labelText: "MAX AIR"
                    valueText: airTime.cur.max.toFixed(2) + "s"
                    MouseArea {
                        anchors.fill: parent
                        onClicked: airDetails.open()
                        onPressAndHold: airTime.resetMax()
                    }
                }

                // rf169: no max speed limit: a small purple note in the same spot
                // (the original rf96 badge shape); amber + big when a limit is set
                Rectangle {
                    visible: !maxSpeed.shown && maxSpeed.ready && state.pkgState !== state.s_Connecting
                    z: 3
                    anchors.horizontalCenter: parent.horizontalCenter
                    anchors.top: parent.top
                    // rf182: just under MAX AIR while it's shown
                    anchors.topMargin: peakAirStat.visible ? peakAirStat.y + peakAirStat.height + 0.04 * unit : -0.08 * unit
                    width: noLimitBadge.implicitWidth + 0.3 * unit
                    height: noLimitBadge.implicitHeight + 0.1 * unit
                    radius: height / 2
                    color: "#0b0718"
                    border.color: swTheme.neonPurple
                    border.width: 1
                    Text {
                        id: noLimitBadge
                        anchors.centerIn: parent
                        color: swTheme.neonPurple
                        font.family: "Exan"
                        font.pixelSize: 0.2 * unit
                        text: "MAX SPEED LIMIT: OFF"
                    }
                }

                // rf96: a max speed limit is set (MAX SPEED in CONTROL): always
                // shown at the top of the speedo, between the peaks
                Rectangle {
                    visible: maxSpeed.shown
                    z: 3
                    anchors.horizontalCenter: parent.horizontalCenter
                    anchors.top: parent.top
                    // rf182: just under MAX AIR while it's shown
                    anchors.topMargin: peakAirStat.visible ? peakAirStat.y + peakAirStat.height + 0.04 * unit : -0.08 * unit
                    // rf161: bigger and bolder so a set limit is obvious (kept
                    // between the TOP SPEED / MAX DUTY boxes)
                    width: Math.min(maxSpeedBadge.implicitWidth + 0.4 * unit, parent.width * 0.44)
                    height: 0.62 * unit
                    radius: height / 2
                    color: "#2a1d00"
                    border.color: "#FFB300"
                    border.width: 3
                    Text {
                        id: maxSpeedBadge
                        anchors.centerIn: parent
                        width: parent.width - 0.3 * unit
                        horizontalAlignment: Text.AlignHCenter
                        fontSizeMode: Text.HorizontalFit
                        minimumPixelSize: 0.2 * unit
                        color: "#FFB300"
                        font.family: "Exan"
                        font.bold: true
                        font.pixelSize: 0.36 * unit
                        text: "\u26A0 MAX %1 %2".arg(Math.round(maxSpeed.capKmh * vescConfig.imperialFactor)).arg(vescConfig.speedUnit.toUpperCase())
                    }
                }

                function resetPeaks() {
                    swSettings.peakSpeed = 0;
                    swSettings.peakDuty = 0;
                    VescIf.emitStatusMessage("Top speed / max duty reset", true);
                }

                // one-time: older builds saved a 30 mph dial; move it to 40
                Component.onCompleted: Qt.callLater(function() {
                    if (!swSettings.speedo40Migrated) {
                        if (preferences.speedDialMax < 40) {
                            preferences.speedDialMax = 40;
                        }
                        swSettings.speedo40Migrated = true;
                    }
                })

                Item {
                    id: hudDials  // Refloat Glow: current / duty dials flank the speedo
                    anchors.bottom: parent.bottom
                    visible: parent.height >= 2.6 * unit  // hidden while the sheet squeezes the speedo
                    width: parent.width
                    height: 1.9 * unit

                    SwNeonLabel {
                        id: currentDialLabel
                        anchors.bottom: parent.bottom
                        width: parent.height
                        horizontalAlignment: Text.AlignHCenter
                        text: "CURRENT"
                    }

                    Dial {
                        anchors.bottom: currentDialLabel.top
                        anchors.bottomMargin: -0.15 * unit
                        width: parent.height
                        height: width

                        value: state.rtData["motor.current"]

                        allowNegative: true
                        minValue: motorConfig.currentMin;
                        maxValue: motorConfig.currentMax;
                        valueUnit: "A"
                    }

                    SwNeonLabel {
                        id: dutyDialLabel
                        anchors.bottom: parent.bottom
                        anchors.right: parent.right
                        width: parent.height
                        horizontalAlignment: Text.AlignHCenter
                        text: "DUTY"
                    }

                    Dial {
                        anchors.bottom: currentDialLabel.top
                        anchors.bottomMargin: -0.15 * unit
                        anchors.right: parent.right
                        width: parent.height
                        height: width

                        value: state.rtData["motor.duty_cycle"] * 100

                        maxValue: 100
                        warnThresholdAbs: 80
                        valueUnit: "%"
                    }

                }
            }

            Item {Layout.fillHeight: true}

            Item {
                id: hud
                Layout.fillWidth: true
                Layout.preferredHeight: Math.max(hudLeft.contentHeight, pitch.height)
                Layout.bottomMargin: parent.centralMargin

                Item {
                    id: hudLeft

                    property var barThicknessSmall: 0.14 * unit
                    property var fontSizeBars: fontSizeNormal

                    width: parent.width  / 2
                    height: parent.height

                    // Refloat Glow: footpad + roll on top, then the small dials and
                    // battery current; the side view gets the whole right column
                    property real contentHeight: hudRightTop.height + 1.5 * unit

                    Item {
                        id: hudRightTop
                        width: parent.width
                        height: width * 0.46

                        property real sidePadding: (width - 2 * height) / 4

                        Item {
                            id: footpad
                            anchors.left: parent.left
                            anchors.leftMargin: parent.sidePadding
                            width: parent.height
                            height: width

                            property real leftVoltage: state.rtData["footpad.adc1"]
                            property real rightVoltage: state.rtData["footpad.adc2"]

                            // Refloat Glow: breathing glow while either half is engaged
                            property real pulse: 0
                            SequentialAnimation on pulse {
                                running: leftSensor.on || rightSensor.on
                                loops: Animation.Infinite
                                onRunningChanged: if (!running) footpad.pulse = 0
                                NumberAnimation { from: 0; to: 1; duration: 450; easing.type: Easing.InOutSine }
                                NumberAnimation { from: 1; to: 0; duration: 450; easing.type: Easing.InOutSine }
                            }

                            property real canvasWidth: width * 0.85
                            property real scale: canvasWidth / footpadPath.width

                            Path {
                                id: footpadPath

                                property int width: 100
                                property int height: 80
                                property real aspect: height / width
                                scale: Qt.size(footpad.scale, footpad.scale)

                                PathSvg {path: "M 62 2 L 38 2 A 36 15 180 0 0 2 17 L 2 78 L 98 78 L 98 17 A 36 15 0 0 0 62 2 M 50 11 L 50 69"}
                            }

                            Path {
                                id: footpadLeftSensorPath
                                scale: Qt.size(footpad.scale, footpad.scale)
                                PathSvg {path: "M 44 8 L 44 72 L 8 72 L 8 18.4 A 30 10.4 180 0 1 38 8 L 44 8"}
                            }

                            Path {
                                id: footpadRightSensorPath
                                scale: Qt.size(footpad.scale, footpad.scale)
                                PathSvg {path: "M 56 72 L 92 72 L 92 18.4 A 30 10.4 0 0 0 62 8L 56 8 L 56 72"}
                            }

                            component FpCanvas : Canvas {
                                anchors.horizontalCenter: parent.horizontalCenter
                                anchors.bottom: footpadLeftAdc.top
                                anchors.bottomMargin: footpadLeftAdc.font.pixelSize * 0.32
                                width: parent.canvasWidth
                                height: width * footpadPath.aspect
                                contextType: "2d"
                            }

                            component SensorCanvas : FpCanvas {
                                property Path path
                                property bool on: false
                                opacity: on ? 1 : 0

                                onOnChanged: requestPaint();

                                Behavior on opacity {
                                    NumberAnimation {
                                        easing.type: Easing.OutCubic
                                        duration: 60
                                    }
                                }

                                onPaint: {
                                    var context = getContext("2d");
                                    context.reset();
                                    context.fillStyle = swTheme.color("lightAccent")
                                    context.path = path
                                    context.fill()
                                }
                            }

                            FpCanvas {
                                id: footpadCanvas
                                onPaint: {
                                    var context = getContext("2d");
                                    context.reset();
                                    context.path = footpadPath
                                    context.strokeStyle = swTheme.neonPurple
                                    context.globalAlpha = 0.25
                                    context.lineWidth = 7
                                    context.stroke()
                                    context.globalAlpha = 1.0
                                    context.lineWidth = 2
                                    context.stroke()
                                }
                            }

                            SensorCanvas {
                                id: leftSensor
                                path: footpadLeftSensorPath
                            }

                            Glow {
                                anchors.fill: leftSensor
                                radius: Math.round(0.08 * unit)
                                samples: radius * 2 + 1
                                spread: 0.6
                                opacity: leftSensor.opacity * (0.4 + 0.5 * footpad.pulse)
                                color: swTheme.color("lightAccent")
                                source: leftSensor
                            }

                            SensorCanvas {
                                id: rightSensor
                                path: footpadRightSensorPath
                            }

                            Glow {
                                anchors.fill: rightSensor
                                radius: Math.round(0.08 * unit)
                                samples: radius * 2 + 1
                                spread: 0.6
                                opacity: rightSensor.opacity * (0.4 + 0.5 * footpad.pulse)
                                color: swTheme.color("lightAccent")
                                source: rightSensor
                            }

                            // Refloat Glow: ADC labels on each half
                            component AdcLabel : Text {
                                property bool on: false
                                anchors.centerIn: footpadCanvas
                                anchors.verticalCenterOffset: footpadCanvas.height * 0.08
                                font.pixelSize: fontSizeSuperSmall
                                font.bold: true
                                color: on ? swTheme.color("darkBackground") : swTheme.color("disabledText")
                                scale: on ? 1.0 + 0.12 * footpad.pulse : 1.0
                                z: 3
                            }

                            AdcLabel {
                                anchors.horizontalCenterOffset: -footpadCanvas.width / 4
                                text: "ADC1"
                                on: leftSensor.on
                            }

                            AdcLabel {
                                anchors.horizontalCenterOffset: footpadCanvas.width / 4
                                text: "ADC2"
                                on: rightSensor.on
                            }

                            SwNText {
                                id: footpadLeftAdc
                                anchors.bottom: parent.bottom
                                anchors.horizontalCenter: footpadCanvas.horizontalCenter
                                anchors.horizontalCenterOffset: -footpadCanvas.width / 4

                                font.pixelSize: fontSizeSmall
                                text: "%1V".arg(toFixed1Zero(parent.leftVoltage))
                            }

                            SwNText {
                                id: footpadRightAdc
                                anchors.bottom: parent.bottom
                                anchors.horizontalCenter: footpadCanvas.horizontalCenter
                                anchors.horizontalCenterOffset: footpadCanvas.width / 4

                                font.pixelSize: fontSizeSmall
                                text: "%1V".arg(toFixed1Zero(parent.rightVoltage))
                            }
                        }

                        Item {
                            id: roll
                            anchors.right: parent.right
                            anchors.rightMargin: parent.sidePadding
                            width: parent.height
                            height: width

                            property real newValue: state.rtData["imu.roll"]
                            property real preValue: newValue
                            onNewValueChanged: {
                                if (Math.abs(newValue - preValue) > 180) {
                                    rollEasingBehavior.enabled = false;
                                    value += newValue > 0 ? 360 : -360;
                                    rollEasingBehavior.enabled = true;
                                }
                                value = newValue;
                                preValue = newValue;
                            }
                            property real value: newValue
                            onValueChanged: rollCanvas.requestPaint();

                            // Refloat Glow: + = nose up (same sign as the side view)
                            property real noseUp: state.rtData["imu.pitch"]
                            onNoseUpChanged: rollCanvas.requestPaint();
                            property int tireStyle: swSettings.tireStyle
                            onTireStyleChanged: rollCanvas.requestPaint();

                            Behavior on noseUp {
                                NumberAnimation {easing.type: Easing.OutCirc; duration: 100}
                            }

                            Behavior on value {
                                id: rollEasingBehavior
                                NumberAnimation {
                                    easing.type: Easing.OutCirc
                                    duration: 100
                                }
                            }

                            Canvas {
                                id: rollCanvas
                                anchors.horizontalCenter: parent.horizontalCenter
                                width: height
                                height: parent.width - rollText.font.pixelSize * 1.1
                                contextType: "2d"

                                property real scale: width * 0.95 / rollPath.width

                                Path {
                                    id: rollPath

                                    property int width: 100
                                    property int height: 88
                                    scale: Qt.size(rollCanvas.scale, rollCanvas.scale)

                                    PathSvg {path: "M 45.01 -9 L -45.01 -9 A 3 3 0 0 0 -48 -5.75 L -47 6.25 A 3 3 0 0 0 -44.01 9 L 44.01 9 A 3 3 0 0 0 47 6.25 L 48 -5.75 A 3 3 0 0 0 45.01 -9 M -33.54 9 L -33.01 15 A 38.15 15.07 95.62 0 0 -23.54 37.5 A 35 17.39 0 0 0 23.54 37.5 A 38.15 15.07 -95.62 0 0 33.01 15 L 33.54 9 M 33.54 -9 L 33.01 -15 A 38.15 15.07 95.62 0 0 23.54 -37.5 A 35 17.39 0 0 0 -23.54 -37.5 A 38.15 15.07 84.38 0 0 -33.01 -15 L -33.54 -9 M -36 -3 L 36 -3"}
                                }

                                // Refloat Glow: Neon Future front view. Tire + nose block roll
                                // together; the nose block (with its lightbar) slides up
                                // the tire as the nose rises: top of the tire at the
                                // tail-down rest angle (~20 deg), middle when level.
                                onPaint: {
                                    var ctx = getContext("2d");
                                    ctx.reset();
                                    var green = "#39ff7a";
                                    var purple = "#b14cff";
                                    var u = 1 / scale;
                                    var rollDeg = parent.value;
                                    var noseUp = parent.noseUp;
                                    if (noseUp !== noseUp) noseUp = 0;
                                    var lift = -29 * Math.max(-1, Math.min(1, noseUp / 20));

                                    function glow(color, w) {
                                        ctx.save();
                                        ctx.strokeStyle = color;
                                        ctx.globalAlpha = 0.22;
                                        ctx.lineWidth = w * 3.5;
                                        ctx.stroke();
                                        ctx.globalAlpha = 1.0;
                                        ctx.lineWidth = w;
                                        ctx.stroke();
                                        ctx.restore();
                                    }

                                    function roundRect(x, y, w, h, r) {
                                        ctx.beginPath();
                                        ctx.moveTo(x + r, y);
                                        ctx.lineTo(x + w - r, y);
                                        ctx.arcTo(x + w, y, x + w, y + r, r);
                                        ctx.lineTo(x + w, y + h - r);
                                        ctx.arcTo(x + w, y + h, x + w - r, y + h, r);
                                        ctx.lineTo(x + r, y + h);
                                        ctx.arcTo(x, y + h, x, y + h - r, r);
                                        ctx.lineTo(x, y + r);
                                        ctx.arcTo(x, y, x + r, y, r);
                                        ctx.closePath();
                                    }

                                    ctx.translate(width / 2, height / 2);
                                    ctx.scale(scale, scale);

                                    // fixed roll scale: arc with ticks every 15 deg, level mark
                                    ctx.beginPath();
                                    ctx.arc(0, 0, 47, Math.PI * 1.17, Math.PI * 1.83);
                                    ctx.strokeStyle = purple;
                                    ctx.globalAlpha = 0.5;
                                    ctx.lineWidth = 1.2 * u;
                                    ctx.stroke();
                                    for (var t = -45; t <= 45; t += 15) {
                                        var ta = (t - 90) * Math.PI / 180;
                                        var r1 = t === 0 ? 42 : 44;
                                        ctx.beginPath();
                                        ctx.moveTo(Math.cos(ta) * r1, Math.sin(ta) * r1);
                                        ctx.lineTo(Math.cos(ta) * 47, Math.sin(ta) * 47);
                                        ctx.stroke();
                                    }
                                    ctx.globalAlpha = 1.0;

                                    ctx.rotate(Math.PI / 180 * rollDeg);

                                    // roll pointer
                                    ctx.beginPath();
                                    ctx.moveTo(0, -48);
                                    ctx.lineTo(-3, -53);
                                    ctx.lineTo(3, -53);
                                    ctx.closePath();
                                    ctx.fillStyle = green;
                                    ctx.fill();

                                    // tire (front view) + tread; slick = rounder, no tread
                                    var slick = swSettings.tireStyle === 1;
                                    roundRect(-25, -40, 50, 80, slick ? 24 : 17);
                                    glow(green, 2 * u);
                                    ctx.beginPath();
                                    for (var y = -30; y <= (slick ? -31 : 30); y += 7.5) {
                                        ctx.moveTo(-18, y);
                                        ctx.lineTo(18, y);
                                    }
                                    ctx.strokeStyle = green;
                                    ctx.globalAlpha = 0.35;
                                    ctx.lineWidth = 1 * u;
                                    ctx.stroke();
                                    ctx.globalAlpha = 1.0;

                                    // axle hub
                                    ctx.beginPath();
                                    ctx.arc(0, 0, 3.5, 0, 2 * Math.PI);
                                    ctx.fillStyle = purple;
                                    ctx.fill();

                                    // nose block, slides with pitch; filled so it hides the tire behind it
                                    roundRect(-47, lift - 10, 94, 20, 4);
                                    ctx.fillStyle = "#0b0716";
                                    ctx.fill();
                                    glow(purple, 2 * u);

                                    // lightbar
                                    ctx.beginPath();
                                    ctx.moveTo(-34, lift - 2);
                                    ctx.lineTo(34, lift - 2);
                                    glow("#d6ffe4", 2.5 * u);
                                    ctx.beginPath();
                                    ctx.moveTo(-34, lift - 2);
                                    ctx.lineTo(34, lift - 2);
                                    ctx.strokeStyle = green;
                                    ctx.globalAlpha = 0.6;
                                    ctx.lineWidth = 6 * u;
                                    ctx.stroke();
                                    ctx.globalAlpha = 1.0;
                                }
                            }

                            SwNText {
                                id: rollText
                                anchors.bottom: parent.bottom
                                anchors.horizontalCenter: parent.horizontalCenter

                                font.pixelSize: fontSizeSmall
                                font.family: "Exan"
                                text: "ROLL %1°".arg(toFixed1Zero(parent.value))
                            }
                        }
                    }

                    Item {
                        id: consumption
                        anchors.left: parent.left
                        anchors.bottom: parent.bottom
                        anchors.bottomMargin: 0.1 * unit
                        width: 1.3 * unit
                        height: 0.8 * unit

                        readonly property real alpha: 0.05;
                        property real value: 0;

                        SwNeonValue {
                            width: parent.width

                            horizontalAlignment: Text.AlignHCenter
                            text: (toFixed1Zero(parent.value))
                        }

                        SwNeonLabel {
                            width: parent.width
                            anchors.bottom: parent.bottom

                            horizontalAlignment: Text.AlignHCenter
                            text: "WH/%1".arg(vescConfig.distanceUnit.toUpperCase())
                        }

                        function add(v) {
                            value = (1.0 - alpha) * value + alpha * v;
                        }
                    }

                    Item {
                        id: batteryCurrent

                        property var value: state.rtData["motor.batt_current"]
                        property var minValue: preferences.battCurrentLog ? -Math.log(-motorConfig.inCurrentMin + 1) : motorConfig.inCurrentMin
                        property var maxValue: preferences.battCurrentLog ? Math.log(motorConfig.inCurrentMax + 1) : motorConfig.inCurrentMax

                        property var positiveWidth: value > 0 ? (preferences.battCurrentLog ? Math.log(value + 1) : value) / maxValue : 0
                        property var negativeWidth: value < 0 ? (preferences.battCurrentLog ? -Math.log(-value + 1) : value) / minValue : 0

                        Behavior on value {
                            NumberAnimation {
                                easing.type: Easing.OutCirc
                                duration: 100
                            }
                        }

                        anchors.bottom: parent.bottom
                        anchors.right: parent.right
                        width: parent.width - consumption.width

                        SwNeonLabel {
                            id: batteryCurrentLabel
                            anchors.bottom: parent.bottom
                            anchors.horizontalCenter: parent.horizontalCenter
                            width: parent.width
                            horizontalAlignment: Text.AlignHCenter

                            text: "BATTERY AMPS"
                        }

                        Rectangle {
                            id: batteryCurrentBar
                            anchors.bottom: batteryCurrentLabel.top
                            anchors.bottomMargin: 0.06 * unit
                            anchors.horizontalCenter: parent.horizontalCenter
                            width: sideWidth * 2
                            height: hudLeft.barThicknessSmall

                            property var sideWidth: 1.4 * unit

                            color: swTheme.color("lightBackground")

                            Rectangle {
                                anchors.bottom: parent.bottom
                                anchors.horizontalCenter: parent.horizontalCenter
                                width: 1
                                height: hudLeft.barThicknessSmall * 1.2
                                z: 2

                                color: swTheme.color("lightText")
                            }

                            Rectangle {
                                anchors.left: parent.horizontalCenter
                                width: batteryCurrent.positiveWidth * parent.sideWidth
                                height: hudLeft.barThicknessSmall
                                z: 1

                                color: swTheme.color("lightAccent")
                            }

                            Rectangle {
                                anchors.right: parent.horizontalCenter
                                width: batteryCurrent.negativeWidth * parent.sideWidth
                                height: hudLeft.barThicknessSmall
                                z: 1

                                color: swTheme.color("green")
                            }
                        }

                        SwNeonValue {
                            id: batteryCurrentValue
                            anchors.bottom: batteryCurrentBar.top
                            anchors.bottomMargin: 0.06 * unit
                            anchors.horizontalCenter: parent.horizontalCenter

                            text: toFixed1Zero(parent.value)
                        }

                        SwNeonLabel {
                            id: batteryCurrentValueUnit
                            anchors.left: batteryCurrentValue.right
                            anchors.baseline: batteryCurrentValue.baseline
                            anchors.leftMargin: 0.04 * unit

                            text: "A"
                        }
                    }
                }

                Item {
                    id: hudRight

                    anchors.right: parent.right
                    width: parent.width / 2
                    height: parent.height

                    Item {
                        id: pitch
                        anchors.verticalCenter: parent.verticalCenter
                        width: parent.width
                        height: width * 0.85

                        property real textWidth: 1.4 * unit

                        property real pitchValue: state.rtData["imu.pitch"]
                        property real balancePitchValue: state.rtData["imu.balance_pitch"]
                        property real setpointValue: state.rtData["setpoint"]

                        property real runtimeOpacity: 0

                        states: State {
                            name: "running";
                            when: state.pkgState === state.s_Running
                            PropertyChanges {target: pitch; runtimeOpacity: 1;}
                        }

                        transitions: [
                            Transition {
                                to: "running"
                                PropertyAnimation {target: pitch; property: "runtimeOpacity"; duration: 200; easing.type: Easing.OutExpo;}
                            },
                            Transition {
                                from: "running"
                                PropertyAnimation {target: pitch; property: "runtimeOpacity"; duration: 2000; easing.type: Easing.OutExpo;}
                            }
                        ]

                        Behavior on pitchValue {
                            NumberAnimation {
                                easing.type: Easing.OutCirc
                                duration: 100
                            }
                        }

                        Behavior on balancePitchValue {
                            NumberAnimation {
                                easing.type: Easing.OutCirc
                                duration: 100
                            }
                        }

                        Behavior on setpointValue {
                            NumberAnimation {
                                easing.type: Easing.OutCirc
                                duration: 100
                            }
                        }

                        onPitchValueChanged: pitchCanvas.requestPaint()
                        onBalancePitchValueChanged: pitchCanvas.requestPaint()
                        onSetpointValueChanged: pitchCanvas.requestPaint()

                        Canvas {
                            id: pitchCanvas
                            anchors.centerIn: parent
                            anchors.verticalCenterOffset: -0.6 * unit  // Refloat Glow: sit level with the footpad / roll views
                            width: height
                            height: parent.height
                            contextType: "2d"

                            property real scale: width * 0.88 / pitchBoardPath.width

                            Path {
                                id: pitchBoardPath

                                property int width: 200
                                property int height: 80
                                scale: Qt.size(pitchCanvas.scale, pitchCanvas.scale)

                                PathSvg {path: "M -97.36 -3.15 L -91.65 4.16 A 10 10 0 0 0 -83.77 8 L 83.77 8 A 10 10 0 0 0 91.65 4.16 L 97.36 -3.15 A 3 3 0 0 0 95 -8 L -95 -8 A 3 3 0 0 0 -97.36 -3.15"}
                            }

                            Path {
                                id: pitchWheelPath
                                scale: Qt.size(pitchCanvas.scale, pitchCanvas.scale)

                                PathSvg {path: "M 35.1 8 A 36 36 0 0 1 -35.1 8 M -35.1 -8 A 36 36 0 0 1 35.1 -8 M 18.33 8 A 20 20 0 0 1 -18.33 8 M -18.33 -8 A 20 20 0 0 1 18.33 -8"}
                            }

                            Path {
                                id: pitchSetpointPath
                                scale: Qt.size(pitchCanvas.scale, pitchCanvas.scale)
                                PathSvg {path: "M -86 0 L -43 0 M 43 0 L 86 0"}
                            }

                            function paintPath(context, paths, rotation, color) {
                                context.save();
                                context.translate(width / 2, height / 2);
                                if (sw_flip) context.scale(-1, 1);
                                context.rotate(Math.PI / 180 * rotation);
                                context.lineWidth = 2;
                                context.strokeStyle = swTheme.color(color);
                                for (let path of paths) {
                                    context.path = path;
                                    context.stroke();
                                }
                                context.restore();
                            }

                            // Refloat Glow: neon side view (green tire + footpads, purple
                            // rails/fender/hub) with NOSE/TAIL. Nose is on the left. The
                            // front pad brightens when ADC1 or ADC2 is engaged.
                            property bool fpOn: state.fpState !== state.fs_None
                            property real sw_sign: 1
                            // Refloat Glow: FLIP mirrors the whole side view (pitch included),
                            // so the board's real attitude is kept: tail-down stays tail-down,
                            // it's just drawn on the other side
                            property bool sw_flip: swSettings.flipView
                            onSw_flipChanged: requestPaint()
                            property int sw_rail: swSettings.railStyle
                            property int sw_tire: swSettings.tireStyle
                            onSw_tireChanged: requestPaint()
                            onFpOnChanged: requestPaint()
                            onSw_signChanged: requestPaint()
                            onSw_railChanged: requestPaint()

                            // Refloat Glow: rail profiles. Height of the rail centerline
                            // (path units, + = down) at x (-97 nose ... 97 tail).
                            function railY(x) {
                                // piecewise-straight profiles with sharp kinks
                                switch (sw_rail) {
                                case 1:  // WTF: center raised over the tire, shallow dips either side, ends back up
                                    return railLerp(x, [-97, -33, -12, 12, 33, 97], [0, 3.2, -1.2, -1.2, 3.2, 0]);
                                case 2:  // Atom: flat middle, deck sweeps up into both kicks
                                    return railLerp(x, [-97, -80, -40, 40, 80, 97], [-5, -2, 0, 0, -2, -5]);
                                default:
                                    return 0;
                                }
                            }

                            function railLerp(x, xs, ys) {
                                for (var i = 1; i < xs.length; i++) {
                                    if (x <= xs[i]) {
                                        return ys[i - 1] + (x - xs[i - 1]) / (xs[i] - xs[i - 1]) * (ys[i] - ys[i - 1]);
                                    }
                                }
                                return ys[ys.length - 1];
                            }

                            // rail outline in path units (call after context.scale)
                            function railPath(context) {
                                var x;
                                if (sw_rail === 2) {
                                    // Atom: deck + truss rail, ends chamfered underneath
                                    context.beginPath();
                                    context.moveTo(-97, railY(-97) - 8);
                                    for (x = -92; x <= 92; x += 4) {
                                        context.lineTo(x, railY(x) - 7);
                                    }
                                    context.lineTo(97, railY(97) - 8);
                                    context.lineTo(96, railY(96) - 2);
                                    context.lineTo(84, railY(84) + 7);
                                    for (x = 80; x >= -80; x -= 4) {
                                        context.lineTo(x, railY(x) + 7);
                                    }
                                    context.lineTo(-84, railY(-84) + 7);
                                    context.lineTo(-96, railY(-96) - 2);
                                    context.closePath();
                                    return;
                                }
                                if (sw_rail === 1) {
                                    // WTF: slimmer rail, straight segments between the
                                    // kinks, ends cut at an angle (top corner further out)
                                    var xs = [-97, -33, -12, 12, 33, 97];
                                    context.beginPath();
                                    context.moveTo(xs[0], railY(xs[0]) - 6);
                                    for (var i = 1; i < xs.length; i++) {
                                        context.lineTo(xs[i], railY(xs[i]) - 6);
                                    }
                                    context.lineTo(86, railY(86) + 6);
                                    for (var j = xs.length - 2; j >= 1; j--) {
                                        context.lineTo(xs[j], railY(xs[j]) + 6);
                                    }
                                    context.lineTo(-86, railY(-86) + 6);
                                    context.closePath();
                                    return;
                                }
                                context.beginPath();
                                context.moveTo(-97, railY(-97) - 3);
                                for (x = -95; x <= 95; x += 5) {
                                    context.lineTo(x, railY(x) - 8);
                                }
                                context.lineTo(97, railY(97) - 3);
                                context.lineTo(92, railY(92) + 4);
                                for (x = 85; x >= -85; x -= 5) {
                                    context.lineTo(x, railY(x) + 8);
                                }
                                context.lineTo(-92, railY(-92) + 4);
                                context.closePath();
                            }

                            // a footpad following the rail top
                            function padPath(context, x0, x1) {
                                var off = sw_rail === 0 ? 11 : 9;  // sits on the rail top
                                context.beginPath();
                                context.moveTo(x0, railY(x0) - off);
                                for (var x = x0 + 2; x < x1; x += 2) {
                                    context.lineTo(x, railY(x) - off);
                                }
                                context.lineTo(x1, railY(x1) - off);
                            }

                            function paintBalanceOutline(context, rotation) {
                                context.save();
                                context.translate(width / 2, height / 2);
                                if (sw_flip) context.scale(-1, 1);
                                context.rotate(Math.PI / 180 * rotation);
                                context.scale(scale, scale);
                                railPath(context);
                                context.lineWidth = 2 / scale;
                                context.strokeStyle = swTheme.color("swBalance");
                                context.stroke();
                                context.restore();
                            }

                            // wide faint pass (glow) + thin bright pass
                            function glow(context, color, w) {
                                context.save();
                                context.strokeStyle = color;
                                context.globalAlpha = 0.22;
                                context.lineWidth = w * 3.5;
                                context.stroke();
                                context.globalAlpha = 1.0;
                                context.lineWidth = w;
                                context.stroke();
                                context.restore();
                            }

                            function paintDetailedBoard(context, rotation) {
                                var green = swTheme.neonGreen;
                                var purple = swTheme.neonPurple;
                                var u = 1 / scale;  // one screen pixel in path units
                                context.save();
                                context.translate(width / 2, height / 2);
                                if (sw_flip) context.scale(-1, 1);
                                context.rotate(Math.PI / 180 * rotation);

                                context.scale(scale, scale);

                                // rails (shape from swSettings.railStyle)
                                railPath(context);
                                glow(context, purple, 2 * u);

                                var atom = sw_rail === 2;
                                if (atom) {
                                    // deck / rail seam
                                    context.beginPath();
                                    context.moveTo(-95, railY(-95) - 3);
                                    for (var sx = -91; sx <= 95; sx += 4) {
                                        context.lineTo(sx, railY(sx) - 3);
                                    }
                                    glow(context, purple, 1 * u);

                                    // truss lattice (X cells) either side of the hub
                                    context.beginPath();
                                    for (var side = -1; side <= 1; side += 2) {
                                        for (var cx0 = 22; cx0 < 77; cx0 += 11) {
                                            var xa = side * cx0, xb = side * (cx0 + 11);
                                            context.moveTo(xa, railY(xa) - 1);
                                            context.lineTo(xb, railY(xb) + 5);
                                            context.moveTo(xa, railY(xa) + 5);
                                            context.lineTo(xb, railY(xb) - 1);
                                        }
                                    }
                                    glow(context, purple, 0.8 * u);

                                    // green slanted inserts at the nose and tail
                                    for (var e = -1; e <= 1; e += 2) {
                                        context.beginPath();
                                        context.moveTo(e * 90, railY(e * 90) - 1);
                                        context.lineTo(e * 84, railY(e * 84) - 1);
                                        context.lineTo(e * 72, railY(e * 72) + 5);
                                        context.lineTo(e * 78, railY(e * 78) + 5);
                                        context.closePath();
                                        glow(context, green, 1.5 * u);
                                    }
                                }

                                // tire
                                for (var k = 0; k < 2; k++) {
                                    var a0 = Math.asin(8 / 36);
                                    context.beginPath();
                                    if (k === 0)
                                        context.arc(0, 0, 36, a0, Math.PI - a0);
                                    else
                                        context.arc(0, 0, 36, Math.PI + a0, 2 * Math.PI - a0);
                                    glow(context, green, (sw_tire === 1 ? 3 : 2) * u);
                                }

                                // tread ticks (treaded tire only; slick = smooth ring)
                                context.beginPath();
                                for (var i = 0; i < (sw_tire === 1 ? 0 : 36); i++) {
                                    var a = i * Math.PI / 18;
                                    var y1 = 31 * Math.sin(a);
                                    if (Math.abs(y1) < 10) continue;
                                    context.moveTo(31 * Math.cos(a), y1);
                                    context.lineTo(36 * Math.cos(a), 36 * Math.sin(a));
                                }
                                context.strokeStyle = green;
                                context.lineWidth = 1.2 * u;
                                context.stroke();

                                if (atom) {
                                    // Atom hub: green rings with a bolt circle
                                    for (var r of [18, 13]) {
                                        for (var hh = 0; hh < 2; hh++) {
                                            var c0 = Math.asin(Math.min(1, 8 / r));
                                            context.beginPath();
                                            if (hh === 0)
                                                context.arc(0, 0, r, c0, Math.PI - c0);
                                            else
                                                context.arc(0, 0, r, Math.PI + c0, 2 * Math.PI - c0);
                                            glow(context, green, (r === 18 ? 1.8 : 1.2) * u);
                                        }
                                    }
                                    context.beginPath();
                                    for (var bi = 0; bi < 8; bi++) {
                                        var ba = bi * Math.PI / 4 + Math.PI / 8;
                                        var bx = 15.5 * Math.cos(ba), by = 15.5 * Math.sin(ba);
                                        if (Math.abs(by) < 9) continue;
                                        context.moveTo(bx + 1.3, by);
                                        context.arc(bx, by, 1.3, 0, 2 * Math.PI);
                                    }
                                    glow(context, green, 1 * u);

                                    // axle bolts in the rail
                                    context.beginPath();
                                    for (var ax of [-11, -6, 6, 11]) {
                                        context.moveTo(ax + 1.8, railY(0) + 2);
                                        context.arc(ax, railY(0) + 2, 1.8, 0, 2 * Math.PI);
                                    }
                                    glow(context, green, 1 * u);

                                }

                                // hub motor
                                for (var h = 0; h < (atom ? 0 : 2); h++) {
                                    var b0 = Math.asin(8 / 18);
                                    context.beginPath();
                                    if (h === 0)
                                        context.arc(0, 0, 18, b0, Math.PI - b0);
                                    else
                                        context.arc(0, 0, 18, Math.PI + b0, 2 * Math.PI - b0);
                                    glow(context, purple, 1.5 * u);
                                }
                                if (!atom) {
                                    context.beginPath();
                                    context.arc(0, 0, 3.5, 0, 2 * Math.PI);
                                    context.fillStyle = purple;
                                    context.fill();

                                    // fender
                                    context.beginPath();
                                    context.arc(0, 0, 43, Math.PI * 1.13, Math.PI * 1.87);
                                    glow(context, purple, 2 * u);
                                }

                                // front footpad (nose, left)
                                padPath(context, -88, -46);
                                glow(context, fpOn ? green : "#1d6b3c", (fpOn ? 4 : 2.5) * u);

                                // labels
                                context.font = "bold " + Math.round(fontSizeSuperSmall * u) + "px monospace";
                                context.textAlign = "center";
                                if (sw_flip) context.scale(-1, 1);  // keep the text readable
                                var lx = sw_flip ? -1 : 1;
                                context.fillStyle = green;
                                context.fillText("NOSE", -70 * lx, 26);
                                context.fillStyle = purple;
                                context.fillText("TAIL", 70 * lx, 26);
                                context.restore();
                            }

                            onPaint: {
                                var context = getContext("2d");
                                context.reset()
                                paintBalanceOutline(context, sw_sign * parent.balancePitchValue);
                                paintDetailedBoard(context, sw_sign * parent.pitchValue);
                                context.globalAlpha = parent.runtimeOpacity;
                                paintPath(context, [pitchSetpointPath], sw_sign * parent.setpointValue, "orange");
                            }
                        }


                        Text {
                            id: pitchPushbackText
                            anchors.top: parent.top
                            anchors.left: parent.left
                            anchors.leftMargin: 0.17 * unit

                            property string satText: state.setpointAdjustmentTypeString

                            onSatTextChanged: {
                                if (satText) {
                                    text = satText;
                                    if (state.setpointAdjustmentClass == state.sac_Error) {
                                        color = swTheme.color("red");
                                    } else if (state.setpointAdjustmentClass == state.sac_Warning) {
                                        color = swTheme.color("orange");
                                    } else {
                                        color = swTheme.color("normalText");
                                    }
                                }
                            }

                            font.pixelSize: fontSizeSmall
                            opacity: 0

                            states: State {
                                name: "shown";
                                when: pitchPushbackText.satText != "" && state.pkgState === state.s_Running
                                PropertyChanges {target: pitchPushbackText; opacity: 1;}
                            }

                            transitions: [
                                Transition {
                                    to: "shown"
                                    PropertyAnimation {target: pitchPushbackText; property: "opacity"; duration: 200; easing.type: Easing.OutExpo;}
                                },
                                Transition {
                                    from: "shown"
                                    PropertyAnimation {target: pitchPushbackText; property: "opacity"; duration: 2000; easing.type: Easing.OutExpo;}
                                }
                            ]
                        }

                        SwNeonLabel {
                            id: pitchPitchLabel
                            anchors.bottom: parent.bottom
                            anchors.left: parent.left
                            width: parent.textWidth

                            horizontalAlignment: Text.AlignHCenter
                            text: "PITCH"
                        }

                        SwNeonValue {
                            id: pitchPitchValue
                            anchors.bottom: pitchPitchLabel.top
                            width: parent.textWidth

                            horizontalAlignment: Text.AlignHCenter
                            text: "%1°".arg(toFixed1Zero(parent.pitchValue))
                        }

                        // Refloat Glow: BALANCE sits one step right of PITCH, so WH/MI,
                        // BATTERY AMPS, PITCH and BALANCE are evenly spaced
                        property real balanceX: textWidth / 2 + width / 2 + 0.05 * unit - textWidth / 2

                        SwNeonLabel {
                            id: pitchBalancePitchLabel
                            anchors.bottom: parent.bottom
                            x: parent.balanceX
                            width: parent.textWidth

                            horizontalAlignment: Text.AlignHCenter
                            text: "BALANCE"
                        }

                        SwNeonValue {
                            id: pitchBalancePitchValue
                            anchors.bottom: pitchBalancePitchLabel.top
                            x: parent.balanceX
                            width: parent.textWidth

                            color: swTheme.color("swPurple")
                            horizontalAlignment: Text.AlignHCenter
                            text: "%1°".arg(toFixed1Zero(parent.balancePitchValue))
                        }

                        SwNText {
                            id: pitchSetpointLabel
                            anchors.top: parent.top
                            anchors.right: parent.right
                            width: parent.textWidth

                            font.pixelSize: fontSizeSmall
                            horizontalAlignment: Text.AlignHCenter
                            opacity: parent.runtimeOpacity
                            text: "setpoint"
                        }

                        Text {
                            id: pitchSetpointValue
                            anchors.top: pitchSetpointLabel.bottom
                            anchors.right: parent.right
                            width: parent.textWidth

                            color: swTheme.color("orange")
                            font.pixelSize: fontSizeNormal
                            horizontalAlignment: Text.AlignHCenter
                            opacity: parent.runtimeOpacity
                            text: "%1°".arg(toFixed1Zero(parent.setpointValue))
                        }
                    }
                }
            }

            Item {Layout.fillHeight: true}

            Item {
                id: middleRow

                property var verticalValueItemWidth: 1.7 * unit
                property var verticalValueItemHeight: 0.95 * unit

                Layout.fillWidth: true
                Layout.preferredHeight: 1.1 * unit
                Layout.topMargin: parent.centralMargin

                SwStat {
                    id: motorTemp
                    anchors.left: parent.left
                    anchors.verticalCenter: parent.verticalCenter
                    engineIcon: true
                    fahrenheit: swSettings.tempF
                    unitText: swSettings.tempF ? "°F" : "°C"

                    // Refloat Glow: tap the engine to switch °C / °F
                    MouseArea {
                        anchors.fill: parent
                        onClicked: swSettings.tempF = !swSettings.tempF
                    }
                    warningThreshold: motorConfig.tempMotorStart - preferences.tempWarningOffset
                    value: state.rtData["motor.motor_temp"]
                }

                SwStat {
                    id: escTemp
                    anchors.right: parent.right
                    anchors.verticalCenter: parent.verticalCenter
                    labelText: "ESC"
                    fahrenheit: swSettings.tempF
                    unitText: swSettings.tempF ? "°F" : "°C"
                    warningThreshold: motorConfig.tempFetStart - preferences.tempWarningOffset
                    value: state.rtData["motor.mosfet_temp"]
                }

                StatusText {
                    id: statusText
                    anchors.verticalCenter: parent.verticalCenter
                    anchors.horizontalCenter: parent.horizontalCenter
                    width: parent.width - 2 * motorTemp.width - 0.4 * unit
                    height: parent.height * 0.83
                    globState: state
                }
            }

            // Refloat Glow: TILT slider. Springs back to 0 when released. Range is
            // +-4 deg (the package also hard-caps remote tilt at 4 deg), so it
            // can't tilt the nose far enough to drag or dive.
            RowLayout {
                id: swTiltRow
                Layout.fillWidth: true
                Layout.preferredHeight: 0.85 * unit
                Layout.leftMargin: 0.2 * unit
                Layout.rightMargin: 0.2 * unit
                Layout.topMargin: 0.1 * unit
                spacing: 0.2 * unit

                SwNeonLabel {
                    Layout.preferredWidth: 1.3 * unit
                    Layout.alignment: Qt.AlignVCenter
                    color: swTiltSlider.value !== 0 ? swTheme.neonGreen : "#c98bff"
                    font.pixelSize: 0.36 * unit
                    text: "TILT"
                }

                Slider {
                    id: swTiltSlider
                    Layout.fillWidth: true
                    Layout.preferredHeight: unit
                    Layout.alignment: Qt.AlignVCenter

                    from: -1
                    to: 1
                    value: 0
                    enabled: mainItem.tiltUsable  // rf108: engaged and moving
                    opacity: enabled ? 1 : 0.4

                    readonly property real maxDeg: 4
                    property real angleLimit: 10  // Tiltback Angle Limit, read on press
                    property bool sentNonZero: false
                    readonly property real degrees: value * Math.min(maxDeg, angleLimit)

                    // value for (set-remote-state ...), scaled so full slider = maxDeg
                    function input() {
                        return angleLimit > 0 ? clamp(degrees / angleLimit, -1, 1) : 0;
                    }

                    onPressedChanged: {
                        if (!pressed) return;
                        var lim = packageConfig.getParamValue("inputtilt_angle_limit");
                        if (lim > 0) {
                            angleLimit = lim;
                        }
                        // (remote tilt input UART: set while idle, see tiltUsable)
                    }

                    background: Rectangle {
                        x: swTiltSlider.leftPadding
                        y: swTiltSlider.topPadding + swTiltSlider.availableHeight / 2 - height / 2
                        width: swTiltSlider.availableWidth
                        height: 0.16 * unit
                        radius: height / 2
                        color: "#1d1238"
                        border.color: swTheme.neonPurple
                        border.width: 1

                        Rectangle {
                            property real mid: parent.width / 2
                            property real pos: swTiltSlider.visualPosition * parent.width
                            x: Math.min(mid, pos)
                            width: Math.abs(pos - mid)
                            height: parent.height
                            radius: height / 2
                            color: swTheme.neonGreen
                        }

                        Rectangle {
                            anchors.centerIn: parent
                            width: 2
                            height: parent.height * 2.4
                            color: swTheme.color("lightText")
                        }
                    }

                    handle: Rectangle {
                        x: swTiltSlider.leftPadding + swTiltSlider.visualPosition * (swTiltSlider.availableWidth - width)
                        y: swTiltSlider.topPadding + swTiltSlider.availableHeight / 2 - height / 2
                        width: 0.62 * unit
                        height: width
                        radius: width / 2
                        color: swTiltSlider.pressed ? swTheme.neonGreen : swTheme.background
                        border.color: swTheme.neonGreen
                        border.width: 3
                    }
                }

                SwNeonValue {
                    Layout.preferredWidth: 1.5 * unit
                    Layout.alignment: Qt.AlignVCenter
                    horizontalAlignment: Text.AlignRight
                    color: swTiltSlider.value !== 0 ? swTheme.neonGreen : "#ead6ff"
                    font.pixelSize: 0.36 * unit
                    text: (swTiltSlider.degrees > 0 ? "+" : "") + swTiltSlider.degrees.toFixed(1) + "°"
                }
            }

            // Refloat Glow: big HORN bar across the bottom (hold or tap). Riding:
            // full haptics, up to 3 s per press; idle: tone only, up to 2 s.
            // Mirrors the package's heat budget (haptic_feedback.c): 3 s of
            // horn, used up while sounding (1.5x faster idle), refilled 1 s
            // per s of silence. The package enforces it; this only shows it.
            Rectangle {
                id: hornFrame
                Layout.fillWidth: true
                Layout.preferredHeight: 1.75 * unit  // bigger now the sheet folds away
                Layout.leftMargin: 0.15 * unit
                Layout.rightMargin: 0.15 * unit
                Layout.topMargin: 0.15 * unit
                Layout.bottomMargin: 0.35 * unit  // gap so the horn and the sheet handle can't be mis-hit
                radius: 0.3 * unit

                readonly property real budgetMax: 3.0
                property bool available: state.pkgState === state.s_Running || state.pkgState === state.s_Ready
                property bool riding: state.pkgState === state.s_Running
                property bool expired: false   // held past the per-press limit
                property bool blocked: false   // pressed with too little budget left
                property real budget: budgetMax
                property bool honking: hornButton.pressed && !expired && !blocked && budget > 0

                // called from the 10 Hz timer
                function tick() {
                    if (honking) {
                        budget = Math.max(0, budget - (riding ? 0.1 : 0.15));
                        if (budget <= 0) {
                            expired = true;
                            commands.sendHorn(0);
                        }
                    } else {
                        budget = Math.min(budgetMax, budget + 0.1);
                    }
                }

                color: honking ? swTheme.neonPurple : "#140a26"
                border.color: swTheme.neonPurple
                border.width: 3

                RectangularGlow {
                    anchors.fill: parent
                    z: -1
                    glowRadius: 0.25 * unit
                    spread: 0.2
                    cornerRadius: parent.radius + glowRadius
                    color: swTheme.neonPurple
                    opacity: hornFrame.honking ? 0.9 : 0.3
                }
                opacity: available && budget >= 0.2 ? 1.0 : 0.4

                // heat budget gauge along the bottom edge
                Rectangle {
                    anchors.left: parent.left
                    anchors.bottom: parent.bottom
                    anchors.leftMargin: parent.radius
                    anchors.bottomMargin: 0.12 * unit
                    width: (parent.width - 2 * parent.radius) * hornFrame.budget / hornFrame.budgetMax
                    height: 0.07 * unit
                    radius: height / 2
                    color: hornFrame.budget >= 1.0 ? swTheme.neonGreen : swTheme.color("orange")
                    opacity: hornFrame.budget < hornFrame.budgetMax ? 0.9 : 0.35
                }

                Timer {
                    id: hornMaxTimer
                    interval: 3000
                    onTriggered: {
                        hornFrame.expired = true;
                        commands.sendHorn(0);
                    }
                }

                Text {
                    anchors.centerIn: parent
                    text: hornFrame.honking ? "HONK" : hornFrame.blocked || (hornButton.pressed && hornFrame.budget <= 0) ? "WAIT" : hornFrame.expired ? "MAX" : "HORN"
                    color: hornFrame.honking ? swTheme.background : swTheme.neonPurple
                    font.family: "Exan"
                    font.pixelSize: 0.75 * unit
                    font.letterSpacing: 0.2 * unit
                }

                MouseArea {
                    id: hornButton
                    anchors.fill: parent
                    enabled: parent.available
                    onPressed: {
                        hornFrame.expired = false;
                        hornFrame.blocked = hornFrame.budget < 0.2;
                        if (hornFrame.blocked) return;
                        hornMaxTimer.interval = hornFrame.riding ? 3000 : 2000;
                        hornMaxTimer.restart();
                        commands.sendHorn(2);
                    }
                    onReleased: hornFrame.release()
                    onCanceled: hornFrame.release()
                }

                function release() {
                    commands.sendHorn(0);
                    hornMaxTimer.stop();
                    expired = false;
                    blocked = false;
                }
            }
        }
    }

    // rf157: PERSISTENT FATAL BEEP (?) - Refloat's Persistent Fatal Error
    // (alert_tracker.c: a firmware fault latches the fatal error state)
    BaseDialog {
        id: fatalHelp
        title: "Persistent fatal beep"
        standardButtons: Dialog.NoButton
        readonly property string g: ""  // rf158: no highlighted words
        readonly property string e: ""
        footer: Item {
            implicitHeight: 1.2 * unit
            SwPill {
                anchors.centerIn: parent
                minWidth: 3.0 * unit
                label: "GOT IT"
                onClicked: fatalHelp.close()
            }
        }
        Column {
            width: parent.width
            spacing: 0.3 * unit
            Repeater {
                model: [
                    "This is Refloat's " + fatalHelp.g + "Persistent Fatal Error" + fatalHelp.e + " setting. When it's " + fatalHelp.g + "ON" + fatalHelp.e
                        + ", any fault, even a momentary one, sets a fatal error that keeps beeping until you power-cycle the board (or clear it in VESC Tool).",  // rf159
                    "On most " + fatalHelp.g + "known-good, working boards" + fatalHelp.e + " it's recommended " + fatalHelp.g + "OFF" + fatalHelp.e
                        + ". It can be set off during what many would call " + fatalHelp.g + "normal riding" + fatalHelp.e + ": " + fatalHelp.g + "airtime" + fatalHelp.e + " or "
                        + fatalHelp.g + "deweighting" + fatalHelp.e + " while moving, like a " + fatalHelp.g + "curb drop" + fatalHelp.e + " or a " + fatalHelp.g + "bonk" + fatalHelp.e
                        + ", can cause a brief fault, and with this ON it turns into a " + fatalHelp.g + "persistent beep" + fatalHelp.e + ".",
                    "With it " + fatalHelp.g + "OFF" + fatalHelp.e + ", a fault still beeps " + fatalHelp.g + "while it's happening" + fatalHelp.e + "; it just doesn't stay on afterwards.",
                    "Saved to the board only while it's " + fatalHelp.g + "stopped" + fatalHelp.e + ". Refloat's default is ON."
                ]
                Text {
                    visible: modelData !== ""
                    width: parent.width
                    wrapMode: Text.WordWrap
                    textFormat: Text.StyledText
                    color: "#ead6ff"
                    font.pixelSize: 0.3 * unit
                    lineHeight: 1.15
                    text: modelData
                }
            }
        }
    }

    // rf156: SNOOZE (?) - how snooze and the idle power-off clock work.
    // The power-off time is VESC's own (App Settings > General > Shutdown
    // Mode), read live. Facts from leds.c: the idle clock restarts with
    // riding, a rolling wheel or a motor tone; no power-off timer = 10 min.
    BaseDialog {
        id: snoozeHelp
        title: "Snooze"
        standardButtons: Dialog.NoButton
        readonly property string g: ""  // rf158: no highlighted words
        readonly property string e: ""
        readonly property real offMin: vescAppConfig.offMinutes
        readonly property string offText: offMin <= 0 ? ""
            : offMin < 1 ? Math.round(offMin * 60) + " seconds"
            : offMin >= 60 ? (offMin / 60) + (offMin === 60 ? " hour" : " hours")
            : offMin + (offMin === 1 ? " minute" : " minutes")
        readonly property real before: swSettings.ledSnoozeMin === 255 ? 5 : swSettings.ledSnoozeMin

        footer: Item {
            implicitHeight: 1.2 * unit
            SwPill {
                anchors.centerIn: parent
                minWidth: 3.0 * unit
                label: "GOT IT"
                onClicked: snoozeHelp.close()
            }
        }

        Column {
            width: parent.width
            spacing: 0.3 * unit
            Repeater {
                model: [
                    snoozeHelp.offMin > 0
                        ? "Your board is set to " + snoozeHelp.g + "power off" + snoozeHelp.e + " after idling for " + snoozeHelp.g + snoozeHelp.offText + snoozeHelp.e + "."
                        : "Your board isn't set to power off when idle.",
                    // same rules as main.c: no timer -> 10 min; timer not longer than the lead -> none
                    snoozeHelp.before <= 0 ? snoozeHelp.g + "Snooze" + snoozeHelp.e + " is set to " + snoozeHelp.g + "NEVER" + snoozeHelp.e + ", so the lights stay in their normal idle look."
                    : snoozeHelp.offMin <= 0 ? snoozeHelp.g + "Snooze" + snoozeHelp.e + " kicks in after " + snoozeHelp.g + "10 minutes" + snoozeHelp.e + " idle to let you know the board has been " + snoozeHelp.g + "sitting idle" + snoozeHelp.e + ". The lights switch to their snooze look."
                    : snoozeHelp.offMin <= snoozeHelp.before ? "The power-off time is " + snoozeHelp.g + "too short for snooze" + snoozeHelp.e + " (" + snoozeHelp.before + " min before it), so snooze won't kick in."
                    : snoozeHelp.g + "Snooze" + snoozeHelp.e + " kicks in " + snoozeHelp.g + snoozeHelp.before + " min before" + snoozeHelp.e + " that time to let you know your board is " + snoozeHelp.g + "getting close to powering off" + snoozeHelp.e
                        + ". The lights switch to their snooze look (BREATHE, DIM, DARK... set in HEAD/TAIL LIGHTS and STATUS BAR).",
                    // rf158: leds.c: a separate power-off warning on top of any snooze
                    // look (also with NEVER); last minute, last 15 s for a 1 min timer
                    snoozeHelp.offMin >= 1 ? "Separately, in the last minute before power-off (last 15 s with a 1 minute timer) the lights flash twice every 15 s, whatever the snooze setting." : "",
                    "To reset the clock, " + snoozeHelp.g + "roll the wheel forward" + snoozeHelp.e + " (or ride). The idle power-off clock " + snoozeHelp.g + "starts over" + snoozeHelp.e
                        + ", snooze ends and the lights go back to their " + snoozeHelp.g + "normal idle look" + snoozeHelp.e + ". Pressing the footpads or lifting the board doesn't reset it.",
                    "Use the arrows to pick how many minutes before power-off snooze starts (" + snoozeHelp.g + "NEVER" + snoozeHelp.e + " = no snooze)."
                ]
                Text {
                    visible: modelData !== ""
                    width: parent.width
                    wrapMode: Text.WordWrap
                    textFormat: Text.StyledText
                    color: "#ead6ff"
                    font.pixelSize: 0.3 * unit
                    lineHeight: 1.15
                    text: modelData
                }
            }
        }
    }

    // Refloat Glow (rf81): with the sheet (SUW) up, a tap anywhere on
    // the main view above it just puts it down (that tap does nothing else).
    // rf150: except the HORN button: it still works with the sheet up, so horn
    // settings can be tried right away (the sheet stays up).
    MouseArea {
        anchors.left: root.left
        anchors.right: root.right
        anchors.top: root.top
        anchors.bottom: bottomSheet.top
        z: 5
        enabled: bottomSheet.fraction > 0.5 && !bottomSheet.dragging
        onPressed: function (mouse) {
            if (hornFrame.visible) {
                var p = mapToItem(hornFrame, mouse.x, mouse.y);
                if (p.x >= 0 && p.y >= 0 && p.x < hornFrame.width && p.y < hornFrame.height) {
                    mouse.accepted = false;  // goes on to the HORN button below
                    return;
                }
            }
        }
        onClicked: bottomSheet.setFraction(0)
    }

    // rf105: "TAP OR SWIPE UP HERE" - a neon hand pointing at the sheet handle
    // when the UI opens (after the disclaimer / tour); gone once the sheet is
    // opened or after 10 s
    Item {
        id: sheetHint
        property bool done: false
        readonly property bool show: !done && bottomSheet.fraction < 0.1 && !disclaimerDialog.visible && !rinkTour.visible
        visible: opacity > 0
        opacity: show ? 1 : 0
        Behavior on opacity { NumberAnimation { duration: 300 } }
        z: 6
        anchors.horizontalCenter: root.horizontalCenter
        anchors.bottom: bottomSheet.top
        anchors.bottomMargin: 0.05 * unit
        width: 5 * unit
        height: 2.6 * unit
        property real bob: 0
        SequentialAnimation on bob {
            running: sheetHint.visible
            loops: Animation.Infinite
            NumberAnimation { to: 0.35 * unit; duration: 650; easing.type: Easing.InOutSine }
            NumberAnimation { to: 0; duration: 650; easing.type: Easing.InOutSine }
        }
        Timer { running: sheetHint.show; interval: 10000; onTriggered: sheetHint.done = true }

        Rectangle {
            id: sheetHintLabel
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.top: parent.top
            width: sheetHintText.implicitWidth + 0.6 * unit
            height: sheetHintText.implicitHeight + 0.3 * unit
            radius: height / 2
            color: "#E60b0718"
            border.color: swTheme.neonGreen
            border.width: 2
            Text {
                id: sheetHintText
                anchors.centerIn: parent
                text: "TAP OR SWIPE UP HERE"
                color: swTheme.neonGreen
                font.family: "Exan"
                font.pixelSize: 0.28 * unit
                font.letterSpacing: 0.03 * unit
            }
        }
        // the hand: neon outline, pointing down at the handle, bobbing
        Canvas {
            id: sheetHintHand
            width: 0.9 * unit
            height: 1.26 * unit
            anchors.horizontalCenter: parent.horizontalCenter
            y: sheetHintLabel.height + 0.1 * unit + sheetHint.bob
            onWidthChanged: requestPaint()
            // rf113: a pointing hand (index finger down, other fingers curled,
            // thumb, cuff), drawn on a 40 x 56 grid
            onPaint: {
                var c = getContext("2d");
                c.reset();
                var k = Math.min(width / 40, height / 56);
                c.translate((width - 40 * k) / 2, (height - 56 * k) / 2);
                c.scale(k, k);
                c.strokeStyle = "#39ff7a"; c.lineWidth = 2.4;
                c.lineJoin = "round"; c.lineCap = "round";
                c.shadowColor = "#39ff7a"; c.shadowBlur = 6 * k;
                c.beginPath();
                // index finger
                c.moveTo(14, 27); c.lineTo(14, 50); c.arc(18, 50, 4, Math.PI, 0, true); c.lineTo(22, 27);
                // curled fingers
                c.moveTo(22, 27); c.lineTo(22, 30); c.quadraticCurveTo(22, 34, 26, 34); c.quadraticCurveTo(30, 34, 30, 30); c.lineTo(30, 27);
                c.moveTo(30, 26); c.lineTo(30, 28); c.quadraticCurveTo(30, 31.5, 33, 31.5); c.quadraticCurveTo(36, 31.5, 36, 28);
                // back of the hand
                c.lineTo(36, 8); c.quadraticCurveTo(36, 5, 33, 5); c.lineTo(12, 5); c.quadraticCurveTo(8, 5, 8, 9); c.lineTo(8, 22);
                // thumb
                c.moveTo(8, 18); c.quadraticCurveTo(2.5, 19, 3.5, 24.5); c.quadraticCurveTo(5, 28.5, 14, 27);
                // cuff
                c.moveTo(10, 1.5); c.lineTo(34, 1.5);
                c.stroke();
            }
        }
        // tap ripple on the handle
        Rectangle {
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.bottom: parent.bottom
            anchors.bottomMargin: -0.55 * unit
            width: 0.6 * unit + sheetHint.bob * 2
            height: width * 0.45
            radius: height / 2
            color: "transparent"
            border.color: swTheme.neonGreen
            border.width: 2
            opacity: 1 - sheetHint.bob / (0.35 * unit) * 0.8
        }
    }

    // Refloat Glow: Tunes / Control / Data live in a pull-up sheet over the
    // full-screen main view. Drag the handle up/down, tap it to open/close.
    // The position is remembered (swSettings.sheetFraction).
    Item {
        id: bottomSheet
        anchors.left: root.left
        anchors.right: root.right
        anchors.bottom: root.bottom
        height: minHeight + (maxHeight - minHeight) * fraction
        z: 5
        clip: true  // collapsed, only the handle peeks out

        Material.accent: swTheme.neonGreen
        Material.foreground: swTheme.color("normalText")
        Material.background: swTheme.color("lightBackground")

        property real handleHeight: 0.75 * unit
        // Refloat Glow: collapses all the way down to just the swipe handle
        property real minHeight: handleHeight + 1
        property real openMinHeight: handleHeight + bottomStackTabs.implicitHeight + bottomLine.implicitHeight + 2
        // Fixed (unit-based) height of everything on the main view except the
        // speedo, which takes what's left. Never read from layout results.
        property real hudFixedHeight: (0.8 + 1.1 + 0.12 + 1.1 + 0.85 + 0.1 + 1.75 + 0.5 + 1.0) * unit + Math.max(hudLeft.contentHeight, pitch.height)
        property real maxHeight: Math.max(openMinHeight, root.height * (bottomStackTabs.currentIndex === 2 ? 0.5 : 0.4))  // up to 2/5 of the screen (1/2 on MIXER)
        property real fraction: 0  // 0 = collapsed, 1 = fully up
        property bool dragging: false

        Behavior on fraction {
            enabled: !bottomSheet.dragging
            NumberAnimation {duration: 220; easing.type: Easing.OutCubic}
        }

        // rf105: always opens on the full home screen (sheet down)
        Component.onCompleted: fraction = 0
        onFractionChanged: if (fraction > 0.1) sheetHint.done = true

        // Refloat Glow: the sheet is "magnetic": it always settles fully up or
        // fully down, whichever is closer when you let go
        function setFraction(f) {
            fraction = f;
            swSettings.sheetFraction = f;
        }

        function open() {
            setFraction(1);
        }

        function toggle() {
            setFraction(fraction < 0.5 ? 1 : 0);
        }

        Rectangle {
            anchors.fill: parent
            color: swTheme.background
            border.color: swTheme.neonPurple
            border.width: 1
            radius: 0.2 * unit

            SwGrid {
                anchors.fill: parent
                anchors.margins: 1
            }
        }

        ColumnLayout {
            anchors.left: parent.left
            anchors.right: parent.right
            anchors.top: parent.top
            anchors.margins: 1
            height: bottomSheet.maxHeight - 2  // full size; the sheet clips it
            spacing: 0

            Item {
                id: sheetHandle
                Layout.fillWidth: true
                Layout.preferredHeight: bottomSheet.handleHeight

                Rectangle {
                    anchors.centerIn: parent
                    width: 1.4 * unit
                    height: 0.12 * unit
                    radius: height / 2
                    color: sheetDrag.pressed ? swTheme.neonGreen : swTheme.neonPurple
                }

                MouseArea {
                    id: sheetDrag
                    anchors.fill: parent
                    preventStealing: true

                    property real startY: 0
                    property real startFraction: 0
                    property bool moved: false

                    onPressed: {
                        startY = mapToItem(mainItem, mouse.x, mouse.y).y;
                        startFraction = bottomSheet.fraction;
                        moved = false;
                        bottomSheet.dragging = true;
                    }

                    onPositionChanged: {
                        var dy = startY - mapToItem(mainItem, mouse.x, mouse.y).y;
                        if (Math.abs(dy) > 0.15 * unit) {
                            moved = true;
                        }
                        var range = bottomSheet.maxHeight - bottomSheet.minHeight;
                        if (moved && range > 0) {
                            bottomSheet.fraction = clamp(startFraction + dy / range, 0, 1);
                        }
                    }

                    onReleased: {
                        bottomSheet.dragging = false;
                        if (!moved) {
                            bottomSheet.toggle();
                            return;
                        }
                        bottomSheet.setFraction(bottomSheet.fraction < 0.5 ? 0 : 1);
                    }

                    onCanceled: {
                        bottomSheet.dragging = false;
                        bottomSheet.setFraction(bottomSheet.fraction < 0.5 ? 0 : 1);
                    }
                }
            }

            TabBar {
                id: bottomStackTabs
                Layout.fillWidth: true
                clip: true

                // Refloat Glow: Neon Future-style tab labels
                component SwTabButton : TabButton {
                    id: swTab
                    font.family: "Exan"
                    font.pixelSize: 0.27 * unit
                    font.letterSpacing: 0.03 * unit

                    // tabs share the bar's width equally; a fixed implicit width keeps
                    // the wrapping label from feeding back into the TabBar's size
                    implicitWidth: 2 * unit
                    // rf108: less side padding so CONTROL keeps a bigger font
                    leftPadding: 0.05 * unit
                    rightPadding: 0.05 * unit

                    contentItem: Text {
                        text: swTab.text
                        font: swTab.font
                        color: swTab.checked ? swTheme.neonGreen : "#c98bff"
                        horizontalAlignment: Text.AlignHCenter
                        verticalAlignment: Text.AlignVCenter
                        // long labels (BOARD STYLE) wrap to two lines before shrinking
                        fontSizeMode: Text.Fit
                        wrapMode: Text.WordWrap
                        maximumLineCount: 2
                        lineHeight: 0.9
                        minimumPixelSize: 0.16 * unit
                        elide: Text.ElideRight
                    }

                    // rf109: the active tab is a rounded neon box with a soft glow
                    background: Rectangle {
                        color: swTab.pressed && !swTab.checked ? "#24123f" : "#0b0718"

                        RectangularGlow {
                            anchors.fill: activeBox
                            visible: swTab.checked
                            glowRadius: 0.12 * unit
                            spread: 0.15
                            cornerRadius: activeBox.radius + glowRadius
                            color: swTheme.neonGreen
                            opacity: 0.55
                        }
                        Rectangle {
                            id: activeBox
                            visible: swTab.checked
                            anchors.fill: parent
                            anchors.margins: 0.07 * unit
                            radius: 0.18 * unit
                            color: "#0e2a1a"
                            border.color: swTheme.neonGreen
                            border.width: 2
                        }

                        // divider between tabs
                        Rectangle {
                            anchors.right: parent.right
                            anchors.verticalCenter: parent.verticalCenter
                            width: 1
                            height: parent.height * 0.5
                            color: swTheme.neonPurple
                            opacity: 0.5
                        }


                    }
                }

                SwTabButton {text: "TUNES"}
                SwTabButton {text: "CONTROL"}
                SwTabButton {text: "MIXER"}
                SwTabButton {text: "DATA"}
                SwTabButton {text: "BOARD STYLE"}
                SwTabButton {text: "LEDS"}

                background: Rectangle {
                    color: "#0b0718"

                    Rectangle {
                        anchors.top: parent.top
                        width: parent.width
                        height: 1
                        color: swTheme.neonPurple
                        opacity: 0.6
                    }

                    Rectangle {
                        anchors.bottom: parent.bottom
                        width: parent.width
                        height: 1
                        color: swTheme.neonPurple
                        opacity: 0.6
                    }
                }

                onCurrentIndexChanged: {
                    bottomStackLayout.currentIndex = currentIndex;
                }
            }

            StackLayout {
                id: bottomStackLayout
                Layout.fillWidth: true
                Layout.fillHeight: true
                clip: true

                Item {
                    id: tunesPage
                    Layout.fillWidth: true
                    Layout.fillHeight: true

                    // Only one tune shows ACTIVE: the last one applied here if it still
                    // matches the board, else the first matching one. (In VESC Tool's
                    // limited mode the board config isn't read, so every tune "matches".)
                    property var tuneDiffs: {
                        var d = [];
                        for (var i = 1; i <= preferences.tuneSlotCount; i++) {
                            d.push(tuneManager.tunes[i] ? packageConfig.diffConfig(tuneManager.tunes[i], true).differs.length : -1);
                        }
                        return d;
                    }
                    property int activeSlot: {
                        var a = swSettings.activeTuneSlot;
                        if (a > 0 && tuneDiffs[a - 1] === 0) return a;
                        for (var i = 0; i < tuneDiffs.length; i++) {
                            if (tuneDiffs[i] === 0) return i + 1;
                        }
                        return 0;
                    }

                    GridLayout {
                        property int spacing: 0.35 * unit  // rf109: bigger tune buttons (was 0.6)
                        anchors.fill: parent
                        anchors.topMargin: spacing
                        anchors.leftMargin: spacing
                        anchors.rightMargin: spacing
                        anchors.bottomMargin: spacing
                        rowSpacing: spacing
                        columnSpacing: spacing
                        columns: (preferences.tuneSlotCount === 2 && height > width * 0.6) ? 1 : 2

                        Repeater {
                            model: preferences.tuneSlotCount

                            Button {
                                id: button
                                Layout.fillWidth: true
                                Layout.fillHeight: true
                                Layout.minimumHeight: Math.max(1.5 * unit, buttonItemHeight + 2 * buttonItemMargin)
                                Layout.columnSpan: (slot === preferences.tuneSlotCount && (slot % 2) === 1) ? 2 : 1

                                property int slot: index + 1

                                property var tuneName: tuneManager.tunes[slot] ? tuneManager.tunes[slot].name : ""
                                property var tuneDiff: tunesPage.tuneDiffs[index] !== undefined ? tunesPage.tuneDiffs[index] : -1
                                property bool active: !!tuneName && tunesPage.activeSlot === slot

                                property real buttonItemHeight: unit
                                property real buttonItemMargin: 0.15 * unit

                                padding: 0
                                leftInset: 0
                                rightInset: 0
                                topInset: 0
                                bottomInset: 0

                                onPressAndHold: {
                                    editTuneDialog.show(slot, tuneName);
                                }

                                onClicked: {
                                    if (tuneName) {
                                        var tune = tuneManager.loadTune(slot);
                                        packageConfig.applyConfig(tune, true);
                                        swSettings.activeTuneSlot = slot;
                                    }
                                }

                                contentItem: Item {
                                    anchors.fill: parent
                                    anchors.margins: parent.buttonItemMargin
                                    clip: true
                                    z: 2

                                    Item {
                                        anchors.centerIn: parent
                                        width: parent.width
                                        height: button.buttonItemHeight

                                        Text {
                                            id: tuneButtonText
                                            width: parent.width
                                            anchors.centerIn: tuneName ? parent : undefined
                                            anchors.top: tuneName ? undefined : parent.top

                                            color: !tuneName ? swTheme.color("disabledText") : button.pressed ? swTheme.background : button.neon
                                            font.family: "Exan"
                                            font.pixelSize: 0.48 * unit
                                            font.letterSpacing: 0.08 * unit
                                            horizontalAlignment: Text.AlignHCenter
                                            fontSizeMode: Text.HorizontalFit
                                            minimumPixelSize: 0.22 * unit
                                            text: (tuneName || "empty slot").toUpperCase()
                                        }

                                        SwDText {
                                            id: tuneButtonHelpText
                                            width: parent.width
                                            anchors.bottom: parent.bottom

                                            font.pixelSize: fontSizeSuperSmall
                                            visible: !tuneName
                                            horizontalAlignment: Text.AlignHCenter
                                            text: "press and hold to set"
                                        }

                                        // shown on the tune that matches the board's current config
                                        Text {
                                            anchors.horizontalCenter: parent.horizontalCenter
                                            anchors.top: tuneButtonText.bottom
                                            visible: button.active
                                            color: button.pressed ? swTheme.background : button.neon
                                            font.family: "Exan"
                                            font.pixelSize: 0.2 * unit
                                            font.letterSpacing: 0.1 * unit
                                            text: "ACTIVE"
                                        }
                                    }

                                    SwDText {
                                        id: tuneButtonDiffCount
                                        anchors.bottom: parent.bottom
                                        anchors.right: parent.right

                                        font.pixelSize: fontSizeSmall
                                        visible: preferences.showTuneDiffCount && tuneDiff > 0
                                        horizontalAlignment: Text.AlignHRight
                                        text: tuneDiff
                                    }
                                }

                                // Refloat Glow: neon slab like the HORN button, in the slot's
                                // chosen color (press and hold > Color). Brighter glow + tinted
                                // core on the active tune; fills solid while pressed.
                                property color neon: swTheme.tuneColor(slot)

                                background: Rectangle {
                                    id: buttonBg
                                    z: 1

                                    radius: 0.3 * unit
                                    border.width: 4  // rf109: bolder outline
                                    border.color: tuneName ? button.neon : swTheme.color("disabledText")
                                    // always opaque, so the glow behind never shows through
                                    // and washes out the name (like the simulator)
                                    color: button.pressed && tuneName ? button.neon : button.active ? Qt.tint("#0b0718", Qt.rgba(button.neon.r, button.neon.g, button.neon.b, 0.18)) : "#0b0718"

                                    Behavior on color {
                                        ColorAnimation {duration: 150}
                                    }

                                    RectangularGlow {
                                        anchors.fill: parent
                                        z: -1
                                        visible: !!button.tuneName
                                        glowRadius: 0.25 * unit
                                        spread: 0.2
                                        cornerRadius: parent.radius + glowRadius
                                        color: button.neon
                                        opacity: button.pressed || button.active ? 0.9 : 0.3
                                    }
                                }
                            }
                        }
                    }

                    FloatingToolButton {
                        id: downloadTunesButton
                        anchors.right: parent.right
                        anchors.top: parent.top
                        strokeColor: swTheme.neonGreen
                        bgColor: swTheme.color("lightBackground")

                        iconPath: Path {
                            PathSvg {path: "M 43 39 L 16 39 M 38.5 32 L 11.5 32 M 34 25 L 7 25 M 25 2 L 25 18 L 33 11 M 25 18 L 17 11"}
                        }

                        onClicked: {
                            tuneArchiveDialog.show();
                        }
                    }
                }

                ScrollView {
                    Layout.fillHeight: true
                    Layout.fillWidth: true
                    contentWidth: availableWidth
                    clip: true

                    Column {
                        anchors.fill: parent
                        anchors.leftMargin: 0.15 * unit
                        anchors.rightMargin: 0.15 * unit
                        spacing: 0.05 * unit

                        Item {
                            width: parent.width
                            height: 0.1 * unit
                        }

                        SwLText {
                            id: movementControlsHeader
                            anchors.horizontalCenter: parent.horizontalCenter

                            // Refloat Glow: section headings in neon green digital font
                            font.pixelSize: 0.38 * unit
                            font.family: "Exan"
                            font.letterSpacing: 0.03 * unit
                            color: swTheme.neonGreen
                            text: "Move"
                        }

                        // Refloat Glow: vertical move slider. Up = forward, down =
                        // backward; same behavior as before (springs back to 0).
                        SwNeonLabel {
                            anchors.horizontalCenter: parent.horizontalCenter
                            color: moveSlider.value > 0 ? swTheme.neonGreen : "#c98bff"
                            text: "FWD"
                        }

                        Slider {
                            id: moveSlider
                            anchors.horizontalCenter: parent.horizontalCenter
                            width: 1.2 * unit
                            height: 3.2 * unit
                            orientation: Qt.Vertical

                            from: -1
                            to: 1
                            value: 0
                        }

                        SwNeonLabel {
                            anchors.horizontalCenter: parent.horizontalCenter
                            color: moveSlider.value < 0 ? swTheme.neonGreen : "#c98bff"
                            text: "REV"
                        }

                        Item {
                            width: parent.width
                            implicitHeight: tiltControlsHeader.implicitHeight + 0.2 * unit
                            anchors.horizontalCenter: parent.horizontalCenter

                            SwLText {
                                id: tiltControlsHeader
                                anchors.centerIn: parent

                                // Refloat Glow: section headings in neon green digital font
                                font.pixelSize: 0.38 * unit
                                font.family: "Exan"
                                font.letterSpacing: 0.03 * unit
                                color: swTheme.neonGreen
                                text: "Tilt"
                            }

                        }

                        Slider {
                            id: tiltSlider
                            width: parent.width * 0.9
                            anchors.horizontalCenter: parent.horizontalCenter

                            enabled: mainItem.tiltUsable  // rf108: engaged and moving
                            opacity: enabled ? 1 : 0.4
                            from: -1
                            to: 1
                            value: 0
                        }

                        SwLText {
                            visible: !mainItem.tiltUsable
                            anchors.horizontalCenter: parent.horizontalCenter
                            font.pixelSize: fontSizeSmall
                            text: "Tilt works while riding (engaged and moving)."
                        }

                        // rf182: DISABLE MOVING FAULTS (Refloat's own setting), between
                        // MOVE / TILT and HORN SETTINGS
                        Item {
                            width: parent.width
                            height: 0.3 * unit
                        }
                        SwNeonLabel {
                            anchors.horizontalCenter: parent.horizontalCenter
                            font.pixelSize: 0.4 * unit
                            font.letterSpacing: 0.05 * unit
                            text: "DISABLE MOVING FAULTS"
                        }
                        SwLText {
                            width: parent.width
                            font.pixelSize: fontSizeNormal
                            wrapMode: Text.WordWrap
                            text: "DMF: lifting your foot off the sensor won't stop the board while you ride forward (Refloat's Disable Moving Faults). Needs correct speed calibration and a tail-heavy board."
                        }
                        SwPill {
                            anchors.horizontalCenter: parent.horizontalCenter
                            minWidth: 3.0 * unit
                            label: dmfCfg.on ? "DMF ON" : "DMF OFF"
                            lit: dmfCfg.on
                            enabledLook: dmfCfg.known
                            onClicked: {
                                if (!dmfCfg.known) { VescIf.emitStatusMessage("Refloat's settings aren't loaded yet", false); return; }
                                if (dmfCfg.on) dmfCfg.set(false); else dmfConfirm.open();
                            }
                        }

                        // rf180: controller BEEPER only in Settings (gear) › RIDE › BEEPER
                        Item {
                            width: parent.width
                            height: 0.3 * unit
                        }

                        // Refloat Glow: horn-only sound settings
                        SwNeonLabel {
                            anchors.horizontalCenter: parent.horizontalCenter

                            font.pixelSize: 0.45 * unit
                            font.letterSpacing: 0.06 * unit
                            text: "HORN SETTINGS"
                        }

                        SwLText {
                            width: parent.width
                            font.pixelSize: fontSizeNormal
                            wrapMode: Text.WordWrap
                            text: "Only for the HORN button (separate from Haptic Feedback). A beep, no motor buzz; while riding only below 60% duty, never over a real warning."
                        }

                        // SIMPLE | ADVANCED
                        Rectangle {
                            anchors.horizontalCenter: parent.horizontalCenter
                            width: 4.6 * unit
                            height: 0.65 * unit
                            radius: height / 2
                            color: "#0b0718"
                            border.color: swTheme.neonPurple
                            border.width: 2

                            Row {
                                anchors.fill: parent
                                anchors.margins: 3

                                Repeater {
                                    model: ["SIMPLE", "ADVANCED"]

                                    Rectangle {
                                        width: parent.width / 2
                                        height: parent.height
                                        radius: height / 2
                                        property bool on: (index === 1) === swSettings.hornAdvanced
                                        color: on ? swTheme.neonGreen : "transparent"

                                        Text {
                                            anchors.centerIn: parent
                                            text: modelData
                                            color: parent.on ? swTheme.background : "#c98bff"
                                            font.family: "Exan"
                                            font.pixelSize: 0.22 * unit
                                        }
                                    }
                                }
                            }

                            MouseArea {
                                anchors.fill: parent
                                onClicked: hornSettingsSender.setAdvanced(mouse.x >= width / 2)
                            }
                        }

                        // simple mode
                        SwStepper {
                            visible: false  // rf75: the horn never adds motor current
                            label: "STRENGTH (buzz, riding only)"
                            value: swSettings.hornSimpleStrength
                            from: 0; to: 10; step: 1
                            valueText: value === 0 ? "OFF" : value + " / 10"
                            onMoved: { swSettings.hornSimpleStrength = newValue; hornSettingsSender.changed(); }
                        }

                        SwStepper {
                            visible: !swSettings.hornAdvanced
                            label: "VOLUME (beep loudness)"
                            value: swSettings.hornSimpleVolume
                            from: 1; to: 10; step: 1
                            valueText: value + " / 10"
                            onMoved: { swSettings.hornSimpleVolume = newValue; hornSettingsSender.changed(); }
                        }

                        SwStepper {
                            visible: !swSettings.hornAdvanced
                            label: "PITCH (low - high)"
                            value: swSettings.hornSimplePitch
                            from: 1; to: 10; step: 1
                            valueText: value + " / 10"
                            onMoved: { swSettings.hornSimplePitch = newValue; hornSettingsSender.changed(); }
                        }

                        // advanced mode
                        SwStepper {
                            visible: swSettings.hornAdvanced
                            label: "BEEP STRENGTH"
                            value: Math.min(4, swSettings.hornBeepStrength)
                            from: 0.4; to: 4; step: 0.2; decimals: 1; suffix: " V"
                            onMoved: { swSettings.hornBeepStrength = newValue; hornSettingsSender.changed(); }
                        }

                        SwStepper {
                            visible: swSettings.hornAdvanced
                            label: "BEEP PITCH"
                            value: swSettings.hornBeepFreq
                            from: 300; to: 1000; step: 25; suffix: " Hz"
                            onMoved: { swSettings.hornBeepFreq = newValue; hornSettingsSender.changed(); }
                        }

                        SwStepper {
                            visible: false  // rf75: the horn never adds motor current
                            label: "BUZZ STRENGTH (riding)"
                            value: swSettings.hornBuzzStrength
                            from: 0; to: 15; step: 1; suffix: " A"
                            onMoved: { swSettings.hornBuzzStrength = newValue; hornSettingsSender.changed(); }
                        }

                        SwStepper {
                            visible: false  // rf75: the horn never adds motor current
                            label: "BUZZ FREQ (riding)"
                            value: swSettings.hornBuzzFreq
                            from: 30; to: 150; step: 5; suffix: " Hz"
                            onMoved: { swSettings.hornBuzzFreq = newValue; hornSettingsSender.changed(); }
                        }

                        // boot melody: OFF / DEFAULT / CUSTOM, CUSTOM MELODY editor, TEST
                        SwNeonLabel {
                            anchors.horizontalCenter: parent.horizontalCenter
                            font.pixelSize: 0.3 * unit
                            text: "BOOT MELODY"
                        }

                        Row {
                            anchors.horizontalCenter: parent.horizontalCenter
                            spacing: 0.2 * unit

                            SwPill {
                                label: "OFF"
                                lit: !swSettings.hornBootMelody
                                onClicked: { swSettings.hornBootMelody = false; hornSettingsSender.send(); }
                            }

                            SwPill {
                                label: "DEFAULT"
                                lit: swSettings.hornBootMelody && !swSettings.hornBootCustom
                                onClicked: { swSettings.hornBootMelody = true; swSettings.hornBootCustom = false; hornSettingsSender.send(); }
                            }

                            SwPill {
                                label: "CUSTOM"
                                lit: swSettings.hornBootMelody && swSettings.hornBootCustom
                                onClicked: { swSettings.hornBootMelody = true; swSettings.hornBootCustom = true; hornSettingsSender.send(); }
                            }
                        }

                        SwStepper {
                            visible: swSettings.hornBootMelody
                            label: "MELODY VOLUME / INTENSITY"
                            value: swSettings.bootMelodyVolume
                            from: 1; to: 10; step: 1
                            valueText: value + " / 10"
                            onMoved: { swSettings.bootMelodyVolume = newValue; hornSettingsSender.changed(); }
                        }

                        SwLText {
                            anchors.horizontalCenter: parent.horizontalCenter
                            visible: swSettings.hornBootMelody
                            font.pixelSize: fontSizeSmall
                            color: "#c98bff"
                            text: "10 / 10 is about 60% of the horn's top volume, so it stays gentle on the motor"
                        }

                        // which custom melody is in use (the list lives in MY MELODIES)
                        SwLText {
                            anchors.horizontalCenter: parent.horizontalCenter
                            visible: swSettings.hornBootMelody && swSettings.hornBootCustom
                            font.pixelSize: fontSizeSmall
                            color: "#c98bff"
                            text: {
                                swSettings.melodyRec;  // re-evaluate when the melody changes
                                var n = melodyLib.currentName();
                                return "Custom: " + (n.length ? n : "unsaved recording");
                            }
                        }

                        Row {
                            id: ctlMelodyRow  // rf166: Onboarding Tour target
                            anchors.horizontalCenter: parent.horizontalCenter
                            spacing: 0.2 * unit

                            SwPill {
                                label: "MY MELODIES" + (melodyLib.items.length ? " (" + melodyLib.items.length + ")" : "")
                                onClicked: myMelodiesPopup.open()
                            }

                            SwPill {
                                label: "RECORD \u266A"
                                onClicked: melodyPad.startRecording()
                            }

                            SwPill {
                                label: "TEST"
                                enabledLook: state.pkgState === state.s_Ready
                                onClicked: {
                                    if (state.pkgState === state.s_Ready) {
                                        hornSettingsSender.playMelody(swSettings.hornBootCustom);
                                    } else {
                                        VescIf.emitStatusMessage("Melody test works when the board is idle (READY)", false);
                                    }
                                }
                            }
                        }

                        Rectangle {
                            anchors.horizontalCenter: parent.horizontalCenter
                            width: 3.2 * unit
                            height: 0.7 * unit
                            radius: height / 2
                            color: resetHornMouse.pressed ? swTheme.neonPurple : "transparent"
                            border.color: swTheme.neonPurple
                            border.width: 2

                            Text {
                                anchors.centerIn: parent
                                text: "RESET HORN"
                                color: resetHornMouse.pressed ? swTheme.background : swTheme.neonPurple
                                font.family: "Exan"
                                font.pixelSize: 0.26 * unit
                            }

                            MouseArea {
                                id: resetHornMouse
                                anchors.fill: parent
                                onClicked: {
                                    swSettings.hornBeepStrength = 2.5;
                                    swSettings.hornBeepFreq = 495;
                                    swSettings.hornBuzzStrength = 8;
                                    swSettings.hornBuzzFreq = 70;
                                    swSettings.hornSimpleStrength = 5;
                                    swSettings.hornSimpleVolume = 5;
                                    swSettings.hornSimplePitch = 3;
                                    swSettings.bootMelodyVolume = 6;
                                    hornSettingsSender.send();
                                    VescIf.emitStatusMessage("Horn settings reset", true);
                                }
                            }
                        }

                        Item {
                            width: parent.width
                            height: 0.3 * unit
                        }

                        SwNeonLabel {
                            anchors.horizontalCenter: parent.horizontalCenter

                            font.pixelSize: 0.45 * unit
                            font.letterSpacing: 0.06 * unit
                            text: "MAGIC FLYWHEEL"
                        }

                        SwLText {
                            width: parent.width
                            font.pixelSize: fontSizeNormal
                            wrapMode: Text.WordWrap
                            text: "Before enabling flywheel mode make sure that your board is nose up and perfectly balanced. To turn it off, you must disengage the board first."
                        }

                        // Refloat Glow: Neon Future flywheel switch. Purple when off; neon
                        // green, glowing and filled while flywheel mode is running.
                        Button {
                            id: flywheelOnButton
                            anchors.horizontalCenter: parent.horizontalCenter
                            width: 4.2 * unit
                            height: 1.1 * unit
                            padding: 0
                            leftInset: 0
                            rightInset: 0
                            topInset: 0
                            bottomInset: 0

                            property bool spinning: state.pkgMode === state.m_Flywheel
                            property color neon: spinning ? swTheme.neonGreen : swTheme.neonPurple

                            enabled: [state.m_Normal, state.m_Flywheel].includes(state.pkgMode)
                            opacity: enabled ? 1 : 0.4
                            text: spinning ? "FLYWHEEL OFF" : "FLYWHEEL ON"
                            onClicked: {
                                commands.sendFlywheel(state.pkgMode === state.m_Normal);
                            }

                            contentItem: Text {
                                text: flywheelOnButton.text
                                color: flywheelOnButton.pressed ? swTheme.background : flywheelOnButton.neon
                                font.family: "Exan"
                                font.pixelSize: 0.36 * unit
                                font.letterSpacing: 0.08 * unit
                                horizontalAlignment: Text.AlignHCenter
                                verticalAlignment: Text.AlignVCenter
                                fontSizeMode: Text.HorizontalFit
                                minimumPixelSize: 0.2 * unit
                            }

                            background: Rectangle {
                                radius: 0.3 * unit
                                color: flywheelOnButton.pressed ? flywheelOnButton.neon : flywheelOnButton.spinning ? "#0e2a1a" : "#140a26"
                                border.color: flywheelOnButton.neon
                                border.width: 3

                                RectangularGlow {
                                    anchors.fill: parent
                                    z: -1
                                    glowRadius: 0.25 * unit
                                    spread: 0.2
                                    cornerRadius: parent.radius + glowRadius
                                    color: flywheelOnButton.neon
                                    opacity: flywheelOnButton.spinning || flywheelOnButton.pressed ? 0.9 : 0.3
                                }
                            }
                        }

                        // rf96: MAX SPEED tucked away at the bottom of CONTROL; the
                        // terms must be accepted each time before it opens
                        Item { width: parent.width; height: 0.4 * unit }
                        Text {
                            anchors.horizontalCenter: parent.horizontalCenter
                            text: maxSpeed.shown ? "\u26A0 MAX SPEED LIMIT: %1 %2 \u203A".arg(Math.round(maxSpeed.capKmh * vescConfig.imperialFactor)).arg(vescConfig.speedUnit.toUpperCase())
                                                 : "Max speed limiter \u203A"
                            color: maxSpeed.shown ? "#FFB300" : "#5c5470"
                            font.family: maxSpeed.shown ? "Exan" : font.family
                            font.pixelSize: 0.2 * unit
                            MouseArea {
                                anchors.fill: parent
                                anchors.margins: -0.2 * unit
                                onClicked: maxSpeedTerms.open()
                            }
                        }

                        Item {
                            width: parent.width
                            height: 0.1 * unit
                        }
                    }
                }

                // Refloat Glow: MIXER tab - tile keyboard, real notes E4 ... G5 (white keys).
                // LIVE mode: tap / hold a tile and the board plays that note live.
                // REC mode (like making a custom vibration on iOS): the first tap
                // starts a 4 s recording, a playhead sweeps across the timeline at a
                // steady rate, and every tap is placed where it happened, so the gaps
                // between taps become rests. It stops by itself at 4 s. A held tile
                // stops at 2 s, like the horn (also enforced on the board). The board
                // only makes sound while idle (READY). The CONTROL tab's CUSTOM MELODY
                // button opens this tab in REC mode.
                Item {
                    id: melodyPad
                    Layout.fillWidth: true
                    Layout.fillHeight: true

                    property bool recording: false  // REC mode
                    property bool armed: false  // REC: waiting for the first tap
                    property bool capturing: false  // REC: a take is running
                    readonly property int windowMs: 4000
                    readonly property int maxNoteMs: 2000
                    readonly property int maxEntries: 64  // notes + rests the board holds
                    property var notes: hornSettingsSender.notes()
                    property var events: []  // this take: [level, startMs, endMs]
                    property double recStart: 0
                    property int recMs: 0
                    property int holdLevel: 0
                    property double holdStart: 0
                    property int holdMs: 0
                    property double playStart: 0
                    property int playMs: -1  // playhead while PLAY runs, -1 = off
                    property int totalMs: {
                        var t = 0;
                        for (var i = 0; i < notes.length; i++) t += notes[i][1];
                        return t;
                    }

                    readonly property var noteNames: ["E4", "F4", "G4", "A4", "B4", "C5", "D5", "E5", "F5", "G5"]

                    readonly property int beepLevel: 11  // rf133: a controller beep step
                    readonly property int beepMs: 200

                    // rf133: BEEP: the controller's own beeper now; in REC it's also
                    // placed in the take like a tile tap (the board beeps there on playback)
                    function beep() {
                        release();
                        if (recording && armed && !capturing) {
                            capturing = true;
                            recStart = Date.now();
                            recMs = 0;
                            events = [];
                            playMs = -1;
                            recTimer.start();
                        }
                        if (capturing) {
                            var s = Date.now() - recStart;
                            var e = Math.min(s + beepMs, windowMs);
                            if (e - s >= 40) {
                                var ev = events.slice();
                                ev.push([beepLevel, s, e]);
                                events = ev;
                            }
                        }
                        ledSender.testCtrlBeep();
                        if (!ledSender.ctrlBeep)
                            VescIf.emitStatusMessage("Controller beeper is off (Settings \u203A RIDE \u203A BEEPER): the beep is silent", false);
                    }

                    function tileColor(level) {
                        if (level === beepLevel) return "#ff8a1f";  // rf133: beep step
                        // purple (low) -> green (high)
                        var f = (level - 1) / 9;
                        return Qt.rgba(0.69 * (1 - f) + 0.22 * f, 0.30 * (1 - f) + 1.0 * f, 1.0 * (1 - f) + 0.48 * f, 1);
                    }

                    function store(n) {
                        swSettings.melodyRec = JSON.stringify(n);
                        hornSettingsSender.sendMelody();
                    }

                    function setRec(on) {
                        release();
                        stopTake();
                        recording = on;
                        armed = on && notes.length === 0;
                    }

                    function startRecording() {
                        setRec(true);
                        bottomStackTabs.currentIndex = 2;
                        bottomSheet.open();
                    }

                    function press(level) {
                        release();
                        if (recording && armed && !capturing) {
                            capturing = true;
                            recStart = Date.now();
                            recMs = 0;
                            events = [];
                            playMs = -1;
                            recTimer.start();
                        }
                        holdLevel = level;
                        holdStart = Date.now();
                        holdMs = 0;
                        hornSettingsSender.liveTone(level);
                        holdTimer.start();
                    }

                    function release() {
                        if (holdLevel === 0) return;
                        holdTimer.stop();
                        hornSettingsSender.liveTone(0);
                        if (capturing) {
                            var s = holdStart - recStart;
                            var e = Math.min(Date.now() - recStart, s + maxNoteMs, windowMs);
                            if (e - s >= 40) {
                                var ev = events.slice();
                                ev.push([holdLevel, s, e]);
                                events = ev;
                            }
                        }
                        holdLevel = 0;
                        holdMs = 0;
                    }

                    // events -> [[level, ms], ...] with rests (level 0) for the gaps
                    function build(ev) {
                        var out = [], cursor = 0;
                        for (var i = 0; i < ev.length && out.length < maxEntries - 1; i++) {
                            var s = Math.round(ev[i][1] / 20) * 20;
                            var e = Math.round(ev[i][2] / 20) * 20;
                            if (s - cursor >= 40) {
                                out.push([0, s - cursor]);
                            } else {
                                s = cursor;
                            }
                            var len = Math.min(maxNoteMs, Math.max(60, e - s), windowMs - s);
                            if (len < 40) break;
                            out.push([ev[i][0], len]);
                            cursor = s + len;
                        }
                        return out;
                    }

                    function stopTake() {
                        recTimer.stop();
                        capturing = false;
                    }

                    function finish() {
                        release();
                        stopTake();
                        armed = false;
                        recMs = windowMs;
                        if (events.length > 0) {
                            store(build(events));
                        } else {
                            armed = true;
                        }
                    }

                    // timeline blocks: [level, startMs, endMs]
                    function blocks() {
                        if (capturing) {
                            var b = events.slice();
                            if (holdLevel > 0) {
                                var s = holdStart - recStart;
                                b.push([holdLevel, s, Math.min(recMs, s + maxNoteMs)]);
                            }
                            return b;
                        }
                        if (armed) return [];
                        var out = [], t = 0;
                        for (var i = 0; i < notes.length; i++) {
                            if (notes[i][0] > 0) out.push([notes[i][0], t, t + notes[i][1]]);
                            t += notes[i][1];
                        }
                        return out;
                    }

                    onVisibleChanged: if (!visible) { release(); if (capturing) finish(); }

                    Timer {
                        id: holdTimer
                        interval: 100
                        repeat: true
                        onTriggered: {
                            melodyPad.holdMs = Date.now() - melodyPad.holdStart;
                            if (melodyPad.holdMs >= melodyPad.maxNoteMs) {
                                melodyPad.release();  // 2 s per note, like the horn
                            } else {
                                hornSettingsSender.liveTone(melodyPad.holdLevel);  // keepalive
                            }
                        }
                    }

                    Timer {
                        id: recTimer
                        interval: 30
                        repeat: true
                        onTriggered: {
                            melodyPad.recMs = Date.now() - melodyPad.recStart;
                            if (melodyPad.recMs >= melodyPad.windowMs) {
                                melodyPad.finish();
                            }
                        }
                    }

                    Timer {
                        id: playTimer
                        interval: 30
                        repeat: true
                        onTriggered: {
                            melodyPad.playMs = Date.now() - melodyPad.playStart;
                            if (melodyPad.playMs >= melodyPad.totalMs) {
                                melodyPad.playMs = -1;
                                stop();
                            }
                        }
                    }

                    ColumnLayout {
                        anchors.fill: parent
                        anchors.margins: 0.2 * unit
                        spacing: 0.12 * unit

                        // mode: LIVE (play only) or REC (record the boot melody)
                        RowLayout {
                            id: mixerModeRow  // rf166: Onboarding Tour target
                            Layout.fillWidth: true
                            spacing: 0.15 * unit

                            SwPill {
                                label: "LIVE"
                                minWidth: 1.4 * unit  // rf150: the row must fit a phone
                                lit: !melodyPad.recording
                                onClicked: melodyPad.setRec(false)
                            }

                            SwPill {
                                label: "● REC"
                                minWidth: 1.4 * unit  // rf150: the row must fit a phone
                                lit: melodyPad.recording
                                onClicked: melodyPad.setRec(true)
                            }

                            // rf133: the controller beeper; recorded in REC
                            SwPill {
                                label: "\u266A BEEP"
                                minWidth: 1.4 * unit  // rf150: the row must fit a phone
                                lit: true
                                litColor: "#ff8a1f"  // rf134: orange, like its timeline marks
                                onClicked: melodyPad.beep()
                            }

                            // rf149: tile labels, tap to cycle: BLANK -> NOTES -> 123
                            SwPill {
                                label: ["BLANK", "NOTES", "123"][swSettings.mixerLabels]
                                minWidth: 1.4 * unit  // rf150: the row must fit a phone
                                lit: swSettings.mixerLabels !== 0
                                onClicked: swSettings.mixerLabels = (swSettings.mixerLabels + 1) % 3
                            }

                            // rf150: the hint takes what's left (shortened with "..."), so
                            // the row never gets wider than the screen
                            SwNeonLabel {
                                Layout.fillWidth: true
                                Layout.minimumWidth: 0
                                horizontalAlignment: Text.AlignRight
                                elide: Text.ElideRight
                                color: melodyPad.capturing ? "#ff4d6d" : "#c98bff"
                                font.pixelSize: 0.24 * unit
                                text: !melodyPad.recording
                                    ? (state.pkgState === state.s_Ready ? "TAP TO PLAY" : "BOARD PLAYS WHEN IDLE")
                                    : melodyPad.capturing
                                    ? "● REC  %1 / 4.0 s".arg((melodyPad.recMs / 1000).toFixed(1))
                                    : melodyPad.armed
                                    ? "TAP A TILE TO START"
                                    : "%1 s MELODY".arg((melodyPad.totalMs / 1000).toFixed(1))
                            }
                        }

                        // timeline: 4 s wide; notes sit where they were played, a
                        // playhead moves across while recording / playing
                        Rectangle {
                            id: timelineBox
                            visible: melodyPad.recording
                            Layout.fillWidth: true
                            Layout.preferredHeight: 0.6 * unit
                            color: "#140a26"
                            radius: 0.1 * unit
                            border.color: melodyPad.capturing ? "#ff4d6d" : "#3d2266"

                            Item {
                                id: timeline
                                anchors.fill: parent
                                anchors.margins: 3

                                // 1 s grid marks
                                Repeater {
                                    model: 3

                                    Rectangle {
                                        x: timeline.width * (index + 1) / 4
                                        width: 1
                                        height: timeline.height
                                        color: "#3d2266"
                                    }
                                }

                                Repeater {
                                    model: {
                                        melodyPad.recMs; melodyPad.holdMs; melodyPad.events; melodyPad.notes; melodyPad.armed;
                                        return melodyPad.blocks();
                                    }

                                    Rectangle {
                                        x: timeline.width * modelData[1] / melodyPad.windowMs
                                        width: Math.max(3, timeline.width * (modelData[2] - modelData[1]) / melodyPad.windowMs - 1)
                                        height: timeline.height
                                        radius: 3
                                        color: melodyPad.tileColor(modelData[0])

                                        Text {
                                            anchors.centerIn: parent
                                            visible: parent.width > 0.4 * unit
                                            text: modelData[0] === melodyPad.beepLevel ? "\u266A" : melodyPad.noteNames[modelData[0] - 1].charAt(0)
                                            color: swTheme.background
                                            font.family: "Exan"
                                            font.pixelSize: 0.22 * unit
                                        }
                                    }
                                }

                                // playhead
                                Rectangle {
                                    visible: melodyPad.capturing || melodyPad.playMs >= 0
                                    x: timeline.width * Math.min(1, (melodyPad.capturing ? melodyPad.recMs : melodyPad.playMs) / melodyPad.windowMs) - 1
                                    y: -2
                                    width: 2
                                    height: timeline.height + 4
                                    color: melodyPad.capturing ? "#ff4d6d" : swTheme.neonGreen
                                }
                            }
                        }

                        // tiles: notes E4 (low) ... G5 (high), two rows for thumbs
                        GridLayout {
                            id: mixerGrid  // rf166: Onboarding Tour target
                            Layout.fillWidth: true
                            Layout.fillHeight: true
                            columns: 5
                            rowSpacing: 0.15 * unit
                            columnSpacing: 0.15 * unit

                            Repeater {
                                model: 10

                                Rectangle {
                                    Layout.fillWidth: true
                                    Layout.fillHeight: true
                                    property int level: index + 1
                                    property bool held: melodyPad.holdLevel === level
                                    radius: 0.2 * unit
                                    color: held ? melodyPad.tileColor(level) : "#140a26"
                                    border.color: melodyPad.tileColor(level)
                                    border.width: 3
                                    // rf85: blank tiles; rf149: NOTES = note names, 123 = numbers
                                    Text {
                                        visible: swSettings.mixerLabels !== 0
                                        anchors.centerIn: parent
                                        text: swSettings.mixerLabels === 2 ? String(parent.level)
                                            : melodyPad.noteNames[parent.level - 1].charAt(0) + "<font size=\"2\">" + melodyPad.noteNames[parent.level - 1].charAt(1) + "</font>"
                                        textFormat: Text.StyledText
                                        color: parent.held ? swTheme.background : melodyPad.tileColor(parent.level)
                                        font.family: "Exan"
                                        font.pixelSize: 0.5 * unit
                                    }

                                    MouseArea {
                                        anchors.fill: parent
                                        onPressed: melodyPad.press(parent.level)
                                        onReleased: melodyPad.release()
                                        onCanceled: melodyPad.release()
                                    }
                                }
                            }
                        }

                        Row {
                            id: mixerActRow  // rf166: Onboarding Tour target
                            visible: melodyPad.recording
                            Layout.alignment: Qt.AlignHCenter
                            spacing: 0.12 * unit

                            SwPill {
                                minWidth: 1.7 * unit
                                label: melodyPad.capturing ? "■ STOP" : "CLEAR"
                                lit: melodyPad.capturing
                                onClicked: {
                                    if (melodyPad.capturing) {
                                        melodyPad.finish();
                                    } else {
                                        // ready for a new take (the current melody stays until it's recorded)
                                        melodyPad.release();
                                        melodyPad.events = [];
                                        melodyPad.recMs = 0;
                                        melodyPad.armed = true;
                                    }
                                }
                            }

                            SwPill {
                                minWidth: 1.7 * unit
                                label: "PLAY"
                                enabledLook: !melodyPad.capturing && !melodyPad.armed && melodyPad.notes.length > 0 && state.pkgState === state.s_Ready
                                onClicked: {
                                    if (melodyPad.capturing || melodyPad.armed || !melodyPad.notes.length) return;
                                    if (state.pkgState === state.s_Ready) {
                                        hornSettingsSender.playMelody(true);
                                        melodyPad.playStart = Date.now();
                                        melodyPad.playMs = 0;
                                        playTimer.restart();
                                    } else {
                                        VescIf.emitStatusMessage("Melody plays when the board is idle (READY)", false);
                                    }
                                }
                            }

                            SwPill {
                                minWidth: 1.7 * unit
                                label: "SAVE"
                                enabledLook: !melodyPad.capturing && !melodyPad.armed && melodyPad.notes.length > 0
                                onClicked: {
                                    if (!melodyPad.capturing && !melodyPad.armed && melodyPad.notes.length > 0) saveMelodyDialog.show();
                                }
                            }

                            SwPill {
                                minWidth: 1.7 * unit
                                label: "DONE"
                                lit: !melodyPad.capturing
                                enabledLook: !melodyPad.capturing
                                onClicked: {
                                    if (melodyPad.capturing) return;
                                    if (!melodyPad.armed && melodyPad.notes.length > 0) {
                                        swSettings.hornBootMelody = true;
                                        swSettings.hornBootCustom = true;
                                        hornSettingsSender.send();
                                        VescIf.emitStatusMessage("Custom melody set as boot melody", true);
                                    }
                                    melodyPad.setRec(false);
                                }
                            }
                        }

                        SwLText {
                            visible: melodyPad.recording
                            Layout.fillWidth: true
                            horizontalAlignment: Text.AlignHCenter
                            font.pixelSize: fontSizeSmall
                            wrapMode: Text.WordWrap
                            text: (melodyPad.capturing
                                ? "Recording... tap the tiles. It stops by itself at 4 s."
                                : melodyPad.armed
                                ? "Your first tap starts a 4 s recording. Gaps between taps are kept; each note stops at 2 s."
                                : "PLAY to hear it, SAVE to keep it, DONE to use it at boot. CLEAR to record again.")
                                + (state.pkgState === state.s_Ready ? "" : " (The board plays notes only when idle.)")
                        }
                    }
                }

                Item {
                    Layout.fillWidth: true
                    Layout.fillHeight: true

                    // Refloat Glow: GRAPH / TEXT switch for the live data
                    Rectangle {
                        id: toggleDataPlotButton
                        anchors.top: parent.top
                        anchors.right: parent.right
                        anchors.topMargin: 0.08 * unit
                        anchors.rightMargin: 0.1 * unit
                        z: 1
                        width: 2.8 * unit
                        height: 0.6 * unit
                        radius: height / 2
                        color: "#0b0718"
                        border.color: swTheme.neonPurple
                        border.width: 2

                        property bool value: true  // true = graph

                        Row {
                            anchors.fill: parent
                            anchors.margins: 3

                            Repeater {
                                model: ["GRAPH", "TEXT"]

                                Rectangle {
                                    width: parent.width / 2
                                    height: parent.height
                                    radius: height / 2
                                    property bool on: (index === 0) === toggleDataPlotButton.value
                                    color: on ? swTheme.neonGreen : "transparent"

                                    Text {
                                        anchors.centerIn: parent
                                        text: modelData
                                        color: parent.on ? swTheme.background : "#c98bff"
                                        font.family: "Exan"
                                        font.pixelSize: 0.22 * unit
                                    }
                                }
                            }
                        }

                        MouseArea {
                            anchors.fill: parent
                            onClicked: toggleDataPlotButton.value = mouse.x < width / 2
                        }
                    }

                    ScrollView {
                        anchors.fill: parent
                        contentWidth: availableWidth
                        clip: true
                        visible: !toggleDataPlotButton.value

                        Column {
                            id: debugColumn
                            anchors.fill: parent
                            anchors.leftMargin: 0.15 * unit
                            anchors.rightMargin: 0.15 * unit
                            spacing: 5

                            property real itemWidth: width * 0.5
                            property real labelWidth: itemWidth * 0.7

                            component Value : Item {
                                implicitHeight: label.implicitHeight
                                implicitWidth: debugColumn.itemWidth

                                property string label
                                property string value
                                property string unit: ""

                                SwNText {
                                    id: label
                                    width: debugColumn.labelWidth
                                    anchors.left: parent.left
                                    anchors.top: parent.top
                                    font.pixelSize: fontSizeNormal
                                    text: "%1:".arg(parent.label)
                                }

                                SwLText {
                                    anchors.left: label.right
                                    anchors.top: parent.top
                                    font.pixelSize: fontSizeNormal
                                    text: parent.value + parent.unit
                                }
                            }

                            Item {
                                width: parent.width
                                height: 0.8 * unit  // room for the GRAPH / TEXT switch
                            }

                            // Refloat Glow: live core values as plain text
                            Row {
                                width: parent.width

                                Column {
                                    width: parent.width / 2
                                    spacing: 5
                                    clip: true

                                    Value {label: "Speed"; unit: " " + vescConfig.speedUnit; value: toFixed1Zero(Math.abs(state.rtData["motor.speed"]) * vescConfig.imperialFactor);}
                                    Value {label: "ERPM"; value: round(state.rtData["motor.erpm"]);}
                                    Value {label: "Duty"; unit: "%"; value: toFixed1Zero(state.rtData["motor.duty_cycle"] * 100);}
                                    Value {label: "Motor current"; unit: "A"; value: toFixed1Zero(state.rtData["motor.current"]);}
                                    Value {label: "Battery current"; unit: "A"; value: toFixed1Zero(state.rtData["motor.batt_current"]);}
                                    Value {label: "Battery voltage"; unit: "V"; value: toFixed1Zero(state.rtData["motor.batt_voltage"]);}
                                    Value {label: "Motor temp"; unit: swSettings.tempF ? "°F" : "°C"; value: toFixed1Zero(swSettings.tempF ? state.rtData["motor.motor_temp"] * 1.8 + 32 : state.rtData["motor.motor_temp"]);}
                                    Value {label: "ESC temp"; unit: swSettings.tempF ? "°F" : "°C"; value: toFixed1Zero(swSettings.tempF ? state.rtData["motor.mosfet_temp"] * 1.8 + 32 : state.rtData["motor.mosfet_temp"]);}
                                }

                                Column {
                                    width: parent.width / 2
                                    spacing: 5
                                    clip: true

                                    Value {label: "Pitch"; unit: "°"; value: toFixed1Zero(state.rtData["imu.pitch"]);}
                                    Value {label: "Balance pitch"; unit: "°"; value: toFixed1Zero(state.rtData["imu.balance_pitch"]);}
                                    Value {label: "Roll"; unit: "°"; value: toFixed1Zero(state.rtData["imu.roll"]);}
                                    Value {label: "Setpoint"; unit: "°"; value: toFixed1Zero(state.rtData["setpoint"]);}
                                    Value {label: "ADC1"; unit: "V"; value: toFixed2Zero(state.rtData["footpad.adc1"]);}
                                    Value {label: "ADC2"; unit: "V"; value: toFixed2Zero(state.rtData["footpad.adc2"]);}
                                    Value {label: "Wheelslip"; value: state.wheelslip ? "YES" : "no";}
                                }
                            }

                            Rectangle {
                                width: parent.width
                                height: 1
                                color: swTheme.neonPurple
                                opacity: 0.4
                            }

                            Row {
                                width: parent.width

                                Column {
                                    width: parent.width / 2
                                    spacing: 5
                                    clip: true

                                    Value {label: "Requested current"; unit: "A"; value: toFixed2Zero(state.rtData["balance_current"]);}
                                    Value {label: "Filtered current"; unit: "A"; value: toFixed2Zero(state.rtData["motor.filt_current"]);}
                                    Value {label: "ATR Accel. diff."; value: toFixed2Zero(state.rtData["atr.accel_diff"]);}
                                    Value {label: "ATR Speed Boost"; unit: "%"; value: round(state.rtData["atr.speed_boost"] * 100);}
                                    Value {label: "Booster current"; unit: "A"; value: toFixed2Zero(state.rtData["booster.current"]);}
                                    Value {label: "Remote input"; unit: "%"; value: round(state.rtData["remote.input"] * 100);}
                                }

                                Column {
                                    width: parent.width / 2
                                    spacing: 5
                                    clip: true

                                    Value {label: "ATR setpoint"; unit: "°"; value: toFixed2Zero(state.rtData["atr.setpoint"]);}
                                    Value {label: "Brake Tilt setpoint"; unit: "°"; value: toFixed2Zero(state.rtData["brake_tilt.setpoint"]);}
                                    Value {label: "Torque Tilt setpoint"; unit: "°"; value: toFixed2Zero(state.rtData["torque_tilt.setpoint"]);}
                                    Value {label: "Turn Tilt setpoint"; unit: "°"; value: toFixed2Zero(state.rtData["turn_tilt.setpoint"]);}
                                    Value {label: "Remote Tilt setpoint"; unit: "°"; value: toFixed2Zero(state.rtData["remote.setpoint"]);}
                                }
                            }

                            Item {
                                width: parent.width
                                height: 0.1 * unit
                            }
                        }
                    }

                    Plot {
                        id: rtPlot
                        anchors.fill: parent
                        visible: toggleDataPlotButton.value
                        neon: true

                        followEnd: true
                        maxWindowMinutes: preferences.plotMaxWindowMinutes

                        showRecordDownload: state.capDataRecord

                        plotData: PlotData {
                            id: rtPlotData
                            seriesMetaData: plotSeriesMetaData
                            seriesExtraColors: plotSeriesExtraColors
                        }

                        Connections {
                            target: state

                            function onCommsInitialized() {
                                rtPlotData.init(state.rtDataAllItems, state.ticksPerSecond);
                                rtPlot.init(state.ticksPerSecond);
                            }
                        }
                    }
                }

                // Refloat Glow: Board Style - looks of the side / front views only
                ScrollView {
                    id: styleTabPage  // rf166: Onboarding Tour target
                    Layout.fillHeight: true
                    Layout.fillWidth: true
                    contentWidth: availableWidth
                    clip: true

                    Column {
                        anchors.fill: parent
                        anchors.leftMargin: 0.15 * unit
                        anchors.rightMargin: 0.15 * unit
                        spacing: 0.15 * unit

                        Item {
                            width: parent.width
                            height: 0.1 * unit
                        }

                        SwLText {
                            anchors.horizontalCenter: parent.horizontalCenter

                            // Refloat Glow: section headings in neon green digital font
                            font.pixelSize: 0.38 * unit
                            font.family: "Exan"
                            font.letterSpacing: 0.03 * unit
                            color: swTheme.neonGreen
                            text: "Rails"
                        }

                        // Refloat Glow: rail shape for the side view
                        Row {
                            anchors.horizontalCenter: parent.horizontalCenter
                            spacing: 0.12 * unit

                            Repeater {
                                model: ["STRAIGHT", "WTF", "ATOM"]

                                Rectangle {
                                    width: 2.5 * unit
                                    height: 0.75 * unit
                                    radius: height / 2
                                    property bool selected: swSettings.railStyle === index
                                    color: selected ? swTheme.neonGreen : "transparent"
                                    border.color: selected ? swTheme.neonGreen : swTheme.neonPurple
                                    border.width: 2

                                    Text {
                                        anchors.centerIn: parent
                                        text: modelData
                                        color: parent.selected ? swTheme.background : swTheme.neonPurple
                                        font.family: "Exan"
                                        font.pixelSize: 0.28 * unit
                                    }

                                    MouseArea {
                                        anchors.fill: parent
                                        onClicked: swSettings.railStyle = index
                                    }
                                }
                            }
                        }

                        SwLText {
                            anchors.horizontalCenter: parent.horizontalCenter

                            // Refloat Glow: section headings in neon green digital font
                            font.pixelSize: 0.38 * unit
                            font.family: "Exan"
                            font.letterSpacing: 0.03 * unit
                            color: swTheme.neonGreen
                            text: "Tire"
                        }

                        // Refloat Glow: tire style for the side and front views
                        Row {
                            anchors.horizontalCenter: parent.horizontalCenter
                            spacing: 0.12 * unit

                            Repeater {
                                model: ["TREADED", "SLICK"]

                                Rectangle {
                                    width: 2.6 * unit
                                    height: 0.75 * unit
                                    radius: height / 2
                                    property bool selected: swSettings.tireStyle === index
                                    color: selected ? swTheme.neonGreen : "transparent"
                                    border.color: selected ? swTheme.neonGreen : swTheme.neonPurple
                                    border.width: 2

                                    Text {
                                        anchors.centerIn: parent
                                        text: modelData
                                        color: parent.selected ? swTheme.background : swTheme.neonPurple
                                        font.family: "Exan"
                                        font.pixelSize: 0.28 * unit
                                    }

                                    MouseArea {
                                        anchors.fill: parent
                                        onClicked: swSettings.tireStyle = index
                                    }
                                }
                            }
                        }

                        SwLText {
                            anchors.horizontalCenter: parent.horizontalCenter

                            // Refloat Glow: section headings in neon green digital font
                            font.pixelSize: 0.38 * unit
                            font.family: "Exan"
                            font.letterSpacing: 0.03 * unit
                            color: swTheme.neonGreen
                            text: "View"
                        }

                        // Refloat Glow: mirror the side view (nose left <-> right)
                        Rectangle {
                            anchors.horizontalCenter: parent.horizontalCenter
                            width: 2.6 * unit
                            height: 0.75 * unit
                            radius: height / 2
                            property bool selected: swSettings.flipView
                            color: selected ? swTheme.neonGreen : "transparent"
                            border.color: selected ? swTheme.neonGreen : swTheme.neonPurple
                            border.width: 2

                            Text {
                                anchors.centerIn: parent
                                text: "FLIP"
                                color: parent.selected ? swTheme.background : swTheme.neonPurple
                                font.family: "Exan"
                                font.pixelSize: 0.28 * unit
                            }

                            MouseArea {
                                anchors.fill: parent
                                onClicked: swSettings.flipView = !swSettings.flipView
                            }
                        }

                        Item {
                            width: parent.width
                            height: 0.2 * unit
                        }
                    }
                }

                // Refloat Glow: LEDS - light module (SLCM build) settings
                ScrollView {
                    Layout.fillHeight: true
                    Layout.fillWidth: true
                    contentWidth: availableWidth
                    clip: true

                    Column {
                        id: ledsPage
                        anchors.fill: parent
                        anchors.leftMargin: 0.15 * unit
                        anchors.rightMargin: 0.15 * unit
                        spacing: 0.12 * unit

                        Item { width: parent.width; height: 0.05 * unit }

                        // what's fitted: SLCM detected or not (asked while this tab is open)
                        Binding { target: slcmDetect; property: "tabOpen"; value: ledsPage.visible }

                        Rectangle {
                            width: parent.width
                            height: ledCompatText.implicitHeight + 0.2 * unit
                            radius: 0.08 * unit
                            readonly property color tone: slcmDetect.present ? swTheme.neonGreen : (slcmDetect.known ? "#FFB300" : swTheme.neonPurple)
                            color: slcmDetect.present ? "#0d2a12" : (slcmDetect.known ? "#2A1F00" : "#140c26")
                            border.color: tone
                            border.width: 2
                            Text {
                                id: ledCompatText
                                anchors.centerIn: parent
                                width: parent.width - 0.2 * unit
                                horizontalAlignment: Text.AlignHCenter
                                wrapMode: Text.WordWrap
                                color: parent.tone === swTheme.neonPurple ? "#ead6ff" : parent.tone
                                font.pixelSize: fontSizeSmall
                                textFormat: Text.StyledText
                                text: slcmDetect.present
                                    ? "<b>&#10004; SLCM DETECTED</b> &middot; " + slcmDetect.version + "<br>Same light settings as any controller, plus the SLCM EXTRAS below."
                                    : slcmDetect.known
                                        ? "<b>REFLOAT LIGHTS</b><br>These are Refloat's own LED settings, the same on any controller (Thor, Floatwheel, ...)."
                                        : "Looking for an SLCM light module..."
                            }
                        }

                        // quick switches, every controller: they override the other
                        // light settings (riding and idle) until switched back on
                        LedHeading { visible: ledSender.quickAvailable; text: "Lights" }

                        // rf132: Refloat view: ALL LIGHTS first, a bit bigger
                        SwPill {
                            anchors.horizontalCenter: parent.horizontalCenter
                            visible: ledSender.quickAvailable && !slcmDetect.present
                            minWidth: 7.6 * unit
                            implicitHeight: 0.95 * unit
                            labelSize: 0.3 * unit
                            label: ledSender.allOn ? "ALL LIGHTS ON" : "ALL LIGHTS OFF"
                            lit: ledSender.allOn
                            onClicked: ledSender.setAll(!ledSender.allOn)
                        }

                        Row {
                            anchors.horizontalCenter: parent.horizontalCenter
                            visible: ledSender.quickAvailable
                            spacing: 0.2 * unit

                            SwPill {
                                minWidth: 3.6 * unit
                                implicitHeight: 0.75 * unit
                                label: swSettings.ledHeadlights ? "HEAD/TAIL ON" : "HEAD/TAIL OFF"
                                lit: swSettings.ledHeadlights
                                onClicked: ledSender.setHead(!swSettings.ledHeadlights)
                            }

                            SwPill {
                                minWidth: 3.6 * unit
                                implicitHeight: 0.75 * unit
                                label: swSettings.ledStatusBar ? "STATUS ON" : "STATUS OFF"
                                lit: swSettings.ledStatusBar
                                onClicked: ledSender.setStatus(!swSettings.ledStatusBar)
                            }
                        }

                        SwPill {
                            anchors.horizontalCenter: parent.horizontalCenter
                            visible: ledSender.quickAvailable && slcmDetect.present  // rf132: SLCM: as before
                            minWidth: 7.4 * unit
                            implicitHeight: 0.75 * unit
                            label: ledSender.allOn ? "ALL LIGHTS ON" : "ALL LIGHTS OFF"
                            lit: ledSender.allOn
                            onClicked: ledSender.setAll(!ledSender.allOn)
                        }

                        SwLText {
                            visible: ledSender.overrideText !== ""
                            width: parent.width
                            horizontalAlignment: Text.AlignHCenter
                            wrapMode: Text.WordWrap
                            font.pixelSize: fontSizeSmall
                            color: "#ff8a1f"
                            text: ledSender.overrideText + ": overrides the other light settings (riding and idle) until switched back on."
                        }

                        SwLText {
                            width: parent.width
                            horizontalAlignment: Text.AlignHCenter
                            wrapMode: Text.WordWrap
                            font.pixelSize: fontSizeSmall
                            text: !lights.enabled && !slcmDetect.present
                                ? "No SLCM and no controller-driven LEDs set up (Refloat Cfg \u25B8 Hardware: LED Mode, type, pin), so light switches are hidden."
                                : (!lights.lcm && !slcmDetect.present
                                    ? "Using an LCM? Set Refloat Cfg \u25B8 Hardware \u25B8 LED Mode to External (or Internal and External) and write the config."
                                    : (swSettings.ledConfigured && slcmDetect.present
                                        ? "SLCM settings are stored on the board, so they apply even without the phone."
                                        : "SLCM settings are only sent once you change one here; until then the light module keeps its own."))
                        }

                        // Each tile opens its settings in a full-screen window
                        GridLayout {
                            id: ledMainTiles  // rf166: Onboarding Tour target
                            width: parent.width
                            columns: 2
                            rowSpacing: 0.18 * unit
                            columnSpacing: 0.18 * unit

                            LedTile {
                                title: "HEAD/TAIL LIGHTS"
                                glyph: "\u25C9"
                                art: 3  // rf98: the neon board
                                Layout.columnSpan: 2
                                Layout.preferredHeight: 3.0 * unit
                                lit: swSettings.ledHeadlights
                                summary: swSettings.ledHeadlights
                                    ? "ON \u00B7 " + "RIDE " + swSettings.ledHeadlightPct + "% \u00B7 IDLE " + swSettings.ledHeadlightIdlePct + "%"
                                    : "OFF"
                                onClicked: ledWindow.show("head")
                            }
                            LedTile {
                                title: "STATUS BAR"
                                glyph: "\u2589"
                                art: slcmDetect.present ? 2 : 4  // rf136: Refloat view: the board's front, live status bar
                                Layout.preferredHeight: slcmDetect.present ? 1.9 * unit : 3.0 * unit  // rf152: same height as HEAD/TAIL LIGHTS
                                Layout.columnSpan: 2  // rf98: full width under HEAD/TAIL LIGHTS
                                lit: swSettings.ledStatusBar
                                summary: swSettings.ledStatusBar
                                    ? "ON \u00B7 RIDE " + swSettings.ledStatusRidePct + "% \u00B7 " + (ledSender.slcmPresets ? "IDLE " + ledSender.animLabel(0, swSettings.ledAnimIdle === 128 ? 15 : swSettings.ledAnimIdle) : ledSender.rfSummary)
                                    : "OFF"
                                onClicked: ledWindow.show("bar")
                            }
                        }

                        // rf129: the snooze timer on the LEDS page (controller-driven LEDs):
                        // minutes before VESC's power-off, with the power-off note
                        LedCard {
                            visible: !ledSender.slcmPresets && (ledSender.rgbAvail || ledSender.rfStatusAvail)
                            width: parent.width
                            // rf156: title with a (?) that opens the explanation
                            Item {
                                width: parent.width
                                height: 0.5 * unit
                                Text {
                                    anchors.centerIn: parent
                                    text: "SNOOZE"
                                    color: swTheme.neonGreen
                                    font.family: "Exan"
                                    font.pixelSize: 0.28 * unit
                                    font.letterSpacing: 0.03 * unit
                                }
                                Rectangle {
                                    anchors.right: parent.right
                                    anchors.verticalCenter: parent.verticalCenter
                                    width: 0.5 * unit
                                    height: width
                                    radius: width / 2
                                    color: snzHelpArea.pressed ? swTheme.neonPurple : "transparent"
                                    border.color: swTheme.neonPurple
                                    border.width: 2
                                    Text {
                                        anchors.centerIn: parent
                                        text: "?"
                                        color: snzHelpArea.pressed ? swTheme.background : swTheme.neonGreen
                                        font.family: "Exan"
                                        font.pixelSize: 0.28 * unit
                                    }
                                    MouseArea {
                                        id: snzHelpArea
                                        anchors.fill: parent
                                        anchors.margins: -0.2 * unit  // easy to hit
                                        onClicked: snoozeHelp.open()
                                    }
                                }
                            }
                            // rf100: how many minutes BEFORE the board powers off the
                            // snooze starts (default 5; 0 = never), head/tail and status bar
                            // rf154: reads "[v 5 min ^] BEFORE BOARD POWERS OFF": the
                            // minutes on the left, the words right after them
                            Item {
                                visible: ledSender.rgbAvail || ledSender.rfStatusAvail
                                width: parent.width
                                height: 0.95 * unit
                                SwStepper {
                                    id: snoozeMinStep
                                    anchors.left: parent.left
                                    width: valueWidth + 2.4 * unit  // just the arrows and the minutes
                                    label: ""
                                    valueWidth: 2.0 * unit
                                    value: swSettings.ledSnoozeMin === 255 ? 5 : swSettings.ledSnoozeMin
                                    from: 0; to: vescAppConfig.offMinutes >= 2 ? Math.min(60, Math.ceil(vescAppConfig.offMinutes) - 1) : 60; step: 1
                                    valueText: value === 0 ? "NEVER" : value + " min"
                                    onMoved: { swSettings.ledSnoozeMin = newValue; ledSender.changed(); }
                                }
                                SwNeonLabel {
                                    anchors.left: snoozeMinStep.right
                                    anchors.leftMargin: 0.2 * unit
                                    anchors.right: parent.right
                                    anchors.verticalCenter: parent.verticalCenter
                                    font.pixelSize: 0.26 * unit
                                    text: "BEFORE BOARD POWERS OFF"
                                }
                            }
                        }

                        // rf173: BEEPER moved to Settings › RIDE (gear)

                        // rf131: changes made in an ADVANCED view with AUTO APPLY off, still waiting
                        SwPill {
                            visible: ledSender.pending && !slcmDetect.present
                            anchors.horizontalCenter: parent.horizontalCenter
                            minWidth: 5.0 * unit
                            label: "\u2713 APPLY WAITING LED CHANGES"
                            lit: true
                            onClicked: {
                                ledSender.apply();
                                VescIf.emitStatusMessage("LED changes applied", true);
                            }
                        }

                        SwLText {
                            width: parent.width
                            horizontalAlignment: Text.AlignHCenter
                            wrapMode: Text.WordWrap
                            font.pixelSize: fontSizeSmall
                            text: "Refloat's LED settings (Refloat Cfg \u203A LEDs), kept in step both ways, on every controller."
                        }

                        // SLCM extras: only with an SLCM light module
                        // rf183: NON-RGB HEAD/TAIL LIGHTS (rf175) removed (user, 2026-11-24)

                        LedHeading { visible: slcmDetect.present; text: "SLCM extras" }

                        GridLayout {
                            visible: slcmDetect.present
                            width: parent.width
                            columns: 2
                            rowSpacing: 0.18 * unit
                            columnSpacing: 0.18 * unit

                            LedTile {
                                Layout.columnSpan: 2
                                title: "STATUS BAR ANIMATIONS"
                                glyph: "\u2726"
                                lit: true
                                swatch: Qt.hsla(swSettings.ledColor / 360, 1.0, 0.5, 1.0)
                                summary: "IDLE " + ledSender.animLabel(0, swSettings.ledAnimIdle) + " \u00B7 RIDE "
                                    + ledSender.animLabel(1, swSettings.ledAnimRide)
                                onClicked: ledWindow.show("anim")
                            }
                            LedTile {
                                id: slcmBeepTile  // rf166: Onboarding Tour target
                                title: "BEEPER"
                                glyph: "\u266A"
                                lit: swSettings.ledBeep
                                summary: "LCM BEEPER " + (swSettings.ledBeep ? "ON" : "OFF")  // rf173: controller beeper in Settings
                                onClicked: ledWindow.show("sound")
                            }
                            LedTile {
                                id: slcmBattTile  // rf166: Onboarding Tour target
                                title: "BATTERY GAUGE"
                                glyph: "\u25AE"
                                lit: swSettings.batCurveOn
                                summary: swSettings.batCurveOn
                                    ? (swSettings.batCell === "MY CELL" && batteryCurve.custom ? batteryCurve.custom.name : swSettings.batCell)
                                        + " \u00B7 " + batteryCurve.parallel + "P \u00B7 " + batteryCurve.styleNames[swSettings.batStyle + 1]
                                    : "VESC BATTERY %"
                                onClicked: ledWindow.show("battery")
                            }
                        }

                        // Refloat Glow: CHECK FOR UPDATES (package + SLCM on GitHub)
                        // rf130: SLCM boards only (not in the Refloat view)
                        GridLayout {
                            visible: slcmDetect.present
                            width: parent.width
                            columns: 2
                            rowSpacing: 0.18 * unit
                            columnSpacing: 0.18 * unit

                            LedTile {
                                id: slcmUpdTile  // rf166: Onboarding Tour target
                                Layout.columnSpan: 2
                                title: "UPDATES"
                                glyph: "\u21BB"
                                lit: updater.pkgFit === "newer" || updater.lcmFit === "newer"
                                summary: updater.phase === 1 ? "CHECKING..."
                                    : updater.phase !== 2 ? "CHECK FOR UPDATES"
                                    : updater.pkgFit === "newer" && updater.lcmFit === "newer" ? "PACKAGE + LCM UPDATE AVAILABLE"
                                    : updater.pkgFit === "newer" ? "PACKAGE UPDATE AVAILABLE"
                                    : updater.lcmFit === "newer" ? "LCM UPDATE AVAILABLE"
                                    : "UP TO DATE \u00B7 CHECK AGAIN"
                                onClicked: ledWindow.show("updates")
                            }
                        }

                        Item { width: parent.width; height: 0.6 * unit }

                        // Refloat Glow: LCM firmware tools, tucked away
                        // on purpose - a 2 s press and hold opens them
                        Item {
                            id: lcmToolsLink
                            visible: ledSender.lcmModule || slcmDetect.present || lcmFw.active
                            anchors.horizontalCenter: parent.horizontalCenter
                            width: lcmToolsText.implicitWidth + 0.4 * unit
                            height: 0.62 * unit
                            property real hold: 0
                            property bool hint: false

                            Text {
                                id: lcmToolsText
                                anchors.centerIn: parent
                                text: lcmFw.active ? "LCM FIRMWARE \u00B7 FLASHING " + Math.round(lcmFw.progress * 100) + "%"
                                    : (lcmToolsLink.hint ? "HOLD 2 s TO OPEN" : "LCM firmware tools")
                                color: lcmFw.active ? swTheme.neonGreen : "#5c5470"
                                font.pixelSize: 0.2 * unit
                                font.letterSpacing: 0.02 * unit
                            }
                            Rectangle {
                                anchors.bottom: parent.bottom
                                x: 0.2 * unit
                                height: 2
                                width: (parent.width - 0.4 * unit) * lcmToolsLink.hold
                                color: swTheme.neonGreen
                            }
                            NumberAnimation {
                                id: lcmToolsHoldAnim
                                target: lcmToolsLink
                                property: "hold"
                                from: 0; to: 1
                                duration: 2000
                                onFinished: if (lcmToolsArea.pressed) { lcmToolsLink.hold = 0; ledWindow.show("fw"); }
                            }
                            Timer { id: lcmToolsHint; interval: 2500; onTriggered: lcmToolsLink.hint = false }
                            MouseArea {
                                id: lcmToolsArea
                                anchors.fill: parent
                                onPressed: {
                                    if (lcmFw.active) { ledWindow.show("fw"); return; }  // follow a running update
                                    lcmToolsHoldAnim.restart();
                                }
                                onReleased: {
                                    if (lcmToolsLink.hold < 1 && lcmToolsLink.hold > 0) { lcmToolsLink.hint = true; lcmToolsHint.restart(); }
                                    lcmToolsHoldAnim.stop();
                                    lcmToolsLink.hold = 0;
                                }
                                onCanceled: { lcmToolsHoldAnim.stop(); lcmToolsLink.hold = 0; }
                            }
                        }

                        Item { width: parent.width; height: 0.3 * unit }
                    }
                }

            }

            // Refloat Glow: title strip - REFLOAT + GLOW + version
            Text {
                id: bottomLine
                Layout.fillWidth: true
                Layout.topMargin: 0.04 * unit
                Layout.bottomMargin: 0.04 * unit
                font.family: "Exan"
                font.pixelSize: 0.24 * unit
                font.letterSpacing: 0.03 * unit
                horizontalAlignment: Text.AlignHCenter
                textFormat: Text.StyledText
                text: '<font color="#b14cff">RE</font><font color="#ead6ff">FLOAT</font>'
                      + '<font color="#7a3fc0"> — </font><font color="#39ff7a">GLOW</font>'
                      + '<font color="#7d68ab">  {{VERSION}}</font>'
                // rf141: tap to read the "Before you start" notice again (and
                // what's at the bottom of it)
                MouseArea {
                    anchors.fill: parent
                    onClicked: disclaimerDialog.open()
                }
            }
        }
    }
}
