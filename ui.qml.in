//            id: cpGrid
//            anchors.fill: parent
//            anchors.margins: 10
//            columns: 2
//            spacing: 5
//            flow: Grid.TopToBottom
//
//            Repeater {
//                model: colorPreview.cData
//
//                Item {
//                    width: (cpGrid.width - cpGrid.spacing) / 2
//                    height: (cpGrid.height - 24 * cpGrid.spacing) / 25
//
